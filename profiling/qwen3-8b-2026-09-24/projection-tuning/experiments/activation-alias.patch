   // for:
   // - Constants/parameters: Already on device and immutable
   // - KV cache tensors: Device-native and updated in-place by cache operations
+  bool isLargeDeviceActivation(mlir::Type type) {
+    if (!std::getenv("LIBTT_KEEP_TRACE_ACTIVATIONS")) return false;
+    auto tensor = mlir::dyn_cast<RankedTensorType>(type);
+    if (!tensor || !tensor.hasStaticShape() || tensor.getNumElements() < 1024)
+      return false;
+    auto layout = mlir::dyn_cast_or_null<TTNNLayoutAttr>(tensor.getEncoding());
+    return layout && layout.getBufferType() != BufferType::SystemMemory &&
+           (tensor.getElementType().isBF16() || tensor.getElementType().isF32());
+  }
+
   bool shouldKeepArgOnDevice(func::FuncOp op, size_t argIndex) {
-    return ttcore::isConstantOrParameterArgumentType(op, argIndex) ||
+    return isLargeDeviceActivation(op.getArgument(argIndex).getType()) ||
+           ttcore::isConstantOrParameterArgumentType(op, argIndex) ||
            ttcore::isKVCacheArgument(op, argIndex);
   }
 
