+        # kernel and persistent trace-slot aliasing, so it can be captured
+        # without forcing the much larger prefill graph through tracing.
+        return {
+            key: value
+            for key, value in {**options, "enable_trace": "true"}.items()
+            if key != "experimental_weight_dtype"
+        }
