+    def compiler_options(self):
+        options = getattr(self.full_attn_backend, "compiler_options", None)
+        if not options or "enable_trace" not in options:
+            return options
+        # Full-model prefill tracing is prohibitively expensive. Hybrid
+        # recurrent dynamics also require BF16 model weights; the default
+        # global BF8 lowering changes greedy decode tokens.
