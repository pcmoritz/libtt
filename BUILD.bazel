load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_python//python:packaging.bzl", "py_wheel")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "bazel/cc_embed_data.S.tpl",
    "bazel/cc_embed_data.h.tpl",
    "bazel/libtt_pjrt_exports.lds",
])

py_library(
    name = "jax_plugin",
    srcs = ["python/jax_plugins/libtt/__init__.py"],
    imports = ["python"],
)

cc_library(
    name = "tt_metal_runtime_root",
    srcs = [
        "cpp/tt_metal_runtime_root.cc",
    ],
    hdrs = [
        "cpp/tt_metal_runtime_root.h",
    ],
    copts = ["-std=c++20"],
    deps = [
        "@tt_metal//:tt_metal_runtime_embedded",
        "@libarchive//:archive",
    ],
    linkstatic = True,
)

cc_library(
    name = "tt_metal_runtime_auto_setup",
    srcs = ["cpp/tt_metal_runtime_auto_setup.cc"],
    copts = ["-std=c++20"],
    deps = [":tt_metal_runtime_root"],
    alwayslink = True,
)

cc_shared_library(
    name = "tt_shared",
    additional_linker_inputs = select({
        "@platforms//os:linux": ["bazel/libtt_pjrt_exports.lds"],
        "//conditions:default": [],
    }),
    deps = [
        ":tt_metal_runtime_auto_setup",
        "@tt_xla_src//:pjrt_plugin",
    ],
    shared_lib_name = select({
        "@platforms//os:macos": "libtt.dylib",
        "//conditions:default": "libtt.so",
    }),
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,--exclude-libs,ALL",
            "-Wl,--version-script,$(location bazel/libtt_pjrt_exports.lds)",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "tt",
    srcs = [
        ":tt_shared",
    ],
)

# Give the shared library its installed package path before handing it to
# py_wheel. The symlink avoids copying the large library in the Bazel graph;
# wheelmaker follows it when it writes the archive.
copy_file(
    name = "jax_plugin_shared_library",
    src = ":tt_shared",
    out = "python/jax_plugins/libtt/libtt.so",
    allow_symlink = True,
)

py_wheel(
    name = "jax_tt_plugin_wheel",
    distribution = "jax-tt-plugin",
    entry_points = {
        "jax_plugins": ["libtt = jax_plugins.libtt"],
    },
    platform = "linux_x86_64",
    python_requires = ">=3.11",
    requires = ["jax>=0.7.1"],
    strip_path_prefixes = ["python"],
    summary = "JAX PJRT plugin for Tenstorrent devices",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    version = "0.1.0",
    deps = [
        ":jax_plugin",
        ":jax_plugin_shared_library",
    ],
)
