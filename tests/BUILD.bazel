load("@jax_test_pip//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_test")

JAX_TEST_ARGS = [
    "--jax-tests-anchor=$(rlocationpath @jax_src//:jax_tests_anchor)",
    "--libtt=$(rlocationpath //:tt)",
]

JAX_TEST_DATA = [
    "//:tt",
    "@jax_src//:jax_tests",
    "@jax_src//:jax_tests_anchor",
]

JAX_TEST_DEPS = [
    requirement("absl-py"),
    requirement("cloudpickle"),
    requirement("filelock"),
    requirement("flatbuffers"),
    requirement("hypothesis"),
    requirement("jax"),
    requirement("jaxlib"),
    requirement("matplotlib"),
    requirement("mpmath"),
    requirement("numpy"),
    requirement("pillow"),
    requirement("portpicker"),
    requirement("pytest"),
    requirement("scipy"),
    "@rules_python//python/runfiles",
]

JAX_TEST_TAGS = [
    "exclusive",
    "manual",
    "no-sandbox",
    "requires-tt-device",
]

py_test(
    name = "jax_smoke_tests",
    srcs = ["jax_test_suite.py"],
    args = JAX_TEST_ARGS + [
        "tests/device_test.py",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant0",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant1",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant2",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant3",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant4",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant5",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant7",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant8",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant9",
    ],
    data = JAX_TEST_DATA,
    deps = JAX_TEST_DEPS + ["//jax_plugins:libtt"],
    main = "jax_test_suite.py",
    tags = JAX_TEST_TAGS,
    timeout = "long",
)

py_test(
    name = "jax_test_suite",
    srcs = ["jax_test_suite.py"],
    args = JAX_TEST_ARGS,
    data = JAX_TEST_DATA,
    deps = JAX_TEST_DEPS + ["//jax_plugins:libtt"],
    main = "jax_test_suite.py",
    tags = JAX_TEST_TAGS,
    timeout = "eternal",
)

py_test(
    name = "jax_svd_tests",
    srcs = ["jax_test_suite.py"],
    args = JAX_TEST_ARGS + [
        # Cover an unbatched matrix and rank-3/rank-4 batches with float32.
        # The other sampled cases use complex inputs, which TT does not
        # support yet.
        "tests/svd_test.py::SvdTest::testSvdvals0",
        "tests/svd_test.py::SvdTest::testSvdvals1",
        "tests/svd_test.py::SvdTest::testSvdvals3",
        "tests/linalg_test.py::NumpyLinalgTest::testJspSVDBasic",
        "--override-ini=addopts=",
    ],
    data = JAX_TEST_DATA,
    deps = JAX_TEST_DEPS + ["//jax_plugins:libtt"],
    main = "jax_test_suite.py",
    tags = JAX_TEST_TAGS,
    timeout = "eternal",
)

py_test(
    name = "tt_linalg_lowerings_test",
    srcs = ["tt_linalg_lowerings_test.py"],
    deps = [
        "//jax_plugins:libtt",
        requirement("jax"),
        requirement("jaxlib"),
        requirement("numpy"),
        requirement("pytest"),
    ],
    main = "tt_linalg_lowerings_test.py",
)
