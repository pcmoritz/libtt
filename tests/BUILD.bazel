load("@jax_test_pip//:requirements.bzl", "requirement")
load("@rules_cc//cc:defs.bzl", "cc_test")
load("@rules_python//python:defs.bzl", "py_test")
load("@torch_tpu_test_pip//:requirements.bzl", torch_tpu_test_requirements = "all_requirements")

PLUGIN_TEST_ARGS = [
    "--jax-plugin-wheel=$(rlocationpath //:jax_tt_plugin_wheel)",
]

PLUGIN_TEST_DATA = ["//:jax_tt_plugin_wheel"]

PLUGIN_TEST_DEPS = [
    requirement("jax"),
    requirement("jaxlib"),
    requirement("numpy"),
    requirement("pytest"),
    "@rules_python//python/runfiles",
]

JAX_TEST_ARGS = PLUGIN_TEST_ARGS + [
    "--tests-anchor=$(rlocationpath @jax_src//:jax_tests_anchor)",
    "--override-ini=testpaths=tests",
]

JAX_TEST_DATA = PLUGIN_TEST_DATA + [
    "@jax_src//:jax_tests",
    "@jax_src//:jax_tests_anchor",
]

JAX_TEST_DEPS = PLUGIN_TEST_DEPS + [
    requirement("absl-py"),
    requirement("cloudpickle"),
    requirement("filelock"),
    requirement("flatbuffers"),
    requirement("hypothesis"),
    requirement("matplotlib"),
    requirement("mpmath"),
    requirement("pillow"),
    requirement("portpicker"),
    requirement("scipy"),
]

TORCH_TPU_TEST_ARGS = PLUGIN_TEST_ARGS + [
    "--tests-anchor=$(rlocationpath @torch_tpu_src//:torch_tpu_tests_anchor)",
    # absl flags for the modules that define them. The op tests compare with
    # CPU instead of GPU golden files, on a few samples per op, and the error
    # tests check the error messages on the device, as in torch_tpu's own
    # Bazel setup.
    "--absl-flag=op_testing:--test_mode=torch_tpu_vs_cpu",
    "--absl-flag=op_testing:--max_samples_per_op_dtype=3",
    "--absl-flag=op_testing:--dtypes=float32,bfloat16,float16,int64,int32,int16,int8,uint8,bool",
    "--absl-flag=ops_test:--test_categories=-foreach,-nonzero,-searchsorted",
    "--absl-flag=error_testing:--test_mode=tpu",
    # The error tests also run with torch_tpu's debug checks, and without C++
    # stack traces in the error messages.
    "--env=*errors_test.py:TORCH_TPU_ENABLE_DEBUG_CHECKS=1",
    "--env=*errors_test.py:TORCH_SHOW_CPP_STACKTRACES=0",
    # torchcomms isn't on PyPI (torch_tpu's open source build leaves these out
    # too), and the profiler tests import tsl's protos, which torch_tpu builds
    # from the tsl repository and no package provides.
    "--exclude=tests/distributed/torchcomm_multi_tpu_test.py",
    "--exclude=tests/distributed/torchcomm_tpu_test.py",
    "--exclude=tests/profiler/profiler_api_test.py",
    "--exclude=tests/profiler/profiler_integration_test.py",
    # Seconds per test (pytest-timeout), so that a hang only fails its test.
    "--timeout=600",
    # Count passed subtests too; the op tests run each sample as a subtest.
    "-o",
    "verbosity_subtests=1",
]

TORCH_TPU_TEST_DATA = PLUGIN_TEST_DATA + [
    "@torch_tpu_src//:torch_tpu_tests",
    "@torch_tpu_src//:torch_tpu_tests_anchor",
]

TORCH_TPU_TEST_SRCS = [
    "pytest_runner.py",
    "torch_tpu_pytest_plugin.py",
    "torch_tpu_runner.py",
    "torch_tpu_site/sitecustomize.py",
]

TORCH_TPU_TEST_DEPS = torch_tpu_test_requirements + [
    "@rules_python//python/runfiles",
]

DEVICE_TEST_TAGS = [
    "exclusive",
    "manual",
    "no-sandbox",
    "requires-tt-device",
]

py_test(
    name = "libtt_test_suite",
    srcs = ["pytest_runner.py"],
    args = PLUGIN_TEST_ARGS + [
        "--tests-anchor=$(rlocationpath :libtt/pytest.ini)",
    ],
    data = PLUGIN_TEST_DATA + glob(["libtt/**/*.py"]) + ["libtt/pytest.ini"],
    deps = PLUGIN_TEST_DEPS,
    main = "pytest_runner.py",
    tags = DEVICE_TEST_TAGS,
    timeout = "long",
)

py_test(
    name = "jax_smoke_tests",
    srcs = ["pytest_runner.py"],
    args = JAX_TEST_ARGS + [
        "tests/lax_test.py::FunctionAccuracyTest::testSuccessOnComplexPlane_square_complex64",
        "tests/lax_test.py::LaxTest::test_constant_folding_complex_to_real_scan_regression",
        "tests/device_test.py",
        "tests/batching_test.py::BatchingTest::testDynamicUpdateSlice",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant0",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant1",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant2",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant3",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant4",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant5",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant7",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant8",
        "tests/lax_test.py::LazyConstantTest::testIotaConstant9",
        "tests/lax_numpy_test.py::LaxBackedNumpyTests::testPackbits0",
        "tests/lax_numpy_test.py::LaxBackedNumpyTests::testPackbits2",
        "tests/lax_numpy_test.py::LaxBackedNumpyTests::testUnpackbits6",
    ],
    data = JAX_TEST_DATA,
    deps = JAX_TEST_DEPS,
    main = "pytest_runner.py",
    tags = DEVICE_TEST_TAGS,
    timeout = "long",
)

py_test(
    name = "jax_test_suite",
    srcs = ["pytest_runner.py"],
    args = JAX_TEST_ARGS,
    data = JAX_TEST_DATA,
    deps = JAX_TEST_DEPS,
    main = "pytest_runner.py",
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
)

py_test(
    name = "torch_tpu_smoke_tests",
    srcs = TORCH_TPU_TEST_SRCS,
    args = TORCH_TPU_TEST_ARGS + [
        "tests/booleans_test.py",
        "tests/compile/stablehlo_compile_test.py",
        "tests/fused_adam_test.py",
        "tests/optimizers/sgd_test.py",
        "tests/scan_test.py",
        "tests/untyped_storage_test.py",
        # unique and unique_consecutive sort with a non-strict comparator,
        # with duplicates, returned inverse indices and counts.
        "tests/ops_unit_test.py::OpsGradUnitTest::test_unique2_distributions",
        "tests/ops_unit_test.py::OpsUnitTest::test_unique_consecutive_distributions",
    ],
    data = TORCH_TPU_TEST_DATA,
    deps = TORCH_TPU_TEST_DEPS,
    main = "torch_tpu_runner.py",
    tags = DEVICE_TEST_TAGS,
    timeout = "long",
)

py_test(
    name = "torch_tpu_test_suite",
    srcs = TORCH_TPU_TEST_SRCS,
    args = TORCH_TPU_TEST_ARGS,
    data = TORCH_TPU_TEST_DATA,
    deps = TORCH_TPU_TEST_DEPS,
    main = "torch_tpu_runner.py",
    tags = DEVICE_TEST_TAGS,
    timeout = "eternal",
)

cc_test(
    name = "tt_metal_unit_tests",
    srcs = glob([
        "tt_metal/*.cpp",
        "tt_metal/*.hpp",
