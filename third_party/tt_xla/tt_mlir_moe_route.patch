+def TTIR_MoeRouteOp : TTIR_NamedOp<"moe_route"> {
+  let summary = "A mixture-of-experts router's top-k selection";
+  let description = [{
+    scores = sigmoid(logits), ids = top_k(scores + bias) (best first, the
+    lower expert first among equal keys), weights = scores[ids] /
+    sum(scores[ids]) * scale; rows from num_valid on get weight 0 and id -1.
+    logits [T, E] FP32, bias [E]; weights [T, k] FP32, ids [T, k] INT32.
+    libtt's tt.moe_route custom call (sglang_tpu_kernels.py) forms it.
+  }];
+  let arguments = (ins AnyRankedTensor:$logits,
+                       AnyRankedTensor:$bias,
+                       Optional<AnyRankedTensor>:$num_valid,
+                       I64Attr:$k,
+                       F32Attr:$scale);
+  let results = (outs AnyRankedTensor:$weights, AnyRankedTensor:$ids);
+}
