+class MoeRouteOpConversionPattern : public OpConversionPattern<ttir::MoeRouteOp> {
+public:
+  using OpConversionPattern<ttir::MoeRouteOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::MoeRouteOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(this->getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                      types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::MoeRouteOp>(
+        op, types, adaptor.getLogits(), adaptor.getBias(),
+        adaptor.getNumValid(), op.getKAttr(), op.getScaleAttr());
+    return success();
+  }
+};
