+::flatbuffers::Offset<::tt::target::ttnn::MoeRouteOp>
+createOp(FlatbufferObjectCache &cache, MoeRouteOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  auto result = [&](Value value) {
+    return cache.getOrCreateNoSharding(value, tensorValueToFlatbuffer,
+                                       std::nullopt);
+  };
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> numValid =
+      op.getNumValid() ? tensor(op.getNumValid()) : 0;
+  auto weights = result(op.getWeights());
+  auto ids = result(op.getIds());
+  return ::tt::target::ttnn::CreateMoeRouteOp(
+      *cache.fbb, tensor(op.getLogits()), tensor(op.getBias()), numValid,
+      static_cast<uint32_t>(op.getK()), op.getScale().convertToFloat(),
+      weights, ids);
+}
