+// libtt: a head-major subgraph returns a tile reinterpretation of its
+// generic's output buffer ([H, T, D] tiles in [T, H*D] order, see
+// rewriteHeadMajorSubgraph). The buffer takes the function's result type when
+// both have the same element type, tile pages and buffer placement.
+static void retypeReinterpretedReturns(ModuleOp moduleOp) {
+  moduleOp.walk([](func::ReturnOp ret) {
+    auto func = ret->getParentOfType<func::FuncOp>();
+    if (!func) {
+      return;
+    }
+    ArrayRef<Type> results = func.getFunctionType().getResults();
+    for (auto [i, v] : llvm::enumerate(ret.getOperands())) {
+      if (i >= results.size() || v.getType() == results[i]) {
+        continue;
+      }
+      auto empty = v.getDefiningOp<ttnn::EmptyOp>();
+      auto have = mlir::dyn_cast<RankedTensorType>(v.getType());
+      auto want = mlir::dyn_cast<RankedTensorType>(results[i]);
+      if (!empty || !have || !want ||
+          have.getElementType() != want.getElementType()) {
+        continue;
+      }
+      auto hl = mlir::dyn_cast<ttnn::TTNNLayoutAttr>(have.getEncoding());
+      auto wl = mlir::dyn_cast<ttnn::TTNNLayoutAttr>(want.getEncoding());
+      if (!hl || !wl) {
+        continue;
+      }
+      MemRefType hm = hl.getMemref(), wm = wl.getMemref();
+      if (hm.getElementType() != wm.getElementType() ||
+          hm.getNumElements() != wm.getNumElements() ||
+          hl.getBufferType() != wl.getBufferType() ||
+          hl.getMemLayout() != wl.getMemLayout()) {
+        continue;
+      }
+      empty.getResult().setType(want);
+      empty.setShapeAttr(
+          ttnn::ShapeAttr::get(func.getContext(), want.getShape()));
+    }
+  });
+}
