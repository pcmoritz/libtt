+def TTIR_RowToColumnOp : TTIR_ElementwiseOp<"row_to_column", [OneOperand, TTIR_ElementwiseUnary]> {
+    let summary = "libtt: a [1, N] row reinterpreted as [N, 1] made the [N, 1] column.";
+    let description = [{
+      The input is a [1, N] row (N <= 32) reinterpreted as the [N, 1] tensor of the result: the same
+      tile, the values in its row 0. The result is the column: value i in row i (column 0, and in
+      libtt's lowering repeated across the row). Lets a per-token [T] factor enter a D2M subgraph
+      without a TTNN reshape.
+    }];
+
