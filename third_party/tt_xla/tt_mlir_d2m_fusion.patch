+    let description = [{
+      result[i, t, 0] = sum_j input[j, t, 0]: an all-reduce over dim 0. Only for a wide-row reduction
+      split in k chunks of one tile row, one chunk per core of its D2M generic: libtt's lowering
+      exchanges the partial tiles between those cores inside the kernel (d2m_fusion::insertChunkAllReduce).
+    }];
+
