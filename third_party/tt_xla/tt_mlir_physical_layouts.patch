+// libtt: physical layouts (ttir-physical-layouts). In tiles, a rank-1
+// array of N elements is one row of N / 32 tiles, each padded to 32 rows: 32
+// times its size, a matrix of W < 32 rows takes 32 / W times its size, and a
+// [T, 1, V] tensor pads each of its T rows to 32. Rank-1 arrays of at least
+// 2^20 elements and matrices of at most 8 rows and 2^22 elements, a multiple of
+// 32, are stored on device as [N / 32, 32] instead, and [T, 1, V] tensors of at
+// least 2^20 elements as [T, V], the same elements in row-major order in
+// whole tiles; ttir-physical-layouts (libtt's PhysicalLayouts.cpp,
+// boundaryShape) gives programs' arguments and results of these shapes that
+// type too. LIBTT_PHYSICAL_LAYOUTS=0 turns both off.
+static bool physicalLayoutsEnabled() {
+  static const bool enabled = [] {
+    const char *value = std::getenv("LIBTT_PHYSICAL_LAYOUTS");
+    return value == nullptr || std::strcmp(value, "0") != 0;
+  }();
+  return enabled;
+}
+
+static std::optional<::ttnn::Shape>
+compactShape(const ::ttnn::Shape &shape) {
+  constexpr std::uint64_t kWidth = 32;
+  if (!physicalLayoutsEnabled() || shape.volume() == 0) {
+    return std::nullopt;
+  }
+  const bool rank1 = shape.rank() == 1 && shape.volume() >= (1u << 20);
+  const bool fewRows = shape.rank() == 2 && shape[0] <= 8 &&
+                       shape[1] != kWidth && shape.volume() >= (1u << 22);
+  if ((rank1 || fewRows) && shape.volume() % kWidth == 0) {
+    return ::ttnn::Shape{static_cast<std::uint32_t>(shape.volume() / kWidth),
+                        static_cast<std::uint32_t>(kWidth)};
+  }
+  if (shape.rank() == 3 && shape[1] == 1 && shape[0] > 1 && shape[2] > 1 &&
+      shape.volume() >= (1u << 20)) {
+    return ::ttnn::Shape{shape[0], shape[2]};
+  }
+  return std::nullopt;
+}
+
+// The shape `toLayout` gives `tensor` for `desired`: the program input's, or
+// for other device layouts in tiles, its compact shape.
+static std::optional<::ttnn::Shape> targetShape(
+    const ::ttnn::Tensor &tensor, const LayoutDesc &desired) {
+  if (desired.shape) {
+    return desired.shape;
+  }
+  if (desired.isOnDevice() && desired.isTilized()) {
+    return compactShape(tensor.logical_shape());
+  }
+  return std::nullopt;
+}
+
+// `tensor` reshaped to `shape`, its compact shape or back. One in tiles on
+// device goes through the host: its elements are rows apart in its own tiles
+// and side by side in the compact one, and a device reshape of a rank-1
+// tensor's tiles stages whole rows. Buffers are made in the shape programs
+// take, so this is rare.
+static ::ttnn::Tensor reshapeTo(const ::ttnn::Tensor &tensor,
+                                const ::ttnn::Shape &shape) {
+  const std::vector<int32_t> target(shape.begin(), shape.end());
+  if (tensor.storage_type() == ::ttnn::StorageType::DEVICE &&
+      tensor.layout() == ::ttnn::Layout::TILE) {
+    ::ttnn::Tensor host = ::ttnn::to_layout(::ttnn::from_device(tensor),
+                                            ::ttnn::Layout::ROW_MAJOR);
+    return ::ttnn::reshape(host, target);
+  }
+  return ::ttnn::reshape(tensor, target);
+}
