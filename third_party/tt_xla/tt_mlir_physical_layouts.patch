+// libtt: physical layouts (ttir-physical-layouts). The shape a tensor is
+// stored in on device, if not its own (ttmlir/PhysicalLayouts.h): the compiler
+// gives programs' arguments and results of these shapes that shape too.
+static std::optional<::ttnn::Shape> compactShape(const ::ttnn::Shape &shape) {
+  std::optional<std::array<int64_t, 2>> compact =
+      ttmlir::physical_layouts::compactShape(shape);
+  if (!compact) {
+    return std::nullopt;
+  }
+  return ::ttnn::Shape{static_cast<std::uint32_t>((*compact)[0]),
+                       static_cast<std::uint32_t>((*compact)[1])};
+}
+
+// Whether `a` and `b` are a shape and its compact shape, in either order.
+static bool isCompactPair(const ::ttnn::Shape &a, const ::ttnn::Shape &b) {
+  return a != b && (compactShape(a) == b || compactShape(b) == a);
+}
+
+// The shape `toLayout` reshapes `tensor` to for `desired`, if any: the program
+// input's when the two are a compact pair, or for other device layouts in
+// tiles, its compact shape. A buffer and a program made with
+// LIBTT_PHYSICAL_LAYOUTS set differently still pair up, so only the shape new
+// buffers are stored in follows the flag, read each time as the compiler does.
+static std::optional<::ttnn::Shape> targetShape(const ::ttnn::Tensor &tensor,
+                                                const LayoutDesc &desired) {
+  const ::ttnn::Shape &shape = tensor.logical_shape();
+  if (desired.shape) {
+    return isCompactPair(shape, *desired.shape) ? desired.shape : std::nullopt;
+  }
+  if (desired.isOnDevice() && desired.isTilized() &&
+      ttmlir::physical_layouts::enabled()) {
+    return compactShape(shape);
+  }
+  return std::nullopt;
+}
+
+// `tensor` reshaped to `shape`, its compact shape or back, for a program that
+// takes it in `layout`. On device, TT-NN's tiled reshape moves the elements
+// between tiles. If either end is row-major, its row-major reshape moves them
+// instead, from a tiled tensor untilized first, so that no padded copy is made:
+// a flat buffer in tiles takes 32 times its size. Buffers are made in the shape
+// programs take, so this is rare.
+static ::ttnn::Tensor reshapeTo(const ::ttnn::Tensor &tensor,
+                                const ::ttnn::Shape &shape,
+                                ::ttnn::Layout layout) {
+  const std::vector<int32_t> target(shape.begin(), shape.end());
+  const bool rowMajor =
+      tensor.layout() == ::ttnn::Layout::ROW_MAJOR ||
+      (layout == ::ttnn::Layout::ROW_MAJOR &&
+       utils::canUntilizeOnDevice(tensor.dtype(), tensor.memory_config()));
+  if (tensor.storage_type() == ::ttnn::StorageType::DEVICE && rowMajor) {
+    return ::ttnn::reshape(::ttnn::to_layout(tensor, ::ttnn::Layout::ROW_MAJOR),
+                           target);
+  }
+  return ::ttnn::reshape(tensor, target);
+}
