diff --git a/pjrt_implementation/src/api/module_builder/module_builder.cc b/pjrt_implementation/src/api/module_builder/module_builder.cc
--- a/pjrt_implementation/src/api/module_builder/module_builder.cc
+++ b/pjrt_implementation/src/api/module_builder/module_builder.cc
@@ -1096,9 +1096,18 @@ tt_pjrt_status ModuleBuilder::convertFromTTIRToTTNN(
   if (compile_options.math_fidelity.has_value()) {
     mlir::tt::ttnn::OptionalMathFidelity math_fidelity;
     tt_pjrt_status status = CompileOptionsParser::parseMathFidelity(
         compile_options.math_fidelity.value(), math_fidelity);
     if (!tt_pjrt_status_is_ok(status)) {
       return status;
     }
     options.computeCfgMathFidelity = math_fidelity;
+    const std::string option_value =
+        compile_options.math_fidelity.value() == "ttnn_default"
+            ? "undefined"
+            : compile_options.math_fidelity.value();
+    if (mlir::failed(options.parseFromString(
+            "compute-cfg-math-fidelity=" + option_value))) {
+      LOG_F(ERROR, "Failed to forward explicit math_fidelity option");
+      return tt_pjrt_status::kInvalidArgument;
+    }
   }
@@ -1108,4 +1117,10 @@ tt_pjrt_status ModuleBuilder::convertFromTTIRToTTNN(
   if (compile_options.fp32_dest_acc_en.has_value() &&
       !compile_options.enable_trace) {
     options.computeCfgFp32DestAccEn = compile_options.fp32_dest_acc_en.value();
+    if (mlir::failed(options.parseFromString(
+            std::string("compute-cfg-fp32-dest-acc-en=") +
+            (compile_options.fp32_dest_acc_en.value() ? "true" : "false")))) {
+      LOG_F(ERROR, "Failed to forward explicit fp32_dest_acc_en option");
+      return tt_pjrt_status::kInvalidArgument;
+    }
   }
