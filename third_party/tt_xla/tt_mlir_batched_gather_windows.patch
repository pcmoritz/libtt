+static Value prepareGatherIndices(
+    mlir::stablehlo::GatherOp srcOp, Value startIndices,
+    RankedTensorType startIndicesType, RankedTensorType outputType,
+    ConversionPatternRewriter &rewriter,
+    std::optional<int64_t> maxIndex = std::nullopt) {
+  auto dimensionNumbers = srcOp.getDimensionNumbers();
+  auto startIndicesShape = startIndicesType.getShape();
+
+  SmallVector<int64_t> reshapedIndicesShape;
+  for (int64_t dim : llvm::seq<int64_t>(startIndicesType.getRank())) {
+    if (dim != dimensionNumbers.getIndexVectorDim()) {
+      reshapedIndicesShape.push_back(startIndicesShape[dim]);
+    }
+  }
+
+  Value indices = startIndices;
+  if (reshapedIndicesShape.size() != startIndicesShape.size()) {
+    auto reshapedIndicesType = RankedTensorType::get(
+        reshapedIndicesShape, startIndicesType.getElementType(),
+        startIndicesType.getEncoding());
+    indices = rewriter.create<ttir::ReshapeOp>(
+        srcOp.getLoc(), reshapedIndicesType, indices,
+        rewriter.getI32ArrayAttr(
+            llvm::to_vector_of<int32_t>(reshapedIndicesShape)));
+  }
+
+  if (maxIndex) {
+    auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+    indices = rewriter.create<ttir::ClampScalarOp>(
+        srcOp.getLoc(), indicesType, indices, rewriter.getI32IntegerAttr(0),
+        rewriter.getI32IntegerAttr(*maxIndex));
+  }
+
+  if (static_cast<int64_t>(reshapedIndicesShape.size()) <
+      outputType.getRank()) {
+    SmallVector<int64_t> unsqueezedShape(reshapedIndicesShape);
+    for (int64_t offsetDim : dimensionNumbers.getOffsetDims()) {
+      unsqueezedShape.insert(unsqueezedShape.begin() + offsetDim, 1);
+    }
+
+    auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+    auto unsqueezedType =
+        RankedTensorType::get(unsqueezedShape, indicesType.getElementType(),
+                              indicesType.getEncoding());
+    indices = rewriter.create<ttir::ReshapeOp>(
+        srcOp.getLoc(), unsqueezedType, indices,
+        rewriter.getI32ArrayAttr(
+            llvm::to_vector_of<int32_t>(unsqueezedShape)));
+
+    if (unsqueezedShape != SmallVector<int64_t>(outputType.getShape())) {
+      auto broadcastDims = ttmlir::utils::getBroadcastDimensions<int64_t>(
+          unsqueezedShape, outputType.getShape());
+      auto broadcastType =
+          RankedTensorType::get(outputType.getShape(),
+                                indicesType.getElementType(),
+                                indicesType.getEncoding());
+      indices = rewriter.create<ttir::BroadcastOp>(
+          srcOp.getLoc(), broadcastType, indices,
+          rewriter.getDenseI64ArrayAttr(broadcastDims));
+    }
+  }
+
+  return indices;
+}
