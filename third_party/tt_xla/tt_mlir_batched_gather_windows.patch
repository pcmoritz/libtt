+// Converts a batched StableHLO gather of a window along one non-batch
+// dimension into ttir.gather.
+class StableHLOBatchedGatherWindowToGatherPattern
+    : public OpConversionPattern<mlir::stablehlo::GatherOp> {
+public:
+  StableHLOBatchedGatherWindowToGatherPattern(TypeConverter &typeConverter,
+                                              MLIRContext *context)
+      : OpConversionPattern<mlir::stablehlo::GatherOp>(typeConverter, context,
+                                                       /*benefit=*/4) {}
+
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::GatherOp srcOp,
+                  mlir::stablehlo::GatherOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto dimensionNumbers = srcOp.getDimensionNumbers();
+    auto operandBatchingDims = dimensionNumbers.getOperandBatchingDims();
+    auto startIndicesBatchingDims =
+        dimensionNumbers.getStartIndicesBatchingDims();
+    auto startIndexMap = dimensionNumbers.getStartIndexMap();
+    auto offsetDims = dimensionNumbers.getOffsetDims();
+
+    auto operandType =
+        mlir::cast<RankedTensorType>(srcOp.getOperand().getType());
+    auto startIndicesType =
+        mlir::cast<RankedTensorType>(srcOp.getStartIndices().getType());
+    auto sliceSizes = srcOp.getSliceSizes();
+
+    if (operandBatchingDims.empty() || startIndicesBatchingDims.empty() ||
+        startIndexMap.size() != 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Expected a batched gather of one indexed dimension");
+    }
+
+    int64_t indexedDim = startIndexMap.front();
+    if (llvm::is_contained(operandBatchingDims, indexedDim) ||
+        sliceSizes[indexedDim] == 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Expected a window along a non-batch dimension");
+    }
+
+    if (operandBatchingDims.size() != startIndicesBatchingDims.size() ||
+        operandBatchingDims.size() + 1 !=
+            static_cast<size_t>(operandType.getRank()) ||
+        offsetDims.size() != 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Expected only batch and indexed operand dimensions");
+    }
+
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult().getType()));
+    if (outputType.getRank() != operandType.getRank()) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Output rank must match operand rank");
+    }
+
+    SmallVector<int64_t> permutation;
+    for (int64_t indicesDim :
+         llvm::seq<int64_t>(startIndicesType.getRank())) {
+      if (indicesDim == dimensionNumbers.getIndexVectorDim()) {
+        continue;
+      }
+      auto batchDim = llvm::find(startIndicesBatchingDims, indicesDim);
+      if (batchDim == startIndicesBatchingDims.end()) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "All non-vector start-index dimensions must be batched");
+      }
+      permutation.push_back(
+          operandBatchingDims[batchDim - startIndicesBatchingDims.begin()]);
+    }
+
+    if (permutation.size() + 1 !=
+        static_cast<size_t>(operandType.getRank())) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Start indices rank must match the batching dimensions");
+    }
+    int64_t gatherDim = offsetDims.front();
+    permutation.insert(permutation.begin() + gatherDim, indexedDim);
+
+    Value operand = adaptor.getOperands()[0];
+    if (!llvm::is_sorted(permutation)) {
+      auto permutedShape =
+          ttmlir::utils::applyPermutation(operandType.getShape(), permutation);
+      operand = rewriter.create<ttir::PermuteOp>(
+          srcOp.getLoc(),
+          RankedTensorType::get(permutedShape, operandType.getElementType(),
+                                operandType.getEncoding()),
+          operand, permutation);
+    }
+
+    Value indices = prepareGatherIndices(
+        srcOp, adaptor.getOperands()[1], startIndicesType, outputType, rewriter,
+        operandType.getShape()[indexedDim] - sliceSizes[indexedDim]);
+    auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+    Value offsets = rewriter.create<ttir::ArangeOp>(
+        srcOp.getLoc(), indicesType, /*start=*/0,
+        /*end=*/sliceSizes[indexedDim], /*step=*/1,
+        /*arange_dimension=*/gatherDim);
+    indices = rewriter.create<ttir::AddOp>(srcOp.getLoc(), indicesType, indices,
+                                           offsets);
+
+    rewriter.replaceOpWithNewOp<ttir::GatherOp>(
+        srcOp, outputType, operand, indices,
+        rewriter.getI32IntegerAttr(static_cast<int32_t>(gatherDim)));
+    return success();
+  }
+};
