+// PermuteOp canonicalization
+//
+// A permute that moves size-1 dims only permutes the others; the size-1 dims
+// are a reshape. Written as reshape, permute, reshape, the reshapes fold into
+// the reshape next to it, and no tensor keeps a size-1 dim among its last
+// two, which TTNN pads to a whole tile. torch_tpu writes [B, S, N, H] to
+// [B, N, S, H] with B = 1 as
+//   reshape 1x2048x16x128 -> 2048x16x128x1, permute [3, 1, 0, 2],
+// which becomes
+//   reshape 1x2048x16x128 -> 2048x16x128, permute [1, 0, 2],
+//   reshape 16x2048x128 -> 1x16x2048x128.
+// Only a permute with a size-1 dim among the last two of its input or result,
+// which TTNN pads, is rewritten: the TTIR and TTNN fusions match the others by
+// rank and permutation, as concatenate_heads matches [B, N, S, H] permute
+// [0, 2, 1, 3] with B = 1. A permute next to no reshape is left as it is: its
+// reshapes would not fold.
+void mlir::tt::ttir::PermuteOp::getCanonicalizationPatterns(
+    mlir::RewritePatternSet &patterns, mlir::MLIRContext *context) {
+  patterns.add(+[](mlir::tt::ttir::PermuteOp op,
+                   mlir::PatternRewriter &rewriter) -> mlir::LogicalResult {
+    // Decomposed permutes were split on purpose.
+    if (op->hasAttr("decomposed")) {
+      return mlir::failure();
+    }
+    auto inputType = mlir::cast<mlir::RankedTensorType>(op.getInput().getType());
+    auto padsTile = [](llvm::ArrayRef<int64_t> shape) {
+      return llvm::is_contained(shape.take_back(2), 1);
+    };
+    if (!padsTile(inputType.getShape()) && !padsTile(op.getType().getShape())) {
+      return mlir::failure();
+    }
+    int64_t rank = inputType.getRank();
+    llvm::SmallVector<int64_t> compactShape;
+    llvm::SmallVector<int64_t> compactIndex(rank, -1);
+    for (int64_t d = 0; d < rank; ++d) {
+      if (inputType.getDimSize(d) != 1) {
+        compactIndex[d] = compactShape.size();
+        compactShape.push_back(inputType.getDimSize(d));
+      }
+    }
+    bool nextToReshape =
+        op.getInput().getDefiningOp<mlir::tt::ttir::ReshapeOp>() ||
+        (op->hasOneUse() &&
+         mlir::isa<mlir::tt::ttir::ReshapeOp>(*op->getUsers().begin()));
+    if (!nextToReshape) {
+      return mlir::failure();
+    }
+    llvm::SmallVector<int64_t> compactPermutation;
+    for (int64_t d : op.getPermutation()) {
+      if (compactIndex[d] >= 0) {
+        compactPermutation.push_back(compactIndex[d]);
+      }
+    }
+    mlir::Value result = mlir::tt::ttir::utils::createReshapeOp(
+        rewriter, op.getLoc(), op.getInput(), compactShape);
+    if (!llvm::is_sorted(compactPermutation)) {
+      llvm::SmallVector<int64_t> permutedShape =
+          ttmlir::utils::applyPermutation(llvm::ArrayRef(compactShape),
+                                          compactPermutation);
+      result = rewriter.create<mlir::tt::ttir::PermuteOp>(
+          op.getLoc(),
+          mlir::RankedTensorType::get(permutedShape,
+                                      inputType.getElementType(),
+                                      inputType.getEncoding()),
+          result, compactPermutation);
+    }
+    rewriter.replaceOp(op, mlir::tt::ttir::utils::createReshapeOp(
+                               rewriter, op.getLoc(), result,
+                               op.getType().getShape()));
+    return mlir::success();
+  });
+}
