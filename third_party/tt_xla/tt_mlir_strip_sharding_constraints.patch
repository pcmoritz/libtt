diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPass.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPass.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPass.cpp
