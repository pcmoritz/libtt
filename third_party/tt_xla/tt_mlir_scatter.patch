+static bool isSubtractReduction(Region &region) {
+  if (!region.hasOneBlock()) {
+    return false;
+  }
+  Block &block = region.front();
+  Operation *terminator = block.getTerminator();
+  if (block.getNumArguments() != 2 || terminator->getNumOperands() != 1) {
+    return false;
+  }
+  auto subtract = mlir::dyn_cast_or_null<mlir::stablehlo::SubtractOp>(
+      terminator->getOperand(0).getDefiningOp());
+  return subtract &&
+         subtract->getOperand(0) == block.getArgument(0) &&
+         subtract->getOperand(1) == block.getArgument(1);
