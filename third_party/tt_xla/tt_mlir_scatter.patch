+template <typename BinaryOp>
+static bool matchesBinaryScatterReducer(Block &block) {
+  if (block.getNumArguments() != 2 || block.getOperations().size() != 2) {
+    return false;
+  }
+  auto binary = mlir::dyn_cast<BinaryOp>(block.front());
+  auto returnOp =
+      mlir::dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+  return binary && returnOp && returnOp.getNumOperands() == 1 &&
+         binary.getLhs() == block.getArgument(0) &&
+         binary.getRhs() == block.getArgument(1) &&
+         returnOp.getOperand(0) == binary.getResult();
+}
+
+static std::optional<ttcore::ReduceType>
+getBinaryScatterReduceType(Region &region) {
+  if (!region.hasOneBlock()) {
+    return std::nullopt;
+  }
+  Block &block = region.front();
+  if (matchesBinaryScatterReducer<mlir::stablehlo::AddOp>(block)) {
+    return ttcore::ReduceType::Sum;
+  }
+  if (matchesBinaryScatterReducer<mlir::stablehlo::MulOp>(block)) {
+    return ttcore::ReduceType::Prod;
+  }
+  if (matchesBinaryScatterReducer<mlir::stablehlo::MaxOp>(block)) {
+    return ttcore::ReduceType::Max;
+  }
+  if (matchesBinaryScatterReducer<mlir::stablehlo::MinOp>(block)) {
+    return ttcore::ReduceType::Min;
+  }
+  return std::nullopt;
+}
+
+static bool isSubtractReduction(Region &region) {
+  if (!region.hasOneBlock()) {
+    return false;
+  }
+  Block &block = region.front();
+  if (block.getNumArguments() != 2 || block.getOperations().size() != 2) {
+    return false;
+  }
+  auto subtract = mlir::dyn_cast<mlir::stablehlo::SubtractOp>(block.front());
+  auto returnOp =
+      mlir::dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+  return subtract && returnOp && returnOp.getNumOperands() == 1 &&
+         subtract.getLhs() == block.getArgument(0) &&
+         subtract.getRhs() == block.getArgument(1) &&
+         returnOp.getOperand(0) == subtract.getResult();
+}
+
+enum class UnaryScatterApplyKind {
+  None,
+  Negate,
+  Sine,
+  Cosine,
+  Square,
+  Sqrt,
+  Log,
+  Exponential,
+  SubtractOne,
+};
+
+template <typename UnaryOp>
+static bool matchesUnaryScatterApply(Block &block) {
+  if (block.getNumArguments() != 2 || block.getOperations().size() != 2) {
+    return false;
+  }
+  auto unary = mlir::dyn_cast<UnaryOp>(block.front());
+  auto returnOp =
+      mlir::dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+  return unary && returnOp && returnOp.getNumOperands() == 1 &&
+         unary.getOperand() == block.getArgument(0) &&
+         returnOp.getOperand(0) == unary.getResult();
+}
+
+static UnaryScatterApplyKind getUnaryScatterApplyKind(Region &region) {
+  if (!region.hasOneBlock()) {
+    return UnaryScatterApplyKind::None;
+  }
+  Block &block = region.front();
+  if (block.getNumArguments() != 2) {
+    return UnaryScatterApplyKind::None;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::NegOp>(block)) {
+    return UnaryScatterApplyKind::Negate;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::SineOp>(block)) {
+    return UnaryScatterApplyKind::Sine;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::CosineOp>(block)) {
+    return UnaryScatterApplyKind::Cosine;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::SqrtOp>(block)) {
+    return UnaryScatterApplyKind::Sqrt;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::LogOp>(block)) {
+    return UnaryScatterApplyKind::Log;
+  }
+  if (matchesUnaryScatterApply<mlir::stablehlo::ExpOp>(block)) {
+    return UnaryScatterApplyKind::Exponential;
+  }
+
+  auto returnOp =
+      mlir::dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+  if (!returnOp || returnOp.getNumOperands() != 1) {
+    return UnaryScatterApplyKind::None;
+  }
+  Operation *result = returnOp.getOperand(0).getDefiningOp();
+  if (block.getOperations().size() == 2) {
+    auto multiply = mlir::dyn_cast_or_null<mlir::stablehlo::MulOp>(result);
+    if (multiply && multiply.getLhs() == block.getArgument(0) &&
+        multiply.getRhs() == block.getArgument(0)) {
+      return UnaryScatterApplyKind::Square;
+    }
+  }
+
+  auto subtract =
+      mlir::dyn_cast_or_null<mlir::stablehlo::SubtractOp>(result);
+  if (!subtract || subtract.getLhs() != block.getArgument(0)) {
+    return UnaryScatterApplyKind::None;
+  }
+  auto constant =
+      subtract.getRhs().getDefiningOp<mlir::stablehlo::ConstantOp>();
+  bool constantInBlock = constant && constant->getBlock() == &block;
+  size_t expectedOperations = constantInBlock ? 3 : 2;
+  if (block.getOperations().size() != expectedOperations) {
+    return UnaryScatterApplyKind::None;
+  }
+  DenseIntElementsAttr value;
+  if (constant) {
+    value = mlir::dyn_cast<DenseIntElementsAttr>(constant.getValue());
+  }
+  if (!value || !value.isSplat() || !value.getSplatValue<APInt>().isOne()) {
+    return UnaryScatterApplyKind::None;
+  }
+  return UnaryScatterApplyKind::SubtractOne;
+}
