+// Whether `value` is an argument of its function marked as a constant or a
+// parameter (a weight that const-eval can transform ahead of time).
+static bool isConstantOrParameterArgument(Value value) {
+  auto argument = mlir::dyn_cast<BlockArgument>(value);
+  if (!argument) {
+    return false;
+  }
+  auto funcOp =
+      mlir::dyn_cast<func::FuncOp>(argument.getOwner()->getParentOp());
+  return funcOp && ttcore::isConstantOrParameterArgumentType(
+                       funcOp, argument.getArgNumber());
+}
