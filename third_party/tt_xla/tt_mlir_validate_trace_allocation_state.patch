 namespace tt::runtime::ttnn::operations::trace {

+static size_t
+getLiveBufferAllocationWatermark(::ttnn::MeshDevice &meshDevice) {
+  size_t watermark =
+      meshDevice.allocator()->get_live_buffer_allocation_watermark();
+  // Active subdevices have allocators separate from the default mesh
+  // allocator. Include every one in the same global-id watermark.
+  for (const ::tt::tt_metal::SubDeviceId subDeviceId :
+       meshDevice.get_sub_device_ids()) {
+    watermark = std::max(
+        watermark, meshDevice.allocator(subDeviceId)
+                       ->get_live_buffer_allocation_watermark());
+  }
+  // Per-core/hybrid allocations can also be owned by physical allocators.
+  for (::tt::tt_metal::IDevice *device : meshDevice.get_devices()) {
+    watermark = std::max(
+        watermark, device->allocator()->get_live_buffer_allocation_watermark());
+  }
+  return watermark;
+}
