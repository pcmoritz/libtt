+static void appendLiveBufferAllocationLayout(
+    ::tt::tt_metal::Allocator *allocator,
+    std::unordered_set<::tt::tt_metal::Allocator *> &seenAllocators,
+    TraceAllocationLayout &layout) {
+  if (!seenAllocators.insert(allocator).second) {
+    return;
+  }
+
+  const uintptr_t allocatorKey = reinterpret_cast<uintptr_t>(allocator);
+  for (const auto &[bufferType, localAllocatorId, begin, end] :
+       allocator->get_live_buffer_allocation_layout()) {
+    layout.emplace_back(allocatorKey, bufferType, localAllocatorId, begin, end);
+  }
+}
+
+static TraceAllocationLayout
+getLiveBufferAllocationLayout(::ttnn::MeshDevice &meshDevice) {
+  TraceAllocationLayout layout;
+  std::unordered_set<::tt::tt_metal::Allocator *> seenAllocators;
+  appendLiveBufferAllocationLayout(meshDevice.allocator().get(), seenAllocators,
+                                   layout);
+  for (const ::tt::tt_metal::SubDeviceId subDeviceId :
+       meshDevice.get_sub_device_ids()) {
+    appendLiveBufferAllocationLayout(meshDevice.allocator(subDeviceId).get(),
+                                     seenAllocators, layout);
+  }
+  for (::tt::tt_metal::IDevice *device : meshDevice.get_devices()) {
+    appendLiveBufferAllocationLayout(device->allocator().get(), seenAllocators,
+                                     layout);
+  }
+  std::sort(layout.begin(), layout.end());
+  return layout;
+}
+
+static bool isLiveBufferAllocationLayoutCovered(
+    const TraceAllocationLayout &captured,
+    const TraceAllocationLayout &current) {
+  auto key = [](const TraceAllocationRegion &region) {
+    return std::tuple(std::get<0>(region), std::get<1>(region),
+                      std::get<2>(region));
+  };
+
+  size_t capturedIndex = 0;
+  for (const TraceAllocationRegion &currentRegion : current) {
+    const auto currentKey = key(currentRegion);
+    while (capturedIndex < captured.size()) {
+      const TraceAllocationRegion &capturedRegion = captured[capturedIndex];
+      const auto capturedKey = key(capturedRegion);
+      if (capturedKey < currentKey ||
+          (capturedKey == currentKey &&
+           std::get<4>(capturedRegion) <= std::get<3>(currentRegion))) {
+        ++capturedIndex;
+        continue;
+      }
+      break;
+    }
+
+    if (capturedIndex == captured.size()) {
+      return false;
+    }
+    const TraceAllocationRegion &capturedRegion = captured[capturedIndex];
+    if (key(capturedRegion) != currentKey ||
+        std::get<3>(capturedRegion) > std::get<3>(currentRegion) ||
+        std::get<4>(capturedRegion) < std::get<4>(currentRegion)) {
+      return false;
+    }
+  }
+  return true;
+}
