@@ -524,3 +524,112 @@ def test_mnist_linear_logits(helper: Helper, request, num_loops, trace_region_si

     ttrt.runtime.DebugStats.get().clear()
     helper.teardown()
+
+
+@pytest.mark.parametrize("trace_region_size", [0, 80000])
+def test_trace_caches_variants_for_live_untraced_allocation(
+    helper: Helper, request, trace_region_size
+):
+    """Distinct live-allocation layouts are captured once and then reused."""
+    traced_path = os.path.join(
+        FLATBUFFER_BASE_PATH, "matmul_multiply_no_consteval.mlir.tmp.ttnn"
+    )
+    untraced_path = os.path.join(
+        FLATBUFFER_BASE_PATH,
+        "large_neg_no_consteval.mlir.tmp.untraced.ttnn",
+    )
+    for path in (traced_path, untraced_path):
+        assert os.path.exists(path), f"Binary file not found: {path}"
+
+    helper.initialize(request.node.name, traced_path)
+    helper.check_constraints()
+
+    traced_runner = ProgramTestRunner(
+        ProgramTestConfig(
+            name="traced",
+            expected_num_inputs=3,
+            compute_golden=lambda inputs: (inputs[0] @ inputs[1]) * inputs[2],
+        ),
+        helper.binary,
+        0,
+    )
+    logger = Logger()
+    untraced_binary = Binary(logger, FileManager(logger), untraced_path)
+    untraced_binary.check_version()
+    untraced_binary.check_system_desc(helper.query)
+    untraced_runner = ProgramTestRunner(
+        ProgramTestConfig(
+            name="untraced",
+            expected_num_inputs=1,
+            compute_golden=lambda inputs: -inputs[0],
+        ),
+        untraced_binary,
+        0,
+    )
+
+    debug_stats = ttrt.runtime.DebugStats.get()
+    debug_stats.clear()
+
+    with DeviceContext(
+        mesh_shape=[1, 1],
+        enable_program_cache=True,
+        trace_region_size=trace_region_size,
+    ) as device:
+        # Prepare both inputs before capture. Holding the untraced output below
+        # guarantees at least one newer allocation remains live.
+        traced_inputs, traced_golden, _ = traced_runner.get_inputs_and_golden(
+            device
+        )
+        untraced_inputs, untraced_golden, _ = (
+            untraced_runner.get_inputs_and_golden(device)
+        )
+
+        traced_runner.run_program_and_compare_golden(
+            device, traced_inputs, traced_golden
+        )
+        assert debug_stats.get_stat("TraceCacheMiss") == 1
+        assert debug_stats.get_stat("CapturedTrace") == 1
+
+        held_untraced_output = untraced_runner.submit_program(
+            device, untraced_inputs
+        )
+        assert debug_stats.get_stat("TraceCacheMiss") == 1
+
+        # The held output was allocated after capture, so replay must recapture
+        # first. The held output must remain intact across that recapture.
+        traced_runner.run_program_and_compare_golden(
+            device, traced_inputs, traced_golden
+        )
+        assert debug_stats.get_stat("TraceStaleRecapture") == 1
+        assert_pcc(
+            _read_device_output(untraced_runner, held_untraced_output),
+            untraced_golden,
+        )
+
+        # Freeing the newer allocation restores layout A, so the original
+        # trace variant is reused without another capture.
+        ttrt.runtime.deallocate_tensor(held_untraced_output, force=True)
+        traced_runner.run_program_and_compare_golden(
+            device, traced_inputs, traced_golden
+        )
+        assert debug_stats.get_stat("TraceStaleRecapture") == 1
+        assert debug_stats.get_stat("ExecutedTrace") == 1
+
+        # Reallocating the same shape restores layout B. The Buffer object is
+        # new, but its occupied address range is covered by the second variant.
+        replacement_output = untraced_runner.submit_program(
+            device, untraced_inputs
+        )
+        traced_runner.run_program_and_compare_golden(
+            device, traced_inputs, traced_golden
+        )
+        assert debug_stats.get_stat("TraceStaleRecapture") == 1
+        assert debug_stats.get_stat("ExecutedTrace") == 2
+        assert_pcc(
+            _read_device_output(untraced_runner, replacement_output),
+            untraced_golden,
+        )
+        ttrt.runtime.deallocate_tensor(replacement_output, force=True)
+
+    debug_stats.clear()
+    helper.teardown()
