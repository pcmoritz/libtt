diff --git a/pjrt_implementation/src/api/module_builder/frontend_passes/shlo_clean_for_xla_ingestion.cc b/pjrt_implementation/src/api/module_builder/frontend_passes/shlo_clean_for_xla_ingestion.cc
--- a/pjrt_implementation/src/api/module_builder/frontend_passes/shlo_clean_for_xla_ingestion.cc
+++ b/pjrt_implementation/src/api/module_builder/frontend_passes/shlo_clean_for_xla_ingestion.cc
@@ -409,6 +409,31 @@
     auto meshOp = meshOps.front();
 
     auto manualComputationOp = manualComputationOps.front();
+    // JAX queries parameter shardings from the module metadata, not the
+    // parameter instructions. Preserve them before removing the function body.
+    auto main = module.lookupSymbol<mlir::func::FuncOp>("main");
+    llvm::SmallVector<mlir::Attribute> inputShardings(main.getNumArguments());
+    for (auto [operand, sharding] :
+         llvm::zip(manualComputationOp.getOperands(),
+                   manualComputationOp.getInShardings().getShardings())) {
+      auto argument = mlir::dyn_cast<mlir::BlockArgument>(operand);
+      if (argument && argument.getOwner() == &main.getBody().front()) {
+        auto index = argument.getArgNumber();
+        auto declared = main.getArgAttrOfType<mlir::sdy::TensorShardingAttr>(
+            index, mlir::sdy::TensorShardingAttr::name);
+        inputShardings[index] = mlir::StringAttr::get(
+            module.getContext(), internal::extractHloShardingString(
+                                     declared ? declared : sharding,
+                                     meshOp.getMeshAttr()));
+      }
+    }
+    if (llvm::all_of(inputShardings,
+                     [](mlir::Attribute attr) { return bool(attr); })) {
+      module->setAttr(
+          "mhlo.spmd_parameters_shardings",
+          mlir::ArrayAttr::get(module.getContext(), inputShardings));
+    }
+
     auto outShardingResult = internal::extractSdyManualComputationOutSharding(
         manualComputationOp, meshOp.getMeshAttr());
 
