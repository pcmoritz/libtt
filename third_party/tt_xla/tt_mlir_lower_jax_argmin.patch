+    if (!mlir::isa<FloatType>(elementType) &&
+        !mlir::isa<IntegerType>(elementType)) {
+      return false;
+    }
+
+    bool hasUnitReductionDimension =
+        inputType.getDimSize(srcOp.getDimensions().front()) == 1;
+
+    if (!hasUnitReductionDimension &&
+        !hasValidArgMaxInputs(srcOp.getInputs())) {
+      return false;
+    }
+
+    if (!hasValidArgMaxOutputs(srcOp.getResults())) {
+      return false;
+    }
+
+    if (!hasValidArgMinInitValues(srcOp.getInitValues())) {
+      return false;
+    }
+
+    if (!hasUnitReductionDimension &&
+        !hasValidArgMinReducerBody(srcOp.getBody())) {
+      return false;
+    }
+
+    return true;
+  }
