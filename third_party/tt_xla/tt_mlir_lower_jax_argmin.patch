+  matchAndRewriteInternalArgMin(mlir::stablehlo::ReduceOp &srcOp,
+                                mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                                ConversionPatternRewriter &rewriter) const {
+    mlir::Value input = adaptor.getInputs().front();
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    mlir::Type elementType = inputType.getElementType();
+    mlir::Value reversedInput;
+    if (mlir::isa<FloatType>(elementType)) {
+      reversedInput =
+          rewriter.create<ttir::NegOp>(srcOp->getLoc(), inputType, input);
+    } else {
+      auto integerType = mlir::cast<IntegerType>(elementType);
+      if (integerType.getWidth() == 1) {
+        reversedInput = rewriter.create<ttir::LogicalNotOp>(
+            srcOp->getLoc(), inputType, input);
+      } else {
+        reversedInput = rewriter.create<ttir::BitwiseNotOp>(
+            srcOp->getLoc(), inputType, input);
+      }
+    }
+    // TODO: Remove this permutation once tt-metal supports row-major argmax
+    // reductions on non-last dimensions.
+    int64_t dimension = srcOp.getDimensions().front();
+    int64_t rank = inputType.getRank();
+    if (dimension != rank - 1) {
+      llvm::SmallVector<int64_t> permutation;
+      llvm::SmallVector<int64_t> permutedShape;
+      for (int64_t i = 0; i < rank; ++i) {
+        if (i != dimension) {
+          permutation.push_back(i);
+          permutedShape.push_back(inputType.getDimSize(i));
+        }
+      }
+      permutation.push_back(dimension);
+      permutedShape.push_back(inputType.getDimSize(dimension));
+      auto permutedType = RankedTensorType::get(
+          permutedShape, elementType, inputType.getEncoding());
+      reversedInput = rewriter.create<ttir::PermuteOp>(
+          srcOp->getLoc(), permutedType, reversedInput, permutation);
+      dimension = rank - 1;
+    }
+
+    mlir::ArrayAttr dimArg = rewriter.getI32ArrayAttr(
+        llvm::SmallVector<int32_t>{static_cast<int32_t>(dimension)});
+    return matchAndRewriteInternalArgMax(srcOp, reversedInput, rewriter,
+                                         dimArg);
+  }
