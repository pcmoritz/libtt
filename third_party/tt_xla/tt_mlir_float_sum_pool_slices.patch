 private:
+  // Sums a float32 or float16 window one dimension at a time: each window
+  // dimension adds its strided slices of the zero-padded input, so a window
+  // takes the sum of its sizes in slices rather than their product. Returns
+  // nullopt for other inputs and for windows of more than 64 slices, which
+  // take the ttnn pooling path.
+  std::optional<Value> sumWindowSlices(mlir::stablehlo::ReduceWindowOp srcOp,
+                                       Value input,
+                                       DenseI64ArrayAttr windowDimensions,
+                                       DenseI64ArrayAttr windowStrides,
+                                       DenseI64ArrayAttr windowDilations,
+                                       DenseI64ArrayAttr padding,
+                                       ConversionPatternRewriter &rewriter) const {
+    constexpr int64_t kMaxSlices = 64;
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+    Type elementType = inputType.getElementType();
+    ArrayRef<int64_t> window = windowDimensions.asArrayRef();
+    ArrayRef<int64_t> strides = windowStrides.asArrayRef();
+    ArrayRef<int64_t> dilations = windowDilations.asArrayRef();
+    ArrayRef<int64_t> pads = padding.asArrayRef();
+    int64_t rank = inputType.getRank();
+    int64_t numSlices =
+        std::accumulate(window.begin(), window.end(), int64_t{0});
+    if (!(elementType.isF32() || elementType.isF16()) ||
+        numSlices > kMaxSlices || !inputType.hasStaticShape() ||
+        !resultType.hasStaticShape() || resultType.getNumElements() == 0 ||
+        llvm::any_of(pads, [](int64_t pad) { return pad < 0; })) {
+      return std::nullopt;
+    }
+
+    Location loc = srcOp.getLoc();
+    SmallVector<int64_t> shape(inputType.getShape());
+    if (llvm::any_of(pads, [](int64_t pad) { return pad != 0; })) {
+      for (int64_t d = 0; d < rank; ++d) {
+        shape[d] += pads[2 * d] + pads[2 * d + 1];
+      }
+      input = rewriter.create<ttir::PadOp>(
+          loc, RankedTensorType::get(shape, elementType,
+                                     inputType.getEncoding()),
+          input,
+          rewriter.getDenseI32ArrayAttr(
+              SmallVector<int32_t>(pads.begin(), pads.end())),
+          rewriter.getF32FloatAttr(0.0));
+    }
+
+    for (int64_t d = 0; d < rank; ++d) {
+      int64_t outputSize = resultType.getDimSize(d);
+      if (window[d] == 1 && strides[d] == 1 && shape[d] == outputSize) {
+        continue;
+      }
+      SmallVector<int32_t> begins(rank, 0), ends(shape.begin(), shape.end()),
+          steps(rank, 1);
+      shape[d] = outputSize;
+      auto sliceType = RankedTensorType::get(shape, elementType,
+                                             resultType.getEncoding());
+      Value sum;
+      for (int64_t offset = 0; offset < window[d]; ++offset) {
+        begins[d] = offset * dilations[d];
+        ends[d] = begins[d] + (outputSize - 1) * strides[d] + 1;
+        steps[d] = strides[d];
+        Value slice = rewriter.create<ttir::SliceStaticOp>(
+            loc, sliceType, input, rewriter.getI32ArrayAttr(begins),
+            rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+        sum = sum ? rewriter.create<ttir::AddOp>(loc, sliceType, sum, slice)
+                        .getResult()
+                  : slice;
+      }
+      input = sum;
+    }
+    return input;
+  }
+
