 namespace {
+// Explicit recurrent calls use the same in-place cache contract as paged KV
+// ops. The FFI returns an alias for functional JAX; the dialect retains the
+// cache operand.
+class StableHLORecurrentOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CustomCallOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CustomCallOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto name = op.getCallTargetName();
+    if (name == "tt.gated_delta_rule") {
+      if (op.getNumOperands() != 6 || op.getNumResults() != 2) {
+        return op.emitOpError("invalid recurrent call arity");
+      }
+      SmallVector<Type> types;
+      if (failed(
+              getTypeConverter()->convertTypes(op.getResultTypes(), types))) {
+        return failure();
+      }
+      rewriter.replaceOpWithNewOp<ttir::GatedDeltaRuleOp>(
+          op, types, adaptor.getOperands());
+      return success();
+    }
+    if (name == "tt.gated_delta_decode") {
+      if (op.getNumOperands() != 10 || op.getNumResults() != 2) {
+        return op.emitOpError("invalid recurrent call arity");
+      }
+      if (failed(requireOutputOperandAlias(op, 0, 0))) {
+        return failure();
+      }
+      auto type = getTypeConverter()->convertType(op.getResult(1).getType());
+      auto result = rewriter.create<ttir::GatedDeltaDecodeOp>(
+          op.getLoc(), type, adaptor.getOperands());
+      rewriter.replaceOp(op, {adaptor.getOperands()[0], result.getResult()});
+      return success();
+    }
+    if (name == "tt.causal_conv1d_update") {
+      if (op.getNumOperands() != 5 || op.getNumResults() != 2) {
+        return op.emitOpError("invalid recurrent call arity");
+      }
+      if (failed(requireOutputOperandAlias(op, 0, 0))) {
+        return failure();
+      }
+      auto type = getTypeConverter()->convertType(op.getResult(1).getType());
+      auto result = rewriter.create<ttir::CausalConv1dUpdateOp>(
+          op.getLoc(), type, adaptor.getOperands());
+      rewriter.replaceOp(op, {adaptor.getOperands()[0], result.getResult()});
+      return success();
+    }
+    if (name == "tt.state_pool_update") {
+      if (op.getNumOperands() != 3 || op.getNumResults() != 1) {
+        return op.emitOpError("invalid recurrent call arity");
+      }
+      if (failed(requireOutputOperandAlias(op, 0, 0))) {
+        return failure();
+      }
+      rewriter.create<ttir::StatePoolUpdateOp>(op.getLoc(), TypeRange{},
+                                               adaptor.getOperands());
+      rewriter.replaceOp(op, adaptor.getOperands()[0]);
+      return success();
+    }
+    return failure();
+  }
+};
