diff --git a/runtime/lib/ttnn/operations/transformer/recurrent.cpp b/runtime/lib/ttnn/operations/transformer/recurrent.cpp
--- /dev/null
+++ b/runtime/lib/ttnn/operations/transformer/recurrent.cpp
@@ -0,0 +1,115 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+#include "operations/transformer/recurrent.h"
+#include "tt/runtime/detail/ttnn/operations/utils.h"
+#include "tt/runtime/detail/ttnn/ttnn.h"
+#include "tt/runtime/detail/ttnn/utils.h"
+#include "ttnn/operations/transformer/chunk_gated_delta_rule/chunk_gated_delta_rule.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/causal_conv1d_update.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/causal_conv1d_prefill.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/gated_delta_decode.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/state_pool_update.hpp"
+
+namespace tt::runtime::ttnn::operations::transformer {
+namespace {
+::ttnn::Tensor
+tiled(const ::ttnn::Tensor &input, ::ttnn::DataType dtype,
+      const ::ttnn::MemoryConfig &config = ::ttnn::DRAM_MEMORY_CONFIG) {
+  auto result = input;
+  if (result.layout() != ::ttnn::Layout::TILE) {
+    result = ::ttnn::to_layout(result, ::ttnn::Layout::TILE, dtype, config);
+  } else if (result.dtype() != dtype) {
+    result = ::ttnn::typecast(result, dtype, config);
+  }
+  return result.memory_config() == config
+             ? result
+             : ::ttnn::to_memory_config(result, config);
+}
+void put(ProgramTensorPool &pool, const ::tt::target::ttnn::TensorRef *ref,
+         const ::ttnn::Tensor &tensor) {
+  auto config = ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+      ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(ref));
+  pool.insertTTNNTensorAndValidate(
+      ref, tiled(tensor, utils::getDataType(ref),
+                 config.value_or(::ttnn::DRAM_MEMORY_CONFIG)));
+}
+} // namespace
+
+void run(const ::tt::target::ttnn::GatedDeltaRuleOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  auto [output, state] = ::ttnn::transformer::chunk_gated_delta_rule(
+      get(op->query()), get(op->key()), get(op->value()), get(op->gate()),
+      get(op->beta()), 1.0f,
+      tiled(get(op->initial_state()), ::ttnn::DataType::FLOAT32), true, 32,
+      false, false,
+      ::ttnn::DRAM_MEMORY_CONFIG, std::nullopt, get(op->eye()), get(op->tril()),
+      get(op->ones()), get(op->masks()));
+  put(pool, op->final_state(), state.value());
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::GatedDeltaDecodeOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  const auto &query = get(op->query());
+  const auto &shape = query.logical_shape();
+  const uint32_t batch = shape[0], heads = shape[1], dim = shape[2];
+  auto vector = [&](const auto *ref) {
+    return tiled(get(ref), ::ttnn::DataType::FLOAT32);
+  };
+  auto output = ::ttnn::empty(::ttnn::Shape{batch, heads, 1, dim},
+                              ::ttnn::DataType::FLOAT32, ::ttnn::Layout::TILE,
+                              query.device(), ::ttnn::DRAM_MEMORY_CONFIG);
+  ::ttnn::transformer::gated_delta_decode(
+      vector(op->query()), vector(op->key()), vector(op->value()),
+      tiled(get(op->beta_logits()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->delta_time()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->a_log()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->dt_bias()), ::ttnn::DataType::FLOAT32), get(op->cache()),
+      output, tiled(get(op->state_indices()), ::ttnn::DataType::INT32),
+      tiled(get(op->has_initial_state()), ::ttnn::DataType::BFLOAT16));
+  put(pool, op->output(),
+      ::ttnn::reshape(output, ::ttnn::Shape{batch, heads, dim}));
+}
+
+void run(const ::tt::target::ttnn::CausalConv1dPrefillOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto output = ::ttnn::transformer::causal_conv1d_prefill(
+      tiled(pool.getTTNNTensorAndValidate(op->history()), ::ttnn::DataType::BFLOAT16),
+      tiled(pool.getTTNNTensorAndValidate(op->weight()), ::ttnn::DataType::BFLOAT16));
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::CausalConv1dUpdateOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  auto output = ::ttnn::transformer::causal_conv1d_update(
+      tiled(get(op->input()), ::ttnn::DataType::BFLOAT16), get(op->cache()),
+      tiled(get(op->weight()), ::ttnn::DataType::BFLOAT16),
+      tiled(get(op->state_indices()), ::ttnn::DataType::INT32),
+      tiled(get(op->has_initial_state()), ::ttnn::DataType::BFLOAT16));
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::StatePoolUpdateOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  const auto &cache = pool.getTTNNTensorAndValidate(op->cache());
+  ::ttnn::transformer::state_pool_update(
+      cache,
+      tiled(pool.getTTNNTensorAndValidate(op->state_indices()),
+            ::ttnn::DataType::INT32),
+      tiled(pool.getTTNNTensorAndValidate(op->updates()), cache.dtype()));
+}
+} // namespace tt::runtime::ttnn::operations::transformer
diff --git a/lib/Dialect/TTIR/Transforms/TTIRFusing.cpp b/lib/Dialect/TTIR/Transforms/TTIRFusing.cpp
--- a/lib/Dialect/TTIR/Transforms/TTIRFusing.cpp
+++ b/lib/Dialect/TTIR/Transforms/TTIRFusing.cpp
@@ -533,5 +533,134 @@
 //
 // When multiply inputs and output are typecasted, the typecasts are ignored and
 // silu op is done in the type of the sigmoid input.
+// Fuse the four FP32 products and ordered sum feeding SiLU. The FP32 result
+// keeps the existing final typecast, including its rounding behavior.
+class CausalConv1dPrefillFusion : public OpRewritePattern<SiluOp> {
+  using OpRewritePattern<SiluOp>::OpRewritePattern;
+
+  static Value stripViews(Value value) {
+    while (true) {
+      if (auto reshape = value.getDefiningOp<ReshapeOp>()) {
+        value = reshape.getInput();
+      } else if (auto broadcast = value.getDefiningOp<BroadcastOp>()) {
+        value = broadcast.getInput();
+      } else {
+        return value;
+      }
+    }
+  }
+
+  static bool shapeIs(Value value, ArrayRef<int64_t> shape, bool fp32 = false) {
+    auto type = dyn_cast<RankedTensorType>(value.getType());
+    return type && type.getShape() == shape &&
+           (fp32 ? type.getElementType().isF32()
+                 : type.getElementType().isBF16());
+  }
+
+  static bool isSlice(SliceStaticOp slice, ArrayRef<int32_t> begins,
+                      ArrayRef<int32_t> ends) {
+    auto matches = [](ArrayAttr attr, ArrayRef<int32_t> values) {
+      return attr.size() == values.size() &&
+             llvm::equal(attr, values, [](Attribute a, int32_t v) {
+               return cast<IntegerAttr>(a).getInt() == v;
+             });
+    };
+    return slice && matches(slice.getBegins(), begins) &&
+           matches(slice.getEnds(), ends) && matches(slice.getStep(), {1, 1});
+  }
+
+  static Value matchWeight(Value value, int32_t channels, int32_t tap) {
+    auto broadcast = value.getDefiningOp<BroadcastOp>();
+    if (!broadcast || !shapeIs(broadcast.getInput(), {1, channels}, true))
+      return {};
+    auto castOp = stripViews(broadcast.getInput()).getDefiningOp<TypecastOp>();
+    if (!castOp || !castOp.getType().getElementType().isF32())
+      return {};
+    auto slice = stripViews(castOp.getInput()).getDefiningOp<SliceStaticOp>();
+    if (!isSlice(slice, {0, tap}, {channels, tap + 1}) ||
+        !shapeIs(slice.getInput(), {channels, 4}))
+      return {};
+    return slice.getInput();
+  }
+
+public:
+  LogicalResult matchAndRewrite(SiluOp silu,
+                                PatternRewriter &rewriter) const final {
+    auto type = silu.getType();
+    if (!type.hasStaticShape() || type.getRank() != 2 ||
+        !type.getElementType().isF32() || type.getDimSize(0) <= 0 ||
+        type.getDimSize(1) <= 0 || type.getDimSize(0) % 32 ||
+        type.getDimSize(1) % 32)
+      return rewriter.notifyMatchFailure(
+          silu, "requires static tile-aligned FP32 output");
+    if (!silu->hasOneUse())
+      return rewriter.notifyMatchFailure(silu,
+                                         "SiLU must feed only a BF16 cast");
+    auto outputCast = dyn_cast<TypecastOp>(*silu->getUsers().begin());
+    if (!outputCast || !outputCast.getType().getElementType().isBF16())
+      return rewriter.notifyMatchFailure(silu, "SiLU must feed a BF16 cast");
+    const int32_t rows = type.getDimSize(0), channels = type.getDimSize(1);
+    Value sum = silu.getInput();
+    SmallVector<Value> products(4);
+    for (int tap = 3; tap >= 0; --tap) {
+      auto add = sum.getDefiningOp<AddOp>();
+      if (!add || !add->hasOneUse() || add.getType() != type)
+        return rewriter.notifyMatchFailure(
+            silu, "requires four ordered, unshared additions");
+      products[tap] = add.getRhs();
+      sum = add.getLhs();
+    }
+    auto zero = stripViews(sum);
+    auto full = zero.getDefiningOp<FullOp>();
+    auto fill = full ? dyn_cast<FloatAttr>(full.getFillValue()) : FloatAttr();
+    if (!matchPattern(zero, m_PosZeroFloat()) &&
+        !(fill && fill.getValue().isPosZero()))
+      return rewriter.notifyMatchFailure(silu, "requires a zero initial sum");
+
+    Value history, weight;
+    for (int32_t tap = 0; tap < 4; ++tap) {
+      auto mul = products[tap].getDefiningOp<MultiplyOp>();
+      if (!mul || !mul->hasOneUse() || mul.getType() != type)
+        return rewriter.notifyMatchFailure(silu,
+                                           "requires unshared FP32 products");
+      Value tapWeight = matchWeight(mul.getRhs(), channels, tap);
+      Value window = mul.getLhs();
+      if (!tapWeight) {
+        tapWeight = matchWeight(mul.getLhs(), channels, tap);
+        window = mul.getRhs();
+      }
+      if (!tapWeight || (weight && weight != tapWeight))
+        return rewriter.notifyMatchFailure(
+            silu, "requires four taps from the same BF16 weight");
+      weight = tapWeight;
+      auto castOp = window.getDefiningOp<TypecastOp>();
+      if (!castOp || castOp.getType() != type ||
+          !shapeIs(castOp.getInput(), {rows, channels}))
+        return rewriter.notifyMatchFailure(
+            silu, "requires BF16 input windows cast to FP32");
+      window = castOp.getInput();
+      auto slice = window.getDefiningOp<SliceStaticOp>();
+      if (isSlice(slice, {tap, 0}, {tap + rows, channels})) {
+        if (!shapeIs(slice.getInput(), {rows + 3, channels}) ||
+            (history && history != slice.getInput()))
+          return rewriter.notifyMatchFailure(
+              silu, "requires four windows from the same history");
+        history = slice.getInput();
+      } else {
+        // Canonicalization can replace the last window with concat's input.
+        auto concat = history ? history.getDefiningOp<ConcatOp>() : ConcatOp();
+        if (tap != 3 || !concat || concat.getDim() != 0 ||
+            concat.getInputs().size() != 2 ||
+            !shapeIs(concat.getInputs()[0], {3, channels}) ||
+            concat.getInputs()[1] != window)
+          return rewriter.notifyMatchFailure(
+              silu, "requires the final window from the history concat");
+      }
+    }
+    rewriter.replaceOpWithNewOp<CausalConv1dPrefillOp>(silu, type, history,
+                                                       weight);
+    return success();
+  }
+};
