 namespace {
+template <typename SrcOp, typename DstOp>
+class RecurrentOpConversionPattern : public OpConversionPattern<SrcOp> {
+public:
+  using OpConversionPattern<SrcOp>::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(SrcOp op, typename SrcOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(this->getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                      types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<DstOp>(op, types, adaptor.getOperands());
+    return success();
+  }
+};
+class GatedDeltaRuleOpConversionPattern
+    : public OpConversionPattern<ttir::GatedDeltaRuleOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(ttir::GatedDeltaRuleOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(getTypeConverter()->convertTypes(op->getResultTypes(), types))) {
+      return failure();
+    }
+
+    // TTNN's chunk kernel needs FP32 constants resident before trace capture.
+    // Keep these implementation details out of the frontend GDN interface.
+    constexpr int64_t tile = 32;
+    SmallVector<float> eye(tile * tile), tril(tile * tile);
+    SmallVector<float> ones(tile * tile, 1.0f), masks(tile * tile * 3);
+    for (int64_t row = 0; row < tile; ++row) {
+      for (int64_t col = 0; col < tile; ++col) {
+        eye[row * tile + col] = row == col;
+        tril[row * tile + col] = row >= col;
+        // Top-left, bottom-right and bottom-left 16x16 quadrant masks.
+        masks[row * tile * 3 + col] = row < tile / 2 && col < tile / 2;
+        masks[row * tile * 3 + tile + col] = row >= tile / 2 && col >= tile / 2;
+        masks[row * tile * 3 + 2 * tile + col] = row >= tile / 2 && col < tile / 2;
+      }
+    }
+
+    auto *ctx = rewriter.getContext();
+    Value device = ttnn::utils::getOrInsertDevice(rewriter, op);
+    SmallVector<Value> operands(adaptor.getOperands());
+    auto appendConstant = [&](ArrayRef<float> values, int64_t width) {
+      SmallVector<int64_t> shape{1, 1, tile, width};
+      auto valueType = RankedTensorType::get(shape, rewriter.getF32Type());
+      auto layout =
+          ttnn::TTNNLayoutAttr::Builder(
+              ctx, shape,
+              ttnn::utils::getElementType(ctx, ttnn::Layout::Tile,
+                                         ttcore::DataType::Float32))
+              .setBufferType(ttnn::BufferType::DRAM)
+              .setMemoryLayout(ttnn::TensorMemoryLayout::Interleaved)
+              .build();
+      auto type = RankedTensorType::get(shape, rewriter.getF32Type(), layout);
+      operands.push_back(rewriter.create<ttnn::ConstantOp>(
+          op.getLoc(), type, device, DenseElementsAttr::get(valueType, values)));
+    };
+    appendConstant(eye, tile);
+    appendConstant(tril, tile);
+    appendConstant(ones, tile);
+    appendConstant(masks, 3 * tile);
+    rewriter.replaceOpWithNewOp<ttnn::GatedDeltaRuleOp>(op, types, operands);
+    return success();
+  }
+};
+using GatedDeltaDecodeOpConversionPattern =
+    RecurrentOpConversionPattern<ttir::GatedDeltaDecodeOp,
+                                 ttnn::GatedDeltaDecodeOp>;
+using CausalConv1dUpdateOpConversionPattern =
