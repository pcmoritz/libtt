+#include "operations/transformer/recurrent.h"
+#include "tt/runtime/detail/ttnn/operations/utils.h"
+#include "tt/runtime/detail/ttnn/ttnn.h"
+#include "tt/runtime/detail/ttnn/utils.h"
+#include "ttnn/operations/transformer/chunk_gated_delta_rule/chunk_gated_delta_rule.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/causal_conv1d_update.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/gated_delta_decode.hpp"
+#include "ttnn/operations/transformer/gated_delta_attn/state_pool_update.hpp"
+
+namespace tt::runtime::ttnn::operations::transformer {
+namespace {
+::ttnn::Tensor
+tiled(const ::ttnn::Tensor &input, ::ttnn::DataType dtype,
+      const ::ttnn::MemoryConfig &config = ::ttnn::DRAM_MEMORY_CONFIG) {
+  auto result = input;
+  if (result.layout() != ::ttnn::Layout::TILE) {
+    result = ::ttnn::to_layout(result, ::ttnn::Layout::TILE, dtype, config);
+  } else if (result.dtype() != dtype) {
+    result = ::ttnn::typecast(result, dtype, config);
+  }
+  return result.memory_config() == config
+             ? result
+             : ::ttnn::to_memory_config(result, config);
+}
+void put(ProgramTensorPool &pool, const ::tt::target::ttnn::TensorRef *ref,
+         const ::ttnn::Tensor &tensor) {
+  auto config = ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+      ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(ref));
+  pool.insertTTNNTensorAndValidate(
+      ref, tiled(tensor, utils::getDataType(ref),
+                 config.value_or(::ttnn::DRAM_MEMORY_CONFIG)));
+}
+} // namespace
+
+void run(const ::tt::target::ttnn::GatedDeltaRuleOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  auto [output, state] = ::ttnn::transformer::chunk_gated_delta_rule(
+      get(op->query()), get(op->key()), get(op->value()), get(op->gate()),
+      get(op->beta()), 1.0f,
+      tiled(get(op->initial_state()), ::ttnn::DataType::FLOAT32), true, 32,
+      false, false,
+      ::ttnn::DRAM_MEMORY_CONFIG, std::nullopt, get(op->eye()), get(op->tril()),
+      get(op->ones()), get(op->masks()));
+  put(pool, op->final_state(), state.value());
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::GatedDeltaDecodeOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  auto vector = [&](const auto *ref) {
+    return tiled(get(ref), ::ttnn::DataType::FLOAT32);
+  };
+  auto output = ::ttnn::transformer::gated_delta_decode(
+      vector(op->query()), vector(op->key()), vector(op->value()),
+      tiled(get(op->beta_logits()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->delta_time()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->a_log()), ::ttnn::DataType::FLOAT32),
+      tiled(get(op->dt_bias()), ::ttnn::DataType::FLOAT32), get(op->cache()),
+      tiled(get(op->state_indices()), ::ttnn::DataType::INT32),
+      tiled(get(op->has_initial_state()), ::ttnn::DataType::BFLOAT16));
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::CausalConv1dUpdateOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  auto get = [&](const auto *ref) -> const ::ttnn::Tensor & {
+    return pool.getTTNNTensorAndValidate(ref);
+  };
+  auto output = ::ttnn::transformer::causal_conv1d_update(
+      tiled(get(op->input()), ::ttnn::DataType::BFLOAT16), get(op->cache()),
+      tiled(get(op->weight()), ::ttnn::DataType::BFLOAT16),
+      tiled(get(op->state_indices()), ::ttnn::DataType::INT32),
+      tiled(get(op->has_initial_state()), ::ttnn::DataType::BFLOAT16));
+  put(pool, op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::StatePoolUpdateOp *op,
+         ProgramContext &context) {
+  auto &pool = context.getTensorPool();
+  const auto &cache = pool.getTTNNTensorAndValidate(op->cache());
+  ::ttnn::transformer::state_pool_update(
+      cache,
+      tiled(pool.getTTNNTensorAndValidate(op->state_indices()),
+            ::ttnn::DataType::INT32),
+      tiled(pool.getTTNNTensorAndValidate(op->updates()), cache.dtype()));
+}
+} // namespace tt::runtime::ttnn::operations::transformer
