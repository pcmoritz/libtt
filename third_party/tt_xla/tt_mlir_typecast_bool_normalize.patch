+namespace {
+class StableHLOToTTIRConvertOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ConvertOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::ConvertOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConvertOp srcOp,
+                  mlir::stablehlo::ConvertOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto inputType = cast<RankedTensorType>(srcOp.getOperand().getType());
+    auto inputIntegerType =
+        dyn_cast<IntegerType>(inputType.getElementType());
+    auto resultType = cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    if (!inputIntegerType || inputIntegerType.getWidth() != 1) {
+      rewriter.replaceOpWithNewOp<ttir::TypecastOp>(
+          srcOp, resultType, adaptor.getOperand());
+      return success();
+    }
+
+    auto zeroValue = rewriter.getZeroAttr(resultType.getElementType());
+    auto oneValue = rewriter.getOneAttr(resultType.getElementType());
+    if (!zeroValue || !oneValue) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "unsupported boolean conversion result type");
+    }
+
+    auto zeroAttr = DenseElementsAttr::get(resultType, zeroValue);
+    auto oneAttr = DenseElementsAttr::get(resultType, oneValue);
+    Value zero = rewriter.create<ttir::ConstantOp>(
+        srcOp.getLoc(), resultType, zeroAttr);
+    Value one = rewriter.create<ttir::ConstantOp>(
+        srcOp.getLoc(), resultType, oneAttr);
+    rewriter.replaceOpWithNewOp<ttir::WhereOp>(
+        srcOp, resultType, adaptor.getOperand(), one, zero);
+    return success();
+  }
+};
+} // namespace
