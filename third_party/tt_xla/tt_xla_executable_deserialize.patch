+  std::string_view body = payload.substr(sizeof(header));
+  bool in_bounds = true;
+  auto section = [&](uint64_t offset, uint64_t size) {
+    if (offset > body.size() || size > body.size() - offset) {
+      in_bounds = false;
+      return std::string_view();
+    }
+    return body.substr(offset, size);
+  };
+  SerializedExecutableSections sections{
+      .ttnn_mlir = section(header.ttnn_offset, header.ttnn_size),
+      .flatbuffer = section(header.fb_offset, header.fb_size),
+      .mlir_code = section(header.mlir_offset, header.mlir_size),
+      .compile_options = section(header.options_offset, header.options_size)};
+  // Only flatbuffer executables can be loaded.
+  if (!in_bounds || sections.flatbuffer.empty()) {
+    return std::nullopt;
+  }
+  return sections;
+}
+
 } // namespace tt::pjrt
