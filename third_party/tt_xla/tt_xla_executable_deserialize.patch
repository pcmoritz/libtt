+PJRT_Error *onExecutableDeserializeAndLoad(
+    PJRT_Executable_DeserializeAndLoad_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "ClientInstance::PJRT_Executable_DeserializeAndLoad");
+
+  std::optional<SerializedExecutableSections> sections =
+      SerializedExecutableInstance::parse(std::string_view(
+          args->serialized_executable, args->serialized_executable_size));
+  if (!sections) {
+    return *ErrorInstance::makeError(
+                tt_pjrt_status::kInvalidArgument,
+                "Not an executable serialized by this build of the plugin")
+                .release();
+  }
+  tt::runtime::Binary flatbuffer(tt::runtime::Flatbuffer::loadFromMemory(
+      sections->flatbuffer.data(), sections->flatbuffer.size()));
+  // The build ID already pins the flatbuffer schema; this is a backstop.
+  if (!flatbuffer.checkSchemaHash()) {
+    return *ErrorInstance::makeError(
+                tt_pjrt_status::kInvalidArgument,
+                "The serialized flatbuffer has another schema than the runtime")
+                .release();
+  }
+  module_builder::CompiledProgram compiled_program{
+      std::string(sections->ttnn_mlir), std::move(flatbuffer)};
+  PJRT_Program program{
+      .struct_size = PJRT_Program_STRUCT_SIZE,
+      .extension_start = nullptr,
+      .code = const_cast<char *>(sections->mlir_code.data()),
+      .code_size = sections->mlir_code.size(),
+      .format = module_builder::c_mlir_format_name.data(),
+      .format_size = module_builder::c_mlir_format_name.size()};
+  // Overriding options give the executable's devices and shardings, but those
+  // that only steer the TTIR to TTNN pipeline do nothing, since the TTNN
+  // program comes from the payload.
+  std::string_view compile_options =
+      args->overridden_serialized_compile_options
+          ? std::string_view(args->overridden_serialized_compile_options,
+                             args->overridden_serialized_compile_options_size)
+          : sections->compile_options;
+  return compileProgram(args->client, &program, compile_options,
+                        &compiled_program, &args->loaded_executable);
+}
