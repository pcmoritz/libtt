+std::optional<SerializedExecutableSections>
+SerializedExecutableInstance::parse(std::string_view payload) {
+  SerializationHeader header;
+  if (payload.size() < sizeof(header)) {
+    return std::nullopt;
+  }
+  std::memcpy(&header, payload.data(), sizeof(header));
+  if (std::memcmp(header.magic, SerializationHeader::c_magic,
+                  sizeof(header.magic)) != 0) {
+    return std::nullopt;
+  }
+  std::string_view body = payload.substr(sizeof(header));
+  bool in_bounds = true;
+  auto section = [&](uint64_t offset, uint64_t size) {
+    if (offset > body.size() || size > body.size() - offset) {
+      in_bounds = false;
+      return std::string_view();
+    }
+    return body.substr(offset, size);
+  };
+  SerializedExecutableSections sections{
+      .ttnn_mlir = section(header.ttnn_offset, header.ttnn_size),
+      .flatbuffer = section(header.fb_offset, header.fb_size),
+      .mlir_code = section(header.mlir_offset, header.mlir_size),
+      .compile_options = section(header.options_offset, header.options_size)};
+  std::string_view build_id =
+      section(header.build_id_offset, header.build_id_size);
+  // Only flatbuffer executables can be loaded, and only by the build of the
+  // plugin that wrote them. Without a build ID, nothing can be.
+  if (!in_bounds || sections.flatbuffer.empty() || pluginBuildId().empty() ||
+      build_id != pluginBuildId()) {
+    return std::nullopt;
+  }
+  return sections;
+}
