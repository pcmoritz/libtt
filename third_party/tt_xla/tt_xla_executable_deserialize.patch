+// Returns the GNU build ID of the plugin library, which the linker hashes from
+// the library's contents, so that it changes with any change to the compiler or
+// the runtime. Empty if the library has none.
+std::string_view pluginBuildId() {
+  static const std::string build_id = [] {
+    std::string build_id;
+    dl_iterate_phdr(
+        [](dl_phdr_info *info, size_t, void *data) -> int {
+          std::span<const ElfW(Phdr)> phdrs(info->dlpi_phdr, info->dlpi_phnum);
+          auto address = reinterpret_cast<ElfW(Addr)>(&pluginBuildId);
+          if (std::ranges::none_of(phdrs, [&](const ElfW(Phdr) & phdr) {
+                ElfW(Addr) start = info->dlpi_addr + phdr.p_vaddr;
+                return phdr.p_type == PT_LOAD && address >= start &&
+                       address < start + phdr.p_memsz;
+              })) {
+            return 0;
+          }
+          for (const ElfW(Phdr) &phdr : phdrs) {
+            if (phdr.p_type != PT_NOTE) {
+              continue;
+            }
+            // A note's name and descriptor are padded to the segment's
+            // alignment, 4 or 8 bytes.
+            ElfW(Addr) align = std::max<ElfW(Addr)>(phdr.p_align, 4);
+            auto padded = [&](ElfW(Addr) size) {
+              return (size + align - 1) & ~(align - 1);
+            };
+            const char *note =
+                reinterpret_cast<const char *>(info->dlpi_addr + phdr.p_vaddr);
+            const char *end = note + phdr.p_memsz;
+            while (note + sizeof(ElfW(Nhdr)) <= end) {
+              const auto *header = reinterpret_cast<const ElfW(Nhdr) *>(note);
+              const char *name = note + sizeof(ElfW(Nhdr));
+              const char *desc = name + padded(header->n_namesz);
+              if (header->n_type == NT_GNU_BUILD_ID &&
+                  header->n_namesz == 4 && std::memcmp(name, "GNU", 4) == 0) {
+                static_cast<std::string *>(data)->assign(desc,
+                                                         header->n_descsz);
+                return 1;
+              }
+              note = desc + padded(header->n_descsz);
+            }
+          }
+          return 1;
+        },
+        &build_id);
+    return build_id;
+  }();
+  return build_id;
+}
