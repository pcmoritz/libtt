diff --git a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
--- a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
+++ b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
@@ -2617,11 +2617,17 @@ public:
   LogicalResult
   matchAndRewrite(ttir::TypecastOp op, ttir::TypecastOp::Adaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
-    auto resultType = op.getType();
+    RankedTensorType resultType = op.getType();
+    auto resultIntegerType =
+        dyn_cast<IntegerType>(resultType.getElementType());
+    bool truncate =
+        isa<FloatType>(op.getInput().getType().getElementType()) &&
+        resultIntegerType && resultIntegerType.isUnsigned() &&
+        resultIntegerType.getWidth() == 16;
 
     rewriter.replaceOpWithNewOp<ttnn::TypecastOp>(
         op, this->getTypeConverter()->convertType(resultType),
-        adaptor.getInput());
+        adaptor.getInput(), truncate);
     return success();
   }
 };
