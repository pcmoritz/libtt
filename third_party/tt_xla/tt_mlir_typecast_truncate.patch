         srcOp, adaptor, rewriter);
 
+    mlir::Attribute input;
+    if (srcOp.getTruncate()) {
+      auto tensorType = mlir::cast<emitc::OpaqueType>(
+          getTypeConverter()->convertType(srcOp.getInput().getType()));
+      auto trunc = rewriter.create<emitc::CallOpaqueOp>(
+          srcOp.getLoc(), tensorType, "ttnn::trunc", nullptr, nullptr,
+          adaptor.getInput());
+      input = emitter.emit(trunc.getResult(0), /*index=*/0);
+    } else {
+      input = emitter.emit(srcOp.getInput());
+    }
+
     llvm::SmallVector<mlir::Attribute> args{
-        emitter.emit(srcOp.getInput()),
+        input,
         emitter.emit(srcOp.getDtypeAttr()),
         emitter.emit(srcOp.getMemoryConfigAttr()),
     };
