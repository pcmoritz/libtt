+def TTIR_WindowBiasOp : TTIR_NamedOp<"window_bias"> {
+  let summary = "The causal decode attention's relative-position window bias";
+  let description = [{
+    bias[t, 0, h, j] = rel_r[t, 16 h : 16 h + 16] . table[W - 1 - d] for the
+    distance d = p - first - j of column j of the window of W keys ending at
+    position p's key tile. rel_r [T, heads * 16] BF16, table [2W, 16] FP32,
+    positions [T] INT32; bias [T, 1, heads, W] BF16 and, with sink [T, heads],
+    the sink tiles [T, 1, heads, 32] (sink * sink_scale in column 0). libtt's
+    tt.window_bias custom call (sglang_tpu_kernels.py) forms it.
+  }];
+  let arguments = (ins AnyRankedTensor:$rel_r,
+                       AnyRankedTensor:$table,
+                       AnyRankedTensor:$positions,
+                       Optional<AnyRankedTensor>:$sink,
+                       I64Attr:$heads,
+                       F32Attr:$sink_scale);
+  let results = (outs Variadic<AnyRankedTensor>:$outputs);
+}
