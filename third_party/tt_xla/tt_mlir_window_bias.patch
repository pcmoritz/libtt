+::flatbuffers::Offset<::tt::target::ttnn::WindowBiasOp>
+createOp(FlatbufferObjectCache &cache, WindowBiasOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> sink =
+      op.getSink() ? tensor(op.getSink()) : 0;
+  std::vector<::flatbuffers::Offset<::tt::target::ttnn::TensorRef>> outs;
+  for (Value output : op.getOutputs()) {
+    outs.push_back(cache.getOrCreateNoSharding(output, tensorValueToFlatbuffer,
+                                               std::nullopt));
+  }
+  auto outsOffset = cache.fbb->CreateVector(outs);
+  return ::tt::target::ttnn::CreateWindowBiasOp(
+      *cache.fbb, tensor(op.getRelR()), tensor(op.getTable()),
+      tensor(op.getPositions()), sink, static_cast<uint32_t>(op.getHeads()),
+      op.getSinkScale().convertToFloat(), outsOffset);
+}
