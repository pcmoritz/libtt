+class WindowBiasOpConversionPattern
+    : public OpConversionPattern<ttir::WindowBiasOp> {
+public:
+  using OpConversionPattern<ttir::WindowBiasOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::WindowBiasOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(this->getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                      types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::WindowBiasOp>(
+        op, types, adaptor.getRelR(), adaptor.getTable(),
+        adaptor.getPositions(), adaptor.getSink(), op.getHeadsAttr(),
+        op.getSinkScaleAttr());
+    return success();
+  }
+};
