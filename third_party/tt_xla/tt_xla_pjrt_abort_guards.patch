+static bool moduleHasZeroSizedTensor(mlir::ModuleOp module) {
+  return module
+      .walk([](mlir::Operation *op) {
+        auto hasZeroElements = [](mlir::Type type) {
+          auto tensorType = mlir::dyn_cast<mlir::RankedTensorType>(type);
+          return tensorType && tensorType.hasStaticShape() &&
+                 tensorType.getNumElements() == 0;
+        };
+        return llvm::any_of(op->getOperandTypes(), hasZeroElements) ||
+                       llvm::any_of(op->getResultTypes(), hasZeroElements)
+                   ? mlir::WalkResult::interrupt()
+                   : mlir::WalkResult::advance();
+      })
+      .wasInterrupted();
+}
