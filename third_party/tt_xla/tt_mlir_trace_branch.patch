 namespace tt::runtime::ttnn::operations::trace {
 
+// Depth of run-and-capture programs executing on this thread. A case with a
+// device selector inside one runs both of its branches, between the markers
+// that make the trace branch at replay (see the CaseOp runtime).
+static thread_local int traceCaptureProgramDepth = 0;
+
+bool inTraceCaptureProgram() { return traceCaptureProgramDepth > 0; }
+
+namespace {
+struct TraceCaptureProgramScope {
+  TraceCaptureProgramScope() { ++traceCaptureProgramDepth; }
+  ~TraceCaptureProgramScope() { --traceCaptureProgramDepth; }
+};
+} // namespace
