@@ -23,6 +23,34 @@
 #define GEN_PASS_DEF_TTNNTRACEHOISTTRANSFORM
 #include "ttmlir/Dialect/TTNN/Transforms/Passes.h.inc"
 
+// Rejects a case with a device-resident selector in the branch programs of
+// `caseOp`, at any depth: the runtime branches a trace on one such selector
+// at a time.
+static LogicalResult verifyNoNestedDeviceSelectedCase(ttcore::CaseOp caseOp) {
+  for (Attribute branch : caseOp.getBranchPrograms()) {
+    auto program = SymbolTable::lookupNearestSymbolFrom<func::FuncOp>(
+        caseOp, mlir::cast<FlatSymbolRefAttr>(branch));
+    if (!program) {
+      continue;
+    }
+    WalkResult result = program.walk([&](ttcore::CaseOp nested) {
+      auto type = mlir::dyn_cast<RankedTensorType>(nested.getIndex().getType());
+      if (type && utils::isTensorOnDevice(type)) {
+        nested.emitError("a traced case with a device-resident selector "
+                         "cannot hold another one in its branches");
+        return WalkResult::interrupt();
+      }
+      return failed(verifyNoNestedDeviceSelectedCase(nested))
+                 ? WalkResult::interrupt()
+                 : WalkResult::advance();
+    });
+    if (result.wasInterrupted()) {
+      return failure();
+    }
+  }
+  return success();
+}
