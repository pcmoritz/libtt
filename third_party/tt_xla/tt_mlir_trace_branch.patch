+// Whether the runtime has to read a device value to run `loop`: a loop with a
+// condition program, or a counted loop with a bound held by an input. Inside
+// a trace, the trace loops on the value instead (see the WhileLoopOp runtime).
+static bool loopNeedsTraceControl(ttcore::WhileLoopOp loop) {
+  if (loop.getConditionProgramAttr()) {
+    return true;
+  }
+  for (ttcore::LoopBoundAttr bound :
+       {loop.getInitialAttr(), loop.getLimitAttr(), loop.getStepAttr()}) {
+    if (bound && bound.getInputIndex()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+static bool caseNeedsTraceControl(ttcore::CaseOp caseOp) {
+  auto type = mlir::dyn_cast<RankedTensorType>(caseOp.getIndex().getType());
+  return type && utils::isTensorOnDevice(type);
+}
+
+// Rejects control flow that would make the trace branch or loop on a device
+// value inside the programs `programs` name, at any depth: a trace branches
+// or loops on one value at a time.
+static LogicalResult
+verifyNoNestedTraceControl(Operation *op, ArrayRef<FlatSymbolRefAttr> programs) {
+  for (FlatSymbolRefAttr symbol : programs) {
+    if (!symbol) {
+      continue;
+    }
+    auto program = SymbolTable::lookupNearestSymbolFrom<func::FuncOp>(op, symbol);
+    if (!program) {
+      continue;
+    }
+    WalkResult result = program.walk([&](Operation *nested) {
+      llvm::SmallVector<FlatSymbolRefAttr> nestedPrograms;
+      if (auto caseOp = mlir::dyn_cast<ttcore::CaseOp>(nested)) {
+        if (caseNeedsTraceControl(caseOp)) {
+          caseOp.emitError("a traced case or loop controlled by a device value "
+                           "cannot hold another one in its programs");
+          return WalkResult::interrupt();
+        }
+        for (Attribute branch : caseOp.getBranchPrograms()) {
+          nestedPrograms.push_back(mlir::cast<FlatSymbolRefAttr>(branch));
+        }
+      } else if (auto loop = mlir::dyn_cast<ttcore::WhileLoopOp>(nested)) {
+        if (loopNeedsTraceControl(loop)) {
+          loop.emitError("a traced case or loop controlled by a device value "
+                         "cannot hold another one in its programs");
+          return WalkResult::interrupt();
+        }
+        nestedPrograms.push_back(loop.getBodyProgramAttr());
+        nestedPrograms.push_back(loop.getConditionProgramAttr());
+      } else {
+        return WalkResult::advance();
+      }
+      return failed(verifyNoNestedTraceControl(nested, nestedPrograms))
+                 ? WalkResult::interrupt()
+                 : WalkResult::advance();
+    });
+    if (result.wasInterrupted()) {
+      return failure();
+    }
+  }
+  return success();
+}
