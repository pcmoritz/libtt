-  // Handles ReturnOp during propagation. Checks if actual layout matches
-  // expected function signature and inserts ToLayoutOp if needed for tilizing.
-  void handleReturnOp(IRRewriter &rewriter, FunctionType funcType,
-                      func::ReturnOp returnOp, unsigned operandIdx,
-                      Value previousOp) {
+  // The type a signature fixes for `use`: the function's result type for a
+  // returned value, the callee's argument type for a while loop's or case's
+  // input. Every case branch has one signature (see CaseLayoutPattern), so the
+  // first branch speaks for all of them. nullopt for any other use, a case's
+  // selector included.
+  static std::optional<Type> getExpectedType(OpOperand &use,
+                                             FunctionType funcType) {
+    Operation *owner = use.getOwner();
+    if (mlir::isa<func::ReturnOp>(owner)) {
+      return funcType.getResult(use.getOperandNumber());
+    }
+    auto calleeArgType = [&](OperandRange inputs,
+                             FlatSymbolRefAttr callee) -> std::optional<Type> {
+      unsigned begin = inputs.getBeginOperandIndex();
+      unsigned operand = use.getOperandNumber();
+      auto function =
+          SymbolTable::lookupNearestSymbolFrom<func::FuncOp>(owner, callee);
+      if (!function || operand < begin || operand >= begin + inputs.size()) {
+        return std::nullopt;
+      }
+      return function.getArgumentTypes()[operand - begin];
+    };
+    if (auto loop = mlir::dyn_cast<ttcore::WhileLoopOp>(owner)) {
+      return calleeArgType(loop.getInputs(), loop.getBodyProgramAttr());
+    }
+    if (auto caseOp = mlir::dyn_cast<ttcore::CaseOp>(owner)) {
+      ArrayAttr branches = caseOp.getBranchPrograms();
+      if (branches.empty()) {
+        return std::nullopt;
+      }
+      return calleeArgType(caseOp.getInputs(),
+                           mlir::cast<FlatSymbolRefAttr>(branches[0]));
+    }
+    return std::nullopt;
+  }
