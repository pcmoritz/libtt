 private:
+  // (user, operand number) pairs that propagation must leave as they are.
+  using DirectUses = llvm::DenseSet<std::pair<Operation *, unsigned>>;
+
+  // The control-flow operands that read one of `args` directly, before the
+  // redundant ToTensorSpecOps are bypassed.
+  DirectUses collectDirectControlFlowUses(
+      const llvm::SmallVector<Value> &args,
+      const llvm::SmallVector<ttnn::ToTensorSpecOp> &toRemove) {
+    llvm::DenseSet<Operation *> removed;
+    for (ttnn::ToTensorSpecOp op : toRemove) {
+      removed.insert(op.getOperation());
+    }
+    DirectUses uses;
+    for (Value arg : args) {
+      for (OpOperand &use : arg.getUses()) {
+        Operation *owner = use.getOwner();
+        if (!removed.contains(owner) &&
+            mlir::isa<ttcore::WhileLoopOp, ttcore::CaseOp>(owner)) {
+          uses.insert({owner, use.getOperandNumber()});
+        }
+      }
+    }
+    return uses;
+  }
