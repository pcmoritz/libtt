+// Frontends commonly expand sigmoid(x) as 1 / (1 + exp(-x)). Lower the
+// expansion back to the native sigmoid op even when it is not part of SiLU.
+// Besides reducing the number of device programs, this also lets subsequent
+// fusion patterns reason about sigmoid semantically instead of structurally.
+class ExpandedSigmoidFusionPattern : public mlir::OpRewritePattern<DivOp> {
+  using mlir::OpRewritePattern<DivOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(DivOp divOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    if (utils::isInsideCompositeDecomposition(divOp)) {
+      return mlir::failure();
+    }
+
+    mlir::Value input =
+        SiluFusionPattern::matchExpandedSigmoidInput(divOp.getResult());
+    if (!input) {
+      return mlir::failure();
+    }
+
+    mlir::Type outputType = divOp.getResult().getType();
+    mlir::Value result = rewriter.create<SigmoidOp>(
+        divOp.getLoc(), input.getType(), input);
+    if (result.getType() != outputType) {
+      result = rewriter.create<TypecastOp>(divOp.getLoc(), outputType, result);
+    }
+    rewriter.replaceOp(divOp, result);
+    return mlir::success();
+  }
+};
