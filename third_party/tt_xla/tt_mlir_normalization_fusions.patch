+// Fuses an L2 normalization over the trailing dimension into rms_norm:
+//
+//   y = x / sqrt(sum(x * x, dim=-1) + epsilon) * scale
+//
+// rms_norm computes x / sqrt(mean(x * x) + rms_epsilon) * weight.  For a
+// reduction of size D the two expressions are equivalent when
+//
+//   rms_epsilon = epsilon / D
+//   weight      = scale / sqrt(D)
+//
+// `scale` is optional and must be a splat constant.  This form is emitted by
+// several frontends for query/key L2 normalization, and replacing it with a
+// single rms_norm avoids materializing the reduction and denominator tensors.
+class L2NormRMSNormFusionPattern : public mlir::OpRewritePattern<DivOp> {
+  using mlir::OpRewritePattern<DivOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(DivOp divOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    if (utils::isInsideCompositeDecomposition(divOp)) {
+      return mlir::failure();
+    }
+
+    // Keep the exact value being normalized. Looking through its reshape and
+    // broadcast chain would change both the rank and the reduction dimension.
+    mlir::Value x = divOp.getLhs();
+    auto xType = mlir::dyn_cast<mlir::RankedTensorType>(x.getType());
+    if (!xType || xType.getRank() == 0) {
+      return mlir::failure();
+    }
+
+    // Match sqrt(sum(x^2) + epsilon), looking through reshapes and broadcasts.
+    auto sqrtOp = utils::findOpThroughLayoutOps<SqrtOp>(divOp.getRhs());
+    if (!sqrtOp) {
+      return mlir::failure();
+    }
+    auto addOp = utils::findOpThroughLayoutOps<AddOp>(sqrtOp.getInput());
+    if (!addOp) {
+      return mlir::failure();
+    }
+
+    SumOp sumOp = utils::findOpThroughLayoutOps<SumOp>(addOp.getLhs());
+    mlir::Value epsilonValue = addOp.getRhs();
+    if (!sumOp) {
+      sumOp = utils::findOpThroughLayoutOps<SumOp>(addOp.getRhs());
+      epsilonValue = addOp.getLhs();
+    }
+    std::optional<double> epsilon = getSplatConstantValue(epsilonValue);
+    if (!sumOp || !epsilon || !std::isfinite(*epsilon) || *epsilon < 0.0) {
+      return mlir::failure();
+    }
+
+    std::optional<mlir::ArrayAttr> dimArg = sumOp.getDimArg();
+    if (!dimArg || dimArg->size() != 1) {
+      return mlir::failure();
+    }
+    int64_t reduceDim =
+        mlir::cast<mlir::IntegerAttr>((*dimArg)[0]).getInt();
+    if (reduceDim < 0) {
+      reduceDim += xType.getRank();
+    }
+    // TTNN rms_norm operates on the trailing dimension.  Restricting the
+    // rewrite avoids introducing permutations for a normalization that is
+    // normally on the model's head dimension anyway.
+    if (reduceDim != xType.getRank() - 1) {
+      return mlir::failure();
+    }
+    int64_t reduceDimSize = xType.getShape()[reduceDim];
+    if (reduceDimSize <= 1) {
+      return mlir::failure();
+    }
+
+    mlir::Value squareBase;
+    if (auto mulOp =
+            utils::findOpThroughLayoutOps<MultiplyOp>(sumOp.getInput())) {
+      if (utils::lookThroughLayoutOps(mulOp.getLhs()) !=
+          utils::lookThroughLayoutOps(mulOp.getRhs())) {
+        return mlir::failure();
+      }
+      squareBase = mulOp.getLhs();
+    } else if (auto powOp =
+                   utils::findOpThroughLayoutOps<PowOp>(sumOp.getInput())) {
+      if (!isApproxScalarConstant(powOp.getRhs(), 2.0, 1e-3)) {
+        return mlir::failure();
+      }
+      squareBase = powOp.getLhs();
+    } else {
+      return mlir::failure();
+    }
+    if (squareBase != x) {
+      return mlir::failure();
+    }
+
+    // Fold a following splat scale into rms_norm's weight when possible.
+    double scale = 1.0;
+    mlir::Operation *replaceTarget = divOp.getOperation();
+    if (divOp->hasOneUse()) {
+      if (auto scaleMul =
+              mlir::dyn_cast<MultiplyOp>(*divOp->getUsers().begin())) {
+        mlir::Value other = scaleMul.getLhs() == divOp.getResult()
+                                ? scaleMul.getRhs()
+                                : scaleMul.getLhs();
+        if (std::optional<double> scaleValue =
+                getSplatConstantValue(other)) {
+          if (!std::isfinite(*scaleValue)) {
+            return mlir::failure();
+          }
+          scale = *scaleValue;
+          replaceTarget = scaleMul.getOperation();
+        }
+      }
+    }
+
+    auto targetType = mlir::dyn_cast<mlir::RankedTensorType>(
+        replaceTarget->getResult(0).getType());
+    if (!targetType) {
+      return mlir::failure();
+    }
+
+    rewriter.setInsertionPoint(replaceTarget);
+    mlir::Location loc = divOp.getLoc();
+    llvm::SmallVector<int64_t> normalizedShape{reduceDimSize};
+    auto weightType = mlir::RankedTensorType::get(
+        normalizedShape, xType.getElementType(), xType.getEncoding());
+    float weightValue = static_cast<float>(
+        scale / std::sqrt(static_cast<double>(reduceDimSize)));
+    mlir::Value weight = rewriter.create<FullOp>(
+        loc, weightType, rewriter.getF32FloatAttr(weightValue));
+    float rmsEpsilon = static_cast<float>(
+        *epsilon / static_cast<double>(reduceDimSize));
+    mlir::Value rmsResult =
+        rewriter
+            .create<RMSNormOp>(
+                loc, xType, x, weight,
+                /*bias=*/mlir::Value(),
+                rewriter.getDenseI64ArrayAttr(normalizedShape),
+                rewriter.getF32FloatAttr(rmsEpsilon))
+            .getResult();
+
+    mlir::Value result =
+        utils::reshapeAndCastToType(rewriter, loc, rmsResult, targetType);
+    rewriter.replaceOp(replaceTarget, result);
+    return mlir::success();
+  }
+};
