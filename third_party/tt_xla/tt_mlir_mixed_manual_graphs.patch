+// Inline manual computations nested in another one. Their operands now have
+// the device-local shapes of their in_shardings. The region's arguments are
+// local over its manual axes only, but ops in the region have been localized
+// over its automatic axes from their own shardings, so they take the operands.
+static void inlineNestedManualComputations(func::FuncOp &funcOp) {
+  llvm::SmallVector<mlir::sdy::ManualComputationOp> nested;
+  // Post-order: inner computations come first.
+  funcOp.walk([&](mlir::sdy::ManualComputationOp op) {
+    if (op->getParentOfType<mlir::sdy::ManualComputationOp>()) {
+      nested.push_back(op);
+    }
+  });
+  for (mlir::sdy::ManualComputationOp op : nested) {
+    mlir::Block &body = op.getRegion().front();
+    auto returnOp = mlir::cast<mlir::sdy::ReturnOp>(body.getTerminator());
+    for (auto [arg, operand] : llvm::zip(body.getArguments(), op.getOperands())) {
+      arg.replaceAllUsesWith(operand);
+    }
+    op.getResults().replaceAllUsesWith(returnOp.getOperands());
+    op->getBlock()->getOperations().splice(mlir::Block::iterator(op),
+                                           body.getOperations(), body.begin(),
+                                           mlir::Block::iterator(returnOp));
+    returnOp->erase();
+    op->erase();
+  }
+}
