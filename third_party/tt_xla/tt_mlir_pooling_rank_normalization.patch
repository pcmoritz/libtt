 namespace {
 
+struct Pool2DLayout {
+  SmallVector<size_t, 2> spatialDims;
+  SmallVector<int64_t> permutation;
+  SmallVector<int64_t> inversePermutation;
+
+  bool needsPermute() const {
+    for (auto [index, dimension] : llvm::enumerate(permutation)) {
+      if (static_cast<int64_t>(index) != dimension) {
+        return true;
+      }
+    }
+    return false;
+  }
+
+  bool needsReshape() const { return permutation.size() != 4; }
+
+  SmallVector<int64_t> getPermutedShape(ArrayRef<int64_t> shape) const {
+    return ttmlir::utils::applyPermutation(shape, permutation);
+  }
+
+  SmallVector<int64_t> getNormalizedShape(ArrayRef<int64_t> shape) const {
+    SmallVector<int64_t> permutedShape = getPermutedShape(shape);
+    switch (permutedShape.size()) {
+    case 2:
+      return {1, permutedShape[0], permutedShape[1], 1};
+    case 3:
+      return {permutedShape[0], permutedShape[1], permutedShape[2], 1};
+    case 4:
+      return permutedShape;
+    case 5: {
+      int64_t batch = ShapedType::isDynamic(permutedShape[0]) ||
+                              ShapedType::isDynamic(permutedShape[1])
+                          ? ShapedType::kDynamic
+                          : permutedShape[0] * permutedShape[1];
+      return {batch, permutedShape[2], permutedShape[3], permutedShape[4]};
+    }
+    default:
+      llvm_unreachable("expected a rank-2 through rank-5 pooling input");
+    }
+  }
+};
+
+static std::optional<Pool2DLayout>
+getPool2DLayout(ArrayRef<int64_t> windowDimensions,
+                ArrayRef<int64_t> windowStrides,
+                ArrayRef<int64_t> windowDilations,
+                ArrayRef<int64_t> padding) {
+  size_t rank = windowDimensions.size();
+  if (rank < 2 || rank > 5 || windowStrides.size() != rank ||
+      windowDilations.size() != rank || padding.size() != rank * 2) {
+    return std::nullopt;
+  }
+
+  Pool2DLayout layout;
+  for (size_t i = 0; i < rank; ++i) {
+    if (windowDimensions[i] != 1 || windowStrides[i] != 1 ||
+        windowDilations[i] != 1 || padding[i * 2] != 0 ||
+        padding[i * 2 + 1] != 0) {
+      layout.spatialDims.push_back(i);
+    }
+  }
+  if (layout.spatialDims.size() > 2) {
+    return std::nullopt;
+  }
+
+  // Preserve the existing pooling convention when fewer than two spatial
+  // dimensions are observable: rank-2 is HW, while higher ranks use their
+  // last two dimensions.
+  if (layout.spatialDims.size() < 2) {
+    layout.spatialDims = {rank - 2, rank - 1};
+  }
+
+  SmallVector<int64_t> nonSpatialDims;
+  for (size_t i = 0; i < rank; ++i) {
+    if (!llvm::is_contained(layout.spatialDims, i)) {
+      nonSpatialDims.push_back(i);
+    }
+  }
+
+  // Rank-3 has no channel dimension: its non-spatial dimension is N. Rank-4
+  // and rank-5 keep the last non-spatial dimension as C and flatten any
+  // preceding dimensions into N.
+  if (rank == 3) {
+    layout.permutation.append(nonSpatialDims);
+  } else if (rank >= 4 && !nonSpatialDims.empty()) {
+    layout.permutation.append(nonSpatialDims.begin(),
+                              std::prev(nonSpatialDims.end()));
+  }
+  layout.permutation.push_back(layout.spatialDims[0]);
+  layout.permutation.push_back(layout.spatialDims[1]);
+  if (rank >= 4 && !nonSpatialDims.empty()) {
+    layout.permutation.push_back(nonSpatialDims.back());
+  }
+  layout.inversePermutation =
+      ttmlir::utils::inversePermutation(layout.permutation);
+  return layout;
+}
