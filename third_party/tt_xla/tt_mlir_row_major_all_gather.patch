+// All-gather can copy aligned row-major pages directly. Limit this to returned
+// results: tilizing a gathered tensor for a compute consumer would move more
+// data than tilizing the input. Rows must fill at least one tile's payload to
+// avoid underfilling the CCL kernel's four-page packets, and fit in the default
+// fabric packet. Function inputs have their layouts set before this pass walks
+// the operations, so the return signature and operation layouts agree.
+static bool keepAllGatherRowMajor(Operation *op) {
+  auto gather = mlir::dyn_cast_if_present<ttir::AllGatherOp>(op);
+  if (!gather || !isa<BlockArgument>(gather.getInput()) ||
+      !llvm::all_of(gather->getUsers(), [](Operation *user) {
+        return isa<func::ReturnOp>(user);
+      })) {
+    return false;
+  }
+  auto type = gather.getInput().getType();
+  auto layout = mlir::dyn_cast_if_present<TTNNLayoutAttr>(type.getEncoding());
+  if (!layout || layout.isTiled() ||
+      !layout.hasInterleavedDRAMTensorMemoryLayout() || type.getRank() < 2) {
+    return false;
+  }
+  int64_t rowBytes =
+      type.getShape().back() * type.getElementTypeBitWidth() / 8;
+  auto tile = ttcore::TileType::get(type.getElementType());
+  return rowBytes >= tile.getSizeBytes() && rowBytes <= 4096 &&
+         rowBytes % 64 == 0;
+}
