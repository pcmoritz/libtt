+// Gated delta decode reads the query and key head of each value head's group,
+// so grouped query/key heads need not be repeated. Matches a slice with
+// group-aligned head bounds of x [B, H, D] repeated r times per head, as
+// repeat_interleave(x, r, dim=1) or
+//   reshape(broadcast(reshape(x, [B, H, 1, D]), [B, H, r, D]), [B, H * r, D]),
+// optionally times a scalar, and slices x instead. When the query and key are
+// L2-normalized heads of one tensor and only a constant scales the query, the
+// kernel reads, normalizes and scales them itself; when they and the value are
+// head-aligned slices of one flat tensor, it reads all three from that tensor.
+class GatedDeltaDecodeGroupedHeadsPattern
+    : public mlir::OpRewritePattern<GatedDeltaDecodeOp> {
+public:
+  using mlir::OpRewritePattern<GatedDeltaDecodeOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(GatedDeltaDecodeOp op,
+                  mlir::PatternRewriter &rewriter) const final {
+    std::optional<Grouped> query = match(op.getQuery());
+    std::optional<Grouped> key = match(op.getKey());
+    if (!query || !key || query->repeats != key->repeats) {
+      return mlir::failure();
+    }
+    std::optional<Normalized> normalized = matchL2Norm(query->heads);
+    if (normalized && query->heads == key->heads && !query->scalar &&
+        !key->scalar && !key->fill) {
+      float scale =
+          query->fill
+              ? mlir::cast<FloatAttr>(query->fill).getValue().convertToFloat()
+              : 1.0f;
+      Value input = normalized->input;
+      int64_t qkOffset = 0, valueOffset = 0;
+      std::optional<std::pair<Value, int64_t>> qkSource =
+          flatSource(normalized->input);
+      std::optional<std::pair<Value, int64_t>> valueSource =
+          flatSource(op.getValue());
+      if (qkSource && valueSource && qkSource->first == valueSource->first) {
+        auto flatType = mlir::cast<RankedTensorType>(qkSource->first.getType());
+        input = qkSource->first;
+        if (!flatType.getElementType().isF32()) {
+          input = rewriter.create<TypecastOp>(
+              op.getLoc(),
+              RankedTensorType::get(flatType.getShape(), rewriter.getF32Type(),
+                                    flatType.getEncoding()),
+              input);
+        }
+        qkOffset = qkSource->second;
+        valueOffset = valueSource->second;
+      }
+      rewriter.modifyOpInPlace(op, [&] {
+        op.getQueryMutable().assign(input);
+        op.getKeyMutable().assign(input);
+        if (qkOffset || valueOffset || input != normalized->input) {
+          op.getValueMutable().assign(input);
+          op.setValueHeadOffset(valueOffset);
+        }
+        op.setQueryHeadOffset(qkOffset + query->begin / query->repeats);
+        op.setKeyHeadOffset(qkOffset + key->begin / key->repeats);
+        op.setNumKeyHeads((key->end - key->begin) / key->repeats);
+        op.setNormalizeEpsAttr(rewriter.getF32FloatAttr(normalized->eps));
+        op.setQueryScaleAttr(rewriter.getF32FloatAttr(scale));
+      });
+      return mlir::success();
+    }
+    Value newQuery = ungroup(rewriter, *query);
+    Value newKey = ungroup(rewriter, *key);
+    rewriter.modifyOpInPlace(op, [&] {
+      op.getQueryMutable().assign(newQuery);
+      op.getKeyMutable().assign(newKey);
+    });
+    return mlir::success();
+  }
+
+private:
+  struct Grouped {
+    Value heads; // [B, H, D] before repetition.
+    int64_t repeats;
+    int64_t begin, end; // Bounds on the repeated heads.
+    Value scalar;       // Optional factor with all dimensions of size 1,
+    Attribute fill;     // or optional constant factor.
+    Location loc;
+  };
+
+  static std::optional<Grouped> match(Value value) {
+    Location loc = value.getLoc();
+    Value scalar;
+    Attribute fill;
+    if (auto multiply = value.getDefiningOp<MultiplyOp>()) {
+      for (auto [operand, other] :
+           {std::pair(multiply.getLhs(), multiply.getRhs()),
+            std::pair(multiply.getRhs(), multiply.getLhs())}) {
+        auto broadcast = other.getDefiningOp<BroadcastOp>();
+        DenseElementsAttr constant;
+        if (auto full = other.getDefiningOp<FullOp>()) {
+          fill = full.getFillValue();
+        } else if (matchPattern(other, m_Constant(&constant)) &&
+                   constant.isSplat()) {
+          fill = constant.getSplatValue<Attribute>();
+        } else if (broadcast &&
+                   llvm::all_of(mlir::cast<RankedTensorType>(
+                                    broadcast.getInput().getType())
+                                    .getShape(),
+                                [](int64_t size) { return size == 1; })) {
+          scalar = broadcast.getInput();
+        }
+        if (scalar || fill) {
+          value = operand;
+          break;
+        }
+      }
+      if (!scalar && !fill) {
+        return std::nullopt;
+      }
+    }
+    auto slice = value.getDefiningOp<SliceStaticOp>();
+    std::optional<std::pair<Value, int64_t>> repeated =
+        slice ? matchRepeatedHeads(slice.getInput()) : std::nullopt;
+    if (!repeated) {
+      return std::nullopt;
+    }
+    auto [heads, repeats] = *repeated;
+    auto headsShape = mlir::cast<RankedTensorType>(heads.getType()).getShape();
+    const int64_t batch = headsShape[0], dim = headsShape[2];
+    auto bounds = [](ArrayAttr attr) {
+      return llvm::to_vector(llvm::map_range(attr, [](Attribute value) {
+        return mlir::cast<IntegerAttr>(value).getInt();
+      }));
+    };
+    auto begins = bounds(slice.getBegins());
+    auto ends = bounds(slice.getEnds());
+    auto steps = bounds(slice.getStep());
+    if (begins != ArrayRef<int64_t>{0, begins[1], 0} ||
+        ends != ArrayRef<int64_t>{batch, ends[1], dim} ||
+        steps != ArrayRef<int64_t>{1, 1, 1} || begins[1] % repeats != 0 ||
+        ends[1] % repeats != 0) {
+      return std::nullopt;
+    }
+    return Grouped{heads, repeats, begins[1], ends[1], scalar, fill, loc};
+  }
+
+  struct Normalized {
+    Value input; // [B, H, D] before normalization.
+    float eps;
+  };
+
+  // Returns the flat [B, W] tensor of which value [B, H, 128] reshapes a slice
+  // of whole heads, and the slice's first head.
+  static std::optional<std::pair<Value, int64_t>> flatSource(Value value) {
+    while (Operation *op = value.getDefiningOp()) {
+      if (!isa<TypecastOp, ReshapeOp>(op)) {
+        break;
+      }
+      value = op->getOperand(0);
+    }
+    auto slice = value.getDefiningOp<SliceStaticOp>();
+    if (!slice) {
+      return std::nullopt;
+    }
+    auto shape = mlir::cast<RankedTensorType>(slice.getInput().getType())
+                     .getShape();
+    auto bound = [](ArrayAttr attr, size_t i) {
+      return mlir::cast<IntegerAttr>(attr[i]).getInt();
+    };
+    if (shape.size() != 2 || bound(slice.getBegins(), 0) != 0 ||
+        bound(slice.getEnds(), 0) != shape[0] ||
+        bound(slice.getStep(), 0) != 1 || bound(slice.getStep(), 1) != 1 ||
+        bound(slice.getBegins(), 1) % 128 != 0) {
+      return std::nullopt;
+    }
+    return std::pair(slice.getInput(), bound(slice.getBegins(), 1) / 128);
+  }
+
+  static Value skipBroadcastsAndReshapes(Value value) {
+    while (Operation *op = value.getDefiningOp()) {
+      if (!isa<BroadcastOp, ReshapeOp>(op)) {
+        break;
+      }
+      value = op->getOperand(0);
+    }
+    return value;
+  }
+
+  static std::optional<float> constantValue(Value value) {
+    value = skipBroadcastsAndReshapes(value);
+    if (auto full = value.getDefiningOp<FullOp>()) {
+      if (auto fill = mlir::dyn_cast<FloatAttr>(full.getFillValue())) {
+        return fill.getValue().convertToFloat();
+      }
+    }
+    DenseElementsAttr constant;
+    if (matchPattern(value, m_Constant(&constant)) && constant.isSplat() &&
+        isa<FloatType>(constant.getElementType())) {
+      return constant.getSplatValue<APFloat>().convertToFloat();
+    }
+    return std::nullopt;
+  }
+
+  // Matches x / sqrt(sum(x * x, last dim) + eps) for f32 x [B, H, 128], the
+  // normalization the decode kernel applies.
+  static std::optional<Normalized> matchL2Norm(Value value) {
+    auto div = value.getDefiningOp<DivOp>();
+    auto sqrt = div ? skipBroadcastsAndReshapes(div.getRhs())
+                          .getDefiningOp<SqrtOp>()
+                    : nullptr;
+    auto add = sqrt ? skipBroadcastsAndReshapes(sqrt.getInput())
+                          .getDefiningOp<AddOp>()
+                    : nullptr;
+    if (!add) {
+      return std::nullopt;
+    }
+    Value x = div.getLhs();
+    auto type = mlir::cast<RankedTensorType>(x.getType());
+    if (type.getRank() != 3 || type.getDimSize(2) != 128 ||
+        !type.getElementType().isF32()) {
+      return std::nullopt;
+    }
+    for (auto [sumSide, epsSide] : {std::pair(add.getLhs(), add.getRhs()),
+                                    std::pair(add.getRhs(), add.getLhs())}) {
+      auto sum = skipBroadcastsAndReshapes(sumSide).getDefiningOp<SumOp>();
+      std::optional<float> eps = constantValue(epsSide);
+      auto square = sum ? sum.getInput().getDefiningOp<MultiplyOp>() : nullptr;
+      if (!square || !eps || square.getLhs() != x || square.getRhs() != x) {
+        continue;
+      }
+      std::optional<ArrayAttr> dims = sum.getDimArg();
+      if (!dims || dims->size() != 1) {
+        continue;
+      }
+      int64_t dim = mlir::cast<IntegerAttr>((*dims)[0]).getInt();
+      if (dim == 2 || dim == -1) {
+        return Normalized{x, *eps};
+      }
+    }
+    return std::nullopt;
+  }
+
+  // Returns x [B, H, D] and r for x with each head repeated r times.
+  static std::optional<std::pair<Value, int64_t>>
+  matchRepeatedHeads(Value value) {
+    if (auto repeat = value.getDefiningOp<RepeatInterleaveOp>()) {
+      auto type = mlir::cast<RankedTensorType>(repeat.getInput().getType());
+      if (type.getRank() != 3 || (repeat.getDim() != 1 && repeat.getDim() != -2)) {
+        return std::nullopt;
+      }
+      return std::pair(repeat.getInput(), int64_t(repeat.getRepeats()));
+    }
+    auto outer = value.getDefiningOp<ReshapeOp>();
+    auto broadcast =
+        outer ? outer.getInput().getDefiningOp<BroadcastOp>() : nullptr;
+    auto inner =
+        broadcast ? broadcast.getInput().getDefiningOp<ReshapeOp>() : nullptr;
+    if (!inner) {
+      return std::nullopt;
+    }
+    Value heads = inner.getInput();
+    auto headsShape = mlir::cast<RankedTensorType>(heads.getType()).getShape();
+    auto innerShape = inner.getType().getShape();
+    auto broadcastShape = broadcast.getType().getShape();
+    auto outerShape = outer.getType().getShape();
+    if (headsShape.size() != 3 || innerShape.size() != 4 ||
+        broadcastShape.size() != 4 || outerShape.size() != 3) {
+      return std::nullopt;
+    }
+    const int64_t batch = headsShape[0], numHeads = headsShape[1],
+                  dim = headsShape[2], repeats = broadcastShape[2];
+    if (innerShape != ArrayRef<int64_t>{batch, numHeads, 1, dim} ||
+        broadcastShape != ArrayRef<int64_t>{batch, numHeads, repeats, dim} ||
+        outerShape != ArrayRef<int64_t>{batch, numHeads * repeats, dim}) {
+      return std::nullopt;
+    }
+    return std::pair(heads, repeats);
+  }
+
+  static Value ungroup(mlir::PatternRewriter &rewriter, const Grouped &group) {
+    auto type = mlir::cast<RankedTensorType>(group.heads.getType());
+    SmallVector<int64_t> shape(type.getShape());
+    const int32_t begin = group.begin / group.repeats;
+    const int32_t end = group.end / group.repeats;
+    shape[1] = end - begin;
+    auto slicedType =
+        RankedTensorType::get(shape, type.getElementType(), type.getEncoding());
+    Value result = rewriter.create<SliceStaticOp>(
+        group.loc, slicedType, group.heads,
+        rewriter.getI32ArrayAttr({0, begin, 0}),
+        rewriter.getI32ArrayAttr({static_cast<int32_t>(shape[0]), end,
+                                  static_cast<int32_t>(shape[2])}),
+        rewriter.getI32ArrayAttr({1, 1, 1}));
+    Value factor;
+    if (group.fill) {
+      factor = rewriter.create<FullOp>(group.loc, slicedType, group.fill);
+    } else if (group.scalar) {
+      factor = rewriter.create<BroadcastOp>(
+          group.loc, slicedType, group.scalar,
+          ttmlir::utils::getBroadcastDimensions<int64_t>(
+              mlir::cast<RankedTensorType>(group.scalar.getType()).getShape(),
+              shape));
+    }
+    if (factor) {
+      result =
+          rewriter.create<MultiplyOp>(group.loc, slicedType, result, factor);
+    }
+    return result;
+  }
+};
+
