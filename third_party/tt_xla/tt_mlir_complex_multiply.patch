+// Extracts one component from tensor<...x2xf32>, where component 0 is real
+// and component 1 is imaginary.
+static Value unpackComplexComponent(Location loc, Value input,
+                                    int64_t component,
+                                    OpBuilder &builder) {
+  auto inputType = mlir::cast<RankedTensorType>(input.getType());
+  auto transposed = transposeTrailingToLeading(loc, input, builder);
+  auto transposedType = mlir::cast<RankedTensorType>(transposed.getType());
+  int64_t rank = transposedType.getRank();
+  auto transposedShape = transposedType.getShape();
+
+  SmallVector<int64_t> begins(rank, 0),
+      ends(transposedShape.begin(), transposedShape.end()), steps(rank, 1);
+  begins[0] = component;
+  ends[0] = component + 1;
+  SmallVector<int64_t> sliceShape(transposedShape.begin(),
+                                  transposedShape.end());
+  sliceShape[0] = 1;
+  auto slice = builder.create<mlir::stablehlo::SliceOp>(
+      loc, RankedTensorType::get(sliceShape, inputType.getElementType()),
+      transposed, builder.getDenseI64ArrayAttr(begins),
+      builder.getDenseI64ArrayAttr(ends),
+      builder.getDenseI64ArrayAttr(steps));
+
+  SmallVector<int64_t> componentShape(inputType.getShape().begin(),
+                                      inputType.getShape().end() - 1);
+  auto componentType =
+      RankedTensorType::get(componentShape, inputType.getElementType());
+  return builder
+      .create<mlir::stablehlo::ReshapeOp>(loc, componentType,
+                                          slice.getResult())
+      .getResult();
+}
