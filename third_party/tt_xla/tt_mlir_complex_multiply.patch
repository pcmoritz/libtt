+// Decomposes (a + bi) * (c + di) into
+//   real = ac - bd
+//   imag = ad + bc
+namespace {
+class ComplexMulOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::MulOp> {
+  using OpConversionPattern<mlir::stablehlo::MulOp>::OpConversionPattern;
+
+public:
+  LogicalResult matchAndRewrite(
+      mlir::stablehlo::MulOp op,
+      OpConversionPattern<mlir::stablehlo::MulOp>::OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    Location loc = op.getLoc();
+    Value lhsReal =
+        unpackComplexComponent(loc, adaptor.getLhs(), 0, rewriter);
+    Value lhsImag =
+        unpackComplexComponent(loc, adaptor.getLhs(), 1, rewriter);
+    Value rhsReal =
+        unpackComplexComponent(loc, adaptor.getRhs(), 0, rewriter);
+    Value rhsImag =
+        unpackComplexComponent(loc, adaptor.getRhs(), 1, rewriter);
+
+    Value ac =
+        rewriter.create<mlir::stablehlo::MulOp>(loc, lhsReal, rhsReal);
+    Value bd =
+        rewriter.create<mlir::stablehlo::MulOp>(loc, lhsImag, rhsImag);
+    Value ad =
+        rewriter.create<mlir::stablehlo::MulOp>(loc, lhsReal, rhsImag);
+    Value bc =
+        rewriter.create<mlir::stablehlo::MulOp>(loc, lhsImag, rhsReal);
+    Value real = rewriter.create<mlir::stablehlo::SubtractOp>(loc, ac, bd);
+    Value imag = rewriter.create<mlir::stablehlo::AddOp>(loc, ad, bc);
+
+    rewriter.replaceOp(op, packRealImag(loc, real, imag, rewriter));
+    return success();
+  }
+};
+} // namespace
