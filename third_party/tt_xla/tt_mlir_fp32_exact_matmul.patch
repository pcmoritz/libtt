+// FP32 products and sums on the vector unit, for a matmul of FP32 inputs at
+// the highest precision. An operand that the compiler left in a narrower
+// float type (a dropped exact cast) is cast here.
+static ::ttnn::Tensor
+matmulFp32(const ::ttnn::Tensor &lhs, const ::ttnn::Tensor &rhs,
+           bool transposeA, bool transposeB,
+           const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig,
+           ::ttnn::DataType outputDataType) {
+  auto prepare = [](const ::ttnn::Tensor &tensor, bool transpose) {
+    ::ttnn::Tensor result = tensor;
+    if (result.dtype() != ::ttnn::DataType::FLOAT32) {
+      result = ::ttnn::typecast(result, ::ttnn::DataType::FLOAT32);
+    }
+    if (transpose) {
+      result = ::ttnn::transpose(result, -2, -1);
+    }
+    return result;
+  };
+  ::ttnn::Tensor output = ::ttnn::experimental::matmul_fp32(
+      prepare(lhs, transposeA), prepare(rhs, transposeB), outputMemoryConfig);
+  if (output.dtype() != outputDataType) {
+    output = ::ttnn::typecast(output, outputDataType, outputMemoryConfig);
+  }
+  return output;
+}
