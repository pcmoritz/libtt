+    auto newOp = rewriter.replaceOpWithNewOp<mlir::tt::ttir::DotGeneralOp>(
         srcOp, outputType, adaptor.getLhs(), adaptor.getRhs(),
         adaptor.getDotDimensionNumbers().getLhsBatchingDimensions(),
         adaptor.getDotDimensionNumbers().getLhsContractingDimensions(),
         adaptor.getDotDimensionNumbers().getRhsBatchingDimensions(),
         adaptor.getDotDimensionNumbers().getRhsContractingDimensions());
+    // The matrix unit reads FP32 inputs as TF32. A dot_general of FP32 inputs
+    // at the highest precision gets FP32 products and sums (the runtime's
+    // ttnn::experimental::matmul_fp32, on the vector unit).
+    if (lhsType.isF32() && rhsType.isF32() && asksForHighestPrecision(srcOp)) {
