+    return llvm::any_of(*op.getPrecisionConfig(), [](mlir::Attribute attr) {
+      auto precision = mlir::dyn_cast<mlir::stablehlo::PrecisionAttr>(attr);
+      return precision &&
+             precision.getValue() == mlir::stablehlo::Precision::HIGHEST;
+    });
+  }
