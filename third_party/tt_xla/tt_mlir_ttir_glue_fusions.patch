+// TTNN lays out the last two dims of a tensor as 32x32 tiles, so a [1, 10240]
+// view takes 320 tiles where [1, 4, 2560] takes 80. An elementwise op next to
+// a reshape between two such views is cheaper on the side with fewer tiles;
+// the two patterns below move it there.
+static int64_t tileCount(RankedTensorType type) {
+  ArrayRef<int64_t> shape = type.getShape();
+  const int64_t rank = shape.size();
+  int64_t tiles = 1;
+  for (int64_t d = 0; d + 2 < rank; ++d) {
+    tiles *= shape[d];
+  }
+  tiles *= llvm::divideCeil(rank >= 2 ? shape[rank - 2] : 1, 32);
+  return tiles * llvm::divideCeil(rank >= 1 ? shape[rank - 1] : 1, 32);
+}
+
+// The index of the one operand of elementwise `op` (of result type `type`)
+// that is a runtime value of the op's shape, when every other operand is free
+// to reshape: a constant or parameter (its reshape runs in const-eval) that
+// is a scalar or has the op's shape. nullopt otherwise.
+static std::optional<unsigned> findReshapedOperand(Operation *op,
+                                                   RankedTensorType type) {
+  std::optional<unsigned> data;
+  for (auto [i, operand] : llvm::enumerate(op->getOperands())) {
+    auto operandType = mlir::cast<RankedTensorType>(operand.getType());
+    Operation *source = utils::lookThroughLayoutOps(operand).getDefiningOp();
+    bool constant =
+        (source && source->hasTrait<mlir::OpTrait::ConstantLike>()) ||
+        mlir::isa_and_present<FullOp, ZerosOp, OnesOp>(source) ||
+        ttcore::valueTracesToConstantArgs(operand);
+    bool free = constant && (operandType.getNumElements() == 1 ||
+                             operandType.getShape() == type.getShape());
+    if (free) {
+      continue;
+    }
+    if (data || operandType.getShape() != type.getShape()) {
+      return std::nullopt;
+    }
+    data = i;
+  }
+  return data;
+}
+
+// `op` rebuilt with result shape `shape`: operand `data` becomes `value` and
+// the others are reshaped to `shape` (or to ones of its rank if scalars).
+static Value rebuildWithShape(PatternRewriter &rewriter, Operation *op,
+                              unsigned data, Value value,
+                              ArrayRef<int64_t> shape) {
+  SmallVector<Value> operands;
+  for (auto [i, operand] : llvm::enumerate(op->getOperands())) {
+    if (i == data) {
+      operands.push_back(value);
+      continue;
+    }
+    auto operandType = mlir::cast<RankedTensorType>(operand.getType());
+    SmallVector<int64_t> operandShape(shape);
+    if (operandType.getNumElements() == 1) {
+      operandShape.assign(shape.size(), 1);
+    }
+    operands.push_back(
+        utils::createReshapeOp(rewriter, op->getLoc(), operand, operandShape));
+  }
+  auto type = mlir::cast<RankedTensorType>(op->getResult(0).getType());
+  StringAttr name = rewriter.getStringAttr(op->getName().getStringRef());
+  auto resultType = RankedTensorType::get(shape, type.getElementType());
+  return rewriter
+      .create(op->getLoc(), name, operands, resultType, op->getAttrs())
+      ->getResult(0);
+}
