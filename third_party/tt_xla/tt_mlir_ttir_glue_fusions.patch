+// reshape(op(x, c)) -> op(reshape(x), reshape(c)) when the reshape's result
+// has fewer tiles than op's.
+class HoistReshapeToFewerTilesPattern
+    : public mlir::OpRewritePattern<ReshapeOp> {
+  using mlir::OpRewritePattern<ReshapeOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(ReshapeOp reshape,
+                  mlir::PatternRewriter &rewriter) const final {
+    Operation *op = reshape.getInput().getDefiningOp();
+    if (!op || !op->hasOneUse() ||
+        !mlir::isa<ElementwiseUnary, ElementwiseBinary>(op)) {
+      return mlir::failure();
+    }
+    auto type = mlir::cast<RankedTensorType>(op->getResult(0).getType());
+    if (tileCount(reshape.getType()) >= tileCount(type)) {
+      return mlir::failure();
+    }
+    std::optional<unsigned> data = findReshapedOperand(op, type);
+    if (!data) {
+      return mlir::failure();
+    }
+    ArrayRef<int64_t> shape = reshape.getType().getShape();
+    Value value = utils::createReshapeOp(rewriter, reshape.getLoc(),
+                                         op->getOperand(*data), shape);
+    rewriter.replaceOp(reshape,
+                       rebuildWithShape(rewriter, op, *data, value, shape));
+    return mlir::success();
+  }
+};
+
+// op(reshape(x), c) -> reshape(op(x, reshape(c))) when x has fewer tiles than
+// op's result.
+class SinkReshapeToFewerTilesPattern : public mlir::RewritePattern {
+public:
+  SinkReshapeToFewerTilesPattern(MLIRContext *context)
+      : RewritePattern(MatchAnyOpTypeTag(), /*benefit=*/1, context) {}
+
+  mlir::LogicalResult
+  matchAndRewrite(Operation *op, mlir::PatternRewriter &rewriter) const final {
+    if (!mlir::isa<ElementwiseUnary, ElementwiseBinary>(op) ||
+        op->getNumResults() != 1) {
+      return mlir::failure();
+    }
+    auto type = mlir::cast<RankedTensorType>(op->getResult(0).getType());
+    std::optional<unsigned> data = findReshapedOperand(op, type);
+    if (!data) {
+      return mlir::failure();
+    }
+    auto reshape = op->getOperand(*data).getDefiningOp<ReshapeOp>();
+    if (!reshape || !reshape->hasOneUse() ||
+        tileCount(reshape.getInput().getType()) >= tileCount(type)) {
+      return mlir::failure();
+    }
+    ArrayRef<int64_t> shape = reshape.getInput().getType().getShape();
+    Value result =
+        rebuildWithShape(rewriter, op, *data, reshape.getInput(), shape);
+    rewriter.replaceOp(op, utils::createReshapeOp(rewriter, op->getLoc(),
+                                                  result, type.getShape()));
+    return mlir::success();
+  }
+};
