+  // Whether const-eval computes op's RHS (and bias) once: they come from
+  // constants and the function's Parameter and Constant arguments only.
+  static bool isConstEvaluable(OpType op) {
+    auto fromConstants = [](Value value) {
+      auto chain = ttmlir::utils::getUseDefChain(value);
+      return ttmlir::utils::filterBlockArguments(chain.getArrayRef()).empty() ||
+             ttcore::valueTracesToConstantArgs(value);
+    };
+    if constexpr (std::is_same_v<OpType, LinearOp>) {
+      if (op.getBias() && !fromConstants(op.getBias())) {
+        return false;
+      }
+    }
+    return fromConstants(op.getB());
+  }
