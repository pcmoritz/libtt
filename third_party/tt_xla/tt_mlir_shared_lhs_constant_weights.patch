+    // Exact FP32 matmuls run on the vector unit and stay apart. The fused RHS
+    // concatenates the candidates' weights, which is free only when const-eval
+    // computes it once; over weights that the program takes as inputs, it
+    // would copy every weight on every call.
+    if (rootOp->hasAttr("ttcore.fp32_exact") || !isConstEvaluable(rootOp)) {
       return result;
     }
