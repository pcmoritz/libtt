+  // A running logsumexp: one input reduced with logaddexp from log(0) = -inf
+  // along one dimension; see isCumProd for the window conditions.
+  std::optional<CumulativeReductionMatch>
+  isCumulativeLogSumExp(
+      mlir::stablehlo::ReduceWindowOp &srcOp,
+      mlir::stablehlo::ReduceWindowOp::Adaptor adaptor) const {
+    if (srcOp.getInputs().size() != 1 ||
+        !isLogAddExpBody(srcOp.getBody().front()) ||
+        !hasInitValue(srcOp, TypicalInitReductionValue::NEG_INF) ||
+        !hasValidWindowAttributes(adaptor)) {
+      return std::nullopt;
+    }
+    SmallVector<int64_t> padding(adaptor.getWindowDimensionsAttr().size() * 2,
+                                 0);
+    if (adaptor.getPaddingAttr()) {
+      padding.assign(adaptor.getPaddingAttr().getValues<int64_t>().begin(),
+                     adaptor.getPaddingAttr().getValues<int64_t>().end());
+    }
+    CumulativeReductionMatch match;
+    if (!hasValidInputAndPadding(
+            srcOp, adaptor, match,
+            DenseI64ArrayAttr::get(srcOp.getContext(), padding))) {
+      return std::nullopt;
+    }
+    return match;
+  }
+
+  // Lowers a running max, min or logsumexp to ttir.cumulative. Unlike cumsum
+  // and cumprod, integers keep their type: ttnn's accumulation kernel takes max
+  // and min natively, and float32 cannot hold every int32. The kernel takes
+  // 32-bit integers only, so narrower unsigned ones are scanned as uint32
+  // (exact: max and min only select input values). NaN propagates as in JAX.
+  void replaceWithCumulativeReduction(
+      mlir::stablehlo::ReduceWindowOp srcOp,
+      mlir::stablehlo::ReduceWindowOp::Adaptor adaptor,
+      CumulativeReductionMatch match, ttcore::ReduceType reduction,
+      ConversionPatternRewriter &rewriter) const {
+    auto resultType = cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+    RankedTensorType scanType = resultType;
+    if (auto intType = dyn_cast<IntegerType>(resultType.getElementType());
+        intType && intType.isUnsigned() && intType.getWidth() < 32) {
+      scanType = resultType.clone(rewriter.getIntegerType(32, false));
+    }
+    Value result = castToElementType(rewriter, srcOp.getLoc(),
+                                     adaptor.getInputs()[0],
+                                     scanType.getElementType());
+    result = rewriter.create<ttir::CumulativeOp>(
+        srcOp.getLoc(), scanType, result,
+        rewriter.getI64IntegerAttr(match.dimension),
+        ttcore::ReduceTypeAttr::get(rewriter.getContext(), reduction),
+        rewriter.getBoolAttr(match.reverse));
+    rewriter.replaceOp(srcOp, castToElementType(rewriter, srcOp.getLoc(),
+                                                result,
+                                                resultType.getElementType()));
+  }
