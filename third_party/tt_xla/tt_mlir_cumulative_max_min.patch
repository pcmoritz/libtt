+    // [[1, 3, 2],     [[1, 3, 3],
+    //  [5, 4, 6]]  ->  [5, 5, 6]]
+    ```
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       I64Attr:$dim,
+                       TTCore_ReduceTypeAttr:$reduction,
+                       DefaultValuedAttr<BoolAttr, "false">:$reverse);
+
+  let results = (outs AnyRankedTensor:$result);
+
+  let hasVerifier = 1;
+}
