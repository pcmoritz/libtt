+::flatbuffers::Offset<::tt::target::ttnn::CumulativeOp>
+createOp(FlatbufferObjectCache &cache, CumulativeOp op) {
+  auto in = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getInput()));
+  auto output = cache.getOrCreateNoSharding(op.getResult(),
+                                            tensorValueToFlatbuffer,
+                                            /*local_shape*/ std::nullopt);
+  auto memoryConfig = toFlatbuffer(cache, op.getMemoryConfigAttr());
+  auto dtype = toFlatbuffer(cache, op.getDtypeAttr());
+  ::tt::target::ttnn::CumulativeReduction reduction;
+  switch (op.getReduction()) {
+  case ttcore::ReduceType::Max:
+    reduction = ::tt::target::ttnn::CumulativeReduction::Max;
+    break;
+  case ttcore::ReduceType::Min:
+    reduction = ::tt::target::ttnn::CumulativeReduction::Min;
+    break;
+  case ttcore::ReduceType::LogSumExp:
+    reduction = ::tt::target::ttnn::CumulativeReduction::LogSumExp;
+    break;
+  default:
+    llvm_unreachable("cumulative reduction is verified to be max, min or logsumexp");
+  }
+  return ::tt::target::ttnn::CreateCumulativeOp(*cache.fbb, in, output,
+                                                op.getDim(), reduction,
+                                                op.getReverse(), dtype,
+                                                memoryConfig);
+}
