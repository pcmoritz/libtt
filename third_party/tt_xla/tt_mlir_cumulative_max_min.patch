 // CumProdOp verification
+::mlir::LogicalResult mlir::tt::ttir::CumulativeOp::verify() {
+  int64_t dim = getDim();
+  int64_t inputRank = getInput().getType().getRank();
+  if (dim < -inputRank || dim >= inputRank) {
+    return emitOpError() << "specified dimension should be between "
+                         << -inputRank << " and " << (inputRank - 1)
+                         << ", but got: " << dim;
+  }
+  if (getReduction() != ttcore::ReduceType::Max &&
+      getReduction() != ttcore::ReduceType::Min &&
+      getReduction() != ttcore::ReduceType::LogSumExp) {
+    return emitOpError() << "reduction must be max, min or logsumexp, but got: "
+                         << ttcore::stringifyReduceType(getReduction());
+  }
+  return success();
+}
