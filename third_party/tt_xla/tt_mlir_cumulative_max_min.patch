+  std::optional<std::pair<CumulativeReductionMatch, ttcore::ReduceType>>
+  isCumulativeExtremum(mlir::stablehlo::ReduceWindowOp &srcOp,
+                       mlir::stablehlo::ReduceWindowOp::Adaptor adaptor,
+                       mlir::Operation *frontOp,
+                       DenseI64ArrayAttr padding) const {
+    ttcore::ReduceType reduction;
+    TypicalInitReductionValue identity;
+    if (isa<mlir::stablehlo::MaxOp>(frontOp)) {
+      reduction = ttcore::ReduceType::Max;
+      identity = TypicalInitReductionValue::NEG_INF;
+    } else if (isa<mlir::stablehlo::MinOp>(frontOp)) {
+      reduction = ttcore::ReduceType::Min;
+      identity = TypicalInitReductionValue::POS_INF;
+    } else {
+      return std::nullopt;
+    }
+    if (!hasInitValue(srcOp, identity) || !hasValidWindowAttributes(adaptor)) {
+      return std::nullopt;
+    }
+    CumulativeReductionMatch match;
+    if (!hasValidInputAndPadding(srcOp, adaptor, match, padding)) {
+      return std::nullopt;
+    }
+    return std::pair{match, reduction};
+  }
+
+  // Whether the reduction body is exactly JAX's logaddexp of two floats:
+  //   d = a - b
+  //   select(d != d, a + b, max(a, b) + log1p(exp(-|d|)))
+  // with d != d a float comparison, which is true for NaN.
+  bool isLogAddExpBody(Block &block) const {
+    // The ten ops above and the return, nothing else.
+    if (block.getNumArguments() != 2 || block.getOperations().size() != 11) {
+      return false;
+    }
+    Value a = block.getArgument(0);
+    Value b = block.getArgument(1);
+    if (a.getType() != b.getType() ||
+        !isa<FloatType>(getElementTypeOrSelf(a.getType()))) {
+      return false;
+    }
+    auto takes = [&](Operation *op, Value x, Value y) {
+      return op && op->getNumOperands() == 2 && op->getOperand(0) == x &&
+             op->getOperand(1) == y;
+    };
+    auto ret = dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+    if (!ret || ret.getNumOperands() != 1) {
+      return false;
+    }
+    auto select = ret.getOperand(0).getDefiningOp<mlir::stablehlo::SelectOp>();
+    if (!select) {
+      return false;
+    }
+    auto isNan = select.getPred().getDefiningOp<mlir::stablehlo::CompareOp>();
+    // Under total order a NaN equals itself.
+    std::optional<mlir::stablehlo::ComparisonType> compareType =
+        isNan ? isNan.getCompareType() : std::nullopt;
+    if (!isNan ||
+        isNan.getComparisonDirection() !=
+            mlir::stablehlo::ComparisonDirection::NE ||
+        (compareType && *compareType != mlir::stablehlo::ComparisonType::FLOAT) ||
+        isNan.getLhs() != isNan.getRhs()) {
+      return false;
+    }
+    auto diff = isNan.getLhs().getDefiningOp<mlir::stablehlo::SubtractOp>();
+    auto sum = select.getOnTrue().getDefiningOp<mlir::stablehlo::AddOp>();
+    auto result = select.getOnFalse().getDefiningOp<mlir::stablehlo::AddOp>();
+    if (!takes(diff, a, b) || !takes(sum, a, b) || !result) {
+      return false;
+    }
+    auto max = result.getLhs().getDefiningOp<mlir::stablehlo::MaxOp>();
+    auto log1p = result.getRhs().getDefiningOp<mlir::stablehlo::Log1pOp>();
+    if (!takes(max, a, b) || !log1p) {
+      return false;
+    }
+    auto exp = log1p.getOperand().getDefiningOp<mlir::stablehlo::ExpOp>();
+    auto neg = exp ? exp.getOperand().getDefiningOp<mlir::stablehlo::NegOp>()
+                   : nullptr;
+    auto abs = neg ? neg.getOperand().getDefiningOp<mlir::stablehlo::AbsOp>()
+                   : nullptr;
+    return abs && abs.getOperand() == diff.getResult();
+  }
