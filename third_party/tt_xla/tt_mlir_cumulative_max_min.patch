+      ConversionPatternRewriter &rewriter) const {
+    auto resultType = cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+    DenseI64ArrayAttr dimensions =
+        rewriter.getDenseI64ArrayAttr({match.dimension});
+    Value input = adaptor.getInputs()[0];
+    if (match.reverse) {
+      input = rewriter.create<ttir::ReverseOp>(srcOp.getLoc(), resultType,
+                                                input, dimensions);
+    }
+    Value result = rewriter.create<ttir::CumulativeOp>(
+        srcOp.getLoc(), resultType, input,
+        rewriter.getI64IntegerAttr(match.dimension),
+        rewriter.getStringAttr(reduction));
+    if (match.reverse) {
