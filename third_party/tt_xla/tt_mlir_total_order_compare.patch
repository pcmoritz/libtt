+// A float32 comparison in IEEE 754 total order, which binary_ng runs as a
+// native SFPU comparison (Blackhole).
+static void runTotalOrderCompareOp(const ::tt::target::ttnn::EltwiseBinaryOp *op,
+                                   ProgramTensorPool &tensorPool) {
+  using ::ttnn::operations::binary_ng::BinaryOpType;
+  BinaryOpType type;
+  switch (op->type()) {
+  case ::tt::target::ttnn::EltwiseBinaryOpType::Equal:
+    type = BinaryOpType::EQ_TOTAL_ORDER;
+    break;
+  case ::tt::target::ttnn::EltwiseBinaryOpType::NotEqual:
+    type = BinaryOpType::NE_TOTAL_ORDER;
+    break;
+  case ::tt::target::ttnn::EltwiseBinaryOpType::LessThan:
+    type = BinaryOpType::LT_TOTAL_ORDER;
+    break;
+  case ::tt::target::ttnn::EltwiseBinaryOpType::GreaterThan:
+    type = BinaryOpType::GT_TOTAL_ORDER;
+    break;
+  case ::tt::target::ttnn::EltwiseBinaryOpType::LessEqual:
+    type = BinaryOpType::LE_TOTAL_ORDER;
+    break;
+  case ::tt::target::ttnn::EltwiseBinaryOpType::GreaterEqual:
+    type = BinaryOpType::GE_TOTAL_ORDER;
+    break;
+  default:
+    LOG_FATAL("Total order is only defined for comparisons");
+  }
+  LOG_ASSERT(!op->output_activations() && !op->input_tensor_a_activations() &&
+                 !op->input_tensor_b_activations(),
+             "Total-order comparisons take no activations");
+
+  const ::ttnn::Tensor &lhs = tensorPool.getTTNNTensorAndValidate(op->lhs());
+  const ::ttnn::Tensor &rhs = tensorPool.getTTNNTensorAndValidate(op->rhs());
+  std::optional<::ttnn::MemoryConfig> outputMemoryConfig =
+      ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+          op->memory_config());
+
+  // binary_ng packs wrong values when a float32 comparison asks for a narrower
+  // result, so compare to float32 and typecast.
+  ::ttnn::Tensor out = ::ttnn::prim::binary_ng(lhs, rhs, type, std::nullopt,
+                                               outputMemoryConfig);
+  if (op->output_dtype()) {
+    ::ttnn::DataType outputDataType =
+        ::tt::runtime::ttnn::utils::toTTNNDataType(*(op->output_dtype()));
+    if (outputDataType != out.dtype()) {
+      out = ::ttnn::typecast(out, outputDataType, outputMemoryConfig);
+    }
+  }
+  tensorPool.insertTTNNTensorAndValidate(op->out(), out);
+}
