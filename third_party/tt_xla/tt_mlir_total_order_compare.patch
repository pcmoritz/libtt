 private:
+  // Returns int32 keys whose signed order is the IEEE total order of `value`'s
+  // floats (as float32), as in XLA's ComparisonExpander:
+  //   key = bits < 0 ? bits ^ 0x7fffffff : bits
+  // The bits of a non-negative float already order as an integer; flipping
+  // all but the sign bit of a negative one reverses the order of negatives.
+  // Keys of a broadcast are computed before it, on the smaller tensor.
+  Value toTotalOrderKey(Value value, bool bitsOnly,
+                        ConversionPatternRewriter &rewriter) const {
+    Location loc = value.getLoc();
+    if (auto broadcast =
+            value.getDefiningOp<mlir::stablehlo::BroadcastInDimOp>()) {
+      Value key = toTotalOrderKey(broadcast.getOperand(), bitsOnly, rewriter);
+      return rewriter.create<mlir::stablehlo::BroadcastInDimOp>(
+          loc, broadcast.getType().clone(rewriter.getI32Type()), key,
+          broadcast.getBroadcastDimensionsAttr());
+    }
+    auto type = cast<RankedTensorType>(value.getType());
+    auto i32Type = type.clone(rewriter.getI32Type());
+    if (type.getElementType() != rewriter.getF32Type()) {
+      value = rewriter.create<mlir::stablehlo::ConvertOp>(
+          loc, type.clone(rewriter.getF32Type()), value);
+    }
+    Value bits =
+        rewriter.create<mlir::stablehlo::BitcastConvertOp>(loc, i32Type, value);
+    if (bitsOnly) {
+      return bits;
+    }
+    auto constant = [&](int32_t fill) -> Value {
+      return rewriter.create<mlir::stablehlo::ConstantOp>(
+          loc, DenseElementsAttr::get(i32Type, llvm::ArrayRef<int32_t>{fill}));
+    };
