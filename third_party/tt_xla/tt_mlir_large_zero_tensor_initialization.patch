+TEST_F(LayoutConverterTest, LargeZeroTensorPreservesMeshTopology) {
+  if (tt::runtime::getNumAvailableDevices() < 2) {
+    GTEST_SKIP() << "Test requires at least two devices";
+  }
+
+  // The zero-on-device fast path is used above 65535 row-major pages. Keep
+  // each page small so the regression does not require a large host buffer.
+  std::vector<uint32_t> shardShape = {65536, 1};
+  std::vector<int64_t> shardStride =
+      tt::runtime::utils::calculateStride(shardShape);
+  std::vector<uint16_t> zeros(shardShape[0] * shardShape[1], 0);
+  std::vector<const void *> shardData = {zeros.data(), zeros.data()};
+
+  tt::runtime::Tensor hostTensor = tt::runtime::createMultiDeviceHostTensor(
+      shardData, shardShape, shardStride, sizeof(uint16_t),
+      tt::target::DataType::BFloat16, {}, {1, 2});
+  const auto &hostTTNNTensor =
+      tt::runtime::ttnn::utils::getTTNNTensorFromRuntimeTensor(hostTensor);
+  const auto expectedTopology = hostTTNNTensor.tensor_topology();
+
+  tt::runtime::MeshDeviceOptions meshOptions;
+  meshOptions.meshShape = {1, 2};
+  tt::runtime::Device device = tt::runtime::openMeshDevice(meshOptions);
+  tt::runtime::Layout tileLayout =
+      tt::runtime::test::ttnn::getDramInterleavedTileLayout(
+          tt::target::DataType::BFloat16);
+
+  tt::runtime::Tensor deviceTensor =
+      tt::runtime::toLayout(hostTensor, device, tileLayout, true);
+  const auto &deviceTTNNTensor =
+      tt::runtime::ttnn::utils::getTTNNTensorFromRuntimeTensor(deviceTensor);
+  EXPECT_EQ(deviceTTNNTensor.tensor_topology(), expectedTopology);
+
+  tt::runtime::closeMeshDevice(device);
+}
