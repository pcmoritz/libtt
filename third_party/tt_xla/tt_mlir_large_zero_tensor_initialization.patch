+bool shouldInitializeZeroOnDevice(const ::ttnn::Tensor &input) {
+  const auto &spec = input.tensor_spec();
+  const size_t pageSize = spec.compute_page_size_bytes();
+  if (pageSize == 0) {
+    return false;
+  }
+
+  const size_t rowMajorPages =
+      spec.compute_packed_buffer_size_bytes() / pageSize;
+  const auto &shape = spec.physical_shape();
+  constexpr size_t tileHeight = tt::constants::TILE_HEIGHT;
+  constexpr size_t tileWidth = tt::constants::TILE_WIDTH;
+  const size_t tilePages = ((shape.height() + tileHeight - 1) / tileHeight) *
+                           ((shape.width() + tileWidth - 1) / tileWidth);
+
+  // H2D commands use a 16-bit page index. Avoid scanning ordinary tensors;
+  // only transfers that exceed that range and become smaller when tiled can
+  // benefit from direct device initialization.
+  constexpr size_t maxTransferPageIndex =
+      std::numeric_limits<std::uint16_t>::max();
+  if (rowMajorPages <= maxTransferPageIndex || tilePages >= rowMajorPages) {
+    return false;
+  }
+
+  bool allZero = true;
+  input.host_tensor().buffer().apply([&](const auto &shard) {
+    const auto bytes = shard.view_bytes();
+    allZero = allZero &&
+              std::all_of(bytes.begin(), bytes.end(), [](std::byte value) {
+                return value == std::byte{0};
+              });
+  });
+  return allZero;
+}
