+const tt::runtime::Layout &
+FlatbufferLoadedExecutableInstance::getInputLayout(size_t arg_index) {
+  std::call_once(m_input_layouts_once, [this] {
+    FlatbufferExecutableImage *executable_image =
+        static_cast<FlatbufferExecutableImage *>(m_executable_image.get());
+    const size_t num_inputs = m_executable_image->getNumInputs();
+    m_input_layouts.reserve(num_inputs);
+    for (size_t i = 0; i < num_inputs; ++i) {
+      m_input_layouts.push_back(tt::runtime::getLayout(
+          executable_image->getFlatbufferBinary(), /*programIndex=*/0, i));
+    }
+  });
+  return m_input_layouts[arg_index];
+}
