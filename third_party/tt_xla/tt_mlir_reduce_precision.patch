 static void
 addElementwiseUnaryOpsConversionPatterns(MLIRContext *ctx,
                                          RewritePatternSet &patterns,
@@ -10912,6 +11040,8 @@ addElementwiseUnaryOpsConversionPatterns(MLIRContext *ctx,
   patterns.add<StableHLOToTTIROpDefaultConversionPattern<
       mlir::stablehlo::RoundNearestEvenOp, mlir::tt::ttir::RoundOp>>(
       typeConverter, ctx);
+  patterns.add<StableHLOToTTIRReducePrecisionOpConversionPattern>(
+      typeConverter, ctx);
 }
 
