+namespace {
+class StableHLOToTTIRReducePrecisionOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ReducePrecisionOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::ReducePrecisionOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ReducePrecisionOp srcOp,
+                  mlir::stablehlo::ReducePrecisionOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    auto inputType = mlir::cast<FloatType>(resultType.getElementType());
+
+    int exponentBits = srcOp.getExponentBits();
+    int mantissaBits = srcOp.getMantissaBits();
+    int inputMantissaBits = inputType.getFPMantissaWidth() - 1;
+    int inputExponentBits =
+        inputType.getWidth() - inputMantissaBits - /*sign=*/1;
+    if (exponentBits >= inputExponentBits &&
+        mantissaBits >= inputMantissaBits) {
+      rewriter.replaceOp(srcOp, adaptor.getOperand());
+      return success();
+    }
+    if (!(inputType.isF32() || inputType.isBF16() || inputType.isF16()) ||
+        exponentBits < 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "requested floating-point format is not supported");
+    }
+
+    // ttnn.reduce_precision rounds on the input's own bits, like XLA.
+    rewriter.replaceOpWithNewOp<ttir::ReducePrecisionOp>(
+        srcOp, resultType, adaptor.getOperand(), exponentBits, mantissaBits);
+    return success();
+  }
+};
+} // namespace
+
