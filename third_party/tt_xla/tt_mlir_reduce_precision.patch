diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -10871,2 +10871,50 @@ public:
 
+namespace {
+class StableHLOToTTIRReducePrecisionOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ReducePrecisionOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::ReducePrecisionOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ReducePrecisionOp srcOp,
+                  mlir::stablehlo::ReducePrecisionOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    auto inputType = mlir::cast<FloatType>(resultType.getElementType());
+
+    int exponentBits = srcOp.getExponentBits();
+    int mantissaBits = srcOp.getMantissaBits();
+    Type reducedElementType;
+    if (exponentBits == 5 && mantissaBits == 10) {
+      reducedElementType = rewriter.getF16Type();
+    } else if (exponentBits == 8 && mantissaBits == 7) {
+      reducedElementType = rewriter.getBF16Type();
+    } else if (exponentBits == 8 && mantissaBits == 23) {
+      reducedElementType = rewriter.getF32Type();
+    } else {
+      return rewriter.notifyMatchFailure(
+          srcOp, "requested floating-point format is not supported");
+    }
+
+    int inputMantissaBits = inputType.getFPMantissaWidth() - 1;
+    int inputExponentBits =
+        inputType.getWidth() - inputMantissaBits - /*sign=*/1;
+    if (exponentBits >= inputExponentBits &&
+        mantissaBits >= inputMantissaBits) {
+      rewriter.replaceOp(srcOp, adaptor.getOperand());
+      return success();
+    }
+
+    auto reducedType = resultType.clone(reducedElementType);
+    Value reduced = rewriter.create<ttir::TypecastOp>(
+        srcOp.getLoc(), reducedType, adaptor.getOperand(), true);
+    rewriter.replaceOpWithNewOp<ttir::TypecastOp>(
+        srcOp, resultType, reduced, true);
+    return success();
+  }
+};
+} // namespace
+
 static void
@@ -10180,2 +10236,4 @@ addElementwiseUnaryOpsConversionPatterns(MLIRContext *ctx,
   patterns.add<StableHLOToTTIROpRoundOpConversionPattern>(typeConverter, ctx);
+  patterns.add<StableHLOToTTIRReducePrecisionOpConversionPattern>(
+      typeConverter, ctx);
 }
