+// Fold PyTorch's SiluAndMul after a merged gate and up projection, as
+// SGLang-TorchTPU's decode MLP runs it on one tile row of activations: the
+// BF16 product's [gate | up] halves sliced, silu of the gate in FP32 cast back
+// to BF16, times up. The projection, a matmul or a scaled matmul with a BF16
+// result, becomes a half-width one with ttnn.exact_swiglu, whose decode
+// program epilogue reproduces every rounding of those ops.
+template <typename ProjectionOp>
+class TTNNProjectionWithExactSwiGLU
+    : public mlir::OpRewritePattern<MultiplyOp> {
+public:
+  TTNNProjectionWithExactSwiGLU(mlir::MLIRContext *context)
+      : mlir::OpRewritePattern<MultiplyOp>(context, /*benefit=*/2) {}
+
+  mlir::LogicalResult
+  matchAndRewrite(MultiplyOp multiplyOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    if (!multiplyOp.getActivations().empty() ||
+        !multiplyOp.getInputTensorAActivations().empty() ||
+        !multiplyOp.getInputTensorBActivations().empty()) {
+      return failure();
+    }
+    // The BF16 silu of a slice: typecast to FP32, silu, typecast to BF16,
+    // innermost last, each used once.
+    auto siluOfSlice = [](Value value) -> SmallVector<Operation *> {
+      auto narrow = value.getDefiningOp<TypecastOp>();
+      auto silu = narrow ? narrow.getInput().getDefiningOp<SiluOp>() : nullptr;
+      auto widen = silu ? silu.getInput().getDefiningOp<TypecastOp>() : nullptr;
+      auto slice =
+          widen ? widen.getInput().getDefiningOp<SliceStaticOp>() : nullptr;
+      if (!slice || !elementTypeOf(slice.getResult()).isBF16() ||
+          !elementTypeOf(widen.getResult()).isF32() ||
+          !elementTypeOf(silu.getResult()).isF32() ||
+          !elementTypeOf(narrow.getResult()).isBF16()) {
+        return {};
+      }
+      SmallVector<Operation *> chain = {narrow, silu, widen, slice};
+      if (!llvm::all_of(chain, [](Operation *op) {
+            return op->getResult(0).hasOneUse();
+          })) {
+        return {};
+      }
+      return chain;
+    };
+    SmallVector<Operation *> chain = siluOfSlice(multiplyOp.getLhs());
+    Value other = multiplyOp.getRhs();
+    if (chain.empty()) {
+      chain = siluOfSlice(multiplyOp.getRhs());
+      other = multiplyOp.getLhs();
+    }
+    auto up = other.getDefiningOp<SliceStaticOp>();
+    if (chain.empty() || !up || !up.getResult().hasOneUse()) {
+      return failure();
+    }
+    auto gate = mlir::cast<SliceStaticOp>(chain.back());
+    auto projection = gate.getInput().getDefiningOp<ProjectionOp>();
+    if (!projection || up.getInput() != projection.getResult() ||
+        !projection.getResult().hasNUses(2) ||
+        projection->hasAttr("ttnn.fused_swiglu")) {
+      return failure();
+    }
+    if constexpr (std::is_same_v<ProjectionOp, MatmulOp>) {
+      if (projection.getTransposeA() || projection.getActivation() ||
+          projection.getMatmulProgramConfigAttr() ||
+          projection->hasAttr("ttcore.fp32_exact")) {
+        return failure();
+      }
+    }
+    // One tile row of BF16 [M, 2 * half], K and the halves whole tiles.
+    auto [tileHeight, tileWidth] = ttcore::TileType::getDefaultShape();
+    RankedTensorType type = projection.getType();
+    RankedTensorType outputType = multiplyOp.getType();
+    ArrayRef<int64_t> shape = type.getShape();
+    int64_t k = mlir::cast<RankedTensorType>(projection->getOperand(0).getType())
+                    .getShape()
+                    .back();
+    if (shape.size() != 2 || !type.getElementType().isBF16() ||
+        !outputType.getElementType().isBF16() || shape[0] > tileHeight ||
+        shape[1] % (2 * tileWidth) != 0 || k % tileWidth != 0) {
+      return failure();
+    }
+    const int64_t half = shape[1] / 2;
+    auto isHalf = [&](SliceStaticOp slice, int64_t begin) {
+      auto values = [](mlir::ArrayAttr attr) {
+        return llvm::cantFail(ttmlir::utils::getIntegerVector<int64_t>(attr));
+      };
+      return values(slice.getBegins()) == SmallVector<int64_t>{0, begin} &&
+             values(slice.getEnds()) ==
+                 SmallVector<int64_t>{shape[0], begin + half} &&
+             values(slice.getStep()) == SmallVector<int64_t>{1, 1};
+    };
+    if (!isHalf(gate, 0) || !isHalf(up, half) ||
+        outputType.getShape() != ArrayRef<int64_t>{shape[0], half}) {
+      return failure();
+    }
+
+    mlir::OperationState state(projection.getLoc(),
+                               ProjectionOp::getOperationName());
+    state.addOperands(projection->getOperands());
+    state.addTypes(outputType);
+    state.addAttributes(projection->getAttrs());
+    mlir::Operation *fused = rewriter.create(state);
+    fused->setAttr("ttnn.fused_swiglu", rewriter.getUnitAttr());
+    fused->setAttr("ttnn.exact_swiglu", rewriter.getUnitAttr());
+
+    rewriter.replaceOp(multiplyOp, fused->getResult(0));
+    for (Operation *op : chain) {
+      rewriter.eraseOp(op);
+    }
+    rewriter.eraseOp(up);
+    rewriter.eraseOp(projection);
+    return success();
+  }
+};
