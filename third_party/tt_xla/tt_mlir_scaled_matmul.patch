+def TTNN_ScaledMatmulOp : TTNN_Op<"scaled_matmul", [OpModelExempt]> {
+  let summary = "Matmul with per-row and per-column output scales.";
+  let description = [{
+    ttnn::matmul_scaled: the FP32 product of `a` and `b` times `row_scale`
+    ([M, 1] f32), then times `col_scale` ([1, N], [N, 1] or [1, 1] f32), each
+    as ttnn.multiply's FP32 multiply, rounded to the result type as
+    ttnn.multiply rounds: torch._scaled_mm's dequantization of SGLang's FP8
+    linears, in the decode matmul's epilogue. ttir.fused_matmul lowers to it
+    (libtt's ttir-matmul-epilogues forms that).
+  }];
+  let arguments = (ins AnyRankedTensor:$a,
+                       AnyRankedTensor:$b,
+                       AnyRankedTensor:$row_scale,
+                       AnyRankedTensor:$col_scale,
+                       DefaultValuedAttr<BoolAttr, "false">:$transpose_b,
+                       OptionalAttr<TTNN_DeviceComputeKernelConfig>:$compute_config);
+  let results = (outs AnyRankedTensor:$result);
+}
