 // Fold the decode MLP's concatenated [up | gate] projection and SwiGLU into a
 // single half-width matmul.  The runtime implements this marker with a
 // two-weight matmul that keeps matching up/gate accumulators on the same core.
+// Fold the dequantization of SGLang-TorchTPU's FP8 linears, (matmul *
+// row_scale) * col_scale in FP32, then narrowed to BF16, into the decode
+// matmul's epilogue (ttnn::matmul_scaled, which falls back to these ops past
+// one tile row of activations). The operands are float8, the product and
+// scales f32, the row scale [M, 1], the column scale [1, N] or one element.
+class TTNNMatmulWithOutputScales : public mlir::OpRewritePattern<MultiplyOp> {
+public:
+  TTNNMatmulWithOutputScales(mlir::MLIRContext *context)
+      : mlir::OpRewritePattern<MultiplyOp>(context, /*benefit=*/2) {}
+
+  mlir::LogicalResult
+  matchAndRewrite(MultiplyOp outer,
+                  mlir::PatternRewriter &rewriter) const final {
+    auto plain = [](MultiplyOp op) {
+      return op.getActivations().empty() &&
+             op.getInputTensorAActivations().empty() &&
+             op.getInputTensorBActivations().empty();
+    };
+    // The multiply of a defining op of type T by another value, either way
+    // round.
+    auto factorOf = [](auto opType, MultiplyOp op, Value &other) {
+      using T = decltype(opType);
+      if (auto def = op.getLhs().getDefiningOp<T>()) {
+        other = op.getRhs();
+        return def;
+      }
+      if (auto def = op.getRhs().getDefiningOp<T>()) {
+        other = op.getLhs();
+        return def;
+      }
+      return T();
+    };
+    Value colScale, rowScale;
+    MultiplyOp inner = factorOf(MultiplyOp(), outer, colScale);
+    if (!plain(outer) || !inner || !plain(inner) ||
+        !inner.getResult().hasOneUse()) {
+      return failure();
+    }
+    MatmulOp matmulOp = factorOf(MatmulOp(), inner, rowScale);
+    if (!matmulOp || !matmulOp.getResult().hasOneUse() ||
+        matmulOp.getTransposeA() || matmulOp.getActivation() ||
+        matmulOp.getMatmulProgramConfigAttr() ||
+        matmulOp->hasAttr("ttnn.fused_swiglu") ||
+        matmulOp->hasAttr("ttcore.fp32_exact")) {
+      return failure();
+    }
+    // Only float8 matmuls: others keep their weight-format rewrites.
+    auto isFloat8 = [](Value v) {
+      return mlir::isa<Float8E4M3FNType, Float8E5M2Type>(
+          mlir::cast<RankedTensorType>(v.getType()).getElementType());
+    };
+    if (!isFloat8(matmulOp.getA()) || !isFloat8(matmulOp.getB())) {
+      return failure();
+    }
+    auto productType = matmulOp.getType();
+    auto rowType = mlir::cast<RankedTensorType>(rowScale.getType());
+    auto colType = mlir::cast<RankedTensorType>(colScale.getType());
+    if (productType.getRank() != 2 || !productType.getElementType().isF32() ||
+        !inner.getType().getElementType().isF32() ||
+        !rowType.getElementType().isF32() ||
+        !colType.getElementType().isF32()) {
+      return failure();
+    }
+    const int64_t rows = productType.getDimSize(0);
+    const int64_t cols = productType.getDimSize(1);
+    auto [tileHeight, tileWidth] = ttcore::TileType::getDefaultShape();
+    if (rows > tileHeight ||
+        rowType.getShape() != ArrayRef<int64_t>{rows, 1} ||
+        (colType.getNumElements() != 1 &&
+         colType.getShape() != ArrayRef<int64_t>{1, cols})) {
+      return failure();
+    }
+    // The result: the outer multiply's, or its only use's, a typecast of it
+    // to BF16.
+    mlir::Operation *last = outer;
+    RankedTensorType resultType = outer.getType();
+    if (resultType.getElementType().isF32() && outer.getResult().hasOneUse()) {
+      if (auto cast = mlir::dyn_cast<TypecastOp>(
+              *outer.getResult().getUsers().begin());
+          cast && cast.getType().getElementType().isBF16()) {
+        last = cast;
+        resultType = cast.getType();
+      }
+    }
+    if (!resultType.getElementType().isF32() &&
+        !resultType.getElementType().isBF16()) {
+      return failure();
+    }
+    rewriter.setInsertionPoint(last);
+    auto fused = rewriter.create<ScaledMatmulOp>(
+        last->getLoc(), resultType, matmulOp.getA(), matmulOp.getB(), rowScale,
+        colScale, matmulOp.getTransposeBAttr(),
+        matmulOp.getComputeConfigAttr());
+    rewriter.replaceOp(last, fused.getResult());
+    if (last != outer.getOperation()) {
+      rewriter.eraseOp(outer);
+    }
+    rewriter.eraseOp(inner);
+    rewriter.eraseOp(matmulOp);
+    return success();
+  }
+};
