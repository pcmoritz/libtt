+  let summary = "Matmul with per-row and per-column output scales.";
+  let description = [{
+    ttnn::matmul_scaled: the FP32 product of `a` and `b` times `row_scale`
+    ([M, 1] f32), then times `col_scale` ([1, N], [N, 1] or [1, 1] f32), each
