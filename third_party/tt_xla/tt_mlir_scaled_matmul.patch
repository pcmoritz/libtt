+::flatbuffers::Offset<::tt::target::ttnn::ScaledMatmulOp>
+createOp(FlatbufferObjectCache &cache, ScaledMatmulOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  auto output = cache.getOrCreateNoSharding(
+      op.getResult(), tensorValueToFlatbuffer, std::nullopt);
+  std::optional<
+      ::flatbuffers::Offset<::tt::target::ttnn::DeviceComputeKernelConfig>>
+      computeConfig = toFlatbuffer(cache, op.getComputeConfig());
+  return ::tt::target::ttnn::CreateScaledMatmulOp(
+      *cache.fbb, tensor(op.getA()), tensor(op.getB()),
+      tensor(op.getRowScale()), tensor(op.getColScale()), output,
+      op.getTransposeB(), computeConfig.value_or(0));
+}
