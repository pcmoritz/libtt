+      ValueRange operands = adaptor.getOperands();
+      Value stateSlots = operands.size() == fixed + 1 ? operands[5] : Value();
+      Value dynamicWeight = dynamic ? operands.back() : Value();
+      auto headDim =
+          config ? dyn_cast_or_null<IntegerAttr>(config.get("head_dim"))
+                 : nullptr;
+      auto outputScale =
+          config ? dyn_cast_or_null<FloatAttr>(config.get("output_scale"))
+                 : nullptr;
+      auto applySilu = flag("apply_silu");
       auto type = getTypeConverter()->convertType(op.getResult(1).getType());
