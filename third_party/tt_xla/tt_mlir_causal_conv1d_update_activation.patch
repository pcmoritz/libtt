+          op.getLoc(), type, operands[0], operands[1], operands[2],
+          operands[3], operands[4], stateSlots, dynamicWeight,
+          rewriter.getBoolAttr(applySilu ? applySilu.getValue() : true),
+          rewriter.getI64IntegerAttr(headDim ? headDim.getInt() : 0),
+          rewriter.getF32FloatAttr(
+              outputScale ? outputScale.getValueAsDouble() : 1.0));
+      rewriter.replaceOp(op, {operands[0], result.getResult()});
       return success();
     }
     if (name == "tt.state_pool_update") {
