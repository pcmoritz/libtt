+        return value;
+      };
+      const bool dynamic =
+          flag("has_dynamic_weight") && flag("has_dynamic_weight").getValue();
+      // An optional operand after the first five holds the state slots of a
+      // multi-step call.
+      const size_t fixed = 5 + size_t{dynamic};
+      if ((op.getNumOperands() != fixed && op.getNumOperands() != fixed + 1) ||
           op.getNumResults() != 2) {
         return op.emitOpError("invalid recurrent call arity");
       }
       if (failed(requireOutputOperandAlias(op, 0, 0))) {
         return failure();
