diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -10241,6 +10241,17 @@ public:
       auto type = getTypeConverter()->convertType(op.getResult(1).getType());
       auto result = rewriter.create<ttir::CausalConv1dUpdateOp>(
           op.getLoc(), type, adaptor.getOperands());
+      // backend_config's apply_silu = false runs the plain convolution.
+      auto config = dyn_cast_or_null<DictionaryAttr>(op.getBackendConfigAttr());
+      if (!config) {
+        config = dyn_cast_or_null<DictionaryAttr>(
+            op->getDiscardableAttr("mhlo.backend_config"));
+      }
+      if (auto applySilu =
+              config ? dyn_cast_or_null<BoolAttr>(config.get("apply_silu"))
+                     : nullptr) {
+        result.setApplySiluAttr(applySilu);
+      }
       rewriter.replaceOp(op, {adaptor.getOperands()[0], result.getResult()});
       return success();
     }
