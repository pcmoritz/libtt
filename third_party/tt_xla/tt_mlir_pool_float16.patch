diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -4552,8 +4552,15 @@
     for (int64_t element : kernel) {
       kernelSize *= element;
     }
-    int64_t divisor =
-        constantOp.getValueAttr().getSplatValue<llvm::APInt>().getZExtValue();
+    // Average pooling divides a float sum by a float constant.
+    mlir::Attribute value =
+        constantOp.getValueAttr().getSplatValue<mlir::Attribute>();
+    double divisor = 0;
+    if (auto floatValue = mlir::dyn_cast<mlir::FloatAttr>(value)) {
+      divisor = floatValue.getValueAsDouble();
+    } else if (auto intValue = mlir::dyn_cast<mlir::IntegerAttr>(value)) {
+      divisor = intValue.getValue().getZExtValue();
+    }
     if (divisor == kernelSize) {
       return divOp;
     }
