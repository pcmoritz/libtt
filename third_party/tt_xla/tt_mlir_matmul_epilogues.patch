+def TTIR_FusedMatmulOp : TTIR_NamedOp<"fused_matmul", [AttrSizedOperandSegments]> {
+  let summary = "A matmul with the epilogue its TTNN kernel applies as it writes";
+  let description = [{
+    a @ b, a or b transposed if transpose_a or transpose_b, with
+    - bias added (ttnn.linear), or
+    - in FP32, times row_scale [M, 1] and col_scale [1, N] ([N, 1] taken as
+      its transpose, or one element), a and b float8 (ttnn.scaled_matmul),
+    and then
+    - activation (silu, gelu or sigmoid) applied, or
+    - fused_swiglu: the product's halves [up | gate] combined as
+      up * silu(gate); with exact_swiglu, [gate | up] as
+      BF16(silu(FP32(gate))) * up, rounded as those ops round (PyTorch's
+      SiluAndMul).
+    libtt's ttir-matmul-epilogues forms it; it lowers to ttnn.matmul,
+    ttnn.linear or ttnn.scaled_matmul with the same epilogue.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$a,
+                       AnyRankedTensor:$b,
+                       Optional<AnyRankedTensor>:$bias,
+                       Optional<AnyRankedTensor>:$row_scale,
+                       Optional<AnyRankedTensor>:$col_scale,
+                       DefaultValuedAttr<BoolAttr, "false">:$transpose_a,
+                       DefaultValuedAttr<BoolAttr, "false">:$transpose_b,
+                       OptionalAttr<StrAttr>:$activation,
+                       UnitAttr:$fused_swiglu,
+                       UnitAttr:$exact_swiglu);
+
+  let results = (outs AnyRankedTensor:$result);
+}
