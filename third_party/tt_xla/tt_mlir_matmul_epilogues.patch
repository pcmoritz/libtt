+// A matmul with an epilogue (libtt's ttir-matmul-epilogues): ttnn.scaled_matmul
+// with output scales, ttnn.linear with a bias, ttnn.matmul otherwise.
+class FusedMatmulOpConversionPattern
+    : public OpConversionPattern<ttir::FusedMatmulOp> {
+public:
+  using OpConversionPattern<ttir::FusedMatmulOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::FusedMatmulOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    Type type = this->getTypeConverter()->convertType(op.getType());
+    Operation *newOp;
+    if (adaptor.getRowScale()) {
+      newOp = rewriter.create<ttnn::ScaledMatmulOp>(
+          op.getLoc(), type, adaptor.getA(), adaptor.getB(),
+          adaptor.getRowScale(), adaptor.getColScale(), op.getTransposeBAttr(),
+          /*compute_config=*/nullptr);
+    } else if (adaptor.getBias()) {
+      newOp = rewriter.create<ttnn::LinearOp>(
+          op.getLoc(), type, adaptor.getA(), adaptor.getB(), adaptor.getBias(),
+          adaptor.getTransposeA(), adaptor.getTransposeB(),
+          /*matmul_program_config=*/nullptr, op.getActivationAttr(),
+          /*compute_config=*/nullptr);
+    } else {
+      newOp = rewriter.create<ttnn::MatmulOp>(
+          op.getLoc(), type, adaptor.getA(), adaptor.getB(),
+          adaptor.getTransposeA(), adaptor.getTransposeB(),
+          /*matmul_program_config=*/nullptr, op.getActivationAttr());
+    }
+    if (auto attr = op->getAttr("ttcore.weight_dtype")) {
+      newOp->setAttr("ttcore.weight_dtype", attr);
+    }
+    if (op.getFusedSwiglu()) {
+      newOp->setAttr("ttnn.fused_swiglu", rewriter.getUnitAttr());
+    }
+    if (op.getExactSwiglu()) {
+      newOp->setAttr("ttnn.exact_swiglu", rewriter.getUnitAttr());
+    }
+    rewriter.replaceOp(op, newOp->getResults());
+    return success();
+  }
+};
 } // namespace
 // ANCHOR_END: adding_an_op_matmul_op_rewriter
 
