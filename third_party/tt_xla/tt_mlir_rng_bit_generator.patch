+    const uint32_t width = std::min<uint32_t>(elementType.getWidth(), 32);
+    auto bitsType = RankedTensorType::get(
+        shape, width < 32 ? rewriter.getIntegerType(32, false) : elementType);
+    auto rng = rewriter.create<ttir::RngBitGeneratorOp>(
