+::flatbuffers::Offset<::tt::target::ttnn::RngBitGeneratorOp>
+createRngBitGeneratorOp(FlatbufferObjectCache &cache, RngBitGeneratorOp op) {
+  auto state = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getInitialState()));
+  auto outputState = cache.getOrCreateNoSharding(
+      op.getOutputState(), tensorValueToFlatbuffer, /*local_shape*/ std::nullopt);
+  auto out = cache.getOrCreateNoSharding(
+      op.getOutput(), tensorValueToFlatbuffer, /*local_shape*/ std::nullopt);
+  return ::tt::target::ttnn::CreateRngBitGeneratorOp(
+      *cache.fbb, state, op.getPhilox(), op.getWidth(), outputState, out);
+}
