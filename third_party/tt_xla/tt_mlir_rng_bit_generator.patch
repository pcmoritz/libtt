+public:
+  using OpConversionPattern<ttir::RngBitGeneratorOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::RngBitGeneratorOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> resultTypes;
+    if (failed(this->getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                      resultTypes))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::RngBitGeneratorOp>(
+        op, resultTypes[0], resultTypes[1], adaptor.getInitialState(),
+        adaptor.getPhilox());
+    return success();
+  }
+};
