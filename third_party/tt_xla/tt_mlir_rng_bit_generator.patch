+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttmlir/Dialect/StableHLO/Transforms/Passes.h"
+
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/SymbolTable.h"
+#include "stablehlo/dialect/StablehloOps.h"
+
+using namespace mlir;
+
+namespace mlir::tt::stablehlo {
+#define GEN_PASS_DEF_STABLEHLOEXPANDRNGBITGENERATORPASS
+#include "ttmlir/Dialect/StableHLO/Transforms/Passes.h.inc"
+
+//===----------------------------------------------------------------------===//
+// ExpandRngBitGenerator overview
+//===----------------------------------------------------------------------===//
+// stablehlo.rng_bit_generator returns random bits that are a function of its
+// state: the same state gives the same bits, which is what makes
+// torch.manual_seed reproducible. This pass computes them on the device with
+// the requested algorithm, from 32-bit integer arithmetic:
+//
+//   DEFAULT, THREE_FRY: Threefry-2x32 with 20 rounds (JAX's threefry2x32)
+//   PHILOX:             Philox-4x32 with 10 rounds (Random123's philox4x32_10)
+//
+// Both are counter-based. With the state's words w0, w1 (and w2, for a
+// three-word Philox state; torch_tpu's state is [seed, offset]), the key is
+// (w0, 0) and the i-th counter is (i, w1) for Threefry and (i, w1, w2, 0) for
+// Philox. Each counter gives two (Threefry) or four (Philox) 32-bit words; the
+// output takes the first words of all counters, then the second words, and so
+// on. The output state advances w1 by one per four output elements, so the
+// next call uses other counters.
+//
+// DEFAULT and THREE_FRY use the state's first two words. The device computes
+// 64-bit integers in 32 bits: the state's words count modulo 2^32, and 64-bit
+// outputs have 32 random low bits. Outputs other than unsigned integers, and
+// states of fewer than two words, are errors.
+//===----------------------------------------------------------------------===//
+
+namespace {
+
+// Unsigned 32-bit arithmetic on tensor<size x ui32>.
+class Arith {
+public:
+  Arith(OpBuilder &builder, Location loc, int64_t size, SymbolTable &symbols)
+      : b(builder), loc(loc), symbols(symbols),
+        type(RankedTensorType::get({size},
+                                   builder.getIntegerType(32, false))) {}
+
+  Value constant(uint32_t value) {
+    return b.create<mlir::stablehlo::ConstantOp>(
+        loc, DenseElementsAttr::get(type, ArrayRef<uint32_t>{value}));
+  }
+  // A tensor<1xui32>, broadcast to this shape.
+  Value broadcast(Value word) {
+    return b.create<mlir::stablehlo::BroadcastInDimOp>(
+        loc, type, word, b.getDenseI64ArrayAttr({0}));
+  }
+  Value iota() { return b.create<mlir::stablehlo::IotaOp>(loc, type, 0); }
+  Value add(Value x, Value y) {
+    return b.create<mlir::stablehlo::AddOp>(loc, x, y);
+  }
+  Value add(Value x, uint32_t y) { return add(x, constant(y)); }
+  Value xorOp(Value x, Value y) {
+    return b.create<mlir::stablehlo::XorOp>(loc, x, y);
+  }
+  Value rotateLeft(Value x, int r) {
+    return b.create<mlir::stablehlo::OrOp>(
+        loc, b.create<mlir::stablehlo::ShiftLeftOp>(loc, x, constant(r)),
+        b.create<mlir::stablehlo::ShiftRightLogicalOp>(loc, x,
+                                                       constant(32 - r)));
+  }
+  // The low and high halves of the 64-bit product. The high half is a
+  // chlo.mulhi composite, as JAX emits for lax.mulhi, which runs as ttir.mulhi.
+  std::pair<Value, Value> multiply(uint32_t x, Value y) {
+    Value low = b.create<mlir::stablehlo::MulOp>(loc, constant(x), y);
+    Value high =
+        b.create<mlir::stablehlo::CompositeOp>(
+             loc, TypeRange{type}, ValueRange{constant(x), y}, "chlo.mulhi",
+             b.getDictionaryAttr({}), mulhiDecomposition().getSymName())
+            .getResult(0);
+    return {low, high};
+  }
+
+  // Threefry-2x32 with 20 rounds of the counters x under the key k.
+  std::array<Value, 2> threefry(std::array<Value, 2> k,
+                                std::array<Value, 2> x) {
+    static constexpr int kRotations[2][4] = {{13, 15, 26, 6},
+                                             {17, 29, 16, 24}};
+    Value ks[3] = {k[0], k[1], xorOp(xorOp(k[0], k[1]), constant(0x1BD11BDA))};
+    x[0] = add(x[0], ks[0]);
+    x[1] = add(x[1], ks[1]);
+    for (int i = 0; i < 5; ++i) {
+      for (int r : kRotations[i % 2]) {
+        x[0] = add(x[0], x[1]);
+        x[1] = xorOp(rotateLeft(x[1], r), x[0]);
+      }
+      x[0] = add(x[0], ks[(i + 1) % 3]);
+      x[1] = add(add(x[1], ks[(i + 2) % 3]), i + 1);
+    }
+    return x;
+  }
+
+  // Philox-4x32 with 10 rounds of the counters x under the key k.
+  std::array<Value, 4> philox(std::array<Value, 2> k, std::array<Value, 4> x) {
+    for (int round = 0; round < 10; ++round) {
+      if (round > 0) {
+        k = {add(k[0], 0x9E3779B9), add(k[1], 0xBB67AE85)};
+      }
+      auto [low0, high0] = multiply(0xD2511F53, x[0]);
+      auto [low1, high1] = multiply(0xCD9E8D57, x[2]);
+      x = {xorOp(xorOp(high1, x[1]), k[0]), low1,
+           xorOp(xorOp(high0, x[3]), k[1]), low0};
+    }
+    return x;
+  }
+
+private:
+  // The chlo.mulhi composite's decomposition: the 64-bit product's high half.
+  func::FuncOp mulhiDecomposition() {
+    if (decomposition) {
+      return decomposition;
+    }
+    OpBuilder::InsertionGuard guard(b);
+    b.setInsertionPointToEnd(&symbols.getOp()->getRegion(0).front());
+    decomposition = b.create<func::FuncOp>(
+        loc, "rng_bit_generator_mulhi", b.getFunctionType({type, type}, type));
+    decomposition.setPrivate();
+    symbols.insert(decomposition);
+    b.setInsertionPointToStart(decomposition.addEntryBlock());
+    auto wide = type.clone(b.getIntegerType(64, false));
+    Value x = b.create<mlir::stablehlo::ConvertOp>(
+        loc, wide, decomposition.getArgument(0));
+    Value y = b.create<mlir::stablehlo::ConvertOp>(
+        loc, wide, decomposition.getArgument(1));
+    Value high = b.create<mlir::stablehlo::ShiftRightLogicalOp>(
+        loc, b.create<mlir::stablehlo::MulOp>(loc, x, y),
+        b.create<mlir::stablehlo::ConstantOp>(
+            loc, DenseElementsAttr::get(wide, ArrayRef<uint64_t>{32})));
+    b.create<func::ReturnOp>(
+        loc, ValueRange{b.create<mlir::stablehlo::ConvertOp>(loc, type, high)});
+    return decomposition;
+  }
+
+  OpBuilder &b;
+  Location loc;
+  SymbolTable &symbols;
+  func::FuncOp decomposition;
+
+public:
+  RankedTensorType type;
+};
+
+// Word `index` of the state as a tensor<1xui32> (its low 32 bits).
+Value stateWord(OpBuilder &b, Location loc, Value state, int64_t index) {
+  Value word = b.create<mlir::stablehlo::SliceOp>(
+      loc, state, b.getDenseI64ArrayAttr({index}),
+      b.getDenseI64ArrayAttr({index + 1}), b.getDenseI64ArrayAttr({1}));
+  auto ui32 = b.getIntegerType(32, false);
+  if (cast<RankedTensorType>(word.getType()).getElementType() != ui32) {
+    word = b.create<mlir::stablehlo::ConvertOp>(loc, word, ui32);
+  }
+  return word;
+}
+
+LogicalResult expand(mlir::stablehlo::RngBitGeneratorOp op,
+                     SymbolTable &symbols) {
+  Value state = op.getInitialState();
+  auto stateType = cast<RankedTensorType>(state.getType());
+  auto outputType = cast<RankedTensorType>(op.getOutput().getType());
+  auto stateElementType = dyn_cast<IntegerType>(stateType.getElementType());
+  auto elementType = dyn_cast<IntegerType>(outputType.getElementType());
+  if (!outputType.hasStaticShape() || !stateType.hasStaticShape()) {
+    return op.emitOpError("with a dynamic shape isn't supported");
+  }
+  if (!elementType || !elementType.isUnsigned() ||
+      elementType.getWidth() > 64) {
+    return op.emitOpError("generates unsigned integers of up to 64 bits, not ")
+           << outputType.getElementType();
+  }
+  if (stateType.getRank() != 1 || stateType.getDimSize(0) < 2 ||
+      !stateElementType ||
+      (stateElementType.getWidth() != 32 &&
+       stateElementType.getWidth() != 64)) {
+    return op.emitOpError("needs a state of at least two 32- or 64-bit "
+                          "integers, not ")
+           << stateType;
+  }
+  bool philox =
+      op.getRngAlgorithm() == mlir::stablehlo::RngAlgorithm::PHILOX;
+
+  OpBuilder b(op);
+  Location loc = op.getLoc();
+  const int64_t elements = outputType.getNumElements();
+  if (elements == 0) {
+    op->replaceAllUsesWith(ValueRange{
+        state, b.create<mlir::stablehlo::ConstantOp>(
+                   loc, DenseElementsAttr::get(outputType, ArrayRef<APInt>{}))});
+    op->erase();
+    return success();
+  }
+  // One counter per two (Threefry) or four (Philox) elements.
+  const int64_t width = philox ? 4 : 2;
+  const int64_t counters = (elements + width - 1) / width;
+  Arith arith(b, loc, counters, symbols);
+  std::array<Value, 2> key = {arith.broadcast(stateWord(b, loc, state, 0)),
+                              arith.constant(0)};
+  Value offset = arith.broadcast(stateWord(b, loc, state, 1));
+  SmallVector<Value> words;
+  if (philox) {
+    Value high = stateType.getDimSize(0) > 2
+                     ? arith.broadcast(stateWord(b, loc, state, 2))
+                     : arith.constant(0);
+    auto x = arith.philox(key, {arith.iota(), offset, high, arith.constant(0)});
+    words.assign(x.begin(), x.end());
+  } else {
+    auto x = arith.threefry(key, {arith.iota(), offset});
+    words.assign(x.begin(), x.end());
+  }
+
+  Value bits = b.create<mlir::stablehlo::ConcatenateOp>(loc, words, 0);
+  auto ui32 = b.getIntegerType(32, false);
+  if (width * counters != elements) {
+    bits = b.create<mlir::stablehlo::SliceOp>(
+        loc, bits, b.getDenseI64ArrayAttr({0}),
+        b.getDenseI64ArrayAttr({elements}), b.getDenseI64ArrayAttr({1}));
+  }
+  if (elementType.getWidth() < 32) {
+    // The low bits of each word.
+    bits = b.create<mlir::stablehlo::AndOp>(
+        loc, bits,
+        b.create<mlir::stablehlo::ConstantOp>(
+            loc, DenseElementsAttr::get(
+                     cast<RankedTensorType>(bits.getType()),
+                     ArrayRef<uint32_t>{static_cast<uint32_t>(
+                         (uint64_t{1} << elementType.getWidth()) - 1)})));
+  }
+  Value output = b.create<mlir::stablehlo::ReshapeOp>(
+      loc, outputType.clone(ui32), bits);
+  if (elementType.getWidth() != 32) {
+    output = b.create<mlir::stablehlo::ConvertOp>(loc, outputType, output);
+  }
+
+  // The state's second word advances by one per four elements.
+  SmallVector<APInt> advance(stateType.getDimSize(0),
+                             APInt(stateElementType.getWidth(), 0));
+  advance[1] = APInt(stateElementType.getWidth(), (elements + 3) / 4);
+  Value outputState = b.create<mlir::stablehlo::AddOp>(
+      loc, state,
+      b.create<mlir::stablehlo::ConstantOp>(
+          loc, DenseElementsAttr::get(stateType, advance)));
+
+  op->replaceAllUsesWith(ValueRange{outputState, output});
+  op->erase();
+  return success();
+}
+
+struct StableHLOExpandRngBitGeneratorPass
+    : public impl::StableHLOExpandRngBitGeneratorPassBase<
+          StableHLOExpandRngBitGeneratorPass> {
+  using impl::StableHLOExpandRngBitGeneratorPassBase<
+      StableHLOExpandRngBitGeneratorPass>::
+      StableHLOExpandRngBitGeneratorPassBase;
+
+  void runOnOperation() override {
+    SymbolTable symbols(getOperation());
+    SmallVector<mlir::stablehlo::RngBitGeneratorOp> ops;
+    getOperation().walk(
+        [&](mlir::stablehlo::RngBitGeneratorOp op) { ops.push_back(op); });
+    for (auto op : ops) {
+      if (failed(expand(op, symbols))) {
+        return signalPassFailure();
+      }
+    }
+  }
+};
+
+} // namespace
+} // namespace mlir::tt::stablehlo
