+def TTIR_RngBitGeneratorOp : TTIR_NamedOp<"rng_bit_generator"> {
+  let summary = "Counter-based random bits from a state.";
+  let description = [{
+    stablehlo.rng_bit_generator on the device. The state is a vector of at
+    least two words w0, w1, ...; the key is (w0, 0), and element i of `output`
+    (in row-major order) is the low `width` bits of the first word of
+    Threefry-2x32 with 20 rounds of counter (i, w1), or with `philox`, of
+    Philox-4x32 with 10 rounds of counter (i, w1, w2 or 0, 0).
+    `output_state` is the state with w1 advanced by ceil(elements / 4), so the
+    next call uses other counters. The words count modulo 2^32.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$initial_state,
+                       DefaultValuedAttr<BoolAttr, "false">:$philox,
+                       DefaultValuedAttr<UI32Attr, "32">:$width);
+
+  let results = (outs AnyRankedTensor:$output_state,
+                      AnyRankedTensor:$output);
+}
