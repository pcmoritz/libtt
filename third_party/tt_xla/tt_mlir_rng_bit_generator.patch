+def TTIR_RngBitGeneratorOp : TTIR_NamedOp<"rng_bit_generator"> {
+  let summary = "Counter-based random bits from a state.";
+  let description = [{
+    stablehlo.rng_bit_generator with uint64 state represented as uint32[n, 2]
+    low/high pairs, for 2 <= n <= 16. For low words w0, w1, w2 and high words
+    h0, h1, h2, element i of `output` is the first word of Threefry-2x32-20
+    with key (w0 ^ h1, h0), counter (i, w1), or with `philox`, of
+    Philox-4x32-10 with key (w0, h0 ^ h2), counter (i, w1, w2, h1).
+    Missing w2/h2 are zero. `output_state` increments the second uint64
+    element by one modulo 2^64. `output` contains uint32 words.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$initial_state,
+                       DefaultValuedAttr<BoolAttr, "false">:$philox);
+
+  let results = (outs AnyRankedTensor:$output_state,
+                      AnyRankedTensor:$output);
+}
