+  // page, which has livelocked the kernel.
+  static const std::uint64_t kMaxAliasedBytes =
+      (std::uint64_t{32} << 20) / std::max<size_t>(getNumAvailableDevices(), 1);
   std::shared_ptr<void> borrowed =
