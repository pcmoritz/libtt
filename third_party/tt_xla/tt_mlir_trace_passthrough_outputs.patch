diff --git a/test/ttmlir/Dialect/TTNN/trace/passthrough_barrier_output.mlir b/test/ttmlir/Dialect/TTNN/trace/passthrough_barrier_output.mlir
new file mode 100644
--- /dev/null
+++ b/test/ttmlir/Dialect/TTNN/trace/passthrough_barrier_output.mlir
@@ -0,0 +1,36 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// RUN: ttmlir-opt --ttnn-trace-hoist-transform -o %t %s
+// RUN: FileCheck %s --input-file=%t
+
+#dram = #ttnn.buffer_type<dram>
+#layout = #ttnn.ttnn_layout<(d0, d1) -> (d0, d1), <1x1>, memref<1x1x!ttcore.tile<32x32, bf16>, #dram>, <interleaved>>
+
+module {
+  // The barrier remains in the trace to preserve ordering, but its pass-through
+  // result does not add an output-slot argument or a device copy.
+  // CHECK-LABEL: func.func private @trace_0_main
+  // CHECK-SAME: (%arg0: tensor<32x32xbf16, #ttnn_layout>, %arg1: tensor<32x32xbf16, #ttnn_layout>, %arg2: tensor<32x32xbf16, #ttnn_layout>)
+  // CHECK: "ttnn.add"
+  // CHECK: "ttcore.optimization_barrier"
+  // CHECK-COUNT-1: "ttnn.copy"
+
+  // Two input slots and only the add-result output slot are allocated.
+  // CHECK-LABEL: func.func private @allocate_slots_trace_0_main
+  // CHECK-SAME: () -> (tensor<32x32xbf16, #ttnn_layout>, tensor<32x32xbf16, #ttnn_layout>, tensor<32x32xbf16, #ttnn_layout>)
+
+  // The public function returns the original state argument and the sole trace
+  // result. No trace result is created for the barrier identity.
+  // CHECK-LABEL: func.func @main
+  // CHECK: %[[RESULT:.+]] = "ttnn.capture_or_execute_trace"
+  // CHECK-SAME: -> tensor<32x32xbf16, #ttnn_layout>
+  // CHECK: return %arg0, %[[RESULT]]
+
+  func.func @main(%arg0: tensor<32x32xbf16, #layout>, %arg1: tensor<32x32xbf16, #layout>) -> (tensor<32x32xbf16, #layout>, tensor<32x32xbf16, #layout>) attributes {tt.function_type = "forward_device"} {
+    %sum = "ttnn.add"(%arg0, %arg1) : (tensor<32x32xbf16, #layout>, tensor<32x32xbf16, #layout>) -> tensor<32x32xbf16, #layout>
+    %state = "ttcore.optimization_barrier"(%arg0) : (tensor<32x32xbf16, #layout>) -> tensor<32x32xbf16, #layout>
+    return %state, %sum : tensor<32x32xbf16, #layout>, tensor<32x32xbf16, #layout>
+  }
+}
