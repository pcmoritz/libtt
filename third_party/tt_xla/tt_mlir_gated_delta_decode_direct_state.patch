+      tensorPool.getTTNNTensorAndValidate(op->state_pool());
+  const ::ttnn::Tensor &stateIndices =
+      tensorPool.getTTNNTensorAndValidate(op->state_indices());
+  const auto &poolShape = statePool.logical_shape();
+  const auto &indicesShape = stateIndices.logical_shape();
+  TT_FATAL(poolShape.rank() == 4 && indicesShape.rank() == 1,
+           "state pool gather expects rank-4 pool and rank-1 indices");
+  ::ttnn::Tensor state = ::ttnn::empty(
+      ::ttnn::Shape{indicesShape[0], poolShape[1], poolShape[2], poolShape[3]},
+      statePool.dtype(), statePool.layout(), statePool.device(),
+      statePool.memory_config());
+  (void)::ttnn::transformer::state_pool_gather(statePool, stateIndices, state);
+  tensorPool.insertTTNNTensorAndValidate(op->state(), state);
