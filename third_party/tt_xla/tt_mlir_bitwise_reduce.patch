 private:
+  // StableHLO reduces integers with bitwise and/or/xor, but TTIR only has
+  // logical and/or reductions on booleans. Matches a single-input reduce whose
+  // body applies one of these ops directly to its arguments, for integer
+  // inputs, or xor for boolean inputs.
+  bool isElementwiseFoldReduction(mlir::stablehlo::ReduceOp &srcOp) const {
+    if (srcOp.getInputs().size() != 1 || !srcOp.getBody().hasOneBlock()) {
+      return false;
+    }
+    Block &body = srcOp.getBody().front();
+    if (body.getNumArguments() != 2 || body.getOperations().size() != 2) {
+      return false;
+    }
+    Operation &combiner = body.front();
+    if (!mlir::isa<mlir::stablehlo::AndOp, mlir::stablehlo::OrOp,
+                   mlir::stablehlo::XorOp>(combiner)) {
+      return false;
+    }
+    auto returnOp =
+        mlir::dyn_cast<mlir::stablehlo::ReturnOp>(body.getTerminator());
+    if (!returnOp || returnOp.getNumOperands() != 1 ||
+        returnOp.getOperand(0) != combiner.getResult(0)) {
+      return false;
+    }
+    Value lhs = combiner.getOperand(0);
+    Value rhs = combiner.getOperand(1);
+    Value accumulator = body.getArgument(0);
+    Value element = body.getArgument(1);
+    if (!((lhs == accumulator && rhs == element) ||
+          (lhs == element && rhs == accumulator))) {
+      return false;
+    }
+    auto inputType =
+        mlir::cast<RankedTensorType>(srcOp.getInputs().front().getType());
+    return inputType.getElementTypeBitWidth() != 1 ||
+           mlir::isa<mlir::stablehlo::XorOp>(combiner);
+  }
+
+  // Boolean and/or keep their ttir.reduce_and/reduce_or lowering, so the
+  // halves are combined bitwise, or with logical xor for booleans.
+  LogicalResult
+  matchAndRewriteElementwiseFold(mlir::stablehlo::ReduceOp &srcOp,
+                                 mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                                 ConversionPatternRewriter &rewriter) const {
+    Operation &combiner = srcOp.getBody().front().front();
+    if (mlir::isa<mlir::stablehlo::AndOp>(combiner)) {
+      return rewriteTreeReduction<ttir::BitwiseAndOp>(srcOp, adaptor,
+                                                      rewriter);
+    }
+    if (mlir::isa<mlir::stablehlo::OrOp>(combiner)) {
+      return rewriteTreeReduction<ttir::BitwiseOrOp>(srcOp, adaptor, rewriter);
+    }
+    auto inputType =
+        mlir::cast<RankedTensorType>(adaptor.getInputs().front().getType());
+    if (inputType.getElementTypeBitWidth() == 1) {
+      return rewriteTreeReduction<ttir::LogicalXorOp>(srcOp, adaptor,
+                                                      rewriter);
+    }
+    return rewriteTreeReduction<ttir::BitwiseXorOp>(srcOp, adaptor, rewriter);
+  }
+
+  // Halves each reduced dimension until one element is left, combining the
+  // halves with CombineOp and carrying an odd middle element to the next
+  // step. The result is then combined with the init value unless that is the
+  // op's identity. Reducing an empty dimension yields the init value.
+  template <typename CombineOp>
+  LogicalResult
+  rewriteTreeReduction(mlir::stablehlo::ReduceOp &srcOp,
+                       mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                       ConversionPatternRewriter &rewriter) const {
+    Location loc = srcOp.getLoc();
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+    Value value = adaptor.getInputs().front();
+    auto inputType = mlir::cast<RankedTensorType>(value.getType());
+    llvm::ArrayRef<int64_t> dimensions = srcOp.getDimensions();
+
+    auto broadcastInit = [&](Value &init) {
+      return ttir::utils::broadcastValue(rewriter,
+                                         adaptor.getInitValues().front(),
+                                         outputType, init, loc,
+                                         /*frontUnsqueeze=*/false);
+    };
+    if (llvm::any_of(dimensions, [&](int64_t dim) {
+          return inputType.getDimSize(dim) == 0;
+        })) {
+      Value init;
+      if (failed(broadcastInit(init))) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "reduce init value is not broadcastable");
+      }
+      rewriter.replaceOp(srcOp, init);
+      return success();
+    }
+
+    auto combine = [&](Value lhs, Value rhs) -> Value {
+      return rewriter.create<CombineOp>(loc, lhs.getType(), lhs, rhs);
+    };
+    auto slice = [&](Value input, int64_t dim, int64_t begin,
+                     int64_t end) -> Value {
+      auto type = mlir::cast<RankedTensorType>(input.getType());
+      llvm::ArrayRef<int64_t> shape = type.getShape();
+      llvm::SmallVector<int32_t> begins(shape.size(), 0);
+      llvm::SmallVector<int32_t> ends(shape.begin(), shape.end());
+      llvm::SmallVector<int32_t> steps(shape.size(), 1);
+      begins[dim] = begin;
+      ends[dim] = end;
+      llvm::SmallVector<int64_t> sliceShape(shape);
+      sliceShape[dim] = end - begin;
+      return rewriter.create<ttir::SliceStaticOp>(
+          loc, type.clone(sliceShape), input, rewriter.getI32ArrayAttr(begins),
+          rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+    };
+
+    for (int64_t dim : dimensions) {
+      for (int64_t size = inputType.getDimSize(dim); size > 1;
+           size = (size + 1) / 2) {
+        int64_t half = size / 2;
+        Value folded = combine(slice(value, dim, 0, half),
+                               slice(value, dim, size - half, size));
+        if (size % 2 != 0) {
+          auto foldedType = mlir::cast<RankedTensorType>(folded.getType());
+          llvm::SmallVector<int64_t> foldedShape(foldedType.getShape());
+          foldedShape[dim] = half + 1;
+          llvm::SmallVector<Value> pieces = {
+              folded, slice(value, dim, half, half + 1)};
+          folded = rewriter.create<ttir::ConcatOp>(
+              loc, foldedType.clone(foldedShape), pieces, dim);
+        }
+        value = folded;
+      }
+    }
+
+    value = rewriter.create<ttir::ReshapeOp>(
+        loc, outputType, value,
+        rewriter.getI32ArrayAttr(
+            llvm::to_vector_of<int32_t>(outputType.getShape())));
+    if (!isIdentityInitValue(srcOp, srcOp.getBody().front().front())) {
+      Value init;
+      if (failed(broadcastInit(init))) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "reduce init value is not broadcastable");
+      }
+      value = combine(value, init);
+    }
+    rewriter.replaceOp(srcOp, value);
+    return success();
+  }
+
+  // All ones is the identity of and; zero is the identity of or and xor.
+  bool isIdentityInitValue(mlir::stablehlo::ReduceOp &srcOp,
+                           Operation &combiner) const {
+    auto constant = srcOp.getInitValues()
+                        .front()
+                        .getDefiningOp<mlir::stablehlo::ConstantOp>();
+    if (!constant || !constant.getValue().isSplat()) {
+      return false;
+    }
+    APInt init = constant.getValue().getSplatValue<APInt>();
+    return mlir::isa<mlir::stablehlo::AndOp>(combiner) ? init.isAllOnes()
+                                                       : init.isZero();
+  }
+
   LogicalResult
   checkConversionLegality(mlir::stablehlo::ReduceOp &srcOp,
                           mlir::stablehlo::ReduceOp::Adaptor adaptor,
