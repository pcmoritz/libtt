diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -326,6 +326,11 @@
       return matchAndRewriteInternal<mlir::tt::ttir::ProdOp>(srcOp, adaptor,
                                                              rewriter);
     }
+    if (mlir::isa<mlir::stablehlo::AndOp, mlir::stablehlo::OrOp,
+                  mlir::stablehlo::XorOp>(innerOp) &&
+        (!isBoolean(srcOp) || mlir::isa<mlir::stablehlo::XorOp>(innerOp))) {
+      return matchAndRewriteElementwiseTree(srcOp, adaptor, innerOp, rewriter);
+    }
     if (mlir::isa<mlir::stablehlo::AndOp>(innerOp)) {
       return matchAndRewriteInternal<mlir::tt::ttir::ReduceAndOp>(
           srcOp, adaptor, rewriter);
@@ -354,27 +359,92 @@
           "Expecting StableHLO Reduce OP to have a body operation defined.");
     }
 
-    mlir::Operation &innerOp = srcOp.getBody().front().front();
-    if (mlir::isa<mlir::stablehlo::AndOp>(innerOp) ||
-        mlir::isa<mlir::stablehlo::OrOp>(innerOp)) {
-      bool allOperandsAreBoolean = std::all_of(
-          srcOp->operand_begin(), srcOp->operand_end(), [](auto operand) {
-            return mlir::cast<RankedTensorType>(operand.getType())
-                       .getElementTypeBitWidth() == 1;
-          });
-      // Stablehlo (unlike other dialects) has single op for both logical and
-      // bitwise operation. Data type is used to distinguish between logical and
-      // bitwise operation. If the datatype is boolean then it is a logical
-      // operation; otherwise it is bitwise operation. This check ensure that
-      // the inputs are boolean as tt-metal only supports logical operations.
-      if (!allOperandsAreBoolean) {
-        return rewriter.notifyMatchFailure(
-            srcOp,
-            "stablehlo.reduce for stablehlo.and/stablehlo.or operator is only "
-            "supported for logical operator.");
+    return success();
+  }
+
+  // StableHLO has one op for logical and bitwise and/or/xor: on booleans they
+  // are logical.
+  static bool isBoolean(mlir::stablehlo::ReduceOp srcOp) {
+    return llvm::all_of(srcOp->getOperands(), [](Value operand) {
+      return mlir::cast<RankedTensorType>(operand.getType())
+                 .getElementTypeBitWidth() == 1;
+    });
+  }
+
+  // A bitwise and/or/xor reduction, or a logical xor, has no ttnn reduction.
+  // Each reduced dimension is halved with the elementwise op until it has one
+  // element, carrying an odd last element over; the result is then combined
+  // with the init value.
+  LogicalResult
+  matchAndRewriteElementwiseTree(mlir::stablehlo::ReduceOp &srcOp,
+                                 mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                                 const mlir::Operation &innerOp,
+                                 ConversionPatternRewriter &rewriter) const {
+    Location loc = srcOp.getLoc();
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResultTypes().front()));
+    Value result = adaptor.getInputs().front();
+    auto inputType = mlir::cast<RankedTensorType>(result.getType());
+    SmallVector<int64_t> shape(inputType.getShape());
+    bool isLogical = isBoolean(srcOp);
+    auto combine = [&](Value lhs, Value rhs) -> Value {
+      Type type = lhs.getType();
+      if (mlir::isa<mlir::stablehlo::AndOp>(innerOp)) {
+        return rewriter.create<ttir::BitwiseAndOp>(loc, type, lhs, rhs);
+      }
+      if (mlir::isa<mlir::stablehlo::OrOp>(innerOp)) {
+        return rewriter.create<ttir::BitwiseOrOp>(loc, type, lhs, rhs);
+      }
+      if (isLogical) {
+        return rewriter.create<ttir::LogicalXorOp>(loc, type, lhs, rhs);
+      }
+      return rewriter.create<ttir::BitwiseXorOp>(loc, type, lhs, rhs);
+    };
+    auto slice = [&](Value input, int64_t dim, int64_t begin,
+                     int64_t end) -> Value {
+      auto type = mlir::cast<RankedTensorType>(input.getType());
+      SmallVector<int32_t> begins(type.getRank(), 0);
+      SmallVector<int32_t> ends(type.getShape());
+      SmallVector<int32_t> steps(type.getRank(), 1);
+      begins[dim] = begin;
+      ends[dim] = end;
+      SmallVector<int64_t> sliceShape(type.getShape());
+      sliceShape[dim] = end - begin;
+      return rewriter.create<ttir::SliceStaticOp>(
+          loc, type.clone(sliceShape), input, rewriter.getI32ArrayAttr(begins),
+          rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+    };
+
+    for (int64_t dim : srcOp.getDimensions()) {
+      if (shape[dim] == 0) {
+        return rewriter.notifyMatchFailure(srcOp, "empty reduced dimension");
+      }
+      while (shape[dim] > 1) {
+        int64_t size = shape[dim];
+        int64_t half = size / 2;
+        Value halved = combine(slice(result, dim, 0, half),
+                               slice(result, dim, half, 2 * half));
+        if (size % 2 == 1) {
+          shape[dim] = half + 1;
+          halved = rewriter.create<ttir::ConcatOp>(
+              loc, inputType.clone(shape),
+              ValueRange{halved, slice(result, dim, size - 1, size)}, dim);
+        } else {
+          shape[dim] = half;
+        }
+        result = halved;
       }
     }
 
+    SmallVector<int32_t> ones(shape.size(), 1);
+    Value init = rewriter.create<ttir::ReshapeOp>(
+        loc, inputType.clone(SmallVector<int64_t>(shape.size(), 1)),
+        adaptor.getInitValues().front(), rewriter.getI32ArrayAttr(ones));
+    result = combine(result, init);
+    rewriter.replaceOpWithNewOp<ttir::ReshapeOp>(
+        srcOp, outputType, result,
+        rewriter.getI32ArrayAttr(
+            llvm::to_vector_of<int32_t>(outputType.getShape())));
     return success();
   }
 
