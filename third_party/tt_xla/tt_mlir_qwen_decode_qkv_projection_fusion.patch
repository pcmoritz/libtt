+  // Shared-LHS fusion iterates SSA users, which is not a semantic ordering.
+  // For Q/K/V projections this can produce V,K,Q, forcing later passes to
+  // reason about a lifted constant in a nonstandard order. Preserve the
+  // projection order encoded in locations when all three are present.
+  static void sortQKVProjectionCandidates(FusionCandidates &candidates) {
+    if (candidates.ops.size() != 3) {
+      return;
+    }
+
+    SmallVector<int, 3> order;
+    for (OpType op : candidates.ops) {
+      order.push_back(static_cast<int>(
+          ttmlir::utils::getQKVProjectionRole(op.getOperation())));
+    }
+    if (!llvm::is_contained(order, 0) || !llvm::is_contained(order, 1) ||
+        !llvm::is_contained(order, 2)) {
+      return;
+    }
+
+    SmallVector<OpType, 3> sorted(order.size());
+    for (size_t i = 0; i < order.size(); ++i) {
+      sorted[order[i]] = candidates.ops[i];
+    }
+    candidates.ops.assign(sorted.begin(), sorted.end());
+    candidates.firstTransposeB = candidates.ops.front().getTransposeB();
+  }
+
   // Collect all ops that share the same LHS operand and are compatible
