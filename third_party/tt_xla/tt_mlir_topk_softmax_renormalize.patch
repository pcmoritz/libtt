+// Softmax as PyTorch writes it: exp(x) times the reciprocal of its sum.
+//
+//   %e = exp(%x)
+//   %r = div(1, sum(%e, keep_dim=true))
+//   %s = multiply(%e, broadcast(%r))
+//
+// ReductionWithReshapePattern folds PyTorch's sum and reshape into the keep-dim
+// sum. Returns x and the softmax dim.
+static std::optional<std::pair<mlir::Value, int64_t>>
+matchReciprocalSoftmax(MultiplyOp multiplyOp) {
+  for (auto [exp, reciprocal] :
+       {std::pair(multiplyOp.getLhs(), multiplyOp.getRhs()),
+        std::pair(multiplyOp.getRhs(), multiplyOp.getLhs())}) {
+    auto expOp = exp.getDefiningOp<ExpOp>();
+    auto divOp = ttmlir::utils::findOpThrough<DivOp, BroadcastOp>(reciprocal);
+    if (!expOp || !divOp || expOp.getType() != multiplyOp.getType()) {
+      continue;
+    }
+    // The 1 is a splat constant or, from JAX, a ones op.
+    std::optional<double> one = getSplatConstantValue(divOp.getLhs());
+    const bool isOne =
+        (one && *one == 1.0) ||
+        utils::lookThroughLayoutOps(divOp.getLhs()).getDefiningOp<OnesOp>();
+    auto sumOp = divOp.getRhs().getDefiningOp<SumOp>();
+    if (!isOne || !sumOp || !sumOp.getKeepDim() ||
+        sumOp.getInput() != expOp.getResult() || !sumOp.getDimArg() ||
+        sumOp.getDimArg()->size() != 1) {
+      continue;
+    }
+    // exp feeds only the sum and the product, the sum only the reciprocal,
+    // and the reciprocal (and its broadcast) only the product.
+    if (ttmlir::utils::countUsers(expOp.getResult()) != 2 ||
+        !sumOp.getResult().hasOneUse() || !divOp.getResult().hasOneUse() ||
+        !reciprocal.hasOneUse()) {
+      continue;
+    }
+    return std::pair(
+        expOp.getInput(),
+        mlir::cast<mlir::IntegerAttr>((*sumOp.getDimArg())[0]).getInt());
+  }
+  return std::nullopt;
+}
+
+// PyTorch's softmax becomes a softmax op in BF16 only, and
+// NumericStableSoftmaxFusionPattern then takes in the subtracted max. TTNN's
+// softmax rejects FP16, and in FP32 it is about 1e-3 off where the
+// decomposition is within 1e-6; TopKSoftmaxRenormalizePattern takes an FP32
+// router's softmax as written.
+class SoftmaxReciprocalFusionPattern
+    : public mlir::OpRewritePattern<MultiplyOp> {
+  using mlir::OpRewritePattern<MultiplyOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(MultiplyOp multiplyOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    auto type = mlir::cast<mlir::RankedTensorType>(multiplyOp.getType());
+    if (!type.getElementType().isBF16()) {
+      return mlir::failure();
+    }
+    auto softmax = matchReciprocalSoftmax(multiplyOp);
+    if (!softmax || isWideSoftmax(type, softmax->second)) {
+      return mlir::failure();
+    }
+    rewriter.replaceOpWithNewOp<SoftmaxOp>(multiplyOp, type, softmax->first,
+                                           softmax->second,
+                                           /*numericStable=*/false);
+    return mlir::success();
+  }
+};
+
+// A mixture-of-experts router takes the top k of softmax(x) and renormalizes
+// them over the k picks: p_i / sum_k p_j, which is exp(x_i) / sum_k exp(x_j),
+// the softmax of the top k of x. Rewrite it that way:
+//
+//   %p = softmax(%x)                   %v, %i = topk(%x)
+//   %v, %i = topk(%p)          ->      %w = softmax(%v)
+//   %w = div(%v, sum(%v))
+//
+// which skips the softmax over all of x and the renormalization's reduction and
+// division. softmax is monotonic, so topk picks the same indices from x as from
+// softmax(x), except where rounding makes two softmax values of different x
+// equal: topk(softmax(x)) breaks that tie by index, topk(x) by x.
+//
+// The sum may have an epsilon added, as SGLang-TorchTPU's router does (1e-20),
+// if it is too small to change it: the top k of N probabilities sum to at
+// least k / N, and adding less than (k / N) * 2^-25 leaves that sum unchanged
+// in FP32.
+class TopKSoftmaxRenormalizePattern : public mlir::OpRewritePattern<DivOp> {
+  using mlir::OpRewritePattern<DivOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(DivOp divOp, mlir::PatternRewriter &rewriter) const final {
+    mlir::Value values = divOp.getLhs();
+    auto topkOp = values.getDefiningOp<TopKOp>();
+    if (!topkOp || topkOp.getValues() != values || !topkOp.getLargest()) {
+      return mlir::failure();
+    }
+    // The probabilities are a softmax op or, in an FP32 router, PyTorch's
+    // softmax as written.
+    mlir::Value probabilities = topkOp.getInputTensor();
+    if (!probabilities.hasOneUse()) {
+      return mlir::failure();
+    }
+    mlir::Value logits;
+    int64_t softmaxDim;
+    if (auto softmaxOp = probabilities.getDefiningOp<SoftmaxOp>()) {
+      logits = softmaxOp.getInput();
+      softmaxDim = softmaxOp.getDimension();
+    } else if (auto multiplyOp = probabilities.getDefiningOp<MultiplyOp>()) {
+      auto softmax = matchReciprocalSoftmax(multiplyOp);
+      if (!softmax) {
+        return mlir::failure();
+      }
+      std::tie(logits, softmaxDim) = *softmax;
+    } else {
+      return mlir::failure();
+    }
+    auto inputType = mlir::cast<mlir::RankedTensorType>(logits.getType());
+    // TTNN's softmax takes FP32 and BF16.
+    if (!inputType.getElementType().isF32() &&
+        !inputType.getElementType().isBF16()) {
+      return mlir::failure();
+    }
+    const int64_t rank = inputType.getRank();
+    auto normalize = [rank](int64_t dim) { return dim < 0 ? dim + rank : dim; };
+    const int64_t dim = rank - 1;
+    if (normalize(softmaxDim) != dim || normalize(topkOp.getDim()) != dim) {
+      return mlir::failure();
+    }
+    // softmax(x - c) is softmax(x) for c constant along the dim, such as the
+    // max PyTorch subtracts, so the top k may come from x.
+    if (auto subtractOp = logits.getDefiningOp<SubtractOp>()) {
+      auto subtracted = mlir::cast<mlir::RankedTensorType>(
+          ttmlir::utils::lookThrough<BroadcastOp>(subtractOp.getRhs())
+              .getType());
+      if (subtractOp.getLhs().getType() == inputType &&
+          subtracted.getRank() == rank && subtracted.getDimSize(dim) == 1) {
+        logits = subtractOp.getLhs();
+      }
+    }
+
+    // Each row must be divided by its own sum: a keep-dim sum of the values
+    // over the last dim, possibly broadcast back to their shape.
+    // ReductionWithReshapePattern folds JAX's sum and reshape into one.
+    if (divOp.getType() != values.getType()) {
+      return mlir::failure();
+    }
+    mlir::Value denominator =
+        ttmlir::utils::lookThrough<BroadcastOp>(divOp.getRhs());
+    if (auto addOp = denominator.getDefiningOp<AddOp>()) {
+      const double maxEpsilon = static_cast<double>(topkOp.getK()) /
+                                inputType.getDimSize(dim) * std::ldexp(1.0, -25);
+      auto negligible = [maxEpsilon](mlir::Value value) {
+        std::optional<double> epsilon = getSplatConstantValue(value);
+        return epsilon && std::abs(*epsilon) <= maxEpsilon;
+      };
+      if (!addOp.getResult().hasOneUse() || inputType.isDynamicDim(dim)) {
+        return mlir::failure();
+      }
+      if (negligible(addOp.getRhs())) {
+        denominator = addOp.getLhs();
+      } else if (negligible(addOp.getLhs())) {
+        denominator = addOp.getRhs();
+      } else {
+        return mlir::failure();
+      }
+    }
+    auto sumOp = denominator.getDefiningOp<SumOp>();
+    if (!sumOp || !sumOp.getKeepDim() || sumOp.getInput() != values ||
+        !sumOp.getDimArg() || sumOp.getDimArg()->size() != 1 ||
+        normalize(mlir::cast<mlir::IntegerAttr>((*sumOp.getDimArg())[0])
+                      .getInt()) != dim) {
+      return mlir::failure();
+    }
+    // Nothing else may read the renormalized-away values.
+    if (ttmlir::utils::countUsers(values) != 2) {
+      return mlir::failure();
+    }
+
+    // The new top-k replaces the old one's indices, which may be read before
+    // the division, so both new ops go where the old top-k is.
+    rewriter.setInsertionPoint(topkOp);
+    auto newTopK = rewriter.create<TopKOp>(
+        topkOp.getLoc(), topkOp.getValues().getType(),
+        topkOp.getIndices().getType(), logits, topkOp.getKAttr(),
+        rewriter.getI32IntegerAttr(dim), topkOp.getLargestAttr(),
+        topkOp.getSortedAttr());
+    auto newSoftmax = rewriter.create<SoftmaxOp>(
+        divOp.getLoc(), divOp.getType(), newTopK.getValues(), dim,
+        /*numericStable=*/true);
+    rewriter.replaceAllUsesWith(topkOp.getIndices(), newTopK.getIndices());
+    rewriter.replaceOp(divOp, newSoftmax.getResult());
+    return mlir::success();
+  }
+};
