+    }
+
+    if (indicesShape != outputShape) {
+      auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+      indices = rewriter.create<ttir::BroadcastOp>(
+          srcOp.getLoc(),
+          RankedTensorType::get(outputShape, indicesType.getElementType(),
+                                indicesType.getEncoding()),
+          indices,
+          rewriter.getDenseI64ArrayAttr(
+              ttmlir::utils::getBroadcastDimensions<int64_t>(indicesShape,
+                                                               outputShape)));
+    }
+
+    auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+    indices = rewriter.create<ttir::ClampScalarOp>(
+        srcOp.getLoc(), indicesType, indices, rewriter.getI32IntegerAttr(0),
+        rewriter.getI32IntegerAttr(operandShape[indexedDim] -
+                                   sliceSizes[indexedDim]));
