+// Converts a rank-preserving batched gather window into ttir.gather by
+// expanding each start index across the window.
+class StableHLOGatherWindowToGatherDimPattern
+    : public OpConversionPattern<mlir::stablehlo::GatherOp> {
+  using OpConversionPattern<mlir::stablehlo::GatherOp>::OpConversionPattern;
+
