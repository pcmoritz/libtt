+// Converts a rank-preserving batched gather window into ttir.gather by
+// expanding each start index across the window.
+class StableHLOGatherWindowToGatherDimPattern
+    : public OpConversionPattern<mlir::stablehlo::GatherOp> {
+  using OpConversionPattern<mlir::stablehlo::GatherOp>::OpConversionPattern;
+
+public:
+  StableHLOGatherWindowToGatherDimPattern(TypeConverter &typeConverter,
+                                          MLIRContext *context)
+      : OpConversionPattern<mlir::stablehlo::GatherOp>(typeConverter, context,
+                                                       /*benefit=*/3) {}
+
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::GatherOp srcOp,
+                  mlir::stablehlo::GatherOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto dimensionNumbers = srcOp.getDimensionNumbers();
+    auto operandBatchingDims = dimensionNumbers.getOperandBatchingDims();
+    auto startIndicesBatchingDims =
+        dimensionNumbers.getStartIndicesBatchingDims();
+    auto startIndexMap = dimensionNumbers.getStartIndexMap();
+    auto offsetDims = dimensionNumbers.getOffsetDims();
+    int64_t indexVectorDim = dimensionNumbers.getIndexVectorDim();
+
+    auto operandShape =
+        mlir::cast<RankedTensorType>(srcOp.getOperand().getType()).getShape();
+    auto startIndicesShape =
+        mlir::cast<RankedTensorType>(srcOp.getStartIndices().getType())
+            .getShape();
+    auto sliceSizes = srcOp.getSliceSizes();
+
+    if (operandBatchingDims.empty()) {
+      return rewriter.notifyMatchFailure(srcOp, "No batching dims present");
+    }
+    if (startIndexMap.size() != 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "start_index_map must have exactly one element");
+    }
+    if (operandBatchingDims.size() + 1 != operandShape.size()) {
+      return rewriter.notifyMatchFailure(srcOp,
+                                         "Unsupported batched gather window");
+    }
+
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult().getType()));
+    auto outputShape = outputType.getShape();
+    if (outputShape.size() != operandShape.size()) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Windowed gather cannot change the operand rank");
+    }
+    if (offsetDims.size() != 1) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "Windowed gather must have one offset dimension");
+    }
+
+    int64_t indexedDim = startIndexMap[0];
+    if (sliceSizes[indexedDim] == 1) {
+      return rewriter.notifyMatchFailure(srcOp, "Not a windowed gather");
+    }
+
+    int64_t gatherDim = offsetDims.front();
+    SmallVector<int64_t> indicesShape;
+    for (int64_t i = 0; i < static_cast<int64_t>(startIndicesShape.size());
+         ++i) {
+      if (i != indexVectorDim) {
+        indicesShape.push_back(startIndicesShape[i]);
+      }
+    }
+    indicesShape.insert(indicesShape.begin() + gatherDim, 1);
+
+    Value operand = adaptor.getOperands()[0];
+    SmallVector<int64_t> permutation(outputType.getRank(), indexedDim);
+    for (auto [operandDim, startDim] :
+         llvm::zip_equal(operandBatchingDims, startIndicesBatchingDims)) {
+      int64_t indicesDim = startDim - (startDim > indexVectorDim);
+      int64_t outputDim = indicesDim + (indicesDim >= gatherDim);
+      permutation[outputDim] = operandDim;
+    }
+    if (!llvm::equal(permutation,
+                     llvm::seq<int64_t>(0, permutation.size()))) {
+      auto operandType = mlir::cast<RankedTensorType>(operand.getType());
+      auto permutedShape = ttmlir::utils::applyPermutation(
+          operandType.getShape(), permutation);
+      operand = rewriter.create<ttir::PermuteOp>(
+          srcOp.getLoc(), operandType.clone(permutedShape),
+          operand, permutation);
+    }
+
+    Value indices = adaptor.getOperands()[1];
+    if (indicesShape != startIndicesShape) {
+      indices = ttir::utils::createReshapeOp(rewriter, srcOp.getLoc(), indices,
+                                             indicesShape);
+    }
+
+    auto indicesType =
+        mlir::cast<RankedTensorType>(indices.getType()).clone(outputShape);
+    indices = rewriter.create<ttir::BroadcastOp>(
+        srcOp.getLoc(), indicesType, indices,
+        rewriter.getDenseI64ArrayAttr(
+            ttmlir::utils::getBroadcastDimensions<int64_t>(indicesShape,
+                                                             outputShape)));
+
+    indices = rewriter.create<ttir::ClampScalarOp>(
+        srcOp.getLoc(), indicesType, indices, rewriter.getI32IntegerAttr(0),
+        rewriter.getI32IntegerAttr(operandShape[indexedDim] -
+                                   sliceSizes[indexedDim]));
+    Value offsets = rewriter.create<ttir::ArangeOp>(
+        srcOp.getLoc(), indicesType, /*start=*/0,
+        /*end=*/sliceSizes[indexedDim], /*step=*/1,
+        /*arange_dimension=*/gatherDim);
+    indices = rewriter.create<ttir::AddOp>(srcOp.getLoc(), indicesType,
+                                           indices, offsets);
+
+    rewriter.replaceOpWithNewOp<ttir::GatherOp>(
+        srcOp, outputType, operand, indices,
+        rewriter.getI32IntegerAttr(static_cast<int32_t>(gatherDim)));
+    return success();
+  }
+};
