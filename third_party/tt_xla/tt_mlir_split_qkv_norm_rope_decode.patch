+def TTNN_SplitQKVNormRopeDecodeOp : TTNN_Op<"split_qkv_norm_rope_decode", [OpModelExempt]> {
+  let summary = "A decode step's attention prologue as PyTorch models trace it, in one program";
+  let description = [{
+    Splits a fused QKV projection input [B, (num_q_heads + 2 * num_kv_heads) *
+    head_dim] into heads, applies rms_norm with q_weight to the q heads and
+    with k_weight to the k heads, and rotary_embedding with token b's row of
+    cos_cache and sin_cache [1, 1 or B, 1, head_dim] to both, rounding as
+    those ops do with HiFi4 and FP32 accumulation. query is [1, B,
+    num_q_heads, q_width]: the rotated q heads, zero padded to q_width.
+    key_values holds every token's rotated k heads and v heads side by side:
+    one tensor [1, B, num_kv_heads, 2 * head_dim], or one per token, [1, 1,
+    num_kv_heads, 2 * head_dim].
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$q_weight,
+                       AnyRankedTensor:$k_weight,
+                       AnyRankedTensor:$cos_cache,
+                       AnyRankedTensor:$sin_cache,
+                       UI32Attr:$num_q_heads,
+                       UI32Attr:$num_kv_heads,
+                       F32Attr:$epsilon);
+
+  let results = (outs AnyRankedTensor:$query,
+                      Variadic<AnyRankedTensor>:$key_values);
+
+  let hasCanonicalizer = 1;
+}
