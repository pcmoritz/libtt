+def TTNN_SplitQKVNormRopeDecodeOp : TTNN_Op<"split_qkv_norm_rope_decode", [OpModelExempt]> {
+  let summary = "A decode step's attention prologue as PyTorch models trace it, in one program";
+  let description = [{
+    Splits a fused QKV projection input [B, W] into heads: num_q_heads q
+    heads, each followed by its gate head in gated attention (as W tells),
+    then num_kv_heads k heads and num_kv_heads v heads, all head_dim wide, the
+    length of q_weight. Applies rms_norm with q_weight to the q heads and with
+    k_weight to the k heads, and rotary_embedding with token b's row of
+    cos_cache and sin_cache [1, 1 or B, 1, R] to the first R dims of both,
+    rounding as those ops do with HiFi4 and FP32 accumulation. query is [1, B,
+    num_q_heads, q_width]: the q heads, zero padded to q_width. key_values
+    holds every token's k heads and v heads side by side, [1, B,
+    num_kv_heads, 2 * head_dim].
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$q_weight,
+                       AnyRankedTensor:$k_weight,
+                       AnyRankedTensor:$cos_cache,
+                       AnyRankedTensor:$sin_cache,
+                       UI32Attr:$num_q_heads,
+                       UI32Attr:$num_kv_heads,
+                       F32Attr:$epsilon);
+
+  let results = (outs AnyRankedTensor:$query,
+                      AnyRankedTensor:$key_values);
+
+  let hasCanonicalizer = 1;
+}
+
+def TTNN_AttentionOutputGateOp : TTNN_Op<"attention_output_gate", [OpModelExempt]> {
+  let summary = "Gated attention's output gate as PyTorch models trace it, in one program";
+  let description = [{
+    Each head of the attention output [1, T, H, W], head_dim wide from
+    value_offset, times the sigmoid of its gate head: gate [T, N]'s head_dim
+    columns from h * gate_stride + gate_offset. The sigmoid is computed in
+    FP32 from the BF16 gate and rounded to BF16, and the product rounded to
+    BF16, as the separate typecast, sigmoid, typecast and multiply round.
+    The result is [T, H * head_dim].
+  }];
+
+  let arguments = (ins AnyRankedTensor:$attention,
+                       AnyRankedTensor:$gate,
+                       UI32Attr:$head_dim,
+                       UI32Attr:$value_offset,
+                       UI32Attr:$gate_offset,
+                       UI32Attr:$gate_stride);
+
+  let results = (outs AnyRankedTensor:$result);
+}
