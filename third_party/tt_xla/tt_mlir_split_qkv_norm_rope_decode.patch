+def TTIR_SplitQKVNormRopeDecodeOp : TTIR_NamedOp<"split_qkv_norm_rope_decode"> {
+  let summary = "A decode step's attention prologue as PyTorch models trace it";
+  let description = [{
+    Splits a fused QKV projection input [B, W] into q, k and v heads, applies
+    rms_norm with q_weight and k_weight to the q and k heads and
+    rotary_embedding with token b's row of cos_cache and sin_cache to both,
+    and returns query [1, B, num_q_heads, q_width] and key_values [1, B,
+    num_kv_heads, 2 * head_dim]: see ttnn.split_qkv_norm_rope_decode, which
+    it lowers to. libtt's SplitQKVNormRopeDecodeFusing forms it.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$q_weight,
+                       AnyRankedTensor:$k_weight,
+                       AnyRankedTensor:$cos_cache,
+                       AnyRankedTensor:$sin_cache,
+                       UI32Attr:$num_q_heads,
+                       UI32Attr:$num_kv_heads,
+                       F32Attr:$epsilon);
+
+  let results = (outs AnyRankedTensor:$query,
+                      AnyRankedTensor:$key_values);
+}
