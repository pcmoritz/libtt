+::flatbuffers::Offset<::tt::target::ttnn::SplitQKVNormRopeDecodeOp>
+createOp(FlatbufferObjectCache &cache, SplitQKVNormRopeDecodeOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  auto output = [&](Value value) {
+    return cache.getOrCreateNoSharding(value, tensorValueToFlatbuffer,
+                                       /*local_shape*/ std::nullopt);
+  };
+  return ::tt::target::ttnn::CreateSplitQKVNormRopeDecodeOp(
+      *cache.fbb, tensor(op.getInput()), tensor(op.getQWeight()),
+      tensor(op.getKWeight()), tensor(op.getCosCache()),
+      tensor(op.getSinCache()), output(op.getQuery()),
+      output(op.getKeyValues()), op.getNumQHeads(), op.getNumKvHeads(),
+      op.getEpsilon().convertToFloat());
+}
+
+::flatbuffers::Offset<::tt::target::ttnn::AttentionOutputGateOp>
+createOp(FlatbufferObjectCache &cache, AttentionOutputGateOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  auto output = cache.getOrCreateNoSharding(op.getResult(),
+                                            tensorValueToFlatbuffer,
+                                            /*local_shape*/ std::nullopt);
+  return ::tt::target::ttnn::CreateAttentionOutputGateOp(
+      *cache.fbb, tensor(op.getAttention()), tensor(op.getGate()), output,
+      op.getHeadDim(), op.getValueOffset(), op.getGateOffset(),
+      op.getGateStride());
+}
