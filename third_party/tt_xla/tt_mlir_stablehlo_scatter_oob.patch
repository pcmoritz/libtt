     size_t windowIdxPos = 0;
@@ -8090,2 +8108,6 @@ private:
 
+      if (isScatterDim) {
+        dimIndex = clampScatterIndex(loc, rewriter, dimIndex,
+                                     operandShape[operandDim], validIndices);
+      }
       indexSlices.push_back(dimIndex);
@@ -8095,2 +8117,10 @@ private:
         loc, rewriter, indexSlices, operandShape, indicesType.getElementType());
+    auto flatIndicesType =
+        mlir::cast<RankedTensorType>(flatIndices.getType());
+    Value outOfBounds = rewriter.create<ttir::FullOp>(
+        loc, flatIndicesType,
+        rewriter.getI32IntegerAttr(
+            static_cast<int32_t>(ttmlir::utils::volume(operandShape))));
+    flatIndices = rewriter.create<ttir::WhereOp>(
+        loc, flatIndicesType, validIndices, flatIndices, outOfBounds);
 
