+  Value clampScatterIndex(Location loc, PatternRewriter &rewriter, Value index,
+                          int64_t dimSize, Value &validIndices) const {
+    auto indexType = mlir::cast<RankedTensorType>(index.getType());
+    Value clamped = rewriter.create<ttir::ClampScalarOp>(
+        loc, indexType, index, rewriter.getI32IntegerAttr(0),
+        rewriter.getI32IntegerAttr(dimSize - 1));
+    auto validType = indexType.clone(rewriter.getI1Type());
+    Value isValid = rewriter.create<ttir::EqualOp>(
+        loc, validType, index, clamped);
+    if (validIndices) {
+      isValid = rewriter.create<ttir::LogicalAndOp>(
+          loc, validType, validIndices, isValid);
+    }
+    validIndices = isValid;
+    return clamped;
+  }
+
   /// Computes flattened 1D indices for multi-dimensional scatter.
@@ -8044,2 +8061,3 @@ private:
     llvm::SmallVector<Value> indexSlices;
