+namespace {
+class StableHLOToTTIRSignOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::SignOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::SignOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::SignOp srcOp,
+                  mlir::stablehlo::SignOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    auto integerType =
+        mlir::dyn_cast<IntegerType>(resultType.getElementType());
+    if (!integerType) {
+      rewriter.replaceOpWithNewOp<ttir::SignOp>(
+          srcOp, resultType, adaptor.getOperand());
+      return success();
+    }
+
+    int32_t min = integerType.isUnsigned() ? 0 : -1;
+    rewriter.replaceOpWithNewOp<ttir::ClampScalarOp>(
+        srcOp, resultType, adaptor.getOperand(),
+        rewriter.getI32IntegerAttr(min), rewriter.getI32IntegerAttr(1));
+    return success();
+  }
+};
+} // namespace
