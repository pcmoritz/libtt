 // Collects inputs JAX marked for input/output aliasing. Only input indices are
 // needed here to invalidate consumed buffers after successful execution.
+// The permutation of a partitioned program whose only work is transposing its
+// argument: one argument, one result, and one stablehlo.transpose of the
+// argument (in a manual computation or not) that is returned. Without other
+// ops there are no collectives, so each device transposes its own shard.
+static std::optional<std::vector<int64_t>>
+collectArgumentTranspose(mlir::ModuleOp module) {
+  std::optional<std::vector<int64_t>> permutation;
+  bool other = false;
+  size_t num_funcs = 0;
+  module.walk([&](mlir::Operation *op) {
+    if (mlir::isa<mlir::ModuleOp, mlir::sdy::MeshOp, mlir::func::ReturnOp,
+                  mlir::sdy::ManualComputationOp, mlir::sdy::ReturnOp>(op)) {
+      return;
+    }
+    if (auto func = mlir::dyn_cast<mlir::func::FuncOp>(op)) {
+      other |= ++num_funcs > 1 || func.getNumArguments() != 1 ||
+               func.getNumResults() != 1;
+      return;
+    }
+    auto transpose = mlir::dyn_cast<mlir::stablehlo::TransposeOp>(op);
+    if (!transpose || permutation ||
+        !mlir::isa<mlir::BlockArgument>(transpose.getOperand()) ||
+        !transpose->hasOneUse() ||
+        !mlir::isa<mlir::func::ReturnOp, mlir::sdy::ReturnOp>(
+            *transpose->user_begin())) {
+      other = true;
+      return;
+    }
+    llvm::ArrayRef<int64_t> dims = transpose.getPermutation();
+    permutation.emplace(dims.begin(), dims.end());
+  });
+  return other ? std::nullopt : permutation;
+}
