 // TODO(mrakita): Make this method work in asynchronous fashion.
+// Signals the caller's per-device completion events: execution is synchronous.
+static void signalDeviceCompletion(PJRT_LoadedExecutable_Execute_Args *args) {
+  if (!args->device_complete_events) {
+    return;
+  }
+  for (int device_num = 0; device_num < args->num_devices; ++device_num) {
+    std::unique_ptr<EventInstance> device_complete_event =
+        EventInstance::createInstance();
+    EventInstance::markAsReadyAndCallback(device_complete_event.get(),
+                                          tt_pjrt_status::kSuccess);
+
+    // Releasing the ownership to the PJRT API caller since the caller is
+    // responsible for calling `PJRT_Event_Destroy` on the event.
+    args->device_complete_events[device_num] = *device_complete_event.release();
+  }
+}
+
+bool FlatbufferLoadedExecutableInstance::transposeOnHost(
+    PJRT_LoadedExecutable_Execute_Args *args) {
+  const std::optional<std::vector<int64_t>> &permutation =
+      m_executable_image->getArgumentTranspose();
+  if (!permutation) {
+    return false;
+  }
+  std::vector<tt::runtime::Tensor> transposed;
+  for (size_t device = 0; device < args->num_devices; ++device) {
+    const PjrtTensorRef &tensor =
+        BufferInstance::unwrap(args->argument_lists[device][0])
+            ->getPjrtTensor();
+    if (!tensor || !tensor->has_runtime_tensor() ||
+        tensor->shards().size() != 1) {
+      return false;
+    }
+    std::optional<tt::runtime::Tensor> result =
+        tt::runtime::permuteHostTensor(tensor->runtime_tensor(), *permutation);
+    if (!result) {
+      return false;
+    }
+    transposed.push_back(std::move(*result));
+  }
+
+  std::optional<std::vector<std::uint32_t>> shape = getOutputShape(0);
+  if (!shape) {
+    return false;
+  }
+  for (size_t device = 0; device < args->num_devices; ++device) {
+    std::unique_ptr<BufferInstance> output =
+        BufferInstance::createOutputBufferInstance(
+            std::vector<std::uint32_t>(*shape), m_addressable_devices[device],
+            m_addressable_devices[device]->getDefaultMemory(),
+            m_executable_image->getOutputTypes()[0], device);
+    output->markAsDataReady();
+    PjrtTensor::from_runtime_tensor({output.get()},
+                                    std::move(transposed[device]));
+    args->output_lists[device][0] = *output.release();
+  }
+  return true;
+}
