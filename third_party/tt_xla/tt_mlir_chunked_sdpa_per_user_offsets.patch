--- a/include/ttmlir/Dialect/TTIR/IR/TTIROps.td
+++ b/include/ttmlir/Dialect/TTIR/IR/TTIROps.td
@@ -6343,15 +6343,16 @@ def TTIR_ChunkedScaledDotProductAttentionOp : TTIR_NamedOp<"chunked_scaled_dot_p
     Chunked-prefill attention. A prefill chunk of `query` attends
     causally over the prefix tokens `[0, chunk_start_idx + chunk_len)` that are
     resident in the paged K/V cache, read on device via `page_table`. The prefix
-    offset is supplied by the device tensor `chunk_start_idx` (`[1]` int32). Causal
-    masking is handled internally; no host attention mask.
+    offset is supplied by the device tensor `chunk_start_idx`: `[1]` for an
+    offset shared by all users, or `[B]` for per-user offsets. Causal masking is
+    handled internally; no host attention mask.
 
     Args:
         query (AnyRankedTensor): `[B x Hq x chunk_len x D]`.
         key (AnyRankedTensor): paged K cache `[num_blocks x Hkv x block_size x D]`.
         value (AnyRankedTensor): paged V cache, same layout as `key`.
         page_table (AnyRankedTensor): `[B x num_blocks_per_user]` int32.
-        chunk_start_idx (AnyRankedTensor): `[1]` int32 prefix offset.
+        chunk_start_idx (AnyRankedTensor): `[1]` or `[B]` int32 prefix offsets.
         scale (float, optional): Softmax scale. Defaults to `1 / sqrt(D)`.
 
     Returns:
diff --git a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
index b5a4fb5..30a68ae 100644
--- a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
+++ b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
@@ -3402,12 +3402,75 @@ public:
   matchAndRewrite(ttir::ChunkedScaledDotProductAttentionOp op,
                   OpAdaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
-    rewriter.replaceOpWithNewOp<ttnn::ChunkedScaledDotProductAttentionOp>(
-        op, this->getTypeConverter()->convertType(op.getType()),
-        adaptor.getQuery(), adaptor.getKey(), adaptor.getValue(),
-        adaptor.getPageTable(), adaptor.getChunkStartIdx(),
-        adaptor.getScaleAttr(),
-        /*program_config=*/nullptr);
+    auto chunkStartIdxType =
+        cast<RankedTensorType>(adaptor.getChunkStartIdx().getType());
+    if (chunkStartIdxType.getDimSize(0) == 1) {
+      rewriter.replaceOpWithNewOp<ttnn::ChunkedScaledDotProductAttentionOp>(
+          op, this->getTypeConverter()->convertType(op.getType()),
+          adaptor.getQuery(), adaptor.getKey(), adaptor.getValue(),
+          adaptor.getPageTable(), adaptor.getChunkStartIdx(),
+          adaptor.getScaleAttr(),
+          /*program_config=*/nullptr);
+      return success();
+    }
+
+    // TTNN accepts one prefix offset and one page-table row per invocation.
+    // Keep the TTIR operation batched and statically expand its users here so
+    // frontends do not need to model the backend execution strategy.
+    Location loc = op.getLoc();
+    auto outputType = cast<RankedTensorType>(
+        this->getTypeConverter()->convertType(op.getType()));
+    auto queryType = cast<RankedTensorType>(adaptor.getQuery().getType());
+    auto pageTableType =
+        cast<RankedTensorType>(adaptor.getPageTable().getType());
+
+    auto sliceUser = [&](Value input, RankedTensorType inputType,
+                         int64_t user) -> Value {
+      SmallVector<int32_t> begins(inputType.getRank(), 0);
+      SmallVector<int32_t> ends(inputType.getShape().begin(),
+                                inputType.getShape().end());
+      SmallVector<int32_t> steps(inputType.getRank(), 1);
+      begins[0] = static_cast<int32_t>(user);
+      ends[0] = static_cast<int32_t>(user + 1);
+
+      SmallVector<int64_t> sliceShape(inputType.getShape());
+      sliceShape[0] = 1;
+      auto sliceType =
+          ttnn::utils::RankedTensorTypeFactory::create(inputType, sliceShape);
+      return rewriter
+          .create<ttnn::SliceStaticOp>(
+              loc, sliceType, input, rewriter.getI32ArrayAttr(begins),
+              rewriter.getI32ArrayAttr(ends),
+              rewriter.getI32ArrayAttr(steps))
+          .getResult();
+    };
+
+    int64_t numUsers = queryType.getDimSize(0);
+    SmallVector<Value> userOutputs;
+    userOutputs.reserve(numUsers);
+    for (int64_t user = 0; user < numUsers; ++user) {
+      Value query = sliceUser(adaptor.getQuery(), queryType, user);
+      Value pageTable =
+          sliceUser(adaptor.getPageTable(), pageTableType, user);
+      Value chunkStartIdx =
+          sliceUser(adaptor.getChunkStartIdx(), chunkStartIdxType, user);
+
+      SmallVector<int64_t> userOutputShape(outputType.getShape());
+      userOutputShape[0] = 1;
+      auto userOutputType = ttnn::utils::RankedTensorTypeFactory::create(
+          outputType, userOutputShape);
+      userOutputs.push_back(
+          rewriter
+              .create<ttnn::ChunkedScaledDotProductAttentionOp>(
+                  loc, userOutputType, query, adaptor.getKey(),
+                  adaptor.getValue(), pageTable, chunkStartIdx,
+                  adaptor.getScaleAttr(),
+                  /*program_config=*/nullptr)
+              .getResult());
+    }
+
+    rewriter.replaceOpWithNewOp<ttnn::ConcatOp>(op, outputType, userOutputs,
+                                                 /*dim=*/0);
     return success();
   }
 };
