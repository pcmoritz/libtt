   if (auto foldResult = foldUnitConcatOp(*this)) {
@@ -2670,6 +2682,9 @@
   if (auto foldResult = foldEmptyTensorsConcatOp(*this)) {
     return foldResult;
   }
+  if (auto foldResult = foldEmptyResultConcatOp(*this)) {
+    return foldResult;
+  }
 
   return nullptr;
