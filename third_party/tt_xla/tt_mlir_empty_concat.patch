+// A concatenation of inputs that are empty in another dimension, such as
+// [5, 0] tensors along dimension 0, is an empty constant. TTNN's row-major
+// concatenation divides by the size of the last dimension.
+mlir::OpFoldResult foldEmptyResultConcatOp(ttir::ConcatOp op) {
+  auto outputType = mlir::cast<RankedTensorType>(op.getResult().getType());
+  if (outputType.getNumElements() != 0 ||
+      !outputType.getElementType().isIntOrIndexOrFloat()) {
+    return nullptr;
+  }
+  return mlir::DenseElementsAttr::getFromRawBuffer(outputType, {});
+}
+
 // ConcatOp Folder
