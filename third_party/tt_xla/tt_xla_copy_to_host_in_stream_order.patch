+tt::runtime::Tensor
+PjrtTensor::start_move_to_host(const BufferInstance *shard) {
+  const std::lock_guard<std::mutex> lock(m_state_mutex);
+  // Moving gives each shard but the first a tensor of its own.
+  const auto it = std::find(m_shards.begin(), m_shards.end(), shard);
+  TT_FATAL(it != m_shards.end(), "The buffer is not a shard of this tensor");
+  const size_t index = it - m_shards.begin();
+  std::vector<tt::runtime::Tensor> tensors =
+      move_to_host_locked(/*blocking=*/false);
+  TT_FATAL(!tensors.empty(), "Shell-only PjrtTensor has no data to read");
+  return tensors.size() == 1 ? tensors[0] : tensors[index];
+}
+
+void PjrtTensor::wait_for_read() const {
+  const std::lock_guard<std::mutex> lock(m_state_mutex);
+  wait_for_read_locked();
+}
+
+void PjrtTensor::wait_for_read_locked() const {
+  if (m_read_pending) {
+    tt::runtime::wait(*m_runtime_tensor);
+    m_read_pending = false;
+  }
 }
 
