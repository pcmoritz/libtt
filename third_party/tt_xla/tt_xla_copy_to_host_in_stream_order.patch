+tt::runtime::Tensor
+PjrtTensor::start_copy_to_host(BufferInstance *shard) {
+  const std::lock_guard<std::mutex> lock(m_state_mutex);
+  TT_FATAL(m_runtime_tensor.has_value(),
+           "Shell-only PjrtTensor has no data to read");
+  const auto it = std::find(m_shards.begin(), m_shards.end(), shard);
+  TT_FATAL(it != m_shards.end(), "The buffer is not a shard of this tensor");
+  const size_t index = it - m_shards.begin();
+
+  // A buffer still on the framework's host buffer copies it now: the host
+  // tensor can be that memory, which the framework may free once a program
+  // has taken the tensor (under this lock) or the buffer is deleted.
+  if (shard->holdsHostBuffer()) {
+    const std::vector<tt::runtime::Tensor> tensors =
+        tt::runtime::toHost(*m_runtime_tensor, /*untilize=*/true);
+    const tt::runtime::Tensor &host =
+        tensors.size() == 1 ? tensors[0] : tensors[index];
+    tt::runtime::Tensor owned = tt::runtime::createOwnedHostTensor(
+        nullptr, tt::runtime::getTensorDesc(host));
+    tt::runtime::memcpy(owned, host);
+    return owned;
+  }
+
+  // One read gives every shard its host tensor: a tensor of several shards
+  // keeps them for the reads of the others.
+  if (m_host_copies.empty()) {
+    // A buffer of one device holds the same data on every chip of the mesh
+    // (LoadedExecutableInstance::getOrCreateMeshDevice); one chip's is read.
+    const tt::runtime::Tensor source =
+        on_every_chip() ? tt::runtime::getDeviceTensors(*m_runtime_tensor)[0]
+                        : *m_runtime_tensor;
+    m_host_copies =
+        tt::runtime::toHost(source, /*untilize=*/true, /*blocking=*/false);
+    TT_FATAL(m_host_copies.size() == m_shards.size() ||
+                 m_host_copies.size() == 1,
+             "Unexpected number of tensors after copy to host: "
+             "tensors.size()={}, m_shards.size()={}",
+             m_host_copies.size(), m_shards.size());
+  }
+  const tt::runtime::Tensor host =
+      m_host_copies.size() == 1 ? m_host_copies[0] : m_host_copies[index];
+  if (m_shards.size() == 1) {
+    m_host_copies.clear();
+  }
+  return host;
 }
 
