diff --git a/lib/Dialect/TTNN/Analysis/MemoryLayoutPropagation.cpp b/lib/Dialect/TTNN/Analysis/MemoryLayoutPropagation.cpp
--- a/lib/Dialect/TTNN/Analysis/MemoryLayoutPropagation.cpp
+++ b/lib/Dialect/TTNN/Analysis/MemoryLayoutPropagation.cpp
@@ -1435,10 +1435,24 @@
   // insert a reconciling cast right after the op it is configuring.
   SmallVector<Operation *> configuredOps;
+  SmallVector<std::pair<OpOperand *, TTNNLayoutAttr>> exemptInputs;
   func->walk([&](Operation *op) {
     if (getChosenCandidate(op)) {
       configuredOps.push_back(op);
+    } else if (op->hasTrait<OpModelExempt>()) {
+      // Unmodeled consumers cannot validate a producer's new layout.
+      // Preserve the input layouts they were lowered with.
+      for (OpOperand &operand : op->getOpOperands()) {
+        if (auto type = dyn_cast<RankedTensorType>(operand.get().getType())) {
+          if (auto layout = dyn_cast_or_null<TTNNLayoutAttr>(type.getEncoding())) {
+            exemptInputs.emplace_back(&operand, layout);
+          }
+        }
+      }
     }
   });
   for (Operation *op : configuredOps) {
     applyOpConfig(op, *getChosenCandidate(op));
+  }
+  for (auto [operand, layout] : exemptInputs) {
+    insertReshardOp(operand->getOwner(), operand->getOperandNumber(), layout);
   }
