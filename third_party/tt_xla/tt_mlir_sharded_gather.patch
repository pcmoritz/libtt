+// Shardy can keep the operand dimension a gather indexes sharded, and then
+// sums the gathered slices across the shards. Like XLA's SPMD partitioner
+// (PartitionGatherTrivialSlicedOperandDimensions), each device makes the
+// indices relative to its shard, clamps them into it, and zeroes the slices of
+// indices in other shards. Every index is in exactly one shard.
+static void shiftGatherIndicesIntoShards(mlir::OpBuilder &builder,
+                                         mlir::sdy::MeshOp globalMeshOp,
+                                         mlir::ModuleOp &rootModule) {
+  mlir::sdy::MeshAttr mesh = globalMeshOp.getMesh();
+  rootModule.walk([&](mlir::stablehlo::GatherOp gather) {
+    mlir::stablehlo::GatherDimensionNumbersAttr dims =
+        gather.getDimensionNumbers();
+    if (dims.getStartIndexMap().size() != 1) {
+      return;
+    }
+    int64_t dim = dims.getStartIndexMap().front();
+    llvm::ArrayRef<mlir::sdy::AxisRefAttr> axes =
+        shardy_utils::getOperandShardingAttr(gather->getOpOperand(0),
+                                             globalMeshOp,
+                                             /*createIfMissing=*/false)
+            .getDimShardings()[dim]
+            .getAxes();
+    if (axes.empty()) {
+      return;
+    }
+    int64_t shards = 1;
+    for (mlir::sdy::AxisRefAttr axis : axes) {
+      shards *= axis.getSize(mesh);
+    }
+    int64_t shardSize = gather.getOperand().getType().getDimSize(dim) / shards;
+
+    mlir::MLIRContext *context = builder.getContext();
+    mlir::Location loc = gather.getLoc();
+    mlir::Value indices = gather.getStartIndices();
+    auto indicesType = mlir::cast<mlir::RankedTensorType>(indices.getType());
+    mlir::Type indexType = indicesType.getElementType();
+    mlir::RankedTensorType resultType = gather.getType();
+    mlir::sdy::TensorShardingAttr indicesSharding =
+        shardy_utils::getOperandShardingAttr(gather->getOpOperand(1),
+                                             globalMeshOp,
+                                             /*createIfMissing=*/false);
+    mlir::sdy::TensorShardingAttr resultSharding =
+        shardy_utils::getFirstSharding(gather);
+    auto annotate = [&](mlir::Value value,
+                        mlir::sdy::TensorShardingAttr sharding) {
+      if (sharding) {
+        mlir::sdy::setSharding(value, sharding);
+      }
+      return value;
+    };
+    auto constant = [&](mlir::Type type, mlir::Attribute value) {
+      return builder.create<mlir::stablehlo::ConstantOp>(
+          loc, mlir::DenseElementsAttr::get(
+                   mlir::RankedTensorType::get({}, type), value));
+    };
+
+    auto scalar = [&](int64_t value) -> mlir::Value {
+      return constant(indexType, builder.getIntegerAttr(indexType, value));
+    };
+
+    // The device's shard: its coordinates along `axes`, from
+    // stablehlo.partition_id, which numbers devices row-major over the mesh.
+    builder.setInsertionPoint(gather);
+    mlir::Value device = builder.create<mlir::stablehlo::ConvertOp>(
+        loc, mlir::RankedTensorType::get({}, indexType),
+        builder.create<mlir::stablehlo::PartitionIdOp>(loc));
+    mlir::Value shard;
+    for (mlir::sdy::AxisRefAttr axis : axes) {
+      int64_t stride = 1;
+      for (mlir::sdy::MeshAxisAttr meshAxis : llvm::reverse(mesh.getAxes())) {
+        if (meshAxis.getName() == axis.getName()) {
+          break;
+        }
+        stride *= meshAxis.getSize();
+      }
+      if (mlir::sdy::SubAxisInfoAttr subAxis = axis.getSubAxisInfo()) {
+        stride *= subAxis.getPreSize();
+      }
+      int64_t size = axis.getSize(mesh);
+      mlir::Value coord = device;
+      if (stride > 1) {
+        coord = builder.create<mlir::stablehlo::DivOp>(loc, coord,
+                                                       scalar(stride));
+      }
+      if (mesh.getTotalSize() / stride > size) {
+        coord =
+            builder.create<mlir::stablehlo::RemOp>(loc, coord, scalar(size));
+      }
+      shard = shard ? builder.create<mlir::stablehlo::AddOp>(
+                          loc,
+                          builder.create<mlir::stablehlo::MulOp>(
+                              loc, shard, scalar(size)),
+                          coord)
+                    : coord;
+    }
+    mlir::Value offset = builder.create<mlir::stablehlo::MulOp>(
+        loc, shard, scalar(shardSize));
+    offset = annotate(builder.create<mlir::stablehlo::BroadcastInDimOp>(
+                          loc, indicesType, offset,
+                          builder.getDenseI64ArrayAttr({})),
+                      indicesSharding);
+
+    mlir::Value local = annotate(
+        builder.create<mlir::stablehlo::SubtractOp>(loc, indices, offset),
+        indicesSharding);
+    mlir::Value clamped = annotate(
+        builder.create<mlir::stablehlo::ClampOp>(loc, indicesType, scalar(0),
+                                                 local, scalar(shardSize - 1)),
+        indicesSharding);
+    gather.getStartIndicesMutable().assign(clamped);
+
+    // Zero the slices of indices in other shards. The mask drops the index
+    // vector dimension and is broadcast over the slices' offset dimensions.
+    mlir::Value mine = annotate(
+        builder.create<mlir::stablehlo::CompareOp>(
+            loc, clamped, local, mlir::stablehlo::ComparisonDirection::EQ),
+        indicesSharding);
+    llvm::SmallVector<int64_t> batchShape;
+    llvm::SmallVector<mlir::sdy::DimensionShardingAttr> batchDimShardings;
+    for (auto [i, size] : llvm::enumerate(indicesType.getShape())) {
+      if (static_cast<int64_t>(i) == dims.getIndexVectorDim()) {
+        continue;
+      }
+      batchShape.push_back(size);
+      if (indicesSharding) {
+        batchDimShardings.push_back(indicesSharding.getDimShardings()[i]);
+      }
+    }
+    mlir::sdy::TensorShardingAttr batchSharding;
+    if (indicesSharding) {
+      batchSharding = mlir::sdy::TensorShardingAttr::get(
+          context, indicesSharding.getMeshOrRef(), batchDimShardings,
+          indicesSharding.getReplicatedAxes(),
+          indicesSharding.getUnreducedAxes());
+    }
+    mine = annotate(builder.create<mlir::stablehlo::ReshapeOp>(
+                        loc,
+                        mlir::RankedTensorType::get(batchShape,
+                                                    builder.getI1Type()),
+                        mine),
+                    batchSharding);
+    llvm::SmallVector<int64_t> batchDims;
+    for (int64_t i = 0; i < resultType.getRank(); ++i) {
+      if (!llvm::is_contained(dims.getOffsetDims(), i)) {
+        batchDims.push_back(i);
+      }
+    }
+    mine = annotate(builder.create<mlir::stablehlo::BroadcastInDimOp>(
+                        loc,
+                        mlir::RankedTensorType::get(resultType.getShape(),
+                                                    builder.getI1Type()),
+                        mine, builder.getDenseI64ArrayAttr(batchDims)),
+                    resultSharding);
+    mlir::Type elementType = resultType.getElementType();
+    mlir::Value zeros = annotate(
+        builder.create<mlir::stablehlo::BroadcastInDimOp>(
+            loc, resultType,
+            constant(elementType, builder.getZeroAttr(elementType)),
+            builder.getDenseI64ArrayAttr({})),
+        resultSharding);
+    builder.setInsertionPointAfter(gather);
+    auto masked = builder.create<mlir::stablehlo::SelectOp>(
+        loc, mine, gather.getResult(), zeros);
+    annotate(masked, resultSharding);
+    gather.getResult().replaceAllUsesExcept(masked, masked);
+  });
+}
