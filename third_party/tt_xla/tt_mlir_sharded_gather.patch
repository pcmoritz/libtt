--- a/lib/Dialect/StableHLO/Transforms/UpdateGlobalToLocalShapes.cpp
+++ b/lib/Dialect/StableHLO/Transforms/UpdateGlobalToLocalShapes.cpp
@@ -531,6 +531,147 @@ convertShardyCCLToStableHLOCCL(MLIRContext *context,
   return mlir::success();
