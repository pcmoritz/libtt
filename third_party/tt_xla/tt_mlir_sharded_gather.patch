+// Shardy can keep the operand dimension a gather indexes sharded, and then
+// sums the gathered slices across the shards. Like XLA's SPMD partitioner
+// (PartitionGatherTrivialSlicedOperandDimensions), each device makes the
+// indices relative to its shard; the gather reads zeros for indices in other
+// shards (tt.fill_out_of_bounds, honored by libtt's rows_gather lowering), so
+// every index contributes from exactly one shard. Runs on local shapes.
+static void shiftGatherIndicesIntoShards(mlir::OpBuilder &builder,
+                                         mlir::sdy::MeshOp globalMeshOp,
+                                         mlir::ModuleOp &rootModule) {
+  mlir::sdy::MeshAttr mesh = globalMeshOp.getMesh();
+  rootModule.walk([&](mlir::stablehlo::GatherOp gather) {
+    mlir::stablehlo::GatherDimensionNumbersAttr dims =
+        gather.getDimensionNumbers();
+    // Shardy keeps exactly these gathers' operands sharded along the indexed
+    // dimension (see the GatherOp rule in libtt's shardy_gather_replication.patch).
+    if (dims.getStartIndexMap().size() != 1) {
+      return;
+    }
+    int64_t dim = dims.getStartIndexMap().front();
+    llvm::ArrayRef<mlir::sdy::AxisRefAttr> axes =
+        shardy_utils::getOperandShardingAttr(gather->getOpOperand(0),
+                                             globalMeshOp,
+                                             /*createIfMissing=*/false)
+            .getDimShardings()[dim]
+            .getAxes();
+    if (axes.empty()) {
+      return;
+    }
+    // WrapUnderManualComputation wraps each function in a manual computation,
+    // so a user's shard_map is a nested one. Its block arguments report its
+    // in_shardings, but along its manual axes the indices are already local.
+    auto shardMap = gather->getParentOfType<mlir::sdy::ManualComputationOp>();
+    if (shardMap && shardMap->getParentOfType<mlir::sdy::ManualComputationOp>() &&
+        llvm::any_of(axes, [&](mlir::sdy::AxisRefAttr axis) {
+          return llvm::is_contained(shardMap.getManualAxes(),
+                                    mlir::StringAttr::get(
+                                        builder.getContext(), axis.getName()));
+        })) {
+      return;
+    }
+
+    mlir::Location loc = gather.getLoc();
+    mlir::Value indices = gather.getStartIndices();
+    auto indicesType = mlir::cast<mlir::RankedTensorType>(indices.getType());
+    mlir::Type indexType = indicesType.getElementType();
+    auto index = [&](int64_t value) -> mlir::Value {
+      return builder.create<mlir::stablehlo::ConstantOp>(
+          loc, mlir::DenseElementsAttr::get(
+                   mlir::RankedTensorType::get({}, indexType),
+                   builder.getIntegerAttr(indexType, value)));
+    };
+
+    // The device's shard: its coordinates along `axes`, from
+    // stablehlo.partition_id, which numbers devices row-major over the mesh.
+    // (Looking the offset up in a table with dynamic_slice doesn't work: TTNN
+    // reads the start index on the host, which needs it to be the same on
+    // every device.)
+    builder.setInsertionPoint(gather);
+    mlir::Value device = builder.create<mlir::stablehlo::ConvertOp>(
+        loc, mlir::RankedTensorType::get({}, indexType),
+        builder.create<mlir::stablehlo::PartitionIdOp>(loc));
+    mlir::Value shard;
+    int64_t shards = 1;
+    for (mlir::sdy::AxisRefAttr axis : axes) {
+      int64_t stride = 1;
+      for (mlir::sdy::MeshAxisAttr meshAxis : llvm::reverse(mesh.getAxes())) {
+        if (meshAxis.getName() == axis.getName()) {
+          break;
+        }
+        stride *= meshAxis.getSize();
+      }
+      int64_t size = axis.getSize(mesh);
+      // A sub-axis "x":(m)k splits x into [m, k, rest], major to minor.
+      if (mlir::sdy::SubAxisInfoAttr subAxis = axis.getSubAxisInfo()) {
+        stride *= mesh.getAxisSize(axis.getName()) / (subAxis.getPreSize() * size);
+      }
+      mlir::Value coord = builder.create<mlir::stablehlo::RemOp>(
+          loc, builder.create<mlir::stablehlo::DivOp>(loc, device, index(stride)),
+          index(size));
+      shard = shard ? builder.create<mlir::stablehlo::AddOp>(
+                          loc,
+                          builder.create<mlir::stablehlo::MulOp>(loc, shard,
+                                                                 index(size)),
+                          coord)
+                    : coord;
+      shards *= size;
+    }
+    int64_t shardSize = gather.getOperand().getType().getDimSize(dim);
+    mlir::Value offset = builder.create<mlir::stablehlo::BroadcastInDimOp>(
+        loc, indicesType,
+        builder.create<mlir::stablehlo::MulOp>(loc, shard, index(shardSize)),
+        builder.getDenseI64ArrayAttr({}));
+
+    // Gather clamps indices into the whole operand, so clamp before finding
+    // the owning shard. The shard-relative index is left as is: out of
+    // [0, shardSize) it reads zeros, which the sum over shards ignores.
+    mlir::Value global = builder.create<mlir::stablehlo::ClampOp>(
+        loc, indicesType, index(0), indices, index(shards * shardSize - 1));
+    gather.getStartIndicesMutable().assign(
+        builder.create<mlir::stablehlo::SubtractOp>(loc, global, offset));
+    gather->setAttr("tt.fill_out_of_bounds", builder.getUnitAttr());
+  });
+}
+
 class UpdateGlobalToLocalShapesPass
     : public impl::UpdateGlobalToLocalShapesPassBase<
           UpdateGlobalToLocalShapesPass> {
@@ -613,6 +717,8 @@ public:
       }
     });
 
+    shiftGatherIndicesIntoShards(builder, globalMeshOp, rootModule);
+
     rootModule.walk(
         [&](func::FuncOp funcOp) { inlineNestedManualComputations(funcOp); });
 
