+namespace {
+// The program's compute config, with math_approx_mode off unless the program
+// sets it: ttnn's batch_norm is exact by default, while
+// createDeviceComputeKernelConfig starts from approximate math, which is off
+// by about 1e-3.
+std::optional<::ttnn::DeviceComputeKernelConfig>
+computeConfig(const ::tt::target::ttnn::DeviceComputeKernelConfig *config) {
+  if (!config) {
+    return std::nullopt;
+  }
+  ::ttnn::DeviceComputeKernelConfig result =
+      utils::createDeviceComputeKernelConfig(config);
+  if (!config->math_approx_mode()) {
+    result.math_approx_mode = false;
+  }
+  return result;
+}
+} // namespace
