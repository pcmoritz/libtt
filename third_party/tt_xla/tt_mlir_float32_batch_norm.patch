+
+// float32 batch norm training computes the batch's statistics with
+// reductions: StableHLO returns the mean and the biased variance, while ttnn's
+// batch_norm only returns running statistics, with Bessel's correction.
+static bool decomposesBatchNorm(RankedTensorType operandType) {
+  return operandType.getElementType().isF32();
+}
+
+// The mean of an NCHW tensor over all but the channel dimension, as
+// [1, C, 1, 1].
+static mlir::Value channelMean(ConversionPatternRewriter &rewriter,
+                               Location loc, mlir::Value input) {
+  auto type = mlir::cast<RankedTensorType>(input.getType());
+  llvm::ArrayRef<int64_t> shape = type.getShape();
+  auto statType = RankedTensorType::get({1, shape[1], 1, 1},
+                                        type.getElementType(),
+                                        type.getEncoding());
+  mlir::Value sum = rewriter.create<ttir::SumOp>(
+      loc, statType, input, /*keepDim=*/true,
+      rewriter.getI32ArrayAttr({0, 2, 3}));
+  mlir::Value count = rewriter.create<ttir::FullOp>(
+      loc, statType,
+      rewriter.getF32FloatAttr(static_cast<float>(shape[0] * shape[2] *
+                                                  shape[3])));
+  return rewriter.create<ttir::DivOp>(loc, statType, sum, count);
+}
 } // namespace
 
