+
+// float32 batch norm runs as reductions and elementwise ops: ttnn's
+// batch_norm is off by about 1e-3 relative, while ttnn's float32 sums,
+// divisions and rsqrt are accurate to about 1e-7.
+static bool decomposesBatchNorm(RankedTensorType operandType) {
+  return operandType.getElementType().isF32();
+}
+
+// The mean of an NCHW tensor over all but the channel dimension, as
+// [1, C, 1, 1].
+static mlir::Value channelMean(ConversionPatternRewriter &rewriter,
+                               Location loc, mlir::Value input) {
+  auto type = mlir::cast<RankedTensorType>(input.getType());
+  llvm::ArrayRef<int64_t> shape = type.getShape();
+  auto statType = RankedTensorType::get({1, shape[1], 1, 1},
+                                        type.getElementType(),
+                                        type.getEncoding());
+  mlir::Value sum = rewriter.create<ttir::SumOp>(
+      loc, statType, input, /*keepDim=*/true,
+      rewriter.getI32ArrayAttr({0, 2, 3}));
+  mlir::Value count = rewriter.create<ttir::FullOp>(
+      loc, statType,
+      rewriter.getF32FloatAttr(static_cast<float>(shape[0] * shape[2] *
+                                                  shape[3])));
+  return rewriter.create<ttir::DivOp>(loc, statType, sum, count);
+}
+
+// (x - mean) * rsqrt(variance + epsilon) * scale + offset, given x - mean
+// and [1, C, 1, 1] statistics and parameters.
+static mlir::Value normalizeBatch(ConversionPatternRewriter &rewriter,
+                                  Location loc, mlir::Value centered,
+                                  mlir::Value variance, mlir::Value scale,
+                                  mlir::Value offset, FloatAttr epsilon) {
+  auto type = mlir::cast<RankedTensorType>(centered.getType());
+  auto statType = mlir::cast<RankedTensorType>(variance.getType());
+  mlir::Value eps = rewriter.create<ttir::FullOp>(
+      loc, statType,
+      rewriter.getF32FloatAttr(
+          static_cast<float>(epsilon.getValueAsDouble())));
+  mlir::Value invStd = rewriter.create<ttir::RsqrtOp>(
+      loc, statType,
+      rewriter.create<ttir::AddOp>(loc, statType, variance, eps));
+  mlir::Value result =
+      rewriter.create<ttir::MultiplyOp>(loc, type, centered, invStd);
+  result = rewriter.create<ttir::MultiplyOp>(loc, type, result, scale);
+  return rewriter.create<ttir::AddOp>(loc, type, result, offset);
+}
 } // namespace
 
