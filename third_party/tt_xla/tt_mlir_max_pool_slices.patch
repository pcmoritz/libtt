+// Whether a reduction body only contains elementwise ops, which apply to whole
+// tensors as they do to the body's scalars.
+static bool hasElementwiseBody(Block &body) {
+  return llvm::all_of(body.without_terminator(), [](Operation &op) {
+    return isa<mlir::stablehlo::CompareOp, mlir::stablehlo::SelectOp,
+               mlir::stablehlo::AndOp, mlir::stablehlo::OrOp,
+               mlir::stablehlo::NotOp, mlir::stablehlo::MaxOp,
+               mlir::stablehlo::MinOp, mlir::stablehlo::AddOp,
+               mlir::stablehlo::MulOp>(op);
+  });
+}
+
+// Applies an elementwise reduction body to tensors of `shape`: the body's
+// first arguments take `lhs` and the rest `rhs`. The cloned StableHLO ops are
+// converted like any other.
+static SmallVector<Value> applyReductionBody(Block &body, ValueRange lhs,
+                                             ValueRange rhs,
+                                             ArrayRef<int64_t> shape,
+                                             PatternRewriter &rewriter) {
+  IRMapping mapping;
+  for (size_t i = 0; i < lhs.size(); ++i) {
+    mapping.map(body.getArgument(i), lhs[i]);
+    mapping.map(body.getArgument(lhs.size() + i), rhs[i]);
+  }
+  for (Operation &op : body.without_terminator()) {
+    Operation *clone = rewriter.clone(op, mapping);
+    for (OpResult result : clone->getResults()) {
+      result.setType(RankedTensorType::get(
+          shape,
+          mlir::cast<RankedTensorType>(result.getType()).getElementType()));
+    }
+  }
+  SmallVector<Value> results;
+  for (Value operand : body.getTerminator()->getOperands()) {
+    results.push_back(mapping.lookupOrDefault(operand));
+  }
+  return results;
+}
+
+// Combines reduction results with their init values, broadcast to `shape`.
+// StableHLO reductions start from the init values; for an identity such as
+// max pooling's lowest value this changes nothing.
+static SmallVector<Value> applyReductionInit(Block &body, ValueRange results,
+                                             ValueRange inits,
+                                             ArrayRef<int64_t> shape,
+                                             Location loc,
+                                             PatternRewriter &rewriter) {
+  SmallVector<Value> broadcastInits;
+  for (Value init : inits) {
+    auto type = mlir::cast<RankedTensorType>(init.getType());
+    broadcastInits.push_back(rewriter.create<mlir::stablehlo::BroadcastInDimOp>(
+        loc, RankedTensorType::get(shape, type.getElementType()), init,
+        rewriter.getDenseI64ArrayAttr({})));
+  }
+  return applyReductionBody(body, broadcastInits, results, shape, rewriter);
+}
