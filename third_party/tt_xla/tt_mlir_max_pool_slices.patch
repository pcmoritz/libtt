+  LogicalResult matchAndRewriteVariadicSlices(
+      mlir::stablehlo::ReduceOp &srcOp,
+      mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+      ConversionPatternRewriter &rewriter) const {
+    constexpr int64_t kMaxSlices = 64;
+    Block &body = srcOp.getBody().front();
+    SmallVector<Value> inputs(adaptor.getInputs().begin(),
+                              adaptor.getInputs().end());
+    auto inputType = mlir::cast<RankedTensorType>(inputs.front().getType());
+    ArrayRef<int64_t> dimensions = srcOp.getDimensions();
+    SmallVector<int64_t> shape(inputType.getShape());
+    int64_t numSlices = 0;
+    for (int64_t d : dimensions) {
+      numSlices += shape[d];
+    }
+    if (!hasElementwiseBody(body) || !inputType.hasStaticShape() ||
+        numSlices > kMaxSlices ||
+        llvm::any_of(dimensions, [&](int64_t d) { return shape[d] == 0; })) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "unsupported variadic stablehlo.reduce");
+    }
+
+    Location loc = srcOp.getLoc();
+    SmallVector<int64_t> ones(shape.size(), 1);
+    for (int64_t d : dimensions) {
+      SmallVector<int64_t> window(ones);
+      window[d] = shape[d];
+      shape[d] = 1;
+      inputs =
+          reduceSlices(body, inputs, window, ones, ones, shape, loc, rewriter);
+    }
+
+    SmallVector<Value> results = applyReductionInit(
+        body, inputs, adaptor.getInitValues(), shape, loc, rewriter);
+    for (size_t i = 0; i < results.size(); ++i) {
+      auto resultType = mlir::cast<RankedTensorType>(
+          getTypeConverter()->convertType(srcOp.getResult(i).getType()));
+      results[i] = rewriter.create<ttir::ReshapeOp>(
+          loc, resultType, results[i],
+          rewriter.getI32ArrayAttr(SmallVector<int32_t>(
+              resultType.getShape().begin(), resultType.getShape().end())));
+    }
+    rewriter.replaceOp(srcOp, results);
+    return success();
+  }
