+// An embedding lookup in a table sharded by rows across a mesh axis would
+// all-gather the whole table first, e.g. a vocabulary-parallel token
+// embedding. Instead, each device looks up the indices that fall into its
+// rows and zeroes the others, and an all-reduce sums the lookups. Every index
+// is in the rows of exactly one device, so the sum is exact. Only for
+// bfloat16 and float32 tables, whose sums across devices are exact.
+class ShardedEmbeddingPattern : public mlir::OpRewritePattern<EmbeddingOp> {
+public:
+  using mlir::OpRewritePattern<EmbeddingOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(EmbeddingOp op, mlir::PatternRewriter &rewriter) const final {
+    Value table = op.getWeight();
+    while (mlir::isa_and_nonnull<PermuteOp, ReshapeOp>(table.getDefiningOp()) &&
+           table.getDefiningOp()->getOperand(0).getType() == table.getType()) {
+      table = table.getDefiningOp()->getOperand(0);
+    }
+    auto gather = table.getDefiningOp<AllGatherOp>();
+    auto indicesType = mlir::cast<RankedTensorType>(op.getInput().getType());
+    auto indexType = mlir::dyn_cast<IntegerType>(indicesType.getElementType());
+    Type valueType = op.getType().getElementType();
+    if (!gather || gather.getAllGatherDim() != 0 ||
+        !(valueType.isBF16() || valueType.isF32()) || !indexType ||
+        indexType.getWidth() != 32 || indexType.isUnsigned()) {
+      return mlir::failure();
+    }
+    auto shardType = mlir::cast<RankedTensorType>(gather.getInput().getType());
+    const int64_t rows = shardType.getDimSize(0);
+    const int64_t devices =
+        mlir::cast<RankedTensorType>(table.getType()).getDimSize(0) / rows;
+    Location loc = op.getLoc();
+
+    // The first row of each device: [0, rows, 2 * rows, ...] split across
+    // the gathered mesh axis.
+    SmallVector<APInt> starts;
+    for (int64_t device = 0; device < devices; ++device) {
+      starts.push_back(APInt(32, device * rows));
+    }
+    auto startsType = RankedTensorType::get({devices}, indexType);
+    Value start = rewriter.create<ConstantOp>(
+        loc, startsType, DenseElementsAttr::get(startsType, starts));
+    auto oneType = RankedTensorType::get({1}, indexType);
+    start = rewriter.create<MeshPartitionOp>(loc, oneType, start,
+                                             rewriter.getSI32IntegerAttr(0),
+                                             gather.getClusterAxisAttr());
+    SmallVector<int64_t> ones(indicesType.getRank(), 1);
+    start = rewriter.create<ReshapeOp>(
+        loc, RankedTensorType::get(ones, indexType), start,
+        rewriter.getI32ArrayAttr(SmallVector<int32_t>(ones.size(), 1)));
+    start = rewriter.create<BroadcastOp>(
+        loc, indicesType, start,
+        ttmlir::utils::getBroadcastDimensions<int64_t>(
+            ones, indicesType.getShape()));
+
+    Value local =
+        rewriter.create<SubtractOp>(loc, indicesType, op.getInput(), start);
+    Value clamped = rewriter.create<ClampScalarOp>(
+        loc, indicesType, local, rewriter.getI32IntegerAttr(0),
+        rewriter.getI32IntegerAttr(rows - 1));
+    // Like other comparisons on device, the mask has the values' type.
+    auto outputType = op.getType();
+    Type maskElementType = outputType.getElementType();
+    Value mine = rewriter.create<EqualOp>(
+        loc, RankedTensorType::get(indicesType.getShape(), maskElementType),
+        clamped, local);
+    Value rowsFound = rewriter.create<EmbeddingOp>(loc, outputType, clamped,
+                                                   gather.getInput());
+
+    // Zero the lookups of indices in other devices' rows.
+    SmallVector<int64_t> maskShape(indicesType.getShape());
+    maskShape.push_back(1);
+    SmallVector<int32_t> maskShape32(maskShape.begin(), maskShape.end());
+    mine = rewriter.create<ReshapeOp>(
+        loc, RankedTensorType::get(maskShape, maskElementType), mine,
+        rewriter.getI32ArrayAttr(maskShape32));
+    mine = rewriter.create<BroadcastOp>(
+        loc, RankedTensorType::get(outputType.getShape(), maskElementType),
+        mine,
+        ttmlir::utils::getBroadcastDimensions<int64_t>(
+            maskShape, outputType.getShape()));
+    Value zeros = rewriter.create<ZerosOp>(
+        loc, outputType, llvm::to_vector_of<int32_t>(outputType.getShape()));
+    Value masked =
+        rewriter.create<WhereOp>(loc, outputType, mine, rowsFound, zeros);
+    rewriter.replaceOpWithNewOp<AllReduceOp>(
+        op, outputType, masked,
+        ttcore::ReduceTypeAttr::get(rewriter.getContext(),
+                                    ttcore::ReduceType::Sum),
+        gather.getClusterAxisAttr());
+    return mlir::success();
+  }
+};
