+static bool isTraceKeyInput(
+    const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op, size_t inputIndex) {
+  const auto *indices = op->trace_key_input_indices();
+  return indices &&
+         std::find(indices->begin(), indices->end(), inputIndex) !=
+             indices->end();
+}
+
+// Whether input `inputIndex` is captured by address rather than copied into
+// a slot. Binaries that predate the explicit partition record it in the
+// input's storage type.
+static bool isDeviceResidentInput(
+    const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op, size_t inputIndex) {
+  const auto *indices = op->device_resident_input_indices();
+  if (!indices) {
+    return ::tt::runtime::ttnn::utils::inDeviceMemory(
+        op->inputs()->Get(inputIndex));
+  }
+  return std::find(indices->begin(), indices->end(), inputIndex) !=
+         indices->end();
+}
+
+static std::int64_t readTraceKeyScalar(const ::ttnn::Tensor &tensor) {
+  LOG_ASSERT(tensor.storage_type() == ::ttnn::StorageType::HOST,
+             "Trace-key inputs must reside on host");
+  switch (tensor.dtype()) {
+  case ::ttnn::DataType::INT32:
+    return ::tt::runtime::ttnn::utils::getScalarFromTensor<int32_t>(tensor);
+  case ::ttnn::DataType::UINT32:
+    return ::tt::runtime::ttnn::utils::getScalarFromTensor<uint32_t>(tensor);
+  case ::ttnn::DataType::UINT16:
+    return ::tt::runtime::ttnn::utils::getScalarFromTensor<uint16_t>(tensor);
+  case ::ttnn::DataType::UINT8:
+    return ::tt::runtime::ttnn::utils::getScalarFromTensor<uint8_t>(tensor);
+  case ::ttnn::DataType::BFLOAT16:
+    return static_cast<float>(
+               ::tt::runtime::ttnn::utils::getScalarFromTensor<bfloat16>(tensor)) !=
+           0;
+  default:
+    LOG_FATAL("Unsupported integer trace-key scalar data type");
+  }
+}
+
+static std::vector<std::int64_t>
+getTraceKey(const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op,
+            ProgramContext &context) {
+  std::vector<std::int64_t> key;
+  const auto *indices = op->trace_key_input_indices();
+  if (!indices) {
+    return key;
+  }
+  key.reserve(indices->size());
+  for (uint32_t inputIndex : *indices) {
+    LOG_ASSERT(inputIndex < op->inputs()->size(),
+               "Trace-key input index is out of range");
+    const auto &tensor = context.getTensorPool().getTTNNTensorAndValidate(
+        op->inputs()->Get(inputIndex));
+    key.push_back(readTraceKeyScalar(tensor));
+  }
+  return key;
+}
