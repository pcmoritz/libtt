+namespace {
+class StableHLOToTTIRConvertOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ConvertOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::ConvertOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConvertOp srcOp,
+                  mlir::stablehlo::ConvertOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult().getType()));
+    auto inputType =
+        mlir::cast<RankedTensorType>(adaptor.getOperand().getType());
+    auto resultIntegerType =
+        mlir::dyn_cast<IntegerType>(resultType.getElementType());
+
+    Value input = adaptor.getOperand();
+    if (mlir::isa<FloatType>(inputType.getElementType()) &&
+        resultIntegerType && resultIntegerType.getWidth() > 1) {
+      // StableHLO/JAX float-to-integer conversion truncates toward zero,
+      // whereas TTNN typecast rounds. Make the rounding explicit first.
+      Value magnitude =
+          rewriter.create<ttir::AbsOp>(srcOp.getLoc(), inputType, input);
+      magnitude = rewriter.create<ttir::FloorOp>(srcOp.getLoc(), inputType,
+                                                  magnitude);
+      Value sign =
+          rewriter.create<ttir::SignOp>(srcOp.getLoc(), inputType, input);
+      input = rewriter.create<ttir::MultiplyOp>(srcOp.getLoc(), inputType,
+                                                 magnitude, sign);
+    }
+
+    rewriter.replaceOpWithNewOp<ttir::TypecastOp>(srcOp, resultType, input);
+    return success();
+  }
+};
+} // namespace
