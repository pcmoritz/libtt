 namespace {
+// An FP32 RMS norm of a BF16 tensor cast to FP32 normalizes the BF16 tensor and
+// produces FP32 itself: with FP32 accumulation the norm unpacks BF16 exactly
+// into FP32 DST and keeps its intermediates in FP32, so only the typecast
+// program goes. A norm without a compute config gets the maximum-precision
+// one RMSNormConfigRewritePattern would give it later.
+class TTNNRMSNormOfUpcast : public mlir::OpRewritePattern<RMSNormOp> {
+public:
+  using mlir::OpRewritePattern<RMSNormOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(RMSNormOp norm, mlir::PatternRewriter &rewriter) const final {
+    auto cast = norm.getInput().getDefiningOp<TypecastOp>();
+    auto elementType = [](Value v) {
+      return mlir::cast<mlir::RankedTensorType>(v.getType()).getElementType();
+    };
+    DeviceComputeKernelConfigAttr config = norm.getComputeConfigAttr();
+    if (!cast || !cast.getResult().hasOneUse() ||
+        !elementType(cast.getInput()).isBF16() ||
+        !elementType(cast.getResult()).isF32() ||
+        !elementType(norm.getResult()).isF32() ||
+        (config && (!config.getFp32DestAccEn() ||
+                    !config.getFp32DestAccEn().getValue()))) {
+      return mlir::failure();
+    }
+    MLIRContext *context = norm.getContext();
+    if (!config) {
+      config = DeviceComputeKernelConfigAttr::get(
+          context, MathFidelity::HiFi4, BoolAttr::get(context, false),
+          BoolAttr::get(context, true), BoolAttr::get(context, true),
+          /*dstFullSyncEn=*/nullptr);
+    }
+    rewriter.modifyOpInPlace(norm, [&]() {
+      norm.getInputMutable().assign(cast.getInput());
+      norm.setComputeConfigAttr(config);
+    });
+    rewriter.eraseOp(cast);
+    return mlir::success();
+  }
+};
+} // namespace
