+// The branch of a conditional whose selector is on device, while its program
+// runs. Its trace is captured as a conditional trace after a dry warmup, which
+// compiles its programs without running them, and replayed with
+// enqueue_trace_if: it runs only if the first word of `predicate` (a uint32
+// tensor in interleaved DRAM) is `value`, and nothing reads the predicate on
+// host. The branches of a conditional publish their results in the same output
+// slots, the first branch's, so that they are the conditional's results
+// whichever branch ran.
+struct ConditionalTrace {
+  const ::ttnn::Tensor &predicate;
+  uint32_t value;
+  // Empty until the trace of a branch has slots.
+  std::vector<::tt::runtime::Tensor> &outputSlots;
+  // Whether workloads are launched dry: during the warmup of a capture.
+  bool dryLaunches = false;
+};
+
+// The conditional trace of this thread, if a branch program runs as one.
+ConditionalTrace *currentConditionalTrace();
+
+// Makes a conditional trace current while a branch program runs.
+class ConditionalTraceScope {
+public:
+  explicit ConditionalTraceScope(ConditionalTrace &trace);
+  ~ConditionalTraceScope();
+  ConditionalTraceScope(const ConditionalTraceScope &) = delete;
+  ConditionalTraceScope &operator=(const ConditionalTraceScope &) = delete;
+
+private:
+  ConditionalTrace *previous;
+};
+
+// Launches workloads dry or not while a conditional trace is current; does
+// nothing otherwise.
+void setDryLaunches(::ttnn::MeshDevice &meshDevice, bool dry);
+
 } // namespace tt::runtime::ttnn::operations::trace
 
