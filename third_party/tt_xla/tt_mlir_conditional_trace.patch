 namespace tt::runtime::ttnn::operations::trace {
 
+namespace {
+thread_local ConditionalTrace *conditionalTrace = nullptr;
+} // namespace
+
+ConditionalTrace *currentConditionalTrace() { return conditionalTrace; }
+
+ConditionalTraceScope::ConditionalTraceScope(ConditionalTrace &trace)
+    : previous(conditionalTrace) {
+  conditionalTrace = &trace;
+}
+
+ConditionalTraceScope::~ConditionalTraceScope() {
+  conditionalTrace = previous;
+}
+
+void setDryLaunches(::ttnn::MeshDevice &meshDevice, bool dry) {
+  if (!conditionalTrace || conditionalTrace->dryLaunches == dry) {
+    return;
+  }
+  meshDevice.mesh_command_queue(0).set_dry_launches(dry);
+  conditionalTrace->dryLaunches = dry;
+}
+
+// Replays a trace; under a conditional trace, only if its predicate holds.
+static void replayTrace(::ttnn::MeshDevice &meshDevice,
+                        ::ttnn::MeshTraceId traceId) {
+  if (conditionalTrace) {
+    meshDevice.mesh_command_queue(0).enqueue_trace_if(
+        traceId, conditionalTrace->predicate.mesh_buffer(),
+        conditionalTrace->value);
+    return;
+  }
+  ::ttnn::operations::trace::execute_trace(&meshDevice, traceId,
+                                           ::ttnn::QueueId(0),
+                                           /*blocking=*/false);
+}
+
+// Under a conditional trace, the branches share their output slots: a trace
+// takes the slots of the branch before it, or gives its own to the branches
+// after it.
+static void shareOutputSlots(std::vector<::tt::runtime::Tensor> &outputSlots) {
+  if (!conditionalTrace) {
+    return;
+  }
+  if (conditionalTrace->outputSlots.empty()) {
+    conditionalTrace->outputSlots = outputSlots;
+    return;
+  }
+  LOG_ASSERT(conditionalTrace->outputSlots.size() == outputSlots.size(),
+             "The branches of a conditional trace must have the same results");
+  outputSlots = conditionalTrace->outputSlots;
+}
+
+// Whether a cached variant was captured the way this invocation runs: as a
+// conditional trace exactly when one is current, writing the slots the other
+// branches write.
+static bool matchesConditional(const TraceVariant &variant) {
+  if (variant.conditional != (conditionalTrace != nullptr)) {
+    return false;
+  }
+  if (!conditionalTrace || conditionalTrace->outputSlots.empty()) {
+    return true;
+  }
+  if (variant.outputTensors.size() != conditionalTrace->outputSlots.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < variant.outputTensors.size(); ++i) {
+    if (variant.outputTensors[i].handle.get() !=
+        conditionalTrace->outputSlots[i].handle.get()) {
+      return false;
+    }
+  }
+  return true;
+}
