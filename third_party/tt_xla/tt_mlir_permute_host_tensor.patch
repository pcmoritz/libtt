+std::optional<::tt::runtime::Tensor>
+permuteHostTensor(::tt::runtime::Tensor tensor,
+                  const std::vector<std::int64_t> &permutation) {
+  const ::ttnn::Tensor &ttnnTensor =
+      utils::getTTNNTensorFromRuntimeTensor(tensor);
+  if (!utils::isOnHost(ttnnTensor.storage_type()) ||
+      ttnnTensor.layout() != ::ttnn::Layout::ROW_MAJOR) {
+    return std::nullopt;
+  }
+  std::vector<::ttnn::Tensor> hostShards =
+      ::ttnn::distributed::get_device_tensors(ttnnTensor);
+  const TensorDesc desc = getTensorDesc(tensor);
+  if (hostShards.size() != 1 || permutation.size() != desc.shape.size()) {
+    return std::nullopt;
+  }
+
+  // The caller's memory a strided view stands for, or the tensor's buffer.
+  const StridedHostView *view = nullptr;
+  ttnnTensor.host_storage().host_tensor().buffer().apply(
+      [&](const ::tt::tt_metal::HostBuffer &shard) {
+        view = findStridedHostView(shard);
+      });
+  const void *data =
+      view ? view->data : utils::getRawHostDataPtr(hostShards.front());
+  const std::vector<std::int64_t> &stride = view ? view->stride : desc.stride;
+
+  std::vector<std::uint32_t> shape(permutation.size());
+  std::vector<std::int64_t> permutedStride(permutation.size());
+  for (size_t i = 0; i < permutation.size(); ++i) {
+    shape[i] = desc.shape[permutation[i]];
+    permutedStride[i] = stride[permutation[i]];
+  }
+  // A permuted view is not contiguous: the copy gathers it, transposing
+  // 16-bit matrices in 8x8 blocks.
+  return createOwnedHostTensor(data, shape, permutedStride, desc.elementSize(),
+                               desc.dataType);
+}
