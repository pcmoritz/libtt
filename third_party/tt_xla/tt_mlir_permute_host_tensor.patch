+std::optional<Tensor>
+permuteHostTensor(Tensor tensor, const std::vector<std::int64_t> &permutation) {
+  using RetType = std::optional<Tensor>;
+  return DISPATCH_TO_CURRENT_RUNTIME(
+      RetType,
+      [&]() -> RetType {
+        return ::tt::runtime::ttnn::permuteHostTensor(std::move(tensor),
+                                                      permutation);
+      },
+      [&]() -> RetType { return std::nullopt; },
+      [&]() -> RetType { return std::nullopt; });
+}
