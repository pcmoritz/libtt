+// Packs separate real and imaginary tensors into the trailing-dimension
+// representation used for complex values:
+//
+//   (tensor<d0x...xdNxf32>, tensor<d0x...xdNxf32>)
+//                         --> tensor<d0x...xdNx2xf32>
+static Value packRealImag(Location loc, Value real, Value imag,
+                          OpBuilder &builder) {
+  auto componentType = mlir::cast<RankedTensorType>(real.getType());
+
+  SmallVector<int64_t> unsqueezedShape;
+  unsqueezedShape.push_back(1);
+  for (auto d : componentType.getShape()) {
+    unsqueezedShape.push_back(d);
+  }
+  auto unsqueezedType =
+      RankedTensorType::get(unsqueezedShape, componentType.getElementType());
+  auto reshapedReal = builder.create<mlir::stablehlo::ReshapeOp>(
+      loc, unsqueezedType, real);
+  auto reshapedImag = builder.create<mlir::stablehlo::ReshapeOp>(
+      loc, unsqueezedType, imag);
+
+  SmallVector<int64_t> concatShape;
+  concatShape.push_back(2);
+  for (auto d : componentType.getShape()) {
+    concatShape.push_back(d);
+  }
+  auto concatType =
+      RankedTensorType::get(concatShape, componentType.getElementType());
+  auto concat = builder.create<mlir::stablehlo::ConcatenateOp>(
+      loc, concatType,
+      ValueRange{reshapedReal.getResult(), reshapedImag.getResult()},
+      /*dimension=*/0);
+
+  return transposeLeadingToTrailing(loc, concat.getResult(), builder);
+}
