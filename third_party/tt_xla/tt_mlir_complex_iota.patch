+// Rewrites a complex stablehlo.iota as a real iota paired with an all-zero
+// imaginary tensor. Merely changing the iota result to tensor<...x2xf32>
+// would incorrectly generate the iota value in both component lanes.
+namespace {
+class ComplexIotaOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::IotaOp> {
+  using OpConversionPattern<mlir::stablehlo::IotaOp>::OpConversionPattern;
+
+public:
+  LogicalResult matchAndRewrite(
+      mlir::stablehlo::IotaOp op,
+      OpConversionPattern<mlir::stablehlo::IotaOp>::OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    auto originalType = mlir::cast<RankedTensorType>(op.getType());
+    auto complexType =
+        mlir::dyn_cast<mlir::ComplexType>(originalType.getElementType());
+    if (!complexType) {
+      return failure();
+    }
+
+    auto componentType = RankedTensorType::get(
+        originalType.getShape(), complexType.getElementType());
+    Value real = rewriter.create<mlir::stablehlo::IotaOp>(
+        op.getLoc(), componentType, op.getIotaDimension());
+    auto zeros = DenseElementsAttr::get(
+        componentType,
+        rewriter.getFloatAttr(complexType.getElementType(), 0.0));
+    Value imag = rewriter.create<mlir::stablehlo::ConstantOp>(
+        op.getLoc(), componentType, zeros);
+
+    rewriter.replaceOp(
+        op, packRealImag(op.getLoc(), real, imag, rewriter));
     return success();
   }
 };
