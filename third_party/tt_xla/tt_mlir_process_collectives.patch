+namespace {
+bool isDramInterleavedTiled(const ::ttnn::Tensor &tensor) {
+  return tensor.memory_config().is_dram() &&
+         !tensor.memory_config().is_sharded() &&
+         tensor.layout() == ::ttnn::Layout::TILE;
+}
+
+int32_t nonNegativeDim(int32_t dim, uint32_t rank) {
+  return dim < 0 ? dim + static_cast<int32_t>(rank) : dim;
+}
+
+// `tensor` in DRAM-interleaved tiles, as the collectives that trade addresses
+// take it.
+::ttnn::Tensor toDramTiles(const ::ttnn::Tensor &tensor) {
+  ::ttnn::Tensor result = tensor;
+  if (!result.memory_config().is_dram() ||
+      result.memory_config().is_sharded()) {
+    result = ::ttnn::to_memory_config(result, ::ttnn::DRAM_MEMORY_CONFIG);
+  }
+  if (result.layout() != ::ttnn::Layout::TILE) {
+    result = ::ttnn::to_layout(result, ::ttnn::Layout::TILE);
+  }
+  return result;
+}
+
+// `tensor` back in `like`'s layout, in `memoryConfig` or else `like`'s.
+::ttnn::Tensor
+likeInput(const ::ttnn::Tensor &tensor, const ::ttnn::Tensor &like,
+          const std::optional<::ttnn::MemoryConfig> &memoryConfig) {
+  ::ttnn::Tensor result = tensor;
+  if (result.layout() != like.layout()) {
+    result = ::ttnn::to_layout(result, like.layout());
+  }
+  const ::ttnn::MemoryConfig wanted =
+      memoryConfig.value_or(like.memory_config());
+  if (result.memory_config() != wanted) {
+    result = ::ttnn::to_memory_config(result, wanted);
+  }
+  return result;
+}
+
+// A view of `tensor` with a leading dimension of one to gather along, of at
+// most four dimensions (the dimensions before the last two merged).
+::ttnn::Tensor withLeadingUnitDim(const ::ttnn::Tensor &tensor) {
+  const ::ttnn::Shape &shape = tensor.logical_shape();
+  ::ttsl::SmallVector<uint32_t> dims{1};
+  if (shape.rank() == 0) {
+    dims.push_back(1);
+  } else if (shape.rank() < 4) {
+    for (uint32_t size : shape) {
+      dims.push_back(size);
+    }
+  } else {
+    uint32_t leading = 1;
+    for (size_t i = 0; i + 2 < shape.rank(); ++i) {
+      leading *= shape[i];
+    }
+    dims.push_back(leading);
+    dims.push_back(shape[-2]);
+    dims.push_back(shape[-1]);
+  }
+  return ::ttnn::reshape(tensor, ::ttnn::Shape(dims));
+}
+} // namespace
+
+bool meshSpansProcesses(const ::ttnn::MeshDevice &device) {
+  return device.get_view().get_local_mesh_coord_range().shape().mesh_size() !=
+         device.shape().mesh_size();
+}
+
+bool allGatherTradesAddresses(const ::ttnn::Tensor &input, int32_t dim) {
+  const ::ttnn::Shape &shape = input.logical_shape();
+  dim = nonNegativeDim(dim, shape.rank());
+  return isDramInterleavedTiled(input) &&
+         shape[dim] == input.padded_shape()[dim];
+}
+
+bool reduceScatterTradesAddresses(const ::ttnn::Tensor &input, int32_t dim,
+                                  uint32_t ringSize) {
+  const ::ttnn::Shape &shape = input.logical_shape();
+  const int32_t rank = static_cast<int32_t>(shape.rank());
+  dim = nonNegativeDim(dim, rank);
+  const auto tileShape = input.tensor_spec().tile().get_tile_shape();
+  return isDramInterleavedTiled(input) && shape[dim] % ringSize == 0 &&
+         (dim < rank - 2 ||
+          (shape[dim] / ringSize) % tileShape[dim - (rank - 2)] == 0);
+}
+
+bool allReduceExchangesInL1(
+    const ::ttnn::Tensor &input, uint32_t ringSize,
+    const std::optional<::tt::tt_metal::SubDeviceId> &subDeviceId,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig) {
+  // ttnn::all_reduce's own condition for its direct exchange.
+  return !subDeviceId && input.device()->num_devices() == ringSize &&
+         outputMemoryConfig.value_or(::ttnn::DRAM_MEMORY_CONFIG) ==
+             ::ttnn::DRAM_MEMORY_CONFIG &&
+         ::ttnn::experimental::prim::direct_all_reduce_scratch_config(input,
+                                                                      ringSize)
+             .has_value();
+}
+
+CollectiveAlongDim
+allGatherAlong(std::optional<uint32_t> clusterAxis,
+               std::optional<::tt::tt_metal::SubDeviceId> subDeviceId,
+               std::optional<uint32_t> numLinks) {
+  return [=](const ::ttnn::Tensor &tensor, int32_t dim) {
+    return ::ttnn::all_gather(tensor, dim, clusterAxis,
+                              ::ttnn::DRAM_MEMORY_CONFIG,
+                              /*persistent_output_tensor=*/std::nullopt,
+                              subDeviceId, /*sub_core_grid=*/std::nullopt,
+                              numLinks);
+  };
+}
+
+CollectiveAlongDim
+reduceScatterAlong(std::optional<uint32_t> clusterAxis,
+                   std::optional<::tt::tt_metal::SubDeviceId> subDeviceId,
+                   std::optional<uint32_t> numLinks) {
+  return [=](const ::ttnn::Tensor &tensor, int32_t dim) {
+    return ::ttnn::reduce_scatter(tensor, dim, clusterAxis, subDeviceId,
+                                  ::ttnn::DRAM_MEMORY_CONFIG,
+                                  /*intermediate_memory_config=*/std::nullopt,
+                                  /*optional_output_tensor=*/std::nullopt,
+                                  numLinks, ::tt::tt_fabric::Topology::Linear);
+  };
+}
+
+::ttnn::Tensor allGatherAcrossProcesses(
+    const ::ttnn::Tensor &input, int32_t dim, const CollectiveAlongDim &gather,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig) {
+  const ::ttnn::Shape &shape = input.logical_shape();
+  const int32_t rank = static_cast<int32_t>(shape.rank());
+  dim = nonNegativeDim(dim, rank);
+  const ::ttnn::Tensor tiles = toDramTiles(input);
+  if (allGatherTradesAddresses(tiles, dim)) {
+    return likeInput(gather(tiles, dim), input, outputMemoryConfig);
+  }
+  // A padded (tiled) dimension: gather the whole tensors along a leading
+  // dimension and concatenate the ring's pieces along `dim`.
+  const ::ttnn::Tensor gathered = gather(withLeadingUnitDim(tiles), 0);
+  const ::ttnn::Shape &gatheredShape = gathered.logical_shape();
+  const uint32_t ringSize = gatheredShape[0];
+  ::ttsl::SmallVector<uint32_t> begins(gatheredShape.rank(), 0);
+  ::ttsl::SmallVector<uint32_t> ends(gatheredShape.cbegin(),
+                                     gatheredShape.cend());
+  const ::ttsl::SmallVector<uint32_t> steps(gatheredShape.rank(), 1);
+  std::vector<::ttnn::Tensor> pieces;
+  for (uint32_t i = 0; i < ringSize; ++i) {
+    begins[0] = i;
+    ends[0] = i + 1;
+    pieces.push_back(::ttnn::slice(gathered, begins, ends, steps));
+  }
+  const int32_t concatDim =
+      dim - rank + static_cast<int32_t>(gatheredShape.rank());
+  ::ttsl::SmallVector<uint32_t> outDims(shape.cbegin(), shape.cend());
+  outDims[dim] *= ringSize;
+  return likeInput(::ttnn::reshape(::ttnn::concat(pieces, concatDim),
+                                   ::ttnn::Shape(outDims)),
+                   input, outputMemoryConfig);
+}
+
+::ttnn::Tensor allReduceAcrossProcesses(
+    const ::ttnn::Tensor &input, ::reduction_common::ReduceType reduceType,
+    uint32_t ringSize, const CollectiveAlongDim &gather,
+    const CollectiveAlongDim &scatter,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig) {
+  const ::ttnn::Tensor tiles = toDramTiles(input);
+  const ::ttnn::Shape &shape = tiles.logical_shape();
+  // A sum whose reduce-scatter and all-gather trade addresses: as ttnn runs it.
+  if (reduceType == ::reduction_common::ReduceType::Sum) {
+    for (int32_t dim = static_cast<int32_t>(shape.rank()) - 1; dim >= 0;
+         --dim) {
+      if (reduceScatterTradesAddresses(tiles, dim, ringSize)) {
+        return likeInput(gather(scatter(tiles, dim), dim), input,
+                         outputMemoryConfig);
+      }
+    }
+  }
+  // Otherwise every rank's whole tensor, gathered along a leading dimension
+  // and reduced across it.
+  const ::ttnn::Tensor gathered = gather(withLeadingUnitDim(tiles), 0);
+  ::ttnn::Tensor reduced;
+  switch (reduceType) {
+  case ::reduction_common::ReduceType::Sum:
+    reduced = ::ttnn::sum(gathered, 0);
+    break;
+  case ::reduction_common::ReduceType::Max:
+    reduced = ::ttnn::max(gathered, 0);
+    break;
+  case ::reduction_common::ReduceType::Min:
+    reduced = ::ttnn::min(gathered, 0);
+    break;
+  default:
+    LOG_FATAL("Unsupported reduce type for a collective between processes");
+  }
+  return likeInput(::ttnn::reshape(reduced, shape), input,
+                   outputMemoryConfig);
+}
+
+::ttnn::Tensor reduceScatterAcrossProcesses(
+    const ::ttnn::Tensor &input, int32_t dim, uint32_t ringSize,
+    std::optional<uint32_t> clusterAxis, const CollectiveAlongDim &gather,
+    const CollectiveAlongDim &scatter,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig) {
+  const ::ttnn::Tensor reduced = allReduceAcrossProcesses(
+      input, ::reduction_common::ReduceType::Sum, ringSize, gather, scatter,
+      ::ttnn::DRAM_MEMORY_CONFIG);
+  // Row-major, as tiled slices must start on tile boundaries.
+  const ::ttnn::Tensor slice = ::ttnn::mesh_partition(
+      ::ttnn::to_layout(reduced, ::ttnn::Layout::ROW_MAJOR), dim, clusterAxis,
+      ::ttnn::DRAM_MEMORY_CONFIG);
+  return likeInput(slice, input, outputMemoryConfig);
+}
+
+::ttnn::Tensor runCollectiveInPieces(
+    const ::ttnn::Tensor &input, int32_t collectiveDim,
+    double bytesPerInputByte, uint64_t budgetPerBank,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig,
+    const std::function<::ttnn::Tensor(const ::ttnn::Tensor &)> &collective) {
+  ::ttnn::MeshDevice &device = *input.device();
+  // Buffers are interleaved over the DRAM banks; 10% for their page rounding.
+  const double bytesPerBank =
+      bytesPerInputByte * input.physical_volume() * input.element_size() /
+      device.allocator()->get_num_banks(::ttnn::BufferType::DRAM);
+  const auto pieces =
+      static_cast<uint32_t>(std::ceil(bytesPerBank / (0.9 * budgetPerBank)));
+  if (pieces <= 1) {
+    return collective(input);
+  }
+
+  // Split the dimension with the most units (tiles in the two tiled
+  // dimensions) into `pieces` runs of units.
+  const ::ttnn::Shape &shape = input.logical_shape();
+  const int32_t rank = static_cast<int32_t>(shape.rank());
+  const int32_t skip = collectiveDim < 0 ? collectiveDim + rank : collectiveDim;
+  const bool tiled = input.layout() == ::ttnn::Layout::TILE;
+  const auto tileShape = input.tensor_spec().tile().get_tile_shape();
+  int32_t splitDim = -1;
+  uint32_t unit = 1;
+  uint32_t units = 0;
+  for (int32_t dim = 0; dim < rank; ++dim) {
+    const uint32_t dimUnit =
+        !tiled || dim < rank - 2 ? 1 : tileShape[dim - (rank - 2)];
+    if (dim == skip || shape[dim] % dimUnit != 0 ||
+        shape[dim] / dimUnit <= units) {
+      continue;
+    }
+    splitDim = dim;
+    unit = dimUnit;
+    units = shape[dim] / dimUnit;
+  }
+  if (splitDim < 0 || units < pieces) {
+    return collective(input);
+  }
+
+  const uint32_t unitsPerPiece = (units + pieces - 1) / pieces;
+  ::ttsl::SmallVector<uint32_t> begins(rank, 0);
+  ::ttsl::SmallVector<uint32_t> ends(shape.cbegin(), shape.cend());
+  const ::ttsl::SmallVector<uint32_t> steps(rank, 1);
+  std::vector<::ttnn::Tensor> results;
+  for (uint32_t start = 0; start < units; start += unitsPerPiece) {
+    begins[splitDim] = start * unit;
+    ends[splitDim] = std::min(units, start + unitsPerPiece) * unit;
+    results.push_back(collective(::ttnn::slice(input, begins, ends, steps)));
+  }
+  return ::ttnn::concat(results, splitDim, outputMemoryConfig);
+}
+
 } // namespace tt::runtime::ttnn::utils
