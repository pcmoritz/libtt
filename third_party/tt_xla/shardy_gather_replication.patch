diff --git a/shardy/dialect/sdy/transforms/propagation/op_sharding_rule_registry.cc b/shardy/dialect/sdy/transforms/propagation/op_sharding_rule_registry.cc
--- a/shardy/dialect/sdy/transforms/propagation/op_sharding_rule_registry.cc
+++ b/shardy/dialect/sdy/transforms/propagation/op_sharding_rule_registry.cc
@@ -850,6 +850,13 @@
             dimNums.getStartIndicesBatchingDims(),
             [&](int64_t inputDim, int64_t indicesDim, int64_t slicesDim,
                 int64_t factorSize, FactorType factorType, bool isBlocked) {
+              // Keeping the operand dimension sharded needs indices relative to
+              // each shard, which TT-MLIR only computes for a gather that
+              // indexes just this dimension.
+              if (factorType == FactorType::kReduction &&
+                  dimNums.getStartIndexMap() != ArrayRef<int64_t>{inputDim}) {
+                factorType = FactorType::kNeedReplication;
+              }
               builder.addFactor({inputDim, indicesDim}, slicesDim, factorSize,
                                 factorType, isBlocked);
             });
