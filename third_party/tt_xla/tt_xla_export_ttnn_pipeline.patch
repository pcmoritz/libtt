@@ -1469,6 +1470,50 @@ tt_pjrt_status ModuleBuilder::convertFromTTIRToTTNN(
           : client_instance->computeFabricConfig(devices_mesh_shape);
   options.meshTopology = fabricConfigToMeshTopology(mesh_fabric_for_topology);
 
+  // libtt: export the pipeline's input with the exact pipeline as its first
+  // line (an MLIR comment), so that ttmlir-opt reruns this compile:
+  // ttmlir_opt FILE "$(sed -n '1s#^// ##p' FILE)". The options listed are
+  // those that differ from tt-mlir's defaults (ttmlir-opt's too); some
+  // options' printers do not round-trip, and the plugin leaves those at their
+  // defaults. The tt-lang passes added below only rewrite ttnn.tt_lang_op ops.
+  if (compile_options.export_path.has_value()) {
+    auto printOptions = [](const auto &pipeline_options) {
+      std::string printed;
+      llvm::raw_string_ostream stream(printed);
+      pipeline_options.print(stream);
+      std::replace(printed.begin(), printed.end(), '\n', ' ');
+      return printed;
+    };
+    // `{name=value name=value ...}` -> its options.
+    auto splitOptions = [](llvm::StringRef printed,
+                           llvm::SmallVectorImpl<llvm::StringRef> &split) {
+      printed = printed.trim();
+      printed.consume_front("{");
+      printed.consume_back("}");
+      printed.split(split, ' ', -1, /*KeepEmpty=*/false);
+    };
+    std::string actual = printOptions(options);
+    std::string defaults =
+        printOptions(mlir::tt::ttnn::TTIRToTTNNCommonPipelineOptions());
+    llvm::SmallVector<llvm::StringRef> actual_options, default_options;
+    splitOptions(actual, actual_options);
+    splitOptions(defaults, default_options);
+    llvm::StringMap<llvm::StringRef> default_by_name;
+    for (llvm::StringRef option : default_options) {
+      default_by_name[option.split('=').first] = option;
+    }
+    std::string changed;
+    for (llvm::StringRef option : actual_options) {
+      auto it = default_by_name.find(option.split('=').first);
+      if (it == default_by_name.end() || it->second != option) {
+        changed += (changed.empty() ? "" : " ") + option.str();
+      }
+    }
+    printModule(mlir_module, compile_options.export_path, "ttir_to_ttnn",
+                compile_options.export_model_name,
+                "// --ttir-to-ttnn-common-pipeline=" + changed + "\n");
+  }
+
   // Run the common TTIR-to-TTNN pipeline.
   mlir::tt::ttnn::createTTIRToTTNNCommonPipeline(ttir_to_ttnn_pm, options);
 
