+  // Converts StableHLO batching dimensions into ordinary indexed dimensions.
+  // A batch coordinate is just another component of each scatter index; batch
+  // dimensions are also inserted window dimensions because they have no window
+  // offset. This leaves one canonical, non-batched scatter lowering below.
+  Value materializeBatchingIndices(
+      mlir::stablehlo::ScatterOp op, Value indices,
+      ArrayRef<int64_t> inputBatchingDims,
+      ArrayRef<int64_t> scatterIndicesBatchingDims,
+      SmallVectorImpl<int64_t> &scatterDimsToOperandDims,
+      SmallVectorImpl<int64_t> &insertedWindowDims,
+      PatternRewriter &rewriter) const {
+    auto indicesType = mlir::cast<RankedTensorType>(indices.getType());
+    ArrayRef<int64_t> indicesShape = indicesType.getShape();
+    int64_t indexVectorDim = indicesType.getRank() - 1;
+    SmallVector<int64_t> columnShape(indicesShape);
+    columnShape[indexVectorDim] = 1;
+    auto columnType = RankedTensorType::get(
+        columnShape, indicesType.getElementType(), indicesType.getEncoding());
+
+    SmallVector<std::pair<int64_t, Value>> indexedDimensions;
+    indexedDimensions.reserve(scatterDimsToOperandDims.size() +
+                              inputBatchingDims.size());
+
+    for (auto [column, operandDim] :
+         llvm::enumerate(scatterDimsToOperandDims)) {
+      SmallVector<int32_t> begins(indicesType.getRank(), 0);
+      SmallVector<int32_t> ends(indicesShape.begin(), indicesShape.end());
+      SmallVector<int32_t> steps(indicesType.getRank(), 1);
+      begins[indexVectorDim] = static_cast<int32_t>(column);
+      ends[indexVectorDim] = static_cast<int32_t>(column + 1);
+      Value slice = rewriter.create<ttir::SliceStaticOp>(
+          ttmlir::utils::appendLocationSuffix(
+              op.getLoc(), "_scatter_index_" + std::to_string(operandDim)),
+          columnType, indices, rewriter.getI32ArrayAttr(begins),
+          rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+      indexedDimensions.emplace_back(operandDim, slice);
+    }
+
+    unsigned bitWidth = indicesType.getElementType().getIntOrFloatBitWidth();
+    int64_t numPositions = ttmlir::utils::volume(columnShape);
+    for (auto [inputDim, indicesDim] :
+         llvm::zip_equal(inputBatchingDims, scatterIndicesBatchingDims)) {
+      int64_t stride = 1;
+      for (int64_t dim = indicesDim + 1; dim < indexVectorDim; ++dim) {
+        stride *= indicesShape[dim];
+      }
+      SmallVector<APInt> coordinates;
+      coordinates.reserve(numPositions);
+      for (int64_t linear = 0; linear < numPositions; ++linear) {
+        coordinates.emplace_back(
+            bitWidth, (linear / stride) % indicesShape[indicesDim]);
+      }
+      auto coordinateAttr = DenseIntElementsAttr::get(columnType, coordinates);
+      Value coordinate = rewriter.create<ttir::ConstantOp>(
+          ttmlir::utils::appendLocationSuffix(
+              op.getLoc(), "_batch_index_" + std::to_string(inputDim)),
+          columnType, coordinateAttr);
+      indexedDimensions.emplace_back(inputDim, coordinate);
+    }
+
+    llvm::sort(indexedDimensions,
+               [](const auto &lhs, const auto &rhs) {
+                 return lhs.first < rhs.first;
+               });
+    scatterDimsToOperandDims.clear();
+    SmallVector<Value> columns;
+    columns.reserve(indexedDimensions.size());
+    for (auto [operandDim, column] : indexedDimensions) {
+      scatterDimsToOperandDims.push_back(operandDim);
+      columns.push_back(column);
+    }
+
+    insertedWindowDims.append(inputBatchingDims.begin(),
+                              inputBatchingDims.end());
+    llvm::sort(insertedWindowDims);
+
+    SmallVector<int64_t> canonicalShape(indicesShape);
+    canonicalShape[indexVectorDim] = columns.size();
+    auto canonicalType = indicesType.clone(canonicalShape);
+    return rewriter.create<ttir::ConcatOp>(
+        op.getLoc(), canonicalType, columns,
+        rewriter.getSI32IntegerAttr(indexVectorDim));
+  }
+
