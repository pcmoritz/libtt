+// ConvTranspose2d stores four-sided padding in tt-metal's
+// [top, bottom, left, right] order.
+std::variant<std::array<uint32_t, 2>, std::array<uint32_t, 4>>
+convertConvTranspose2dPadding(llvm::ArrayRef<int32_t> padding) {
+  if (padding.size() == 2) {
+    return conversion::convertLLVMArrayRefToStdArray<uint32_t, 2>(padding);
+  }
+  assert(padding.size() == 4);
+  return conversion::convertLLVMArrayRefToStdArray<uint32_t, 4>(padding);
+}
