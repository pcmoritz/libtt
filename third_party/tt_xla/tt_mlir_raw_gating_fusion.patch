+bool isZeroLike(Value value) {
+  return matchPattern(stripRecurrentViews(value), m_AnyZeroFloat());
+}
+
+Value matchExpandedSigmoidInput(Value value) {
+  auto divide = stripRecurrentViews(value)
+                    .getDefiningOp<::mlir::stablehlo::DivOp>();
+  if (!divide || !isOneLike(divide.getLhs())) {
+    return {};
+  }
+  auto add = divide.getRhs().getDefiningOp<::mlir::stablehlo::AddOp>();
+  if (!add) {
+    return {};
+  }
+  for (auto [one, exponentialValue] :
+       {std::pair{add.getLhs(), add.getRhs()},
+        std::pair{add.getRhs(), add.getLhs()}}) {
+    auto exponential =
+        exponentialValue.getDefiningOp<::mlir::stablehlo::ExpOp>();
+    if (!isOneLike(one) || !exponential) {
+      continue;
+    }
+    auto negate = exponential.getOperand()
+                      .getDefiningOp<::mlir::stablehlo::NegOp>();
+    if (negate) {
+      return negate.getOperand();
+    }
+  }
+  return {};
+}
+
+Value matchStableSoftplusInput(Value value) {
+  auto select = stripRecurrentViews(value)
+                    .getDefiningOp<::mlir::stablehlo::SelectOp>();
+  auto compare = select ? select.getPred()
+                              .getDefiningOp<::mlir::stablehlo::CompareOp>()
+                        : ::mlir::stablehlo::CompareOp();
+  auto nanAdd = select ? select.getOnTrue()
+                             .getDefiningOp<::mlir::stablehlo::AddOp>()
+                       : ::mlir::stablehlo::AddOp();
+  if (!compare || compare.getLhs() != compare.getRhs() || !nanAdd) {
+    return {};
+  }
+  for (auto [input, zero] :
+       {std::pair{nanAdd.getLhs(), nanAdd.getRhs()},
+        std::pair{nanAdd.getRhs(), nanAdd.getLhs()}}) {
+    if (!isZeroLike(zero)) {
+      continue;
+    }
+    auto finiteAdd = select.getOnFalse()
+                         .getDefiningOp<::mlir::stablehlo::AddOp>();
+    if (!finiteAdd) {
+      continue;
+    }
+    for (Value operand : finiteAdd->getOperands()) {
+      auto maximum =
+          operand.getDefiningOp<::mlir::stablehlo::MaxOp>();
+      if (maximum &&
+          ((maximum.getLhs() == input && isZeroLike(maximum.getRhs())) ||
+           (maximum.getRhs() == input && isZeroLike(maximum.getLhs())))) {
+        return input;
+      }
+    }
+  }
+  return {};
+}
+
+struct QwenDecodeGatingMatch {
+  Value betaLogits;
+  Value deltaTime;
+  Value aLog;
+  Value dtBias;
+};
+
+std::optional<QwenDecodeGatingMatch>
+matchDecodeGating(Value beta, Value decay, int64_t batch,
+                  int64_t numHeads) {
+  SmallVector<int64_t> scalarShape = {batch, numHeads};
+  Value betaLogits = matchExpandedSigmoidInput(beta);
+  if (!hasShape(betaLogits, scalarShape)) {
+    return std::nullopt;
+  }
+
+  auto finalExp = stripRecurrentViews(decay)
+                      .getDefiningOp<::mlir::stablehlo::ExpOp>();
+  auto multiply = finalExp ? finalExp.getOperand()
+                                 .getDefiningOp<::mlir::stablehlo::MulOp>()
+                           : ::mlir::stablehlo::MulOp();
+  if (!multiply) {
+    return std::nullopt;
+  }
+  for (auto [aValue, softplusValue] :
+       {std::pair{multiply.getLhs(), multiply.getRhs()},
+        std::pair{multiply.getRhs(), multiply.getLhs()}}) {
+    auto negate = stripRecurrentViews(aValue)
+                      .getDefiningOp<::mlir::stablehlo::NegOp>();
+    auto aExp = negate ? negate.getOperand()
+                            .getDefiningOp<::mlir::stablehlo::ExpOp>()
+                      : ::mlir::stablehlo::ExpOp();
+    Value softplusInput = matchStableSoftplusInput(softplusValue);
+    auto biasAdd = softplusInput
+                       ? softplusInput.getDefiningOp<
+                             ::mlir::stablehlo::AddOp>()
+                       : ::mlir::stablehlo::AddOp();
+    if (!aExp || !biasAdd || !hasShape(aExp.getOperand(), {numHeads})) {
+      continue;
+    }
+    for (auto [deltaTime, biasValue] :
+         {std::pair{biasAdd.getLhs(), biasAdd.getRhs()},
+          std::pair{biasAdd.getRhs(), biasAdd.getLhs()}}) {
+      Value dtBias = stripRecurrentViews(biasValue);
+      if (hasShape(deltaTime, scalarShape) &&
+          hasShape(dtBias, {numHeads})) {
+        return QwenDecodeGatingMatch{betaLogits, deltaTime,
+                                     aExp.getOperand(), dtBias};
+      }
+    }
+  }
+  return std::nullopt;
+}
