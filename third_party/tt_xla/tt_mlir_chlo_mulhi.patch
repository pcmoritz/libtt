+// uint32 chlo.mulhi runs as ttir.mulhi: its decomposition widens to 64 bits,
+// which are narrowed back to 32. Narrower types decompose correctly.
+class ChloMulHiConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CompositeOp> {
+public:
+  using OpConversionPattern<mlir::stablehlo::CompositeOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CompositeOp srcOp,
+                  mlir::stablehlo::CompositeOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (srcOp.getName() != "chlo.mulhi") {
+      return failure();
+    }
+    auto type = mlir::cast<RankedTensorType>(srcOp.getResult(0).getType());
+    if (!type.getElementType().isUnsignedInteger(32)) {
+      return rewriter.notifyMatchFailure(srcOp, "only uint32 is a ttir.mulhi");
+    }
+    rewriter.replaceOpWithNewOp<ttir::MulHiOp>(
+        srcOp, type, adaptor.getOperands()[0], adaptor.getOperands()[1]);
+    return success();
+  }
+};
