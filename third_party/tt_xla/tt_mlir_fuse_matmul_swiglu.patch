+// Fold the decode MLP's concatenated [up | gate] projection and SwiGLU into a
+// single half-width matmul.  The runtime implements this marker with a
+// two-weight matmul that keeps matching up/gate accumulators on the same core.
+class TTNNMatmulWithSwiGLUEpilogue
+    : public mlir::OpRewritePattern<MultiplyOp> {
+public:
+  TTNNMatmulWithSwiGLUEpilogue(mlir::MLIRContext *context)
+      : mlir::OpRewritePattern<MultiplyOp>(context, /*benefit=*/2) {}
+
+  mlir::LogicalResult
+  matchAndRewrite(MultiplyOp multiplyOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    SiluOp lhsSilu = multiplyOp.getLhs().getDefiningOp<SiluOp>();
+    SiluOp rhsSilu = multiplyOp.getRhs().getDefiningOp<SiluOp>();
+    if ((!lhsSilu && !rhsSilu) || (lhsSilu && rhsSilu)) {
+      return failure();
+    }
+
+    SiluOp siluOp = lhsSilu ? lhsSilu : rhsSilu;
+    auto activatedSlice = siluOp.getInput().getDefiningOp<SliceStaticOp>();
+    auto otherSlice = (lhsSilu ? multiplyOp.getRhs() : multiplyOp.getLhs())
+                          .getDefiningOp<SliceStaticOp>();
+    if (!activatedSlice || !otherSlice || !siluOp.getResult().hasOneUse() ||
+        !activatedSlice.getResult().hasOneUse() ||
+        !otherSlice.getResult().hasOneUse()) {
+      return failure();
+    }
+
+    auto matmulOp = activatedSlice.getInput().getDefiningOp<MatmulOp>();
+    if (!matmulOp || otherSlice.getInput() != matmulOp.getResult() ||
+        !matmulOp.getResult().hasNUses(2) || matmulOp.getTransposeA() ||
+        matmulOp.getTransposeB() || matmulOp.getActivation()) {
+      return failure();
+    }
+
+    // The fused TT-Metal kernel takes BF16 activations and output, BFP8
+    // weights, one tile row, and tile-aligned K and halves.
+    auto [tileHeight, tileWidth] = ttcore::TileType::getDefaultShape();
+    auto weightDtype =
+        matmulOp->getAttrOfType<mlir::StringAttr>("ttcore.weight_dtype");
+    auto lhsType = matmulOp.getA().getType();
+    auto outputType = multiplyOp.getType();
+    ArrayRef<int64_t> shape = matmulOp.getType().getShape();
+    int64_t k = lhsType.getShape().back();
+    int64_t half = outputType.getShape().back();
+    if (!weightDtype || weightDtype.getValue() != "bfp_bf8" ||
+        !lhsType.getElementType().isBF16() ||
+        !outputType.getElementType().isBF16() || shape.size() != 2 ||
+        shape[0] > tileHeight || k % tileWidth != 0 || half % tileWidth != 0) {
+      return failure();
+    }
+
+    // The two slices must be exactly the up and gate halves of the output.
+    auto isHalf = [&](SliceStaticOp slice, int64_t begin) {
+      auto values = [](mlir::ArrayAttr attr) {
+        return llvm::cantFail(ttmlir::utils::getIntegerVector<int64_t>(attr));
+      };
+      return values(slice.getBegins()) == SmallVector<int64_t>{0, begin} &&
+             values(slice.getEnds()) ==
+                 SmallVector<int64_t>{shape[0], begin + half} &&
+             values(slice.getStep()) == SmallVector<int64_t>{1, 1};
+    };
+    if (shape[1] != 2 * half || !isHalf(otherSlice, 0) ||
+        !isHalf(activatedSlice, half)) {
+      return failure();
+    }
+
+    mlir::OperationState state(matmulOp.getLoc(), MatmulOp::getOperationName());
+    state.addOperands(matmulOp->getOperands());
+    state.addTypes(outputType);
+    state.addAttributes(matmulOp->getAttrs());
+    mlir::Operation *fused = rewriter.create(state);
+    fused->setAttr("ttnn.fused_swiglu", rewriter.getUnitAttr());
+
+    rewriter.replaceOp(multiplyOp, fused->getResult(0));
+    rewriter.eraseOp(siluOp);
+    rewriter.eraseOp(activatedSlice);
+    rewriter.eraseOp(otherSlice);
+    rewriter.eraseOp(matmulOp);
+    return success();
+  }
+};
+
+// Fold PyTorch's SiluAndMul after a merged [gate | up] projection, as
+// SGLang-TorchTPU's decode MLP runs it on one tile row: silu of the gate half
+// in FP32 cast back to BF16, times the up half. The BF16 projection, a matmul
+// (or a scaled matmul), becomes a half-width one marked ttnn.exact_swiglu,
+// whose decode program epilogue reproduces every rounding of those ops.
+template <typename ProjectionOp>
+class TTNNProjectionWithExactSwiGLU
+    : public mlir::OpRewritePattern<MultiplyOp> {
+public:
+  TTNNProjectionWithExactSwiGLU(mlir::MLIRContext *context)
+      : mlir::OpRewritePattern<MultiplyOp>(context, /*benefit=*/2) {}
+
+  mlir::LogicalResult
+  matchAndRewrite(MultiplyOp multiplyOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    auto elementType = [](Value v) {
+      return mlir::cast<RankedTensorType>(v.getType()).getElementType();
+    };
+    // typecast(silu(typecast(slice))) to BF16 by way of an FP32 silu, each
+    // op used once; the gate slice last.
+    auto siluOfSlice = [&](Value v) -> SmallVector<Operation *> {
+      auto narrow = v.getDefiningOp<TypecastOp>();
+      auto silu = narrow ? narrow.getInput().getDefiningOp<SiluOp>() : nullptr;
+      auto widen = silu ? silu.getInput().getDefiningOp<TypecastOp>() : nullptr;
+      auto gate =
+          widen ? widen.getInput().getDefiningOp<SliceStaticOp>() : nullptr;
+      SmallVector<Operation *> chain = {narrow, silu, widen, gate};
+      if (!gate || !elementType(silu.getResult()).isF32() ||
+          !elementType(narrow.getResult()).isBF16() ||
+          !llvm::all_of(chain, [](Operation *op) {
+            return op->getResult(0).hasOneUse();
+          })) {
+        return {};
+      }
+      return chain;
+    };
+    SmallVector<Operation *> chain = siluOfSlice(multiplyOp.getLhs());
+    Value other = multiplyOp.getRhs();
+    if (chain.empty()) {
+      chain = siluOfSlice(multiplyOp.getRhs());
+      other = multiplyOp.getLhs();
+    }
+    auto up = other.getDefiningOp<SliceStaticOp>();
+    auto gate =
+        chain.empty() ? nullptr : mlir::cast<SliceStaticOp>(chain.back());
+    auto projection =
+        gate ? gate.getInput().getDefiningOp<ProjectionOp>() : nullptr;
+    if (!projection || !up || up.getInput() != projection.getResult() ||
+        !up.getResult().hasOneUse() || !projection.getResult().hasNUses(2) ||
+        projection->hasAttr("ttnn.fused_swiglu") ||
+        !multiplyOp.getActivations().empty() ||
+        !multiplyOp.getInputTensorAActivations().empty() ||
+        !multiplyOp.getInputTensorBActivations().empty()) {
+      return failure();
+    }
+    if constexpr (std::is_same_v<ProjectionOp, MatmulOp>) {
+      if (projection.getTransposeA() || projection.getActivation() ||
+          projection.getMatmulProgramConfigAttr() ||
+          projection->hasAttr("ttcore.fp32_exact")) {
+        return failure();
+      }
+    }
+    // A BF16 [M <= 32, 2 * half] product, K and the halves whole tiles.
+    auto [tileHeight, tileWidth] = ttcore::TileType::getDefaultShape();
+    RankedTensorType type = projection.getType();
+    ArrayRef<int64_t> shape = type.getShape();
+    const int64_t half = shape.back() / 2;
+    const int64_t k =
+        mlir::cast<RankedTensorType>(projection->getOperand(0).getType())
+            .getShape()
+            .back();
+    auto isHalf = [&](SliceStaticOp slice, int64_t begin) {
+      auto values = [](mlir::ArrayAttr attr) {
+        return llvm::cantFail(ttmlir::utils::getIntegerVector<int64_t>(attr));
+      };
+      return values(slice.getBegins()) == SmallVector<int64_t>{0, begin} &&
+             values(slice.getEnds()) ==
+                 SmallVector<int64_t>{shape[0], begin + half} &&
+             values(slice.getStep()) == SmallVector<int64_t>{1, 1};
+    };
+    if (shape.size() != 2 || !type.getElementType().isBF16() ||
+        !multiplyOp.getType().getElementType().isBF16() ||
+        shape[0] > tileHeight || half % tileWidth != 0 || k % tileWidth != 0 ||
+        !isHalf(gate, 0) || !isHalf(up, half)) {
+      return failure();
+    }
+
+    mlir::Operation *fused = rewriter.clone(*projection);
+    fused->getResult(0).setType(multiplyOp.getType());
+    fused->setAttr("ttnn.fused_swiglu", rewriter.getUnitAttr());
+    fused->setAttr("ttnn.exact_swiglu", rewriter.getUnitAttr());
+    rewriter.replaceOp(multiplyOp, fused->getResult(0));
+    for (Operation *op : chain) {
+      rewriter.eraseOp(op);
+    }
+    rewriter.eraseOp(up);
+    rewriter.eraseOp(projection);
+    return success();
+  }
+};
