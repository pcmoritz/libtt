+namespace {
+class StableHLOToTTIRBitcastConvertOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::BitcastConvertOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::BitcastConvertOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::BitcastConvertOp srcOp,
+                  mlir::stablehlo::BitcastConvertOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto inputType = mlir::cast<RankedTensorType>(srcOp.getOperand().getType());
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    Type inputElementType = inputType.getElementType();
+    Type outputElementType = outputType.getElementType();
+
+    if (inputType == outputType) {
+      rewriter.replaceOp(srcOp, adaptor.getOperand());
+      return success();
+    }
+
+    unsigned inputWidth = inputElementType.getIntOrFloatBitWidth();
+    unsigned outputWidth = outputElementType.getIntOrFloatBitWidth();
+    if (inputWidth == outputWidth) {
+      rewriter.replaceOpWithNewOp<ttir::BitcastConvertOp>(
+          srcOp, outputType, adaptor.getOperand());
+      return success();
+    }
+
+    auto inputIntegerType = mlir::dyn_cast<IntegerType>(inputElementType);
+    if (!inputIntegerType || !outputElementType.isF16() ||
+        (inputWidth != 4 && inputWidth != 8)) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "shape-changing bitcast is only supported from i4/i8 to f16");
+    }
+
+    ArrayRef<int64_t> inputShape = inputType.getShape();
+    ArrayRef<int64_t> outputShape = outputType.getShape();
+    unsigned lanes = outputWidth / inputWidth;
+    if (inputShape.empty() || inputShape.back() != lanes ||
+        inputShape.drop_back() != outputShape) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "input shape does not match StableHLO bit-packing semantics");
+    }
+
+    Location loc = srcOp.getLoc();
+    auto inputI32Type = RankedTensorType::get(inputShape, rewriter.getI32Type());
+    Value inputI32 = rewriter.create<ttir::TypecastOp>(
+        loc, inputI32Type, adaptor.getOperand());
+    auto packedType =
+        RankedTensorType::get(outputShape, rewriter.getI32Type());
+
+    auto full = [&](int32_t value) {
+      return rewriter.create<ttir::FullOp>(
+          loc, packedType, rewriter.getI32IntegerAttr(value));
+    };
+
+    Value packed;
+    for (unsigned lane = 0; lane < lanes; ++lane) {
+      SmallVector<int32_t> begins(inputShape.size(), 0);
+      SmallVector<int32_t> ends(inputShape.begin(), inputShape.end());
+      SmallVector<int32_t> steps(inputShape.size(), 1);
+      begins.back() = lane;
+      ends.back() = lane + 1;
+
+      SmallVector<int64_t> sliceShape(inputShape.begin(), inputShape.end());
+      sliceShape.back() = 1;
+      auto sliceType =
+          RankedTensorType::get(sliceShape, rewriter.getI32Type());
+      Value value = rewriter.create<ttir::SliceStaticOp>(
+          loc, sliceType, inputI32, rewriter.getI32ArrayAttr(begins),
+          rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+      value = rewriter.create<ttir::ReshapeOp>(
+          loc, packedType, value,
+          rewriter.getI32ArrayAttr(
+              llvm::to_vector_of<int32_t>(outputShape)));
+      value =
+          rewriter.create<ttir::BitwiseAndOp>(loc, packedType, value,
+                                               full((1 << inputWidth) - 1));
+
+      if (lane != 0) {
+        value = rewriter.create<ttir::LogicalLeftShiftOp>(
+            loc, packedType, value, full(lane * inputWidth));
+      }
+      packed = packed ? rewriter.create<ttir::BitwiseOrOp>(
+                            loc, packedType, packed, value)
+                      : value;
+    }
+
+    auto bitsType = RankedTensorType::get(
+        outputShape,
+        IntegerType::get(rewriter.getContext(), 16, IntegerType::Unsigned));
+    Value bits =
+        rewriter.create<ttir::TypecastOp>(loc, bitsType, packed);
+    rewriter.replaceOpWithNewOp<ttir::BitcastConvertOp>(srcOp, outputType,
+                                                        bits);
+    return success();
+  }
+};
+} // namespace
+
