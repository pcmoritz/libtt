+// An FP32 add, subtract, multiply or divide whose only use casts it to BF16
+// produces BF16 itself: binary_ng computes in FP32 DST whenever an operand is
+// FP32 and rounds once as it packs the result, which saves the typecast
+// program. (The packer rounds exact ties away from zero where the typecast
+// rounds them to even.)
+class TTNNBinaryOpNarrowingOutput : public mlir::OpRewritePattern<TypecastOp> {
+public:
+  using mlir::OpRewritePattern<TypecastOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(TypecastOp cast,
+                  mlir::PatternRewriter &rewriter) const final {
+    Operation *producer = cast.getInput().getDefiningOp();
+    if (!producer || !isa<AddOp, SubtractOp, MultiplyOp, DivideOp>(producer) ||
+        !cast.getInput().hasOneUse()) {
+      return failure();
+    }
+    auto elementType = [](Value v) {
+      return mlir::cast<mlir::RankedTensorType>(v.getType()).getElementType();
+    };
+    if (!elementType(cast.getInput()).isF32() || !elementType(cast.getResult()).isBF16() ||
+        !llvm::all_of(producer->getOperands(), [&](Value v) {
+          return elementType(v).isF32() || elementType(v).isBF16();
+        })) {
+      return failure();
+    }
+    rewriter.modifyOpInPlace(producer, [&]() {
+      producer->getResult(0).setType(cast.getResult().getType());
+    });
+    rewriter.replaceOp(cast, producer->getResult(0));
+    return success();
+  }
+};
+
