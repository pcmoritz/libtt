+std::optional<tt::runtime::Device> ClientInstance::getOrCreateSubMesh(
+    const std::vector<uint32_t> &target_mesh_shape,
+    const std::unordered_set<int> &device_ids) {
+  const uint32_t num_chips = static_cast<uint32_t>(m_devices.size());
+  if (m_compile_only || target_mesh_shape.size() != 2) {
+    return std::nullopt;
+  }
+  const uint32_t rows = target_mesh_shape[0];
+  const uint32_t cols = target_mesh_shape[1];
+  // Programs over every chip run on the mesh itself until one over some of
+  // them comes along.
+  if (rows * cols <= 1 || rows * cols > num_chips ||
+      (rows * cols == num_chips && !m_root_mesh.has_value())) {
+    return std::nullopt;
+  }
+
+  // From then on every program runs on a submesh of a root mesh that runs
+  // nothing itself, so a submesh never takes over chips holding the device
+  // state of programs run on another mesh: opening the root drops what
+  // earlier programs left, and releasing a submesh drops what it left.
+  auto holds = [&](const std::vector<uint32_t> &shape) {
+    return shape.size() == 2 && shape[0] * shape[1] == num_chips &&
+           rows <= shape[0] && cols <= shape[1];
+  };
+  if (!m_root_mesh.has_value() ||
+      !holds(tt::runtime::getMeshShape(*m_root_mesh))) {
+    std::vector<uint32_t> root_shape = {1, num_chips};
+    if (!holds(root_shape) && num_chips % rows == 0) {
+      root_shape = {rows, num_chips / rows};
+    }
+    if (!holds(root_shape)) {
+      return std::nullopt;
+    }
+    TensorPool::move_tensors_to_host();
+    closeParentMesh();
+    m_root_mesh = openMeshDevice(root_shape);
+    m_parent_mesh = m_root_mesh;
+  }
+
+  // Chips are numbered row-major over the root mesh. Place the submesh on the
+  // inputs' chips when they form a block, else at the origin.
+  const std::vector<uint32_t> root_shape =
+      tt::runtime::getMeshShape(*m_root_mesh);
+  std::vector<uint32_t> offset = {0, 0};
+  if (!device_ids.empty()) {
+    const int first = *std::min_element(device_ids.begin(), device_ids.end());
+    const uint32_t row = first / root_shape[1];
+    const uint32_t col = first % root_shape[1];
+    bool block = device_ids.size() == rows * cols &&
+                 row + rows <= root_shape[0] && col + cols <= root_shape[1];
+    for (uint32_t r = 0; block && r < rows; ++r) {
+      for (uint32_t c = 0; block && c < cols; ++c) {
+        block = device_ids.count((row + r) * root_shape[1] + col + c) > 0;
+      }
+    }
+    if (block) {
+      offset = {row, col};
+    }
+  }
+
+  auto placement = std::make_pair(target_mesh_shape, offset);
+  if (m_submesh_placement == placement) {
+    return *m_parent_mesh;
+  }
+  DLOG_F(LOG_DEBUG,
+         "ClientInstance::getOrCreateSubMesh - submesh %s at %s of %s",
+         utils::to_string(target_mesh_shape).c_str(),
+         utils::to_string(offset).c_str(),
+         utils::to_string(root_shape).c_str());
+  // Device tensors belong to the mesh they were made on.
+  TensorPool::move_tensors_to_host();
+  releaseSubMesh();
+  m_parent_mesh =
+      tt::runtime::createSubMeshDevice(*m_root_mesh, target_mesh_shape, offset);
+  m_submesh_placement = placement;
+  return *m_parent_mesh;
+}
+
+void ClientInstance::releaseSubMesh() {
+  if (m_submesh_placement.has_value()) {
+    tt::runtime::releaseSubMeshDevice(*m_parent_mesh);
+    m_parent_mesh = m_root_mesh;
+    m_submesh_placement.reset();
+  }
+}
+
 void ClientInstance::closeParentMesh() {
+  releaseSubMesh();
+  m_root_mesh.reset();
   if (m_parent_mesh.has_value()) {
     DLOG_F(LOG_DEBUG, "Closing parent mesh.");
     tt::runtime::closeMeshDevice(*m_parent_mesh);
