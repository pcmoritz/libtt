diff --git a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
--- a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
+++ b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
@@ -876,10 +876,30 @@ public:
   LogicalResult
   matchAndRewrite(TTIROpTy op, OpAdaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
+    auto outputType = mlir::cast<RankedTensorType>(
+        this->getTypeConverter()->convertType(op.getType()));
+    auto inputType = mlir::cast<RankedTensorType>(adaptor.getInput().getType());
+    auto inputIntegerType = dyn_cast<IntegerType>(inputType.getElementType());
+    if (inputIntegerType && inputIntegerType.isUnsigned() &&
+        inputIntegerType.getWidth() == 8) {
+      // tt-metal's sliced row-major path does not preserve UInt8 values.
+      // Promote around the slice until the native path supports the dtype.
+      auto promotedInputType = ttnn::utils::RankedTensorTypeFactory::create(
+          inputType, ttcore::DataType::UInt32);
+      auto promotedOutputType = ttnn::utils::RankedTensorTypeFactory::create(
+          outputType, ttcore::DataType::UInt32);
+      auto promotedInput = rewriter.create<ttnn::TypecastOp>(
+          op.getLoc(), promotedInputType, adaptor.getInput());
+      auto sliced = rewriter.create<TTNNOpTy>(
+          op.getLoc(), promotedOutputType, promotedInput, adaptor.getBegins(),
+          adaptor.getEnds(), adaptor.getStepAttr());
+      rewriter.replaceOpWithNewOp<ttnn::TypecastOp>(op, outputType, sliced);
+      return success();
+    }
+
     rewriter.replaceOpWithNewOp<TTNNOpTy>(
-        op, this->getTypeConverter()->convertType(op.getType()),
-        adaptor.getInput(), adaptor.getBegins(), adaptor.getEnds(),
-        adaptor.getStepAttr());
+        op, outputType, adaptor.getInput(), adaptor.getBegins(),
+        adaptor.getEnds(), adaptor.getStepAttr());
     return success();
   }
 };
@@ -3168,9 +3188,37 @@ public:
   LogicalResult
   matchAndRewrite(ttir::PermuteOp op, OpAdaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
+    auto outputType = mlir::cast<RankedTensorType>(
+        this->getTypeConverter()->convertType(op.getType()));
+    auto inputType = mlir::cast<RankedTensorType>(adaptor.getInput().getType());
+    auto inputIntegerType = dyn_cast<IntegerType>(inputType.getElementType());
+    ArrayRef<int64_t> permutation = op.getPermutation();
+    int64_t rank = inputType.getRank();
+
+    // tt-metal's generic permute path cannot preserve UInt8 values when the
+    // output width comes from an outer dimension. Promote just that path; the
+    // tile-invariant UInt8 paths remain native.
+    bool usesGenericPermute =
+        rank >= 2 && permutation.back() != rank - 1 &&
+        permutation.back() != rank - 2;
+    if (inputIntegerType && inputIntegerType.isUnsigned() &&
+        inputIntegerType.getWidth() == 8 && usesGenericPermute) {
+      auto promotedInputType = ttnn::utils::RankedTensorTypeFactory::create(
+          inputType, ttcore::DataType::UInt32);
+      auto promotedOutputType = ttnn::utils::RankedTensorTypeFactory::create(
+          outputType, ttcore::DataType::UInt32);
+      auto promotedInput = rewriter.create<ttnn::TypecastOp>(
+          op.getLoc(), promotedInputType, adaptor.getInput());
+      auto permuted = rewriter.create<ttnn::PermuteOp>(
+          op.getLoc(), promotedOutputType, promotedInput,
+          adaptor.getPermutationAttr(), mlir::FloatAttr());
+      rewriter.replaceOpWithNewOp<ttnn::TypecastOp>(op, outputType, permuted);
+      return success();
+    }
+
     rewriter.replaceOpWithNewOp<ttnn::PermuteOp>(
-        op, this->getTypeConverter()->convertType(op.getType()),
-        adaptor.getInput(), adaptor.getPermutationAttr(), mlir::FloatAttr());
+        op, outputType, adaptor.getInput(), adaptor.getPermutationAttr(),
+        mlir::FloatAttr());
 
     return success();
   }
