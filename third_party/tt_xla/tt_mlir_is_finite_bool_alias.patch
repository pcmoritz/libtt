+                                         const auto &subCoreGrids) {
+      ::ttnn::Tensor result = ::ttnn::isfinite(
+          input, memoryConfig, /*optional_output_tensor=*/std::nullopt,
+          subCoreGrids);
+      // TTNN predicates preserve their input dtype, but TTIR i1 tensors use
+      // BFLOAT16 as their runtime storage alias. Normalize the numeric 0/1
