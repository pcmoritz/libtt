+      if (result.dtype() == ::ttnn::DataType::BFLOAT16) {
+        return result;
+      }
+      return ::ttnn::typecast(result, ::ttnn::DataType::BFLOAT16,
+                              memoryConfig, outputTensor, subCoreGrids);
+    });
     break;
   }
