diff --git a/runtime/lib/ttnn/operations/eltwise/unary/unary.cpp b/runtime/lib/ttnn/operations/eltwise/unary/unary.cpp
--- a/runtime/lib/ttnn/operations/eltwise/unary/unary.cpp
