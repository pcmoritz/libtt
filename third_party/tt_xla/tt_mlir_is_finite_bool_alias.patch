@@ -168,7 +168,22 @@ void run(const ::tt::target::ttnn::EltwiseUnaryOp *op,
     break;
   }
   case ::tt::target::ttnn::EltwiseUnaryOpType::IsFinite: {
-    runEltwiseUnaryOp(op, tensorPool, ::ttnn::isfinite);
+    runEltwiseUnaryOp(op, tensorPool, [](const ::ttnn::Tensor &input,
+                                         const auto &memoryConfig,
