+struct ConvolutionInputDilationPattern
+    : public ConvolutionDecompositionPattern {
+  ConvolutionInputDilationPattern(TypeConverter &typeConverter,
+                                  MLIRContext *ctx)
+      : ConvolutionDecompositionPattern(typeConverter, ctx,
+                                        PatternBenefit(2)) {
+    setHasBoundedRewriteRecursion();
+  }
+
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConvolutionOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (!isSupportedConv(op) || !isNDimensional(op, 2)) {
+      return failure();
+    }
+
+    auto lhsDilation =
+        getI64ArrayOrDefault(adaptor.getLhsDilationAttr(), 2, 1);
+    auto windowStrides =
+        getI64ArrayOrDefault(adaptor.getWindowStridesAttr(), 2, 1);
+    bool hasInputDilation =
+        llvm::any_of(lhsDilation, [](int64_t value) { return value > 1; });
+    bool hasWindowStride =
+        llvm::any_of(windowStrides, [](int64_t value) { return value > 1; });
+    if (!hasInputDilation || !hasWindowStride) {
+      return failure();
+    }
+
+    Value input = adaptor.getLhs();
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    if (inputType.getNumElements() == 0) {
+      return failure();
+    }
+    SmallVector<int64_t> interiorPadding(inputType.getRank(), 0);
+    for (auto [dim, dilation] : llvm::zip_equal(
+             adaptor.getDimensionNumbers().getInputSpatialDimensions(),
+             lhsDilation)) {
+      interiorPadding[dim] = dilation - 1;
+    }
+
+    Type elementType = inputType.getElementType();
+    auto zeroType = RankedTensorType::get({}, elementType);
+    auto zeroAttr = DenseElementsAttr::get(
+        zeroType, rewriter.getZeroAttr(elementType));
+    Value zero = rewriter.create<ttir::ConstantOp>(op.getLoc(), zeroType,
+                                                    zeroAttr);
+    SmallVector<int64_t> edgePadding(inputType.getRank(), 0);
+    Value padded = mlir::stablehlo::PadOp::create(
+        rewriter, op.getLoc(), input, zero, edgePadding, edgePadding,
+        interiorPadding);
+
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(op.getType()));
+    rewriter.replaceOpWithNewOp<mlir::stablehlo::ConvolutionOp>(
+        op, resultType, padded, adaptor.getRhs(),
+        adaptor.getWindowStridesAttr(), adaptor.getPaddingAttr(),
+        rewriter.getDenseI64ArrayAttr({1, 1}), adaptor.getRhsDilationAttr(),
+        adaptor.getWindowReversalAttr(), adaptor.getDimensionNumbers(),
+        adaptor.getFeatureGroupCount(), adaptor.getBatchGroupCount(),
+        op.getPrecisionConfigAttr());
+    return success();
+  }
+};
+} // namespace
