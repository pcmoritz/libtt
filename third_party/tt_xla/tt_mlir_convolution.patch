+struct Convolution0DToDotGeneralPattern
+    : public ConvolutionDecompositionPattern {
+  using ConvolutionDecompositionPattern::ConvolutionDecompositionPattern;
+
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConvolutionOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (!isSupportedConv(op) || !isNDimensional(op, 0)) {
+      return failure();
+    }
+
+    const auto &dims = adaptor.getDimensionNumbers();
+    if (dims.getInputBatchDimension() != 0 ||
+        dims.getInputFeatureDimension() != 1 ||
+        (adaptor.getBatchGroupCount() != 1 &&
+         adaptor.getFeatureGroupCount() != 1)) {
+      return failure();
+    }
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(op.getType()));
+    Type computeElementType = getComputeElementType(resultType, rewriter);
+    Value lhs = castToElementType(rewriter, op.getLoc(), adaptor.getLhs(),
+                                  computeElementType);
+    Value rhs = castToElementType(rewriter, op.getLoc(), adaptor.getRhs(),
+                                  computeElementType);
+
+    SmallVector<int64_t> outputShape{
+        resultType.getShape()[dims.getOutputBatchDimension()],
+        resultType.getShape()[dims.getOutputFeatureDimension()]};
+    SmallVector<int64_t> lhsContractingDims{1};
+    SmallVector<int64_t> noBatchDims;
+    Value result;
+    int64_t groupCount = std::max(adaptor.getBatchGroupCount(),
+                                  adaptor.getFeatureGroupCount());
+    if (groupCount == 1) {
+      SmallVector<int64_t> rhsContractingDims{
+          dims.getKernelInputFeatureDimension()};
+      auto dotType = RankedTensorType::get(
+          outputShape, computeElementType, resultType.getEncoding());
+      result = rewriter.create<ttir::DotGeneralOp>(
+          op.getLoc(), dotType, lhs, rhs, noBatchDims, lhsContractingDims,
+          noBatchDims, rhsContractingDims);
+    } else {
+      auto rhsType = mlir::cast<RankedTensorType>(rhs.getType());
+      if (dims.getKernelOutputFeatureDimension() != 0) {
+        rhs = rewriter.create<ttir::PermuteOp>(
+            op.getLoc(),
+            rhsType.clone({rhsType.getShape()[1], rhsType.getShape()[0]}), rhs,
+            SmallVector<int64_t>{1, 0});
+        rhsType = mlir::cast<RankedTensorType>(rhs.getType());
+      }
+      int64_t batch = outputShape[0];
+      int64_t inputFeatures = rhsType.getShape()[1];
+      int64_t outputFeaturesPerGroup = outputShape[1] / groupCount;
+      bool featureGrouped = adaptor.getFeatureGroupCount() > 1;
+      lhs = ttir::utils::createReshapeOp(
+          rewriter, op.getLoc(), lhs,
+          {featureGrouped ? batch : groupCount,
+           featureGrouped ? groupCount : batch, inputFeatures});
+
+      SmallVector<int64_t> rhsShape{groupCount, outputFeaturesPerGroup,
+                                    inputFeatures};
+      rhs = ttir::utils::createReshapeOp(rewriter, op.getLoc(), rhs,
+                                          rhsShape);
+      SmallVector<int64_t> lhsBatchDims{featureGrouped ? 1 : 0};
+      SmallVector<int64_t> rhsBatchDims{0};
+      SmallVector<int64_t> groupedContractingDims{2};
+      auto dotType = RankedTensorType::get(
+          {groupCount, batch, outputFeaturesPerGroup}, computeElementType,
+          resultType.getEncoding());
+      result = rewriter.create<ttir::DotGeneralOp>(
+          op.getLoc(), dotType, lhs, rhs, lhsBatchDims,
+          groupedContractingDims, rhsBatchDims, groupedContractingDims);
+      result = rewriter.create<ttir::PermuteOp>(
+          op.getLoc(),
+          RankedTensorType::get({batch, groupCount, outputFeaturesPerGroup},
+                                computeElementType,
+                                resultType.getEncoding()),
+          result, SmallVector<int64_t>{1, 0, 2});
+      result = ttir::utils::createReshapeOp(rewriter, op.getLoc(), result,
+                                             outputShape);
+    }
+
+    if (dims.getOutputBatchDimension() != 0) {
+      result = rewriter.create<ttir::PermuteOp>(
+          op.getLoc(), resultType.clone(computeElementType), result,
+          SmallVector<int64_t>{1, 0});
+    }
+    rewriter.replaceOp(
+        op, castToElementType(rewriter, op.getLoc(), result,
+                              resultType.getElementType()));
+    return success();
+  }
+};
