+// Shifts of 8- and 16-bit integers. TTNN shifts these as Int32, and narrowing
+// the Int32 result saturated rather than wrapped (a left shift of UInt16 gave
+// 65535), a logical right shift of a negative narrow value shifted in the
+// Int32 sign bits, and an arithmetic right shift of an unsigned narrow value
+// did not treat its top bit as the sign. Compute in Int32 with the narrow
+// width's semantics explicitly, so the result is in range before narrowing.
+template <typename SrcOp>
+class StableHLOToTTIRNarrowShiftOpConversionPattern
+    : public OpConversionPattern<SrcOp> {
+  using OpConversionPattern<SrcOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(SrcOp srcOp, typename SrcOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto type = mlir::cast<RankedTensorType>(
+        this->getTypeConverter()->convertType(srcOp.getType()));
+    auto integerType = mlir::dyn_cast<IntegerType>(type.getElementType());
+    if (!integerType || integerType.getWidth() >= 32 ||
+        integerType.getWidth() == 1) {
+      return rewriter.notifyMatchFailure(srcOp, "not a narrow integer shift");
+    }
+    const unsigned width = integerType.getWidth();
+    const bool isUnsigned = integerType.isUnsigned();
+    Location loc = srcOp.getLoc();
+    auto wideType = type.clone(rewriter.getIntegerType(32, /*isSigned=*/true));
+    auto constant = [&](int64_t value) -> Value {
+      return rewriter.create<ttir::ConstantOp>(
+          loc, wideType,
+          DenseElementsAttr::get(
+              wideType, rewriter.getIntegerAttr(wideType.getElementType(),
+                                                value)));
+    };
+    const int64_t mask = (int64_t{1} << width) - 1;
+    const int64_t signBit = int64_t{1} << (width - 1);
+    auto zeroExtend = [&](Value value) -> Value {
+      return rewriter.create<ttir::BitwiseAndOp>(loc, wideType, value,
+                                                 constant(mask));
+    };
+    auto signExtend = [&](Value value) -> Value {
+      Value flipped = rewriter.create<ttir::BitwiseXorOp>(
+          loc, wideType, zeroExtend(value), constant(signBit));
+      return rewriter.create<ttir::SubtractOp>(loc, wideType, flipped,
+                                               constant(signBit));
+    };
+
+    // Conservative folding keeps these widening casts from merging with
+    // neighbouring casts (e.g. of a UInt8 arange, which TTNN cannot create).
+    Value x = rewriter.create<ttir::TypecastOp>(loc, wideType, adaptor.getLhs(),
+                                                /*conservative_folding=*/true);
+    // Amounts are unsigned; any amount of at least the width behaves like 31.
+    Value amount = rewriter.create<ttir::MinimumOp>(
+        loc, wideType,
+        zeroExtend(
+            rewriter.create<ttir::TypecastOp>(loc, wideType, adaptor.getRhs(),
+                                              /*conservative_folding=*/true)),
+        constant(31));
+
+    Value result;
+    if constexpr (std::is_same_v<SrcOp, mlir::stablehlo::ShiftLeftOp>) {
+      result = rewriter.create<ttir::LogicalLeftShiftOp>(loc, wideType, x,
+                                                          amount);
+    } else if constexpr (std::is_same_v<SrcOp,
+                                        mlir::stablehlo::ShiftRightLogicalOp>) {
+      result = rewriter.create<ttir::LogicalRightShiftOp>(
+          loc, wideType, zeroExtend(x), amount);
+    } else {
+      result = rewriter.create<ttir::RightShiftOp>(loc, wideType,
+                                                    signExtend(x), amount);
+    }
+    result = isUnsigned ? zeroExtend(result) : signExtend(result);
+    rewriter.replaceOpWithNewOp<ttir::TypecastOp>(srcOp, type, result,
+                                                  /*conservative_folding=*/true);
+    return success();
+  }
+};
