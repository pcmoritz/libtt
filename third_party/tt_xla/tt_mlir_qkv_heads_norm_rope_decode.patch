+def TTNN_NLPCreateQKVHeadsDecodeNormRopeOp : TTNN_Op<"nlp_create_qkv_heads_decode_norm_rope", [OpModelExempt]> {
+  let summary = "Decode QKV heads with q and k RMS norms and rotary embedding in one program";
+  let description = [{
+    nlp_create_qkv_heads_decode of an interleaved fused QKV projection
+    [1, 1, B, (num_heads + 2 * num_kv_heads) * head_dim], followed by
+    rms_norm of every q and k head and by rotary_embedding of both with
+    token_index 0 (row 0 of cos_cache and sin_cache for every head).
+    norm_weight [num_heads + num_kv_heads, head_dim] holds a weight row per
+    head: q head h uses row h, k head h row num_heads + h. The results are
+    those of nlp_create_qkv_heads_decode: q and k after the norm and rotary,
+    and v.
+
+    A nonzero rotary_dim below head_dim rotates only the first rotary_dim
+    elements of each head, with cos and sin rows of rotary_dim; the rest pass
+    through normalized. With gated_query, each q head of the input is
+    followed by an output gate head of head_dim, which is not read: the
+    input is [1, 1, B, (2 * num_heads + 2 * num_kv_heads) * head_dim].
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$norm_weight,
+                       AnyRankedTensor:$cos_cache,
+                       AnyRankedTensor:$sin_cache,
+                       UI32Attr:$num_heads,
+                       UI32Attr:$num_kv_heads,
+                       F32Attr:$epsilon,
+                       DefaultValuedAttr<UI32Attr, "0">:$rotary_dim,
+                       DefaultValuedAttr<BoolAttr, "false">:$gated_query);
+
+  let results = (outs AnyRankedTensor:$query,
+                      AnyRankedTensor:$key,
+                      AnyRankedTensor:$value);
+}
