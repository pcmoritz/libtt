+                                       /*local_shape*/ std::nullopt);
+  };
+  return ::tt::target::ttnn::CreateNLPCreateQKVHeadsDecodeNormRopeOp(
+      *cache.fbb, tensor(op.getInput()), tensor(op.getNormWeight()),
+      tensor(op.getCosCache()),
+      tensor(op.getSinCache()), output(op.getQuery()), output(op.getKey()),
+      output(op.getValue()), op.getNumHeads(), op.getNumKvHeads(),
+      op.getEpsilon().convertToFloat(), op.getRotaryDim(), op.getGatedQuery());
