+// libtt: the enclosing loops an accumulator in DST can span: those inside
+// the DST acquire covering `op` (a loop that acquires DST per iteration, e.g.
+// over the rows of a core's block, starts a new accumulator each time), and
+// blocking reduction loops.
+static SmallVector<Operation *> getAccumulationLoops(Operation *op) {
+  Operation *acquire = nullptr;
+  for (Operation *anc = op; anc && !acquire; anc = anc->getParentOp()) {
+    for (Operation *prev = anc->getPrevNode(); prev;
+         prev = prev->getPrevNode()) {
+      if (isa<d2m::AcquireDstOp, ttkernel::TileRegsAcquireOp>(prev)) {
+        acquire = prev;
+        break;
+      }
+    }
+  }
+  SmallVector<Operation *> loops;
+  for (Operation *loop : getEnclosingLoops(op)) {
+    if (!acquire || !loop->isAncestor(acquire) ||
+        loop->hasAttr("d2m.reduction_loop")) {
+      loops.push_back(loop);
+    }
+  }
+  return loops;
+}
