+// libtt: true on the last iteration of every enclosing loop that does not
+// index the accumulator (the reduction loops); a null Value when there are
+// none. Fails unless those loops have constant bounds and steps.
+static FailureOr<Value> buildLastReductionIterationGuard(OpBuilder &rewriter,
+                                                         Location loc,
+                                                         Operation *op,
+                                                         Value dstIndex) {
+  Value guard;
+  for (Operation *loop : getAccumulationLoops(op)) {
+    Value loopIV = getSingleBlockLoopIV(loop);
+    if (!loopIV || valueDependsOn(dstIndex, loopIV)) {
+      continue;
+    }
+    std::optional<int64_t> lb, ub, step;
+    if (auto affineFor = dyn_cast<affine::AffineForOp>(loop)) {
+      if (affineFor.hasConstantBounds()) {
+        lb = affineFor.getConstantLowerBound();
+        ub = affineFor.getConstantUpperBound();
+        step = affineFor.getStepAsInt();
+      }
+    } else if (auto scfFor = dyn_cast<scf::ForOp>(loop)) {
+      lb = getConstantIntValue(scfFor.getLowerBound());
+      ub = getConstantIntValue(scfFor.getUpperBound());
+      step = getConstantIntValue(scfFor.getStep());
+    }
+    if (!lb || !ub || !step || *step <= 0 || *ub <= *lb) {
+      return failure();
+    }
+    int64_t last = *lb + ((*ub - *lb - 1) / *step) * *step;
+    Value lastValue = rewriter.create<arith::ConstantIndexOp>(loc, last);
+    Value isLast = rewriter.create<arith::CmpIOp>(
+        loc, arith::CmpIPredicate::eq, loopIV, lastValue);
+    guard = guard ? rewriter.create<arith::AndIOp>(loc, guard, isLast)
+                        .getResult()
+                  : isLast;
+  }
+  return guard;
+}
