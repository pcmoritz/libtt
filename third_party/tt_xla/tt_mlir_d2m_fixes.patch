+// The accumulator mode is kernel-wide, even when individual DST allocations
+// retain a narrower logical type. Match D2MToTTNN's CB-based mode selection.
+static bool kernelUses32BitCB(Operation *op) {
+  auto func = op->getParentOfType<func::FuncOp>();
+  return func
+      .walk([&](Operation *nested) {
+        for (Type type : nested->getResultTypes()) {
+          Type elementType;
+          if (auto cb = dyn_cast<ttkernel::CBType>(type)) {
+            elementType = cb.getElementType();
+          } else {
+            if (auto cb = dyn_cast<d2m::CBType>(type)) {
+              type = cb.getUnderlyingAs<MemRefType>();
+            }
+            if (auto memref = dyn_cast<MemRefType>(type);
+                memref && ttcore::getMemorySpace(memref) ==
+                              ttcore::MemorySpace::DeviceL1) {
+              elementType = memref.getElementType();
+            }
+          }
+          if (auto tile = dyn_cast_if_present<ttcore::TileType>(elementType);
+              tile && tile.getElementType().getIntOrFloatBitWidth() == 32) {
+            return WalkResult::interrupt();
+          }
+        }
+        return WalkResult::advance();
+      })
+      .wasInterrupted();
+}
