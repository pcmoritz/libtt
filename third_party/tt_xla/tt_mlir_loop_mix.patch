+class LoopMixOpConversionPattern : public OpConversionPattern<ttir::LoopMixOp> {
+public:
+  using OpConversionPattern<ttir::LoopMixOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::LoopMixOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(this->getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                      types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::LoopMixOp>(
+        op, types, adaptor.getDest(), adaptor.getMessages(), adaptor.getDown(),
+        adaptor.getGain(), adaptor.getForget(), op.getEpsilonAttr(),
+        adaptor.getNormWeight(), op.getEpsNormAttr());
+    return success();
+  }
+};
