+def TTIR_LoopMixOp : TTIR_NamedOp<"loop_mix"> {
+  let summary = "Inkling 2's loop-message controller";
+  let description = [{
+    hidden = bf16([bf16(rms(dest)) | bf16(rms(messages))] @ down), then
+    output = dest + (tanh(bf16(hidden @ gain)) * messages -
+                     tanh(bf16(hidden @ forget)) * dest)
+    per destination q: dest [Q or 1, T, W] and messages [Q, T, W] FP32, down
+    [Q, 2W, R] and gain and forget [Q, R, W] BF16; one result [Q, T, W] FP32.
+    With norm_weight [Q, W], instead Q results [T, W] BF16, each output's RMS
+    norm (eps_norm) times its weight row. libtt's tt.loop_mix custom call
+    (sglang_tpu_kernels.py) forms it.
+  }];
+  let arguments = (ins AnyRankedTensor:$dest,
+                       AnyRankedTensor:$messages,
+                       AnyRankedTensor:$down,
+                       AnyRankedTensor:$gain,
+                       AnyRankedTensor:$forget,
+                       F32Attr:$epsilon,
+                       Optional<AnyRankedTensor>:$norm_weight,
+                       DefaultValuedAttr<F32Attr, "0.0">:$eps_norm);
+  let results = (outs Variadic<AnyRankedTensor>:$outputs);
+}
