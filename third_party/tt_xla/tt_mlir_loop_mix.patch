+::flatbuffers::Offset<::tt::target::ttnn::LoopMixOp>
+createOp(FlatbufferObjectCache &cache, LoopMixOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  std::vector<::flatbuffers::Offset<::tt::target::ttnn::TensorRef>> outs;
+  for (Value output : op.getOutputs()) {
+    outs.push_back(cache.getOrCreateNoSharding(output, tensorValueToFlatbuffer,
+                                               std::nullopt));
+  }
+  auto outsOffset = cache.fbb->CreateVector(outs);
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> normWeight =
+      op.getNormWeight() ? tensor(op.getNormWeight()) : 0;
+  return ::tt::target::ttnn::CreateLoopMixOp(
+      *cache.fbb, tensor(op.getDest()), tensor(op.getMessages()),
+      tensor(op.getDown()), tensor(op.getGain()), tensor(op.getForget()),
+      op.getEpsilon().convertToFloat(), outsOffset, normWeight,
+      op.getEpsNorm().convertToFloat());
+}
