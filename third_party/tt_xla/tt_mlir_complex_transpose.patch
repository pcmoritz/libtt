+// Keep the trailing real/imaginary pair together when transposing complex data.
+class ComplexTransposeOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::TransposeOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult matchAndRewrite(
+      mlir::stablehlo::TransposeOp op,
+      mlir::stablehlo::TransposeOp::Adaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    auto resultType = cast<RankedTensorType>(
+        getTypeConverter()->convertType(op.getType()));
+    SmallVector<int64_t> permutation(op.getPermutation());
+    permutation.push_back(resultType.getRank() - 1);
+    rewriter.replaceOpWithNewOp<mlir::stablehlo::TransposeOp>(
+        op, resultType, adaptor.getOperand(),
+        rewriter.getDenseI64ArrayAttr(permutation));
+    return success();
+  }
+};
