+namespace {
+// Each device's coordinates in a mesh, indexed by the device's position in a
+// reference device order: meshes lay their device order out row-major.
+class MeshCoordinates {
+public:
+  MeshCoordinates(mlir::sdy::MeshAttr mesh, llvm::ArrayRef<int64_t> devices)
+      : mesh(mesh) {
+    llvm::SmallVector<int64_t> order = deviceOrder(mesh);
+    llvm::DenseMap<int64_t, int64_t> position;
+    for (auto [index, device] : llvm::enumerate(order)) {
+      position[device] = index;
+    }
+    llvm::ArrayRef<mlir::sdy::MeshAxisAttr> axes = mesh.getAxes();
+    for (int64_t device : devices) {
+      int64_t rest = position.lookup(device);
+      llvm::SmallVector<int64_t> coordinates(axes.size());
+      for (size_t axis = axes.size(); axis-- > 0;) {
+        coordinates[axis] = rest % axes[axis].getSize();
+        rest /= axes[axis].getSize();
+      }
+      byDevice.push_back(std::move(coordinates));
+    }
+  }
+
+  static llvm::SmallVector<int64_t> deviceOrder(mlir::sdy::MeshAttr mesh) {
+    if (!mesh.getDeviceIds().empty()) {
+      return llvm::to_vector(mesh.getDeviceIds());
+    }
+    return llvm::to_vector(llvm::seq<int64_t>(0, mesh.getTotalSize()));
+  }
+
+  // The coordinate of sub-axis (preSize, size) of `axis` on every device.
+  llvm::SmallVector<int64_t> values(llvm::StringRef axis, int64_t preSize,
+                                    int64_t size) const {
+    llvm::ArrayRef<mlir::sdy::MeshAxisAttr> axes = mesh.getAxes();
+    size_t index = llvm::find_if(axes, [&](mlir::sdy::MeshAxisAttr a) {
+                     return a.getName() == axis;
+                   }) -
+                   axes.begin();
+    int64_t minor = axes[index].getSize() / (preSize * size);
+    llvm::SmallVector<int64_t> result;
+    for (const llvm::SmallVector<int64_t> &coordinates : byDevice) {
+      result.push_back(coordinates[index] / minor % size);
+    }
+    return result;
+  }
+
+  mlir::sdy::MeshAttr mesh;
+
+private:
+  llvm::SmallVector<llvm::SmallVector<int64_t>> byDevice;
+};
+
+// A target mesh axis and every device's coordinate on it.
+struct TargetAxis {
+  llvm::StringRef name;
+  int64_t size;
+  llvm::SmallVector<int64_t> values;
+};
+} // namespace
+
+// The mesh a sharding refers to by name; empty for an inlined mesh.
+static llvm::StringRef meshName(mlir::sdy::TensorShardingAttr sharding) {
+  auto ref = mlir::dyn_cast<mlir::FlatSymbolRefAttr>(sharding.getMeshOrRef());
+  return ref ? ref.getValue() : llvm::StringRef();
+}
+
+static llvm::SmallVector<TargetAxis>
+targetAxesOf(const MeshCoordinates &target) {
+  llvm::SmallVector<TargetAxis> axes;
+  for (mlir::sdy::MeshAxisAttr axis : target.mesh.getAxes()) {
+    axes.push_back({axis.getName(), axis.getSize(),
+                    target.values(axis.getName(), 1, axis.getSize())});
+  }
+  return axes;
+}
+
+// `values` (one per device, in [0, size)) as a major-to-minor sequence of
+// whole target axes, like the device-to-tile maps XLA derives from shardings.
+// Only whole axes: tt-mlir does not support sub-axes in shardings.
+static std::optional<llvm::SmallVector<const TargetAxis *>>
+decompose(llvm::ArrayRef<int64_t> values, int64_t size,
+          llvm::ArrayRef<TargetAxis> axes,
+          llvm::SmallVector<const TargetAxis *> &used) {
+  if (size == 1) {
+    return llvm::SmallVector<const TargetAxis *>();
+  }
+  for (const TargetAxis &axis : axes) {
+    if (size % axis.size != 0 || llvm::is_contained(used, &axis)) {
+      continue;
+    }
+    int64_t minor = size / axis.size;
+    bool matches = true;
+    llvm::SmallVector<int64_t> rest;
+    for (auto [value, axisValue] : llvm::zip_equal(values, axis.values)) {
+      matches &= value / minor == axisValue;
+      rest.push_back(value % minor);
+    }
+    if (!matches) {
+      continue;
+    }
+    used.push_back(&axis);
+    if (auto tail = decompose(rest, minor, axes, used)) {
+      tail->insert(tail->begin(), &axis);
+      return tail;
+    }
+    used.pop_back();
+  }
+  return std::nullopt;
+}
+
+// The mesh `mesh` becomes as a target: size-one axes go when it has more than
+// two axes, so e.g. (1, 4, 1) becomes (4), and come first otherwise, so (2, 1)
+// becomes (1, 2), as tt-mlir takes (1, n) meshes but not (n, 1) ones. Neither
+// moves a device. None when more than two axes remain, which tt-mlir cannot
+// compile for.
+static std::optional<mlir::sdy::MeshAttr>
+targetMesh(mlir::sdy::MeshAttr mesh) {
+  mlir::MLIRContext *context = mesh.getContext();
+  if (mesh.getAxes().size() > 2) {
+    llvm::SmallVector<mlir::sdy::MeshAxisAttr> axes;
+    for (mlir::sdy::MeshAxisAttr axis : mesh.getAxes()) {
+      if (axis.getSize() > 1) {
+        axes.push_back(axis);
+      }
+    }
+    if (axes.size() > 2) {
+      return std::nullopt;
+    }
+    mesh = mlir::sdy::MeshAttr::get(context, axes, mesh.getDeviceIds());
+  }
+  if (mesh.getAxes().size() == 2 && mesh.getAxes()[0].getSize() > 1 &&
+      mesh.getAxes()[1].getSize() == 1) {
+    mesh = mlir::sdy::MeshAttr::get(
+        context, {mesh.getAxes()[1], mesh.getAxes()[0]}, mesh.getDeviceIds());
+  }
+  return mesh;
+}
+
+namespace {
+// Everything merging the meshes into one target changes, worked out before
+// anything changes.
+struct MeshRewritePlan {
+  mlir::sdy::MeshOp targetOp;
+  mlir::sdy::MeshAttr target;
+  llvm::DenseMap<mlir::Attribute, mlir::Attribute> shardings;
+  llvm::SmallVector<
+      std::pair<mlir::sdy::ManualComputationOp, mlir::sdy::ManualAxesAttr>>
+      manualAxes;
+};
+} // namespace
+
+// How the module reads on `targetOp`'s mesh, or none when it cannot read on
+// it in a form tt-mlir compiles: every axis used on any of `meshOps`, manual
+// axes included, must be a sequence of whole target axes.
+static std::optional<MeshRewritePlan>
+planMeshRewrite(mlir::ModuleOp module, llvm::ArrayRef<mlir::sdy::MeshOp> meshOps,
+                llvm::ArrayRef<int64_t> devices, mlir::sdy::MeshOp targetOp) {
+  mlir::MLIRContext *context = module.getContext();
+  std::optional<mlir::sdy::MeshAttr> target =
+      targetMesh(targetOp.getMeshAttr());
+  if (!target) {
+    return std::nullopt;
+  }
+  MeshRewritePlan plan{targetOp, *target, {}, {}};
+
+  // Explicit collectives name axes outside any sharding; leave them be
+  // unless their mesh stays as it is.
+  bool targetChanges = *target != targetOp.getMeshAttr();
+  llvm::StringMap<MeshCoordinates> coordinates;
+  for (mlir::sdy::MeshOp meshOp : meshOps) {
+    coordinates.try_emplace(meshOp.getSymName(),
+                            MeshCoordinates(meshOp.getMeshAttr(), devices));
+  }
+  mlir::WalkResult collectives =
+      module.walk([&](mlir::sdy::CollectiveOpInterface op) {
+        llvm::StringRef mesh = meshName(op.getOutSharding());
+        bool rewritten = coordinates.contains(mesh) &&
+                         (mesh != targetOp.getSymName() || targetChanges);
+        return rewritten ? mlir::WalkResult::interrupt()
+                         : mlir::WalkResult::advance();
+      });
+  if (collectives.wasInterrupted()) {
+    return std::nullopt;
+  }
+
+  llvm::SmallVector<TargetAxis> targetAxes =
+      targetAxesOf(MeshCoordinates(*target, devices));
+  // (Sub-)axes of a mesh, as functions of the device, through target axes,
+  // major to minor.
+  auto express = [&](llvm::StringRef mesh,
+                     llvm::ArrayRef<mlir::sdy::AxisRefAttr> refs)
+      -> std::optional<llvm::SmallVector<mlir::sdy::AxisRefAttr>> {
+    const MeshCoordinates &meshCoordinates = coordinates.find(mesh)->second;
+    llvm::SmallVector<mlir::sdy::AxisRefAttr> result;
+    for (mlir::sdy::AxisRefAttr ref : refs) {
+      int64_t preSize = 1;
+      int64_t size = meshCoordinates.mesh.getAxisSize(ref.getName());
+      if (mlir::sdy::SubAxisInfoAttr subAxis = ref.getSubAxisInfo()) {
+        preSize = subAxis.getPreSize();
+        size = subAxis.getSize();
+      }
+      llvm::SmallVector<const TargetAxis *> used;
+      auto axes =
+          decompose(meshCoordinates.values(ref.getName(), preSize, size), size,
+                    targetAxes, used);
+      if (!axes) {
+        return std::nullopt;
+      }
+      for (const TargetAxis *axis : *axes) {
+        result.push_back(mlir::sdy::AxisRefAttr::get(context, axis->name));
+      }
+    }
+    return result;
+  };
+  auto inMeshOrder = [&](llvm::SmallVector<mlir::sdy::AxisRefAttr> refs) {
+    llvm::sort(refs, mlir::sdy::AxisRefAttr::getMeshComparator(*target));
+    return refs;
+  };
+
+  // Tensor shardings keep each dimension's axis order; replicated and
+  // unreduced axes go in the target's order.
+  auto rewrite = [&](mlir::sdy::TensorShardingAttr sharding)
+      -> std::optional<mlir::sdy::TensorShardingAttr> {
+    llvm::StringRef mesh = meshName(sharding);
+    llvm::SmallVector<mlir::sdy::DimensionShardingAttr> dims;
+    for (mlir::sdy::DimensionShardingAttr dim : sharding.getDimShardings()) {
+      auto axes = express(mesh, dim.getAxes());
+      if (!axes) {
+        return std::nullopt;
+      }
+      dims.push_back(mlir::sdy::DimensionShardingAttr::get(
+          context, *axes, dim.getIsClosed(), dim.getPriority()));
+    }
+    auto replicated = express(mesh, sharding.getReplicatedAxes());
+    auto unreduced = express(mesh, sharding.getUnreducedAxes());
+    if (!replicated || !unreduced) {
+      return std::nullopt;
+    }
+    return mlir::sdy::TensorShardingAttr::get(
+        context, targetOp.getSymName(), dims, inMeshOrder(*replicated),
+        inMeshOrder(*unreduced));
+  };
+
+  bool expressible = true;
+  mlir::AttrTypeWalker walker;
+  walker.addWalk([&](mlir::sdy::TensorShardingAttr sharding) {
+    if (!expressible || plan.shardings.contains(sharding) ||
+        !coordinates.contains(meshName(sharding))) {
+      return;
+    }
+    std::optional<mlir::sdy::TensorShardingAttr> rewritten = rewrite(sharding);
+    expressible = rewritten.has_value();
+    if (rewritten) {
+      plan.shardings[sharding] = *rewritten;
+    }
+  });
+  module.walk([&](mlir::Operation *op) {
+    walker.walk(op->getAttrDictionary());
+    return expressible ? mlir::WalkResult::advance()
+                       : mlir::WalkResult::interrupt();
+  });
+  if (!expressible) {
+    return std::nullopt;
+  }
+
+  // Manual axes name whole axes of their region's mesh; a region without
+  // operands still has results.
+  mlir::WalkResult manual =
+      module.walk([&](mlir::sdy::ManualComputationOp op) {
+        llvm::ArrayRef<mlir::sdy::TensorShardingAttr> shardings =
+            op.getInShardings().getShardings();
+        if (shardings.empty()) {
+          shardings = op.getOutShardings().getShardings();
+        }
+        if (shardings.empty() ||
+            !coordinates.contains(meshName(shardings.front()))) {
+          return mlir::WalkResult::advance();
+        }
+        llvm::SmallVector<mlir::sdy::AxisRefAttr> refs;
+        for (mlir::StringAttr axis : op.getManualAxes()) {
+          refs.push_back(
+              mlir::sdy::AxisRefAttr::get(context, axis.getValue()));
+        }
+        auto axes = express(meshName(shardings.front()), refs);
+        if (!axes) {
+          return mlir::WalkResult::interrupt();
+        }
+        llvm::SmallVector<mlir::StringAttr> names;
+        for (mlir::sdy::AxisRefAttr axis : inMeshOrder(*axes)) {
+          names.push_back(mlir::StringAttr::get(context, axis.getName()));
+        }
+        plan.manualAxes.emplace_back(
+            op, mlir::sdy::ManualAxesAttr::get(context, names));
+        return mlir::WalkResult::advance();
+      });
+  if (manual.wasInterrupted()) {
+    return std::nullopt;
+  }
+  return plan;
+}
+
+static mlir::LogicalResult
+applyMeshRewrite(mlir::ModuleOp module,
+                 llvm::ArrayRef<mlir::sdy::MeshOp> meshOps,
+                 const MeshRewritePlan &plan) {
+  for (auto [op, axes] : plan.manualAxes) {
+    mlir::sdy::ManualComputationOp(op).setManualAxesAttr(axes);
+  }
+  mlir::AttrTypeReplacer replacer;
+  replacer.addReplacement([&](mlir::sdy::TensorShardingAttr sharding)
+                              -> std::optional<mlir::Attribute> {
+    auto it = plan.shardings.find(sharding);
+    if (it == plan.shardings.end()) {
+      return std::nullopt;
+    }
+    return it->second;
+  });
+  replacer.recursivelyReplaceElementsIn(module, /*replaceAttrs=*/true,
+                                        /*replaceLocs=*/false,
+                                        /*replaceTypes=*/false);
+  mlir::sdy::MeshOp targetOp = plan.targetOp;
+  targetOp.setMeshAttr(plan.target);
+  for (mlir::sdy::MeshOp meshOp : meshOps) {
+    if (meshOp == targetOp) {
+      continue;
+    }
+    if (!mlir::SymbolTable::symbolKnownUseEmpty(meshOp, module)) {
+      return meshOp.emitError("Mesh @")
+             << meshOp.getSymName() << " is still used after merging it into @"
+             << targetOp.getSymName();
+    }
+    meshOp.erase();
+  }
+  return mlir::success();
+}
+
+// JAX lets every shard_map or sharding use its own mesh, while tt-mlir compiles
+// one program for one mesh of at most two axes. Like XLA, which turns every
+// sharding into a map from devices to tiles, treat meshes over the same devices
+// as views of one device grid: express each axis of every mesh, as a function
+// of the device, through axes of one target mesh, and rewrite the shardings and
+// manual axes onto it. The first mesh the whole module can be planned onto
+// wins; when none can, the module stays as it is for the single-mesh check to
+// report.
+mlir::LogicalResult mergeMeshes(mlir::ModuleOp &module) {
+  llvm::SmallVector<mlir::sdy::MeshOp> meshOps;
+  for (mlir::sdy::MeshOp meshOp : getMeshOps(module)) {
+    if (!meshOp.getMeshAttr().empty()) {
+      meshOps.push_back(meshOp);
+    }
+  }
+  if (meshOps.empty()) {
+    return mlir::success();
+  }
+  llvm::SmallVector<int64_t> devices =
+      MeshCoordinates::deviceOrder(meshOps.front().getMeshAttr());
+  llvm::SmallVector<int64_t> sortedDevices = llvm::to_vector(devices);
+  llvm::sort(sortedDevices);
+  for (mlir::sdy::MeshOp meshOp : meshOps) {
+    llvm::SmallVector<int64_t> order =
+        MeshCoordinates::deviceOrder(meshOp.getMeshAttr());
+    llvm::sort(order);
+    if (order != sortedDevices) {
+      return mlir::success(); // Other devices; the single-mesh check reports.
+    }
+  }
+  if (meshOps.size() == 1 &&
+      targetMesh(meshOps.front().getMeshAttr()) ==
+          meshOps.front().getMeshAttr()) {
+    return mlir::success();
+  }
+
+  for (mlir::sdy::MeshOp targetOp : meshOps) {
+    if (std::optional<MeshRewritePlan> plan =
+            planMeshRewrite(module, meshOps, devices, targetOp)) {
+      return applyMeshRewrite(module, meshOps, *plan);
+    }
+  }
+  return mlir::success();
+}
