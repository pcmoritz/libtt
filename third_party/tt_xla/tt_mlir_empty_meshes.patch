 // Normalize a 0D or 1D mesh to 2D. 0D meshes get {1,1}, 1D meshes get {1,N}.
 mlir::LogicalResult normalizeMeshTo2D(mlir::ModuleOp &module) {
+  if (mlir::failed(mergeMeshes(module))) {
+    return mlir::failure();
+  }
+  if (mlir::failed(replaceEmptyMeshes(module))) {
+    return mlir::failure();
+  }
