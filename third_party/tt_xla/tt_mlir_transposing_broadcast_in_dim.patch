     auto outputType = mlir::cast<RankedTensorType>(
         getTypeConverter()->convertType(srcOp.getResult().getType()));
 
+    // The reshape and broadcast below keep the operand's dims in their order,
+    // so they place operand dim i at result dim broadcast_dimensions[i] only
+    // when those increase. Unsorted ones also transpose the operand (PyTorch's
+    // matmul backward broadcasts a transposed weight with dims [2, 1]):
+    // permute it into the order of its result dims first.
+    Value operand = adaptor.getOperand();
+    SmallVector<int64_t> broadcastDimensions(srcOp.getBroadcastDimensions());
+    if (!llvm::is_sorted(broadcastDimensions)) {
+      SmallVector<int64_t> permutation(broadcastDimensions.size());
+      std::iota(permutation.begin(), permutation.end(), 0);
+      llvm::stable_sort(permutation, [&](int64_t a, int64_t b) {
+        return broadcastDimensions[a] < broadcastDimensions[b];
+      });
+      SmallVector<int64_t> permutedShape;
+      SmallVector<int64_t> sortedDimensions;
+      for (int64_t d : permutation) {
+        permutedShape.push_back(inputType.getDimSize(d));
+        sortedDimensions.push_back(broadcastDimensions[d]);
+      }
+      inputType = RankedTensorType::get(permutedShape,
+                                        inputType.getElementType(),
+                                        inputType.getEncoding());
+      operand = rewriter.create<ttir::PermuteOp>(srcOp.getLoc(), inputType,
+                                                 operand, permutation);
+      broadcastDimensions = sortedDimensions;
+    }
