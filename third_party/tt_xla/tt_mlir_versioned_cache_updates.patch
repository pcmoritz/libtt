 // Walks every DistributedOpInterface op and invokes allocateBuffers. The
 // interface implementation owns the allocation logic and is idempotent.
+// Distributed ops run one after another, so the scratch buffers they get of
+// one spec are shared: per block, the first of each spec stands in for the
+// rest. (ttnn.empty is an allocation, so CSE does not merge them.)
 class TTNNAllocateDistributedOpBuffers
     : public impl::TTNNAllocateDistributedOpBuffersBase<
           TTNNAllocateDistributedOpBuffers> {
@@ -28,8 +35,29 @@
     ModuleOp moduleOp = getOperation();
     IRRewriter rewriter(&getContext());
 
+    llvm::DenseSet<Operation *> existing;
+    moduleOp.walk([&](EmptyOp op) { existing.insert(op); });
     moduleOp.walk(
         [&](DistributedOpInterface op) { op.allocateBuffers(rewriter); });
+
+    using Spec = std::tuple<Block *, Type, Attribute, Value>;
+    llvm::DenseMap<Spec, EmptyOp> first;
+    llvm::SmallVector<EmptyOp> shared;
+    moduleOp.walk([&](EmptyOp op) {
+      if (existing.contains(op)) {
+        return;
+      }
+      Spec spec{op->getBlock(), op.getType(), op->getAttrDictionary(),
+                op.getDevice()};
+      if (!first.try_emplace(spec, op).second) {
+        shared.push_back(op);
+      }
+    });
+    for (EmptyOp op : shared) {
+      EmptyOp keep = first.lookup(Spec{op->getBlock(), op.getType(),
+                                       op->getAttrDictionary(), op.getDevice()});
+      rewriter.replaceOp(op, keep.getResult());
+    }
   }
 };
 
