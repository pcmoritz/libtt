+// The cache ops (fill_cache, update_cache, the paged and recurrent updates)
+// write their cache operand in place and have no result, while the custom call
+// they lower returns the updated cache. The updated cache gets its own SSA
+// value: an optimization barrier on the cache, created after the write. Reads
+// after the update use that value and reads before it use the operand, so CSE
+// cannot merge a read after the update into one before it, and the barrier's
+// side effects keep it after the write. The barriers fold away before
+// deallocation, after the last CSE.
+static mlir::Value createUpdatedCache(mlir::OpBuilder &builder,
+                                      mlir::Location loc, mlir::Value cache) {
+  return builder
+      .create<mlir::tt::ttcore::OptimizationBarrierOp>(
+          loc, mlir::TypeRange{cache.getType()}, mlir::ValueRange{cache})
+      .getResult(0);
+}
