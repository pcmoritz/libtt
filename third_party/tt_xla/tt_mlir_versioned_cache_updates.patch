         Op<TTNN_Dialect, mnemonic, [Pure, CheckTileTypeTrait, TTNN_WorkaroundInterface, DeclareOpInterfaceMethods<TTNN_MemoryConfigOpInterface>, DeclareOpInterfaceMethods<TTNN_DtypeOpInterface>] #
         IfOpModelRequired<traits>.value # traits>;
 
+// An op whose result is a new buffer or device resource. Two of them are two
+// resources even when their operands and attributes match (the slots of a
+// trace, the scratch of a distributed op, its semaphores), so the op is not
+// Pure: its result carries an allocation effect, declare it as
+// Res<..., [MemAlloc]>, and CSE never merges two of them. An unused one is
+// still dead.
+class TTNN_AllocationOp<string mnemonic, list<Trait> traits = []> :
+        Op<TTNN_Dialect, mnemonic, [CheckTileTypeTrait, TTNN_WorkaroundInterface, DeclareOpInterfaceMethods<TTNN_MemoryConfigOpInterface>, DeclareOpInterfaceMethods<TTNN_DtypeOpInterface>] #
+        IfOpModelRequired<traits>.value # traits>;
+
 class TTNN_InplaceOp<string mnemonic, list<Trait> traits = []> :
         Op<TTNN_Dialect, mnemonic, [MemoryEffects<[MemWrite]>, TTNN_WorkaroundInterface, DeclareOpInterfaceMethods<TTNN_MemoryConfigOpInterface>, DeclareOpInterfaceMethods<TTNN_DtypeOpInterface>] #
         IfOpModelRequired<traits>.value # traits>;
