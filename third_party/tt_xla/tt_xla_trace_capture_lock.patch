diff --git a/pjrt_implementation/src/api/buffer_instance.cc b/pjrt_implementation/src/api/buffer_instance.cc
--- a/pjrt_implementation/src/api/buffer_instance.cc
+++ b/pjrt_implementation/src/api/buffer_instance.cc
@@ -359,11 +359,17 @@ void BufferInstance::copyFromBuffer(BufferInstance *src_buffer) {
   DLOG_F(LOG_DEBUG, "BufferInstance::copyFromBuffer");
   TT_FATAL(src_buffer->getPjrtTensor(), "Source buffer has no data.");
 
+  // Copying on the device and untilizing for the host both run programs,
+  // which a trace capture on another thread would skip or record.
+  std::unique_lock<std::recursive_mutex> capture_lock(
+      tt::runtime::getTraceCaptureMutex());
+
   // A buffer of one device holding the same data on every chip is copied on
   // the device, without a transfer through the host or a wait for the device.
   if (src_buffer->getPjrtTensor()->on_every_chip()) {
     PjrtTensor::from_runtime_tensor(
         {this}, tt::runtime::cloneTensor(src_buffer->runtimeTensor()));
+    capture_lock.unlock();
     markAsDataReady();
     return;
   }
@@ -385,6 +391,7 @@ void BufferInstance::copyFromBuffer(BufferInstance *src_buffer) {
       /* data= */ nullptr, shape, strides, element_size, runtime_data_type);
 
   src_buffer->getPjrtTensor()->move_to_host();
+  capture_lock.unlock();
   tt::runtime::memcpy(runtime_tensor, src_buffer->runtimeTensor());
 
   PjrtTensor::from_runtime_tensor({this}, std::move(runtime_tensor));
@@ -492,6 +499,11 @@ tt_pjrt_status BufferInstance::copyToHost(void *host_buffer,
   const size_t logical_tensor_size = logicalTensorSize();
   std::optional<tt::runtime::Tensor> host_tensor;
   {
+    // Untilizing the tensor on device runs a program, which a trace capture on
+    // another thread would skip or record: the read would then return what an
+    // earlier buffer left.
+    const std::lock_guard<std::recursive_mutex> capture_lock(
+        tt::runtime::getTraceCaptureMutex());
     const std::lock_guard<std::mutex> lock(s_copy_to_host_internal_mutex);
     host_tensor = m_pjrt_tensor->start_move_to_host(this);
   }
