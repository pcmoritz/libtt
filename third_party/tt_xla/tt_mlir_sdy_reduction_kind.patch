+// Shardy inserts all-reduces and reduce-scatters after ops whose reduction
+// dimensions are sharded. Partial results of a stablehlo.reduce combine with
+// the reduce's own computation (max, min, ...); others, e.g. dot_general, sum.
+// A variadic reduce (e.g. argmax) cannot be combined result by result.
+static FailureOr<mlir::stablehlo::ReduceOp> getSourceReduce(Value operand) {
+  auto reduceOp = operand.getDefiningOp<mlir::stablehlo::ReduceOp>();
+  if (reduceOp && reduceOp->getNumResults() != 1) {
+    return failure();
+  }
+  return reduceOp;
+}
+
+template <typename SrcOp>
+static void addSourceReductionBlock(PatternRewriter &rewriter, SrcOp &srcOp,
+                                    mlir::stablehlo::ReduceOp sourceReduce,
+                                    mlir::RankedTensorType outputType) {
+  if (!sourceReduce) {
+    addReductionBlock<SrcOp, mlir::stablehlo::AddOp>(rewriter, srcOp,
+                                                     outputType);
+    return;
+  }
+  rewriter.cloneRegionBefore(sourceReduce.getBody(), srcOp.getRegion(),
+                             srcOp.getRegion().end());
+}
