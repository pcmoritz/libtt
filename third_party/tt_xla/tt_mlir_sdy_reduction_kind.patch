+// Shardy inserts all-reduces and reduce-scatters after ops whose reduction
+// dimensions are sharded. Like XLA's SPMD partitioner, partial results of a
+// stablehlo.reduce combine with the reduce's own computation (max, min, ...);
+// others, e.g. dot_general, and unreduced values sum. A variadic reduce (e.g.
+// argmax) cannot be combined result by result, see reduceArgMinMax.
+static mlir::stablehlo::ReduceOp getSourceReduce(Value operand) {
+  mlir::sdy::TensorShardingAttr sharding = mlir::sdy::getSharding(operand);
+  if (sharding && !sharding.getUnreducedAxes().empty()) {
+    return nullptr;
+  }
+  return operand.getDefiningOp<mlir::stablehlo::ReduceOp>();
+}
+
+template <typename SrcOp>
+static void addSourceReductionBlock(PatternRewriter &rewriter, SrcOp &srcOp,
+                                    mlir::stablehlo::ReduceOp sourceReduce,
+                                    mlir::RankedTensorType outputType) {
+  if (!sourceReduce) {
+    addReductionBlock<SrcOp, mlir::stablehlo::AddOp>(rewriter, srcOp,
+                                                     outputType);
+    return;
+  }
+  rewriter.cloneRegionBefore(sourceReduce.getBody(), srcOp.getRegion(),
+                             srcOp.getRegion().end());
+}
+
+// Whether `value` is this device's slice of an iota along `dim`.
+static bool isSlicedIota(Value value, int64_t dim) {
+  auto composite = value.getDefiningOp<mlir::stablehlo::CompositeOp>();
+  if (!composite || composite.getName() != "sdy.all_slice") {
+    return false;
+  }
+  auto iota = composite.getOperand(0).getDefiningOp<mlir::stablehlo::IotaOp>();
+  return iota && iota.getIotaDimension() == static_cast<uint64_t>(dim);
+}
+
+// A reduce with a single result over `dim`, combining with Op.
+template <typename Op>
+static Value reduceWith(PatternRewriter &rewriter, mlir::Location loc,
+                        Value input, Value init, int64_t dim) {
+  auto type = mlir::cast<mlir::RankedTensorType>(input.getType());
+  llvm::SmallVector<int64_t> shape(type.getShape());
+  shape.erase(shape.begin() + dim);
+  auto reduceOp = rewriter.create<mlir::stablehlo::ReduceOp>(
+      loc, TypeRange{mlir::RankedTensorType::get(shape, type.getElementType())},
+      ValueRange{input}, ValueRange{init}, rewriter.getDenseI64ArrayAttr({dim}));
+  mlir::Type scalarType = init.getType();
+  mlir::OpBuilder::InsertionGuard guard(rewriter);
+  mlir::Block *block = rewriter.createBlock(
+      &reduceOp.getBody(), {}, {scalarType, scalarType}, {loc, loc});
+  rewriter.create<mlir::stablehlo::ReturnOp>(
+      loc, rewriter
+               .create<Op>(loc, block->getArgument(0), block->getArgument(1))
+               .getResult());
+  return reduceOp.getResult(0);
+}
+
+// The index along `dim` that `reduceOp`'s argmin/argmax reducer picks: the
+// index result of a reduce over (input, iota) with the reducer's body and
+// init values, so the conversion to TTIR validates the reducer.
+static Value argMinMax(PatternRewriter &rewriter, mlir::Location loc,
+                       mlir::stablehlo::ReduceOp reduceOp, Value input,
+                       int64_t dim) {
+  auto type = mlir::cast<mlir::RankedTensorType>(input.getType());
+  mlir::Type indexType =
+      mlir::cast<mlir::RankedTensorType>(reduceOp.getResult(1).getType())
+          .getElementType();
+  Value iota = rewriter.create<mlir::stablehlo::IotaOp>(
+      loc, mlir::RankedTensorType::get(type.getShape(), indexType), dim);
+  llvm::SmallVector<int64_t> shape(type.getShape());
+  shape.erase(shape.begin() + dim);
+  auto argReduce = rewriter.create<mlir::stablehlo::ReduceOp>(
+      loc,
+      TypeRange{mlir::RankedTensorType::get(shape, type.getElementType()),
+                mlir::RankedTensorType::get(shape, indexType)},
+      ValueRange{input, iota}, reduceOp.getInitValues(),
+      rewriter.getDenseI64ArrayAttr({dim}));
+  rewriter.cloneRegionBefore(reduceOp.getBody(), argReduce.getBody(),
+                             argReduce.getBody().end());
+  return argReduce.getResult(1);
+}
+
+// The elements of `input` at `index` along `dim`, as a masked sum.
+static Value pick(PatternRewriter &rewriter, mlir::Location loc, Value input,
+                  Value index, int64_t dim) {
+  auto type = mlir::cast<mlir::RankedTensorType>(input.getType());
+  auto indexType = mlir::cast<mlir::RankedTensorType>(index.getType());
+  auto iotaType =
+      mlir::RankedTensorType::get(type.getShape(), indexType.getElementType());
+  llvm::SmallVector<int64_t> dims = llvm::to_vector(llvm::seq<int64_t>(0, dim));
+  llvm::append_range(dims, llvm::seq<int64_t>(dim + 1, type.getRank()));
+  Value isIndex = rewriter.create<mlir::stablehlo::CompareOp>(
+      loc, rewriter.create<mlir::stablehlo::IotaOp>(loc, iotaType, dim),
+      rewriter.create<mlir::stablehlo::BroadcastInDimOp>(loc, iotaType, index,
+                                                         dims),
+      mlir::stablehlo::ComparisonDirection::EQ);
+  Value zeros = rewriter.create<mlir::stablehlo::ConstantOp>(
+      loc, rewriter.getZeroAttr(type));
+  Value zero = rewriter.create<mlir::stablehlo::ConstantOp>(
+      loc, rewriter.getZeroAttr(
+               mlir::RankedTensorType::get({}, type.getElementType())));
+  return reduceWith<mlir::stablehlo::AddOp>(
+      rewriter, loc,
+      rewriter.create<mlir::stablehlo::SelectOp>(loc, isIndex, input, zeros),
+      zero, dim);
+}
+
+// Combines an argmin/argmax (a reduce over values and a sliced iota) over a
+// dimension sharded along one mesh axis. As in XLA, each device finds its
+// extreme value and global index, both are gathered, and the reducer picks
+// the winning device; the earliest device wins ties, which holds the smallest
+// index.
+static LogicalResult
+reduceArgMinMax(mlir::sdy::AllReduceOp srcOp, mlir::stablehlo::ReduceOp reduceOp,
+                mlir::tt::shardy_utils::MeshMap &meshMap,
+                mlir::stablehlo::ChannelHandleAttr channelHandleAttr,
+                PatternRewriter &rewriter) {
+  if (reduceOp->getNumResults() != 2 || reduceOp.getDimensions().size() != 1 ||
+      srcOp.getReductionAxes().size() != 1 ||
+      !isSlicedIota(reduceOp.getInputs()[1], reduceOp.getDimensions()[0])) {
+    return rewriter.notifyMatchFailure(
+        srcOp, "only argmin/argmax over one mesh axis can be all-reduced");
+  }
+  // Results without users, e.g. argmax's values, lost their all-reduce.
+  llvm::SmallVector<mlir::Operation *> allReduceOps;
+  for (Value result : reduceOp->getResults()) {
+    allReduceOps.push_back(
+        result.hasOneUse()
+            ? mlir::dyn_cast<mlir::sdy::AllReduceOp>(*result.user_begin())
+            : nullptr);
+    if (!result.use_empty() && !allReduceOps.back()) {
+      return rewriter.notifyMatchFailure(srcOp, "partial result is used");
+    }
+  }
+
+  mlir::Location loc = srcOp.getLoc();
+  rewriter.setInsertionPointAfter(reduceOp);
+  int64_t dim = reduceOp.getDimensions()[0];
+  Value input = reduceOp.getInputs()[0];
+  Value slicedIota = reduceOp.getInputs()[1];
+
+  // This device's extreme value and its global index: the local index plus
+  // where this device's slice of the iota starts.
+  Value localIndex = argMinMax(rewriter, loc, reduceOp, input, dim);
+  Value value = pick(rewriter, loc, input, localIndex, dim);
+  auto slicedType = mlir::cast<mlir::RankedTensorType>(slicedIota.getType());
+  llvm::SmallVector<int64_t> limits(slicedType.getShape());
+  limits[dim] = 1;
+  llvm::SmallVector<int64_t> starts(limits.size(), 0), strides(limits.size(), 1);
+  Value start = rewriter.create<mlir::stablehlo::ReshapeOp>(
+      loc, localIndex.getType(),
+      rewriter.create<mlir::stablehlo::SliceOp>(loc, slicedIota, starts, limits,
+                                                strides));
+  Value index = rewriter.create<mlir::stablehlo::AddOp>(loc, localIndex, start);
+
+  // Gather both from every device along the axis into a last dimension,
+  // [..., devices], which ttnn's argmax supports.
+  mlir::StringRef meshAxis = srcOp.getReductionAxes()[0].getName();
+  int64_t last = mlir::cast<mlir::RankedTensorType>(value.getType()).getRank();
+  auto gather = [&](Value result) -> Value {
+    auto type = mlir::cast<mlir::RankedTensorType>(result.getType());
+    llvm::SmallVector<int64_t> shape(type.getShape());
+    shape.push_back(1);
+    Value expanded = rewriter.create<mlir::stablehlo::ReshapeOp>(
+        loc, mlir::RankedTensorType::get(shape, type.getElementType()), result);
+    shape[last] = meshMap[meshAxis.str()];
+    return rewriter
+        .create<mlir::stablehlo::AllGatherOp>(
+            loc, mlir::RankedTensorType::get(shape, type.getElementType()),
+            expanded, last,
+            createDenseAttrFromReplicaGroups(
+                rewriter.getContext(), populateReplicaGroups(meshMap, meshAxis)),
+            channelHandleAttr)
+        .getResult(0);
+  };
+  Value values = gather(value);
+
+  // The winning device, and its value and global index.
+  Value winner = argMinMax(rewriter, loc, reduceOp, values, last);
+  if (allReduceOps[0]) {
+    rewriter.replaceOp(allReduceOps[0],
+                       pick(rewriter, loc, values, winner, last));
+  }
+  if (allReduceOps[1]) {
+    rewriter.replaceOp(allReduceOps[1],
+                       pick(rewriter, loc, gather(index), winner, last));
+  }
+  rewriter.eraseOp(reduceOp);
+  return success();
+}
