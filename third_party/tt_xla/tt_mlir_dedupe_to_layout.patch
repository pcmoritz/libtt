+// Whether `user` may write `value` in place. An op that names the operands it
+// writes (Arg<..., [MemWrite]>) also carries its class's unnamed write, which
+// then refers to those operands; an op whose writes are all unnamed may write
+// any of them.
+static bool mayWriteInPlace(mlir::Operation *user, mlir::Value value) {
+  if (mlir::isMemoryEffectFree(user)) {
+    return false;
+  }
+  auto iface = mlir::dyn_cast<mlir::MemoryEffectOpInterface>(user);
+  if (!iface) {
+    return true;
+  }
+  llvm::SmallVector<mlir::MemoryEffects::EffectInstance> effects;
+  iface.getEffects(effects);
+  bool unnamed = false;
+  bool named = false;
+  for (const auto &effect : effects) {
+    if (!mlir::isa<mlir::MemoryEffects::Write>(effect.getEffect())) {
+      continue;
+    }
+    if (!effect.getValue()) {
+      unnamed = true;
+    } else if (effect.getValue() == value) {
+      return true;
+    } else {
+      named = true;
+    }
+  }
+  return unnamed && !named;
+}
+
+// A to_layout of the same input to the same type earlier in the block already
+// holds this one's result: reuse it. Layout ops inserted late (after the last
+// CSE) convert the same small input once per consumer, e.g. a decode step's
+// state-pool index for every recurrent layer, each a separate program. Only
+// when no user of either result writes to it in place.
+static mlir::Value foldDuplicateToLayoutOp(ttnn::ToLayoutOp op) {
+  auto readOnlyUses = [](mlir::Value value) {
+    return llvm::none_of(value.getUsers(), [&](mlir::Operation *user) {
+      return mayWriteInPlace(user, value);
+    });
+  };
+  for (mlir::Operation *user : op.getInput().getUsers()) {
+    auto other = mlir::dyn_cast<ttnn::ToLayoutOp>(user);
+    if (!other || other == op || other->getBlock() != op->getBlock() ||
+        !other->isBeforeInBlock(op) ||
+        other.getResult().getType() != op.getResult().getType() ||
+        other->getAttrDictionary() != op->getAttrDictionary()) {
+      continue;
+    }
+    if (readOnlyUses(other.getResult()) && readOnlyUses(op.getResult())) {
+      return other.getResult();
+    }
+  }
+  return nullptr;
+}
+
 // ToLayoutOp folder
 mlir::OpFoldResult ttnn::ToLayoutOp::fold(FoldAdaptor adaptor) {
   if (auto foldResult = foldIdentityToLayoutOp(*this)) {
@@ -2520,6 +2577,10 @@ mlir::OpFoldResult ttnn::ToLayoutOp::fold(FoldAdaptor adaptor) {
     return foldResult;
   }
 
+  if (mlir::Value duplicate = foldDuplicateToLayoutOp(*this)) {
+    return duplicate;
+  }
+
   return nullptr;
