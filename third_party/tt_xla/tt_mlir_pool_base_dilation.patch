+  // ttnn pooling runs in bfloat16: float32 and float16 sum pooling (and
+  // average pooling, which divides the sum) adds window slices in its own
+  // type instead, and max pooling takes their maximum. Max pooling of
+  // bfloat16 and 8-bit integers, which bfloat16 holds exactly, stays on ttnn
+  // when its init is -inf (or the lowest integer). Without ttnn pooling (base
+  // dilations), every sum and max window reduces slices.
+  std::optional<Value>
+  trySliceReduction(mlir::stablehlo::ReduceWindowOp srcOp, Value input,
+                    TypicalInitReductionValue init, Operation *reductionOp,
+                    DenseI64ArrayAttr windowDimensions,
+                    DenseI64ArrayAttr windowStrides,
+                    DenseI64ArrayAttr windowDilations,
+                    DenseI64ArrayAttr baseDilations, DenseI64ArrayAttr padding,
+                    bool withoutPooling,
+                    ConversionPatternRewriter &rewriter) const {
+    using TypicalInitReductionValue::LOWEST_FINITE;
+    using TypicalInitReductionValue::NEG_INF;
+    using TypicalInitReductionValue::ZERO;
+    Type elementType =
+        mlir::cast<RankedTensorType>(input.getType()).getElementType();
+    bool exactInBF16 = elementType.isBF16() ||
+                       (elementType.isInteger() &&
+                        elementType.getIntOrFloatBitWidth() <= 8);
+    bool isSum = isa<mlir::stablehlo::AddOp>(reductionOp) && init == ZERO &&
+                 (withoutPooling || elementType.isF32() || elementType.isF16());
+    bool isMax = isa<mlir::stablehlo::MaxOp>(reductionOp) &&
+                 (init == LOWEST_FINITE ||
+                  (init == NEG_INF && (withoutPooling || !exactInBF16)));
+    if (!isSum && !isMax) {
+      return std::nullopt;
+    }
+    // Pad with the init value: the lowest value of the type for a max, or
+    // -inf.
+    double padValue = 0.0;
+    if (isMax) {
+      if (auto floatType = mlir::dyn_cast<FloatType>(elementType)) {
+        padValue = llvm::APFloat::getLargest(floatType.getFloatSemantics(),
+                                             /*Negative=*/true)
+                       .convertToDouble();
+        if (init == NEG_INF) {
+          padValue = -std::numeric_limits<double>::infinity();
+        }
+      } else if (auto intType = mlir::dyn_cast<IntegerType>(elementType);
+                 intType && !intType.isUnsigned()) {
+        padValue = static_cast<double>(
+            llvm::APInt::getSignedMinValue(intType.getWidth()).getSExtValue());
+      }
+    }
+    return reduceWindowSlices(srcOp, input, /*max=*/isMax, padValue,
+                              windowDimensions, windowStrides, windowDilations,
+                              baseDilations, padding, rewriter);
+  }
