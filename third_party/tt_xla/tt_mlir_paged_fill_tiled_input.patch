diff --git a/runtime/lib/ttnn/operations/kv_cache/paged_fill_cache.cpp b/runtime/lib/ttnn/operations/kv_cache/paged_fill_cache.cpp
--- a/runtime/lib/ttnn/operations/kv_cache/paged_fill_cache.cpp
+++ b/runtime/lib/ttnn/operations/kv_cache/paged_fill_cache.cpp
@@ -10,3 +10,4 @@
 #include "tt/runtime/workarounds.h"
 #include "ttnn/distributed/api.hpp"
 #include "ttnn/distributed/distributed_tensor.hpp"
+#include "ttnn/operations/core/to_layout/to_layout_op.hpp"
@@ -18,6 +19,15 @@ void run(const ::tt::target::ttnn::PagedFillCacheOp *op,
   const ::ttnn::Tensor &cacheTensor =
       context.getTensorPool().getTTNNTensorAndValidate(op->cache());
-  const ::ttnn::Tensor &inputTensor =
+  const ::ttnn::Tensor &serializedInputTensor =
       context.getTensorPool().getTTNNTensorAndValidate(op->input());
+  // TT-Metal's paged-fill reader consumes tiled input. Layout propagation may
+  // choose row-major for this no-result sink op, so enforce the operation's
+  // runtime precondition here rather than exposing it to callers.
+  const ::ttnn::Tensor inputTensor = ::ttnn::to_layout(
+      serializedInputTensor, ::ttnn::Layout::TILE);
-  const ::ttnn::Tensor &pageTableTensor =
+  const ::ttnn::Tensor &serializedPageTableTensor =
       context.getTensorPool().getTTNNTensorAndValidate(op->page_table());
+  // The writer indexes page-table rows as sticks, so a tiled page table silently
+  // addresses the wrong cache blocks for every batch after the first.
+  const ::ttnn::Tensor pageTableTensor = ::ttnn::to_layout(
+      serializedPageTableTensor, ::ttnn::Layout::ROW_MAJOR);
