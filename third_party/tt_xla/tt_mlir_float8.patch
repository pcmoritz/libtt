+
+using namespace mlir;
+
+namespace mlir::tt::stablehlo {
+#define GEN_PASS_DEF_STABLEHLOFLOAT8DATATYPECONVERSIONPASS
+#include "ttmlir/Dialect/StableHLO/Transforms/Passes.h.inc"
+
+//===----------------------------------------------------------------------===//
+// Float8DataTypeConversion overview
+//===----------------------------------------------------------------------===//
+// Float8 tensors are stored as their bits, in ui8 tensors:
+//   tensor<4x8xf8E4M3FN>  -->  tensor<4x8xui8>
+// The bytes are the same as in the hardware's Fp8_e4m3 and Lf8 formats, so
+// data movement (reshape, transpose, slice, ...) moves them unchanged, and a
+// dot_general of two float8 matrices keeps its float8 operands: a
+// stablehlo.bitcast_convert from the ui8 bits, which the runtime makes a
+// view, feeds the matrix unit, which reads Fp8_e4m3 and Lf8 natively.
+//
+// stablehlo.convert between float8 and f32 stays, on views of the bits: ttnn's
+// typecast converts float8 exactly (the hardware's own conversions truncate
+// and flush subnormals), decoding every code and encoding with rounding to
+// nearest even, subnormals, and each format's overflow (NaN for e4m3fn,
+// infinity for e5m2). Other conversions to or from float8 go through f32, and
+// other ops on float8 values compute in f32.
+//
+// Control flow (while, case, if, shard_map bodies) carries the bits too, as
+// do Shardy's collectives and reshards (sdy.all_slice composites). Ops whose
+// regions compute on float8 values (reduce, sort, scatter, ...) compute on f32
+// values: their regions would otherwise compare or combine the bits. Other
+// composites become calls of their decompositions, which compute like any other
+// function. The pass runs before composites are legalized into TTIR, which
+// would leave float8 types in TTIR ops that it can't reach.
+//===----------------------------------------------------------------------===//
+
+namespace {
+
+// The float8 element type of a type, if it has one.
+Type getFloat8Type(Type type) {
+  Type elementType = getElementTypeOrSelf(type);
+  if (isa<Float8E4M3FNType, Float8E5M2Type>(elementType)) {
+    return elementType;
+  }
+  return {};
+}
+
+bool isFloat8(Type type) { return static_cast<bool>(getFloat8Type(type)); }
+
+bool hasFloat8(TypeRange types) { return llvm::any_of(types, isFloat8); }
+
+bool hasFloat8(Operation *op) {
+  return hasFloat8(op->getOperandTypes()) || hasFloat8(op->getResultTypes());
+}
+
+RankedTensorType withElementType(Type type, Type elementType) {
+  return cast<RankedTensorType>(type).clone(elementType);
+}
+
+// A dot_general whose float8 operands the matrix unit can read as they are:
+// [batch..., M, K] x [batch..., K, N].
+bool hasNativeFloat8Operands(mlir::stablehlo::DotGeneralOp op) {
+  auto lhsType = cast<RankedTensorType>(op.getLhs().getType());
+  auto rhsType = cast<RankedTensorType>(op.getRhs().getType());
+  if (!isFloat8(lhsType) || !isFloat8(rhsType)) {
+    return false;
+  }
+  auto dims = op.getDotDimensionNumbers();
+  int64_t batch = dims.getLhsBatchingDimensions().size();
+  for (int64_t i = 0; i < batch; ++i) {
+    if (dims.getLhsBatchingDimensions()[i] != i ||
+        dims.getRhsBatchingDimensions()[i] != i) {
+      return false;
+    }
+  }
+  ArrayRef<int64_t> lhsContracting = dims.getLhsContractingDimensions();
+  ArrayRef<int64_t> rhsContracting = dims.getRhsContractingDimensions();
+  return lhsType.getRank() == batch + 2 && rhsType.getRank() == batch + 2 &&
+         lhsContracting.size() == 1 && lhsContracting[0] == batch + 1 &&
+         rhsContracting.size() == 1 && rhsContracting[0] == batch;
+}
+
+// The f32 values of float8 bits (a ui8 tensor): a convert of their float8 view.
+Value decodeFloat8(OpBuilder &builder, Location loc, Value bits,
+                   Type float8Type) {
+  Value view = builder.create<mlir::stablehlo::BitcastConvertOp>(
+      loc, withElementType(bits.getType(), float8Type), bits);
+  return builder.create<mlir::stablehlo::ConvertOp>(loc, view,
+                                                    builder.getF32Type());
+}
+
+// The float8 bits (a ui8 tensor) of f32 values: a view of their convert.
+Value encodeFloat8(OpBuilder &builder, Location loc, Value value,
+                   Type float8Type) {
+  Value converted =
+      builder.create<mlir::stablehlo::ConvertOp>(loc, value, float8Type);
+  return builder.create<mlir::stablehlo::BitcastConvertOp>(
+      loc,
+      withElementType(value.getType(),
+                      IntegerType::get(builder.getContext(), 8,
+                                       IntegerType::Unsigned)),
+      converted);
+}
+
+// A value of the given type from a converted operand: float8 bits are
+// decoded, other values converted.
+Value toFloat(OpBuilder &builder, Location loc, Value converted,
+              Type originalType, Type elementType) {
+  Value value = converted;
+  if (auto float8Type = getFloat8Type(originalType)) {
+    value = decodeFloat8(builder, loc, converted, float8Type);
+  }
+  if (getElementTypeOrSelf(value.getType()) != elementType) {
+    value = builder.create<mlir::stablehlo::ConvertOp>(loc, value, elementType);
+  }
+  return value;
+}
+
+// stablehlo.convert to or from float8.
+class Float8ConvertOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ConvertOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConvertOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    Type inputType = op.getOperand().getType();
+    Type resultType = op.getType();
+    if (getElementTypeOrSelf(inputType) == getElementTypeOrSelf(resultType)) {
+      rewriter.replaceOp(op, adaptor.getOperand());
+      return success();
+    }
+    auto resultFloat8 = getFloat8Type(resultType);
+    Type computeType = resultFloat8 ? rewriter.getF32Type()
+                                    : getElementTypeOrSelf(resultType);
+    Value value = toFloat(rewriter, op.getLoc(), adaptor.getOperand(),
+                          inputType, computeType);
+    if (resultFloat8) {
+      value = encodeFloat8(rewriter, op.getLoc(), value, resultFloat8);
+    }
+    rewriter.replaceOp(op, value);
+    return success();
+  }
+};
+
+// Float8 constants become constants of their bits.
+class Float8ConstantOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ConstantOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::ConstantOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto type = cast<RankedTensorType>(
+        getTypeConverter()->convertType(op.getType()));
+    auto value = cast<DenseElementsAttr>(op.getValue())
+                     .bitcast(type.getElementType());
+    rewriter.replaceOpWithNewOp<mlir::stablehlo::ConstantOp>(op, type, value);
+    return success();
+  }
+};
+
+// stablehlo.bitcast_convert from or to float8 moves the bits as they are.
+class Float8BitcastConvertOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::BitcastConvertOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::BitcastConvertOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    Type resultType = getTypeConverter()->convertType(op.getType());
+    if (resultType == adaptor.getOperand().getType()) {
+      rewriter.replaceOp(op, adaptor.getOperand());
+    } else {
+      rewriter.replaceOpWithNewOp<mlir::stablehlo::BitcastConvertOp>(
+          op, resultType, adaptor.getOperand());
+    }
+    return success();
+  }
+};
+
+// A dot_general with a float8 result accumulates in f32 and rounds to the
+// result type. One that the matrix unit can't run on its float8 operands (a
+// float8 operand with another type, or a layout other than [batch..., M, K] x
+// [batch..., K, N]) computes on the decoded values.
+class Float8DotGeneralOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::DotGeneralOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::DotGeneralOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto resultFloat8 = getFloat8Type(op.getType());
+    Value lhs, rhs;
+    if (hasNativeFloat8Operands(op)) {
+      lhs = rewriter.create<mlir::stablehlo::BitcastConvertOp>(
+          op.getLoc(), op.getLhs().getType(), adaptor.getLhs());
+      rhs = rewriter.create<mlir::stablehlo::BitcastConvertOp>(
+          op.getLoc(), op.getRhs().getType(), adaptor.getRhs());
+    } else {
+      // Float8 values are exact in bfloat16; an f32 operand keeps the other
+      // in f32.
+      Type computeType = rewriter.getBF16Type();
+      for (Type operandType : op->getOperandTypes()) {
+        Type element = getElementTypeOrSelf(operandType);
+        if (!isFloat8(element) && element != computeType) {
+          computeType = rewriter.getF32Type();
+        }
+      }
+      lhs = toFloat(rewriter, op.getLoc(), adaptor.getLhs(),
+                    op.getLhs().getType(), computeType);
+      rhs = toFloat(rewriter, op.getLoc(), adaptor.getRhs(),
+                    op.getRhs().getType(), computeType);
+    }
+    Type resultType = resultFloat8
+                          ? withElementType(op.getType(), rewriter.getF32Type())
+                          : op.getType();
+    Value result = rewriter.create<mlir::stablehlo::DotGeneralOp>(
+        op.getLoc(), resultType, lhs, rhs, op.getDotDimensionNumbersAttr(),
+        op.getPrecisionConfigAttr(), op.getAlgorithmAttr());
+    if (resultFloat8) {
+      result = encodeFloat8(rewriter, op.getLoc(), result, resultFloat8);
+    }
+    rewriter.replaceOp(op, result);
+    return success();
+  }
+};
+
+// Ops that only move values, which move the bits: data movement, Shardy's
+// collectives and reshards (sdy.all_slice composites), and control flow (and
+// shard_map's sdy.manual_computation), which carries them through its regions.
+// Custom calls move them only as sharding annotations do: others, such as
+// mhlo.topk, mhlo.erf or tt.sampling, compute on the values instead of
+// comparing or adding their bits.
+bool movesBits(Operation *op) {
+  if (auto call = dyn_cast<mlir::stablehlo::CustomCallOp>(op)) {
+    static constexpr StringLiteral targets[] = {
+        "Sharding", "SPMDFullToShardShape", "SPMDShardToFullShape",
+        "xla.sdy.FuncResultSharding"};
+    return llvm::is_contained(targets, call.getCallTargetName());
+  }
+  if (auto composite = dyn_cast<mlir::stablehlo::CompositeOp>(op)) {
+    return composite.getName() == "sdy.all_slice";
+  }
+  return isa<mlir::stablehlo::AllGatherOp, mlir::stablehlo::AllToAllOp,
+             mlir::stablehlo::BroadcastInDimOp, mlir::stablehlo::CaseOp,
+             mlir::stablehlo::CollectivePermuteOp,
+             mlir::stablehlo::ConcatenateOp, mlir::stablehlo::DynamicSliceOp,
+             mlir::stablehlo::DynamicUpdateSliceOp, mlir::stablehlo::GatherOp,
+             mlir::stablehlo::GetTupleElementOp, mlir::stablehlo::IfOp,
+             mlir::stablehlo::OptimizationBarrierOp, mlir::stablehlo::PadOp,
+             mlir::stablehlo::ReshapeOp, mlir::stablehlo::ReturnOp,
+             mlir::stablehlo::ReverseOp, mlir::stablehlo::SelectOp,
+             mlir::stablehlo::SliceOp, mlir::stablehlo::TransposeOp,
+             mlir::stablehlo::TupleOp, mlir::stablehlo::WhileOp,
+             mlir::sdy::ManualComputationOp, mlir::sdy::ReturnOp,
+             mlir::sdy::ShardingConstraintOp>(op);
+}
+
+// Such an op is rebuilt on the bits: its regions take and return ui8 tensors,
+// and the ops in them convert like any others.
+class Float8BitsPattern : public ConversionPattern {
+public:
+  Float8BitsPattern(const TypeConverter &typeConverter, MLIRContext *context)
+      : ConversionPattern(typeConverter, MatchAnyOpTypeTag(), /*benefit=*/1,
+                          context) {}
+
+  LogicalResult
+  matchAndRewrite(Operation *op, ArrayRef<Value> operands,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (!movesBits(op)) {
+      return failure();
+    }
+    SmallVector<Type> resultTypes;
+    if (failed(getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                resultTypes))) {
+      return failure();
+    }
+    OperationState state(op->getLoc(), op->getName(), operands, resultTypes,
+                         llvm::to_vector(op->getDiscardableAttrs()));
+    state.propertiesAttr = op->getPropertiesAsAttribute();
+    for (unsigned i = 0; i < op->getNumRegions(); ++i) {
+      state.addRegion();
+    }
+    Operation *newOp = rewriter.create(state);
+    for (auto [region, newRegion] :
+         llvm::zip_equal(op->getRegions(), newOp->getRegions())) {
+      rewriter.inlineRegionBefore(region, newRegion, newRegion.end());
+      if (failed(rewriter.convertRegionTypes(&newRegion,
+                                             *getTypeConverter()))) {
+        return failure();
+      }
+    }
+    rewriter.replaceOp(op, newOp->getResults());
+    return success();
+  }
+};
+
+// The other StableHLO ops on float8 values compute on them, except those with
+// patterns of their own.
+bool computesOnFloat8(Operation *op) {
+  return isa<mlir::stablehlo::StablehloDialect>(op->getDialect()) &&
+         !isa<mlir::stablehlo::BitcastConvertOp, mlir::stablehlo::CompositeOp,
+              mlir::stablehlo::ConstantOp, mlir::stablehlo::ConvertOp,
+              mlir::stablehlo::DotGeneralOp>(op) &&
+         !movesBits(op) && hasFloat8(op);
+}
+
+// The f32 values of a float8 constant.
+DenseElementsAttr float32Values(mlir::stablehlo::ConstantOp constant) {
+  return cast<DenseFPElementsAttr>(constant.getValue())
+      .mapValues(Float32Type::get(constant.getContext()),
+                 [](const APFloat &value) {
+                   APFloat converted = value;
+                   bool losesInfo;
+                   converted.convert(APFloat::IEEEsingle(),
+                                     APFloat::rmNearestTiesToEven, &losesInfo);
+                   return converted.bitcastToAPInt();
+                 });
+}
+
+// Such an op computes on f32 values instead: the float8 values it uses, as
+// operands or from above its regions (such as a comparator's constants that
+// canonicalization hoisted), are decoded, the float8 values in its regions
+// (reduce, sort, scatter, ...: scalars, such as a comparator's arguments and
+// constants) become f32, and its float8 results are encoded again. A float8
+// constant becomes an f32 constant, which patterns for a reduction's initial
+// value look for.
+void computeInFloat32(Operation *op) {
+  OpBuilder builder(op);
+  Type f32 = builder.getF32Type();
+  auto decode = [&](Value value) -> Value {
+    if (auto constant = value.getDefiningOp<mlir::stablehlo::ConstantOp>()) {
+      return builder.create<mlir::stablehlo::ConstantOp>(
+          op->getLoc(), float32Values(constant));
+    }
+    return builder.create<mlir::stablehlo::ConvertOp>(op->getLoc(), value, f32);
+  };
+  for (OpOperand &operand : op->getOpOperands()) {
+    if (isFloat8(operand.get().getType())) {
+      operand.set(decode(operand.get()));
+    }
+  }
+  SetVector<Value> captured;
+  getUsedValuesDefinedAbove(op->getRegions(), captured);
+  for (Value value : captured) {
+    if (isFloat8(value.getType())) {
+      Value decoded = decode(value);
+      for (Region &region : op->getRegions()) {
+        replaceAllUsesInRegionWith(value, decoded, region);
+      }
+    }
+  }
+  auto toFloat32 = [&](Value value) {
+    if (isFloat8(value.getType())) {
+      value.setType(withElementType(value.getType(), f32));
+    }
+  };
+  op->walk([&](Block *block) {
+    llvm::for_each(block->getArguments(), toFloat32);
+  });
+  op->walk([&](Operation *inner) {
+    if (inner == op) {
+      return;
+    }
+    if (auto constant = dyn_cast<mlir::stablehlo::ConstantOp>(inner);
+        constant && isFloat8(constant.getType())) {
+      constant.setValueAttr(float32Values(constant));
+    }
+    llvm::for_each(inner->getResults(), toFloat32);
+  });
+  builder.setInsertionPointAfter(op);
+  for (OpResult result : op->getResults()) {
+    if (Type float8Type = getFloat8Type(result.getType())) {
+      result.setType(withElementType(result.getType(), f32));
+      auto encoded = builder.create<mlir::stablehlo::ConvertOp>(
+          op->getLoc(), result, float8Type);
+      result.replaceAllUsesExcept(encoded, encoded);
+    }
+  }
+}
+
+// Composites other than Shardy's reshards compute: they become calls of their
+// decomposition, which computes like any other function, instead of reaching a
+// TTIR lowering with the bits.
+class Float8CompositePattern
+    : public OpConversionPattern<mlir::stablehlo::CompositeOp> {
+  using OpConversionPattern::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CompositeOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (movesBits(op)) {
+      return failure();
+    }
+    SmallVector<Type> resultTypes;
+    if (failed(getTypeConverter()->convertTypes(op->getResultTypes(),
+                                                resultTypes))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<func::CallOp>(
+        op, op.getDecomposition(), resultTypes, adaptor.getOperands());
+    return success();
+  }
+};
+
+struct StableHLOFloat8DataTypeConversionPass
+    : public impl::StableHLOFloat8DataTypeConversionPassBase<
+          StableHLOFloat8DataTypeConversionPass> {
+  using impl::StableHLOFloat8DataTypeConversionPassBase<
+      StableHLOFloat8DataTypeConversionPass>::
+      StableHLOFloat8DataTypeConversionPassBase;
+
+  void runOnOperation() override {
+    // Ops that compute on float8 values compute on f32 values first, and the
+    // conversion below stores the remaining float8 values as their bits.
+    bool anyFloat8 = false;
+    SmallVector<Operation *> computing;
+    getOperation()->walk<WalkOrder::PreOrder>([&](Operation *op) {
+      anyFloat8 |= hasFloat8(op);
+      if (computesOnFloat8(op)) {
+        computing.push_back(op);
+        // Its regions compute in f32 with it.
+        return WalkResult::skip();
+      }
+      return WalkResult::advance();
+    });
+    if (!anyFloat8) {
+      return;
+    }
+    for (Operation *op : computing) {
+      computeInFloat32(op);
+    }
+
+    MLIRContext *context = &getContext();
+    TypeConverter typeConverter;
+    typeConverter.addConversion([](Type type) { return type; });
+    typeConverter.addConversion(
+        [context](RankedTensorType type) -> std::optional<Type> {
+          if (!isFloat8(type)) {
+            return std::nullopt;
+          }
+          return withElementType(
+              type, IntegerType::get(context, 8, IntegerType::Unsigned));
+        });
+    // Float8 operands of the dot_generals that stay: views of the bits.
+    auto bitcast = [](OpBuilder &builder, Type type, ValueRange inputs,
+                      Location loc) -> Value {
+      return builder.create<mlir::stablehlo::BitcastConvertOp>(loc, type,
+                                                               inputs[0]);
+    };
+    typeConverter.addSourceMaterialization(bitcast);
+    typeConverter.addTargetMaterialization(bitcast);
+
+    ConversionTarget target(*context);
+    target.markUnknownOpDynamicallyLegal(
+        [](Operation *op) { return !hasFloat8(op); });
+    target.addDynamicallyLegalOp<mlir::stablehlo::DotGeneralOp>(
+        [](mlir::stablehlo::DotGeneralOp op) {
+          return (hasNativeFloat8Operands(op) && !isFloat8(op.getType())) ||
+                 !hasFloat8(op);
+        });
+    target.addDynamicallyLegalOp<mlir::stablehlo::BitcastConvertOp>(
+        [](mlir::stablehlo::BitcastConvertOp op) {
+          auto operand = getElementTypeOrSelf(op.getOperand().getType());
+          auto result = getElementTypeOrSelf(op.getType());
+          return !hasFloat8(op) ||
+                 (operand.isUnsignedInteger(8) && isFloat8(result)) ||
+                 (isFloat8(operand) && result.isUnsignedInteger(8));
+        });
+    // Conversions between float8 and f32 stay, for ttnn's exact typecast.
+    target.addDynamicallyLegalOp<mlir::stablehlo::ConvertOp>(
+        [](mlir::stablehlo::ConvertOp op) {
+          auto operand = getElementTypeOrSelf(op.getOperand().getType());
+          auto result = getElementTypeOrSelf(op.getType());
+          return !hasFloat8(op) || (isFloat8(operand) && result.isF32()) ||
+                 (operand.isF32() && isFloat8(result));
+        });
+    target.addDynamicallyLegalOp<func::FuncOp>([&](func::FuncOp op) {
+      return typeConverter.isSignatureLegal(op.getFunctionType()) &&
+             typeConverter.isLegal(&op.getBody());
+    });
+
+    RewritePatternSet patterns(context);
+    patterns.add<Float8BitcastConvertOpConversionPattern, Float8BitsPattern,
+                 Float8CompositePattern, Float8ConstantOpConversionPattern,
+                 Float8ConvertOpConversionPattern,
+                 Float8DotGeneralOpConversionPattern>(typeConverter, context);
+    populateFunctionOpInterfaceTypeConversionPattern<func::FuncOp>(
+        patterns, typeConverter);
+    populateReturnOpTypeConversionPattern(patterns, typeConverter);
+    populateCallOpTypeConversionPattern(patterns, typeConverter);
+
+    if (failed(applyPartialConversion(getOperation(), target,
+                                      std::move(patterns)))) {
+      signalPassFailure();
+    }
+  }
+};
+
