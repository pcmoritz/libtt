+// A concatenation of slices that cut adjacent ranges of one tensor along the
+// concatenated dimension is a single slice, e.g. rebuilding [q | k | v] from a
+// fused [q | k | v | z] projection.
+class ConcatOfAdjacentSlicesPattern : public mlir::OpRewritePattern<ConcatOp> {
+public:
+  using mlir::OpRewritePattern<ConcatOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(ConcatOp op, mlir::PatternRewriter &rewriter) const final {
+    const int64_t rank = op.getType().getRank();
+    const int64_t dim = op.getDim() < 0 ? op.getDim() + rank : op.getDim();
+    auto values = [](ArrayAttr attr) {
+      return llvm::to_vector(llvm::map_range(attr, [](Attribute value) {
+        return static_cast<int32_t>(mlir::cast<IntegerAttr>(value).getInt());
+      }));
+    };
+    Value source;
+    SmallVector<int32_t> begins, ends;
+    for (Value input : op.getInputs()) {
+      auto slice = input.getDefiningOp<SliceStaticOp>();
+      if (!slice || (source && slice.getInput() != source) ||
+          llvm::any_of(values(slice.getStep()),
+                       [](int32_t step) { return step != 1; })) {
+        return mlir::failure();
+      }
+      auto sliceBegins = values(slice.getBegins());
+      auto sliceEnds = values(slice.getEnds());
+      if (!source) {
+        source = slice.getInput();
+        begins = sliceBegins;
+        ends = sliceEnds;
+        continue;
+      }
+      for (int64_t d = 0; d < rank; ++d) {
+        if (d == dim) {
+          // Along the concatenated dimension, the next slice must start
+          // exactly where the accumulated slices end.
+          if (sliceBegins[d] != ends[d]) {
+            return mlir::failure();
+          }
+        } else {
+          // Along every other dimension, both slices must cover exactly the
+          // same range.
+          if (sliceBegins[d] != begins[d] || sliceEnds[d] != ends[d]) {
+            return mlir::failure();
+          }
+        }
+      }
+      ends[dim] = sliceEnds[dim];
+    }
+    rewriter.replaceOpWithNewOp<SliceStaticOp>(
+        op, op.getType(), source, rewriter.getI32ArrayAttr(begins),
+        rewriter.getI32ArrayAttr(ends),
+        rewriter.getI32ArrayAttr(SmallVector<int32_t>(rank, 1)));
+    return mlir::success();
+  }
+};
+
+// A slice of a row taken through its vector, [1, N] -> [N] -> [n] -> [1, n],
+// is a slice of the row itself, which a tiled tensor cuts in its own layout;
+// the vector would be untilized, cut and tilized again. Any shape with one
+// dimension above 1 is such a row.
+class SliceOfSqueezedRowPattern : public mlir::OpRewritePattern<ReshapeOp> {
+public:
+  using mlir::OpRewritePattern<ReshapeOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(ReshapeOp op, mlir::PatternRewriter &rewriter) const final {
+    auto slice = op.getInput().getDefiningOp<SliceStaticOp>();
+    auto squeeze = slice ? slice.getInput().getDefiningOp<ReshapeOp>() : nullptr;
+    if (!squeeze) {
+      return mlir::failure();
+    }
+    auto row = mlir::cast<RankedTensorType>(squeeze.getInput().getType());
+    auto result = mlir::cast<RankedTensorType>(op.getType());
+    const auto wide = [](int64_t size) { return size != 1; };
+    if (squeeze.getType().getRank() != 1 || result.getRank() != row.getRank() ||
+        llvm::count_if(row.getShape(), wide) != 1) {
+      return mlir::failure();
+    }
+    const int64_t axis = llvm::find_if(row.getShape(), wide) - row.getShape().begin();
+    for (int64_t d = 0; d < row.getRank(); ++d) {
+      if (d != axis && result.getDimSize(d) != 1) {
+        return mlir::failure();
+      }
+    }
+    auto first = [](ArrayAttr attr) {
+      return static_cast<int32_t>(mlir::cast<IntegerAttr>(attr[0]).getInt());
+    };
+    SmallVector<int32_t> begins(row.getRank(), 0), ends(row.getRank(), 1),
+        steps(row.getRank(), 1);
+    begins[axis] = first(slice.getBegins());
+    ends[axis] = first(slice.getEnds());
+    steps[axis] = first(slice.getStep());
+    rewriter.replaceOpWithNewOp<SliceStaticOp>(
+        op, result, squeeze.getInput(), rewriter.getI32ArrayAttr(begins),
+        rewriter.getI32ArrayAttr(ends), rewriter.getI32ArrayAttr(steps));
+    return mlir::success();
+  }
+};
+
+// Rows [a, b) of a row reshaped to a matrix, [1, N] -> [R, C] -> [b - a, C],
+// are the row's columns [a * C, b * C), reshaped. Tiled, rows that start inside
+// a tile are untilized, cut and tilized again, while the row is cut at a tile
+// boundary in one slice. torch_tpu lowers PyTorch's per-head views of a fused
+// projection's q, k and v this way, possibly through a typecast.
+class RowsOfReshapedRowPattern : public mlir::OpRewritePattern<SliceStaticOp> {
+public:
+  using mlir::OpRewritePattern<SliceStaticOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(SliceStaticOp op, mlir::PatternRewriter &rewriter) const final {
+    auto cast = op.getInput().getDefiningOp<TypecastOp>();
+    auto reshape = (cast ? cast.getInput() : op.getInput()).getDefiningOp<ReshapeOp>();
+    if (!reshape) {
+      return mlir::failure();
+    }
+    auto row = mlir::cast<RankedTensorType>(reshape.getInput().getType());
+    auto matrix = mlir::cast<RankedTensorType>(reshape.getType());
+    const auto wide = [](int64_t size) { return size != 1; };
+    const int64_t rank = matrix.getRank();
+    if (rank < 2 || llvm::count_if(row.getShape(), wide) != 1 ||
+        llvm::any_of(matrix.getShape().drop_back(2), wide)) {
+      return mlir::failure();
+    }
+    auto at = [](ArrayAttr attr, int64_t d) {
+      return mlir::cast<IntegerAttr>(attr[d]).getInt();
+    };
+    for (int64_t d = 0; d < rank; ++d) {
+      const bool whole = at(op.getBegins(), d) == 0 && at(op.getEnds(), d) == matrix.getDimSize(d);
+      if (at(op.getStep(), d) != 1 || (d != rank - 2 && !whole)) {
+        return mlir::failure();
+      }
+    }
+    constexpr int64_t kTileDim = 32;
+    const int64_t first = at(op.getBegins(), rank - 2), last = at(op.getEnds(), rank - 2);
+    const int64_t cols = matrix.getDimSize(rank - 1);
+    if (first < 0 || last <= first || first % kTileDim == 0 || first * cols % kTileDim != 0) {
+      return mlir::failure();
+    }
+    const int64_t axis = llvm::find_if(row.getShape(), wide) - row.getShape().begin();
+    SmallVector<int32_t> begins(row.getRank(), 0), ends, steps(row.getRank(), 1);
+    for (int64_t size : row.getShape()) {
+      ends.push_back(static_cast<int32_t>(size));
+    }
+    begins[axis] = first * cols;
+    ends[axis] = last * cols;
+    SmallVector<int64_t> shape(row.getShape());
+    shape[axis] = (last - first) * cols;
+    Value slice = rewriter.create<SliceStaticOp>(
+        op.getLoc(), RankedTensorType::get(shape, row.getElementType(), row.getEncoding()),
+        reshape.getInput(), rewriter.getI32ArrayAttr(begins), rewriter.getI32ArrayAttr(ends),
+        rewriter.getI32ArrayAttr(steps));
+    if (cast) {
+      slice = rewriter.create<TypecastOp>(
+          cast.getLoc(), RankedTensorType::get(shape, op.getType().getElementType(), row.getEncoding()),
+          slice);
+    }
+    rewriter.replaceOp(op, utils::createReshapeOp(rewriter, op.getLoc(), slice,
+                                                  op.getType().getShape()));
+    return mlir::success();
+  }
+};
