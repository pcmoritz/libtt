+::flatbuffers::Offset<::tt::target::ttnn::RowsGatherOp>
+createOp(FlatbufferObjectCache &cache, RowsGatherOp op) {
+  auto table = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getTable()));
+  auto indices = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getIndices()));
+  auto output =
+      cache.getOrCreateNoSharding(op.getResult(), tensorValueToFlatbuffer,
+                                  /*local_shape*/ std::nullopt);
+  std::vector<uint32_t> sizes(op.getSizes().begin(), op.getSizes().end());
+  std::vector<uint32_t> windows(op.getWindows().begin(),
+                                op.getWindows().end());
+  return ::tt::target::ttnn::CreateRowsGatherOpDirect(
+      *cache.fbb, table, indices, output, &sizes, &windows,
+      op.getFillOutOfBounds());
+}
