+  static bool feedsRowMajorReader(OpOperand &use) {
+    Operation *owner = use.getOwner();
+    if (mlir::isa<ttir::EmbeddingOp>(owner)) {
+      return true;
+    }
+    if (auto gather = mlir::dyn_cast<ttir::RowsGatherOp>(owner)) {
+      return use.get() == gather.getTable();
+    }
+    if (auto scatter = mlir::dyn_cast<ttir::RowsScatterOp>(owner)) {
+      return use.get() == scatter.getTable() ||
+             use.get() == scatter.getSource();
+    }
+    if (mlir::isa<ttir::ReshapeOp>(owner)) {
+      return !owner->use_empty() &&
+             llvm::all_of(owner->getUses(), feedsRowMajorReader);
+    }
+    return false;
+  }
