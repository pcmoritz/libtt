--- a/include/ttmlir/Dialect/TTIR/IR/TTIROps.td
+++ b/include/ttmlir/Dialect/TTIR/IR/TTIROps.td
@@ -5579,6 +5579,55 @@ def TTIR_GatherOp : TTIR_NamedOp<"gather"> {
   let hasVerifier = 1;
 }
 
+def TTIR_RowsGatherOp : TTIR_NamedOp<"rows_gather"> {
+  let summary = "Gather rows of a [B, N, R] table by index";
+  let description = [{
+    `table` is a row-major tensor [B, N, R]: B batches of N rows of R elements.
+    `indices` is an int32 tensor [Bi, M, K] with Bi equal to B or 1 (indices
+    shared by every batch). The N rows are the row-major flattening of K
+    dimensions of extents `sizes`; index component k is clamped into
+    [0, sizes[k] - windows[k]] and names windows[k] consecutive positions, so
+    each index position yields W = prod(windows) rows. The result is
+    [B, M * W, R]:
+
+      result[b, m * W + j, :] = table[b, row_j(indices[bi, m, :]), :]
+
+    With `fill_out_of_bounds`, positions whose components needed clamping read
+    as zeros instead. Any element type; rows are moved as bytes.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$table,
+                       AnyRankedTensor:$indices,
+                       DenseI64ArrayAttr:$sizes,
+                       DenseI64ArrayAttr:$windows,
+                       DefaultValuedAttr<BoolAttr, "false">:$fill_out_of_bounds);
+
+  let results = (outs AnyRankedTensor:$result);
+}
+
+def TTIR_RowsScatterOp : TTIR_NamedOp<"rows_scatter"> {
+  let summary = "Scatter rows into a [B, N, R] table by index";
+  let description = [{
+    The counterpart of `rows_gather`: a copy of `table` where, for every index
+    position whose components are all in bounds (others are dropped),
+
+      result[b, row_j(indices[bi, m, :]), :] = source[b, m * W + j, :]
+
+    or, with `reduce` other than invalid, the row reduced (sum, prod, max, min)
+    with the source row. Duplicate positions apply in increasing m, so the
+    result is deterministic. `source` is [B, M * W, R] in the table's type.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$table,
+                       AnyRankedTensor:$indices,
+                       AnyRankedTensor:$source,
+                       DenseI64ArrayAttr:$sizes,
+                       DenseI64ArrayAttr:$windows,
+                       TTCore_ReduceTypeAttr:$reduce);
+
+  let results = (outs AnyRankedTensor:$result);
+}
+
