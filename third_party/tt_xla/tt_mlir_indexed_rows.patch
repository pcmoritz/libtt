+// rows_gather and rows_scatter (ttnn::experimental) move row-major pages as
+// bytes, so every tensor operand and the result are row-major, and read the
+// index components as int32 (uint32 passes as is).
+static TTNNOperandWorkarounds rowsIndexWorkaround(mlir::Value indices) {
+  TTNNOperandWorkarounds workaround;
+  workaround.tensorLayoutWorkaround = Layout::RowMajor;
+  Type elementType =
+      mlir::cast<RankedTensorType>(indices.getType()).getElementType();
+  if (!elementType.isInteger(32)) {
+    workaround.tensorDataTypeWorkaround = ttcore::DataType::Int32;
+  }
+  return workaround;
+}
+
+TTNNOperandsWorkarounds
+TTNNOperandsWorkaroundsFactory::createRowsGatherOpOperandsWorkarounds(
+    mlir::Operation *op) {
+  auto gather = mlir::cast<ttnn::RowsGatherOp>(op);
+  TTNNOperandWorkarounds rowMajor;
+  rowMajor.tensorLayoutWorkaround = Layout::RowMajor;
+  return TTNNOperandsWorkarounds::createEmptyTTNNOperandsWorkarounds()
+      .addInputOperandWorkaround(rowMajor)                             // table
+      .addInputOperandWorkaround(rowsIndexWorkaround(gather.getIndices()))
+      .addOutputOperandWorkaround(rowMajor);
+}
+
+TTNNOperandsWorkarounds
+TTNNOperandsWorkaroundsFactory::createRowsScatterOpOperandsWorkarounds(
+    mlir::Operation *op) {
+  auto scatter = mlir::cast<ttnn::RowsScatterOp>(op);
+  TTNNOperandWorkarounds rowMajor;
+  rowMajor.tensorLayoutWorkaround = Layout::RowMajor;
+  return TTNNOperandsWorkarounds::createEmptyTTNNOperandsWorkarounds()
+      .addInputOperandWorkaround(rowMajor)                             // table
+      .addInputOperandWorkaround(rowsIndexWorkaround(scatter.getIndices()))
+      .addInputOperandWorkaround(rowMajor)                             // source
+      .addOutputOperandWorkaround(rowMajor);
+}
