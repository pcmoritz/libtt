 private:
+  static bool isSineScatterApply(Region &region) {
+    if (!region.hasOneBlock()) {
+      return false;
+    }
+    Block &block = region.front();
+    if (block.getNumArguments() != 2 ||
+        block.getTerminator()->getNumOperands() != 1) {
+      return false;
+    }
+    auto sine = block.getTerminator()
+                    ->getOperand(0)
+                    .getDefiningOp<mlir::stablehlo::SineOp>();
+    return sine && sine.getOperand() == block.getArgument(0);
+  }
+
+  FailureOr<SmallVector<int64_t>>
+  getBatchedScatterPermutation(mlir::stablehlo::ScatterOp op) const {
+    auto dims = op.getScatterDimensionNumbers();
+    ArrayRef<int64_t> inputBatchDims = dims.getInputBatchingDims();
+    ArrayRef<int64_t> indexBatchDims = dims.getScatterIndicesBatchingDims();
+    auto inputType =
+        mlir::cast<RankedTensorType>(op.getInputs()[0].getType());
+    auto updateType =
+        mlir::cast<RankedTensorType>(op.getUpdates()[0].getType());
+    if (inputType.getRank() != updateType.getRank() ||
+        inputBatchDims.size() != indexBatchDims.size() ||
+        dims.getScatterDimsToOperandDims().size() != 1) {
+      return failure();
+    }
+
+    llvm::DenseMap<int64_t, int64_t> batchDimMap;
+    for (auto [inputDim, indexDim] :
+         llvm::zip(inputBatchDims, indexBatchDims)) {
+      batchDimMap[indexDim] = inputDim;
+    }
+
+    llvm::DenseSet<int64_t> updateWindowDims(
+        dims.getUpdateWindowDims().begin(), dims.getUpdateWindowDims().end());
+    SmallVector<int64_t> updateScatterDims;
+    for (int64_t dim = 0; dim < updateType.getRank(); ++dim) {
+      if (!updateWindowDims.contains(dim)) {
+        updateScatterDims.push_back(dim);
+      }
+    }
+
+    SmallVector<int64_t> scatterIndexDims;
+    auto indexType =
+        mlir::cast<RankedTensorType>(op.getScatterIndices().getType());
+    for (int64_t dim = 0; dim < indexType.getRank(); ++dim) {
+      if (dim != dims.getIndexVectorDim()) {
+        scatterIndexDims.push_back(dim);
+      }
+    }
+    if (updateScatterDims.size() != scatterIndexDims.size()) {
+      return failure();
+    }
+
+    SmallVector<int64_t> permutation(inputType.getRank(), -1);
+    int64_t scatterDim = dims.getScatterDimsToOperandDims()[0];
+    for (auto [updateDim, indexDim] :
+         llvm::zip(updateScatterDims, scatterIndexDims)) {
+      auto batchDim = batchDimMap.find(indexDim);
+      int64_t inputDim =
+          batchDim == batchDimMap.end() ? scatterDim : batchDim->second;
+      if (llvm::is_contained(permutation, inputDim)) {
+        return failure();
+      }
+      permutation[updateDim] = inputDim;
+    }
+
+    llvm::DenseSet<int64_t> nonWindowDims(
+        dims.getInsertedWindowDims().begin(),
+        dims.getInsertedWindowDims().end());
+    nonWindowDims.insert(inputBatchDims.begin(), inputBatchDims.end());
+    SmallVector<int64_t> inputWindowDims;
+    for (int64_t dim = 0; dim < inputType.getRank(); ++dim) {
+      if (!nonWindowDims.contains(dim)) {
+        inputWindowDims.push_back(dim);
+      }
+    }
+    if (inputWindowDims.size() != dims.getUpdateWindowDims().size()) {
+      return failure();
+    }
+    for (auto [updateDim, inputDim] :
+         llvm::zip(dims.getUpdateWindowDims(), inputWindowDims)) {
+      if (permutation[updateDim] != -1 ||
+          llvm::is_contained(permutation, inputDim)) {
+        return failure();
+      }
+      permutation[updateDim] = inputDim;
+    }
+    if (llvm::is_contained(permutation, -1)) {
+      return failure();
+    }
+    return permutation;
+  }
