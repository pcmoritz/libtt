diff --git a/lib/Dialect/TTNN/Transforms/TTNNDecomposeLayouts.cpp b/lib/Dialect/TTNN/Transforms/TTNNDecomposeLayouts.cpp
--- a/lib/Dialect/TTNN/Transforms/TTNNDecomposeLayouts.cpp
+++ b/lib/Dialect/TTNN/Transforms/TTNNDecomposeLayouts.cpp
@@ -480,8 +480,10 @@
     // device-capable, keeping the typecast on device too.
     if (input.isTiled()) {
       // Untilize on the output dtype (typecast first) when it can run on
-      // device.
-      if (isOnDeviceLayoutChangeSupportedForDataType(output.getDataType())) {
+      // device. UInt8 untilize is supported, and a TILE typecast is cheaper
+      // than a ROW_MAJOR typecast.
+      if (isOnDeviceLayoutChangeSupportedForDataType(output.getDataType()) ||
+          output.getDataType() == ttcore::DataType::UInt8) {
         current = createTypecastOp(rewriter, current, output.getDataType());
         return createLayoutStep(rewriter, current, output, padWorkaround);
       }
@@ -509,6 +509,15 @@
     if (!hasLayoutChange(input, output)) {
       return false;
     }
+    // UInt8 tilizes and untilizes on device, so a UInt8 tensor that is on
+    // device doesn't copy through the host for either: UInt8 argmax consumes
+    // row-major input, and a trace can't hold a host copy. A host tensor still
+    // tilizes on host. Keep the existing tilize/typecast ordering.
+    if (input.getDataType() == ttcore::DataType::UInt8 &&
+        output.getDataType() == ttcore::DataType::UInt8 &&
+        (input.isTiled() || input.isDeviceBufferType())) {
+      return false;
+    }
     return !isOnDeviceLayoutChangeSupportedForDataType(input.getDataType()) &&
            !isOnDeviceLayoutChangeSupportedForDataType(output.getDataType());
   }
