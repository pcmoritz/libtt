--- /dev/null
+++ b/runtime/lib/ttnn/operations/normalization/rms_norm_residual.cpp
@@ -0,0 +1,23 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "operations/normalization/rms_norm_residual.h"
+#include "tt/runtime/detail/ttnn/operations/utils.h"
+#include "tt/runtime/detail/ttnn/utils.h"
+#include "ttnn/operations/normalization/rms_norm_residual/rms_norm_residual.hpp"
+
+namespace tt::runtime::ttnn::operations::rms_norm_residual {
+void run(const ::tt::target::ttnn::RMSNormResidualOp *op,
+         ProgramContext &context) {
+  ProgramTensorPool &pool = context.getTensorPool();
+  const ::ttnn::Tensor &input = pool.getTTNNTensorAndValidate(op->input());
+  const ::ttnn::Tensor &residual =
+      pool.getTTNNTensorAndValidate(op->residual());
+  const ::ttnn::Tensor &weight = pool.getTTNNTensorAndValidate(op->weight());
+  auto outputs = ::ttnn::normalization::rms_norm_residual(
+      input, residual, weight, op->epsilon());
+  pool.insertTTNNTensorAndValidate(op->out(), outputs.at(0));
+  pool.insertTTNNTensorAndValidate(op->sum(), outputs.at(1));
+}
+} // namespace tt::runtime::ttnn::operations::rms_norm_residual
