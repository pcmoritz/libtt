+// Fuses the residual add that feeds a decode RMS norm into the norm, with the
+// sum as a second result since the next layer adds to it:
+//   sum = add(x, r); norm = rms_norm(sum, w)  ->  norm, sum = rms_norm_residual(x, r, w)
+// for one tile row of activations, which the fused program handles.
+class RMSNormResidualFusionPattern : public mlir::OpRewritePattern<RMSNormOp> {
+public:
+  using mlir::OpRewritePattern<RMSNormOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(RMSNormOp op, mlir::PatternRewriter &rewriter) const override {
+    auto add = op.getInput().getDefiningOp<AddOp>();
+    if (!add || !op.getWeight() || op.getBias()) {
+      return failure();
+    }
+    auto type = mlir::cast<RankedTensorType>(op.getInput().getType());
+    constexpr int64_t tile = 32;
+    // The program keeps a core's tiles of every operand and intermediate in
+    // L1: up to ceil(width / 32 / 32) tiles of about 18 KiB each, plus
+    // 24 KiB. A width of 65536 is 64 tiles per core, about 1.2 MiB, which
+    // fits the 1.5 MiB of a Blackhole core.
+    constexpr int64_t maxWidth = 65536;
+    if (type.getRank() != 2 || type.getDimSize(0) < 1 || type.getDimSize(0) > tile ||
+        type.getDimSize(1) % tile != 0 || type.getDimSize(1) > maxWidth ||
+        !type.getElementType().isBF16()) {
+      return failure();
+    }
+    if (op.getNormalizedShape().size() != 1 ||
+        op.getNormalizedShape()[0] != type.getDimSize(1) ||
+        op.getType() != type || add->getOperand(0).getType() != type ||
+        add->getOperand(1).getType() != type) {
+      return failure();
+    }
+    auto weightType = mlir::cast<RankedTensorType>(op.getWeight().getType());
+    if (weightType.getNumElements() != type.getDimSize(1) ||
+        weightType.getDimSize(weightType.getRank() - 1) != type.getDimSize(1)) {
+      return failure();
+    }
+    // The fused op defines both the norm and the sum, so it must go where
+    // the weight is defined and every use of the sum follows: at the norm
+    // when the sum's other uses all come after it (the model's case, where
+    // the weight's cast sits between the add and the norm), else at the add
+    // when the weight is already defined there.
+    if (add->getBlock() != op->getBlock()) {
+      return failure();
+    }
+    const bool usesFollowNorm =
+        llvm::all_of(add->getResult(0).getUsers(), [&](Operation *user) {
+          return user == op || (user->getBlock() == op->getBlock() &&
+                                op->isBeforeInBlock(user));
+        });
+    auto *weightOp = op.getWeight().getDefiningOp();
+    const bool weightBeforeAdd =
+        !weightOp || weightOp->getBlock() != add->getBlock() ||
+        weightOp->isBeforeInBlock(add);
+    if (usesFollowNorm) {
+      rewriter.setInsertionPoint(op);
+    } else if (weightBeforeAdd) {
+      rewriter.setInsertionPoint(add);
+    } else {
+      return failure();
+    }
+    auto fused = rewriter.create<RMSNormResidualOp>(
+        op.getLoc(), TypeRange{op.getType(), type}, add->getOperand(0),
+        add->getOperand(1), op.getWeight(), op.getEpsilonAttr());
+    rewriter.replaceOp(op, fused.getOutput());
+    rewriter.replaceOp(add, fused.getSum());
+    return success();
+  }
+};
