+
+  // Pattern match torch_tpu's ArgMax (GE) and ArgMin (LE) ops. Its body starts
+  // with the comparison, propagates NaNs and breaks ties towards the smaller
+  // index, and returns the maximum (minimum) value and a selected index:
+  //  stablehlo.compare (GE / LE)
+  //  ...
+  //  stablehlo.return %max_or_min, %select
+  bool verifyTorchTpuArgExtremePattern(
+      mlir::Block &block,
+      mlir::stablehlo::ComparisonDirection expectedDirection) const {
+    auto compareOp = mlir::dyn_cast<mlir::stablehlo::CompareOp>(block.front());
+    auto returnOp =
+        mlir::dyn_cast<mlir::stablehlo::ReturnOp>(block.getTerminator());
+    if (!compareOp ||
+        compareOp.getComparisonDirection() != expectedDirection ||
+        !returnOp || returnOp.getNumOperands() != 2) {
+      return false;
+    }
+    mlir::Operation *value = returnOp.getOperand(0).getDefiningOp();
+    bool isMax = expectedDirection == mlir::stablehlo::ComparisonDirection::GE;
+    if (isMax ? !isa_and_nonnull<mlir::stablehlo::MaxOp>(value)
+              : !isa_and_nonnull<mlir::stablehlo::MinOp>(value)) {
+      return false;
+    }
+    return isa_and_nonnull<mlir::stablehlo::SelectOp>(
+        returnOp.getOperand(1).getDefiningOp());
   }
 
   // Pattern match the ops for tt-torch ArgMax op.
