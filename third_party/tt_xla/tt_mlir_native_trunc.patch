+// JAX spells isposinf(x) as x == +inf and isinf(x) as abs(x) == +inf.
+// Recover the predicates so the infinity value never needs to be materialized
+// through a floating-point constant kernel.
+class StableHLOToTTIRInfinityPredicateConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CompareOp> {
+  using OpConversionPattern<mlir::stablehlo::CompareOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CompareOp srcOp,
+                  mlir::stablehlo::CompareOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (srcOp.getComparisonDirection() !=
+        mlir::stablehlo::ComparisonDirection::EQ) {
+      return failure();
+    }
+
+    Value input;
+    Value convertedInput;
+    if (isPositiveInfinityConstant(srcOp.getRhs())) {
+      input = srcOp.getLhs();
+      convertedInput = adaptor.getLhs();
+    } else if (isPositiveInfinityConstant(srcOp.getLhs())) {
+      input = srcOp.getRhs();
+      convertedInput = adaptor.getRhs();
+    } else {
+      return failure();
+    }
+
+    auto resultType = dyn_cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    if (!resultType) {
+      return failure();
+    }
+
+    if (input.getDefiningOp<mlir::stablehlo::AbsOp>()) {
+      auto convertedAbs = convertedInput.getDefiningOp<ttir::AbsOp>();
+      if (!convertedAbs) {
+        return failure();
+      }
+      rewriter.replaceOpWithNewOp<ttir::IsInfOp>(
+          srcOp, resultType, convertedAbs.getInput());
+    } else {
+      rewriter.replaceOpWithNewOp<ttir::IsPosInfOp>(srcOp, resultType,
+                                                    convertedInput);
+    }
+    return success();
+  }
+};
+} // namespace
