+namespace {
+// JAX lowers trunc(x) to select(x < 0, ceil(x), floor(x)). Recover the
+// original operation so TTNN can run its single truncation kernel.
+class StableHLOToTTIRTruncSelectConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::SelectOp> {
+  using OpConversionPattern<mlir::stablehlo::SelectOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::SelectOp srcOp,
+                  mlir::stablehlo::SelectOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto compare = srcOp.getPred().getDefiningOp<mlir::stablehlo::CompareOp>();
+    auto ceil = srcOp.getOnTrue().getDefiningOp<mlir::stablehlo::CeilOp>();
+    auto floor = srcOp.getOnFalse().getDefiningOp<mlir::stablehlo::FloorOp>();
+    if (!compare || !ceil || !floor ||
+        compare.getComparisonDirection() !=
+            mlir::stablehlo::ComparisonDirection::LT) {
+      return failure();
+    }
+
+    Value input = compare.getLhs();
+    if (ceil.getOperand() != input || floor.getOperand() != input) {
+      return failure();
+    }
+
+    Value zero = compare.getRhs();
+    while (auto broadcast =
+               zero.getDefiningOp<mlir::stablehlo::BroadcastInDimOp>()) {
+      zero = broadcast.getOperand();
+    }
+    auto constant = zero.getDefiningOp<mlir::stablehlo::ConstantOp>();
+    if (!constant || !checkInitValue(constant, TypicalInitReductionValue::ZERO)) {
+      return failure();
+    }
+
+    auto convertedCeil =
+        adaptor.getOnTrue().getDefiningOp<mlir::tt::ttir::CeilOp>();
+    auto convertedFloor =
+        adaptor.getOnFalse().getDefiningOp<mlir::tt::ttir::FloorOp>();
+    if (!convertedCeil || !convertedFloor ||
+        convertedCeil.getInput() != convertedFloor.getInput()) {
+      return failure();
+    }
+
+    auto resultType = dyn_cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getType()));
+    rewriter.replaceOpWithNewOp<mlir::tt::ttir::TruncOp>(
+        srcOp, resultType, convertedCeil.getInput());
     return success();
   }
 };
