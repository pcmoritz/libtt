+std::unique_ptr<ErrorInstance>
+ErrorInstance::makeError(tt_pjrt_status status, std::string message) {
+  if (tt_pjrt_status_is_ok(status)) {
+    return nullptr;
+  }
+
+  struct make_unique_enabler : public ErrorInstance {
+    make_unique_enabler(tt_pjrt_status status, std::string message)
+        : ErrorInstance(status, std::move(message)) {}
+  };
+
+  return std::make_unique<make_unique_enabler>(status, std::move(message));
+}
