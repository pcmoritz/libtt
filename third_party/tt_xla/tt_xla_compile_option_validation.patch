+    const std::unordered_map<std::string, std::string> &compile_options) {
+  // TT-specific options consumed by CompileOptions::parse().
+  static const std::unordered_set<std::string> supported_options = {
+      "optimization_level",
+      "experimental_weight_dtype",
+      "experimental-kv-cache-dtype",
+      "math_fidelity",
+      "fp32_dest_acc_en",
+      "experimental_enable_fusing_conv2d_with_multiply_pattern",
+      "backend",
+      "enable_trace",
+      "export_tensors",
+      "enable_const_eval",
+      "enable_const_eval_on_cpu",
+      "enable_const_eval_inputs_to_system_memory",
+      "experimental_enable_permute_matmul_fusion",
+      "codegen_try_recover_structure",
+      "codegen_split_files",
+      "experimental-enable-dram-space-saving-optimization",
+      "enable_create_d2m_subgraphs",
+      "ttnn_perf_metrics_enabled",
+      "ttnn_perf_metrics_output_file",
+      "dry_run",
+      "export_path",
+      "export_model_name",
+      // Common XLA/JAX options that are safe for this backend to accept even
+      // though they do not affect TT code generation.
+      "xla_embed_ir_in_executable",
+      "xla_dump_max_hlo_modules",
+      "xla_gpu_auto_spmd_partitioning_memory_budget_ratio",
+      "exec_time_optimization_effort",
+      "memory_fitting_level",
+      "fdo_profile",
+      "xla_gpu_enable_command_buffer",
+      "xla_gpu_enable_latency_hiding_scheduler",
+      "xla_gpu_enable_triton_gemm",
+      "xla_dump_to",
+      "xla_gpu_experimental_dump_fdo_profiles",
+      "xla_gpu_graph_min_graph_size",
+      "xla_allow_excess_precision",
+  };
+
+  static const std::unordered_set<std::string> bool_options = {
+      "fp32_dest_acc_en",
+      "experimental_enable_fusing_conv2d_with_multiply_pattern",
+      "enable_trace",
+      "export_tensors",
+      "enable_const_eval",
+      "enable_const_eval_on_cpu",
+      "enable_const_eval_inputs_to_system_memory",
+      "experimental_enable_permute_matmul_fusion",
+      "codegen_try_recover_structure",
+      "codegen_split_files",
+      "experimental-enable-dram-space-saving-optimization",
+      "enable_create_d2m_subgraphs",
+      "ttnn_perf_metrics_enabled",
+      "dry_run",
+      "xla_embed_ir_in_executable",
+      "xla_allow_excess_precision",
+  };
+
+  for (const auto &[key, value] : compile_options) {
+    if (!supported_options.contains(key)) {
+      return ErrorInstance::makeError(
+          tt_pjrt_status::kInvalidArgument,
+          "No such compile option: '" + key + "'");
+    }
+    if (bool_options.contains(key) && value != "true" && value != "false" &&
+        value != "1" && value != "0" && value != "yes" && value != "no" &&
+        value != "on" && value != "off") {
+      return ErrorInstance::makeError(
+          tt_pjrt_status::kInvalidArgument,
+          "'" + value + "' is not a valid bool value.");
+    }
+  }
+  return nullptr;
+}
