diff --git a/pjrt_implementation/src/api/compile_options.cc b/pjrt_implementation/src/api/compile_options.cc
--- a/pjrt_implementation/src/api/compile_options.cc
+++ b/pjrt_implementation/src/api/compile_options.cc
@@ -12,2 +12,3 @@
 #include <unordered_map>
+#include <unordered_set>
 
@@ -143,2 +144,48 @@ CompileOptions CompileOptions::parse(
 
+std::optional<std::string> CompileOptions::validate(
+    const std::unordered_map<std::string, std::string> &compile_options) {
+  static const std::unordered_set<std::string> supported_options = {
+      optimization_level_key,
+      "experimental_weight_dtype",
+      "experimental-kv-cache-dtype",
+      "math_fidelity",
+      "fp32_dest_acc_en",
+      "experimental_enable_fusing_conv2d_with_multiply_pattern",
+      "backend",
+      "enable_trace",
+      "export_tensors",
+      "enable_const_eval",
+      "enable_const_eval_on_cpu",
+      "enable_const_eval_inputs_to_system_memory",
+      "experimental_enable_permute_matmul_fusion",
+      "codegen_try_recover_structure",
+      "codegen_split_files",
+      "experimental-enable-dram-space-saving-optimization",
+      "enable_create_d2m_subgraphs",
+      "ttnn_perf_metrics_enabled",
+      "ttnn_perf_metrics_output_file",
+      "dry_run",
+      "export_path",
+      "export_model_name",
+      // XLA consumes these options. TT-XLA has no equivalent behavior, but
+      // accepts them for PJRT compatibility.
+      "xla_embed_ir_in_executable",
+      "xla_dump_max_hlo_modules",
+      "xla_gpu_auto_spmd_partitioning_memory_budget_ratio",
+  };
+
+  for (const auto &[name, value] : compile_options) {
+    if (!supported_options.contains(name)) {
+      return "No such compile option: '" + name + "'";
+    }
+
+    if (name == "xla_embed_ir_in_executable" && value != "true" &&
+        value != "false") {
+      return "'" + value + "' is not a valid bool value.";
+    }
+  }
+
+  return std::nullopt;
+}
