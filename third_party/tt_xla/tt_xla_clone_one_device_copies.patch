diff --git a/pjrt_implementation/inc/api/tensor.h b/pjrt_implementation/inc/api/tensor.h
--- a/pjrt_implementation/inc/api/tensor.h
+++ b/pjrt_implementation/inc/api/tensor.h
@@ -135,6 +135,12 @@
   // Moves pjrt tensor to host.
   void move_to_host() noexcept;
 
+  // Whether this is a buffer of one device holding the same data on every chip
+  // of the mesh in use (LoadedExecutableInstance::getOrCreateMeshDevice).
+  // Copies of it to other devices are made on the device, and a replicated
+  // input made of such copies takes the first one's runtime tensor.
+  bool on_every_chip() const;
+
 private:
   static PjrtTensor &from_shards(const std::vector<BufferInstance *> &shards);
   static uint64_t next_uid();
diff --git a/pjrt_implementation/src/api/buffer_instance.cc b/pjrt_implementation/src/api/buffer_instance.cc
--- a/pjrt_implementation/src/api/buffer_instance.cc
+++ b/pjrt_implementation/src/api/buffer_instance.cc
@@ -537,6 +537,18 @@
           getDataType(), getDimensionsRaw(), getNumberOfDimensions(),
           dst_device, dst_memory);
 
+  // A buffer of one device holding the same data on every chip is copied on
+  // the device, without a transfer through the host or a wait for the device.
+  PjrtTensorRef &source = getPjrtTensor();
+  if (source && source->on_every_chip()) {
+    PjrtTensor::from_runtime_tensor(
+        {dst_buffer_instance.get()},
+        tt::runtime::cloneTensor(source->runtime_tensor()));
+    dst_buffer_instance->markAsDataReady();
+    *dst_buffer = dst_buffer_instance.release();
+    return tt_pjrt_status::kSuccess;
+  }
+
   dst_buffer_instance->copyFromBuffer(this);
 
   *dst_buffer = dst_buffer_instance.release();
diff --git a/pjrt_implementation/src/api/tensor.cc b/pjrt_implementation/src/api/tensor.cc
--- a/pjrt_implementation/src/api/tensor.cc
+++ b/pjrt_implementation/src/api/tensor.cc
@@ -11,6 +11,7 @@
 #include "api/tensor.h"
 
 // c++ standard library includes
+#include <algorithm>
 #include <memory>
 #include <optional>
 #include <unordered_map>
@@ -45,10 +46,26 @@
   if (have_same_tensor(shards))
     return from_shards(shards);
 
+  // Buffers of one device that each hold their data on every chip, such as
+  // copies of a program over one device's result, already make a replicated
+  // input.
+  if (strategy.at("strategy") == "replicate" &&
+      std::all_of(shards.begin(), shards.end(), [](BufferInstance *shard) {
+        return shard->getPjrtTensor()->on_every_chip();
+      })) {
+    return from_runtime_tensor(shards,
+                               shards.front()->getPjrtTensor()->runtime_tensor());
+  }
+
   return from_runtime_tensor(
       shards, rt_tensor_from_strategy(shards, strategy, mesh_shape));
 }
 
+bool PjrtTensor::on_every_chip() const {
+  return m_shards.size() == 1 && m_runtime_tensor.has_value() &&
+         tt::runtime::detail::getNumShards(*m_runtime_tensor) > 1;
+}
