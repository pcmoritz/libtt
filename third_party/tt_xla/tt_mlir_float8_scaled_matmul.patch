+// If value views the bits of a transposed matrix as another type, as the
+// float8 data type conversion leaves a transposed float8 matrix
+// (bitcast_convert of the permuted ui8 bits), return the untransposed matrix's
+// view, so that the transpose fuses into the matmul like any other.
+static std::optional<mlir::TypedValue<mlir::RankedTensorType>>
+getBitcastPermuteOpOperand(mlir::PatternRewriter &rewriter,
+                           mlir::TypedValue<mlir::RankedTensorType> value) {
+  auto bitcast = value.getDefiningOp<BitcastConvertOp>();
+  if (!bitcast || !bitcast->hasOneUse()) {
+    return std::nullopt;
+  }
+  auto input = getPermuteOpOperand(bitcast.getInput());
+  if (!input || isConstantOrParameterArgument(*input)) {
+    return std::nullopt;
+  }
+  return rewriter
+      .create<BitcastConvertOp>(
+          bitcast.getLoc(),
+          input->getType().clone(value.getType().getElementType()), *input)
+      .getResult();
+}
