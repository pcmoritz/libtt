+// A dot_general of float8 values converted to f32 or bfloat16, as
+// torch._scaled_mm's lowering emits, reads the float8 values instead: the
+// conversions are exact, and the matrix unit adds the exact products in f32.
+// It computes in f32, and its result is converted to the original type.
+void readConvertedFloat8Operands(mlir::stablehlo::DotGeneralOp op) {
+  auto lhs = op.getLhs().getDefiningOp<mlir::stablehlo::ConvertOp>();
+  auto rhs = op.getRhs().getDefiningOp<mlir::stablehlo::ConvertOp>();
+  if (!lhs || !rhs || !isFloat8(lhs.getOperand().getType()) ||
+      !isFloat8(rhs.getOperand().getType()) || op.getAlgorithmAttr()) {
+    return;
+  }
+  auto isF32OrBF16 = [](Type type) {
+    Type elementType = getElementTypeOrSelf(type);
+    return elementType.isF32() || elementType.isBF16();
+  };
+  if (!isF32OrBF16(lhs.getType()) || !isF32OrBF16(rhs.getType()) ||
+      !isF32OrBF16(op.getType())) {
+    return;
+  }
+  OpBuilder builder(op);
+  auto dot = builder.create<mlir::stablehlo::DotGeneralOp>(
+      op.getLoc(), withElementType(op.getType(), builder.getF32Type()),
+      lhs.getOperand(), rhs.getOperand(), op.getDotDimensionNumbersAttr(),
+      op.getPrecisionConfigAttr(), /*algorithm=*/nullptr);
+  if (!hasNativeFloat8Operands(dot)) {
+    dot.erase();
+    return;
+  }
+  Value result = dot;
+  if (result.getType() != op.getType()) {
+    result = builder.create<mlir::stablehlo::ConvertOp>(
+        op.getLoc(), result, getElementTypeOrSelf(op.getType()));
+  }
+  op.replaceAllUsesWith(result);
+  op.erase();
+  if (lhs->use_empty()) {
+    lhs.erase();
+  }
+  if (rhs != lhs && rhs->use_empty()) {
+    rhs.erase();
+  }
+}
