+namespace {
+// Each device's index in the mesh: partition an iota over the mesh so that
+// every device keeps its own element.
+class StableHLOToTTIRPartitionIdOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::PartitionIdOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::PartitionIdOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::PartitionIdOp srcOp,
+                  mlir::stablehlo::PartitionIdOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult().getType()));
+    Type elementType = outputType.getElementType();
+    llvm::SmallVector<int64_t> meshShape{1};
+    if (auto meshes = srcOp->getParentOfType<mlir::ModuleOp>()
+                          ->getAttrOfType<ttcore::MeshesAttr>(
+                              ttcore::MeshesAttr::name);
+        meshes && !meshes.getMeshes().empty()) {
+      meshShape = llvm::to_vector(meshes.getMeshes()[0].getShape());
+    }
+
+    llvm::SmallVector<APInt> ids;
+    for (int64_t id = 0, e = ttmlir::utils::volume<int64_t>(meshShape); id < e;
+         ++id) {
+      ids.push_back(APInt(elementType.getIntOrFloatBitWidth(), id));
+    }
+    mlir::Value current = rewriter.create<ttir::ConstantOp>(
+        srcOp.getLoc(), RankedTensorType::get(meshShape, elementType),
+        DenseElementsAttr::get(RankedTensorType::get(meshShape, elementType),
+                               ids));
+    llvm::SmallVector<int64_t> shape(meshShape);
+    for (auto [axis, size] : llvm::enumerate(meshShape)) {
+      if (size == 1) {
+        continue;
+      }
+      shape[axis] = 1;
+      current = rewriter.create<ttir::MeshPartitionOp>(
+          srcOp.getLoc(), RankedTensorType::get(shape, elementType), current,
+          rewriter.getSI32IntegerAttr(axis), rewriter.getUI32IntegerAttr(axis));
+    }
+    rewriter.replaceOpWithNewOp<ttir::ReshapeOp>(
+        srcOp, outputType, current,
+        rewriter.getI32ArrayAttr(
+            llvm::to_vector_of<int32_t>(outputType.getShape())));
+    return success();
+  }
+};
+} // namespace
