 private:
+  // ttir.all_reduce only sums. For max and min, gather the replica group's
+  // values along a new leading dimension and reduce it locally.
+  static mlir::Value gatherAndReduce(Location loc, mlir::Value input,
+                                     RankedTensorType outputType,
+                                     ttcore::ReduceType reduceType,
+                                     uint32_t clusterAxis, int64_t groupSize,
+                                     ConversionPatternRewriter &rewriter) {
+    llvm::SmallVector<int64_t> shape{1};
+    llvm::append_range(shape, outputType.getShape());
+    auto unsqueezed = rewriter.create<ttir::ReshapeOp>(
+        loc, RankedTensorType::get(shape, outputType.getElementType()), input,
+        rewriter.getI32ArrayAttr(llvm::to_vector_of<int32_t>(shape)));
+    shape[0] = groupSize;
+    auto gathered = rewriter.create<ttir::AllGatherOp>(
+        loc, RankedTensorType::get(shape, outputType.getElementType()),
+        unsqueezed, /*all_gather_dim=*/0, clusterAxis);
+    auto keepDim = rewriter.getBoolAttr(false);
+    auto dims = rewriter.getI32ArrayAttr({0});
+    if (reduceType == ttcore::ReduceType::Max) {
+      return rewriter.create<ttir::MaxOp>(loc, outputType, gathered, keepDim,
+                                          dims);
+    }
+    return rewriter.create<ttir::MinOp>(loc, outputType, gathered, keepDim,
+                                        dims);
+  }
