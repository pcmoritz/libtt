+// Scatter assignment copies the trailing real/imag dimension as a window.
+// Keep the update body scalar: assignment acts independently on each component.
+class ComplexScatterOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ScatterOp> {
+  using OpConversionPattern<mlir::stablehlo::ScatterOp>::OpConversionPattern;
+
+public:
+  LogicalResult matchAndRewrite(
+      mlir::stablehlo::ScatterOp op, OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    if (op.getInputs().size() != 1 || !op.getUpdateComputation().hasOneBlock()) {
+      return failure();
+    }
+    Block &body = op.getUpdateComputation().front();
+    if (body.getOperations().size() != 1 || body.getNumArguments() != 2 ||
+        body.getTerminator()->getOperand(0) != body.getArgument(1)) {
+      return rewriter.notifyMatchFailure(op, "expected scatter assignment");
+    }
+
+    auto resultType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(op.getResult(0).getType()));
+    auto updateType =
+        mlir::cast<RankedTensorType>(adaptor.getUpdates().front().getType());
+    auto dims = op.getScatterDimensionNumbers();
+    SmallVector<int64_t> windowDims(dims.getUpdateWindowDims());
+    windowDims.push_back(updateType.getRank() - 1);
+    auto newDims = mlir::stablehlo::ScatterDimensionNumbersAttr::get(
+        rewriter.getContext(), windowDims, dims.getInsertedWindowDims(),
+        dims.getInputBatchingDims(), dims.getScatterIndicesBatchingDims(),
+        dims.getScatterDimsToOperandDims(), dims.getIndexVectorDim());
+    auto scatter = rewriter.create<mlir::stablehlo::ScatterOp>(
+        op.getLoc(), TypeRange{resultType}, adaptor.getInputs(),
+        adaptor.getScatterIndices(), adaptor.getUpdates(), newDims,
+        op.getIndicesAreSorted(), op.getUniqueIndices());
+    {
+      OpBuilder::InsertionGuard guard(rewriter);
+      auto scalar = RankedTensorType::get({}, resultType.getElementType());
+      Block *block = rewriter.createBlock(&scatter.getUpdateComputation(), {},
+                                          {scalar, scalar},
+                                          {op.getLoc(), op.getLoc()});
+      rewriter.create<mlir::stablehlo::ReturnOp>(op.getLoc(), block->getArgument(1));
+    }
+    rewriter.replaceOp(op, scatter.getResults());
+    return success();
+  }
+};
