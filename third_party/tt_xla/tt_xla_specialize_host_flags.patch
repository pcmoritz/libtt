+  // Compiles arguments with given values as constants, after the pipeline has
+  // dropped the sharding constraints that would hide them. The folder then
+  // inlines the branch a conditional on them selects.
+  if (!constant_arguments.empty()) {
+    auto main = mlir_module->lookupSymbol<mlir::func::FuncOp>("main");
+    mlir::OpBuilder builder(&main.getBody().front(),
+                            main.getBody().front().begin());
+    for (auto [index, value] : constant_arguments) {
+      mlir::BlockArgument argument = main.getArgument(index);
+      argument.replaceAllUsesWith(builder.create<mlir::stablehlo::ConstantOp>(
+          argument.getLoc(),
+          mlir::DenseElementsAttr::get(
+              mlir::cast<mlir::ShapedType>(argument.getType()), value)));
+    }
+    mlir::stablehlo::StablehloAggressiveFolderPassOptions folding;
+    folding.optimizeFloat = false;
+    mlir::PassManager pm(mlir_module.get()->getName());
+    pm.addNestedPass<mlir::func::FuncOp>(
+        mlir::stablehlo::createStablehloAggressiveFolderPass(folding));
+    if (mlir::failed(pm.run(mlir_module.get()))) {
+      return {tt_pjrt_status::kInternal, nullptr};
+    }
+  }
