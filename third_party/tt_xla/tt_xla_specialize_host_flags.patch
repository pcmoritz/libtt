diff --git a/pjrt_implementation/src/api/flatbuffer_loaded_executable_instance.cc b/pjrt_implementation/src/api/flatbuffer_loaded_executable_instance.cc
--- a/pjrt_implementation/src/api/flatbuffer_loaded_executable_instance.cc
+++ b/pjrt_implementation/src/api/flatbuffer_loaded_executable_instance.cc
@@ -189,6 +189,32 @@
   DLOG_F(LOG_DEBUG, "FlatbufferLoadedExecutableInstance::Execute");
   LOG_BRINGUP_STAGE("RUNTIME_EXECUTION_START");
 
+  std::vector<std::pair<size_t, bool>> flags;
+  for (size_t arg = 0; m_specializer && arg < args->num_args; ++arg) {
+    std::optional<bool> flag =
+        BufferInstance::unwrap(args->argument_lists[0][arg])->getHostFlag();
+    for (size_t device = 1; flag && device < args->num_devices; ++device) {
+      if (BufferInstance::unwrap(args->argument_lists[device][arg])
+              ->getHostFlag() != flag) {
+        flag.reset();
+      }
+    }
+    if (flag) {
+      flags.emplace_back(arg, *flag);
+    }
+  }
+  if (!flags.empty()) {
+    std::unique_lock<std::mutex> lock(m_specializations_mutex);
+    auto [specialization, inserted] = m_specializations.try_emplace(flags);
+    if (inserted) {
+      specialization->second = m_specializer(flags);
+    }
+    if (LoadedExecutableInstance *specialized = specialization->second.get()) {
+      lock.unlock();
+      return specialized->execute(args);
+    }
+  }
+
   if (args->num_devices != m_executable_image->getNumDevicesToUtilize()) {
     LOG_F(ERROR, "Device count mismatch: %zu vs %zu", args->num_devices,
           m_executable_image->getNumDevicesToUtilize());
