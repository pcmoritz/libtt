+struct OneChipPlacement {
+  // The chip of the inputs held there only. Without one, the inputs hold their
+  // data on every chip or on the host, and so does each result.
+  std::optional<std::size_t> chip;
+  // Inputs that are shards of mesh tensors, given as views of those at `chip`.
+  std::vector<std::size_t> views;
+};
+
+// For a program over one chip on a mesh of several, returns where it runs:
+// ttnn runs each op on the chips its inputs occupy. A shard of a mesh tensor is
+// given as its view at its chip, unless the tensor is replicated and the shard
+// not donated. A program may update a donated input in place, after which the
+// shards of the tensor no longer all hold the same data. An input on another
+// chip than the others moves to the host and reaches every chip from there.
+std::optional<OneChipPlacement> oneChipPlacement(
+    PJRT_LoadedExecutable_Execute_Args *args, const tt::runtime::Device &device,
+    const std::unordered_set<size_t> &donated_indices) {
+  if (args->num_devices != 1) {
+    return std::nullopt;
+  }
+  const std::vector<std::uint32_t> shape = tt::runtime::getMeshShape(device);
+  const std::size_t chips = std::accumulate(
+      shape.begin(), shape.end(), std::size_t{1}, std::multiplies<>{});
+  if (chips <= 1) {
+    return std::nullopt;
+  }
+  OneChipPlacement placement;
+  for (size_t arg = 0; arg < args->num_args; ++arg) {
+    BufferInstance *buffer =
+        BufferInstance::unwrap(args->argument_lists[0][arg]);
+    PjrtTensorRef &tensor = buffer->getPjrtTensor();
+    if (!tensor->has_runtime_tensor()) {
+      continue;
+    }
+    const std::vector<BufferInstance *> &shards = tensor->shards();
+    std::optional<std::size_t> chip = tensor->chip();
+    const bool view =
+        shards.size() > 1 &&
+        tt::runtime::detail::getNumShards(tensor->runtime_tensor()) == chips &&
+        !(tensor->on_every_chip() && !donated_indices.count(arg));
+    if (view) {
+      chip = static_cast<std::size_t>(
+          std::find(shards.begin(), shards.end(), buffer) - shards.begin());
+    }
+    if (!chip.has_value()) {
+      continue;
+    }
+    if (placement.chip.has_value() && *placement.chip != *chip) {
+      tensor->move_to_host();
+      continue;
+    }
+    placement.chip = chip;
+    if (view) {
+      if (donated_indices.count(arg)) {
+        tensor->set_replicated(false);
+      }
+      placement.views.push_back(arg);
+    }
+  }
+  return placement;
+}
+
