+// For a program over one chip on a mesh of several, returns the position of the
+// chip whose result is the program's: that of its inputs already on the mesh.
+// An input on another chip, and a donated input whose runtime tensor other
+// buffers share, moves to the host and reaches every chip from there.
+std::optional<std::size_t> oneChipMeshIndex(
+    PJRT_LoadedExecutable_Execute_Args *args, const tt::runtime::Device &device,
+    const std::unordered_set<size_t> &donated_indices) {
+  if (args->num_devices != 1) {
+    return std::nullopt;
+  }
+  const std::vector<std::uint32_t> shape = tt::runtime::getMeshShape(device);
+  const std::size_t chips = std::accumulate(
+      shape.begin(), shape.end(), std::size_t{1}, std::multiplies<>{});
+  if (chips <= 1) {
+    return std::nullopt;
+  }
+  std::optional<std::size_t> index;
+  for (size_t arg = 0; arg < args->num_args; ++arg) {
+    BufferInstance *buffer =
+        BufferInstance::unwrap(args->argument_lists[0][arg]);
+    PjrtTensorRef &tensor = buffer->getPjrtTensor();
+    if (!tensor->has_runtime_tensor() ||
+        tt::runtime::detail::getNumShards(tensor->runtime_tensor()) != chips) {
+      continue;
+    }
+    const std::vector<BufferInstance *> &shards = tensor->shards();
+    const bool shared = shards.size() > 1;
+    const std::size_t position =
+        shared ? static_cast<std::size_t>(
+                     std::find(shards.begin(), shards.end(), buffer) -
+                     shards.begin())
+               : tensor->mesh_index();
+    if ((shared && donated_indices.count(arg)) ||
+        (index.has_value() && *index != position)) {
+      tensor->move_to_host();
+      continue;
+    }
+    index = position;
+  }
+  return index.value_or(0);
+}
+
+} // namespace
