+void ClientInstance::setMeshDeviceIds(std::vector<int> device_ids) {
+  if (!m_mesh_device_ids.empty() && m_mesh_device_ids != device_ids) {
+    TensorPool::move_tensors_to_host();
+  }
+  m_mesh_device_ids = std::move(device_ids);
+}
+
+std::optional<std::size_t> ClientInstance::chipOfDevice(int device_id) const {
+  auto chip = std::find(m_mesh_device_ids.begin(), m_mesh_device_ids.end(),
+                        device_id);
+  if (chip == m_mesh_device_ids.end()) {
+    return std::nullopt;
+  }
+  return static_cast<std::size_t>(chip - m_mesh_device_ids.begin());
+}
