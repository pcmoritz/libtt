+tt::runtime::Tensor PjrtTensor::chip_view(std::size_t position) const {
+  std::vector<tt::runtime::Tensor> views =
+      tt::runtime::getDeviceTensors(runtime_tensor());
+  TT_FATAL(position < views.size(),
+           "Chip {} out of range for a tensor over {} chips", position,
+           views.size());
+  return std::move(views[position]);
+}
