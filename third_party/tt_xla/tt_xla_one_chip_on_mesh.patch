+std::size_t chipCount(const tt::runtime::Device &device) {
+  const std::vector<std::uint32_t> shape = tt::runtime::getMeshShape(device);
+  return std::accumulate(shape.begin(), shape.end(), std::size_t{1},
+                         std::multiplies<>{});
+}
+
+// For a buffer given to a program over one chip of a mesh of `chips`, returns
+// the buffer's chip if it is a shard of a tensor spanning the mesh: its
+// position among the shards. The program gets the shard's view at that chip.
+std::optional<std::size_t> meshShardChip(BufferInstance *buffer,
+                                         std::size_t chips) {
+  PjrtTensorRef &tensor = buffer->getPjrtTensor();
+  const std::vector<BufferInstance *> &shards = tensor->shards();
+  if (chips <= 1 || shards.size() <= 1 || !tensor->has_runtime_tensor() ||
+      tt::runtime::detail::getNumShards(tensor->runtime_tensor()) != chips) {
+    return std::nullopt;
+  }
+  return static_cast<std::size_t>(
+      std::find(shards.begin(), shards.end(), buffer) - shards.begin());
+}
+
+// For a program over one chip on a mesh of several, returns the chip of its
+// inputs held there only: shards of mesh tensors and results of other such
+// programs. Without one, its inputs hold their data on every chip or on the
+// host, and so does each result. Meshes of the same shape share one submesh,
+// so one device's data can be on different chips of it; an input on another
+// chip than the first moves to the host and reaches every chip from there.
+std::optional<std::size_t> oneChip(PJRT_LoadedExecutable_Execute_Args *args,
+                                   std::size_t chips) {
+  if (args->num_devices != 1 || chips <= 1) {
+    return std::nullopt;
+  }
+  std::optional<std::size_t> one_chip;
+  for (size_t arg = 0; arg < args->num_args; ++arg) {
+    BufferInstance *buffer =
+        BufferInstance::unwrap(args->argument_lists[0][arg]);
+    std::optional<std::size_t> chip = meshShardChip(buffer, chips);
+    if (!chip.has_value()) {
+      chip = buffer->getPjrtTensor()->chip();
+    }
+    if (!chip.has_value()) {
+      continue;
+    }
+    if (one_chip.has_value() && *one_chip != *chip) {
+      buffer->getPjrtTensor()->move_to_host();
+      continue;
+    }
+    one_chip = chip;
+  }
+  return one_chip;
+}
+
