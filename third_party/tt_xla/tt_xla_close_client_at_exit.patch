+// torch_tpu never destroys its client, so its device stayed open at exit, and
+// with the fabric's routers still running, the chips' ethernet cores didn't
+// come up for the next process without a board reset.
+void GlobalClientInstanceSingleton::closeAtExit() {
+  GlobalClientInstanceSingleton &singleton_instance = getInstance();
+  std::lock_guard<std::mutex> lock(singleton_instance.m_mutex);
+  if (singleton_instance.isInitialized()) {
+    DLOG_F(LOG_DEBUG, "Closing a client that is still alive at exit");
+    singleton_instance.m_client_instance.reset();
+    singleton_instance.m_ref_count = 0;
+  }
+}
+
 GlobalClientInstanceSingleton &GlobalClientInstanceSingleton::getInstance() {
   // Process-wide, since a framework may create and destroy the client on
   // different threads. Never destroyed: a client that is still alive at exit
@@ -885,7 +900,18 @@ ClientInstance::openMeshDevice(const std::vector<uint32_t> &mesh_shape) {
       .traceRegionSize = traceRegionSize,
   };
 
-  return tt::runtime::openMeshDevice(options);
+  tt::runtime::Device device = tt::runtime::openMeshDevice(options);
+  // Registered once the device is open, so that it runs before tt-metal's
+  // statics are destroyed.
+  static std::once_flag close_at_exit;
+  std::call_once(close_at_exit, [] {
+    std::atexit([] {
+      // A new thread: the exiting thread's tt-metal thread-local state may
+      // already be gone.
+      std::thread(GlobalClientInstanceSingleton::closeAtExit).join();
+    });
+  });
+  return device;
 }
 
