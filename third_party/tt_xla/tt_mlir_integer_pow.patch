@@ -110,6 +110,48 @@
 // As soon as tenstorrent/tt-metal#16618 is finished, this decomposition can be
 // removed.
 namespace {
+// The device computes integer powers exactly on 32-bit tiles, wrapping like
+// int32 multiplication. A narrower integer power widens to int32 and wraps the
+// result to its width: the low bits of the 32-bit power are the narrow one.
+struct NarrowIntegerPowPattern : public OpConversionPattern<ttir::PowOp> {
+  using OpConversionPattern<ttir::PowOp>::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(ttir::PowOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    auto type = mlir::cast<RankedTensorType>(op.getType());
+    auto intType = mlir::dyn_cast<IntegerType>(type.getElementType());
+    if (!intType || intType.getWidth() == 1 || intType.getWidth() >= 32) {
+      return rewriter.notifyMatchFailure(op, "not a narrow integer power");
+    }
+    Location loc = op.getLoc();
+    auto widen = [&](mlir::Value value) -> mlir::Value {
+      auto valueType = mlir::cast<RankedTensorType>(value.getType());
+      return rewriter.create<ttir::TypecastOp>(
+          loc, valueType.clone(rewriter.getIntegerType(32)), value);
+    };
+    auto i32Type = type.clone(rewriter.getIntegerType(32));
+    mlir::Value result = rewriter.create<ttir::PowOp>(
+        loc, i32Type, widen(adaptor.getLhs()), widen(adaptor.getRhs()));
+    auto constant = [&](int32_t value) -> mlir::Value {
+      return rewriter.create<ttir::FullOp>(loc, i32Type,
+                                           rewriter.getI32IntegerAttr(value));
+    };
+    // Wrap to the width: mask, and sign-extend signed types.
+    unsigned width = intType.getWidth();
+    result = rewriter.create<ttir::BitwiseAndOp>(
+        loc, i32Type, result, constant(static_cast<int32_t>((1u << width) - 1)));
+    if (!intType.isUnsigned()) {
+      mlir::Value signBit = constant(1 << (width - 1));
+      result = rewriter.create<ttir::SubtractOp>(
+          loc, i32Type,
+          rewriter.create<ttir::BitwiseXorOp>(loc, i32Type, result, signBit),
+          signBit);
+    }
+    rewriter.replaceOpWithNewOp<ttir::TypecastOp>(op, type, result);
+    return success();
+  }
+};
