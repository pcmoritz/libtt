+// The PJRT coordinator carries host metadata only; tensor traffic uses
+// TT-Fabric.
+static libtt::KeyValueStore
+createKeyValueStore(const PJRT_Client_Create_Args &args) {
+  if (!args.kv_get_callback || !args.kv_put_callback)
+    throw std::invalid_argument(
+        "Multi-process TT requires JAX coordinator callbacks");
+  PJRT_CallbackError makeError = [](PJRT_Error_Code, const char *message,
+                                    size_t size) -> PJRT_Error * {
+    return *ErrorInstance::makeError(tt_pjrt_status::kInternal,
+                                     std::string(message, size))
+                .release();
+  };
+  auto checkError = [](PJRT_Error *error) {
+    if (error) {
+      std::string message = ErrorInstance::unwrap(error)->getMessage();
+      delete ErrorInstance::unwrap(error);
+      throw std::runtime_error(message);
+    }
+  };
+  return {
+      .put =
+          [callback = args.kv_put_callback, user = args.kv_put_user_arg,
+           makeError,
+           checkError](std::string_view key, std::string_view value) mutable {
+            PJRT_KeyValuePutCallback_Args request{};
+            request.struct_size = PJRT_KeyValuePutCallback_Args_STRUCT_SIZE;
+            request.key = key.data();
+            request.key_size = key.size();
+            request.value = value.data();
+            request.value_size = value.size();
+            request.callback_error = &makeError;
+            request.user_arg = user;
+            checkError(callback(&request));
+          },
+      .get =
+          [callback = args.kv_get_callback, user = args.kv_get_user_arg,
+           makeError, checkError](std::string_view key) mutable {
+            PJRT_KeyValueGetCallback_Args request{};
+            request.struct_size = PJRT_KeyValueGetCallback_Args_STRUCT_SIZE;
+            request.key = key.data();
+            request.key_size = key.size();
+            request.timeout_in_ms = 120000;
+            request.callback_error = &makeError;
+            request.user_arg = user;
+            checkError(callback(&request));
+            std::unique_ptr<char, PJRT_KeyValueGetCallback_ValueDeleter> value(
+                request.value, request.value_deleter_callback);
+            return std::string(value.get(), request.value_size);
+          }};
+}
+
+static tt::runtime::SystemDesc
+gatherSystemDescriptors(const tt::runtime::SystemDesc &local,
+                        const libtt::KeyValueStore &store, int rank, int size,
+                        std::vector<int> &owners) {
+  namespace metal = tt::tt_metal::distributed;
+  const auto mapping =
+      metal::SystemMesh::instance().get_mapped_devices(std::nullopt);
+  // System descriptors enumerate local devices in physical-ID order. JAX device
+  // IDs instead follow the global mesh, including positions owned by other
+  // hosts.
+  std::vector<std::pair<int, int>> localIds;
+  for (size_t i = 0; i < mapping.device_ids.size(); ++i)
+    if (mapping.device_ids[i].is_local())
+      localIds.emplace_back(mapping.device_ids[i].value(), i);
+  std::sort(localIds.begin(), localIds.end());
+  if (localIds.size() != local->chip_desc_indices()->size())
+    throw std::runtime_error("System mesh and local descriptor disagree");
+  std::ostringstream ids;
+  for (const auto &[physicalId, globalId] : localIds)
+    ids << globalId << ' ';
+  const std::string prefix = "libtt/devices/";
+  store.put(prefix + std::to_string(rank) + "/ids", ids.str());
+  std::vector<uint8_t> bytes;
+  local.storeToMemory(bytes);
+  store.put(prefix + std::to_string(rank) + "/desc",
+            std::string_view(reinterpret_cast<const char *>(bytes.data()),
+                             bytes.size()));
+
+  auto merged =
+      tt::target::UnPackSizePrefixedSystemDescRoot(local.handle.get());
+  auto &desc = *merged->system_desc;
+  const size_t count = mapping.device_ids.size();
+  desc.chip_descs.clear();
+  desc.chip_descs.resize(count);
+  desc.chip_desc_indices.resize(count);
+  std::iota(desc.chip_desc_indices.begin(), desc.chip_desc_indices.end(), 0);
+  desc.chip_capabilities.resize(count);
+  desc.chip_channels.clear();
+  owners.assign(count, -1);
+  for (int process = 0; process < size; ++process) {
+    const auto descriptor =
+        store.get(prefix + std::to_string(process) + "/desc");
+    flatbuffers::Verifier verifier(
+        reinterpret_cast<const uint8_t *>(descriptor.data()),
+        descriptor.size());
+    if (!tt::target::VerifySizePrefixedSystemDescRootBuffer(verifier))
+      throw std::runtime_error("Invalid remote system descriptor");
+    auto remote =
+        tt::target::UnPackSizePrefixedSystemDescRoot(descriptor.data());
+    std::istringstream mappingIds(
+        store.get(prefix + std::to_string(process) + "/ids"));
+    for (size_t i = 0; i < remote->system_desc->chip_desc_indices.size(); ++i) {
+      size_t id;
+      if (!(mappingIds >> id) || id >= count || owners[id] != -1)
+        throw std::runtime_error("Inconsistent global device ownership");
+      const auto chipIndex = remote->system_desc->chip_desc_indices[i];
+      desc.chip_descs[id] = std::make_unique<tt::target::ChipDescT>(
+          *remote->system_desc->chip_descs.at(chipIndex));
+      desc.chip_capabilities[id] = remote->system_desc->chip_capabilities.at(i);
+      owners[id] = process;
+    }
+  }
+  if (std::find(owners.begin(), owners.end(), -1) != owners.end())
+    throw std::runtime_error("A global mesh device has no JAX process owner");
+  flatbuffers::FlatBufferBuilder builder;
+  auto root = tt::target::SystemDescRoot::Pack(builder, merged.get());
+  tt::target::FinishSizePrefixedSystemDescRootBuffer(builder, root);
+  return tt::runtime::SystemDesc::loadFromMemory(builder.GetBufferPointer(),
+                                                 builder.GetSize());
+}
 
