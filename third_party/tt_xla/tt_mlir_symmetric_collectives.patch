+// Collectives between processes need their buffers at equal addresses on
+// every chip (see utils::runSymmetricCollective). Reserve a DRAM region for
+// them while the allocators of all processes are still identical. Leaked so
+// that it outlives static destruction.
+static auto &symmetricDram = *new std::map<
+    const ::ttnn::MeshDevice *,
+    std::shared_ptr<::tt::tt_metal::distributed::MeshBuffer>>();
+
+static void reserveSymmetricDram(::ttnn::MeshDevice &meshDevice) {
+  using namespace ::tt::tt_metal::distributed;
+  if (*multihost::DistributedContext::get_current_world()->size() <= 1) {
+    return;
+  }
+  const char *megabytes = std::getenv("LIBTT_SYMMETRIC_DRAM_MB");
+  const uint64_t size = (megabytes ? std::stoull(megabytes) : 2048) << 20;
+  constexpr uint64_t pageSize = 1 << 20;
+  auto buffer = MeshBuffer::create(
+      ReplicatedBufferConfig{.size = size},
+      DeviceLocalBufferConfig{.page_size = pageSize,
+                              .buffer_type = ::ttnn::BufferType::DRAM,
+                              .bottom_up = false},
+      &meshDevice);
+  const uint64_t sizePerBank =
+      buffer->get_reference_buffer()->aligned_size_per_bank();
+  meshDevice.allocator()->set_symmetric_dram(buffer->address(), sizePerBank);
+  utils::setSymmetricDramSizePerBank(meshDevice, sizePerBank);
+  symmetricDram[&meshDevice] = std::move(buffer);
+}
