+namespace {
+// Allocates the calling thread's DRAM buffers from the symmetric region while
+// it lives, until the collective returns or throws.
+class SymmetricDramScope {
+public:
+  explicit SymmetricDramScope(::tt::tt_metal::Allocator &allocator)
+      : allocator(allocator) {
+    allocator.begin_symmetric_dram();
+  }
+  ~SymmetricDramScope() { allocator.end_symmetric_dram(); }
+  SymmetricDramScope(const SymmetricDramScope &) = delete;
+  SymmetricDramScope &operator=(const SymmetricDramScope &) = delete;
+
+private:
+  ::tt::tt_metal::Allocator &allocator;
+};
+
+// The tensor a collective that runs in the symmetric region writes.
+std::optional<std::uint32_t>
+symmetricCollectiveOutput(const ::tt::target::ttnn::Operation &op) {
+  switch (op.type_type()) {
+  case ::tt::target::ttnn::OpType::AllGatherOp:
+    return op.type_as_AllGatherOp()->out()->global_id();
+  case ::tt::target::ttnn::OpType::AllReduceOp:
+    return op.type_as_AllReduceOp()->out()->global_id();
+  case ::tt::target::ttnn::OpType::AllReduceAsyncOp:
+    return op.type_as_AllReduceAsyncOp()->out()->global_id();
+  case ::tt::target::ttnn::OpType::ReduceScatterOp:
+    return op.type_as_ReduceScatterOp()->out()->global_id();
+  default:
+    return std::nullopt;
+  }
+}
+
+// Whether op runs other programs, whose collectives reuse the region too.
+bool runsPrograms(const ::tt::target::ttnn::Operation &op) {
+  switch (op.type_type()) {
+  case ::tt::target::ttnn::OpType::CaseOp:
+  case ::tt::target::ttnn::OpType::WhileLoopOp:
+  case ::tt::target::ttnn::OpType::FuncCallOp:
+  case ::tt::target::ttnn::OpType::LoadCachedOp:
+  case ::tt::target::ttnn::OpType::CaptureOrExecuteTraceOp:
+  case ::tt::target::ttnn::OpType::ExecuteTraceOp:
+    return true;
+  default:
+    return false;
+  }
+}
+
+// Whether op only reads its inputs into new tensors: its results neither view
+// nor are an input.
+bool writesNewTensors(const ::tt::target::ttnn::Operation &op) {
+  switch (op.type_type()) {
+  case ::tt::target::ttnn::OpType::RMSNormOp:
+  case ::tt::target::ttnn::OpType::RMSNormResidualOp:
+  case ::tt::target::ttnn::OpType::MatmulOp:
+  case ::tt::target::ttnn::OpType::LinearOp:
+    return true;
+  case ::tt::target::ttnn::OpType::TypecastOp: {
+    const auto *typecast = op.type_as_TypecastOp();
+    return typecast->dtype() !=
+           typecast->in()->desc()->layout()->memory_desc()->data_type();
+  }
+  default:
+    return false;
+  }
+}
+
+// The tensors written by the program's collectives that it frees, with the
+// reshapes of them, before its next collective, reading them until then only
+// into new tensors: such a result can stay in the region.
+std::unordered_set<std::uint32_t>
+freedBeforeNextCollective(const ::tt::target::ttnn::Program &program) {
+  const auto &ops = *program.operations();
+  std::unordered_set<std::uint32_t> freed;
+  for (std::uint32_t i = 0; i < ops.size(); ++i) {
+    const std::optional<std::uint32_t> output =
+        symmetricCollectiveOutput(*ops.Get(i));
+    if (!output) {
+      continue;
+    }
+    // The result and its views (a reshape may share its buffer).
+    std::unordered_set<std::uint32_t> live = {*output};
+    for (std::uint32_t j = i + 1; j < ops.size() && !live.empty(); ++j) {
+      const ::tt::target::ttnn::Operation &op = *ops.Get(j);
+      if (symmetricCollectiveOutput(op) || runsPrograms(op)) {
+        break;
+      }
+      if (const auto *deallocate = op.type_as_DeallocateOp()) {
+        live.erase(deallocate->in()->global_id());
+        continue;
+      }
+      auto handle = ::tt::runtime::utils::unsafeBorrowShared(
+          const_cast<::tt::target::ttnn::Operation *>(&op));
+      bool reads = false;
+      for (const TensorRef &ref :
+           getOpInputRefs(OpContext(handle, DeviceRuntime::TTNN))) {
+        // Absent optional operands are null.
+        reads = reads ||
+                (ref.handle &&
+                 live.count(ref.as<::tt::target::ttnn::TensorRef>(
+                                   DeviceRuntime::TTNN)
+                                .global_id()));
+      }
+      if (!reads) {
+        continue;
+      }
+      if (const auto *reshape = op.type_as_ReshapeOp()) {
+        live.insert(reshape->out()->global_id());
+      } else if (!writesNewTensors(op)) {
+        break;
+      }
+    }
+    if (live.empty()) {
+      freed.insert(*output);
+    }
+  }
+  return freed;
+}
+
+// freedBeforeNextCollective of the program context runs, found once per
+// program.
+bool freedBeforeNextCollective(ProgramContext &context,
+                               std::uint32_t outputId) {
+  static std::mutex mutex;
+  static auto &cache = *new std::map<std::pair<std::uint64_t, std::size_t>,
+                                     std::unordered_set<std::uint32_t>>();
+  const std::lock_guard<std::mutex> lock(mutex);
+  const std::pair<std::uint64_t, std::size_t> key = {
+      context.getExecutableHandle().id(), context.getProgramIndex()};
+  auto it = cache.find(key);
+  if (it == cache.end()) {
+    it = cache
+             .emplace(key, freedBeforeNextCollective(*getProgram(
+                               context.getExecutableHandle(),
+                               context.getProgramIndex())))
+             .first;
+  }
+  return it->second.count(outputId) != 0;
+}
+} // namespace
+
+::ttnn::Tensor
+runSymmetricCollective(ProgramContext &context, std::uint32_t outputId,
+                       ::ttnn::MeshDevice &device,
+                       const std::function<::ttnn::Tensor()> &collective) {
+  ::tt::tt_metal::Allocator &allocator = *device.allocator();
+  if (!allocator.has_symmetric_dram()) {
+    return collective();
+  }
+  ::ttnn::Tensor result;
+  {
+    SymmetricDramScope scope(allocator);
+    result = collective();
+  }
+  // A result the program frees before its next collective is read in place:
+  // that collective's peers write to this chip's region only once it runs it.
+  if (freedBeforeNextCollective(context, outputId)) {
+    return result;
+  }
+  // Copied out after the scope ends, outside the region the next collective
+  // reuses.
+  return ::ttnn::clone(result, std::nullopt, std::nullopt, std::nullopt);
+}
+
 } // namespace tt::runtime::ttnn::utils
