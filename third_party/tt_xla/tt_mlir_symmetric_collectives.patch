+// of `input` split along a dimension other than `collectiveDim`, their results
+// concatenated.
+::ttnn::Tensor runCollectiveInPieces(
+    const ::ttnn::Tensor &input, int32_t collectiveDim,
+    double bytesPerInputByte, uint64_t budgetPerBank,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig,
