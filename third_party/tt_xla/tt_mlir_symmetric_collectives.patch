+namespace {
+// Allocates the calling thread's DRAM buffers from the symmetric region while
+// it lives, until the collective returns or throws.
+class SymmetricDramScope {
+public:
+  explicit SymmetricDramScope(::tt::tt_metal::Allocator &allocator)
+      : allocator(allocator) {
+    allocator.begin_symmetric_dram();
+  }
+  ~SymmetricDramScope() { allocator.end_symmetric_dram(); }
+  SymmetricDramScope(const SymmetricDramScope &) = delete;
+  SymmetricDramScope &operator=(const SymmetricDramScope &) = delete;
+
+private:
+  ::tt::tt_metal::Allocator &allocator;
+};
+} // namespace
+
+::ttnn::Tensor
+runSymmetricCollective(::ttnn::MeshDevice &device,
+                       const std::function<::ttnn::Tensor()> &collective) {
+  ::tt::tt_metal::Allocator &allocator = *device.allocator();
+  if (!allocator.has_symmetric_dram()) {
+    return collective();
+  }
+  ::ttnn::Tensor result;
+  {
+    SymmetricDramScope scope(allocator);
+    result = collective();
+  }
+  // Copied out after the scope ends, outside the region the next collective
+  // reuses.
+  return ::ttnn::clone(result, std::nullopt, std::nullopt, std::nullopt);
+}
+
+namespace {
+std::mutex symmetricDramSizesMutex;
+std::map<const ::ttnn::MeshDevice *, uint64_t> &symmetricDramSizes() {
+  // Leaked so that it outlives static destruction.
+  static auto &sizes = *new std::map<const ::ttnn::MeshDevice *, uint64_t>();
+  return sizes;
+}
+} // namespace
+
+void setSymmetricDramSizePerBank(const ::ttnn::MeshDevice &device,
+                                 uint64_t size) {
+  std::lock_guard<std::mutex> lock(symmetricDramSizesMutex);
+  if (size) {
+    symmetricDramSizes()[&device] = size;
+  } else {
+    symmetricDramSizes().erase(&device);
+  }
+}
+
+::ttnn::Tensor runSymmetricCollectiveInPieces(
+    const ::ttnn::Tensor &input, int32_t collectiveDim,
+    double regionBytesPerInputByte,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig,
+    const std::function<::ttnn::Tensor(const ::ttnn::Tensor &)> &collective) {
+  ::ttnn::MeshDevice &device = *input.device();
+  auto whole = [&] {
+    return runSymmetricCollective(device, [&] { return collective(input); });
+  };
+  uint64_t sizePerBank = 0;
+  {
+    std::lock_guard<std::mutex> lock(symmetricDramSizesMutex);
+    auto it = symmetricDramSizes().find(&device);
+    if (it != symmetricDramSizes().end()) {
+      sizePerBank = it->second;
+    }
+  }
+  if (!sizePerBank || !input.memory_config().is_dram() ||
+      input.memory_config().is_sharded()) {
+    return whole();
+  }
+  // Buffers are interleaved over the DRAM banks; 10% for their page rounding.
+  const double bytesPerBank =
+      regionBytesPerInputByte * input.physical_volume() *
+      input.element_size() /
+      device.allocator()->get_num_banks(::ttnn::BufferType::DRAM);
+  const auto pieces =
+      static_cast<uint32_t>(std::ceil(bytesPerBank / (0.9 * sizePerBank)));
+  if (pieces <= 1) {
+    return whole();
+  }
+
+  // Split the dimension with the most units (tiles in the two tiled
+  // dimensions) into `pieces` runs of units.
+  const ::ttnn::Shape &shape = input.logical_shape();
+  const int32_t rank = static_cast<int32_t>(shape.rank());
+  const int32_t skip = collectiveDim < 0 ? collectiveDim + rank : collectiveDim;
+  const bool tiled = input.layout() == ::ttnn::Layout::TILE;
+  const auto tileShape = input.tensor_spec().tile().get_tile_shape();
+  int32_t splitDim = -1;
+  uint32_t unit = 1;
+  uint32_t units = 0;
+  for (int32_t dim = 0; dim < rank; ++dim) {
+    const uint32_t dimUnit =
+        !tiled || dim < rank - 2 ? 1 : tileShape[dim - (rank - 2)];
+    if (dim == skip || shape[dim] % dimUnit != 0 ||
+        shape[dim] / dimUnit <= units) {
+      continue;
+    }
+    splitDim = dim;
+    unit = dimUnit;
+    units = shape[dim] / dimUnit;
+  }
+  if (splitDim < 0 || units < pieces) {
+    return whole();
+  }
+
+  const uint32_t unitsPerPiece = (units + pieces - 1) / pieces;
+  ::ttsl::SmallVector<uint32_t> begins(rank, 0);
+  ::ttsl::SmallVector<uint32_t> ends(shape.cbegin(), shape.cend());
+  const ::ttsl::SmallVector<uint32_t> steps(rank, 1);
+  std::vector<::ttnn::Tensor> results;
+  for (uint32_t start = 0; start < units; start += unitsPerPiece) {
+    begins[splitDim] = start * unit;
+    ends[splitDim] = std::min(units, start + unitsPerPiece) * unit;
+    ::ttnn::Tensor piece = ::ttnn::slice(input, begins, ends, steps);
+    results.push_back(
+        runSymmetricCollective(device, [&] { return collective(piece); }));
+  }
+  return ::ttnn::concat(results, splitDim, outputMemoryConfig);
+}
+
 } // namespace tt::runtime::ttnn::utils
