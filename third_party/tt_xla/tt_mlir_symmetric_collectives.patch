+// Collectives between processes write to their peers at the addresses of
+// their own buffers, which the processes' allocators need not keep equal.
+// With a symmetric DRAM region (reserved when the mesh opened), runs
+// `collective` with its buffers there and copies its result out before the
+// next collective reuses the region.
+::ttnn::Tensor
+runSymmetricCollective(::ttnn::MeshDevice &device,
+                       const std::function<::ttnn::Tensor()> &collective);
+
+// The size of `device`'s symmetric DRAM region in each DRAM bank, 0 without
+// one.
+void setSymmetricDramSizePerBank(const ::ttnn::MeshDevice &device,
+                                 uint64_t size);
+
+// runSymmetricCollective of `collective` on `input`. When the collective's
+// buffers in the region (`regionBytesPerInputByte` times the input's size)
+// would overflow it, it runs on pieces of `input` split along a dimension
+// other than `collectiveDim`, and their results are concatenated.
+::ttnn::Tensor runSymmetricCollectiveInPieces(
+    const ::ttnn::Tensor &input, int32_t collectiveDim,
+    double regionBytesPerInputByte,
+    const std::optional<::ttnn::MemoryConfig> &outputMemoryConfig,
+    const std::function<::ttnn::Tensor(const ::ttnn::Tensor &)> &collective);
+
