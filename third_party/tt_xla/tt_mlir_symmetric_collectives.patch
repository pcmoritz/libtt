     meshDevice->disable_and_clear_program_cache();
   }
+  reserveSymmetricDram(*meshDevice);
 
   LOG_DEBUG("Device grid size = { ",
             meshDevice->compute_with_storage_grid_size().x, ", ",
@@ -936,6 +967,10 @@ void closeMeshDevice(Device parentMesh) {
 #if defined(TT_RUNTIME_ENABLE_PERF_TRACE) && TT_RUNTIME_ENABLE_PERF_TRACE == 1
   ::tt::tt_metal::ReadMeshDeviceProfilerResults(ttnnMeshDevice);
 #endif
+  if (symmetricDram.count(&ttnnMeshDevice)) {
+    ttnnMeshDevice.allocator()->set_symmetric_dram(0, 0);
