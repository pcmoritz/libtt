+// Estimate new storage from the allocation program's device layouts, excluding
+// the aliased caller-owned inputs. Admission must happen before allocation.
+static size_t estimateTraceSlotBytes(
+    const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op,
+    ProgramContext &context) {
+  const auto *program = ::tt::runtime::ttnn::utils::getProgram(
+      context.getExecutableHandle(), op->allocate_slots_program_id());
+  size_t bytes = 0;
+  std::unordered_set<uint32_t> seen;
+  for (size_t i = 0; i < program->outputs()->size(); ++i) {
+    const auto *slot = program->outputs()->Get(i);
+    if ((i < op->inputs()->size() &&
+         ::tt::runtime::ttnn::utils::inDeviceMemory(op->inputs()->Get(i))) ||
+        !::tt::runtime::ttnn::utils::inDeviceMemory(slot) ||
+        !seen.insert(slot->global_id()).second) {
+      continue;
+    }
+    const auto *desc = slot->desc()->layout()->memory_desc();
+    auto memoryConfig = ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+        desc->memory_config());
+    LOG_ASSERT(memoryConfig, "Device trace slots require memory config");
+    auto spec = ::tt::runtime::ttnn::utils::createTensorSpec(
+        ::tt::runtime::ttnn::operations::utils::toTTNNShape(*slot->desc()->shape()),
+        ::tt::runtime::ttnn::utils::toTTNNDataType(desc->data_type()),
+        ::tt::runtime::ttnn::utils::inferLayoutFromTileShape(slot),
+        *memoryConfig);
+    bytes += spec.compute_packed_buffer_size_bytes();
+  }
+  return bytes;
+}
