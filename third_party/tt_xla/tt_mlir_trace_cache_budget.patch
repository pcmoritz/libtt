+size_t TraceCache::memoryBudgetBytes() const {
+  // Budget additional cache storage, not caller-owned weights/KV caches.
+  // Scale with the device's DRAM capacity instead of the number of graphs.
+  if (const char *setting = std::getenv("TT_RUNTIME_TRACE_CACHE_BYTES")) {
+    std::string_view value(setting);
+    size_t bytes = 0;
+    auto [end, error] =
+        std::from_chars(value.data(), value.data() + value.size(), bytes);
+    LOG_ASSERT(error == std::errc{} && end == value.data() + value.size(),
+               "TT_RUNTIME_TRACE_CACHE_BYTES must be a nonnegative integer");
+    return bytes;
+  }
+  auto device = meshDevice.lock();
+  LOG_ASSERT(device, "Trace cache device must be alive");
+  const auto &allocator = device->allocator();
+  return allocator->get_bank_size(::ttnn::BufferType::DRAM) *
+         allocator->get_num_banks(::ttnn::BufferType::DRAM) / 64;
+}
+
+size_t TraceCache::memoryUsageBytes() const {
+  auto device = meshDevice.lock();
+  LOG_ASSERT(device, "Trace cache device must be alive");
+  size_t bytes = 0;
+  std::unordered_set<const void *> buffers;
+  for (const auto &[mainKey, programs] : cache) {
+    for (const auto &[programKey, data] : programs) {
+      for (const TraceVariant &variant : data.variants) {
+        // Variants commonly share a slot set; charge each allocation once.
+        for (const auto &tensor : variant.ownedTensors) {
+          const auto &ttnnTensor =
+              tensor.as<TTNNTensorWrapper>(DeviceRuntime::TTNN).getTensor();
+          if (ttnnTensor.storage_type() == ::ttnn::StorageType::DEVICE &&
+              ttnnTensor.is_allocated() &&
+              buffers.insert(&ttnnTensor.mesh_buffer()).second) {
+            bytes += ttnnTensor.mesh_buffer().device_local_size();
+          }
+        }
+        const auto trace = device->get_mesh_trace(variant.traceId);
+        if (trace && trace->mesh_buffer &&
+            buffers.insert(trace->mesh_buffer.get()).second) {
+          bytes += trace->mesh_buffer->device_local_size();
+        }
+      }
+    }
+  }
+  return bytes;
+}
