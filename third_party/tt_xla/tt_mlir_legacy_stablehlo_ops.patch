 namespace {
+// stablehlo.broadcast prepends `broadcast_sizes` to the operand's shape, so it
+// is a broadcast_in_dim that maps the operand to the trailing dimensions.
+class StableHLOToTTIRBroadcastOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::BroadcastOp> {
+  using OpConversionPattern<mlir::stablehlo::BroadcastOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::BroadcastOp srcOp,
+                  mlir::stablehlo::BroadcastOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    int64_t prefixRank = srcOp.getBroadcastSizes().size();
+    int64_t operandRank =
+        mlir::cast<RankedTensorType>(srcOp.getOperand().getType()).getRank();
+    SmallVector<int64_t> broadcastDimensions = llvm::to_vector(
+        llvm::seq<int64_t>(prefixRank, prefixRank + operandRank));
+    rewriter.replaceOpWithNewOp<mlir::stablehlo::BroadcastInDimOp>(
+        srcOp, getTypeConverter()->convertType(srcOp.getType()),
+        adaptor.getOperand(), broadcastDimensions);
+    return success();
+  }
+};
