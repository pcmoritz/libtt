 } // namespace
 
 namespace {
+// stablehlo.dot multiplies vectors and matrices (rank 1 or 2): it contracts the
+// last dimension of lhs with the first dimension of rhs, without batching.
+class StableHLOToTTIRDotOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::DotOp> {
+  using OpConversionPattern<mlir::stablehlo::DotOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::DotOp srcOp,
+                  mlir::stablehlo::DotOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    int64_t lhsRank =
+        mlir::cast<RankedTensorType>(srcOp.getLhs().getType()).getRank();
+    auto dimensionNumbers = mlir::stablehlo::DotDimensionNumbersAttr::get(
+        rewriter.getContext(), /*lhsBatchingDimensions=*/{},
+        /*rhsBatchingDimensions=*/{},
+        /*lhsContractingDimensions=*/{lhsRank - 1},
+        /*rhsContractingDimensions=*/{0});
+    rewriter.replaceOpWithNewOp<mlir::stablehlo::DotGeneralOp>(
+        srcOp, getTypeConverter()->convertType(srcOp.getType()),
+        adaptor.getLhs(), adaptor.getRhs(), dimensionNumbers,
+        srcOp.getPrecisionConfigAttr(), /*algorithm=*/nullptr);
+    return success();
+  }
+};
+
 class StableHLOToTTIRDotGeneralOpConversionPattern
