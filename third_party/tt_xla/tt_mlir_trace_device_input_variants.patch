diff --git a/runtime/lib/ttnn/types/trace_cache.cpp b/runtime/lib/ttnn/types/trace_cache.cpp
index 66fefc1..eb1bafd 100644
--- a/runtime/lib/ttnn/types/trace_cache.cpp
+++ b/runtime/lib/ttnn/types/trace_cache.cpp
@@ -3,9 +3,129 @@
 // SPDX-License-Identifier: Apache-2.0

 #include "tt/runtime/detail/ttnn/types/trace_cache.h"
+#include "tt/runtime/detail/ttnn/types/types.h"
+
+#include <algorithm>
+#include <unordered_set>

 namespace tt::runtime::ttnn {

+static void releaseOwnedTensors(
+    std::vector<::tt::runtime::Tensor> &tensors,
+    const std::unordered_set<void *> &liveTensorHandles,
+    std::unordered_set<void *> &releasedTensorHandles) {
+  for (::tt::runtime::Tensor &tensor : tensors) {
+    if (liveTensorHandles.contains(tensor.handle.get()) ||
+        !releasedTensorHandles.insert(tensor.handle.get()).second) {
+      continue;
+    }
+    // The runtime tensor handle is shared with any output still visible to
+    // the caller. Removing retain lets normal wrapper destruction reclaim the
+    // buffer after the final reference is gone; force-deallocation here would
+    // invalidate all outstanding aliases.
+    tensor.as<TTNNTensorWrapper>(DeviceRuntime::TTNN).setRetain(false);
+  }
+}
+
+static void releaseTraceData(::ttnn::MeshDevice *meshDevice,
+                             TraceData &traceData) {
+  // Generated traces execute asynchronously on CQ 0. Drain outstanding
+  // replays before releasing their command buffers or persistent slots.
+  meshDevice->mesh_command_queue(0).finish();
+  for (TraceVariant &variant : traceData.variants) {
+    ::ttnn::operations::trace::release_trace(meshDevice, variant.traceId);
+  }
+
+  const std::unordered_set<void *> noLiveTensors;
+  std::unordered_set<void *> releasedTensorHandles;
+  for (TraceVariant &variant : traceData.variants) {
+    releaseOwnedTensors(variant.ownedTensors, noLiveTensors,
+                        releasedTensorHandles);
+  }
+}
+
+void TraceCache::touch(
+    const MainProgramKey &key,
+    const CaptureExecuteProgramKey &captureExecuteKey) {
+  auto it = std::find_if(
+      leastToMostRecentlyUsed.begin(), leastToMostRecentlyUsed.end(),
+      [&](const EntryKey &entry) {
+        return entry.first == key && entry.second == captureExecuteKey;
+      });
+  if (it != leastToMostRecentlyUsed.end()) {
+    leastToMostRecentlyUsed.erase(it);
+  }
+  leastToMostRecentlyUsed.emplace_back(key, captureExecuteKey);
+}
+
+void TraceCache::evictLeastRecentlyUsed() {
+  if (leastToMostRecentlyUsed.empty()) {
+    return;
+  }
+
+  EntryKey entry = leastToMostRecentlyUsed.front();
+  leastToMostRecentlyUsed.erase(leastToMostRecentlyUsed.begin());
+  auto outerIt = cache.find(entry.first);
+  if (outerIt == cache.end()) {
+    return;
+  }
+  auto innerIt = outerIt->second.find(entry.second);
+  if (innerIt == outerIt->second.end()) {
+    return;
+  }
+
+  std::shared_ptr<::ttnn::MeshDevice> lockedDevice = meshDevice.lock();
+  if (lockedDevice && lockedDevice->is_initialized()) {
+    releaseTraceData(lockedDevice.get(), innerIt->second);
+  }
+  outerIt->second.erase(innerIt);
+  if (outerIt->second.empty()) {
+    cache.erase(outerIt);
+  }
+}
+
+void TraceCache::prepareForInsert(
+    const MainProgramKey &key,
+    const CaptureExecuteProgramKey &captureExecuteKey) {
+  if (contains(key, captureExecuteKey)) {
+    return;
+  }
+  while (leastToMostRecentlyUsed.size() >= kMaxEntries) {
+    evictLeastRecentlyUsed();
+  }
+}
+
+void TraceCache::evictOldestVariant(
+    TraceData &traceData,
+    const std::vector<::tt::runtime::Tensor> &replacementTensors) {
+  LOG_ASSERT(!traceData.variants.empty(), "Cannot evict an empty trace cache");
+
+  TraceVariant evictedVariant = std::move(traceData.variants.front());
+  traceData.variants.erase(traceData.variants.begin());
+
+  std::shared_ptr<::ttnn::MeshDevice> lockedDevice = meshDevice.lock();
+  if (!lockedDevice || !lockedDevice->is_initialized()) {
+    return;
+  }
+  lockedDevice->mesh_command_queue(0).finish();
+  ::ttnn::operations::trace::release_trace(lockedDevice.get(),
+                                            evictedVariant.traceId);
+
+  std::unordered_set<void *> liveTensorHandles;
+  for (const ::tt::runtime::Tensor &tensor : replacementTensors) {
+    liveTensorHandles.insert(tensor.handle.get());
+  }
+  for (const TraceVariant &variant : traceData.variants) {
+    for (const ::tt::runtime::Tensor &tensor : variant.ownedTensors) {
+      liveTensorHandles.insert(tensor.handle.get());
+    }
+  }
+
+  std::unordered_set<void *> releasedTensorHandles;
+  releaseOwnedTensors(evictedVariant.ownedTensors, liveTensorHandles,
+                      releasedTensorHandles);
+}
