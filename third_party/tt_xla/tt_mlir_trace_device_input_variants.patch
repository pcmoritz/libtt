+// A device-resident trace input is captured by address, unlike a host input
+// whose current value is copied into a persistent slot before replay. A trace
+// variant can therefore only be reused when each device input is the same
+// runtime tensor it was captured with. In particular, donated KV-cache calls
+// may use the same executable with different cache buffers; replaying the old
+// trace would mutate the old buffer while the enclosing program returns the
+// new one.
+static bool deviceInputsMatch(
+    const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op,
+    ProgramContext &context, const TraceVariant &variant) {
+  LOG_ASSERT(op->inputs()->size() == variant.inputTensors.size(),
+             "Mismatched number of trace inputs");
+  for (size_t i = 0; i < op->inputs()->size(); ++i) {
+    const ::tt::target::ttnn::TensorRef *input = op->inputs()->Get(i);
+    if (!::tt::runtime::ttnn::utils::inDeviceMemory(input)) {
+      continue;
+    }
+    const ::ttnn::Tensor &current =
+        context.getTensorPool().getTTNNTensorAndValidate(input);
+    const ::ttnn::Tensor &captured =
+        variant.inputTensors[i]
+            .as<::tt::runtime::ttnn::TTNNTensorWrapper>(DeviceRuntime::TTNN)
+            .getTensor();
+    if (current.mesh_buffer().address() != captured.mesh_buffer().address()) {
+      return false;
+    }
+  }
+  return true;
 }

