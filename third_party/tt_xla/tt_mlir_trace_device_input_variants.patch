+@pytest.mark.parametrize("trace_region_size", [0, 80000])
+def test_trace_device_input_buffer_variants(helper: Helper, request, trace_region_size):
+    """A trace is only reusable with the device buffers it captured."""
+    binary_path = os.path.join(
+        FLATBUFFER_BASE_PATH, "matmul_multiply_no_consteval.mlir.tmp.ttnn"
+    )
+    assert os.path.exists(binary_path), f"Binary file not found: {binary_path}"
+    helper.initialize(request.node.name, binary_path)
+    helper.check_constraints()
+
+    config = ProgramTestConfig(
+        name="matmul_multiply",
+        expected_num_inputs=3,
+        compute_golden=lambda inputs: ((inputs[0] @ inputs[1]) * inputs[2]),
+        description="Traced graph invoked with distinct device input buffers",
+    )
+    runner = ProgramTestRunner(config, helper.binary, 0)
+    debug_stats = ttrt.runtime.DebugStats.get()
+    debug_stats.clear()
+
+    with DeviceContext(
+        mesh_shape=[1, 1],
+        enable_program_cache=True,
+        trace_region_size=trace_region_size,
+    ) as device:
+        first_inputs, first_golden, _first_inputs_torch = (
+            runner.get_inputs_and_golden(device)
+        )
+        second_inputs, second_golden, _second_inputs_torch = (
+            runner.get_inputs_and_golden(device)
+        )
+
+        runner.run_program_and_compare_golden(device, first_inputs, first_golden)
+        assert debug_stats.get_stat("TraceCacheMiss") == 1
+
+        # The executable and trace-cache key are unchanged, but its parameter
+        # buffers are not. Replaying the first trace would read and write the
+        # first invocation's addresses, so capture a variant for the second
+        # buffer set instead.
+        runner.run_program_and_compare_golden(device, second_inputs, second_golden)
+        assert debug_stats.get_stat("TraceStaleRecapture") == 1
+        assert debug_stats.get_stat("ExecutedTrace") == 0
+
+    debug_stats.clear()
+    helper.teardown()
+
+
