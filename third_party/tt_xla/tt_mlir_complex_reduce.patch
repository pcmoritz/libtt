+// Complex addition is separable, so lower it to ordinary reductions of the
+// real and imaginary components. Cross-component reducers such as complex
+// multiplication use a balanced tree of data movement and elementwise ops.
+namespace {
+class ComplexReduceOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::ReduceOp> {
+  using OpConversionPattern<mlir::stablehlo::ReduceOp>::OpConversionPattern;
+  using ComplexParts = std::pair<Value, Value>;
+
+  enum class ReducerKind { Add, Multiply, Maximum, Minimum };
+
+  template <typename BinaryOp>
+  static bool matchesBinaryReducer(Block &body) {
+    if (body.getNumArguments() != 2 || body.getOperations().size() != 2) {
+      return false;
+    }
+    auto binary = mlir::dyn_cast<BinaryOp>(body.front());
+    auto returnOp =
+        mlir::dyn_cast<mlir::stablehlo::ReturnOp>(body.getTerminator());
+    return binary && returnOp && returnOp.getNumOperands() == 1 &&
+           binary.getLhs() == body.getArgument(0) &&
+           binary.getRhs() == body.getArgument(1) &&
+           returnOp.getOperand(0) == binary.getResult();
+  }
+
+  static std::optional<ReducerKind>
+  matchLexicographicReducer(Block &body) {
+    if (body.getNumArguments() != 2 || body.getOperations().size() != 10) {
+      return std::nullopt;
+    }
+
+    auto it = body.begin();
+    auto lhsReal = mlir::dyn_cast<mlir::stablehlo::RealOp>(*it++);
+    auto rhsReal = mlir::dyn_cast<mlir::stablehlo::RealOp>(*it++);
+    auto realEqual = mlir::dyn_cast<mlir::stablehlo::CompareOp>(*it++);
+    auto realOrdered = mlir::dyn_cast<mlir::stablehlo::CompareOp>(*it++);
+    auto lhsImag = mlir::dyn_cast<mlir::stablehlo::ImagOp>(*it++);
+    auto rhsImag = mlir::dyn_cast<mlir::stablehlo::ImagOp>(*it++);
+    auto imagOrdered = mlir::dyn_cast<mlir::stablehlo::CompareOp>(*it++);
+    auto predicate = mlir::dyn_cast<mlir::stablehlo::SelectOp>(*it++);
+    auto selected = mlir::dyn_cast<mlir::stablehlo::SelectOp>(*it++);
+    auto returnOp = mlir::dyn_cast<mlir::stablehlo::ReturnOp>(*it);
+    if (!lhsReal || !rhsReal || !realEqual || !realOrdered || !lhsImag ||
+        !rhsImag || !imagOrdered || !predicate || !selected || !returnOp) {
+      return std::nullopt;
+    }
+
+    auto direction = realOrdered.getComparisonDirection();
+    if ((direction != mlir::stablehlo::ComparisonDirection::GT &&
+         direction != mlir::stablehlo::ComparisonDirection::LT) ||
+        imagOrdered.getComparisonDirection() != direction ||
+        realEqual.getComparisonDirection() !=
+            mlir::stablehlo::ComparisonDirection::EQ ||
+        realEqual.getCompareType() !=
+            mlir::stablehlo::ComparisonType::FLOAT ||
+        realOrdered.getCompareType() !=
+            mlir::stablehlo::ComparisonType::FLOAT ||
+        imagOrdered.getCompareType() !=
+            mlir::stablehlo::ComparisonType::FLOAT) {
+      return std::nullopt;
+    }
+
+    Value lhs = body.getArgument(0);
+    Value rhs = body.getArgument(1);
+    if (lhsReal.getOperand() != lhs || rhsReal.getOperand() != rhs ||
+        lhsImag.getOperand() != lhs || rhsImag.getOperand() != rhs ||
+        realEqual.getLhs() != lhsReal.getResult() ||
+        realEqual.getRhs() != rhsReal.getResult() ||
+        realOrdered.getLhs() != lhsReal.getResult() ||
+        realOrdered.getRhs() != rhsReal.getResult() ||
+        imagOrdered.getLhs() != lhsImag.getResult() ||
+        imagOrdered.getRhs() != rhsImag.getResult() ||
+        predicate.getPred() != realEqual.getResult() ||
+        predicate.getOnTrue() != imagOrdered.getResult() ||
+        predicate.getOnFalse() != realOrdered.getResult() ||
+        selected.getPred() != predicate.getResult() ||
+        selected.getOnTrue() != lhs ||
+        selected.getOnFalse() != rhs || returnOp.getNumOperands() != 1 ||
+        returnOp.getOperand(0) != selected.getResult()) {
+      return std::nullopt;
+    }
+
+    return direction == mlir::stablehlo::ComparisonDirection::GT
+               ? ReducerKind::Maximum
+               : ReducerKind::Minimum;
+  }
+
+  static std::optional<ReducerKind> getReducerKind(Block &body) {
+    if (matchesBinaryReducer<mlir::stablehlo::AddOp>(body)) {
+      return ReducerKind::Add;
+    }
+    if (matchesBinaryReducer<mlir::stablehlo::MulOp>(body)) {
+      return ReducerKind::Multiply;
+    }
+    return matchLexicographicReducer(body);
+  }
+
+  static ComplexParts combine(Location loc, ComplexParts lhs,
+                              ComplexParts rhs, ReducerKind kind,
+                              OpBuilder &builder) {
+    if (kind == ReducerKind::Add) {
+      return {builder.create<mlir::stablehlo::AddOp>(loc, lhs.first,
+                                                      rhs.first),
+              builder.create<mlir::stablehlo::AddOp>(loc, lhs.second,
+                                                      rhs.second)};
+    }
+    if (kind == ReducerKind::Multiply) {
+      Value ac = builder.create<mlir::stablehlo::MulOp>(loc, lhs.first,
+                                                        rhs.first);
+      Value bd = builder.create<mlir::stablehlo::MulOp>(loc, lhs.second,
+                                                        rhs.second);
+      Value ad = builder.create<mlir::stablehlo::MulOp>(loc, lhs.first,
+                                                        rhs.second);
+      Value bc = builder.create<mlir::stablehlo::MulOp>(loc, lhs.second,
+                                                        rhs.first);
+      return {builder.create<mlir::stablehlo::SubtractOp>(loc, ac, bd),
+              builder.create<mlir::stablehlo::AddOp>(loc, ad, bc)};
+    }
+
+    auto direction = kind == ReducerKind::Maximum
+                         ? mlir::stablehlo::ComparisonDirection::GT
+                         : mlir::stablehlo::ComparisonDirection::LT;
+    Value realEqual = builder.create<mlir::stablehlo::CompareOp>(
+        loc, lhs.first, rhs.first,
+        mlir::stablehlo::ComparisonDirection::EQ);
+    Value realOrdered = builder.create<mlir::stablehlo::CompareOp>(
+        loc, lhs.first, rhs.first, direction);
+    Value imagOrdered = builder.create<mlir::stablehlo::CompareOp>(
+        loc, lhs.second, rhs.second, direction);
+    Value predicate = builder.create<mlir::stablehlo::SelectOp>(
+        loc, realEqual, imagOrdered, realOrdered);
+    return {builder.create<mlir::stablehlo::SelectOp>(
+                loc, predicate, lhs.first, rhs.first),
+            builder.create<mlir::stablehlo::SelectOp>(
+                loc, predicate, lhs.second, rhs.second)};
+  }
+
+public:
+  LogicalResult matchAndRewrite(
+      mlir::stablehlo::ReduceOp op,
+      OpConversionPattern<mlir::stablehlo::ReduceOp>::OpAdaptor adaptor,
+      ConversionPatternRewriter &rewriter) const override {
+    if (op.getInputs().size() != 1 || op.getInitValues().size() != 1 ||
+        op.getNumResults() != 1 || !op.getBody().hasOneBlock()) {
+      return rewriter.notifyMatchFailure(
+          op, "expected a single-input complex reduction");
+    }
+
+    auto inputType =
+        mlir::cast<RankedTensorType>(op.getInputs().front().getType());
+    auto complexType =
+        mlir::dyn_cast<mlir::ComplexType>(inputType.getElementType());
+    if (!complexType) {
+      return failure();
+    }
+    auto kind = getReducerKind(op.getBody().front());
+    if (!kind) {
+      return rewriter.notifyMatchFailure(op,
+                                         "unsupported complex reducer body");
+    }
+
+    Location loc = op.getLoc();
+    ComplexParts current =
+        unpackRealImag(loc, adaptor.getInputs().front(), rewriter);
+    ComplexParts init =
+        unpackRealImag(loc, adaptor.getInitValues().front(), rewriter);
+    auto originalResultType =
+        mlir::cast<RankedTensorType>(op.getResult(0).getType());
+    auto resultType = RankedTensorType::get(
+        originalResultType.getShape(), complexType.getElementType(),
+        originalResultType.getEncoding());
+    auto broadcastInit = [&](Value value) -> Value {
+      return rewriter.create<mlir::stablehlo::BroadcastInDimOp>(
+          loc, resultType, value, rewriter.getDenseI64ArrayAttr({}));
+    };
+
+    bool isEmpty = llvm::any_of(op.getDimensions(), [&](int64_t dimension) {
+      return !inputType.isDynamicDim(dimension) &&
+             inputType.getDimSize(dimension) == 0;
+    });
+
+    if (*kind == ReducerKind::Add) {
+      ComplexParts result{broadcastInit(init.first),
+                          broadcastInit(init.second)};
+      if (!isEmpty) {
+        auto scalarType =
+            RankedTensorType::get({}, complexType.getElementType());
+        auto zeroAttr = DenseElementsAttr::get(
+            scalarType,
+            rewriter.getFloatAttr(complexType.getElementType(), 0.0));
+        Value zero = rewriter.create<mlir::stablehlo::ConstantOp>(
+            loc, scalarType, zeroAttr);
+        auto reduceSum = [&](Value value) -> Value {
+          if (op.getDimensions().empty()) {
+            return value;
+          }
+          auto reduce = rewriter.create<mlir::stablehlo::ReduceOp>(
+              loc, resultType, value, zero, op.getDimensions());
+          Block &body = reduce.getBody().emplaceBlock();
+          body.addArgument(scalarType, loc);
+          body.addArgument(scalarType, loc);
+          OpBuilder::InsertionGuard guard(rewriter);
+          rewriter.setInsertionPointToStart(&body);
+          Value sum = rewriter.create<mlir::stablehlo::AddOp>(
+              loc, body.getArgument(0), body.getArgument(1));
+          rewriter.create<mlir::stablehlo::ReturnOp>(loc, sum);
+          return reduce.getResult(0);
+        };
+        result = {rewriter.create<mlir::stablehlo::AddOp>(
+                      loc, reduceSum(current.first), result.first),
+                  rewriter.create<mlir::stablehlo::AddOp>(
+                      loc, reduceSum(current.second), result.second)};
+      }
+      rewriter.replaceOp(
+          op, packRealImag(loc, result.first, result.second, rewriter));
+      return success();
+    }
+
+    // TODO: Replace this explicit tree for complex multiply/min/max with
+    // first-class complex reduction ops once TTIR/TTNN supports them.
+    for (int64_t dimension : op.getDimensions()) {
+      if (inputType.isDynamicDim(dimension)) {
+        return rewriter.notifyMatchFailure(
+            op, "complex reduction requires static dimensions");
+      }
+    }
+
+    auto slice = [&](Value value, int64_t dimension, int64_t begin,
+                     int64_t limit, int64_t stride) -> Value {
+      auto type = mlir::cast<RankedTensorType>(value.getType());
+      int64_t rank = type.getRank();
+      SmallVector<int64_t> begins(rank, 0),
+          limits(type.getShape().begin(), type.getShape().end()),
+          strides(rank, 1), shape(type.getShape().begin(),
+                                  type.getShape().end());
+      begins[dimension] = begin;
+      limits[dimension] = limit;
+      strides[dimension] = stride;
+      shape[dimension] = (limit - begin + stride - 1) / stride;
+      auto resultType = RankedTensorType::get(
+          shape, type.getElementType(), type.getEncoding());
+      return rewriter.create<mlir::stablehlo::SliceOp>(
+          loc, resultType, value, rewriter.getDenseI64ArrayAttr(begins),
+          rewriter.getDenseI64ArrayAttr(limits),
+          rewriter.getDenseI64ArrayAttr(strides));
+    };
+    auto sliceParts = [&](ComplexParts parts, int64_t dimension,
+                          int64_t begin, int64_t limit,
+                          int64_t stride) -> ComplexParts {
+      return {slice(parts.first, dimension, begin, limit, stride),
+              slice(parts.second, dimension, begin, limit, stride)};
+    };
+    auto concatenate = [&](Value lhs, Value rhs,
+                           int64_t dimension) -> Value {
+      auto lhsType = mlir::cast<RankedTensorType>(lhs.getType());
+      auto rhsType = mlir::cast<RankedTensorType>(rhs.getType());
+      SmallVector<int64_t> shape(lhsType.getShape().begin(),
+                                 lhsType.getShape().end());
+      shape[dimension] += rhsType.getDimSize(dimension);
+      auto resultType = RankedTensorType::get(
+          shape, lhsType.getElementType(), lhsType.getEncoding());
+      return rewriter.create<mlir::stablehlo::ConcatenateOp>(
+          loc, resultType, ValueRange{lhs, rhs}, dimension);
+    };
+
+    if (!isEmpty) {
+      for (int64_t dimension : op.getDimensions()) {
+        int64_t size = inputType.getDimSize(dimension);
+        while (size > 1) {
+          int64_t pairedSize = size / 2;
+          ComplexParts even =
+              sliceParts(current, dimension, 0, pairedSize * 2, 2);
+          ComplexParts odd =
+              sliceParts(current, dimension, 1, pairedSize * 2, 2);
+          std::optional<ComplexParts> tail;
+          if (size % 2 != 0) {
+            tail = sliceParts(current, dimension, size - 1, size, 1);
+          }
+          current = combine(loc, even, odd, *kind, rewriter);
+          if (tail) {
+            current = {
+                concatenate(current.first, tail->first, dimension),
+                concatenate(current.second, tail->second, dimension)};
+          }
+          size = pairedSize + size % 2;
+        }
+      }
+    }
+
+    ComplexParts result{broadcastInit(init.first), broadcastInit(init.second)};
+    if (!isEmpty) {
+      auto reshape = [&](Value value) -> Value {
+        if (value.getType() == resultType) {
+          return value;
+        }
+        return rewriter.create<mlir::stablehlo::ReshapeOp>(loc, resultType,
+                                                           value);
+      };
+      current = {reshape(current.first), reshape(current.second)};
+      result = combine(loc, current, result, *kind, rewriter);
+    }
+
+    rewriter.replaceOp(op,
+                       packRealImag(loc, result.first, result.second, rewriter));
+    return success();
+  }
+};
+} // namespace
