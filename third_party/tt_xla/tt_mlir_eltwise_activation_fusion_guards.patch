diff --git a/lib/Dialect/TTNN/Transforms/TTNNFusing.cpp b/lib/Dialect/TTNN/Transforms/TTNNFusing.cpp
--- a/lib/Dialect/TTNN/Transforms/TTNNFusing.cpp
+++ b/lib/Dialect/TTNN/Transforms/TTNNFusing.cpp
@@ -212,6 +212,20 @@ bool hasInterveningWrite(Value value, Operation *from, Operation *to) {
   return false;
 }
 
+// A binary op applies fused activations to its operands as they are unpacked,
+// which for an activation of an input requires that operand's format to share
+// its exponent format with the others: keep the fusion to BF16 and FP32
+// tensors.
+static bool hasActivationFusibleType(Value value) {
+  auto type = mlir::dyn_cast<mlir::RankedTensorType>(value.getType());
+  return type && (type.getElementType().isBF16() || type.getElementType().isF32());
+}
+
+static bool allActivationFusibleTypes(Operation *op) {
+  return llvm::all_of(op->getOperands(), hasActivationFusibleType) &&
+         llvm::all_of(op->getResults(), hasActivationFusibleType);
+}
+
 class TTNNBinaryOpInputsActivation
     : public mlir::OpInterfaceRewritePattern<ElementwiseBinaryActivations> {
 public:
@@ -261,6 +275,16 @@ private:
     if (!unaryOp) {
       return {};
     }
+    if (!allActivationFusibleTypes(unaryOp) || !allActivationFusibleTypes(binaryOp)) {
+      return {};
+    }
+    // Leave silu(slice(matmul)) * slice(matmul) to the SwiGLU matmul epilogue.
+    if (isa<MultiplyOp>(binaryOp) && isa<SiluOp>(unaryOp.getOperation())) {
+      if (auto slice = unaryOp.getInput().getDefiningOp<SliceStaticOp>();
+          slice && slice.getInput().getDefiningOp<MatmulOp>()) {
+        return {};
+      }
+    }
     if (restrictToMatmulProducer &&
         !unaryOp.getInput().getDefiningOp<MatmulOp>() &&
         !unaryOp.getInput().getDefiningOp<LinearOp>()) {
@@ -324,7 +348,8 @@ public:
 
 private:
   bool isFusable(ElementwiseUnary unaryOp) const {
-    return unaryOp.getUnaryOpType() != UnaryOpType::Unknown;
+    return unaryOp.getUnaryOpType() != UnaryOpType::Unknown &&
+           allActivationFusibleTypes(unaryOp);
   }
 
   ElementwiseBinaryActivations getFusableBinaryOp(Value operand) const {
@@ -333,7 +358,11 @@ private:
       return {};
     }
 
-    return operand.getDefiningOp<ElementwiseBinaryActivations>();
+    auto binaryOp = operand.getDefiningOp<ElementwiseBinaryActivations>();
+    if (!binaryOp || !allActivationFusibleTypes(binaryOp.getOperation())) {
+      return {};
+    }
+    return binaryOp;
   }
 };
 } // namespace
