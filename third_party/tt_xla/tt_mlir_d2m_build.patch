diff --git a/lib/Dialect/TTNN/Transforms/TTNNTraceHoistTransform.cpp b/lib/Dialect/TTNN/Transforms/TTNNTraceHoistTransform.cpp
--- a/lib/Dialect/TTNN/Transforms/TTNNTraceHoistTransform.cpp
+++ b/lib/Dialect/TTNN/Transforms/TTNNTraceHoistTransform.cpp
@@ -75,6 +75,15 @@
   // transfers and preparation run eagerly between traces, and the device
   // programs of eager control flow are partitioned by the same rule.
   bool shouldHoistOp(Operation *op) {
+    // A generic writes its result into an empty it is given: that empty is
+    // the generic's result allocation and is traced like any op's result,
+    // whatever else then reads it.
+    if (auto empty = ::mlir::dyn_cast<ttnn::EmptyOp>(op)) {
+      return llvm::any_of(empty->getUsers(), [](Operation *user) {
+               return ::mlir::isa<ttnn::GenericOp>(user);
+             }) &&
+             isOnDeviceType(empty.getResult().getType());
+    }
     if (::mlir::isa<func::ReturnOp, func::CallOp, ttcore::CaseOp,
                     ttcore::WhileLoopOp, ttnn::WhileOp, ttcore::LoadCachedOp,
                     ttnn::GetDeviceOp, ttnn::AdamWOp, ttnn::DeallocateOp,
