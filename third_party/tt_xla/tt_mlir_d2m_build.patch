+namespace {
+struct FuseD2MElementwiseOpsPattern : public OpRewritePattern<GenericOp> {
+  using OpRewritePattern<GenericOp>::OpRewritePattern;
+
+  LogicalResult matchAndRewrite(GenericOp consumer,
+                                PatternRewriter &rewriter) const final {
+    if (isSimpleElementwiseGeneric(consumer)) {
+      for (Value input : consumer.getInputs()) {
+        auto producer = input.getDefiningOp<GenericOp>();
+        if (!producer) {
+          continue;
+        }
+        auto plan = planElementwiseFusion(producer, consumer);
+        if (failed(plan)) {
+          continue;
+        }
+        fuseElementwiseDAG(producer, consumer, *plan, rewriter);
+        return success();
+      }
+    }
+    // Preserve the existing tree/permutation path for other generic forms.
+    for (OpOperand *input : consumer.getDpsInputOperands()) {
+      if (isElementwiseFusable(input)) {
+        fuseOverOperand(input, input->get().getDefiningOp<GenericOp>(),
+                        consumer, rewriter);
+        return success();
+      }
+    }
+    return failure();
   }
 };
