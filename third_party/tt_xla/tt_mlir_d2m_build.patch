+unsigned getDstCapacityTilesForBody(linalg::GenericOp op,
+                                    unsigned maxDstPhysicalSizeTiles) {
+  bool wide = false;
+  auto visit = [&](Type t) {
+    if (auto st = mlir::dyn_cast<ShapedType>(t)) {
+      t = st.getElementType();
+    }
+    if (auto tile = mlir::dyn_cast<ttcore::TileType>(t)) {
+      wide |= ttcore::getNumberOfBits(tile.getDataType()) == 32;
+    }
+  };
+  for (Value v : op->getOperands()) {
+    visit(v.getType());
+  }
+  op.getBody()->walk([&](Operation *o) {
+    for (Type t : o->getResultTypes()) {
+      visit(t);
+    }
+    for (Value v : o->getOperands()) {
+      visit(v.getType());
+    }
+  });
+  Type tileTy = wide ? Type(Float32Type::get(op.getContext()))
+                     : Type(BFloat16Type::get(op.getContext()));
+  unsigned cap = ttcore::getOpChipDescAttr(op).getDstLogicalSizeTiles(
+      tileTy, /*fullSyncEn=*/false, maxDstPhysicalSizeTiles);
+  return std::max(cap, 1u);
+}
