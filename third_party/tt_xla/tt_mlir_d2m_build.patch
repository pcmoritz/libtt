+bool canExpandTTNNActivations(ArrayAttr activations) {
+  if (!activations) {
+    return true;
+  }
+  return llvm::all_of(activations, [](Attribute attr) {
+    auto activation = mlir::dyn_cast<ttnn::UnaryWithParamAttr>(attr);
