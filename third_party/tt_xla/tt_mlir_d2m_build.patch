@@ -1198,6 +1199,9 @@
       auto cb = getCB(rewriter, op.getInput());
       auto dstIdx = getDstIdxFromResult(op.getResult());
       ensureDominatesInsertionPoint(rewriter, dstIdx);
+      // An Int32 buffer broadcasts through unpack-to-dest exactly; what
+      // truncated integers was the FPU binary op after it (see
+      // emitIntegerBinaryDestReuse).
       rewriter.create<ttkernel::UnaryBcastInitOp>(op->getLoc(), cb, cb,
                                                   bcastType);
       rewriter.create<ttkernel::UnaryBcastTileOp>(
@@ -1629,6 +1633,17 @@
       return emitFPUTiles(rewriter, op, adaptor, loc);
     }
 
+    // The FPU's dest-reuse path carries about 19 bits of a 32-bit integer:
+    // integer tiles copy the CB operand into DST and use the int32 SFPU op.
+    if constexpr (hasMapping<ConcreteOp, IntComputeOpMap>) {
+      if (llvm::isa<IntegerType>(
+              mlir::cast<ttcore::TileType>(op.getLhs().getType())
+                  .getElementType())) {
+        return emitIntegerBinaryDestReuse(rewriter, op, adaptor, loc,
+                                          lhsFromDst);
+      }
+    }
+
     if (lhsFromDst) {
       // LHS from Dst, RHS from Cb (FPU - DEST_TO_SRCA)
       return emitFPUBinaryDestReuse(rewriter, op, adaptor, loc,
@@ -1731,6 +1746,61 @@
       rewriter.create<IntSFPUOp>(loc, dst0, dst1, dst0, dtype);
     } else {
       rewriter.create<IntSFPUOp>(loc, dst0, dst1, dst0);
+    }
+
+    rewriter.eraseOp(op);
+    return success();
+  }
+
+  // Integer binary with one operand already in DST (a broadcast, say): the
+  // CB operand is copied into the result's DST slot, or the next one when the
+  // DST operand lives there, and the int32 SFPU op writes the result.
+  LogicalResult emitIntegerBinaryDestReuse(ConversionPatternRewriter &rewriter,
+                                           ConcreteOp op,
+                                           typename ConcreteOp::Adaptor adaptor,
+                                           Location loc,
+                                           bool lhsFromDst) const {
+    using IntPair = TTKernelOpPair<ConcreteOp, IntComputeOpMap>;
+    using IntInit = typename IntPair::first_type;
+    using IntSFPUOp = typename IntPair::second_type;
+
+    Value cb = getCB(rewriter, lhsFromDst ? op.getRhs() : op.getLhs());
+    Value cbTileIdx = lhsFromDst ? adaptor.getRhs() : adaptor.getLhs();
+    Value dstOperandIdx = lhsFromDst ? adaptor.getLhs() : adaptor.getRhs();
+    auto outCB = getOutCB(rewriter, op);
+    auto dstIdx = getDstIdxFromResult(op.getResult());
+    ensureDominatesInsertionPoint(rewriter, dstIdx);
+
+    auto insertionPoint = rewriter.getInsertionPoint();
+    setInsertionPointAfterOperands(rewriter, {cb, outCB},
+                                   /*allowHoisting*/ true);
+    rewriter.create<ttkernel::InitSFPUOp>(loc, cb, outCB);
+    rewriter.setInsertionPoint(insertionPoint->getBlock(), insertionPoint);
+
+    Value scratch = dstIdx;
+    std::optional<int64_t> dstConst = mlir::getConstantIntValue(dstIdx);
+    std::optional<int64_t> operandConst =
+        mlir::getConstantIntValue(dstOperandIdx);
+    if (!dstConst || !operandConst || *dstConst == *operandConst) {
+      scratch = index(rewriter, loc, dstConst ? *dstConst + 1 : 1);
+    }
+
+    rewriter.create<ttkernel::CopyTileInitOp>(loc, cb);
+    rewriter.create<ttkernel::CopyTileOp>(loc, cb, cbTileIdx, scratch);
+
+    const auto dtype =
+        mlir::cast<ttcore::TileType>(op.getLhs().getType()).getDataType();
+    if constexpr (needsDtypeArg<IntInit>) {
+      rewriter.create<IntInit>(loc, dtype);
+    } else {
+      rewriter.create<IntInit>(loc);
+    }
+    Value lhsIdx = lhsFromDst ? dstOperandIdx : scratch;
+    Value rhsIdx = lhsFromDst ? scratch : dstOperandIdx;
+    if constexpr (needsDtypeArg<IntSFPUOp>) {
+      rewriter.create<IntSFPUOp>(loc, lhsIdx, rhsIdx, dstIdx, dtype);
+    } else {
+      rewriter.create<IntSFPUOp>(loc, lhsIdx, rhsIdx, dstIdx);
     }
 
     rewriter.eraseOp(op);
