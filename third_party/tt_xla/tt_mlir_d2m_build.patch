+      producer->getBlock() != consumer->getBlock() ||
+      !producer->isBeforeInBlock(consumer) ||
+      !(producer.hasCompatibleBlocking(consumer) ||
+        isSingleTileProducer(producer)) ||
+      producer.getIteratorTypes() != consumer.getIteratorTypes()) {
