+// libtt: tile-aligned column slices of whole rows inside D2M subgraphs
+// (LIBTT_D2M_EXT), lowered to tile-offset views (libtt.tile_slice).
+class TTNNToTTIRSlicePattern
+    : public mlir::OpConversionPattern<mlir::tt::ttnn::SliceStaticOp> {
