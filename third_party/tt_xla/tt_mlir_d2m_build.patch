+int64_t estimateDstSlicesPerTile(linalg::GenericOp op) {
+  // Mirrors collectDstAccesses (Unscheduled.cpp): CB loads take a slice each
+  // (never freed; loads are hoisted ahead of the compute loop), a broadcast of
+  // a CB operand takes a slice that is never freed either, a result goes in
+  // place (an operand at its last use, or the first loaded operand) or into
+  // a fresh slice freed after its last compute use (stores keep it).
+  struct Occupant {
+    bool freeable;
+    int64_t remaining;
+  };
+  llvm::DenseMap<Value, Occupant> occupants;
+  auto countUses = [](Value v) {
+    return static_cast<int64_t>(
+        std::distance(v.getUses().begin(), v.getUses().end()));
+  };
+  int64_t live = 0;
+  int64_t peak = 0;
+  // A reduction with fused producers keeps every intermediate's slice (see
+  // the unscheduled allocator: the accumulator spans iterations).
+  const bool noReuse =
+      op.getNumReductionLoops() > 0 &&
+      llvm::any_of(op.getBody()->getOperations(), [](Operation &o) {
+        return mlir::isa<TileSFPUReduceSumOp, TileSFPUReduceMaxOp>(o) &&
+               !mlir::isa<BlockArgument>(o.getOperand(0));
+      });
+  for (Operation &o : op.getBody()->without_terminator()) {
+    auto iface = mlir::dyn_cast<OperandLoadStoreRegisterOpInterface>(&o);
+    if (!iface || o.getNumResults() != 1) {
+      continue;
+    }
+    const int64_t stride =
+        std::max<int64_t>(1, iface.getDstInputSliceStride());
+    int64_t loads = 0;
+    for (int64_t idx : iface.getOperandsLoadFromDstRegister()) {
+      if (!iface.isScalarOperand(idx) &&
+          mlir::isa<BlockArgument>(o.getOperand(idx))) {
+        loads += stride;
+      }
+    }
+    const bool bcastLoad = mlir::isa<TileBcastOp>(o) &&
+                           mlir::isa<BlockArgument>(o.getOperand(0));
+    const bool inPlace =
+        iface.getDstRegInPlace() ||
+        (o.getNumOperands() > 1 && iface.isScalarOperand(1));
+    std::optional<Value> reuseFrom;
+    if (inPlace) {
+      for (int64_t idx : iface.getOperandsLoadFromDstRegister()) {
+        Value v = o.getOperand(idx);
+        auto it = occupants.find(v);
+        if (!iface.isScalarOperand(idx) && it != occupants.end() &&
+            it->second.remaining <= 1) {
+          reuseFrom = v;
+          break;
+        }
+      }
+    }
+    // A binary op with no CB operand may write over an operand dying in it.
+    if (!reuseFrom && loads == 0 && !inPlace &&
+        iface.getOperandsLoadFromDstRegister().size() >= 2) {
+      for (int64_t idx : iface.getOperandsLoadFromDstRegister()) {
+        Value v = o.getOperand(idx);
+        auto it = occupants.find(v);
+        if (!iface.isScalarOperand(idx) && it != occupants.end() &&
+            it->second.remaining ==
+                static_cast<int64_t>(llvm::count(o.getOperands(), v))) {
+          reuseFrom = v;
+          break;
+        }
+      }
+    }
+    live += loads;
+    Occupant result{/*freeable=*/false, countUses(o.getResult(0))};
+    if (bcastLoad && loads == 0) {
+      live += 1;
+    } else if (reuseFrom) {
+      result.freeable = occupants.lookup(*reuseFrom).freeable;
+    } else if (loads == 0) {
+      result.freeable = true;
+      live += 1;
+    }
+    peak = std::max(peak, live);
+    for (Value operand : o.getOperands()) {
+      auto it = occupants.find(operand);
+      if (it == occupants.end() || --it->second.remaining > 0) {
+        continue;
+      }
+      if (it->second.freeable && !noReuse &&
+          !(reuseFrom && *reuseFrom == operand)) {
+        live -= 1;
+      }
+      occupants.erase(it);
+    }
+    occupants[o.getResult(0)] = result;
+    // A fused SFPU reduction (its operand computed in the body) reduces in
+    // place without a scratch slice.
+    const bool fusedReduce =
+        mlir::isa<TileSFPUReduceSumOp, TileSFPUReduceMaxOp>(o) &&
+        !mlir::isa<BlockArgument>(o.getOperand(0));
+    live += fusedReduce ? 0 : iface.getNumDstScratchSlices();
+    peak = std::max(peak, live);
+  }
+  return std::max<int64_t>(peak, 1);
+}
