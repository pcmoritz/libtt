       return failure();
     }
 
+    // The FPU carries about 19 bits of a 32-bit integer: integer tiles take
+    // the SFPU path, which has exact int32 add, subtract and multiply.
+    if (llvm::isa<IntegerType>(
+            mlir::cast<ttcore::TileType>(op.getLhs().getType())
+                .getElementType())) {
+      return failure();
+    }
+
     auto loc = op->getLoc();
     bool lhsFromDst = operandFromDst(op.getLhs());
     bool rhsFromDst = operandFromDst(op.getRhs());
