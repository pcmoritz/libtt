+  case UnaryOpType::Rsqrt:
+    return builder.create<ttir::RsqrtOp>(loc, t, input);
+  case UnaryOpType::Silu:
+    return builder.create<ttir::SiluOp>(loc, t, input);
+  case UnaryOpType::Neg:
+    return builder.create<ttir::NegOp>(loc, t, input);
+  default:
