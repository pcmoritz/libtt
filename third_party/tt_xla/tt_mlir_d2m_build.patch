+// libtt: constants (ttir.full) go to the right of commutative binary ops,
+// where D2M's ScalarizeConstTensors turns them into scalar operands.
+static void constantsToRhs(ModuleOp module) {
+  module.walk([](Operation *op) {
+    if (!mlir::isa<ttir::MultiplyOp, ttir::AddOp, ttir::MaximumOp,
+                   ttir::MinimumOp>(op) ||
+        op->getNumOperands() != 2) {
+      return;
+    }
+    Value lhs = op->getOperand(0), rhs = op->getOperand(1);
+    if (lhs.getDefiningOp<ttir::FullOp>() && !rhs.getDefiningOp<ttir::FullOp>()) {
+      op->setOperand(0, rhs);
+      op->setOperand(1, lhs);
+    }
+  });
+}
