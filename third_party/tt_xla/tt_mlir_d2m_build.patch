+// libtt: the D2M stage (subgraph lowering, collapse, cleanup) as a dynamic
+// pipeline that runs only on modules with D2M subgraphs. Building and
+// initializing its ~70 passes cost ~6 ms per compile, and most programs of a
+// served model (hundreds of small ones) have none.
+class RunD2MStageIfSubgraphs
+    : public PassWrapper<RunD2MStageIfSubgraphs, OperationPass<ModuleOp>> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(RunD2MStageIfSubgraphs)
+
+  explicit RunD2MStageIfSubgraphs(bool elementwiseFusion)
+      : elementwiseFusion(elementwiseFusion) {}
+  RunD2MStageIfSubgraphs(const RunD2MStageIfSubgraphs &other)
+      : PassWrapper(other), elementwiseFusion(other.elementwiseFusion) {}
+
+  StringRef getArgument() const final {
+    return "ttnn-run-d2m-stage-if-subgraphs";
+  }
+  StringRef getName() const final { return "TTNNRunD2MStageIfSubgraphs"; }
+
+  void getDependentDialects(DialectRegistry &registry) const override {
+    buildStage().getDependentDialects(registry);
+  }
+
+  void runOnOperation() final {
+    bool any = false;
+    getOperation().walk([&](D2MSubgraphOp) {
+      any = true;
+      return WalkResult::interrupt();
+    });
+    if (!any) {
+      return;
+    }
+    OpPassManager stage = buildStage();
+    if (failed(runPipeline(stage, getOperation()))) {
+      signalPassFailure();
+    }
+  }
+
+private:
+  OpPassManager buildStage() const {
+    OpPassManager pm(ModuleOp::getOperationName());
+    TTNNPipelineD2MPassOptions d2mOptions;
+    d2mOptions.enableElementwiseFusion = elementwiseFusion;
+    createTTNNPipelineD2MPass(pm, d2mOptions);
+    pm.addPass(createTTNNCollaspeD2M());
+    pm.addPass(createCanonicalizerPass());
+    return pm;
+  }
+
+  bool elementwiseFusion;
+};
