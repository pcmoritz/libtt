+// libtt: head-major form for per-head row ops in decode (LIBTT_D2M_EXT).
+//
+// A subgraph that splits [T, H*D] into [T, H, D] heads, computes elementwise
+// ops and last-dim reductions, and merges the heads back moves data twice in
+// TTNN's tile layout (each leading index pads to whole tiles). Computed as
+// [H, T, D] instead (every rank-3 value has dims 0 and 1 swapped), the split
+// and the merge keep every tile and its order when T <= 32 and D is a multiple
+// of 32: they become tile reinterpretations (libtt.tile_reinterpret reshapes,
+// lowered to views below). A per-token [T] factor becomes [1, T, 1], a
+// transpose of one tile.
+static RankedTensorType withShape(RankedTensorType t, ArrayRef<int64_t> shape) {
+  Attribute encoding = t.getEncoding();
+  if (auto layout = mlir::dyn_cast_if_present<mlir::tt::ttnn::TTNNLayoutAttr>(encoding)) {
+    encoding = mlir::tt::ttnn::TTNNLayoutAttr::Builder(layout, shape).build();
+  }
+  return RankedTensorType::get(shape, t.getElementType(), encoding);
+}
+
+// libtt: a per-token [T] or [1, T] row as the [T, 1] column: the same tile
+// reinterpreted, then row 0 moved to the columns in DST (ttir.row_to_column),
+// so the per-token factor needs no TTNN reshape before the subgraph.
+static mlir::Value rowToColumn(mlir::OpBuilder &b, mlir::Location loc,
+                               mlir::Value row, int64_t T) {
+  auto in = mlir::cast<RankedTensorType>(row.getType());
+  auto colType = withShape(in, {T, 1});
+  auto reinterpret = b.create<mlir::tt::ttir::ReshapeOp>(
+      loc, colType, row, b.getI32ArrayAttr({static_cast<int32_t>(T), 1}));
+  reinterpret->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+  return b.create<mlir::tt::ttir::RowToColumnOp>(loc, colType, reinterpret);
+}
+
+// libtt: group-major form for heads narrower than a tile (D = 16). Values stay in [T, H*D] (rank-3 [a, H, D]
+// and [a, H, 1] become [a, H*D], [a, 1, 1] becomes [a, 1]): a per-head
+// value [a, H, 1] is kept replicated across its head's D columns, so per-head
+// broadcasts are plain elementwise ops, and a last-dim sum is a group sum (the
+// sum of the D columns of each head, replicated), tile-local because D
+// divides 32. The split and merge reshapes disappear.
+template <typename InputList>
+static bool rewriteGroupMajor(func::FuncOp func,
+                              mlir::tt::ttir::ReshapeOp outReshape,
+                              const InputList &inputs, int64_t T, int64_t H,
+                              int64_t D) {
+  using namespace mlir::tt;
+  auto flat = [&](RankedTensorType t) -> std::optional<RankedTensorType> {
+    if (t.getRank() != 3) {
+      return t;
+    }
+    int64_t a = t.getDimSize(0), b = t.getDimSize(1), c = t.getDimSize(2);
+    if (b == H && (c == D || c == 1)) {
+      return withShape(t, {a, H * D});
+    }
+    if (b == 1 && c == 1) {
+      return withShape(t, {a, 1});
+    }
+    return std::nullopt;
+  };
+  Block &body = func.getBody().front();
+  // Check first: every rank-3 value must map; sums keep the last dim.
+  for (Operation &op : body.without_terminator()) {
+    if (&op == outReshape.getOperation()) {
+      continue;
+    }
+    for (Value r : op.getResults()) {
+      if (!flat(mlir::cast<RankedTensorType>(r.getType()))) {
+        return false;
+      }
+    }
+    if (auto sum = mlir::dyn_cast<ttir::SumOp>(op); sum && !sum.getKeepDim()) {
+      return false;
+    }
+  }
+  // Rank-3 arguments: only single elements ([1, 1, 1] -> [1, 1], one tile).
+  for (BlockArgument arg : body.getArguments()) {
+    auto t = mlir::cast<RankedTensorType>(arg.getType());
+    if (t.getRank() == 3 && t.getNumElements() != 1 && !arg.use_empty()) {
+      return false;
+    }
+  }
+  for (auto [reshapeRef, kind] : inputs) {
+    mlir::tt::ttir::ReshapeOp reshape = reshapeRef;
+    auto in = mlir::cast<RankedTensorType>(reshape.getInput().getType());
+    if (in.getRank() != 2 && in.getRank() != 1) {
+      return false;
+    }
+  }
+  mlir::OpBuilder b(func.getContext());
+  b.setInsertionPointToStart(&body);
+  for (BlockArgument arg : body.getArguments()) {
+    auto t = mlir::cast<RankedTensorType>(arg.getType());
+    if (t.getRank() != 3 || arg.use_empty()) {
+      continue;
+    }
+    auto scalar = b.create<ttir::ReshapeOp>(arg.getLoc(), withShape(t, {1, 1}),
+                                            arg, b.getI32ArrayAttr({1, 1}));
+    scalar->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+    arg.replaceAllUsesExcept(scalar.getResult(), scalar);
+  }
+  for (auto [reshapeRef, kind] : inputs) {
+    mlir::tt::ttir::ReshapeOp reshape = reshapeRef;
+    auto in = mlir::cast<RankedTensorType>(reshape.getInput().getType());
+    if (kind == std::remove_cv_t<decltype(kind)>::TokenRow) {
+      b.setInsertionPoint(reshape);
+      reshape.getResult().replaceAllUsesWith(
+          rowToColumn(b, reshape.getLoc(), reshape.getInput(), T));
+      reshape.erase();
+      continue;
+    }
+    if (in.getRank() == 2) {
+      reshape.getResult().replaceAllUsesWith(reshape.getInput());
+      reshape.erase();
+      continue;
+    }
+    // [H*D] (one tile row) -> [1, H*D]: the same tiles.
+    auto out = mlir::cast<RankedTensorType>(reshape.getType());
+    SmallVector<int64_t> shape{1, in.getDimSize(0)};
+    reshape.getResult().setType(withShape(out, shape));
+    reshape.setShapeAttr(b.getI32ArrayAttr(
+        {1, static_cast<int32_t>(in.getDimSize(0))}));
+    reshape->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+  }
+  for (Operation &op : llvm::make_early_inc_range(body.without_terminator())) {
+    if (&op == outReshape.getOperation()) {
+      continue;
+    }
+    if (auto sum = mlir::dyn_cast<ttir::SumOp>(op)) {
+      b.setInsertionPoint(sum);
+      auto type = *flat(mlir::cast<RankedTensorType>(sum.getType()));
+      auto groupSum = b.create<ttir::GroupSumOp>(
+          sum.getLoc(), type, sum.getInput(), b.getI64IntegerAttr(D));
+      sum.getResult().replaceAllUsesWith(groupSum.getResult());
+      sum.erase();
+      continue;
+    }
+    if (mlir::isa<ttir::ReshapeOp>(op)) {
+      continue;
+    }
+    for (Value r : op.getResults()) {
+      r.setType(*flat(mlir::cast<RankedTensorType>(r.getType())));
+    }
+    if (auto full = mlir::dyn_cast<ttir::FullOp>(op)) {
+      auto t = mlir::cast<RankedTensorType>(full.getType());
+      full.setShapeAttr(b.getDenseI32ArrayAttr(
+          llvm::to_vector_of<int32_t>(t.getShape())));
+    }
+  }
+  // The merge: the last value already is [T, H*D]; give it the result type.
+  Value last = outReshape.getInput();
+  last.setType(outReshape.getType());
+  outReshape.getResult().replaceAllUsesWith(last);
+  outReshape.erase();
+  func->setAttr("libtt.group_major", b.getUnitAttr());
+  return true;
+}
+
+// libtt: an elementwise subgraph over one tile row [T, N] (T <= 32) wider
+// than a core row (more than 8 tiles; Inkling 2's attention output gate,
+// [1, 768]) gets one core row. Computed as [k, T, N / k] (the same tiles in
+// the same order, k tile rows: tile reinterpretations), it spreads over k.
+bool rewriteWideRowSubgraph(func::FuncOp func) {
+  namespace ttir = mlir::tt::ttir;
+  if (func.getBody().getBlocks().size() != 1) {
+    return false;
+  }
+  Block &body = func.getBody().front();
+  int64_t T = -1, N = -1;
+  auto row = [&](Type type) {
+    auto t = mlir::dyn_cast<RankedTensorType>(type);
+    if (!t || t.getNumElements() == 1) {
+      return t != nullptr;
+    }
+    if (t.getRank() != 2) {
+      return false;
+    }
+    if (T < 0) {
+      T = t.getDimSize(0);
+      N = t.getDimSize(1);
+    }
+    return t.getDimSize(0) == T && t.getDimSize(1) == N;
+  };
+  for (Operation &op : body) {
+    auto slice = mlir::dyn_cast<ttir::SliceStaticOp>(op);
+    if (slice && !slice->hasAttr("libtt.tile_slice")) {
+      return false;
+    }
+    if (!slice && !mlir::isa<ttir::ElementwiseUnary, ttir::ElementwiseBinary,
+                             ttir::TypecastOp, ttir::FullOp, func::ReturnOp>(
+                      op)) {
+      return false;
+    }
+    if (!slice && !llvm::all_of(op.getOperandTypes(), row)) {
+      return false;
+    }
+    if (!llvm::all_of(op.getResultTypes(), row)) {
+      return false;
+    }
+  }
+  if (T < 1 || T > 32 || N % 32 != 0) {
+    return false;
+  }
+  const int64_t tiles = N / 32;
+  int64_t k = 0;
+  for (int64_t d = 2; d <= 8 && !k; ++d) {
+    if (tiles % d == 0 && tiles / d <= 8) {
+      k = d;
+    }
+  }
+  if (tiles <= 8 || !k) {
+    return false;
+  }
+  SmallVector<int64_t> wide{k, T, N / k};
+  auto widen = [&](RankedTensorType t) {
+    return t.getNumElements() == 1 ? withShape(t, {1, 1, 1})
+                                   : withShape(t, wide);
+  };
+  mlir::OpBuilder b(func.getContext());
+  auto reinterpret = [&](Location loc, Value v, RankedTensorType to) {
+    auto r = b.create<ttir::ReshapeOp>(
+        loc, to, v,
+        b.getI32ArrayAttr(llvm::to_vector_of<int32_t>(to.getShape())));
+    r->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+    return r;
+  };
+  // Arguments (other than slice sources) and slice results: views.
+  b.setInsertionPointToStart(&body);
+  for (BlockArgument arg : body.getArguments()) {
+    if (llvm::all_of(arg.getUsers(), [](Operation *u) {
+          return mlir::isa<ttir::SliceStaticOp>(u);
+        })) {
+      continue;
+    }
+    auto t = mlir::cast<RankedTensorType>(arg.getType());
+    auto view = reinterpret(arg.getLoc(), arg, widen(t));
+    arg.replaceUsesWithIf(view.getResult(), [&](OpOperand &use) {
+      return use.getOwner() != view &&
+             !mlir::isa<ttir::SliceStaticOp>(use.getOwner());
+    });
+  }
+  for (Operation &op : llvm::make_early_inc_range(body.without_terminator())) {
+    if (auto slice = mlir::dyn_cast<ttir::SliceStaticOp>(op)) {
+      b.setInsertionPointAfter(slice);
+      auto view = reinterpret(slice.getLoc(), slice.getResult(),
+                              widen(slice.getType()));
+      slice.getResult().replaceAllUsesExcept(view.getResult(), view);
+      continue;
+    }
+    if (mlir::isa<ttir::ReshapeOp>(op)) {
+      continue;
+    }
+    for (Value r : op.getResults()) {
+      r.setType(widen(mlir::cast<RankedTensorType>(r.getType())));
+    }
+    if (auto full = mlir::dyn_cast<ttir::FullOp>(op)) {
+      auto t = mlir::cast<RankedTensorType>(full.getType());
+      full.setShapeAttr(b.getDenseI32ArrayAttr(
+          llvm::to_vector_of<int32_t>(t.getShape())));
+    }
+  }
+  auto ret = mlir::cast<func::ReturnOp>(body.getTerminator());
+  b.setInsertionPoint(ret);
+  for (auto [i, v] : llvm::enumerate(ret.getOperands())) {
+    auto to = mlir::cast<RankedTensorType>(func.getResultTypes()[i]);
+    if (v.getType() != to) {
+      ret.setOperand(i, reinterpret(ret.getLoc(), v, to).getResult());
+    }
+  }
+  func->setAttr("libtt.wide_rows", b.getUnitAttr());
+  return true;
+}
+
+bool rewriteHeadMajorSubgraph(func::FuncOp func) {
+
+  if (func.getBody().getBlocks().size() != 1) {
+    return false;
+  }
+  Block &body = func.getBody().front();
+  // Unused reshapes (a norm weight's [1, D] -> [D] after its decomposition
+  // looked through it) are not part of the subgraph.
+  for (Operation &op : llvm::make_early_inc_range(llvm::reverse(body))) {
+    if (mlir::isa<mlir::tt::ttir::ReshapeOp>(op) && op.use_empty()) {
+      op.erase();
+    }
+  }
+  auto ret = mlir::dyn_cast<func::ReturnOp>(body.getTerminator());
+  if (!ret || ret.getNumOperands() != 1) {
+    return false;
+  }
+  auto outReshape = ret.getOperand(0).getDefiningOp<mlir::tt::ttir::ReshapeOp>();
+  if (!outReshape) {
+    return false;
+  }
+  auto merged = mlir::cast<RankedTensorType>(outReshape.getType());
+  auto heads = mlir::cast<RankedTensorType>(outReshape.getInput().getType());
+  if (merged.getRank() != 2 || heads.getRank() != 3) {
+    return false;
+  }
+  int64_t T = heads.getDimSize(0), H = heads.getDimSize(1),
+          D = heads.getDimSize(2);
+  // Group-major: heads of 16 stay in [T, H*D] (two
+  // per tile width); last-dim sums become group sums, see below.
+  const bool group = D == 16;
+  if (T > 32 || (D % 32 != 0 && !group) || merged.getDimSize(0) != T ||
+      merged.getDimSize(1) != H * D) {
+    return false;
+  }
+  // Classify the input reshapes; everything else must be elementwise or a
+  // last-dim reduction on rank-3 values.
+  enum class Kind { Split, Scale, Token, TokenRow, Row };
+  SmallVector<std::pair<mlir::tt::ttir::ReshapeOp, Kind>> inputs;
+  for (Operation &op : body.without_terminator()) {
+    if (&op == outReshape.getOperation()) {
+      continue;
+    }
+    if (auto reshape = mlir::dyn_cast<mlir::tt::ttir::ReshapeOp>(op)) {
+      auto in = mlir::cast<RankedTensorType>(reshape.getInput().getType());
+      auto out = mlir::cast<RankedTensorType>(reshape.getType());
+      // Inputs are arguments or rank <= 2 values computed here (e.g. the
+      // widening typecast of [T, H*D]).
+      if (out.getRank() != 3 || in.getRank() == 0 || in.getRank() > 2) {
+        return false;
+      }
+      int64_t inRows = in.getRank() == 2 ? in.getDimSize(0) : 1;
+      int64_t inCols = in.getShape().back();
+      if (out.getShape() == ArrayRef<int64_t>{T, H, D} && inRows == T &&
+          inCols == H * D) {
+        inputs.push_back({reshape, Kind::Split});
+      } else if (out.getShape() == ArrayRef<int64_t>{1, H, D} && inRows == 1 &&
+                 inCols == H * D) {
+        inputs.push_back({reshape, Kind::Scale});
+      } else if (out.getShape() == ArrayRef<int64_t>{T, 1, 1} &&
+                 in.getRank() == 2 && in.getDimSize(0) == T &&
+                 in.getDimSize(1) == 1) {
+        inputs.push_back({reshape, Kind::Token});
+      } else if (out.getShape() == ArrayRef<int64_t>{T, 1, 1} &&
+                 inRows == 1 && inCols == T) {
+        inputs.push_back({reshape, Kind::TokenRow});
+      } else if (out.getShape() == ArrayRef<int64_t>{1, 1, D} && inRows == 1 &&
+                 inCols == D && !group) {
+        // A row for every head (a norm's weight): the same tile in [H, T, D].
+        inputs.push_back({reshape, Kind::Row});
+      } else {
+        return false;
+      }
+      continue;
+    }
+    if (op.getNumResults() != 1 || op.getNumRegions() != 0) {
+      return false;
+    }
+    auto t = mlir::dyn_cast<RankedTensorType>(op.getResult(0).getType());
+    // Rank <= 2 elementwise ops (before the split) keep their layout.
+    if (t && t.getRank() < 3 &&
+        mlir::isa<mlir::tt::ttir::ElementwiseUnary,
+                  mlir::tt::ttir::ElementwiseBinary,
+                  mlir::tt::ttir::TypecastOp, mlir::tt::ttir::SliceStaticOp>(
+            op) &&
+        llvm::all_of(op.getOperandTypes(), [](Type type) {
+          return mlir::cast<RankedTensorType>(type).getRank() < 3;
+        })) {
+      continue;
+    }
+    if (!t || (t.getRank() != 3 && !mlir::isa<mlir::tt::ttir::FullOp>(op))) {
+      return false;
+    }
+    if (auto sum = mlir::dyn_cast<mlir::tt::ttir::SumOp>(op)) {
+      auto dims = sum.getDimArg();
+      if (!dims || dims->size() != 1 ||
+          (mlir::cast<IntegerAttr>((*dims)[0]).getInt() != 2 &&
+           mlir::cast<IntegerAttr>((*dims)[0]).getInt() != -1)) {
+        return false;
+      }
+      continue;
+    }
+    if (!mlir::isa<mlir::tt::ttir::ElementwiseUnary, mlir::tt::ttir::ElementwiseBinary,
+                   mlir::tt::ttir::FullOp, mlir::tt::ttir::TypecastOp, mlir::tt::ttir::ClampScalarOp>(op)) {
+      return false;
+    }
+  }
+  if (!llvm::any_of(inputs, [](auto p) { return p.second == Kind::Split; })) {
+    return false;
+  }
+  // Rank-3 arguments keep TTNN's [T, H, D] layout: only single elements.
+  for (BlockArgument arg : body.getArguments()) {
+    auto t = mlir::cast<RankedTensorType>(arg.getType());
+    if (t.getRank() == 3 && t.getNumElements() != 1 && !arg.use_empty()) {
+      return false;
+    }
+  }
+  if (group) {
+    return rewriteGroupMajor(func, outReshape, inputs, T, H, D);
+  }
+  auto swapped = [](RankedTensorType t) {
+    if (t.getRank() != 3) {
+      return t;
+    }
+    SmallVector<int64_t> shape{t.getDimSize(1), t.getDimSize(0),
+                               t.getDimSize(2)};
+    return withShape(t, shape);
+  };
+  mlir::OpBuilder b(func.getContext());
+  for (Operation &op : llvm::make_early_inc_range(body.without_terminator())) {
+    if (&op == outReshape.getOperation()) {
+      continue;
+    }
+    auto reshape = mlir::dyn_cast<mlir::tt::ttir::ReshapeOp>(op);
+    auto it = llvm::find_if(inputs, [&](auto p) { return p.first == reshape; });
+    if (reshape && it != inputs.end()) {
+      auto out = mlir::cast<RankedTensorType>(reshape.getType());
+      if (it->second == Kind::TokenRow) {
+        // [1, T] or [T] -> the column [T, 1] (row_to_column), reinterpreted
+        // as the column [1, T, 1].
+        b.setInsertionPoint(reshape);
+        mlir::Value col =
+            rowToColumn(b, reshape.getLoc(), reshape.getInput(), T);
+        auto tok = b.create<mlir::tt::ttir::ReshapeOp>(
+            reshape.getLoc(), withShape(out, {1, T, 1}), col,
+            b.getI32ArrayAttr({1, static_cast<int32_t>(T), 1}));
+        tok->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+        reshape.getResult().replaceAllUsesWith(tok.getResult());
+        reshape.erase();
+        continue;
+      }
+      if (it->second == Kind::Token) {
+        // [T, 1] (column 0 of one tile, made by TTNN) reinterpreted as the
+        // column [1, T, 1].
+        reshape.getResult().setType(withShape(out, {1, T, 1}));
+        reshape.setShapeAttr(
+            b.getI32ArrayAttr({1, static_cast<int32_t>(T), 1}));
+        reshape->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+        continue;
+      }
+      auto newType = swapped(out);
+      reshape.getResult().setType(newType);
+      reshape.setShapeAttr(b.getI32ArrayAttr(
+          llvm::to_vector_of<int32_t>(newType.getShape())));
+      reshape->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+      continue;
+    }
+    for (Value r : op.getResults()) {
+      auto t = mlir::cast<RankedTensorType>(r.getType());
+      r.setType(swapped(t));
+    }
+    if (auto full = mlir::dyn_cast<mlir::tt::ttir::FullOp>(op)) {
+      auto t = mlir::cast<RankedTensorType>(full.getType());
+      full.setShapeAttr(b.getDenseI32ArrayAttr(
+          llvm::to_vector_of<int32_t>(t.getShape())));
+    }
+  }
+  outReshape->setAttr("libtt.tile_reinterpret", b.getUnitAttr());
+  func->setAttr("libtt.head_major", b.getUnitAttr());
+  return true;
+}
