+// Whether a program input is only consumed by capture_or_execute_trace ops as
+// a host-staged operand (neither a trace key nor device resident). Such an
+// input is copied into a trace input slot, so it may also arrive on device.
+// Deallocations are not uses: program inputs are retained.
+static bool isHostStagedTraceInput(Binary executableHandle,
+                                   std::uint32_t programIndex,
+                                   std::uint32_t inputIndex) {
+  const ::tt::target::ttnn::Program *program =
+      utils::getProgram(executableHandle, programIndex);
+  const std::uint32_t id = program->inputs()->Get(inputIndex)->global_id();
+  bool stagedUse = false;
+  for (const ::tt::target::ttnn::Operation *op : *program->operations()) {
+    if (op->type_as_DeallocateOp()) {
+      continue;
+    }
+    const auto *trace = op->type_as_CaptureOrExecuteTraceOp();
+    const auto *keys = trace ? trace->trace_key_input_indices() : nullptr;
+    auto opHandle = ::tt::runtime::utils::unsafeBorrowShared(
+        const_cast<::tt::target::ttnn::Operation *>(op));
+    std::vector<TensorRef> refs =
+        getOpInputRefs(OpContext(opHandle, DeviceRuntime::TTNN));
+    for (std::uint32_t i = 0; i < refs.size(); ++i) {
+      const auto &ref =
+          refs[i].as<::tt::target::ttnn::TensorRef>(DeviceRuntime::TTNN);
+      if (ref.global_id() != id) {
+        continue;
+      }
+      const bool isKey =
+          keys && std::find(keys->begin(), keys->end(), i) != keys->end();
+      if (!trace || isKey || utils::inDeviceMemory(&ref)) {
+        return false;
+      }
+      stagedUse = true;
+    }
+  }
+  return stagedUse;
+}
