+// Copies a host-staged input that already lives on device (e.g. another
+// executable's output) into its slot without leaving the device.
+static void copyTensorOnDevice(const ::ttnn::Tensor &srcTensor,
+                               ::ttnn::Tensor &dstTensor) {
+  ::ttnn::Tensor src = srcTensor;
+  if (src.layout() != dstTensor.layout() || src.dtype() != dstTensor.dtype() ||
+      src.memory_config() != dstTensor.memory_config()) {
+    src = ::ttnn::to_layout(src, dstTensor.layout(), dstTensor.dtype(),
+                            dstTensor.memory_config());
+  }
+  ::ttnn::copy(src, dstTensor);
+}
