+// variants therefore read an input that isn't staged at the same address.
+static void stageMovedInputs(
+    const ::tt::target::ttnn::CaptureOrExecuteTraceOp *op,
+    ProgramContext &context, TraceCache &traceCache, TraceData &traceData) {
+  if (traceData.variants.empty()) {
