-// Pattern to convert mhlo.topk to ttir.topk
+static LogicalResult replaceWithTopK(
+    mlir::stablehlo::CustomCallOp srcOp, Value input, int32_t k, int32_t dim,
+    bool largest, const TypeConverter *typeConverter,
+    ConversionPatternRewriter &rewriter) {
+  SmallVector<Type> resultTypes;
+  if (failed(typeConverter->convertTypes(srcOp->getResultTypes(),
+                                         resultTypes))) {
+    return failure();
+  }
+
+  rewriter.replaceOpWithNewOp<ttir::TopKOp>(
+      srcOp, resultTypes, input, rewriter.getI32IntegerAttr(k),
+      rewriter.getI32IntegerAttr(dim), rewriter.getBoolAttr(largest),
+      rewriter.getBoolAttr(true));
+  return success();
+}
+
+static FailureOr<bool>
+getApproxTopKLargest(mlir::stablehlo::CustomCallOp srcOp) {
+  auto calledComputations = srcOp.getCalledComputations();
+  if (calledComputations.size() != 1) {
+    return failure();
+  }
+  auto comparatorRef =
+      mlir::dyn_cast<FlatSymbolRefAttr>(calledComputations[0]);
+  auto moduleOp = srcOp->getParentOfType<ModuleOp>();
+  auto comparator =
+      comparatorRef
+          ? moduleOp.lookupSymbol<func::FuncOp>(comparatorRef.getValue())
+          : nullptr;
+  if (!comparator || comparator.getBody().empty()) {
+    return failure();
+  }
+
+  Block &entryBlock = comparator.getBody().front();
+  if (entryBlock.getNumArguments() < 2) {
+    return failure();
+  }
+
+  FailureOr<bool> isDescending = failure();
+  comparator.walk([&](mlir::stablehlo::CompareOp compareOp) {
+    if (compareOp->getOperand(0) != entryBlock.getArgument(0) ||
+        compareOp->getOperand(1) != entryBlock.getArgument(1)) {
+      return WalkResult::advance();
+    }
+
+    auto direction = compareOp.getComparisonDirection();
+    if (direction != mlir::stablehlo::ComparisonDirection::LT &&
+        direction != mlir::stablehlo::ComparisonDirection::GT) {
+      return WalkResult::advance();
+    }
+    isDescending = direction == mlir::stablehlo::ComparisonDirection::GT;
+    return WalkResult::interrupt();
+  });
+  return isDescending;
+}
