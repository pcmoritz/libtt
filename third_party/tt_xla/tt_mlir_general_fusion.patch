+template <typename TensorManipulationOp>
+class D2MCollapsedViewRewriter
+    : public D2MCollapsedOpRewriter<TensorManipulationOp> {
+public:
+  using D2MCollapsedOpRewriter<
+      TensorManipulationOp>::D2MCollapsedOpRewriter;
+
+  LogicalResult
+  matchAndRewrite(TensorManipulationOp op,
+                  typename TensorManipulationOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if constexpr (std::is_same_v<TensorManipulationOp, ttir::ReshapeOp>) {
+      auto inputType = mlir::cast<RankedTensorType>(op.getInput().getType());
+      auto resultType = mlir::cast<RankedTensorType>(op.getResult().getType());
+      if (inputType.getRank() < 2 || resultType.getRank() < 2 ||
+          inputType.getShape().take_back(2) !=
+              resultType.getShape().take_back(2)) {
+        return rewriter.notifyMatchFailure(op,
+                                           "not a supported collapsed view");
+      }
+    } else {
+      auto begins = extractFromIntegerArrayAttr<int32_t>(op.getBegins());
+      auto ends = extractFromIntegerArrayAttr<int32_t>(op.getEnds());
+      auto steps = extractFromIntegerArrayAttr<int32_t>(op.getStep());
+      auto inputType = mlir::cast<RankedTensorType>(op.getInput().getType());
+      const size_t rank = inputType.getRank();
+      constexpr auto tileShape = ttcore::TileType::getDefaultShape();
+      bool onlySlicesWidth =
+          rank >= 2 && steps.back() == 1 &&
+          begins.back() % tileShape[1] == 0 &&
+          ends.back() % tileShape[1] == 0;
+      for (size_t dim = 0; dim + 1 < rank; ++dim) {
+        onlySlicesWidth &= begins[dim] == 0 && steps[dim] == 1 &&
+                           ends[dim] == inputType.getShape()[dim];
+      }
+      if (!onlySlicesWidth) {
+        return rewriter.notifyMatchFailure(op,
+                                           "not a supported collapsed view");
+      }
+    }
+
+    Value input = this->createOptimalLayoutOp(
+        adaptor.getInput(), this->memorySpaces[0], /*tiled=*/true,
+        /*noCollapse=*/false, rewriter);
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    auto resultType = mlir::cast<RankedTensorType>(op.getResult().getType());
+    auto resultMetalType =
+        this->getMetalTensorFromTTNNTensor(rewriter, op.getResult());
+    AffineMap remapping;
+    if constexpr (std::is_same_v<TensorManipulationOp, ttir::ReshapeOp>) {
+      remapping = ttmlir::utils::calculateReblockMap(
+          inputType.getShape(), resultMetalType.getShape(),
+          rewriter.getContext());
+    } else {
+      TT_assert(inputType.getRank() == resultMetalType.getRank());
+      auto begins = extractFromIntegerArrayAttr<int32_t>(op.getBegins());
+      constexpr auto tileShape = ttcore::TileType::getDefaultShape();
+      remapping = ttmlir::utils::applyOffsetsToAffineMapResults(
+          rewriter.getMultiDimIdentityMap(resultMetalType.getRank()),
+          {begins.back() / tileShape[1]}, resultMetalType.getRank() - 1);
+    }
+    auto view = rewriter.create<d2m::ViewLayoutOp>(
+        op.getLoc(), resultMetalType, input, remapping,
+        /*reinterpretLayout=*/false);
+    rewriter.replaceOp(
+        op, this->unLayoutResult(rewriter, view.getResult(), resultType));
+    return success();
+  }
+};
