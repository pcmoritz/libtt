 namespace {
+template <typename Op>
+class D2MCollapsedOpRewriter : public OpConversionPattern<Op>,
+                               protected D2MNamedRewriterCommon {
+public:
+  D2MCollapsedOpRewriter(const TypeConverter &typeConverter,
+                         mlir::MLIRContext *ctx,
+                         ttcore::MemorySpace defaultInputMemSpace,
+                         ttcore::MemorySpace defaultOutputMemSpace,
+                         bool enableMulticastInference)
+      : OpConversionPattern<Op>(typeConverter, ctx, PatternBenefit(2)),
+        D2MNamedRewriterCommon(defaultInputMemSpace, defaultOutputMemSpace,
+                               /*ttnnMode=*/true, /*collapseTensors=*/false,
+                               enableMulticastInference) {}
+};
+
+class D2MCollapsedConcatRewriter final
+    : public D2MCollapsedOpRewriter<ttir::ConcatOp> {
+public:
+  using D2MCollapsedOpRewriter<ttir::ConcatOp>::D2MCollapsedOpRewriter;
+
+  LogicalResult
+  matchAndRewrite(ttir::ConcatOp op, ttir::ConcatOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const final {
+    auto outType = mlir::cast<RankedTensorType>(op.getResult().getType());
+    const int64_t rank = outType.getRank();
+    int32_t dim = op.getDim();
+    if (dim < 0) {
+      dim += rank;
+    }
+
+    if (adaptor.getOperands().size() <= 1 || dim != rank - 1) {
+      return rewriter.notifyMatchFailure(op,
+                                         "not a collapsed width concat");
+    }
+    constexpr auto tileShape = ttcore::TileType::getDefaultShape();
+    for (Value input : op.getInputs().drop_back()) {
+      auto inputType = mlir::cast<RankedTensorType>(input.getType());
+      if (inputType.getShape()[dim] % tileShape[1] != 0) {
+        return rewriter.notifyMatchFailure(op,
+                                           "requires row-major concat");
+      }
+    }
+
+    SmallVector<d2m::GenericOp> producers;
+    producers.reserve(adaptor.getOperands().size());
+    for (Value input : adaptor.getOperands()) {
+      auto cast = input.getDefiningOp<ttir::TTNNMetalLayoutCastOp>();
+      auto inputType =
+          cast ? mlir::dyn_cast<RankedTensorType>(cast.getInput().getType())
+               : nullptr;
+      auto layout =
+          inputType ? mlir::dyn_cast_if_present<ttcore::MetalLayoutAttr>(
+                          inputType.getEncoding())
+                    : nullptr;
+      auto producer =
+          cast ? cast.getInput().getDefiningOp<d2m::GenericOp>() : nullptr;
+      if (!producer || producer.getOutputs().size() != 1 ||
+          producer->getBlock() != op->getBlock() || !layout ||
+          layout.getMemorySpace() != memorySpaces[0] ||
+          !mlir::isa<ttcore::TileType>(inputType.getElementType())) {
+        return rewriter.notifyMatchFailure(op,
+                                           "inputs cannot write concat output");
+      }
+      if (llvm::is_contained(producers, producer)) {
+        return rewriter.notifyMatchFailure(op,
+                                           "requires distinct producers");
+      }
+      producers.push_back(producer);
+    }
+
+    auto loc = op.getLoc();
+    auto origOutputs = createDpsOutputs(loc, rewriter, {outType});
+    auto [inputs, outputs] = toLayoutOperandsAndResults(
+        rewriter, {adaptor.getOperands(), origOutputs},
+        /*tiled=*/true, /*noCollapse=*/false);
+
+    auto outputCast = mlir::cast<ttir::TTNNMetalLayoutCastOp>(
+        outputs[0].getDefiningOp());
+    Operation *outputEmpty = outputCast.getInput().getDefiningOp();
+    TT_assert((mlir::isa<ttir::EmptyOp, d2m::EmptyOp>(outputEmpty)));
+
+    Operation *insertBefore =
+        *llvm::min_element(producers, [](d2m::GenericOp lhs,
+                                        d2m::GenericOp rhs) {
+          return lhs->isBeforeInBlock(rhs);
+        });
+    outputEmpty->moveBefore(insertBefore);
+    outputCast->moveBefore(insertBefore);
+
+    rewriter.setInsertionPoint(insertBefore);
+    int64_t offset = 0;
+    for (auto [input, producer] : llvm::zip_equal(inputs, producers)) {
+      auto inputType = mlir::cast<RankedTensorType>(input.getType());
+      auto remapping = ttmlir::utils::applyOffsetsToAffineMapResults(
+          rewriter.getMultiDimIdentityMap(inputType.getRank()), {offset},
+          inputType.getRank() - 1);
+      auto view = rewriter.create<d2m::ViewLayoutOp>(
+          loc, inputType, outputs[0], remapping,
+          /*reinterpretLayout=*/false);
+
+      Value oldOutput = producer.getOutputs().front();
+      producer.getOutputsMutable().assign(view.getResult());
+      oldOutput.replaceUsesWithIf(view.getResult(), [&](OpOperand &use) {
+        return producer->isProperAncestor(use.getOwner());
+      });
+      offset += inputType.getShape().back();
+    }
+
+    rewriter.setInsertionPoint(op);
+    Value result = unLayoutResult(rewriter, outputs[0], outType)->getResult(0);
+    rewriter.replaceOp(op, result);
+    return success();
+  }
+};
