 // 2. sum reduce(exp(x)) along a dimension with keep_dim=true
 // 3. (optional) broadcast the sum reduce
 // 4. divide exp(x) by the (broadcasted) sum reduce
+// TTNN's softmax kernels split their work across cores by tile rows, so each
+// row runs on one core. With the exact exp and FP32 accumulation that FP32
+// probabilities need, rows wider than 1024 take longer than the exp / sum /
+// divide decomposition, which reduces each row across cores: 64 rows of 16384
+// take 1.3 ms against 0.15 ms, two rows of 4096 0.14 ms against 0.08 ms. Such
+// rows keep the decomposition.
+static bool isWideSoftmax(mlir::RankedTensorType type, int64_t dim) {
+  constexpr int64_t maxFusedWidth = 1024;
+  if (dim < 0) {
+    dim += type.getRank();
+  }
+  return !type.isDynamicDim(dim) && type.getDimSize(dim) > maxFusedWidth;
+}
