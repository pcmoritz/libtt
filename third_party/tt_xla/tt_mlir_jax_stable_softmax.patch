+// Reads a splat scalar value from a constant-like value, tracing back through
+// layout ops (typecast/reshape/broadcast/repeat_interleave). Handles
+// ttir.full, ttir.constant (splat) and ttir.zeros. Returns std::nullopt if the
+// value is not a recognizable scalar constant.
+static std::optional<double> getSplatConstantValue(mlir::Value value) {
+  value = utils::lookThroughLayoutOps(value);
+  mlir::Operation *op = value.getDefiningOp();
+  if (!op) {
+    return std::nullopt;
+  }
+  if (mlir::isa<ZerosOp>(op)) {
+    return 0.0;
+  }
+  if (auto fullOp = mlir::dyn_cast<FullOp>(op)) {
+    mlir::Attribute fill = fullOp.getFillValue();
+    if (auto floatAttr = mlir::dyn_cast<mlir::FloatAttr>(fill)) {
+      return floatAttr.getValue().convertToDouble();
+    }
+    if (auto intAttr = mlir::dyn_cast<mlir::IntegerAttr>(fill)) {
+      return static_cast<double>(intAttr.getValue().getSExtValue());
+    }
+    return std::nullopt;
+  }
+  if (auto constOp = mlir::dyn_cast<ConstantOp>(op)) {
+    auto elements = mlir::dyn_cast<mlir::ElementsAttr>(constOp.getValue());
+    if (!elements || !elements.isSplat()) {
+      return std::nullopt;
+    }
+    mlir::Type elemType = elements.getElementType();
+    if (mlir::isa<mlir::FloatType>(elemType)) {
+      return elements.getSplatValue<mlir::APFloat>().convertToDouble();
+    }
+    if (mlir::isa<mlir::IntegerType>(elemType)) {
+      return static_cast<double>(
+          elements.getSplatValue<llvm::APInt>().getSExtValue());
+    }
+  }
+  return std::nullopt;
+}
+
+// JAX's softmax subtracts max(x, initial=-inf) along the softmax dim:
+// maximum(-inf, max(x, keep_dim=false)), reshaped to the keep_dim shape and
+// broadcast back. Returns that max.
+static MaxOp findJaxSoftmaxMax(mlir::Value subtracted,
+                               mlir::RankedTensorType inputType,
+                               int64_t dim) {
+  if (auto broadcastOp = subtracted.getDefiningOp<BroadcastOp>()) {
+    subtracted = broadcastOp.getInput();
+  }
+  llvm::SmallVector<int64_t> keepDimShape(inputType.getShape());
+  keepDimShape[dim] = 1;
+  if (mlir::cast<mlir::RankedTensorType>(subtracted.getType()).getShape() !=
+      llvm::ArrayRef<int64_t>(keepDimShape)) {
+    return nullptr;
+  }
+  auto throughReshapes = [](mlir::Value value) {
+    while (auto reshapeOp = value.getDefiningOp<ReshapeOp>()) {
+      value = reshapeOp.getInput();
+    }
+    return value;
+  };
+  auto isNegativeInfinity = [](mlir::Value value) {
+    std::optional<double> splat = getSplatConstantValue(value);
+    return splat && *splat == -std::numeric_limits<double>::infinity();
+  };
+  mlir::Value max = throughReshapes(subtracted);
+  if (auto maximumOp = max.getDefiningOp<MaximumOp>()) {
+    if (isNegativeInfinity(maximumOp.getLhs())) {
+      max = maximumOp.getRhs();
+    } else if (isNegativeInfinity(maximumOp.getRhs())) {
+      max = maximumOp.getLhs();
+    } else {
+      return nullptr;
+    }
+    max = throughReshapes(max);
+  }
+  // Without keep_dim, the max has the input's shape less the softmax dim, and
+  // reshapes keep row-major order, so the ones above only reinsert that dim.
+  auto maxOp = max.getDefiningOp<MaxOp>();
+  if (!maxOp || maxOp.getKeepDim()) {
+    return nullptr;
+  }
+  return maxOp;
+}
