diff --git a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
--- a/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
+++ b/lib/Conversion/TTIRToTTNN/TTIRToTTNN.cpp
@@ -524,9 +524,23 @@ public:
   LogicalResult
   matchAndRewrite(ttir::SoftmaxOp op, OpAdaptor adaptor,
                   ConversionPatternRewriter &rewriter) const override {
+    // An FP32 softmax needs the exact exp and FP32 sums: the approximate exp
+    // alone leaves its probabilities about 3% off. TTNN's defaults give both,
+    // but the runtime fills a config's unset fields with the approximate exp,
+    // LoFi and BF16 sums, and at O0 the pipeline sets HiFi4 and FP32 sums on
+    // every op, so FP32 inputs spell out all three.
+    ttnn::DeviceComputeKernelConfigAttr computeConfig;
+    if (op.getInput().getType().getElementType().isF32()) {
+      computeConfig =
+          ttnn::DeviceComputeKernelConfigAttr::get(rewriter.getContext())
+              .withMathFidelity(ttnn::MathFidelity::HiFi4)
+              .withFp32DestAccEn(true)
+              .withMathApproxMode(false);
+    }
     rewriter.replaceOpWithNewOp<ttnn::SoftmaxOp>(
         op, this->getTypeConverter()->convertType(op.getType()),
-        adaptor.getInput(), adaptor.getDimension(), adaptor.getNumericStable());
+        adaptor.getInput(), adaptor.getDimension(), adaptor.getNumericStable(),
+        computeConfig);
     return success();
   }
 };
