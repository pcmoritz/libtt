+namespace {
+class StableHLOToTTIRDynamicUpdateSliceOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::DynamicUpdateSliceOp> {
+  using OpConversionPattern<
+      mlir::stablehlo::DynamicUpdateSliceOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::DynamicUpdateSliceOp srcOp,
+                  mlir::stablehlo::DynamicUpdateSliceOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    Location loc = srcOp.getLoc();
+    auto operandType =
+        mlir::cast<RankedTensorType>(adaptor.getOperand().getType());
+    auto updateType =
+        mlir::cast<RankedTensorType>(adaptor.getUpdate().getType());
+    int64_t rank = operandType.getRank();
+
+    if (rank == 0) {
+      rewriter.replaceOp(srcOp, adaptor.getUpdate());
+      return success();
+    }
+    if (llvm::is_contained(updateType.getShape(), 0)) {
+      rewriter.replaceOp(srcOp, adaptor.getOperand());
+      return success();
+    }
+
+    Type indexElementType =
+        mlir::cast<RankedTensorType>(
+            adaptor.getStartIndices().front().getType())
+            .getElementType();
+    if (!indexElementType.isInteger(32)) {
+      return rewriter.notifyMatchFailure(srcOp,
+                                         "requires 32-bit start indices");
+    }
+
+    ArrayRef<int64_t> operandShape = operandType.getShape();
+    ArrayRef<int64_t> updateShape = updateType.getShape();
+    SmallVector<int64_t> operandStrides(rank, 1);
+    for (int64_t dim = rank - 1; dim > 0; --dim) {
+      operandStrides[dim - 1] = operandStrides[dim] * operandShape[dim];
+    }
+
+    auto indexScalarType = RankedTensorType::get({1}, indexElementType);
+    auto scalarConstant = [&](int64_t value) -> Value {
+      SmallVector<int32_t, 1> values{static_cast<int32_t>(value)};
+      return rewriter.create<ttir::ConstantOp>(
+          loc, indexScalarType,
+          DenseIntElementsAttr::get(indexScalarType, values));
+    };
+
+    // Compute the flattened, clamped start offset on device.
+    Value base;
+    for (auto [dim, start] : llvm::enumerate(adaptor.getStartIndices())) {
+      int64_t maxStart = operandShape[dim] - updateShape[dim];
+      if (maxStart == 0) {
+        continue;
+      }
+      start = rewriter.create<ttir::ReshapeOp>(
+          loc, indexScalarType, start, rewriter.getI32ArrayAttr({1}));
+      start = rewriter.create<ttir::ClampScalarOp>(
+          loc, indexScalarType, start, rewriter.getI32IntegerAttr(0),
+          rewriter.getI32IntegerAttr(maxStart));
+      if (operandStrides[dim] != 1) {
+        start = rewriter.create<ttir::MultiplyOp>(
+            loc, indexScalarType, start,
+            scalarConstant(operandStrides[dim]));
+      }
+      base = base ? rewriter.create<ttir::AddOp>(loc, indexScalarType, base,
+                                                  start)
+                  : start;
+    }
+
+    int64_t updateVolume = updateType.getNumElements();
+    auto indicesType =
+        RankedTensorType::get({updateVolume}, indexElementType);
+    SmallVector<int32_t> offsets(updateVolume);
+    for (int64_t index = 0; index < updateVolume; ++index) {
+      int64_t coordinate = index;
+      for (int64_t dim = rank - 1; dim >= 0; --dim) {
+        offsets[index] +=
+            (coordinate % updateShape[dim]) * operandStrides[dim];
+        coordinate /= updateShape[dim];
+      }
+    }
+    Value indices = rewriter.create<ttir::ConstantOp>(
+        loc, indicesType, DenseIntElementsAttr::get(indicesType, offsets));
+    if (base) {
+      if (updateVolume != 1) {
+        base = rewriter.create<ttir::BroadcastOp>(
+            loc, indicesType, base,
+            rewriter.getDenseI64ArrayAttr({updateVolume}));
+      }
+      indices =
+          rewriter.create<ttir::AddOp>(loc, indicesType, indices, base);
+    }
+
+    Value operand = ttir::utils::flattenTensor(rewriter, loc,
+                                                adaptor.getOperand());
+    Value update =
+        ttir::utils::flattenTensor(rewriter, loc, adaptor.getUpdate());
+    Value result = rewriter.create<ttir::ScatterOp>(
+        loc, mlir::cast<RankedTensorType>(operand.getType()), operand, indices,
+        update, rewriter.getI32IntegerAttr(0),
+        ttcore::ReduceTypeAttr::get(rewriter.getContext(),
+                                    ttcore::ReduceType::Invalid));
+    rewriter.replaceOpWithNewOp<ttir::ReshapeOp>(
+        srcOp, getTypeConverter()->convertType<RankedTensorType>(
+                   srcOp.getType()),
+        result, rewriter.getI32ArrayAttr(
+                    llvm::to_vector_of<int32_t>(operandShape)));
+    return success();
+  }
+};
+} // namespace
+
