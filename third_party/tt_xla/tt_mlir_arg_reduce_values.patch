--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -314,10 +314,12 @@
 
     if (srcOp.getInputs().size() > 1) {
       if (isArgMax(srcOp, adaptor, rewriter)) {
+        replaceUsedValues<ttir::MaxOp>(srcOp, adaptor, rewriter);
         return matchAndRewriteInternalArgMax(
             srcOp, adaptor.getInputs().front(), rewriter);
       }
       if (isArgMin(srcOp, adaptor, rewriter)) {
