+  // The init value takes part in the reduction. Unless it is the identity
+  // (e.g. torch_tpu's lowest finite float instead of -inf), combine it into
+  // every input element: the maximum (minimum) then includes it, and where the
+  // init would win, every element equals it, so the smaller index 0 wins as it
+  // does in the reduce.
+  template <typename CombineOp>
+  FailureOr<mlir::Value>
+  combineInitIntoInput(mlir::stablehlo::ReduceOp &srcOp,
+                       mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                       TypicalInitReductionValue identity,
+                       ConversionPatternRewriter &rewriter) const {
+    mlir::Value input = adaptor.getInputs().front();
+    if (verifyInitValue(srcOp.getInitValues().front(), identity)) {
+      return input;
+    }
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    mlir::Value init;
+    if (failed(ttir::utils::broadcastValue(
+            rewriter, adaptor.getInitValues().front(), inputType, init,
+            srcOp.getLoc(), /*frontUnsqueeze=*/false))) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "reduce init value is not broadcastable");
+    }
+    return rewriter.create<CombineOp>(srcOp.getLoc(), inputType, input, init)
+        .getResult();
+  }
+
+  // ttir.argmax and ttir.argmin return only the indices. When the reduced
+  // values are used too, e.g. by torch.max(x, dim), reduce them separately.
+  template <typename ReductionOp>
+  void replaceUsedValues(mlir::stablehlo::ReduceOp &srcOp, mlir::Value input,
+                         ConversionPatternRewriter &rewriter) const {
+    if (srcOp.getResult(0).use_empty()) {
+      return;
+    }
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+    mlir::ArrayAttr dimArg = rewriter.getI32ArrayAttr(
+        llvm::SmallVector<int32_t>(srcOp.getDimensions()));
+    srcOp.getResult(0).replaceAllUsesWith(rewriter.create<ReductionOp>(
+        srcOp.getLoc(), outputType, input, /*keep_dim=*/false, dimArg));
+  }
+
