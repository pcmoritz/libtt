+// TPU topology extension, as in XLA's
+// xla/pjrt/extensions/tpu_topology/tpu_topology_extension.h, which the vendored
+// C API headers don't include. Its counts describe a client's topology: its
+// devices in one process, one core each. PyTorch frontends partition their
+// custom kernels into ChipCount() partitions.
+struct PJRT_TpuTopology_Count_Args {
+  size_t struct_size;
+  const PJRT_TopologyDescription *topology;
+  int32_t count;
+};
+
+using PJRT_TpuTopology_Count = PJRT_Error *(PJRT_TpuTopology_Count_Args *args);
+
+// The extension's functions in its order. The slice and coordinate queries
+// stay null.
+struct PJRT_TpuTopology_Extension {
+  PJRT_Extension_Base base;
+  void *slice_queries[7];
+  PJRT_TpuTopology_Count *process_count;
+  PJRT_TpuTopology_Count *chips_per_process;
+  PJRT_TpuTopology_Count *core_count_per_chip;
+  PJRT_TpuTopology_Count *chip_count;
+  PJRT_TpuTopology_Count *core_count;
+  PJRT_TpuTopology_Count *logical_device_count_per_process;
+  PJRT_TpuTopology_Count *logical_device_count;
+  PJRT_TpuTopology_Count *logical_device_count_per_chip;
+  PJRT_TpuTopology_Count *core_count_per_process;
+  void *coordinate_queries[15];
+};
+
+PJRT_Error *countOne(PJRT_TpuTopology_Count_Args *args) {
+  args->count = 1;
+  return nullptr;
+}
+
+PJRT_Error *countDevices(PJRT_TpuTopology_Count_Args *args) {
+  args->count = static_cast<int32_t>(
+      ClientInstance::unwrap(args->topology)->getDevicesRaw().size());
+  return nullptr;
+}
+
+PJRT_TpuTopology_Extension tpuTopologyExtension{
+    .base =
+        {
+            .struct_size = sizeof(PJRT_TpuTopology_Extension),
+            .type = PJRT_Extension_Type_TpuTopology,
+            .next = &hostMemoryAllocatorExtension.base,
+        },
+    .slice_queries = {},
+    .process_count = countOne,
+    .chips_per_process = countDevices,
+    .core_count_per_chip = countOne,
+    .chip_count = countDevices,
+    .core_count = countDevices,
+    .logical_device_count_per_process = countDevices,
+    .logical_device_count = countDevices,
+    .logical_device_count_per_chip = countOne,
+    .core_count_per_process = countDevices,
+    .coordinate_queries = {},
+};
+
 PJRT_Profiler_Extension profilerExtension{
     .struct_size = PJRT_Profiler_Extension_STRUCT_SIZE,
     .type = PJRT_Extension_Type_Profiler,
-    .next = &hostMemoryAllocatorExtension.base,
+    .next = &tpuTopologyExtension.base,
     .profiler_api = &profilerApi,
     .traceme_context_id = 0,
 };
