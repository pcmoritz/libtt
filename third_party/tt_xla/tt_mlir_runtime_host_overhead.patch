diff --git a/runtime/include/tt/runtime/detail/ttnn/types/global_tensor_cache.h b/runtime/include/tt/runtime/detail/ttnn/types/global_tensor_cache.h
--- a/runtime/include/tt/runtime/detail/ttnn/types/global_tensor_cache.h
+++ b/runtime/include/tt/runtime/detail/ttnn/types/global_tensor_cache.h
@@ -42,9 +42,19 @@
 std::string to_string(const CacheKey &key);
 
 struct CacheKeyHasher {
+  // Every const-eval lookup hashes a key, so combine the fields directly
+  // instead of formatting the key into a string first.
   std::size_t operator()(const CacheKey &k) const {
-    // TODO(pilkic): Optimize hash function if needed.
-    return std::hash<std::string>{}(to_string(k));
+    std::size_t hash = std::hash<std::string>{}(k.funcHash);
+    auto combine = [&hash](std::uint64_t value) {
+      hash ^= std::hash<std::uint64_t>{}(value) + 0x9e3779b97f4a7c15ULL +
+              (hash << 6) + (hash >> 2);
+    };
+    combine(static_cast<std::uint64_t>(k.deviceId));
+    for (std::uint64_t version : k.inputVersions) {
+      combine(version);
+    }
+    return hash;
   }
 };
 
