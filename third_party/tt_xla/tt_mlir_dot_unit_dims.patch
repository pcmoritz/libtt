+  // An operand in the order the matmul reshape reads, without the permute's
+  // size-1 dims: those do not change the order of elements, but TTNN pads a
+  // size-1 second-to-last dim to a whole tile. jax.nn.dot_product_attention's
+  // query, [B, T, N, 1, H] with groups of one head, is permuted as [B, T, N, H]
+  // to [B, N, T, H] instead of to [B, N, T, 1, H], 32 times its size.
+  Value permuteOperand(PatternRewriter &rewriter, Location loc, Value input,
+                       RankedTensorType inputType,
+                       ArrayRef<int64_t> permutation) const {
+    SmallVector<int64_t> compactShape;
+    SmallVector<int64_t> compactIndex(inputType.getRank(), -1);
+    for (int64_t d = 0; d < inputType.getRank(); ++d) {
+      if (inputType.getDimSize(d) != 1) {
+        compactIndex[d] = compactShape.size();
+        compactShape.push_back(inputType.getDimSize(d));
+      }
+    }
+    SmallVector<int64_t> compactPermutation;
+    for (int64_t d : permutation) {
+      if (compactIndex[d] >= 0) {
+        compactPermutation.push_back(compactIndex[d]);
+      }
+    }
+    // The matmul reshape alone puts the elements in this order.
+    if (llvm::is_sorted(compactPermutation)) {
+      return input;
+    }
+    if (compactShape.size() != static_cast<size_t>(inputType.getRank())) {
+      input = ttir::utils::createReshapeOp(rewriter, loc, input, compactShape);
+    }
+    return createPermuteOp(
+        rewriter, loc, input, mlir::cast<RankedTensorType>(input.getType()),
+        compactPermutation);
+  }
