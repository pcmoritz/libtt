+// permute(reshape(x)) -> reshape(permute(x)) when the reshape only inserts or
+// removes size-1 dims and x has fewer tiles than the reshape's result, such as
+// a matmul's [B, N, T, H] result restored to [B, N, T, 1, H]: the permute then
+// moves x's tiles instead of the padded ones. x's own size-1 dims go first.
+class SinkReshapeThroughPermutePattern
+    : public mlir::OpRewritePattern<PermuteOp> {
+  using mlir::OpRewritePattern<PermuteOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(PermuteOp permute,
+                  mlir::PatternRewriter &rewriter) const final {
+    auto reshape = permute.getInput().getDefiningOp<ReshapeOp>();
+    if (!reshape || !reshape->hasOneUse()) {
+      return mlir::failure();
+    }
+    Value input = reshape.getInput();
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    auto reshapedType = mlir::cast<RankedTensorType>(reshape.getType());
+    if (tileCount(inputType) >= tileCount(reshapedType)) {
+      return mlir::failure();
+    }
+    auto nonUnitDims = [](RankedTensorType type) {
+      SmallVector<int64_t> dims;
+      for (int64_t d = 0; d < type.getRank(); ++d) {
+        if (type.getDimSize(d) != 1) {
+          dims.push_back(d);
+        }
+      }
+      return dims;
+    };
+    SmallVector<int64_t> inputDims = nonUnitDims(inputType);
+    SmallVector<int64_t> reshapedDims = nonUnitDims(reshapedType);
+    if (!llvm::equal(
+            llvm::map_range(inputDims,
+                            [&](int64_t d) { return inputType.getDimSize(d); }),
+            llvm::map_range(reshapedDims, [&](int64_t d) {
+              return reshapedType.getDimSize(d);
+            }))) {
+      return mlir::failure();
+    }
+
+    SmallVector<int64_t> permutation;
+    for (int64_t d = 0; d < inputType.getRank(); ++d) {
+      if (inputType.getDimSize(d) == 1) {
+        permutation.push_back(d);
+      }
+    }
+    for (int64_t d : permute.getPermutation()) {
+      if (const auto *it = llvm::find(reshapedDims, d);
+          it != reshapedDims.end()) {
+        permutation.push_back(inputDims[it - reshapedDims.begin()]);
+      }
+    }
+    if (!llvm::is_sorted(permutation)) {
+      input = rewriter.create<PermuteOp>(
+          permute.getLoc(),
+          RankedTensorType::get(
+              ttmlir::utils::applyPermutation(inputType.getShape(),
+                                              permutation),
+              inputType.getElementType(), inputType.getEncoding()),
+          input, permutation);
+    }
+    rewriter.replaceOp(permute,
+                       utils::createReshapeOp(rewriter, permute.getLoc(), input,
+                                              permute.getType().getShape()));
+    return mlir::success();
+  }
+};
