+    SmallVector<int64_t> rhsFreeDims =
+        getResultDims(rhsBatchDims, rhsContractDims, rhsType.getRank());
+
+    auto isUnit = [](RankedTensorType type) {
+      return [type](int64_t d) { return type.getDimSize(d) == 1; };
+    };
+    SmallVector<int64_t> lhsDropped;
+    SmallVector<int64_t> rhsDropped;
+    if (!llvm::all_of(lhsFreeDims, isUnit(lhsType))) {
