+      auto maskType = outputType.clone(rewriter.getI1Type());
+      Value mask = rewriter.create<ttir::NotEqualOp>(
+          srcOp.getLoc(), maskType, maskValues, zero);
+
+      rewriter.replaceOpWithNewOp<ttir::WhereOp>(
+          srcOp, outputType, mask, padded, adaptor.getPaddingValue());
+      return success();
+    }
 
