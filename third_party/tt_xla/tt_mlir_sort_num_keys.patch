+  // The number of sort keys. Lexicographic comparators (JAX's) order by
+  // operand pair (2i, 2i + 1) for key i, possibly through canonicalizing ops,
+  // so trace each ordering compare back to the comparator arguments it reads.
+  unsigned getNumKeys(mlir::stablehlo::SortOp &srcOp) const {
+    unsigned numKeys = 1;
+    srcOp.getComparator().front().walk([&](mlir::stablehlo::CompareOp cmpOp) {
+      if (cmpOp.getComparisonDirection() !=
+              mlir::stablehlo::ComparisonDirection::LT &&
+          cmpOp.getComparisonDirection() !=
+              mlir::stablehlo::ComparisonDirection::GT) {
+        return;
+      }
+      SmallVector<Value> worklist{cmpOp.getLhs()};
+      llvm::DenseSet<Value> visited;
+      while (!worklist.empty()) {
+        Value value = worklist.pop_back_val();
+        if (!visited.insert(value).second) {
+          continue;
+        }
+        if (auto arg = dyn_cast<BlockArgument>(value)) {
+          numKeys = std::max(numKeys, arg.getArgNumber() / 2 + 1);
+        } else if (Operation *def = value.getDefiningOp()) {
+          llvm::append_range(worklist, def->getOperands());
+        }
+      }
+    });
+    return numKeys;
+  }
