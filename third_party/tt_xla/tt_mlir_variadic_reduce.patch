+  template <typename ReductionOp, typename CombineOp>
+  mlir::Value createReductionWithInit(
+      mlir::Location loc, RankedTensorType outputType, mlir::Value input,
+      mlir::Value init, mlir::ArrayAttr dimensions,
+      ConversionPatternRewriter &rewriter) const {
+    mlir::Value reduced = rewriter.create<ReductionOp>(
+        loc, outputType, input, /*keep_dim=*/false, dimensions);
+    return rewriter.create<CombineOp>(loc, outputType, reduced, init);
+  }
+
+  LogicalResult matchAndRewriteSeparable(
+      mlir::stablehlo::ReduceOp &srcOp,
+      mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+      ConversionPatternRewriter &rewriter) const {
+    const size_t numInputs = srcOp.getInputs().size();
+    Block &body = srcOp.getBody().front();
+    auto returnOp = mlir::dyn_cast<mlir::stablehlo::ReturnOp>(
+        body.getTerminator());
+    if (!returnOp) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "unsupported separable stablehlo.reduce structure");
+    }
+
+    mlir::ArrayAttr dimensions = rewriter.getI32ArrayAttr(
+        llvm::SmallVector<int32_t>(srcOp.getDimensions()));
+    SmallVector<mlir::Value> results;
+    results.reserve(numInputs);
+    for (size_t i = 0; i < numInputs; ++i) {
+      mlir::Operation *combiner = returnOp.getOperand(i).getDefiningOp();
+      if (!combiner || combiner->getBlock() != &body ||
+          !mlir::isa<mlir::stablehlo::AddOp, mlir::stablehlo::MulOp>(
+              combiner)) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "separable reduce requires direct add or multiply lanes");
+      }
+
+      mlir::Value lhs = combiner->getOperand(0);
+      mlir::Value rhs = combiner->getOperand(1);
+      mlir::Value accumulator = body.getArgument(i);
+      mlir::Value element = body.getArgument(i + numInputs);
+      if (!((lhs == accumulator && rhs == element) ||
+            (lhs == element && rhs == accumulator))) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "separable reduce components are cross-coupled");
+      }
+
+      auto outputType = mlir::cast<RankedTensorType>(
+          getTypeConverter()->convertType(srcOp.getResult(i).getType()));
+      mlir::Value init;
+      if (failed(ttir::utils::broadcastValue(
+              rewriter, adaptor.getInitValues()[i], outputType, init,
+              srcOp.getLoc(), /*frontUnsqueeze=*/false))) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "separable reduce init value is not broadcastable");
+      }
+
+      if (mlir::isa<mlir::stablehlo::AddOp>(combiner)) {
+        results.push_back(
+            createReductionWithInit<ttir::SumOp, ttir::AddOp>(
+                srcOp.getLoc(), outputType, adaptor.getInputs()[i], init,
+                dimensions, rewriter));
+      } else {
+        results.push_back(
+            createReductionWithInit<ttir::ProdOp, ttir::MultiplyOp>(
+                srcOp.getLoc(), outputType, adaptor.getInputs()[i], init,
+                dimensions, rewriter));
+      }
+    }
+
+    rewriter.replaceOp(srcOp, results);
+    return success();
+  }
