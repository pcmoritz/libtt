+table LoopBound {
+  constant: int64;
+  input_index: int32 = null;
+}
+
+// Repeatedly invoke a private program, updating the state slots named by
+// output_indices after each invocation.
+table WhileLoopOp {
+  program_id: uint32;
+  condition_program_id: int32 = -1;
+  initial: LoopBound;
+  limit: LoopBound;
+  step: LoopBound;
+  state_count: uint32;
+  output_indices: [uint32];
+  inputs: [tt.target.ttnn.TensorRef];
+  outputs: [tt.target.ttnn.TensorRef];
+}
