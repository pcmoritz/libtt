+def TTCore_WhileLoopOp : TTCore_Op<"while_loop",
+    [MemoryEffects<[MemRead, MemWrite]>]> {
+  let summary = "Repeatedly invoke an outlined program";
+  let description = [{
+    Invokes the body program until the optional condition program returns
+    false, or for the number of iterations described by the counted bounds.
+  }];
+
+  let arguments = (ins
+    FlatSymbolRefAttr:$body_program,
+    OptionalAttr<FlatSymbolRefAttr>:$condition_program,
+    OptionalAttr<TTCore_LoopBoundAttr>:$initial,
+    OptionalAttr<TTCore_LoopBoundAttr>:$limit,
+    OptionalAttr<TTCore_LoopBoundAttr>:$step,
+    I32Attr:$state_count,
+    DenseI32ArrayAttr:$output_indices,
+    Variadic<AnyRankedTensor>:$inputs
+  );
+
+  let results = (outs Variadic<AnyRankedTensor>:$results);
+}
