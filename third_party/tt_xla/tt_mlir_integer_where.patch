diff --git a/lib/Dialect/TTNN/Transforms/Workarounds/TTNNWorkaroundsPatterns.cpp b/lib/Dialect/TTNN/Transforms/Workarounds/TTNNWorkaroundsPatterns.cpp
--- a/lib/Dialect/TTNN/Transforms/Workarounds/TTNNWorkaroundsPatterns.cpp
+++ b/lib/Dialect/TTNN/Transforms/Workarounds/TTNNWorkaroundsPatterns.cpp
@@ -424,2 +424,35 @@ public:
 
+// UInt32 where is incorrect in tt-metal, while its Int32 path preserves all
+// 32 bits. Reinterpret the data operands around that path to avoid the lossy
+// Float32 workaround and preserve the unsigned payload exactly.
+class UInt32WhereWorkaround : public OpRewritePattern<ttnn::WhereOp> {
+public:
+  using OpRewritePattern<ttnn::WhereOp>::OpRewritePattern;
+
+  LogicalResult matchAndRewrite(ttnn::WhereOp op,
+                                PatternRewriter &rewriter) const override {
+    auto outputType = mlir::cast<RankedTensorType>(op.getType());
+    auto outputLayout = utils::getLayoutAttrFromTensor(outputType);
+    if (outputLayout.getDataType() != ttcore::DataType::UInt32) {
+      return failure();
+    }
+
+    auto toInt32Type = [&](Value value) {
+      auto type = mlir::cast<RankedTensorType>(value.getType());
+      return utils::RankedTensorTypeFactory::create(
+          type, ttcore::DataType::Int32);
+    };
+
+    auto second = rewriter.create<ttnn::BitcastConvertOp>(
+        op.getLoc(), toInt32Type(op.getSecond()), op.getSecond());
+    auto third = rewriter.create<ttnn::BitcastConvertOp>(
+        op.getLoc(), toInt32Type(op.getThird()), op.getThird());
+    auto where = rewriter.create<ttnn::WhereOp>(
+        op.getLoc(), toInt32Type(op.getResult()), op.getFirst(), second, third);
+    rewriter.replaceOpWithNewOp<ttnn::BitcastConvertOp>(
+        op, outputType, where.getResult());
+    return success();
+  }
+};
+
 // Pass to apply workarounds to the operands of TTNN operations.
@@ -433,3 +466,3 @@ public:
       patterns.add<
-          GatherSi32Workaround,
