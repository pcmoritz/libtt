diff --git a/pjrt_implementation/src/utils/data_type_utils.cc b/pjrt_implementation/src/utils/data_type_utils.cc
--- a/pjrt_implementation/src/utils/data_type_utils.cc
+++ b/pjrt_implementation/src/utils/data_type_utils.cc
@@ -122,6 +122,11 @@
     return tt::target::DataType::Float32;
   case PJRT_Buffer_Type_C128:
     return tt::target::DataType::Float64;
+  // The compiler stores float8 tensors as their bits (stablehlo float8 data
+  // type conversion), so their buffers move as bytes.
+  case PJRT_Buffer_Type_F8E4M3FN:
+  case PJRT_Buffer_Type_F8E5M2:
+    return tt::target::DataType::UInt8;
   default:
     TT_THROW("PJRT data type: {} does not have runtime data type equivalent",
              getPJRTBufferTypeString(pjrt_data_type));
@@ -159,6 +164,10 @@
       return PJRT_Buffer_Type_F16;
     } else if (floatType.isBF16()) {
       return PJRT_Buffer_Type_BF16;
+    } else if (mlir::isa<mlir::Float8E4M3FNType>(floatType)) {
+      return PJRT_Buffer_Type_F8E4M3FN;
+    } else if (mlir::isa<mlir::Float8E5M2Type>(floatType)) {
+      return PJRT_Buffer_Type_F8E5M2;
     } else {
       TT_THROW("Unsupported float type");
     }
