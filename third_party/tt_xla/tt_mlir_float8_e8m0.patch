+// A splat i32 constant of the given tensor type's shape.
+Value i32Constant(OpBuilder &builder, Location loc, Type type, int32_t value) {
+  auto i32Type = withElementType(type, builder.getI32Type());
+  return builder.create<mlir::stablehlo::ConstantOp>(
+      loc, DenseElementsAttr::get(i32Type, ArrayRef<int32_t>{value}));
+}
+
+// The f32 values of float8_e8m0fnu bits: 2^(code - 127), the f32 with the code
+// as its exponent and no mantissa, except that code 255 is NaN and code 0 is
+// 2^-127, an f32 subnormal.
+Value decodeE8M0(OpBuilder &builder, Location loc, Value bits) {
+  auto constant = [&](int32_t value) {
+    return i32Constant(builder, loc, bits.getType(), value);
+  };
+  auto is = [&](Value code, int32_t value) -> Value {
+    return builder.create<mlir::stablehlo::CompareOp>(
+        loc, code, constant(value), mlir::stablehlo::ComparisonDirection::EQ);
+  };
+  Value code = builder.create<mlir::stablehlo::ConvertOp>(
+      loc, bits, builder.getI32Type());
+  Value f32Bits =
+      builder.create<mlir::stablehlo::ShiftLeftOp>(loc, code, constant(23));
+  f32Bits = builder.create<mlir::stablehlo::SelectOp>(
+      loc, is(code, 0), constant(0x00400000), f32Bits);
+  f32Bits = builder.create<mlir::stablehlo::SelectOp>(
+      loc, is(code, 255), constant(0x7FC00000), f32Bits);
+  return builder.create<mlir::stablehlo::BitcastConvertOp>(
+      loc, withElementType(bits.getType(), builder.getF32Type()), f32Bits);
+}
+
+// The float8_e8m0fnu bits of f32 values, rounded as ml_dtypes rounds them: a
+// normal value to the next power of two from half its mantissa on, a subnormal
+// one above 2^-127 to 2^-126 and others to 2^-127. Zero, negative values,
+// infinities, NaN and values that round past 2^127 become NaN (code 255).
+Value encodeE8M0(OpBuilder &builder, Location loc, Value value) {
+  auto constant = [&](int32_t fill) {
+    return i32Constant(builder, loc, value.getType(), fill);
+  };
+  auto compare = [&](Value lhs, int32_t rhs,
+                     mlir::stablehlo::ComparisonDirection direction) -> Value {
+    return builder.create<mlir::stablehlo::CompareOp>(loc, lhs, constant(rhs),
+                                                      direction);
+  };
+  using Direction = mlir::stablehlo::ComparisonDirection;
+  Value f32Bits = builder.create<mlir::stablehlo::BitcastConvertOp>(
+      loc, withElementType(value.getType(), builder.getI32Type()), value);
+  Value exponent = builder.create<mlir::stablehlo::AndOp>(
+      loc,
+      builder.create<mlir::stablehlo::ShiftRightLogicalOp>(loc, f32Bits,
+                                                           constant(23)),
+      constant(0xFF));
+  Value mantissa =
+      builder.create<mlir::stablehlo::AndOp>(loc, f32Bits, constant(0x7FFFFF));
+  Value halfway = builder.create<mlir::stablehlo::SelectOp>(
+      loc, compare(exponent, 0, Direction::EQ), constant(0x400001),
+      constant(0x400000));
+  Value roundsUp = builder.create<mlir::stablehlo::CompareOp>(
+      loc, mantissa, halfway, Direction::GE);
+  Value code = builder.create<mlir::stablehlo::AddOp>(
+      loc, exponent,
+      builder.create<mlir::stablehlo::SelectOp>(loc, roundsUp, constant(1),
+                                                constant(0)));
+  // Zero and negative values have f32 bits of at most 0 as an i32.
+  code = builder.create<mlir::stablehlo::SelectOp>(
+      loc, compare(f32Bits, 0, Direction::LE), constant(255), code);
+  code = builder.create<mlir::stablehlo::SelectOp>(
+      loc, compare(exponent, 255, Direction::EQ), constant(255), code);
+  return builder.create<mlir::stablehlo::ConvertOp>(
+      loc, code,
+      IntegerType::get(builder.getContext(), 8, IntegerType::Unsigned));
+}
