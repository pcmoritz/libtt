+// Values of a tensor replicated over the local mesh devices, which can hold
+// one host buffer each. Buffers owned by other hosts are not read.
+template <typename T>
+inline std::vector<T> getReplicatedValues(const ::ttnn::Tensor &tensor) {
+  if (!isOnHost(tensor.storage_type())) {
+    return getReplicatedValues<T>(tensor.cpu());
+  }
+  std::optional<std::vector<T>> values;
+  tensor.host_storage().buffer().apply(
+      [&](const ::tt::tt_metal::HostBuffer &buffer) {
+        std::vector<T> data =
+            ::ttnn::Tensor(buffer, tensor.tensor_spec()).to_vector<T>();
+        LOG_ASSERT(!values || *values == data,
+                   "Replicated values must agree across local devices");
+        values = std::move(data);
+      });
+  LOG_ASSERT(values.has_value(), "Tensor must have a local buffer");
+  return std::move(*values);
+}
+
 template <typename T>
 inline T getScalarFromTensor(const ::ttnn::Tensor &tensor) {
-  std::vector<T> data = tensor.to_vector<T>();
+  std::vector<T> data = getReplicatedValues<T>(tensor);
   LOG_ASSERT(data.size() == 1, "Scalar tensor must have one element");
   return data[0];
 }
