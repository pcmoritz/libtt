+// Dynamic bounds hold the same values on every device of a mesh.
+static ::ttsl::SmallVector<int32_t>
+getSliceBounds(const ::ttnn::Tensor &bounds) {
+  if (bounds.dtype() == ::ttnn::DataType::UINT32) {
+    std::vector<uint32_t> values =
+        ::tt::runtime::ttnn::utils::getReplicatedValues<uint32_t>(bounds);
+    return ::ttsl::SmallVector<int32_t>(values.begin(), values.end());
+  }
+  std::vector<int32_t> values =
+      ::tt::runtime::ttnn::utils::getReplicatedValues<int32_t>(bounds);
+  return ::ttsl::SmallVector<int32_t>(values.begin(), values.end());
+}
