+// `tt.cross_entropy_fw` (logits [N, 1, H, W], targets [N, H] -> losses
+// [N, 1, H, 1]) and `tt.cross_entropy_bw` (logits, targets, grad [1, 1, 1, 1]
+// -> logits gradient, jax.ffi.ffi_call with a float scaler attribute):
+// tt-train's fused cross-entropy, see ttir.cross_entropy_fw.
+class StableHLOCrossEntropyTrainingConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CustomCallOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CustomCallOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    StringRef target = op.getCallTargetName();
+    const bool forward = target == "tt.cross_entropy_fw";
+    if (!forward && target != "tt.cross_entropy_bw") {
+      return failure();
+    }
+    if (op.getNumOperands() != (forward ? 2u : 3u) || op.getNumResults() != 1) {
+      return op.emitOpError() << target << " takes " << (forward ? 2 : 3)
+                              << " operands and returns one result";
+    }
+    Type type = getTypeConverter()->convertType(op.getResult(0).getType());
+    ValueRange operands = adaptor.getOperands();
+    if (forward) {
+      rewriter.replaceOpWithNewOp<ttir::CrossEntropyForwardOp>(
+          op, type, operands[0], operands[1]);
+      return success();
+    }
+    auto backendConfig = getFfiBackendConfig(op);
+    FloatAttr scaler =
+        backendConfig ? backendConfig.getAs<FloatAttr>("scaler") : nullptr;
+    if (!scaler) {
+      return op.emitOpError() << target << " needs a float scaler attribute";
+    }
+    rewriter.replaceOpWithNewOp<ttir::CrossEntropyBackwardOp>(
+        op, type, operands[0], operands[1], operands[2],
+        rewriter.getF32FloatAttr(scaler.getValueAsDouble()));
+    return success();
+  }
+};
