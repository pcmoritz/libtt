+def TTIR_CrossEntropyForwardOp : TTIR_NamedOp<"cross_entropy_fw"> {
+  let summary = "Fused cross-entropy loss forward.";
+  let description = [{
+    `input` holds logits as [N, 1, H, W] and `target` class indices as [N, H].
+    `result` [N, 1, H, 1] is each row's loss, logsumexp(input) - input[target].
+    Lowers to ttnn.cross_entropy_fw, tt-train's ttml::metal::cross_entropy_fw,
+    which reads BF16 logits and computes in FP32.
+  }];
+  let arguments = (ins AnyRankedTensor:$input, AnyRankedTensor:$target);
+  let results = (outs AnyRankedTensor:$result);
+}
+
+def TTIR_CrossEntropyBackwardOp : TTIR_NamedOp<"cross_entropy_bw"> {
+  let summary = "Fused cross-entropy loss backward.";
+  let description = [{
+    The gradient of ttir.cross_entropy_fw's losses with respect to `input`:
+    (softmax(input) - one_hot(target)) * scaler * grad, with `grad` [1, 1, 1, 1]
+    the gradient of their sum. Lowers to ttnn.cross_entropy_bw, tt-train's
+    ttml::metal::cross_entropy_bw.
+  }];
+  let arguments = (ins AnyRankedTensor:$input, AnyRankedTensor:$target,
+                       AnyRankedTensor:$grad, F32Attr:$scaler);
+  let results = (outs AnyRankedTensor:$result);
+}
