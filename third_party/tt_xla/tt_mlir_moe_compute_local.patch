+// This pattern recognizes and converts stablehlo.custom_call @tt.moe_compute
+// to ttir.moe_compute: operands (input [D, T, H], expert ids [T, k], scores
+// [T, k], expert-to-device mapping [D, E], w0 and w1 [L, E, H, N], w2
+// [L, E, N, H]), attributes from mhlo.frontend_attributes (layer_id,
+// output_height_shard_dim, activation, cluster_axis, which, if absent, runs
+// each device on its own, and rings), and a [k, T, H] result.
+class StableHLOToTTIRMoeComputeOpConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CustomCallOp> {
+  using OpConversionPattern<mlir::stablehlo::CustomCallOp>::OpConversionPattern;
+
+public:
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CustomCallOp srcOp,
+                  mlir::stablehlo::CustomCallOp::Adaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (adaptor.getCallTargetNameAttr() != "tt.moe_compute") {
+      return failure();
+    }
+    if (adaptor.getOperands().size() != 7) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "MoeCompute op expects 7 operands (input, indices, scores, "
+                 "mapping, w0, w1, w2).");
+    }
+
+    mlir::DictionaryAttr frontendAttributes =
+        mlir::dyn_cast_or_null<mlir::DictionaryAttr>(
+            srcOp->getDiscardableAttr("mhlo.frontend_attributes"));
+    auto u32Attr = [&](llvm::StringRef name,
+                       std::optional<uint32_t> fallback)
+        -> FailureOr<std::optional<uint32_t>> {
+      auto value = frontendAttributes
+                       ? frontendAttributes.getAs<mlir::StringAttr>(name)
+                       : nullptr;
+      if (!value) {
+        return fallback;
+      }
+      uint32_t result;
+      if (value.getValue().getAsInteger(10, result)) {
+        return failure();
+      }
+      return std::optional<uint32_t>(result);
+    };
+    auto layerId = u32Attr("layer_id", 0);
+    auto outputHeightShardDim = u32Attr("output_height_shard_dim", 4);
+    auto clusterAxis = u32Attr("cluster_axis", std::nullopt);
+    auto rings = u32Attr("rings", 0);
+    if (failed(layerId) || failed(outputHeightShardDim) ||
+        failed(clusterAxis) || failed(rings)) {
+      return rewriter.notifyMatchFailure(
+          srcOp, "MoeCompute attributes must be unsigned integers.");
+    }
+
+    auto activation = ttcore::MoEActivationFunction::Silu;
+    if (auto name = frontendAttributes ? frontendAttributes.getAs<StringAttr>(
+                                             "activation")
+                                       : nullptr) {
+      auto parsed = ttcore::symbolizeMoEActivationFunction(name.getValue());
+      if (!parsed) {
+        return rewriter.notifyMatchFailure(
+            srcOp, "MoeCompute activation must be silu or swiglu.");
+      }
+      activation = *parsed;
+    }
+
+    ValueRange operands = adaptor.getOperands();
+    auto w0Type = cast<RankedTensorType>(operands[4].getType());
+    RankedTensorType outputType = cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResult(0).getType()));
+
+    auto u32 = [&](uint32_t value) {
+      return rewriter.getUI32IntegerAttr(value);
+    };
+    rewriter.replaceOpWithNewOp<ttir::MoeComputeOp>(
+        srcOp, outputType, operands[0], operands[1], operands[2], operands[3],
+        operands[4], operands[5], operands[6], /*bias_0=*/Value(),
+        /*bias_1=*/Value(), /*bias_2=*/Value(), u32(**layerId),
+        u32(**outputHeightShardDim), u32(w0Type.getShape().back()),
+        ttcore::MoEActivationFunctionAttr::get(getContext(), activation),
+        *clusterAxis ? u32(**clusterAxis) : IntegerAttr(), u32(**rings));
+    return success();
+  }
+};
