+// tt-metal reads the expert indices and scores from L1 on the core that drains
+// the tilize stage, the core its placement picks for this hidden size.
+::ttnn::Tensor toTilizeDrainCore(const ::ttnn::Tensor &tensor,
+                                 const ::ttnn::Tensor &input,
+                                 uint32_t outputHeightShardDim) {
+  ::ttnn::MeshDevice *meshDevice = input.device();
+  uint32_t hiddenSize = input.logical_shape()[-1];
+  // As the op picks its data-parallel combine cores: the largest divisor of
+  // the hidden tiles, at most 4, that also divides the matmul ring.
+  uint32_t ringSize = meshDevice->arch() == ::tt::ARCH::BLACKHOLE
+                          ? meshDevice
+                                ->get_optimal_dram_bank_to_logical_worker_assignment(
+                                    ::tt::tt_metal::NOC::RISCV_0_default)
+                                .size()
+                          : 12;
+  uint32_t dataParallelCores = 1;
+  for (uint32_t d = 4; d >= 1; --d) {
+    if ((hiddenSize / 32) % d == 0 && ringSize % d == 0) {
+      dataParallelCores = d;
+      break;
+    }
+  }
+  ::ttnn::CoreCoord core = ::ttnn::experimental::get_moe_tilize_drain_core(
+      meshDevice, outputHeightShardDim, dataParallelCores, hiddenSize);
+  const ::ttnn::Shape &shape = tensor.logical_shape();
+  uint32_t rows = shape.volume() / shape[-1];
+  ::ttnn::MemoryConfig memoryConfig(
+      ::ttnn::TensorMemoryLayout::HEIGHT_SHARDED, ::ttnn::BufferType::L1,
+      ::tt::tt_metal::ShardSpec(::ttnn::CoreRangeSet(::ttnn::CoreRange(core)),
+                                {rows, shape[-1]},
+                                ::tt::tt_metal::ShardOrientation::ROW_MAJOR));
+  return ::ttnn::to_memory_config(
+      ::ttnn::to_layout(tensor, ::ttnn::Layout::ROW_MAJOR), memoryConfig);
+}
+
+// Without a cluster axis, each device runs the experts its mapping row places
+// on it for all of its tokens, with no fabric (tt-metal's local combine).
+// Slots of experts on other devices are left as they are, so the combine
+// output starts zeroed.
+void runLocal(const ::tt::target::ttnn::MoeComputeOp *op,
+              ProgramContext &context) {
+  ProgramTensorPool &tensorPool = context.getTensorPool();
+  const ::ttnn::Tensor &tilizeInput =
+      tensorPool.getTTNNTensorAndValidate(op->tilize_input_tensor());
+  const ::ttnn::Tensor &indices =
+      tensorPool.getTTNNTensorAndValidate(op->tilize_expert_indices_tensor());
+  const ::ttnn::Tensor &scores =
+      tensorPool.getTTNNTensorAndValidate(op->tilize_expert_scores_tensor());
+  // The optimizer may have placed them there already.
+  ::ttnn::Tensor tilizeIndices =
+      toTilizeDrainCore(indices, tilizeInput, op->output_height_shard_dim());
+  ::ttnn::Tensor tilizeScores =
+      toTilizeDrainCore(scores, tilizeInput, op->output_height_shard_dim());
+  const ::ttnn::Tensor &tilizeMapping =
+      tensorPool.getTTNNTensorAndValidate(op->tilize_expert_mapping_tensor());
+  const ::ttnn::Tensor &w0w1 =
+      tensorPool.getTTNNTensorAndValidate(op->matmul_w0_w1_tensor());
+  const ::ttnn::Tensor &w2 =
+      tensorPool.getTTNNTensorAndValidate(op->matmul_w2_tensor());
+
+  // tt-metal's local output path: on a mesh axis of extent 1 there is nothing
+  // to combine, and each chip writes its experts' rows of the [k, tokens,
+  // hidden] output and zeros for the rest. The op's result may view it as any
+  // shape of that size, such as [k * tokens, hidden], which tiles without
+  // padding each expert's rows.
+  ::ttnn::MeshDevice &meshDevice = context.getMeshDevice();
+  const auto &meshShape = meshDevice.shape();
+  std::optional<uint32_t> localAxis;
+  for (uint32_t axis = 0; axis < meshShape.dims(); ++axis) {
+    if (meshShape[axis] == 1) {
+      localAxis = axis;
+      break;
+    }
+  }
+  LOG_ASSERT(localAxis, "moe_compute without a cluster axis needs a mesh axis "
+                        "of extent 1");
+
+  // Several rings run a chip's experts side by side (an expert with fewer
+  // chunks than rings goes whole to the least-loaded ring), but then the rows
+  // of other chips' experts are not written, so the output starts zeroed.
+  const uint32_t rings = op->rings();
+  std::optional<::ttnn::Tensor> output;
+  if (rings > 1) {
+    uint32_t hiddenSize = tilizeInput.logical_shape()[-1];
+    output = ::ttnn::moreh_full(
+        {tilizeIndices.logical_shape()[-1],
+         static_cast<uint32_t>(tilizeInput.logical_volume() / hiddenSize),
+         hiddenSize},
+        0.0f, &meshDevice, ::ttnn::DataType::BFLOAT16, ::ttnn::Layout::ROW_MAJOR,
+        ::ttnn::DRAM_MEMORY_CONFIG);
+  }
+
+  std::vector<::ttnn::Tensor> results = ::ttnn::experimental::moe_compute(
+      tilizeInput, tilizeIndices, tilizeScores, tilizeMapping, w0w1, w2,
+      op->layer_id(), op->output_height_shard_dim(), op->intermediate_size(),
+      op->has_bias(), localAxis, /*topology=*/std::nullopt,
+      /*num_links=*/std::nullopt, /*mux_core_range_set=*/std::nullopt,
+      /*output_memory_config=*/::ttnn::DRAM_MEMORY_CONFIG, output,
+      /*optional_cross_device_semaphore=*/std::nullopt,
+      toMetalActivation(op->activation_function()),
+      /*compute_only=*/false, /*num_shared_experts_per_device=*/std::nullopt,
+      /*local_combine=*/false, /*zero_fill_non_owned_rows=*/rings < 2,
+      /*prefill_rings=*/rings);
+
+  LOG_ASSERT(results.size() == 6, "moe_compute returned ", results.size(),
+             " tensors; expected 6");
+  ::ttnn::Tensor combined =
+      ::ttnn::reshape(results[5], operations::utils::toTTNNShape(
+                                      *op->combine_output()->desc()->shape()));
+  // The consumer tilizes the row-major output. From DRAM, a few rows that are
+  // wide (such as 64 x 2048 for 8 tokens) take TTNN's block tilize, which
+  // reads them in small pieces; whole tile rows tilize faster sharded in L1,
+  // one tile row per core, and the tiles are returned to DRAM.
+  const ::ttnn::Shape &combinedShape = combined.logical_shape();
+  uint32_t combinedRows = combinedShape.volume() / combinedShape[-1];
+  auto grid = meshDevice.compute_with_storage_grid_size();
+  if (combinedRows % 32 == 0 &&
+      combinedRows / 32 <= grid.x * grid.y) {
+    ::ttnn::MemoryConfig l1(
+        ::ttnn::TensorMemoryLayout::HEIGHT_SHARDED, ::ttnn::BufferType::L1,
+        ::tt::tt_metal::ShardSpec(
+            ::tt::tt_metal::num_cores_to_corerangeset(combinedRows / 32, grid,
+                                                      /*row_wise=*/true),
+            {32, combinedShape[-1]},
+            ::tt::tt_metal::ShardOrientation::ROW_MAJOR));
+    ::ttnn::Tensor sharded = ::ttnn::to_memory_config(combined, l1);
+    ::ttnn::Tensor tiled = ::ttnn::to_layout(sharded, ::ttnn::Layout::TILE);
+    ::ttnn::deallocate(sharded);
+    ::ttnn::Tensor dram =
+        ::ttnn::to_memory_config(tiled, ::ttnn::DRAM_MEMORY_CONFIG);
+    ::ttnn::deallocate(tiled);
+    ::ttnn::deallocate(combined);
+    combined = dram;
+  }
+  tensorPool.insertTTNNTensorAndValidate(op->combine_output(), combined);
+  for (size_t i = 0; i < 5; ++i) {
+    ::ttnn::deallocate(results[i]);
+  }
+  if (tilizeIndices.buffer() != indices.buffer()) {
+    ::ttnn::deallocate(tilizeIndices);
+  }
+  if (tilizeScores.buffer() != scores.buffer()) {
+    ::ttnn::deallocate(tilizeScores);
+  }
+}
