+::flatbuffers::Offset<::tt::target::ttnn::MaskedReduceOp>
+createOp(FlatbufferObjectCache &cache, MaskedReduceOp op) {
+  auto input = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getInput()));
+  auto threshold = cache.at<::tt::target::ttnn::TensorRef>(
+      getOperandThroughDPSOps(op.getThreshold()));
+  auto output =
+      cache.getOrCreateNoSharding(op.getResult(), tensorValueToFlatbuffer,
+                                  /*local_shape*/ std::nullopt);
+  // The flatbuffer enums list the cases in the dialect enums' order.
+  return ::tt::target::ttnn::CreateMaskedReduceOp(
+      *cache.fbb, input, threshold, output,
+      static_cast<::tt::target::ttnn::MaskedCompareType>(op.getCompare()),
+      static_cast<::tt::target::ttnn::MaskedModeType>(op.getMode()));
+}
