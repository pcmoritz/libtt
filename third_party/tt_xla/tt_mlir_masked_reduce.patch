+def TTIR_MaskedReduceOp : TTIR_NamedOp<"masked_reduce"> {
+  let summary = "Count, or sum, the elements of each row that compare true against the row's threshold";
+  let description = [{
+    `input` is [..., H, W] and `threshold` [..., H, 1] or [..., H], FP32 or
+    BF16 of one type. Per row, the result, shaped like the threshold, holds how
+    many elements satisfy `input <compare> threshold` (mode count, FP32 or
+    I32), or their sum (mode sum, FP32):
+
+      result[..., h] = sum_w (input[..., h, w] <cmp> threshold[..., h]) ? (count ? 1 : input[..., h, w]) : 0
+
+    One pass over the input, where a reduction of a compare, or of a select on
+    one, reads the input and two intermediates of its size.
+  }];
+
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$threshold,
+                       TTCore_MaskedCompareAttr:$compare,
+                       TTCore_MaskedModeAttr:$mode);
+
+  let results = (outs AnyRankedTensor:$result);
+}
