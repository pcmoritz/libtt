+// masked_reduce (ttnn::experimental) reads tiled FP32 or BF16 tiles, the
+// threshold in the input's type, and writes a tiled FP32 or I32 result.
+TTNNOperandsWorkarounds
+TTNNOperandsWorkaroundsFactory::createMaskedReduceOpOperandsWorkarounds(
+    mlir::Operation *op) {
+  auto masked = mlir::cast<ttnn::MaskedReduceOp>(op);
+  Type inputType = masked.getInput().getType().getElementType();
+  TTNNOperandWorkarounds operand;
+  operand.tensorLayoutWorkaround = Layout::Tile;
+  operand.tensorDataTypeWorkaround = inputType.isBF16()
+                                         ? ttcore::DataType::BFloat16
+                                         : ttcore::DataType::Float32;
+  TTNNOperandWorkarounds result;
+  result.tensorLayoutWorkaround = Layout::Tile;
+  result.tensorDataTypeWorkaround = masked.getResult().getType().getElementType().isInteger(32) ? ttcore::DataType::Int32 : ttcore::DataType::Float32;
+  return TTNNOperandsWorkarounds::createEmptyTTNNOperandsWorkarounds()
+      .addInputOperandWorkaround(operand) // input
+      .addInputOperandWorkaround(operand) // threshold
+      .addOutputOperandWorkaround(result);
+}
