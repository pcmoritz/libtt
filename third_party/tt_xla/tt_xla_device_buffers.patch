+// As on a TPU, a buffer moves to the device when it is created, in the layout
+// programs read their arguments in: tiled, interleaved in DRAM. A program then
+// reads it as it is, and the host buffer is free to go. Only on a client with
+// one device: on a mesh of several chips, a buffer for one device ends up on
+// every chip of the mesh in use, so it moves when a program first runs.
+// Data types without tiles of their own, such as booleans, move then too, and
+// a buffer in host memory (pinned_host) stays there.
+void BufferInstance::moveToDevice(::tt::target::DataType data_type,
+                                  const std::vector<std::uint32_t> &shape) {
+  if (m_memory != nullptr && m_memory->isHostMemory()) {
+    return;
+  }
+  if (data_type != ::tt::target::DataType::BFloat16 &&
+      data_type != ::tt::target::DataType::Float32 &&
+      data_type != ::tt::target::DataType::Int32 &&
+      data_type != ::tt::target::DataType::UInt32) {
+    return;
+  }
+  if (std::find(shape.begin(), shape.end(), 0) != shape.end()) {
+    return;
+  }
+  ClientInstance *client = GlobalClientInstanceSingleton::getClientInstance();
+  if (client == nullptr || client->isCompileOnly() ||
+      client->getDevicesRaw().size() != 1 || !client->parentMesh()) {
+    return;
+  }
+  const std::lock_guard<std::mutex> lock(deviceWorkMutex());
+  m_pjrt_tensor->ensure_layout(*client->parentMesh(),
+                               tt::runtime::getDeviceLayout(data_type));
+}
