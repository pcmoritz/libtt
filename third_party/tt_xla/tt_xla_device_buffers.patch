+// In TPU compatibility mode, as on a TPU, a buffer moves to the device when it
+// is created, in the layout programs read their arguments in: tiled,
+// interleaved in DRAM. A program then reads it as it is, and the host buffer is
+// free to go. Elsewhere a buffer moves when a program first runs: a weight that
+// a JAX program marks stays in host memory, a file mapping without a copy, and
+// the program prepares its device form once. Only on a client with one device:
+// on a mesh of several chips, a buffer for one device ends up on every chip of
+// the mesh in use, so it moves when a program first runs. Data types without
+// tiles of their own, such as booleans, move then too, and a buffer in host
+// memory (pinned_host) stays there.
+bool BufferInstance::movesToDeviceOnCreation(
+    ::tt::target::DataType data_type,
+    const std::vector<std::uint32_t> &shape) const {
+  if (!isTpuCompatMode()) {
+    return false;
+  }
+  if (m_memory != nullptr && m_memory->isHostMemory()) {
+    return false;
+  }
+  if (data_type != ::tt::target::DataType::BFloat16 &&
+      data_type != ::tt::target::DataType::Float32 &&
+      data_type != ::tt::target::DataType::Int32 &&
+      data_type != ::tt::target::DataType::UInt32) {
+    return false;
+  }
+  if (std::find(shape.begin(), shape.end(), 0) != shape.end()) {
+    return false;
+  }
+  ClientInstance *client = GlobalClientInstanceSingleton::getClientInstance();
+  return client != nullptr && !client->isCompileOnly() &&
+         client->getDevicesRaw().size() == 1 && client->parentMesh();
+}
+
+void BufferInstance::moveToDevice(::tt::target::DataType data_type) {
+  ClientInstance *client = GlobalClientInstanceSingleton::getClientInstance();
+  // Writing to the device during a trace capture on another thread would be
+  // skipped or recorded into the trace.
+  const std::lock_guard<std::recursive_mutex> capture_lock(
+      tt::runtime::getTraceCaptureMutex());
+  m_pjrt_tensor->ensure_layout(*client->parentMesh(),
+                               tt::runtime::getDeviceLayout(data_type));
+}
