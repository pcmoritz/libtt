+// A small constant: a cacheable creation op whose only inputs are shared ops
+// (the device) and whose one result holds at most kSmallConstantElements
+// values, such as the scalar constants of element-wise ops. Each const-eval
+// subgraph that uses one gets its own copy, as with shared ops, instead of
+// joining every other subgraph that uses it: a scalar shared by unrelated
+// weights' preparations (say, the decode of every layer's 4-bit experts) would
+// merge them into one const-eval function whose results, and so its hash,
+// depend on everything else the program hoists, and other programs would miss
+// its cache and prepare the same weights again.
+static constexpr int64_t kSmallConstantElements = 1024;
+
+static bool isSmallConstant(mlir::Operation *op) {
+  if (!op->hasTrait<mlir::tt::ttcore::Trait::TTCoreCreationOpTrait>() ||
+      op->hasTrait<mlir::tt::ttcore::Trait::TTCoreNonCacheableTrait>() ||
+      op->getNumResults() != 1) {
+    return false;
+  }
+  for (mlir::Value operand : op->getOperands()) {
+    mlir::Operation *producer = operand.getDefiningOp();
+    if (!producer ||
+        !producer
+             ->hasTrait<mlir::tt::ttcore::Trait::TTCoreDuplicateConstEvalTrait>()) {
+      return false;
+    }
+  }
+  auto type = mlir::dyn_cast<mlir::RankedTensorType>(op->getResult(0).getType());
+  return type && type.hasStaticShape() &&
+         type.getNumElements() <= kSmallConstantElements;
+}
+
 static bool isSharedOp(mlir::Operation *op) {
   assert(op != nullptr);
-  return op->hasTrait<mlir::tt::ttcore::Trait::TTCoreDuplicateConstEvalTrait>();
+  return op->hasTrait<mlir::tt::ttcore::Trait::TTCoreDuplicateConstEvalTrait>() ||
+         isSmallConstant(op);
+}
+
+// Small constants that no op in `funcOp` uses: every const-eval function gets a
+// copy of each (as a shared op), and a function keeps only its own, so that its
+// hash covers its own computation alone; the original function keeps those its
+// remaining ops use.
+static void eraseUnusedSmallConstants(func::FuncOp funcOp) {
+  llvm::SmallVector<mlir::Operation *> unused;
+  funcOp.walk([&](mlir::Operation *op) {
+    if (isSmallConstant(op) && op->use_empty()) {
+      unused.push_back(op);
+    }
+  });
+  for (mlir::Operation *op : unused) {
+    op->erase();
+  }
 }
 
