+class ReducePrecisionOpConversionPattern
+    : public OpConversionPattern<ttir::ReducePrecisionOp> {
+public:
+  using OpConversionPattern<ttir::ReducePrecisionOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::ReducePrecisionOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    rewriter.replaceOpWithNewOp<ttnn::ReducePrecisionOp>(
+        op, this->getTypeConverter()->convertType(op.getType()),
+        adaptor.getInput(), adaptor.getExponentBits(),
+        adaptor.getMantissaBits());
+    return success();
+  }
+};
