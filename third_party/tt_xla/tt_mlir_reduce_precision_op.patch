+// ReducePrecisionOp verification
+::mlir::LogicalResult mlir::tt::ttir::ReducePrecisionOp::verify() {
+  auto inputType = getInput().getType();
+  if (getResult().getType() != inputType) {
+    return emitOpError() << "result type must match the input type";
+  }
+  if (!inputType.getElementType().isF32() &&
+      !inputType.getElementType().isBF16() &&
+      !inputType.getElementType().isF16()) {
+    return emitOpError() << "input must be float32, bfloat16 or float16";
+  }
+  if (getExponentBits() < 1 || getMantissaBits() < 0) {
+    return emitOpError() << "needs at least one exponent bit and a "
+                            "non-negative number of mantissa bits";
+  }
+  return success();
+}
