+def TTNN_ReducePrecisionOp : TTNN_ElementwiseUnaryOp<"reduce_precision", [OpModelExempt]> {
+    let summary = "Eltwise reduce precision op.";
+    let description = [{
+      Rounds a float32, bfloat16 or float16 tensor to a floating-point format
+      with `exponent_bits` and `mantissa_bits`, like XLA's reduce_precision, in
+      one kernel on the raw bits.
+    }];
+
+    let arguments = (ins AnyRankedTensor:$input,
+                         SI32Attr:$exponent_bits,
+                         SI32Attr:$mantissa_bits);
+
+    let builders =
+    [
+      OpBuilder<(ins "Value": $input, "int32_t": $exponent_bits, "int32_t": $mantissa_bits),
+      [{
+        build($_builder, $_state, {input.getType()}, input, exponent_bits, mantissa_bits);
+      }]>
+    ];
+
+    let hasVerifier = 1;
+}
