+def TTIR_ReducePrecisionOp : TTIR_ElementwiseUnaryOp<"reduce_precision",
+    [AllShapesMatch<["input", "result"]>, AllElementTypesMatch<["input", "result"]>]> {
+    let summary = "Elementwise reduce precision operation.";
+    let description = [{
+      Rounds each element of a float32, bfloat16 or float16 tensor to a
+      floating-point format with `exponent_bits` and `mantissa_bits`, as
+      stablehlo.reduce_precision: round to nearest even, flush values below the
+      format's smallest normal to signed zero, saturate overflows to signed
+      infinity, and keep NaN. The result has the input's type.
+    }];
+
+    let arguments = (ins RankedTensorOf<[F32, BF16, F16]>:$input,
+                         ConfinedAttr<SI32Attr, [IntMinValue<1>]>:$exponent_bits,
+                         ConfinedAttr<SI32Attr, [IntNonNegative]>:$mantissa_bits);
+    let results = (outs RankedTensorOf<[F32, BF16, F16]>:$result);
+}
