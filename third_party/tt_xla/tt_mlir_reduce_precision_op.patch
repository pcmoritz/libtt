+def TTNN_ReducePrecisionOp : TTNN_ElementwiseUnaryOp<"reduce_precision",
+    [OpModelExempt, AllShapesMatch<["input", "result"]>, AllElementTypesMatch<["input", "result"]>]> {
+    let summary = "Eltwise reduce precision op.";
+    let description = [{
+      Rounds a float32, bfloat16 or float16 tensor to a floating-point format
+      with `exponent_bits` and `mantissa_bits`, like XLA's reduce_precision, in
+      one kernel on the raw bits.
+    }];
+
+    let arguments = (ins RankedTensorOf<[F32, BF16, F16]>:$input,
+                         ConfinedAttr<SI32Attr, [IntMinValue<1>]>:$exponent_bits,
+                         ConfinedAttr<SI32Attr, [IntNonNegative]>:$mantissa_bits);
+    let results = (outs RankedTensorOf<[F32, BF16, F16]>:$result);
+
+    let builders =
+    [
+      OpBuilder<(ins "Value": $input, "int32_t": $exponent_bits, "int32_t": $mantissa_bits),
+      [{
+        build($_builder, $_state, {input.getType()}, input, exponent_bits, mantissa_bits);
+      }]>
+    ];
+}
