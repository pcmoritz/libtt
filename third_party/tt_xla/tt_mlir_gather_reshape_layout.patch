diff --git a/lib/Dialect/TTNN/IR/TTNNOps.cpp b/lib/Dialect/TTNN/IR/TTNNOps.cpp
--- a/lib/Dialect/TTNN/IR/TTNNOps.cpp
+++ b/lib/Dialect/TTNN/IR/TTNNOps.cpp
@@ -2352,6 +2352,53 @@
   return nullptr;
 }
 
+// A gather can flatten a tile-aligned state into a few very wide rows.
+// Keep the reshape in row-major layout when tilizing the flat shape would
+// introduce padding. Only widen rows: narrowing can turn a copy into millions
+// of tiny row transfers (for example, a gather from flattened log-probabilities).
+static bool addsTilePadding(RankedTensorType compact, RankedTensorType padded) {
+  auto compactLayout = dyn_cast_if_present<TTNNLayoutAttr>(compact.getEncoding());
+  auto paddedLayout = dyn_cast_if_present<TTNNLayoutAttr>(padded.getEncoding());
+  if (!compactLayout || !paddedLayout || !compact.hasStaticShape() ||
+      compact.getRank() < 2 || padded.getRank() < 2 ||
+      padded.getShape().back() <= compact.getShape().back() ||
+      compact.getNumElements() == 0 ||
+      !(compact.getElementType().isBF16() || compact.getElementType().isF32()) ||
+      !compactLayout.hasInterleavedDRAMTensorMemoryLayout() ||
+      !paddedLayout.hasInterleavedDRAMTensorMemoryLayout() ||
+      !compactLayout.isTiled() || !paddedLayout.isTiled()) {
+    return false;
+  }
+  uint64_t bytes = compact.getNumElements() *
+                   (compact.getElementTypeBitWidth() / 8);
+  return compactLayout.getShardSizeInBytes() == bytes &&
+         paddedLayout.getShardSizeInBytes() > bytes;
+}
+
+void ToLayoutOp::getCanonicalizationPatterns(RewritePatternSet &patterns,
+                                            MLIRContext *) {
+  patterns.add(+[](ToLayoutOp op, PatternRewriter &rewriter) -> LogicalResult {
+    auto reshape = op.getInput().getDefiningOp<ReshapeOp>();
+    auto layout = dyn_cast_if_present<TTNNLayoutAttr>(op.getType().getEncoding());
+    if (!reshape || !reshape->hasOneUse() || !op->hasOneUse() ||
+        op.hasDtypeChange() || !layout ||
+        layout.isTiled() || !layout.hasInterleavedDRAMTensorMemoryLayout() ||
+        !addsTilePadding(reshape.getInput().getType(), reshape.getType())) {
+      return failure();
+    }
+    auto embedding = dyn_cast<EmbeddingOp>(*op->getUsers().begin());
+    if (!embedding || embedding.getWeight() != op.getResult()) {
+      return failure();
+    }
+    auto rowType = utils::RankedTensorTypeFactory::create(
+        reshape.getInput().getType(), Layout::RowMajor);
+    auto row = rewriter.create<ToLayoutOp>(op.getLoc(), rowType, reshape.getInput());
+    rewriter.replaceOpWithNewOp<ReshapeOp>(op, op.getType(), row,
+                                         reshape.getShapeAttr());
+    return success();
+  });
+}
