+def TTIR_AttnResOp : TTIR_NamedOp<"attn_res", [AttrSizedOperandSegments]> {
+  let summary = "Block attention residuals (Inkling 2) with an optional RMS norm";
+  let description = [{
+    For each query row q of queries ([Q, W], scaled by the caller) and each
+    token t of the sources ([T, W] each, the last one plus addend if given):
+      r_i = rsqrt(mean(s_i[t]^2) + eps_res)
+      p_i = softmax_i(<s_i[t], queries[q]> * r_i)
+      mix = sum_i p_i * (normalize ? r_i * s_i[t] : s_i[t])
+    and with a weight ([Q, W]) output[q, t] = mix * rsqrt(mean(mix^2) +
+    eps_norm) * weight[q], else output[q, t] = mix; in FP32. The result is
+    [Q, T, W]. libtt's tt.attn_res custom call (sglang_tpu_kernels.py) forms
+    it; it lowers to ttnn::experimental::attn_res.
+  }];
+  let arguments = (ins Variadic<AnyRankedTensor>:$sources,
+                       Optional<AnyRankedTensor>:$addend,
+                       AnyRankedTensor:$queries,
+                       Optional<AnyRankedTensor>:$weight,
+                       F32Attr:$eps_res,
+                       F32Attr:$eps_norm,
+                       BoolAttr:$normalize);
+  let results = (outs AnyRankedTensor:$output);
+}
