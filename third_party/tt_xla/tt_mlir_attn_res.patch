+::flatbuffers::Offset<::tt::target::ttnn::AttnResOp>
+createOp(FlatbufferObjectCache &cache, AttnResOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  std::vector<::flatbuffers::Offset<::tt::target::ttnn::TensorRef>> sources;
+  for (Value source : op.getSources()) {
+    sources.push_back(tensor(source));
+  }
+  auto sourcesOffset = cache.fbb->CreateVector(sources);
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> addend =
+      op.getAddend() ? tensor(op.getAddend()) : 0;
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> weight =
+      op.getWeight() ? tensor(op.getWeight()) : 0;
+  return ::tt::target::ttnn::CreateAttnResOp(
+      *cache.fbb, sourcesOffset, addend, tensor(op.getQueries()), weight,
+      op.getEpsRes().convertToFloat(), op.getEpsNorm().convertToFloat(),
+      op.getNormalize(),
+      cache.getOrCreateNoSharding(op.getOutput(), tensorValueToFlatbuffer,
+                                  std::nullopt));
+}
