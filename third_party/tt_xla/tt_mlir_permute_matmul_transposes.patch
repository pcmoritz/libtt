+// permute(matmul(a, b), P) -> permute(matmul(b, a), P') when P moves the
+// matmul's second-to-last result dim to the last position: (a b)^T = b^T a^T,
+// so the swapped matmul, with its operands' transposes swapped and flipped,
+// gives the result transposed, and P', P with its values rank - 2 and
+// rank - 1 exchanged, keeps the last dim in place (see getPermuteOpOperand).
+class MatmulTransposedResultPattern : public mlir::OpRewritePattern<PermuteOp> {
+  using mlir::OpRewritePattern<PermuteOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(PermuteOp permute,
+                  mlir::PatternRewriter &rewriter) const override {
+    auto matmul = permute.getInput().getDefiningOp<MatmulOp>();
+    // Attributes such as a weight dtype or an exact FP32 kernel refer to the
+    // operands in their order.
+    if (!matmul || !matmul->hasOneUse() ||
+        !matmul->getDiscardableAttrDictionary().empty()) {
+      return mlir::failure();
+    }
+    // Swapped, a matmul that reads neither operand transposed would read both
+    // transposed: a [32, 8, 512, 512] operand read transposed costs more than
+    // the permute of a [32, 8, 512, 64] result.
+    if (!matmul.getTransposeA() && !matmul.getTransposeB()) {
+      return mlir::failure();
+    }
+    auto type = matmul.getType();
+    int64_t rank = type.getRank();
+    ArrayRef<int64_t> permutation = permute.getPermutation();
+    // Swapping operands also swaps which one broadcasts its batch dims.
+    auto aShape = matmul.getA().getType().getShape();
+    auto bShape = matmul.getB().getType().getShape();
+    if (rank < 2 || permutation[rank - 1] != rank - 2 ||
+        aShape.size() != static_cast<size_t>(rank) ||
+        bShape.size() != static_cast<size_t>(rank) ||
+        aShape.drop_back(2) != bShape.drop_back(2)) {
+      return mlir::failure();
+    }
+
+    llvm::SmallVector<int64_t> shape(type.getShape());
+    std::swap(shape[rank - 2], shape[rank - 1]);
+    Value result = rewriter.create<MatmulOp>(
+        matmul.getLoc(),
+        mlir::RankedTensorType::get(shape, type.getElementType(),
+                                    type.getEncoding()),
+        matmul.getB(), matmul.getA(), !matmul.getTransposeB(),
+        !matmul.getTransposeA());
+    auto newPermutation =
+        llvm::map_to_vector(permutation, [&](int64_t d) -> int64_t {
+          return d == rank - 1 ? rank - 2 : d == rank - 2 ? rank - 1 : d;
+        });
+    if (!llvm::is_sorted(newPermutation)) {
+      result = rewriter.create<PermuteOp>(permute.getLoc(), permute.getType(),
+                                          result, newPermutation);
+    }
+    rewriter.replaceOp(permute, result);
+    return mlir::success();
+  }
+};
