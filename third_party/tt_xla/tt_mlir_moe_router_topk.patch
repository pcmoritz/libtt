+::flatbuffers::Offset<::tt::target::ttnn::MoeRouterTopKOp>
+createOp(FlatbufferObjectCache &cache, MoeRouterTopKOp op) {
+  auto tensor = [&](Value value) {
+    return value ? cache.at<::tt::target::ttnn::TensorRef>(
+                       getOperandThroughDPSOps(value))
+                 : ::flatbuffers::Offset<::tt::target::ttnn::TensorRef>();
+  };
+  return ::tt::target::ttnn::CreateMoeRouterTopKOp(
+      *cache.fbb, tensor(op.getLogits()), tensor(op.getMask()),
+      tensor(op.getFill()), static_cast<uint32_t>(op.getK()),
+      cache.getOrCreateNoSharding(op.getWeights(), tensorValueToFlatbuffer,
+                                  std::nullopt),
+      cache.getOrCreateNoSharding(op.getIndices(), tensorValueToFlatbuffer,
+                                  std::nullopt));
+}
