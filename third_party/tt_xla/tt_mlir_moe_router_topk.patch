+// libtt: a mixture-of-experts router's topk, the softmax of its values and
+// the masking of its indices, as one op.
+def TTNN_MoeRouterTopKOp : TTNN_Op<"moe_router_topk", [OpModelExempt, AttrSizedOperandSegments]> {
+  let summary = "Top k of a router's logits, the softmax of the k values, and masked indices";
+  let description = [{
+    For each row of `logits`: the indices of its `k` largest values, largest
+    first, and the softmax of those values. With `mask` and `fill`, every
+    index of a row whose mask is zero is `fill`:
+    where(mask, topk(logits).indices, fill), softmax(topk(logits).values).
+  }];
+
+  let arguments = (ins AnyRankedTensor:$logits,
+                       Optional<AnyRankedTensor>:$mask,
+                       Optional<AnyRankedTensor>:$fill,
+                       I32Attr:$k);
+
+  let results = (outs AnyRankedTensor:$weights,
+                      AnyRankedTensor:$indices);
+}
