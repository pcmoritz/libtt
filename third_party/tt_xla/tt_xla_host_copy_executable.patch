+// Matches values that can be materialized by copying a host-resident input.
+// Most matches preserve byte order; transpose carries the permutation needed
+// to gather the input into a dense output buffer.
+static std::optional<HostCopyOutput> matchHostCopyValue(
+    mlir::Value value, mlir::Type result_type, mlir::Block &entry,
+    std::vector<mlir::Operation *> &allowed_operations) {
+  if (value.getType() != result_type) {
+    return std::nullopt;
+  }
+
+  // Explicit JAX shardings wrap otherwise ordinary values in metadata-only
+  // custom calls. They do not change the local shard that PJRT copies.
+  while (auto sharding = value.getDefiningOp<mlir::stablehlo::CustomCallOp>()) {
+    llvm::StringRef target = sharding.getCallTargetName();
+    if ((target != mlir::tt::sharding_utils::kTTShardingConstraintTargetName &&
+         target != mlir::tt::gspmd_utils::kShardingCustomCallTargetName) ||
+        sharding.getInputs().size() != 1 || sharding.getNumResults() != 1 ||
+        sharding.getInputs().front().getType() != value.getType()) {
+      return std::nullopt;
+    }
+    allowed_operations.push_back(sharding);
+    value = sharding.getInputs().front();
+  }
+
+  if (auto argument = llvm::dyn_cast<mlir::BlockArgument>(value)) {
+    if (argument.getOwner() != &entry) {
+      return std::nullopt;
+    }
+    return HostCopyOutput{argument.getArgNumber(), {}};
+  }
+
+  if (auto transpose = value.getDefiningOp<mlir::stablehlo::TransposeOp>()) {
+    auto argument = llvm::dyn_cast<mlir::BlockArgument>(transpose.getOperand());
+    auto input_type =
+        llvm::dyn_cast<mlir::RankedTensorType>(transpose.getOperand().getType());
+    auto output_type = llvm::dyn_cast<mlir::RankedTensorType>(result_type);
+    llvm::ArrayRef<int64_t> permutation = transpose.getPermutation();
+    if (!argument || argument.getOwner() != &entry || !input_type ||
+        !output_type || !input_type.hasStaticShape() ||
+        !output_type.hasStaticShape() ||
+        mlir::isa<mlir::ComplexType>(input_type.getElementType()) ||
+        input_type.getElementType() != output_type.getElementType() ||
+        permutation.size() != static_cast<size_t>(input_type.getRank()) ||
+        permutation.size() != static_cast<size_t>(output_type.getRank())) {
+      return std::nullopt;
+    }
+    for (size_t i = 0; i < permutation.size(); ++i) {
+      if (permutation[i] < 0 || permutation[i] >= input_type.getRank() ||
+          output_type.getDimSize(i) !=
+              input_type.getDimSize(permutation[i])) {
+        return std::nullopt;
+      }
+    }
+    allowed_operations.push_back(transpose);
+    return HostCopyOutput{argument.getArgNumber(),
+                          {permutation.begin(), permutation.end()}};
+  }
+
+  auto reduce = value.getDefiningOp<mlir::stablehlo::ReduceOp>();
+  if (!reduce || reduce.getNumResults() != 1 || reduce.getInputs().size() != 1 ||
+      reduce.getInitValues().size() != 1 || !reduce.getBody().hasOneBlock()) {
+    return std::nullopt;
+  }
+
+  auto argument =
+      llvm::dyn_cast<mlir::BlockArgument>(reduce.getInputs().front());
+  auto input_type =
+      llvm::dyn_cast<mlir::RankedTensorType>(reduce.getInputs().front().getType());
+  auto output_type = llvm::dyn_cast<mlir::RankedTensorType>(result_type);
+  if (!argument || argument.getOwner() != &entry || !input_type ||
+      !output_type || !input_type.hasStaticShape() ||
+      !output_type.hasStaticShape() ||
+      input_type.getElementType() != output_type.getElementType() ||
+      input_type.getNumElements() != output_type.getNumElements()) {
+    return std::nullopt;
+  }
+  for (int64_t dimension : reduce.getDimensions()) {
+    if (input_type.getDimSize(dimension) != 1) {
+      return std::nullopt;
+    }
+  }
+
+  auto constant = reduce.getInitValues().front()
+                      .getDefiningOp<mlir::stablehlo::ConstantOp>();
+  auto identity = constant ? llvm::dyn_cast<mlir::DenseFPElementsAttr>(
+                                 constant.getValue())
+                           : nullptr;
+  if (!identity || !identity.isSplat()) {
+    return std::nullopt;
+  }
+  const llvm::APFloat &identity_value =
+      *identity.getValues<llvm::APFloat>().begin();
+  if (!identity_value.isInfinity() || identity_value.isNegative()) {
+    return std::nullopt;
+  }
+
+  mlir::Block &body = reduce.getBody().front();
+  auto minimum = llvm::dyn_cast<mlir::stablehlo::MinOp>(body.front());
+  auto return_op =
+      llvm::dyn_cast<mlir::stablehlo::ReturnOp>(body.getTerminator());
+  if (body.getOperations().size() != 2 || body.getNumArguments() != 2 ||
+      !minimum || !return_op || return_op.getNumOperands() != 1 ||
+      return_op.getOperand(0) != minimum.getResult() ||
+      !((minimum.getOperand(0) == body.getArgument(0) &&
+         minimum.getOperand(1) == body.getArgument(1)) ||
+        (minimum.getOperand(0) == body.getArgument(1) &&
+         minimum.getOperand(1) == body.getArgument(0)))) {
+    return std::nullopt;
+  }
+
+  allowed_operations.push_back(constant);
+  allowed_operations.push_back(reduce);
+  return HostCopyOutput{argument.getArgNumber(), {}};
+}
+
+static std::optional<std::vector<HostCopyOutput>>
+collectAndLowerHostCopyOutputs(
+    mlir::OwningOpRef<mlir::ModuleOp> &module) {
+  auto main = (*module).lookupSymbol<mlir::func::FuncOp>("main");
+  if (!main || !main.getBody().hasOneBlock()) {
+    return std::nullopt;
+  }
+
+  mlir::Block &entry = main.getBody().front();
+  auto return_op =
+      llvm::dyn_cast<mlir::func::ReturnOp>(entry.getTerminator());
+  if (!return_op || return_op.getNumOperands() != main.getNumResults()) {
+    return std::nullopt;
+  }
+
+  std::vector<mlir::Operation *> allowed_operations{entry.getTerminator()};
+  std::vector<HostCopyOutput> outputs;
+  outputs.reserve(return_op.getNumOperands());
+  for (size_t output_index = 0; output_index < return_op.getNumOperands();
+       ++output_index) {
+    auto output = matchHostCopyValue(
+        return_op.getOperand(output_index),
+        main.getResultTypes()[output_index], entry, allowed_operations);
+    if (!output) {
+      return std::nullopt;
+    }
+    outputs.push_back(std::move(*output));
+  }
+
+  for (mlir::Operation &operation : entry) {
+    if (std::find(allowed_operations.begin(), allowed_operations.end(),
+                  &operation) == allowed_operations.end()) {
+      return std::nullopt;
+    }
+  }
+  // The compiled image is used only for metadata when PJRT executes this host
+  // copy plan. Replace transposes with cheap reshapes so the ordinary compiler
+  // path can still produce that metadata without lowering a device permute.
+  for (mlir::Operation *operation : allowed_operations) {
+    auto transpose = llvm::dyn_cast<mlir::stablehlo::TransposeOp>(operation);
+    if (!transpose) {
+      continue;
+    }
+    mlir::OpBuilder builder(transpose);
+    auto reshape = builder.create<mlir::stablehlo::ReshapeOp>(
+        transpose.getLoc(), transpose.getType(), transpose.getOperand());
+    transpose.getResult().replaceAllUsesWith(reshape.getResult());
+    transpose.erase();
+  }
+  return outputs;
+}
