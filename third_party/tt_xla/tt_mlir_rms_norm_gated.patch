+def TTIR_RMSNormGatedOp : TTIR_NamedOp<"rms_norm_gated"> {
+  let summary = "RMS normalization of the last dimension with a SiLU gate";
+  let description = [{
+    output = input * rsqrt(mean(input^2) + epsilon) * weight * silu(gate) over
+    each group of the weight's D columns of the last dimension, in FP32: the
+    gated RMS norm of linear-attention layers such as Qwen3.5 and Qwen3.8's
+    gated DeltaNet output, a group per head. input has the output's shape;
+    gate has its leading dimensions and is read from column gate_offset on.
+  }];
+  let arguments = (ins AnyRankedTensor:$input,
+                       AnyRankedTensor:$gate,
+                       AnyRankedTensor:$weight,
+                       DefaultValuedAttr<F32Attr, "1e-05">:$epsilon,
+                       DefaultValuedAttr<I64Attr, "0">:$gate_offset);
+  let results = (outs AnyRankedTensor:$output);
+}
