+// jnp.mean of a BF16 tensor reaches TTNN as a cast to FP32, an FP32 mean and a
+// cast back. A BF16 mean into FP32 DST skips the two typecast programs. The FPU
+// sums with a narrower adder than the FP32 mean's SFPU path (errors of about
+// 2^-15 of the inputs' magnitude, well under their own BF16 rounding, when it
+// adds a tile's rows), so this is kept to means over the second-to-last
+// dimension of at most a tile's rows, such as Qwen3.8-Flash-Next's mean over 4
+// streams. Means along rows and over several dimensions lose more.
+class TTNNBF16MeanOfUpcast : public mlir::OpRewritePattern<TypecastOp> {
+public:
+  using mlir::OpRewritePattern<TypecastOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(TypecastOp down,
+                  mlir::PatternRewriter &rewriter) const final {
+    auto mean = down.getInput().getDefiningOp<MeanOp>();
+    if (!mean || !mean.getResult().hasOneUse()) {
+      return failure();
+    }
+    auto up = mean.getInput().getDefiningOp<TypecastOp>();
+    if (!up) {
+      return failure();
+    }
+    auto elementType = [](Value v) {
+      return mlir::cast<mlir::RankedTensorType>(v.getType()).getElementType();
+    };
+    if (!elementType(up.getInput()).isBF16() || !elementType(up.getResult()).isF32() ||
+        !elementType(mean.getResult()).isF32() || !elementType(down.getResult()).isBF16()) {
+      return failure();
+    }
+    // The number of elements each mean adds up.
+    llvm::ArrayRef<int64_t> shape =
+        mlir::cast<mlir::RankedTensorType>(up.getInput().getType()).getShape();
+    auto dims = mean.getDimArg();
+    if (!dims || dims->size() != 1) {
+      return failure();
+    }
+    const int64_t rank = static_cast<int64_t>(shape.size());
+    int64_t dim = mlir::cast<mlir::IntegerAttr>((*dims)[0]).getInt();
+    dim = dim < 0 ? dim + rank : dim;
+    auto [tileHeight, tileWidth] = ttcore::TileType::getDefaultShape();
+    if (rank < 2 || dim != rank - 2 || shape[dim] > tileHeight) {
+      return failure();
+    }
+
+    mlir::MLIRContext *context = rewriter.getContext();
+    auto computeConfig = DeviceComputeKernelConfigAttr::get(
+        context, /*mathFidelity=*/MathFidelity::HiFi4,
+        /*mathApproxMode=*/BoolAttr::get(context, false),
+        /*fp32DestAccEn=*/BoolAttr::get(context, true),
+        /*packerL1Acc=*/nullptr, /*dstFullSyncEn=*/nullptr);
+    rewriter.replaceOpWithNewOp<MeanOp>(down, down.getType(), up.getInput(),
+                                        mean.getKeepDimAttr(),
+                                        mean.getDimArgAttr(), computeConfig);
+    return success();
+  }
+};
