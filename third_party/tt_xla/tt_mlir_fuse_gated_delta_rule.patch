+class GatedDeltaRuleOpConversionPattern
+    : public OpConversionPattern<ttir::GatedDeltaRuleOp> {
+public:
+  using OpConversionPattern<ttir::GatedDeltaRuleOp>::OpConversionPattern;
+
+  LogicalResult
+  matchAndRewrite(ttir::GatedDeltaRuleOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> resultTypes;
+    resultTypes.reserve(op.getNumResults());
+    for (Type type : op.getResultTypes()) {
+      Type converted = getTypeConverter()->convertType(type);
+      if (!converted) {
+        return rewriter.notifyMatchFailure(
+            op, "failed to convert gated delta rule result type");
+      }
+      resultTypes.push_back(converted);
+    }
+
+    rewriter.replaceOpWithNewOp<ttnn::GatedDeltaRuleOp>(
+        op, resultTypes, adaptor.getQuery(), adaptor.getKey(),
+        adaptor.getValue(), adaptor.getGate(), adaptor.getBeta(),
+        adaptor.getInitialState(), adaptor.getEye(), adaptor.getTril(),
+        adaptor.getOnes(), adaptor.getMasks());
+    return success();
+  }
+};
