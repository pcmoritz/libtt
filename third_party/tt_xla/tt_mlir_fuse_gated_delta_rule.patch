+constexpr int64_t kGatedDeltaHeadSize = 128;
+
+bool hasShape(Value value, ArrayRef<int64_t> shape) {
+  auto type = dyn_cast<RankedTensorType>(value.getType());
+  return type && type.hasStaticShape() && type.getShape() == shape;
+}
+
+Value stripRecurrentViews(Value value) {
+  return ttmlir::utils::lookThrough<
+      ::mlir::stablehlo::BroadcastInDimOp,
+      ::mlir::stablehlo::ReshapeOp>(value);
+}
+
+struct QwenGatedDeltaMatch {
+  int64_t sequenceLength;
+  int64_t numHeads;
+  Value query;
+  Value key;
+  Value value;
+  Value gate;
+  Value beta;
+  Value initialState;
+  unsigned inductionIndex;
+  unsigned stateIndex;
+  unsigned outputIndex;
+};
+
+std::optional<QwenGatedDeltaMatch>
+matchQwenGatedDeltaLoop(::mlir::stablehlo::WhileOp loop) {
+  if ((loop.getNumOperands() != 3 && loop.getNumOperands() != 8) ||
+      !loop.getCond().hasOneBlock() ||
+      !loop.getBody().hasOneBlock()) {
+    return std::nullopt;
+  }
+
+  SmallVector<Value> qkv;
+  SmallVector<Value> gateInputs;
+  auto &body = loop.getBody().front();
+  loop.getBody().walk([&](::mlir::stablehlo::DynamicSliceOp slice) {
+    Value input = slice->getOperand(0);
+    if (auto argument = dyn_cast<BlockArgument>(input);
+        argument && argument.getOwner() == &body) {
+      input = loop->getOperand(argument.getArgNumber());
+    }
+    auto type = dyn_cast<RankedTensorType>(input.getType());
+    if (!type || !type.hasStaticShape()) {
+      return;
+    }
+    ArrayRef<int64_t> shape = type.getShape();
+    bool isQKV =
+        (shape.size() == 3 && shape[2] == kGatedDeltaHeadSize) ||
+        (shape.size() == 4 && shape[3] == kGatedDeltaHeadSize);
+    if (isQKV) {
+      if (!llvm::is_contained(qkv, input)) {
+        qkv.push_back(input);
+      }
+    } else if ((shape.size() == 2 || shape.size() == 3) &&
+               !llvm::is_contained(gateInputs, input)) {
+      gateInputs.push_back(input);
+    }
+  });
+  if (qkv.size() != 3 || gateInputs.size() != 2) {
+    return std::nullopt;
+  }
+
+  auto qType = cast<RankedTensorType>(qkv.front().getType());
+  bool batched = qType.getRank() == 4;
+  if (!batched && qType.getRank() != 3) {
+    return std::nullopt;
+  }
+  int64_t sequenceLength = qType.getDimSize(0);
+  int64_t batchSize = batched ? qType.getDimSize(1) : 1;
+  int64_t numHeads = qType.getDimSize(batched ? 2 : 1);
+  SmallVector<int64_t> qShape = batched
+                                    ? SmallVector<int64_t>{
+                                          sequenceLength, batchSize, numHeads,
+                                          kGatedDeltaHeadSize}
+                                    : SmallVector<int64_t>{
+                                          sequenceLength, numHeads,
+                                          kGatedDeltaHeadSize};
+  SmallVector<int64_t> gateShape =
+      batched ? SmallVector<int64_t>{sequenceLength, batchSize, numHeads}
+              : SmallVector<int64_t>{sequenceLength, numHeads};
+  if (sequenceLength <= 0 ||
+      (sequenceLength != 1 && sequenceLength % 32 != 0) || batchSize <= 0 ||
+      numHeads <= 0 || !hasShape(qkv[1], qShape) ||
+      !hasShape(qkv[2], qShape) || !hasShape(gateInputs[0], gateShape) ||
+      !hasShape(gateInputs[1], gateShape)) {
+    return std::nullopt;
+  }
+
+  std::optional<unsigned> inductionIndex;
+  std::optional<unsigned> stateIndex;
+  std::optional<unsigned> outputIndex;
+  for (auto [index, operand] : llvm::enumerate(loop->getOperands())) {
+    auto type = dyn_cast<RankedTensorType>(operand.getType());
+    if (!type || !type.hasStaticShape()) {
+      continue;
+    }
+    if (type.getRank() == 0 && type.getElementType().isInteger(32)) {
+      inductionIndex = index;
+    } else if ((!batched &&
+                hasShape(operand, {numHeads, kGatedDeltaHeadSize,
+                                   kGatedDeltaHeadSize})) ||
+               (batched &&
+                hasShape(operand, {batchSize, numHeads,
+                                   kGatedDeltaHeadSize,
+                                   kGatedDeltaHeadSize}))) {
+      stateIndex = index;
+    } else if (hasShape(operand, qShape) &&
+               !llvm::is_contained(qkv, operand)) {
+      outputIndex = index;
+    }
+  }
+  if (!inductionIndex || !stateIndex || !outputIndex) {
+    return std::nullopt;
+  }
+
+  unsigned dotCount = 0;
+  unsigned exponentialCount = 0;
+  loop.getBody().walk([&](Operation *op) {
+    StringRef name = op->getName().getStringRef();
+    dotCount += name == "stablehlo.dot_general";
+    exponentialCount += name == "stablehlo.exponential";
+  });
+  if (dotCount < 2 || exponentialCount < 1) {
+    return std::nullopt;
+  }
+
+  return QwenGatedDeltaMatch{
+      sequenceLength, numHeads, qkv[0], qkv[1], qkv[2],
+      gateInputs[0], gateInputs[1], loop->getOperand(*stateIndex),
+      *inductionIndex, *stateIndex, *outputIndex};
+}
+
+Value createMaskConstant(OpBuilder &builder, Location loc, int64_t rows,
+                         int64_t columns,
+                         function_ref<float(int64_t, int64_t)> getValue) {
+  SmallVector<float> values;
+  values.reserve(rows * columns);
+  for (int64_t row = 0; row < rows; ++row) {
+    for (int64_t column = 0; column < columns; ++column) {
+      values.push_back(getValue(row, column));
+    }
+  }
+  auto type =
+      RankedTensorType::get({1, 1, rows, columns}, builder.getF32Type());
+  auto value = DenseElementsAttr::get(type, ArrayRef<float>(values));
+  return builder.create<::mlir::stablehlo::ConstantOp>(loc, value);
+}
+
+LogicalResult fuseQwenGatedDeltaLoop(::mlir::stablehlo::WhileOp loop) {
+  std::optional<QwenGatedDeltaMatch> match = matchQwenGatedDeltaLoop(loop);
+  if (!match) {
+    return failure();
+  }
+
+  OpBuilder builder(loop);
+  Location loc = loop.getLoc();
+  constexpr int64_t chunkSize = 32;
+  Value eye = createMaskConstant(
+      builder, loc, chunkSize, chunkSize,
+      [](int64_t row, int64_t column) { return column == row ? 1.0f : 0.0f; });
+  Value tril = createMaskConstant(
+      builder, loc, chunkSize, chunkSize,
+      [](int64_t row, int64_t column) { return column <= row ? 1.0f : 0.0f; });
+  Value ones = createMaskConstant(
+      builder, loc, chunkSize, chunkSize,
+      [](int64_t, int64_t) { return 1.0f; });
+  Value masks = createMaskConstant(
+      builder, loc, 32, 96, [](int64_t row, int64_t column) {
+        int64_t tileColumn = column % 32;
+        if (column < 32) {
+          return row < 16 && tileColumn < 16 ? 1.0f : 0.0f;
+        }
+        if (column < 64) {
+          return row >= 16 && tileColumn >= 16 ? 1.0f : 0.0f;
+        }
+        return row >= 16 && tileColumn < 16 ? 1.0f : 0.0f;
+      });
+
+  SmallVector<Value> operands = {
+      match->query, match->key, match->value, match->gate, match->beta,
+      match->initialState, eye, tril, ones, masks};
+  SmallVector<Type> resultTypes = {
+      loop.getResult(match->stateIndex).getType(),
+      loop.getResult(match->outputIndex).getType()};
+  auto fused = builder.create<GatedDeltaRuleOp>(loc, resultTypes, operands);
+
+  auto inductionType =
+      cast<RankedTensorType>(loop->getOperand(match->inductionIndex).getType());
+  auto finalInductionAttr = DenseElementsAttr::get(
+      inductionType, builder.getIntegerAttr(inductionType.getElementType(),
+                                             match->sequenceLength));
+  Value finalInduction = builder.create<::mlir::stablehlo::ConstantOp>(
+      loc, finalInductionAttr);
+
+  for (unsigned index = 0; index < loop.getNumResults(); ++index) {
+    Value replacement = loop->getOperand(index);
+    if (index == match->inductionIndex) {
+      replacement = finalInduction;
+    } else if (index == match->stateIndex) {
+      replacement = fused.getResult(0);
+    } else if (index == match->outputIndex) {
+      replacement = fused.getResult(1);
+    }
+    loop.getResult(index).replaceAllUsesWith(replacement);
+  }
+  loop.erase();
+  return success();
+}
+
+struct FuseQwenGatedDeltaLoopPass
+    : public PassWrapper<FuseQwenGatedDeltaLoopPass,
+                         OperationPass<ModuleOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(FuseQwenGatedDeltaLoopPass)
+
+  StringRef getArgument() const final { return "stablehlo-fuse-qwen-gdn"; }
+  StringRef getDescription() const final {
+    return "Fuse the Qwen Gated DeltaNet recurrence before loop lowering";
+  }
+
+  void runOnOperation() final {
+    SmallVector<::mlir::stablehlo::WhileOp> loops;
+    getOperation().walk<WalkOrder::PostOrder>(
+        [&](::mlir::stablehlo::WhileOp loop) { loops.push_back(loop); });
+    bool fusedGatedDeltaLoop = false;
+    for (::mlir::stablehlo::WhileOp loop : loops) {
+      if (succeeded(fuseQwenGatedDeltaLoop(loop))) {
+        fusedGatedDeltaLoop = true;
+      }
+    }
+    if (!fusedGatedDeltaLoop) {
+      return;
+    }
+
+    bool erased;
+    do {
+      erased = false;
+      getOperation().walk<WalkOrder::PostOrder>([&](Operation *op) {
+        if (op != getOperation() && isOpTriviallyDead(op)) {
+          op->erase();
+          erased = true;
+        }
+      });
+    } while (erased);
+  }
+};
+
+struct QwenGatedDeltaDecodeMatch {
+  Value query;
+  Value key;
+  Value value;
+  Value beta;
+  Value decay;
+  Value statePool;
+  Value stateIndices;
+  Value hasInitialState;
+  Value output;
+};
+
+struct QwenCausalConv1dUpdateMatch {
+  Value input;
+  Value statePool;
+  Value weight;
+  Value stateIndices;
+  Value hasInitialState;
+  Value output;
+};
+
+Value findStatePoolIndices(Value value, int64_t batch) {
+  value = stripRecurrentViews(value);
+  auto type = dyn_cast<RankedTensorType>(value.getType());
+  return type && type.hasStaticShape() && type.getRank() == 1 &&
+                 type.getDimSize(0) == batch &&
+                 type.getElementType().isInteger(32)
+             ? value
+             : Value();
+}
+
+template <typename OpTy>
+OpTy findRecurrentUser(Value value) {
+  for (Operation *user : value.getUsers()) {
+    if (auto match = dyn_cast<OpTy>(user)) {
+      return match;
+    }
+  }
+  return {};
+}
+
+Value matchUpdatedState(StatePoolUpdateOp update) {
+  auto select =
+      update.getUpdates().getDefiningOp<::mlir::stablehlo::SelectOp>();
+  if (!select) {
+    return {};
+  }
+  auto readsPool = [&](Value value) {
+    auto gather = value.getDefiningOp<::mlir::stablehlo::GatherOp>();
+    return gather && gather.getOperand() == update.getStatePool();
+  };
+  if (readsPool(select.getOnTrue())) {
+    return select.getOnFalse();
+  }
+  return readsPool(select.getOnFalse()) ? select.getOnTrue() : Value();
+}
+
+Value matchStatePoolRead(Value state, Value statePool, int64_t batch) {
+  auto select = state.getDefiningOp<::mlir::stablehlo::SelectOp>();
+  if (!select) {
+    return {};
+  }
+  auto gather = select.getOnTrue()
+                    .getDefiningOp<::mlir::stablehlo::GatherOp>();
+  if (!gather) {
+    gather = select.getOnFalse()
+                 .getDefiningOp<::mlir::stablehlo::GatherOp>();
+  }
+  Value predicate = stripRecurrentViews(select.getPred());
+  return gather && gather.getOperand() == statePool &&
+                 hasShape(predicate, {batch})
+             ? predicate
+             : Value();
+}
+
+::mlir::stablehlo::OptimizationBarrierOp
+matchRecurrentBarrier(Value state, Value output) {
+  if (!state.hasOneUse() || !output.hasOneUse()) {
+    return {};
+  }
+  auto barrier = dyn_cast<::mlir::stablehlo::OptimizationBarrierOp>(
+      *state.user_begin());
+  return barrier && barrier->getNumOperands() == 2 &&
+                 barrier->getOperand(0) == state &&
+                 barrier->getOperand(1) == output
+             ? barrier
+             : ::mlir::stablehlo::OptimizationBarrierOp();
+}
+
+LogicalResult fuseStatePoolUpdate(::mlir::stablehlo::ScatterOp scatter) {
+  if (scatter.getInputs().size() != 1 || scatter.getUpdates().size() != 1) {
+    return failure();
+  }
+  ArrayRef<int64_t> scatterDims =
+      scatter.getScatterDimensionNumbers().getScatterDimsToOperandDims();
+  if (scatterDims.size() != 1 || scatterDims[0] != 0) {
+    return failure();
+  }
+
+  Value statePool = scatter.getInputs()[0];
+  Value updates = scatter.getUpdates()[0];
+  auto poolType = dyn_cast<RankedTensorType>(statePool.getType());
+  auto updateType = dyn_cast<RankedTensorType>(updates.getType());
+  if (!poolType || !updateType || !poolType.hasStaticShape() ||
+      !updateType.hasStaticShape() || poolType.getRank() < 2 ||
+      poolType.getRank() != updateType.getRank() ||
+      poolType.getElementType() != updateType.getElementType()) {
+    return failure();
+  }
+  int64_t batch = updateType.getDimSize(0);
+  if (batch <= 0 || batch > 32 || poolType.getDimSize(0) < 2 ||
+      poolType.getDimSize(0) > batch + 1) {
+    return failure();
+  }
+  for (int64_t dim = 1; dim < poolType.getRank(); ++dim) {
+    if (poolType.getDimSize(dim) != updateType.getDimSize(dim)) {
+      return failure();
+    }
+  }
+
+  Value stateIndices =
+      findStatePoolIndices(scatter.getScatterIndices(), batch);
+  if (!stateIndices) {
+    return failure();
+  }
+
+  OpBuilder builder(scatter);
+  auto fused = builder.create<StatePoolUpdateOp>(
+      scatter.getLoc(), scatter.getResult(0).getType(), statePool,
+      stateIndices, updates);
+  scatter.getResult(0).replaceAllUsesWith(fused.getFinalStatePool());
+  scatter.erase();
+  return success();
+}
+
+struct FuseStatePoolUpdatesPass
+    : public PassWrapper<FuseStatePoolUpdatesPass, OperationPass<ModuleOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(FuseStatePoolUpdatesPass)
+  void runOnOperation() final {
+    SmallVector<::mlir::stablehlo::ScatterOp> scatters;
+    getOperation().walk<WalkOrder::PostOrder>(
+        [&](::mlir::stablehlo::ScatterOp scatter) {
+          scatters.push_back(scatter);
+        });
+    for (::mlir::stablehlo::ScatterOp scatter : scatters) {
+      (void)fuseStatePoolUpdate(scatter);
+    }
+  }
+};
+
+bool isOneLike(Value value) {
+  return matchPattern(stripRecurrentViews(value), m_OneFloat());
+}
+
+Value matchExpandedSilu(Value input) {
+  for (Operation *user : input.getUsers()) {
+    auto multiply = dyn_cast<::mlir::stablehlo::MulOp>(user);
+    if (!multiply) {
+      continue;
+    }
+    Value sigmoid = multiply.getLhs() == input ? multiply.getRhs()
+                                               : multiply.getLhs();
+    auto logistic =
+        sigmoid.getDefiningOp<::mlir::stablehlo::LogisticOp>();
+    if (logistic && logistic.getOperand() == input) {
+      return multiply.getResult();
+    }
+    auto divide = sigmoid.getDefiningOp<::mlir::stablehlo::DivOp>();
+    if (!divide || !isOneLike(divide.getLhs())) {
+      continue;
+    }
+    auto denominator = divide.getRhs().getDefiningOp<::mlir::stablehlo::AddOp>();
+    if (!denominator) {
+      continue;
+    }
+    for (auto [one, candidate] :
+         {std::pair{denominator.getLhs(), denominator.getRhs()},
+          std::pair{denominator.getRhs(), denominator.getLhs()}}) {
+      auto exponential = candidate.getDefiningOp<::mlir::stablehlo::ExpOp>();
+      if (!isOneLike(one) || !exponential) {
+        continue;
+      }
+      auto negate = exponential.getOperand()
+                        .getDefiningOp<::mlir::stablehlo::NegOp>();
+      if (negate && negate.getOperand() == input) {
+        return multiply.getResult();
+      }
+    }
+  }
+  return {};
+}
+
+std::optional<QwenCausalConv1dUpdateMatch>
+matchQwenCausalConv1dUpdate(StatePoolUpdateOp stateUpdate) {
+  Value statePool = stateUpdate.getStatePool();
+  auto poolType = dyn_cast<RankedTensorType>(statePool.getType());
+  if (!poolType || !poolType.hasStaticShape() || poolType.getRank() != 3 ||
+      !poolType.getElementType().isBF16() || poolType.getDimSize(0) < 2 ||
+      poolType.getDimSize(2) != 3) {
+    return std::nullopt;
+  }
+  int64_t batch =
+      cast<RankedTensorType>(stateUpdate.getUpdates().getType()).getDimSize(0);
+  int64_t channels = poolType.getDimSize(1);
+  if (batch <= 0 || batch > 32 || channels <= 0 || channels % 32 != 0 ||
+      !hasShape(stateUpdate.getStateIndices(), {batch})) {
+    return std::nullopt;
+  }
+  SmallVector<int64_t> inputShape = {batch, channels};
+  SmallVector<int64_t> weightShape = {channels, 4};
+  SmallVector<int64_t> windowShape = {batch, channels, 4};
+  SmallVector<int64_t> stateShape = {batch, channels, 3};
+
+  Value updatedState = matchUpdatedState(stateUpdate);
+  if (!updatedState) {
+    return std::nullopt;
+  }
+  auto slice =
+      updatedState.getDefiningOp<::mlir::stablehlo::SliceOp>();
+  if (!slice || !hasShape(updatedState, stateShape) ||
+      !hasShape(slice.getOperand(), windowShape)) {
+    return std::nullopt;
+  }
+  Value window = slice.getOperand();
+  auto concatenate =
+      window.getDefiningOp<::mlir::stablehlo::ConcatenateOp>();
+  if (!concatenate || concatenate.getDimension() != 2 ||
+      concatenate.getInputs().size() != 2 ||
+      !hasShape(concatenate.getInputs()[0], stateShape)) {
+    return std::nullopt;
+  }
+  Value input = stripRecurrentViews(concatenate.getInputs()[1]);
+  Value hasInitialState =
+      matchStatePoolRead(concatenate.getInputs()[0], statePool, batch);
+  if (!hasShape(input, inputShape) || !hasInitialState) {
+    return std::nullopt;
+  }
+
+  auto dot = findRecurrentUser<::mlir::stablehlo::DotGeneralOp>(window);
+  if (!dot) {
+    return std::nullopt;
+  }
+  Value weight = dot.getLhs() == window ? dot.getRhs() : dot.getLhs();
+  auto dotType = dyn_cast<RankedTensorType>(dot.getType());
+  if ((dot.getLhs() != window && dot.getRhs() != window) ||
+      !hasShape(weight, weightShape) || !dotType ||
+      !dotType.hasStaticShape() || dotType.getRank() != 2 ||
+      !dotType.getElementType().isBF16() ||
+      (dotType.getShape() != ArrayRef<int64_t>({batch, channels}) &&
+       dotType.getShape() != ArrayRef<int64_t>({channels, batch}))) {
+    return std::nullopt;
+  }
+
+  Value activationInput = dot.getResult();
+  if (dot->hasOneUse()) {
+    Operation *user = *dot->user_begin();
+    if (isa<::mlir::stablehlo::TransposeOp,
+            ::mlir::stablehlo::ReshapeOp>(user)) {
+      activationInput = user->getResult(0);
+    }
+  }
+  Value output = matchExpandedSilu(activationInput);
+  if (!output) {
+    return std::nullopt;
+  }
+  return QwenCausalConv1dUpdateMatch{
+      input, statePool, weight, stateUpdate.getStateIndices(),
+      hasInitialState, output};
+}
+
+LogicalResult fuseQwenCausalConv1dUpdate(StatePoolUpdateOp stateUpdate) {
+  auto match = matchQwenCausalConv1dUpdate(stateUpdate);
+  auto barrier =
+      match ? matchRecurrentBarrier(stateUpdate.getFinalStatePool(),
+                                    match->output)
+            : ::mlir::stablehlo::OptimizationBarrierOp();
+  if (!match || !barrier) {
+    return failure();
+  }
+
+  OpBuilder builder(stateUpdate);
+  SmallVector<Type> resultTypes = {barrier->getResult(0).getType(),
+                                   barrier->getResult(1).getType()};
+  SmallVector<Value> operands = {
+      match->input, match->statePool, match->weight, match->stateIndices,
+      match->hasInitialState};
+  auto fused = builder.create<CausalConv1dUpdateOp>(
+      stateUpdate.getLoc(), resultTypes, operands);
+  barrier->setOperand(0, fused.getFinalStatePool());
+  barrier->setOperand(1, fused.getOutput());
+  return success();
+}
+
+std::optional<std::pair<Value, Value>>
+matchDecodeStateMid(Value value, ArrayRef<int64_t> stateShape,
+                    ArrayRef<int64_t> scalarShape) {
+  auto multiply = value.getDefiningOp<::mlir::stablehlo::MulOp>();
+  if (!multiply) {
+    return std::nullopt;
+  }
+  for (auto [state, decayValue] :
+       {std::pair{multiply.getLhs(), multiply.getRhs()},
+        std::pair{multiply.getRhs(), multiply.getLhs()}}) {
+    Value decay = stripRecurrentViews(decayValue);
+    if (hasShape(state, stateShape) && hasShape(decay, scalarShape)) {
+      return std::pair{state, decay};
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::pair<Value, Value>>
+matchDecodeScaledDelta(Value value, Value stateMid, Value key,
+                       ArrayRef<int64_t> vectorShape,
+                       ArrayRef<int64_t> scalarShape) {
+  auto multiply = value.getDefiningOp<::mlir::stablehlo::MulOp>();
+  if (!multiply) {
+    return std::nullopt;
+  }
+  for (auto [deltaValue, betaValue] :
+       {std::pair{multiply.getLhs(), multiply.getRhs()},
+        std::pair{multiply.getRhs(), multiply.getLhs()}}) {
+    auto subtract =
+        deltaValue.getDefiningOp<::mlir::stablehlo::SubtractOp>();
+    Value beta = stripRecurrentViews(betaValue);
+    if (!subtract || !hasShape(beta, scalarShape) ||
+        !hasShape(subtract.getLhs(), vectorShape)) {
+      continue;
+    }
+    auto stateRead =
+        subtract.getRhs().getDefiningOp<::mlir::stablehlo::DotGeneralOp>();
+    if (stateRead && stateRead.getLhs() == stateMid &&
+        stateRead.getRhs() == key) {
+      return std::pair{subtract.getLhs(), beta};
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<QwenGatedDeltaDecodeMatch>
+matchQwenGatedDeltaDecode(StatePoolUpdateOp stateUpdate) {
+  Value finalState = matchUpdatedState(stateUpdate);
+  if (!finalState) {
+    return std::nullopt;
+  }
+  auto outputDot =
+      findRecurrentUser<::mlir::stablehlo::DotGeneralOp>(finalState);
+  if (!outputDot || (outputDot.getLhs() != finalState &&
+                     outputDot.getRhs() != finalState)) {
+    return std::nullopt;
+  }
+  Value query = outputDot.getLhs() == finalState ? outputDot.getRhs()
+                                                  : outputDot.getLhs();
+  auto outputType = dyn_cast<RankedTensorType>(outputDot.getType());
+  auto stateType = dyn_cast<RankedTensorType>(finalState.getType());
+  if (!outputType || !stateType || !outputType.hasStaticShape() ||
+      !stateType.hasStaticShape() || outputType.getRank() != 3 ||
+      stateType.getRank() != 4) {
+    return std::nullopt;
+  }
+
+  int64_t batch = outputType.getDimSize(0);
+  int64_t numHeads = outputType.getDimSize(1);
+  SmallVector<int64_t> vectorShape = {batch, numHeads, kGatedDeltaHeadSize};
+  SmallVector<int64_t> scalarShape = {batch, numHeads};
+  SmallVector<int64_t> stateShape = {
+      batch, numHeads, kGatedDeltaHeadSize, kGatedDeltaHeadSize};
+  if (batch <= 0 || numHeads <= 0 ||
+      outputType.getShape() != ArrayRef<int64_t>(vectorShape) ||
+      stateType.getShape() != ArrayRef<int64_t>(stateShape) ||
+      !hasShape(query, vectorShape) ||
+      !hasShape(stateUpdate.getStateIndices(), {batch})) {
+    return std::nullopt;
+  }
+  auto add = finalState.getDefiningOp<::mlir::stablehlo::AddOp>();
+  if (!add) {
+    return std::nullopt;
+  }
+
+  for (auto [stateMid, outerValue] :
+       {std::pair{add.getLhs(), add.getRhs()},
+        std::pair{add.getRhs(), add.getLhs()}}) {
+    auto stateMatch = matchDecodeStateMid(stateMid, stateShape, scalarShape);
+    auto outer = outerValue.getDefiningOp<::mlir::stablehlo::MulOp>();
+    if (!stateMatch || !outer) {
+      continue;
+    }
+
+    for (auto [keyValue, scaledDeltaValue] :
+         {std::pair{outer.getLhs(), outer.getRhs()},
+          std::pair{outer.getRhs(), outer.getLhs()}}) {
+      Value key = stripRecurrentViews(keyValue);
+      Value scaledDelta = stripRecurrentViews(scaledDeltaValue);
+      if (!hasShape(key, vectorShape) ||
+          !hasShape(scaledDelta, vectorShape)) {
+        continue;
+      }
+      auto deltaMatch = matchDecodeScaledDelta(
+          scaledDelta, stateMid, key, vectorShape, scalarShape);
+      if (deltaMatch) {
+        Value statePool = stateUpdate.getStatePool();
+        Value hasInitialState =
+            matchStatePoolRead(stateMatch->first, statePool, batch);
+        if (!hasInitialState) {
+          continue;
+        }
+        return QwenGatedDeltaDecodeMatch{
+            query, key, deltaMatch->first, deltaMatch->second,
+            stateMatch->second, statePool, stateUpdate.getStateIndices(),
+            hasInitialState, outputDot.getResult()};
+      }
+    }
+  }
+  return std::nullopt;
+}
+
+LogicalResult fuseQwenGatedDeltaDecode(StatePoolUpdateOp stateUpdate) {
+  auto match = matchQwenGatedDeltaDecode(stateUpdate);
+  auto barrier =
+      match ? matchRecurrentBarrier(stateUpdate.getFinalStatePool(),
+                                    match->output)
+            : ::mlir::stablehlo::OptimizationBarrierOp();
+  if (!match || !barrier || !barrier->getResult(1).hasOneUse()) {
+    return failure();
+  }
+  auto outputConvert = dyn_cast<::mlir::stablehlo::ConvertOp>(
+      *barrier->getResult(1).user_begin());
+  if (!outputConvert ||
+      !cast<RankedTensorType>(outputConvert.getType())
+           .getElementType()
+           .isBF16()) {
+    return failure();
+  }
+
+  OpBuilder builder(stateUpdate);
+  SmallVector<Type> resultTypes = {barrier->getResult(0).getType(),
+                                   barrier->getResult(1).getType()};
+  SmallVector<Value> operands = {
+      match->query, match->key, match->value, match->beta, match->decay,
+      match->statePool, match->stateIndices, match->hasInitialState};
+  auto fused = builder.create<GatedDeltaDecodeOp>(
+      stateUpdate.getLoc(), resultTypes, operands);
+  barrier->setOperand(0, fused.getFinalStatePool());
+  barrier->setOperand(1, fused.getOutput());
+
+  return success();
+}
+
+struct FuseQwenRecurrentDecodePass
+    : public PassWrapper<FuseQwenRecurrentDecodePass,
+                         OperationPass<ModuleOp>> {
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(FuseQwenRecurrentDecodePass)
+
+  void runOnOperation() final {
+    SmallVector<StatePoolUpdateOp> stateUpdates;
+    getOperation().walk<WalkOrder::PostOrder>(
+        [&](StatePoolUpdateOp update) { stateUpdates.push_back(update); });
+
+    bool fused = false;
+    for (StatePoolUpdateOp update : stateUpdates) {
+      if ((std::getenv("LIBTT_DISABLE_CAUSAL_CONV1D_UPDATE_FUSION") ==
+               nullptr &&
+           succeeded(fuseQwenCausalConv1dUpdate(update))) ||
+          (std::getenv("LIBTT_DISABLE_GATED_DELTA_DECODE_FUSION") ==
+               nullptr &&
+           succeeded(fuseQwenGatedDeltaDecode(update)))) {
+        fused = true;
+      }
+    }
+    if (!fused) {
+      return;
+    }
+
+    bool erased;
+    do {
+      erased = false;
+      getOperation().walk<WalkOrder::PostOrder>([&](Operation *op) {
+        if (op != getOperation() && isOpTriviallyDead(op)) {
+          op->erase();
+          erased = true;
+        }
+      });
+    } while (erased);
+  }
+};
