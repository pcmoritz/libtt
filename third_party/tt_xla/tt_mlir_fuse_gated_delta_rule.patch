+namespace tt::runtime::ttnn::operations::transformer {
+
+namespace {
+
+constexpr int64_t kHeadSize = 128;
+constexpr uint32_t kChunkSize = 32;
+const ::ttnn::MemoryConfig kDram = ::ttnn::DRAM_MEMORY_CONFIG;
+const ::ttnn::MemoryConfig kL1 = ::ttnn::L1_MEMORY_CONFIG;
+
+::ttnn::Tensor reshapeTensor(const ::ttnn::Tensor &input,
+                             std::initializer_list<uint32_t> shape,
+                             const std::optional<::ttnn::MemoryConfig>
+                                 &memoryConfig = std::nullopt) {
+  return ::ttnn::reshape(input, ::ttnn::Shape(shape), memoryConfig);
+}
+
+::ttnn::Tensor toF32TileDram(const ::ttnn::Tensor &input) {
+  ::ttnn::Tensor result = input;
+  if (result.layout() != ::ttnn::Layout::TILE) {
+    result = ::ttnn::to_layout(result, ::ttnn::Layout::TILE,
+                               ::ttnn::DataType::FLOAT32, kDram);
+  } else if (result.dtype() != ::ttnn::DataType::FLOAT32) {
+    result = ::ttnn::typecast(result, ::ttnn::DataType::FLOAT32, kDram);
+  }
+  if (result.memory_config() != kDram) {
+    result = ::ttnn::to_memory_config(result, kDram);
+  }
+  return result;
+}
+
+::ttnn::Tensor toF32TileL1(const ::ttnn::Tensor &input) {
+  ::ttnn::Tensor result = input;
+  if (result.layout() != ::ttnn::Layout::TILE) {
+    result = ::ttnn::to_layout(result, ::ttnn::Layout::TILE,
+                               ::ttnn::DataType::FLOAT32, kL1);
+  } else if (result.dtype() != ::ttnn::DataType::FLOAT32) {
+    result = ::ttnn::typecast(result, ::ttnn::DataType::FLOAT32, kL1);
+  }
+  if (result.memory_config() != kL1) {
+    result = ::ttnn::to_memory_config(result, kL1);
+  }
+  return result;
+}
+
+::ttnn::Tensor matmulF32L1(const ::ttnn::Tensor &lhs,
+                           const ::ttnn::Tensor &rhs,
+                           bool packerL1Acc) {
+  ::ttnn::WormholeComputeKernelConfig computeConfig;
+  computeConfig.math_fidelity = ::tt::tt_metal::MathFidelity::HiFi2;
+  computeConfig.math_approx_mode = false;
+  computeConfig.fp32_dest_acc_en = true;
+  computeConfig.packer_l1_acc = packerL1Acc;
+  return ::ttnn::matmul(
+      lhs, rhs, false, false, kL1, ::ttnn::DataType::FLOAT32,
+      /*program_config=*/std::nullopt, /*activation=*/std::nullopt,
+      /*compute_kernel_config=*/computeConfig);
+}
+
+std::pair<::ttnn::Tensor, ::ttnn::Tensor>
+runRecurrentDecode(const ::ttnn::Tensor &queryInput,
+                   const ::ttnn::Tensor &keyInput,
+                   const ::ttnn::Tensor &valueInput,
+                   const ::ttnn::Tensor &gateInput,
+                   const ::ttnn::Tensor &betaInput,
+                   const ::ttnn::Tensor &initialStateInput, uint32_t batchSize,
+                   uint32_t numHeads) {
+  ::ttnn::Tensor query = reshapeTensor(toF32TileL1(queryInput),
+                                 {batchSize, numHeads, 1, kHeadSize}, kL1);
+  ::ttnn::Tensor key = reshapeTensor(toF32TileL1(keyInput),
+                               {batchSize, numHeads, 1, kHeadSize}, kL1);
+  ::ttnn::Tensor value = reshapeTensor(toF32TileL1(valueInput),
+                                 {batchSize, numHeads, 1, kHeadSize}, kL1);
+  ::ttnn::Tensor gate = reshapeTensor(toF32TileL1(gateInput),
+                                {batchSize, numHeads, 1, 1}, kL1);
+  ::ttnn::Tensor beta = reshapeTensor(toF32TileL1(betaInput),
+                                {batchSize, numHeads, 1, 1}, kL1);
+  ::ttnn::Tensor state = reshapeTensor(
+      toF32TileL1(initialStateInput),
+      {batchSize, numHeads, kHeadSize, kHeadSize}, kL1);
+
+  ::ttnn::Tensor decay =
+      ::ttnn::exp(gate, /*fast_and_approximate_mode=*/false, kL1);
+  state = ::ttnn::multiply(state, decay, ::ttnn::DataType::FLOAT32, kL1);
+
+  ::ttnn::Tensor valueRead = matmulF32L1(key, state, true);
+  ::ttnn::Tensor delta =
+      ::ttnn::subtract(value, valueRead, ::ttnn::DataType::FLOAT32, kL1);
+  ::ttnn::Tensor keyColumn =
+      reshapeTensor(key, {batchSize, numHeads, kHeadSize, 1}, kL1);
+  ::ttnn::Tensor outer = matmulF32L1(keyColumn, delta, false);
+  outer = ::ttnn::multiply(outer, beta, ::ttnn::DataType::FLOAT32, kL1);
+  state = ::ttnn::add(state, outer, ::ttnn::DataType::FLOAT32, kL1);
+
+  ::ttnn::Tensor output = matmulF32L1(query, state, true);
+  return {output, state};
+}
+
+} // namespace
+
+void run(const ::tt::target::ttnn::GatedDeltaRuleOp *op,
+         ProgramContext &context) {
+  ProgramTensorPool &tensorPool = context.getTensorPool();
+  const ::ttnn::Tensor &queryInput =
+      tensorPool.getTTNNTensorAndValidate(op->query());
+  const auto &inputShape = queryInput.logical_shape();
+  bool batched = inputShape.rank() == 4;
+  LOG_ASSERT((inputShape.rank() == 3 || batched) &&
+                 inputShape[inputShape.rank() - 1] == kHeadSize,
+             "Gated delta rule requires [T, H, 128] or [T, B, H, 128] "
+             "inputs");
+  LOG_ASSERT(inputShape[0] == 1 || inputShape[0] % kChunkSize == 0,
+             "Gated delta rule sequence length must be 1 or a multiple of 32");
+
+  uint32_t sequenceLength = inputShape[0];
+  uint32_t batchSize = batched ? inputShape[1] : 1;
+  uint32_t numHeads = inputShape[batched ? 2 : 1];
+  auto asKernelInput = [&](const ::tt::target::ttnn::TensorRef *ref) {
+    return toF32TileDram(tensorPool.getTTNNTensorAndValidate(ref));
+  };
+  auto timeToBatchMajor = [&](const ::ttnn::Tensor &input) {
+    return ::ttnn::permute(
+        input, ::ttsl::SmallVector<int64_t>{1, 0, 2, 3}, kDram, 0.0f);
+  };
+  auto headVectorToBatchMajor = [&](const ::ttnn::Tensor &input) {
+    return ::ttnn::permute(input,
+                           ::ttsl::SmallVector<int64_t>{1, 0, 2}, kDram,
+                           0.0f);
+  };
+
+  if (sequenceLength == 1) {
+    auto [output4D, finalState4D] = runRecurrentDecode(
+        tensorPool.getTTNNTensorAndValidate(op->query()),
+        tensorPool.getTTNNTensorAndValidate(op->key()),
+        tensorPool.getTTNNTensorAndValidate(op->value()),
+        tensorPool.getTTNNTensorAndValidate(op->gate()),
+        tensorPool.getTTNNTensorAndValidate(op->beta()),
+        tensorPool.getTTNNTensorAndValidate(op->initial_state()), batchSize,
+        numHeads);
+
+    auto outputMemoryConfig =
+        ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+            ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(op->output()));
+    auto stateMemoryConfig =
+        ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+            ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(
+                op->final_state()));
+    ::ttnn::Tensor output =
+        batched ? reshapeTensor(output4D, {1, batchSize, numHeads, kHeadSize}, kL1)
+                : reshapeTensor(output4D, {1, numHeads, kHeadSize}, kL1);
+    output = ::ttnn::to_layout(
+        output, ::ttnn::Layout::TILE, utils::getDataType(op->output()),
+        outputMemoryConfig);
+    ::ttnn::Tensor finalState =
+        batched
+            ? reshapeTensor(finalState4D,
+                      {batchSize, numHeads, kHeadSize, kHeadSize}, kL1)
+            : reshapeTensor(finalState4D,
+                      {numHeads, kHeadSize, kHeadSize}, kL1);
+    finalState = ::ttnn::to_layout(
+        finalState, ::ttnn::Layout::TILE,
+        utils::getDataType(op->final_state()), stateMemoryConfig);
+    tensorPool.insertTTNNTensorAndValidate(op->final_state(), finalState);
+    tensorPool.insertTTNNTensorAndValidate(op->output(), output);
+    return;
+  }
+
+  ::ttnn::Tensor query = asKernelInput(op->query());
+  ::ttnn::Tensor key = asKernelInput(op->key());
+  ::ttnn::Tensor value = asKernelInput(op->value());
+  ::ttnn::Tensor gate = asKernelInput(op->gate());
+  ::ttnn::Tensor beta = asKernelInput(op->beta());
+  ::ttnn::Tensor initialState = asKernelInput(op->initial_state());
+  if (batched) {
+    query = timeToBatchMajor(query);
+    key = timeToBatchMajor(key);
+    value = timeToBatchMajor(value);
+    gate = headVectorToBatchMajor(gate);
+    beta = headVectorToBatchMajor(beta);
+    initialState = reshapeTensor(
+        initialState, {batchSize, numHeads, kHeadSize, kHeadSize});
+  } else {
+    query = reshapeTensor(query, {1, sequenceLength, numHeads, kHeadSize});
+    key = reshapeTensor(key, {1, sequenceLength, numHeads, kHeadSize});
+    value = reshapeTensor(value, {1, sequenceLength, numHeads, kHeadSize});
+    gate = reshapeTensor(gate, {1, sequenceLength, numHeads});
+    beta = reshapeTensor(beta, {1, sequenceLength, numHeads});
+    initialState =
+        reshapeTensor(initialState, {1, numHeads, kHeadSize, kHeadSize});
+  }
+
+  ::ttnn::Tensor eye =
+      toF32TileDram(tensorPool.getTTNNTensorAndValidate(op->eye()));
+  ::ttnn::Tensor tril =
+      toF32TileDram(tensorPool.getTTNNTensorAndValidate(op->tril()));
+  ::ttnn::Tensor ones =
+      toF32TileDram(tensorPool.getTTNNTensorAndValidate(op->ones()));
+  ::ttnn::Tensor masks =
+      toF32TileDram(tensorPool.getTTNNTensorAndValidate(op->masks()));
+
+  auto [output4D, finalStateOptional] =
+      ::ttnn::transformer::chunk_gated_delta_rule(
+          query, key, value, gate, beta, 1.0f, initialState, true, kChunkSize,
+          false, false, kDram, std::nullopt, eye, tril, ones, masks);
+  LOG_ASSERT(finalStateOptional.has_value(),
+             "Gated delta rule did not return its final state");
+
+  auto outputMemoryConfig =
+      ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+          ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(op->output()));
+  auto stateMemoryConfig =
+      ::tt::runtime::ttnn::utils::createMemoryConfigIfNeeded(
+          ::tt::runtime::ttnn::utils::getTensorRefMemoryConfig(
+              op->final_state()));
+
+  ::ttnn::Tensor output;
+  if (batched) {
+    output = ::ttnn::permute(
+        output4D, ::ttsl::SmallVector<int64_t>{1, 0, 2, 3}, kDram,
+        0.0f);
+  } else {
+    output =
+        reshapeTensor(output4D, {sequenceLength, numHeads, kHeadSize}, kDram);
+  }
+  output = ::ttnn::to_layout(
+      output, ::ttnn::Layout::TILE, utils::getDataType(op->output()),
+      outputMemoryConfig);
+  ::ttnn::Tensor finalState =
+      batched
+          ? reshapeTensor(*finalStateOptional,
+                    {batchSize, numHeads, kHeadSize, kHeadSize}, kDram)
+          : reshapeTensor(*finalStateOptional,
+                    {numHeads, kHeadSize, kHeadSize}, kDram);
+  finalState = ::ttnn::to_layout(
+      finalState, ::ttnn::Layout::TILE,
+      utils::getDataType(op->final_state()), stateMemoryConfig);
+
+  tensorPool.insertTTNNTensorAndValidate(op->final_state(), finalState);
+  tensorPool.insertTTNNTensorAndValidate(op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::GatedDeltaDecodeOp *op,
+         ProgramContext &context) {
+  ProgramTensorPool &tensorPool = context.getTensorPool();
+  const ::ttnn::Tensor &query =
+      tensorPool.getTTNNTensorAndValidate(op->query());
+  const ::ttnn::Tensor &key =
+      tensorPool.getTTNNTensorAndValidate(op->key());
+  const ::ttnn::Tensor &value =
+      tensorPool.getTTNNTensorAndValidate(op->value());
+  const ::ttnn::Tensor &beta =
+      tensorPool.getTTNNTensorAndValidate(op->beta());
+  const ::ttnn::Tensor &decay =
+      tensorPool.getTTNNTensorAndValidate(op->decay());
+  const ::ttnn::Tensor &statePool =
+      tensorPool.getTTNNTensorAndValidate(op->state_pool());
+  const ::ttnn::Tensor &stateIndices =
+      tensorPool.getTTNNTensorAndValidate(op->state_indices());
+  const ::ttnn::Tensor &hasInitialState =
+      tensorPool.getTTNNTensorAndValidate(op->has_initial_state());
+
+  const auto &shape = query.logical_shape();
+  const uint32_t batchSize = shape[0];
+  const uint32_t numHeads = shape[1];
+  TT_FATAL(batchSize == 1,
+           "gated delta decode currently supports batch size 1, got {}",
+           batchSize);
+  const auto active4d = [numHeads](const ::ttnn::Tensor &input) {
+    return reshapeTensor(toF32TileDram(input),
+                         {1, numHeads, 1, kHeadSize});
+  };
+
+  ::ttnn::Tensor queryActive = active4d(query);
+  ::ttnn::Tensor keyActive = active4d(key);
+  ::ttnn::Tensor valueActive = active4d(value);
+  ::ttnn::Tensor betaActive = toF32TileDram(beta);
+  ::ttnn::Tensor decayActive = toF32TileDram(decay);
+  const ::ttnn::Tensor &activeIndices = stateIndices;
+  ::ttnn::Tensor activeStateFlag = ::ttnn::to_layout(
+      hasInitialState, ::ttnn::Layout::TILE, ::ttnn::DataType::BFLOAT16,
+      kDram);
+  ::ttnn::Tensor tiledStatePool = toF32TileDram(statePool);
+  ::ttnn::Tensor outputBuffer = ::ttnn::empty(
+      ::ttnn::Shape{1, numHeads, 1, kHeadSize},
+      ::ttnn::DataType::FLOAT32, ::ttnn::Layout::TILE, query.device(), kDram);
+  ::ttnn::Tensor activeOutput =
+      ::ttnn::transformer::gated_delta_decode(
+          queryActive, keyActive, valueActive, betaActive, decayActive,
+          tiledStatePool, outputBuffer, activeIndices, activeStateFlag);
+  ::ttnn::Tensor updatedStatePool = ::ttnn::to_layout(
+      tiledStatePool, statePool.layout(), statePool.dtype(), kDram);
+
+  ::ttnn::Tensor output =
+      reshapeTensor(activeOutput, {batchSize, numHeads, kHeadSize});
+
+  tensorPool.insertTTNNTensorAndValidate(op->final_state_pool(),
+                                         updatedStatePool);
+  tensorPool.insertTTNNTensorAndValidate(op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::CausalConv1dUpdateOp *op,
+         ProgramContext &context) {
+  ProgramTensorPool &tensorPool = context.getTensorPool();
+  const ::ttnn::Tensor &input =
+      tensorPool.getTTNNTensorAndValidate(op->input());
+  const ::ttnn::Tensor &statePool =
+      tensorPool.getTTNNTensorAndValidate(op->state_pool());
+  const ::ttnn::Tensor &weight =
+      tensorPool.getTTNNTensorAndValidate(op->weight());
+  const ::ttnn::Tensor &stateIndices =
+      tensorPool.getTTNNTensorAndValidate(op->state_indices());
+  const ::ttnn::Tensor &hasInitialState =
+      tensorPool.getTTNNTensorAndValidate(op->has_initial_state());
+
+  ::ttnn::Tensor output = ::ttnn::transformer::causal_conv1d_update(
+      input, statePool, weight, stateIndices, hasInitialState);
+
+  tensorPool.insertTTNNTensorAndValidate(op->final_state_pool(), statePool);
+  tensorPool.insertTTNNTensorAndValidate(op->output(), output);
+}
+
+void run(const ::tt::target::ttnn::StatePoolUpdateOp *op,
+         ProgramContext &context) {
+  ProgramTensorPool &tensorPool = context.getTensorPool();
+  const ::ttnn::Tensor &statePoolInput =
+      tensorPool.getTTNNTensorAndValidate(op->state_pool());
+  ::ttnn::Tensor uniqueStatePool =
+      ::ttnn::clone(statePoolInput, std::nullopt,
+                    statePoolInput.memory_config(), std::nullopt);
+  if (tensorPool.inputAliases(op->state_pool())) {
+    tensorPool.insertTTNNTensorAndValidate(op->state_pool(), uniqueStatePool);
+  }
+  const ::ttnn::Tensor &statePool =
+      tensorPool.getTTNNTensorAndValidate(op->state_pool());
+  const ::ttnn::Tensor &stateIndices =
+      tensorPool.getTTNNTensorAndValidate(op->state_indices());
+  const ::ttnn::Tensor &updates =
+      tensorPool.getTTNNTensorAndValidate(op->updates());
+  (void)::ttnn::transformer::state_pool_update(statePool, stateIndices,
+                                                updates);
+}
+
