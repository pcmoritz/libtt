 namespace internal {
 
 // Parse out the value of one specific boolean flag from the options map.
diff --git a/pjrt_implementation/src/api/compile_options.cc b/pjrt_implementation/src/api/compile_options.cc
--- a/pjrt_implementation/src/api/compile_options.cc
+++ b/pjrt_implementation/src/api/compile_options.cc
@@ -14,6 +14,14 @@
 
 namespace tt::pjrt {
 
+bool isTpuCompatMode() {
+  static const bool tpu_compat_mode = [] {
+    const char *value = std::getenv("LIBTT_TPU_COMPAT");
+    return value != nullptr && *value != '\0' && std::string(value) != "0";
+  }();
+  return tpu_compat_mode;
+}
+
 CompileOptions CompileOptions::parse(
     const std::unordered_map<std::string, std::string> &compile_options) {
   CompileOptions options;
@@ -69,6 +77,13 @@ CompileOptions CompileOptions::parse(
   options.enable_trace =
       internal::parseBoolOption(compile_options, "enable_trace")
           .value_or(options.enable_trace);
+  // On a TPU, torch_tpu compiles its eager ops at XLA's O1 effort level and
+  // its graphs at the default. An eager op runs once, or on other buffers each
+  // time, as while a model loads, so a trace of it would only hold slots.
+  if (internal::parseIntOption(compile_options, xla_optimization_level_key) ==
+      1) {
+    options.enable_trace = false;
+  }
   // By default, export tensors for codegen paths.
   options.export_tensors =
