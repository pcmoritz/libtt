+      CompileOptions::xla_optimization_level_key,
+      "xla_tpu_autofdo",
+      "xla_tpu_vmem_scavenging_mode",
       "xla_dump_max_hlo_modules",
       "xla_gpu_auto_spmd_partitioning_memory_budget_ratio",
   };
