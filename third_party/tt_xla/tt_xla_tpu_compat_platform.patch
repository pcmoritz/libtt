+// Whether an eager op's program is long enough to trace: its TTIR ops, each a
+// program or a few once lowered. The sampling filters' unrolled searches have
+// hundreds; the eager ops that load a model or prepare a step, a handful.
+static bool isLongEagerProgram(mlir::ModuleOp module) {
+  constexpr int64_t kLongEagerProgramOps = 128;
+  int64_t ops = 0;
+  module.walk([&](mlir::Operation *op) {
+    if (op->getDialect() && op->getDialect()->getNamespace() == "ttir") {
+      ++ops;
+    }
+  });
+  return ops >= kLongEagerProgramOps;
+}
