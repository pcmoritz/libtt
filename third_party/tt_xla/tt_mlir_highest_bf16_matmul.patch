diff --git a/lib/Dialect/TTNN/Transforms/TTNNSetComputeKernelConfig.cpp b/lib/Dialect/TTNN/Transforms/TTNNSetComputeKernelConfig.cpp
--- a/lib/Dialect/TTNN/Transforms/TTNNSetComputeKernelConfig.cpp
+++ b/lib/Dialect/TTNN/Transforms/TTNNSetComputeKernelConfig.cpp
@@ -45,6 +45,35 @@ void applyLargeInnerDimBf16MatmulConfig(OpTy op,
   config = config.withPackerL1Acc(true);
 }
 
+// A matmul at the highest precision (ttcore.fp32_exact) runs on the vector
+// unit, ttnn::experimental::matmul_fp32, which reads FP32 operands only. With
+// a narrower operand (a BF16 tensor whose cast was dropped, or a weight
+// converted on request) it runs on the matrix unit at HiFi4 with an FP32 Dst
+// instead: its BF16 products are exact, but its sums keep fewer bits than
+// FP32. This runs after the weight dtype conversion, so it sees the final
+// operand dtypes.
+void applyNarrowedExactMatmulConfig(MatmulOp op,
+                                    DeviceComputeKernelConfigAttr &config) {
+  if (!op->hasAttr("ttcore.fp32_exact")) {
+    return;
+  }
+  auto isF32 = [](mlir::Value value) {
+    auto type = mlir::cast<RankedTensorType>(value.getType());
+    if (auto layout =
+            mlir::dyn_cast_or_null<TTNNLayoutAttr>(type.getEncoding())) {
+      return layout.getDataType() == ttcore::DataType::Float32;
+    }
+    return type.getElementType().isF32();
+  };
+  if (isF32(op.getA()) && isF32(op.getB())) {
+    return;
+  }
+  op->removeAttr("ttcore.fp32_exact");
+  config = config.withMathFidelity(MathFidelity::HiFi4)
+               .withFp32DestAccEn(true)
+               .withMathApproxMode(false);
+}
+
 } // namespace
 
 #define GEN_PASS_DEF_TTNNSETCOMPUTEKERNELCONFIG
@@ -160,6 +189,7 @@ public:
       // This fix is required for correctness of large matmuls/linears.
       if (auto matmulOp = dyn_cast<MatmulOp>(op)) {
         applyLargeInnerDimBf16MatmulConfig(matmulOp, config);
+        applyNarrowedExactMatmulConfig(matmulOp, config);
       } else if (auto linearOp = dyn_cast<LinearOp>(op)) {
         applyLargeInnerDimBf16MatmulConfig(linearOp, config);
       }
