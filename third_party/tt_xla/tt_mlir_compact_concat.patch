+    %1 = "ttir.reshape"(%b) <{shape = [256 : i32, 1 : i32, 2048 : i32]}> : (tensor<256x2048xbf16>) -> tensor<256x1x2048xbf16>
+    %2 = "ttir.reshape"(%c) <{shape = [256 : i32, 1 : i32, 4096 : i32]}> : (tensor<256x4096xbf16>) -> tensor<256x1x4096xbf16>
+    %3 = "ttir.concat"(%0, %1, %2) <{dim = 2 : si32}> : (tensor<256x1x2048xbf16>, tensor<256x1x2048xbf16>, tensor<256x1x4096xbf16>) -> tensor<256x1x8192xbf16>
