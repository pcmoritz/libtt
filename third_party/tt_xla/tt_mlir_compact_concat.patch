+    %0 = "ttir.reshape"(%a) <{shape = [32 : i32, 1 : i32, 64 : i32]}> : (tensor<32x64xf32>) -> tensor<32x1x64xf32>
+    %1 = "ttir.reshape"(%b) <{shape = [32 : i32, 1 : i32, 32 : i32]}> : (tensor<32x32xf32>) -> tensor<32x1x32xf32>
