 void mlir::tt::ttir::ReshapeOp::getCanonicalizationPatterns(
     mlir::RewritePatternSet &patterns, mlir::MLIRContext *context) {
+  // Avoid a padded [rows, 1, width] intermediate when concatenating matrices.
+  // The inserted unit dimension changes neither element order nor the concat
+  // axis, but becomes 32 rows per batch when lowered to tiled storage.
+  patterns.add(+[](ReshapeOp reshape, PatternRewriter &rewriter) -> LogicalResult {
+    auto concat = reshape.getInput().getDefiningOp<ConcatOp>();
+    auto shape = reshape.getType().getShape();
+    if (!concat || !concat->hasOneUse() || shape.size() != 2 ||
+        concat.getType().getRank() != 3 ||
+        !(concat.getDim() == 2 || concat.getDim() == -1)) {
+      return failure();
+    }
+    auto concatShape = concat.getType().getShape();
+    if (concatShape[0] != shape[0] || concatShape[1] != 1 ||
+        concatShape[2] != shape[1]) {
+      return failure();
+    }
+    SmallVector<Value> inputs;
+    for (Value input : concat.getInputs()) {
+      auto expanded = input.getDefiningOp<ReshapeOp>();
+      if (!expanded) {
+        return failure();
+      }
+      auto original = expanded.getInput().getType().getShape();
+      if (original.size() != 2 || original[0] != shape[0] ||
+          original[1] != expanded.getType().getShape()[2]) {
+        return failure();
+      }
+      inputs.push_back(expanded.getInput());
+    }
+    auto replacement = rewriter.create<ConcatOp>(
+        reshape.getLoc(), reshape.getType(), inputs, 1);
+    replacement->setAttrs(concat->getAttrs());
+    replacement.setDim(1);
+    rewriter.replaceOp(reshape, replacement.getResult());
+    return success();
+  });
   patterns.add(+[](mlir::tt::ttir::ReshapeOp trailingReshape,
