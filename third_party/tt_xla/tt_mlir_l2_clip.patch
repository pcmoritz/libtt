+def TTIR_L2ClipOp : TTIR_NamedOp<"l2_clip", [AttrSizedOperandSegments]> {
+  let summary = "L2 clipping of each group of columns (a head)";
+  let description = [{
+    v = input[..., offset : offset + width] * scale, then
+    output = v * min(1, threshold / sqrt(sum_group(v^2) + epsilon^2)) *
+    row_scale * sigmoid(gate[..., gate_offset : gate_offset + width]) over
+    each group of `group` columns, in FP32: Inkling 2's query, key and
+    relative-projection clips, and with an infinite threshold its attention
+    output gate. scale is [width], row_scale [rows, 1], the gate as wide.
+    libtt's tt.l2_clip custom call (sglang_tpu_kernels.py) forms it.
+  }];
+  let arguments = (ins AnyRankedTensor:$input,
+                       Optional<AnyRankedTensor>:$scale,
+                       Optional<AnyRankedTensor>:$row_scale,
+                       I64Attr:$group,
+                       F32Attr:$threshold,
+                       F32Attr:$epsilon,
+                       I64Attr:$offset,
+                       I64Attr:$width,
+                       Optional<AnyRankedTensor>:$gate,
+                       DefaultValuedAttr<I64Attr, "0">:$gate_offset);
+  let results = (outs AnyRankedTensor:$output);
+}
