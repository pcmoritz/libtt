+::flatbuffers::Offset<::tt::target::ttnn::L2ClipOp>
+createOp(FlatbufferObjectCache &cache, L2ClipOp op) {
+  auto tensor = [&](Value value) {
+    return cache.at<::tt::target::ttnn::TensorRef>(
+        getOperandThroughDPSOps(value));
+  };
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> scale =
+      op.getScale() ? tensor(op.getScale()) : 0;
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> rowScale =
+      op.getRowScale() ? tensor(op.getRowScale()) : 0;
+  ::flatbuffers::Offset<::tt::target::ttnn::TensorRef> gate =
+      op.getGate() ? tensor(op.getGate()) : 0;
+  return ::tt::target::ttnn::CreateL2ClipOp(
+      *cache.fbb, tensor(op.getInput()), scale, rowScale,
+      static_cast<uint32_t>(op.getGroup()), op.getThreshold().convertToFloat(),
+      op.getEpsilon().convertToFloat(), static_cast<uint32_t>(op.getOffset()),
+      static_cast<uint32_t>(op.getWidth()),
+      cache.getOrCreateNoSharding(op.getOutput(), tensorValueToFlatbuffer,
+                                  std::nullopt),
+      gate, static_cast<uint32_t>(op.getGateOffset()));
+}
