+// Whether a reducer body is exactly `return BinaryOp(arg0, arg1)`, with the
+// arguments in either order (for commutative BinaryOp).
+template <typename BinaryOp>
+inline bool matchesBinaryReducer(Block &body) {
+  if (body.getNumArguments() != 2 || body.getOperations().size() != 2) {
+    return false;
+  }
+  auto binary = mlir::dyn_cast<BinaryOp>(body.front());
+  auto returnOp =
+      mlir::dyn_cast<::mlir::stablehlo::ReturnOp>(body.getTerminator());
+  if (!binary || !returnOp || returnOp.getNumOperands() != 1 ||
+      returnOp.getOperand(0) != binary.getResult()) {
+    return false;
+  }
+  Value lhs = body.getArgument(0);
+  Value rhs = body.getArgument(1);
+  return (binary.getLhs() == lhs && binary.getRhs() == rhs) ||
+         (binary.getLhs() == rhs && binary.getRhs() == lhs);
+}
+
