+
+  // StableHLO has one op for logical and bitwise and/or/xor: on booleans they
+  // are logical.
+  static bool isBoolean(mlir::stablehlo::ReduceOp srcOp) {
+    return llvm::all_of(srcOp->getOperands(), [](Value operand) {
+      return mlir::cast<RankedTensorType>(operand.getType())
+                 .getElementTypeBitWidth() == 1;
+    });
+  }
+
+  // Bitwise and/or/xor of integers, or xor of booleans, reduced in 32-bit
+  // integers: booleans and unsigned integers as ui32, others as si32 (exact,
+  // as bitwise ops commute with zero and sign extension). The result is then
+  // combined with the init value.
+  LogicalResult
+  matchAndRewriteBitwise(mlir::stablehlo::ReduceOp &srcOp,
+                         mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                         const mlir::Operation &innerOp,
+                         ConversionPatternRewriter &rewriter) const {
+    Location loc = srcOp.getLoc();
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResultTypes().front()));
+    auto intType = mlir::dyn_cast<IntegerType>(outputType.getElementType());
+    if (!intType) {
+      return rewriter.notifyMatchFailure(srcOp, "expected an integer reduce");
+    }
+    bool isLogical = isBoolean(srcOp);
+    Type reduceElementType = intType;
+    if (intType.getWidth() != 32) {
+      reduceElementType =
+          isLogical || intType.isUnsigned()
+              ? rewriter.getIntegerType(32, /*isSigned=*/false)
+              : rewriter.getIntegerType(32, /*isSigned=*/true);
+    }
+    auto reduceType = outputType.clone(reduceElementType);
+    Value input = castToElementType(rewriter, loc, adaptor.getInputs().front(),
+                                    reduceElementType);
+    mlir::ArrayAttr dimArg = rewriter.getI32ArrayAttr(
+        llvm::SmallVector<int32_t>(srcOp.getDimensions()));
 
+    Value result;
+    if (mlir::isa<mlir::stablehlo::AndOp>(innerOp)) {
+      result = rewriter.create<ttir::ReduceBitwiseAndOp>(
+          loc, reduceType, input, /*keep_dim=*/false, dimArg);
+    } else if (mlir::isa<mlir::stablehlo::OrOp>(innerOp)) {
+      result = rewriter.create<ttir::ReduceBitwiseOrOp>(
+          loc, reduceType, input, /*keep_dim=*/false, dimArg);
+    } else {
+      result = rewriter.create<ttir::ReduceBitwiseXorOp>(
+          loc, reduceType, input, /*keep_dim=*/false, dimArg);
+    }
+    result = castToElementType(rewriter, loc, result, intType);
+
+    Value init;
+    if (failed(ttir::utils::broadcastValue(
+            rewriter, adaptor.getInitValues().front(), outputType, init, loc,
+            /*frontUnsqueeze=*/false))) {
+      return rewriter.notifyMatchFailure(srcOp,
+                                         "init value is not broadcastable");
+    }
+    if (mlir::isa<mlir::stablehlo::AndOp>(innerOp)) {
+      rewriter.replaceOpWithNewOp<ttir::BitwiseAndOp>(srcOp, outputType,
+                                                      result, init);
+    } else if (mlir::isa<mlir::stablehlo::OrOp>(innerOp)) {
+      rewriter.replaceOpWithNewOp<ttir::BitwiseOrOp>(srcOp, outputType, result,
+                                                     init);
+    } else if (isLogical) {
+      rewriter.replaceOpWithNewOp<ttir::LogicalXorOp>(srcOp, outputType,
+                                                      result, init);
+    } else {
+      rewriter.replaceOpWithNewOp<ttir::BitwiseXorOp>(srcOp, outputType,
+                                                      result, init);
+    }
     return success();
   }
 
