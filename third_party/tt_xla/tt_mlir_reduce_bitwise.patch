+  // Whether the init value is a constant identity: all ones for and, zero for
+  // or and xor.
+  static bool hasIdentityInit(mlir::stablehlo::ReduceOp srcOp, bool allOnes) {
+    auto constant = srcOp.getInitValues()
+                        .front()
+                        .getDefiningOp<mlir::stablehlo::ConstantOp>();
+    auto init =
+        constant ? mlir::dyn_cast<DenseIntElementsAttr>(constant.getValue())
+                 : nullptr;
+    if (!init || !init.isSplat()) {
+      return false;
     }
+    APInt value = init.getSplatValue<APInt>();
+    return allOnes ? value.isAllOnes() : value.isZero();
+  }
 
+  // Bitwise and/or/xor reductions run in 32-bit integers: booleans and
+  // unsigned integers as ui32, others as si32 (exact, as bitwise ops commute
+  // with zero and sign extension). A non-identity init is combined with
+  // CombineOp before the result is narrowed back.
+  template <typename ReductionOp, typename CombineOp>
+  LogicalResult
+  matchAndRewriteBitwise(mlir::stablehlo::ReduceOp &srcOp,
+                         mlir::stablehlo::ReduceOp::Adaptor &adaptor,
+                         ConversionPatternRewriter &rewriter) const {
+    Location loc = srcOp.getLoc();
+    auto outputType = mlir::cast<RankedTensorType>(
+        getTypeConverter()->convertType(srcOp.getResultTypes().front()));
+    auto intType = mlir::dyn_cast<IntegerType>(outputType.getElementType());
+    if (!intType) {
+      return rewriter.notifyMatchFailure(srcOp, "expected an integer reduce");
+    }
+    Type reduceElementType = intType;
+    if (intType.getWidth() != 32) {
+      reduceElementType =
+          isBoolean(srcOp) || intType.isUnsigned()
+              ? rewriter.getIntegerType(32, /*isSigned=*/false)
+              : rewriter.getIntegerType(32, /*isSigned=*/true);
+    }
+    auto reduceType = outputType.clone(reduceElementType);
+    Value input = castToElementType(rewriter, loc, adaptor.getInputs().front(),
+                                    reduceElementType);
+    mlir::ArrayAttr dimArg = rewriter.getI32ArrayAttr(
+        llvm::SmallVector<int32_t>(srcOp.getDimensions()));
+    Value result = rewriter.create<ReductionOp>(loc, reduceType, input,
+                                                /*keep_dim=*/false, dimArg);
+
+    constexpr bool isAnd = std::is_same_v<CombineOp, ttir::BitwiseAndOp>;
+    if (!hasIdentityInit(srcOp, /*allOnes=*/isAnd)) {
+      Value init;
+      if (failed(ttir::utils::broadcastValue(
+              rewriter,
+              castToElementType(rewriter, loc, adaptor.getInitValues().front(),
+                                reduceElementType),
+              reduceType, init, loc, /*frontUnsqueeze=*/false))) {
+        return rewriter.notifyMatchFailure(srcOp,
+                                           "init value is not broadcastable");
+      }
+      result = rewriter.create<CombineOp>(loc, reduceType, result, init);
+    }
+    rewriter.replaceOp(srcOp,
+                       castToElementType(rewriter, loc, result, intType));
     return success();
   }
 
