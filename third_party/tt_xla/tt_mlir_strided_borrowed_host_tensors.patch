+namespace {
+// Caller memory that a borrowed host tensor stands for without aliasing it: a
+// non-contiguous view or a large buffer (createBorrowedHostTensor).
+struct StridedHostView {
+  const void *data; // The first logical element.
+  std::vector<std::uint32_t> shape;
+  std::vector<std::int64_t> stride; // In elements.
+  std::uint32_t itemsize;
+};
+
+// Strided views by the address reservation their tensor aliases.
+std::mutex stridedHostViewsMutex;
+std::unordered_map<const void *, StridedHostView> stridedHostViews;
+
+std::optional<StridedHostView>
+findStridedHostView(const ::tt::tt_metal::HostBuffer &buffer) {
+  std::lock_guard<std::mutex> lock(stridedHostViewsMutex);
+  auto it = stridedHostViews.find(buffer.view_bytes().data());
+  if (it == stridedHostViews.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+template <typename T>
+::tt::tt_metal::HostBuffer hostBufferOver(std::shared_ptr<std::byte[]> bytes,
+                                          std::uint64_t numElements) {
+  T *data = reinterpret_cast<T *>(bytes.get());
+  return ::tt::tt_metal::HostBuffer(
+      ::ttsl::Span<T>(data, data + numElements),
+      ::tt::tt_metal::MemoryPin(std::shared_ptr<void>(bytes, bytes.get())));
+}
+} // namespace
+
+// Reserves inaccessible address space the size of a view for its tensor to
+// alias, registered with the view until the tensor is gone. Readers of host
+// tensors gather the view first (utils::materializeStridedHostTensor); a
+// reader that does not faults rather than reading the wrong bytes.
+static std::shared_ptr<void>
+reserveStridedHostView(void *data, const std::vector<std::uint32_t> &shape,
+                       const std::vector<std::int64_t> &stride,
+                       std::uint32_t itemsize) {
+  const std::size_t bytes =
+      std::max<std::uint64_t>(getNumElements(shape) * itemsize, 1);
+  void *reservation = mmap(nullptr, bytes, PROT_NONE,
+                           MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+  LOG_ASSERT(reservation != MAP_FAILED,
+             "Cannot reserve address space for a strided host view");
+  // A complex tensor's trailing (real, imaginary) dimension has no stride: it
+  // is dense, as in isContiguous().
+  const std::vector<std::int64_t> viewStride =
+      stride.size() == shape.size()
+          ? stride
+          : ::tt::runtime::utils::calculateStride(shape);
+  {
+    std::lock_guard<std::mutex> lock(stridedHostViewsMutex);
+    stridedHostViews.emplace(
+        reservation, StridedHostView{data, shape, viewStride, itemsize});
+  }
+  return std::shared_ptr<void>(reservation, [bytes](void *address) {
+    {
+      std::lock_guard<std::mutex> lock(stridedHostViewsMutex);
+      stridedHostViews.erase(address);
+    }
+    munmap(address, bytes);
+  });
+}
+
+namespace utils {
+::ttnn::Tensor materializeStridedHostTensor(const ::ttnn::Tensor &tensor) {
+  if (!isOnHost(tensor.storage_type())) {
+    return tensor;
+  }
+  const ::tt::tt_metal::HostTensor &hostTensor =
+      tensor.host_storage().host_tensor();
+  bool strided = false;
+  hostTensor.buffer().apply([&](const ::tt::tt_metal::HostBuffer &shard) {
+    strided |= findStridedHostView(shard).has_value();
+  });
+  if (!strided) {
+    return tensor;
+  }
+  return ::ttnn::Tensor(hostTensor.transform(
+      [&](const ::tt::tt_metal::HostBuffer &shard) {
+        std::optional<StridedHostView> view = findStridedHostView(shard);
+        if (!view) {
+          return shard;
+        }
+        std::shared_ptr<std::byte[]> bytes = gatherContiguousBytes(
+            view->data, view->shape, view->stride, view->itemsize);
+        const std::uint64_t numElements = getNumElements(view->shape);
+        switch (tensor.dtype()) {
+        case ::ttnn::DataType::FLOAT32:
+          return hostBufferOver<float>(bytes, numElements);
+        case ::ttnn::DataType::FLOAT16:
+          return hostBufferOver<::tt::tt_metal::float16>(bytes, numElements);
+        case ::ttnn::DataType::BFLOAT16:
+          return hostBufferOver<bfloat16>(bytes, numElements);
+        case ::ttnn::DataType::UINT32:
+          return hostBufferOver<uint32_t>(bytes, numElements);
+        case ::ttnn::DataType::UINT16:
+          return hostBufferOver<uint16_t>(bytes, numElements);
+        case ::ttnn::DataType::UINT8:
+          return hostBufferOver<uint8_t>(bytes, numElements);
+        case ::ttnn::DataType::INT32:
+          return hostBufferOver<int32_t>(bytes, numElements);
+        default:
+          LOG_FATAL("Unsupported data type for a strided host view");
+        }
+      }));
+}
