+namespace {
+// While a capture program runs, the workloads its warmup enqueues before the
+// capture are compiled and have their binaries written, but do not run
+// (begin_trace_capture ends that), so the warmup changes nothing on device;
+// tt-metal can capture only workloads whose binaries are on device. Cleared
+// however the program ends.
+class PrepareWarmup {
+public:
+  explicit PrepareWarmup(::tt::tt_metal::distributed::MeshCommandQueue &cq)
+      : cq(cq) {
+    cq.set_prepare_only(true);
+  }
+  ~PrepareWarmup() { cq.set_prepare_only(false); }
+
+private:
+  ::tt::tt_metal::distributed::MeshCommandQueue &cq;
+};
+} // namespace
