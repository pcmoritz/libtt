+  bool isCapturableCase(Operation *op) {
+    auto caseOp = mlir::dyn_cast<ttcore::CaseOp>(op);
+    if (!caseOp ||
+        !llvm::all_of(caseOp.getInputs().getTypes(), isOnDeviceType) ||
+        !llvm::all_of(op->getResultTypes(), isOnDeviceType)) {
+      return false;
+    }
