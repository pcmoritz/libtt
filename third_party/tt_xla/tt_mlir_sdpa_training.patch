+// ttir.sdpa_fw and sdpa_bw to tt-train's ttnn.sdpa_fw and sdpa_bw, without
+// dropout; the forward returns its intermediates.
+class SDPAForwardOpConversionPattern
+    : public OpConversionPattern<ttir::SDPAForwardOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(ttir::SDPAForwardOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(getTypeConverter()->convertTypes(op->getResultTypes(), types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::SDPAForwardOp>(
+        op, types, adaptor.getQuery(), adaptor.getKey(), adaptor.getValue(),
+        adaptor.getAttentionMask(), op.getMaskTypeAttr(),
+        rewriter.getF32FloatAttr(0.0f), rewriter.getBoolAttr(true));
+    return success();
+  }
+};
+
+class SDPABackwardOpConversionPattern
+    : public OpConversionPattern<ttir::SDPABackwardOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(ttir::SDPABackwardOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    SmallVector<Type> types;
+    if (failed(getTypeConverter()->convertTypes(op->getResultTypes(), types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttnn::SDPABackwardOp>(
+        op, types, adaptor.getGradOutput(), adaptor.getOutput(),
+        adaptor.getQuery(), adaptor.getKey(), adaptor.getValue(),
+        adaptor.getIntermediates(), adaptor.getAttentionMask(),
+        op.getMaskTypeAttr(), rewriter.getF32FloatAttr(0.0f));
+    return success();
+  }
+};
