+def TTIR_SDPAForwardOp : TTIR_NamedOp<"sdpa_fw"> {
+  let summary = "Fused attention forward for training.";
+  let description = [{
+    `query` is [B, Hq, S, D], `key` and `value` [B, Hkv, S, D] with Hq a
+    multiple of Hkv (grouped-query attention). `output` [B, Hq, S, D] is
+    softmax(query key^T / sqrt(D)) value, unmasked, causal or, for
+    `mask_type` arbitrary, masked by `attention_mask` [1, 1, S, S] (1 keeps a
+    score, 0 drops it). `intermediates` [B, Hq, S, 32] FP32 holds each row's
+    log-sum-exp of the scaled scores in its first column, for ttir.sdpa_bw.
+    Lowers to ttnn.sdpa_fw, tt-train's ttml::metal::sdpa_fw.
+  }];
+  let arguments = (ins AnyRankedTensor:$query, AnyRankedTensor:$key,
+                       AnyRankedTensor:$value,
+                       Optional<AnyRankedTensor>:$attention_mask,
+                       TTCore_AttentionMaskTypeAttr:$mask_type);
+  let results = (outs AnyRankedTensor:$output, AnyRankedTensor:$intermediates);
+}
+
+def TTIR_SDPABackwardOp : TTIR_NamedOp<"sdpa_bw"> {
+  let summary = "Fused attention backward for training.";
+  let description = [{
+    The gradients of ttir.sdpa_fw's query, key and value given `grad_output`,
+    from the forward's `output` and `intermediates`, without recomputing the
+    forward. Lowers to ttnn.sdpa_bw, tt-train's ttml::metal::sdpa_bw.
+  }];
+  let arguments = (ins AnyRankedTensor:$grad_output, AnyRankedTensor:$output,
+                       AnyRankedTensor:$query, AnyRankedTensor:$key,
+                       AnyRankedTensor:$value, AnyRankedTensor:$intermediates,
+                       Optional<AnyRankedTensor>:$attention_mask,
+                       TTCore_AttentionMaskTypeAttr:$mask_type);
+  let results = (outs AnyRankedTensor:$grad_query, AnyRankedTensor:$grad_key,
+                      AnyRankedTensor:$grad_value);
+}
