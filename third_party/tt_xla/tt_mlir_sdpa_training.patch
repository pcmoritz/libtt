diff --git a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
--- a/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
+++ b/lib/Conversion/StableHLOToTTIR/StableHLOToTTIRPatterns.cpp
@@ -10274,6 +10274,65 @@
 
 // `tt.quantize_rows` (jax.ffi.ffi_call with min_scale and e5m2 attributes):
 // one input, the float8 output and the FP32 scale.
+// `tt.sdpa_fw` (query, key, value[, mask] -> output, intermediates) and
+// `tt.sdpa_bw` (grad_output, output, query, key, value, intermediates[, mask]
+// -> grad_query, grad_key, grad_value), jax.ffi.ffi_call with a mask_type
+// attribute (0 none, 1 causal, 2 the mask operand, as upstream's
+// tenstorrent.sdpa_fw composites): tt-train's fused attention for training,
+// see ttir.sdpa_fw.
+class StableHLOSDPATrainingConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CustomCallOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CustomCallOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    StringRef target = op.getCallTargetName();
+    const bool forward = target == "tt.sdpa_fw";
+    if (!forward && target != "tt.sdpa_bw") {
+      return failure();
+    }
+    auto backendConfig = getFfiBackendConfig(op);
+    IntegerAttr maskTypeAttr =
+        backendConfig ? backendConfig.getAs<IntegerAttr>("mask_type") : nullptr;
+    std::optional<ttcore::AttentionMaskType> maskType =
+        maskTypeAttr ? ttcore::symbolizeAttentionMaskType(
+                           static_cast<uint32_t>(maskTypeAttr.getInt()))
+                     : std::nullopt;
+    if (!maskType) {
+      return op.emitOpError()
+             << target << " needs a mask_type attribute: 0, 1 or 2";
+    }
+    const unsigned tensors = forward ? 3u : 6u;
+    const bool masked = *maskType == ttcore::AttentionMaskType::Arbitrary;
+    if (op.getNumOperands() != tensors + (masked ? 1u : 0u) ||
+        op.getNumResults() != (forward ? 2u : 3u)) {
+      return op.emitOpError()
+             << target << " takes " << tensors
+             << " operands, and a mask when mask_type is 2, and returns "
+             << (forward ? 2 : 3) << " results";
+    }
+    SmallVector<Type> types;
+    if (failed(getTypeConverter()->convertTypes(op.getResultTypes(), types))) {
+      return failure();
+    }
+    ValueRange operands = adaptor.getOperands();
+    Value mask = masked ? operands[tensors] : Value();
+    auto maskTypeAttribute =
+        ttcore::AttentionMaskTypeAttr::get(rewriter.getContext(), *maskType);
+    if (forward) {
+      rewriter.replaceOpWithNewOp<ttir::SDPAForwardOp>(
+          op, types, operands[0], operands[1], operands[2], mask,
+          maskTypeAttribute);
+    } else {
+      rewriter.replaceOpWithNewOp<ttir::SDPABackwardOp>(
+          op, types, operands[0], operands[1], operands[2], operands[3],
+          operands[4], operands[5], mask, maskTypeAttribute);
+    }
+    return success();
+  }
+};
