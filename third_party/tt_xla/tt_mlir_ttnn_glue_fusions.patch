+// A binary op applies fused activations to its operands as they are unpacked,
+// which for an activation of an input requires that operand's format to share
+// its exponent format with the others: keep the fusion to BF16 and FP32
+// tensors.
+static bool hasActivationFusibleType(Value value) {
+  auto type = mlir::dyn_cast<mlir::RankedTensorType>(value.getType());
+  return type && (type.getElementType().isBF16() || type.getElementType().isF32());
+}
+
+static bool allActivationFusibleTypes(Operation *op) {
+  return llvm::all_of(op->getOperands(), hasActivationFusibleType) &&
+         llvm::all_of(op->getResults(), hasActivationFusibleType);
+}
+
+static mlir::Type elementTypeOf(Value value) {
+  return mlir::cast<mlir::RankedTensorType>(value.getType()).getElementType();
+}
