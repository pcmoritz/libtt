+// `tt.quantize_rows` (jax.ffi.ffi_call with min_scale and e5m2 attributes):
+// one input, the float8 output and the FP32 scale.
+class StableHLOQuantizeRowsConversionPattern
+    : public OpConversionPattern<mlir::stablehlo::CustomCallOp> {
+public:
+  using OpConversionPattern::OpConversionPattern;
+  LogicalResult
+  matchAndRewrite(mlir::stablehlo::CustomCallOp op, OpAdaptor adaptor,
+                  ConversionPatternRewriter &rewriter) const override {
+    if (op.getCallTargetName() != "tt.quantize_rows") {
+      return failure();
+    }
+    if (op.getNumOperands() != 1 || op.getNumResults() != 2) {
+      return op.emitOpError("tt.quantize_rows takes one input and returns two results");
+    }
+    auto backendConfig = getFfiBackendConfig(op);
+    FloatAttr minScale =
+        backendConfig ? backendConfig.getAs<FloatAttr>("min_scale") : nullptr;
+    if (!minScale) {
+      return op.emitOpError("tt.quantize_rows needs a float min_scale attribute");
+    }
+    BoolAttr e5m2 = backendConfig.getAs<BoolAttr>("e5m2");
+    SmallVector<Type> types;
+    if (failed(getTypeConverter()->convertTypes(op.getResultTypes(), types))) {
+      return failure();
+    }
+    rewriter.replaceOpWithNewOp<ttir::QuantizeRowsOp>(
+        op, types, adaptor.getOperands()[0],
+        rewriter.getF32FloatAttr(minScale.getValueAsDouble()),
+        ttcore::DataTypeAttr::get(rewriter.getContext(),
+                                  e5m2 && e5m2.getValue()
+                                      ? ttcore::DataType::Float8E5M2
+                                      : ttcore::DataType::Float8E4M3FN));
+    return success();
+  }
+};
