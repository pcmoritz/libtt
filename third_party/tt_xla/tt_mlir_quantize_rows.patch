+// Fuses the float8 quantization of a decode norm's output into the norm's
+// program, which still returns the norm (Qwen3.8's gated DeltaNet layers also
+// read it in BF16):
+//   norm, sum = rms_norm_residual(x, r, w); q, scale = quantize_rows(norm)
+//   -> norm, sum, q, scale = rms_norm_residual(x, r, w)
+class RMSNormResidualQuantizeFusionPattern
+    : public mlir::OpRewritePattern<QuantizeRowsOp> {
+public:
+  using mlir::OpRewritePattern<QuantizeRowsOp>::OpRewritePattern;
+
+  mlir::LogicalResult
+  matchAndRewrite(QuantizeRowsOp op,
+                  mlir::PatternRewriter &rewriter) const override {
+    auto norm = op.getInput().getDefiningOp<RMSNormResidualOp>();
+    if (!norm || op.getInput() != norm.getOutput() ||
+        !norm.getQuantized().empty() ||
+        !norm.getOutput().getType().getElementType().isBF16()) {
+      return failure();
+    }
+    rewriter.setInsertionPoint(norm);
+    auto fused = rewriter.create<RMSNormResidualOp>(
+        norm.getLoc(),
+        TypeRange{norm.getOutput().getType(), norm.getSum().getType(),
+                  op.getOutput().getType(), op.getScale().getType()},
+        norm.getInput(), norm.getResidual(), norm.getWeight(),
+        norm.getEpsilonAttr(), norm.getWeightOffsetAttr(),
+        op.getFloat8TypeAttr(), op.getMinScaleAttr());
+    rewriter.replaceOp(op, fused.getQuantized());
+    rewriter.replaceOp(norm, ValueRange{fused.getOutput(), fused.getSum()});
+    return success();
+  }
+};
 
