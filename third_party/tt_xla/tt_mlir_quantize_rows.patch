+  scale.tensorDataTypeWorkaround = ttcore::DataType::Float32;
+  return TTNNOperandsWorkarounds::createEmptyTTNNOperandsWorkarounds()
+      .addInputOperandWorkaround(input)
+      .addOutputOperandWorkaround(output)
+      .addOutputOperandWorkaround(scale);
