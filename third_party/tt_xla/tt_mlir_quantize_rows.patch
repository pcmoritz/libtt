+    // Rewrite 2: a tt.* custom_call with one tuple result becomes a
+    // custom_call with the tuple's tensors as results. torch_tpu passes its
+    // JAX kernels through XLA HLO, where a multi-output custom call is
+    // tuple-shaped; the tt.* conversions take the multi-result form.
+    SmallVector<mlir::stablehlo::CustomCallOp> tupleCalls;
+    getOperation().walk([&](mlir::stablehlo::CustomCallOp op) {
+      if (!op.getCallTargetName().starts_with("tt.") ||
+          op.getNumResults() != 1) {
+        return;
+      }
+      auto tupleType = dyn_cast<TupleType>(op.getResult(0).getType());
+      if (!tupleType ||
+          !llvm::all_of(tupleType.getTypes(), llvm::IsaPred<RankedTensorType>) ||
+          !llvm::all_of(op.getResult(0).getUsers(),
+                        llvm::IsaPred<mlir::stablehlo::GetTupleElementOp>)) {
+        return;
+      }
+      tupleCalls.push_back(op);
+    });
+    for (auto op : tupleCalls) {
+      auto tupleType = cast<TupleType>(op.getResult(0).getType());
+      rewriter.setInsertionPoint(op);
+      auto split = rewriter.create<mlir::stablehlo::CustomCallOp>(
+          op.getLoc(), tupleType.getTypes(), op.getOperands(), op->getAttrs());
+      if (auto layouts = split.getResultLayouts();
+          layouts && layouts->size() != tupleType.size()) {
+        split.removeResultLayoutsAttr();
+      }
+      for (OpOperand &use :
+           llvm::make_early_inc_range(op.getResult(0).getUses())) {
+        auto getTupleOp =
+            cast<mlir::stablehlo::GetTupleElementOp>(use.getOwner());
+        rewriter.replaceOp(getTupleOp,
+                           split.getResult(getTupleOp.getIndex()));
+      }
+      rewriter.eraseOp(op);
+    }
   }
 };
