diff --git a/lib/Dialect/TTNN/IR/TTNNWorkaroundsPass.cpp b/lib/Dialect/TTNN/IR/TTNNWorkaroundsPass.cpp
--- a/lib/Dialect/TTNN/IR/TTNNWorkaroundsPass.cpp
+++ b/lib/Dialect/TTNN/IR/TTNNWorkaroundsPass.cpp
@@ -434,2 +434,36 @@ TTNNOperandsWorkaroundsFactory::createReshapeOpOperandsWorkarounds(
 }
+
+TTNNOperandsWorkarounds
+TTNNOperandsWorkaroundsFactory::createConcatOpOperandsWorkarounds(
+    mlir::Operation::operand_range inputs, int64_t dim) {
+  auto inputType = mlir::cast<RankedTensorType>(inputs.front().getType());
+  int64_t rank = inputType.getRank();
+  dim = dim < 0 ? dim + rank : dim;
+
+  bool hasPartialTile = false;
+  if (dim == rank - 1) {
+    constexpr int64_t tileWidth = ttcore::TileType::getDefaultShape()[1];
+    for (Value input : inputs) {
+      auto type = mlir::cast<RankedTensorType>(input.getType());
+      if (type.getDimSize(dim) % tileWidth != 0) {
+        hasPartialTile = true;
+        break;
+      }
+    }
+  }
+
+  if (!hasPartialTile) {
+    return TTNNOperandsWorkarounds::createEmptyTTNNOperandsWorkarounds(
+        inputs.size(), /*outputSize=*/1);
+  }
+
+  TTNNOperandWorkarounds workaround;
+  workaround.tensorLayoutWorkaround = Layout::RowMajor;
+  auto workarounds = TTNNOperandsWorkarounds::
+      createEmptyTTNNOperandsWorkarounds();
+  for (size_t i = 0; i < inputs.size(); ++i) {
+    workarounds.addInputOperandWorkaround(workaround);
+  }
+  return workarounds.addOutputOperandWorkaround(workaround);
+}
 
