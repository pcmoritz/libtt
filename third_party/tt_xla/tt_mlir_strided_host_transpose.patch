+// One round of an 8x8 transpose: interleaves vector i with vector i + 4 at the
+// lane width of `d`, into positions 2i (low halves) and 2i + 1 (high halves).
+template <class D, class V>
+static inline void interleaveRound(D d, V (&v)[8]) {
+  const hn::Repartition<std::uint64_t, D> d64;
+  V t[8];
+  HWY_UNROLL(4)
+  for (int i = 0; i < 4; ++i) {
+    const auto a = hn::BitCast(d, v[i]);
+    const auto b = hn::BitCast(d, v[i + 4]);
+    t[2 * i] = hn::BitCast(d64, hn::InterleaveLower(d, a, b));
+    t[2 * i + 1] = hn::BitCast(d64, hn::InterleaveUpper(d, a, b));
+  }
+  HWY_UNROLL(8)
+  for (int i = 0; i < 8; ++i) {
+    v[i] = t[i];
+  }
+}
+
+// Transposes an 8x8 block of 16-bit values: reads 8 source columns of 8
+// contiguous rows each, writes 8 output rows of 8 columns each. Rounds of 16,
+// 32 and 64-bit interleaves transpose rows loaded in bit-reversed order.
+static inline void transpose8x8(const std::uint16_t *src, std::int64_t srcStride,
+                                std::uint16_t *dst, std::int64_t dstStride) {
+  constexpr int kBitReversed[8] = {0, 4, 2, 6, 1, 5, 3, 7};
+  const hn::FixedTag<std::uint16_t, 8> d16;
+  const hn::Repartition<std::uint32_t, decltype(d16)> d32;
+  const hn::Repartition<std::uint64_t, decltype(d16)> d64;
+  hn::Vec<decltype(d64)> v[8];
+  HWY_UNROLL(8)
+  for (int i = 0; i < 8; ++i) {
+    v[i] = hn::BitCast(d64, hn::LoadU(d16, src + kBitReversed[i] * srcStride));
+  }
+  interleaveRound(d16, v);
+  interleaveRound(d32, v);
+  interleaveRound(d64, v);
+  HWY_UNROLL(8)
+  for (int i = 0; i < 8; ++i) {
+    hn::StoreU(hn::BitCast(d16, v[i]), d16, dst + i * dstStride);
+  }
+}
