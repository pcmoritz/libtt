+// Transposes a column-major 16-bit matrix (element (r, c) at
+// src[r + c * colStride]) into row-major `out`, in 64x64 tiles of 8x8 blocks,
+// on up to eight threads. Within a tile, each group of 8 output rows is written
+// left to right, in 128-byte runs per row. `rows` and `cols` must be multiples
+// of 8.
+static void transpose16(const std::uint16_t *src, std::int64_t colStride,
+                        std::uint16_t *out, std::int64_t rows,
+                        std::int64_t cols) {
+  constexpr std::int64_t kTile = 64;
+  // Tiles start at 128-byte source boundaries when the source is 16-byte
+  // aligned (the first tile is shorter), so each tile reads whole cache lines.
+  const auto address = reinterpret_cast<std::uintptr_t>(src);
+  const std::int64_t head =
+      address % 16 == 0 ? (128 - address % 128) % 128 / 2 : 0;
+  const auto copyRows = [&](std::int64_t rowBegin, std::int64_t rowEnd) {
+    for (std::int64_t r0 = rowBegin; r0 < rowEnd;) {
+      const std::int64_t r1 = std::min(
+          r0 < head ? head : head + (r0 - head) / kTile * kTile + kTile, rowEnd);
+      for (std::int64_t c0 = 0; c0 < cols; c0 += kTile) {
+        for (std::int64_t r = r0; r < r1; r += 8) {
+          for (std::int64_t c = c0; c < std::min(c0 + kTile, cols); c += 8) {
+            transpose8x8(src + r + c * colStride, colStride,
+                         out + r * cols + c, cols);
+          }
+        }
+      }
+      r0 = r1;
+    }
+  };
+
+  // At least 4M elements (8 MB) per thread; row bands stay multiples of 8.
+  const std::int64_t numThreads =
+      std::clamp<std::int64_t>(rows * cols / (4 << 20), 1, 8);
+  if (numThreads == 1) {
+    copyRows(0, rows);
+    return;
+  }
+  std::vector<std::thread> threads;
+  for (std::int64_t t = 0; t < numThreads; ++t) {
+    threads.emplace_back(copyRows, rows * t / numThreads / 8 * 8,
+                         rows * (t + 1) / numThreads / 8 * 8);
+  }
+  for (std::thread &thread : threads) {
+    thread.join();
+  }
+}
