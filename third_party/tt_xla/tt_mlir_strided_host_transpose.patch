+// Transposes an 8x8 block of 16-bit values: reads 8 source columns of 8
+// contiguous rows each, writes 8 output rows of 8 columns each. 16-bit, then
+// 32-bit, then 64-bit interleaves of 128-bit vectors do the transpose.
+static inline void transpose8x8(const std::uint16_t *src, std::int64_t srcStride,
+                                std::uint16_t *dst, std::int64_t dstStride) {
+  const hn::FixedTag<std::uint16_t, 8> d16;
+  const hn::Repartition<std::uint32_t, decltype(d16)> d32;
+  const hn::Repartition<std::uint64_t, decltype(d16)> d64;
+  const auto a0 = hn::LoadU(d16, src + 0 * srcStride);
+  const auto a1 = hn::LoadU(d16, src + 1 * srcStride);
+  const auto a2 = hn::LoadU(d16, src + 2 * srcStride);
+  const auto a3 = hn::LoadU(d16, src + 3 * srcStride);
+  const auto a4 = hn::LoadU(d16, src + 4 * srcStride);
+  const auto a5 = hn::LoadU(d16, src + 5 * srcStride);
+  const auto a6 = hn::LoadU(d16, src + 6 * srcStride);
+  const auto a7 = hn::LoadU(d16, src + 7 * srcStride);
+  const auto b0 = hn::BitCast(d32, hn::InterleaveLower(d16, a0, a1));
+  const auto b1 = hn::BitCast(d32, hn::InterleaveUpper(d16, a0, a1));
+  const auto b2 = hn::BitCast(d32, hn::InterleaveLower(d16, a2, a3));
+  const auto b3 = hn::BitCast(d32, hn::InterleaveUpper(d16, a2, a3));
+  const auto b4 = hn::BitCast(d32, hn::InterleaveLower(d16, a4, a5));
+  const auto b5 = hn::BitCast(d32, hn::InterleaveUpper(d16, a4, a5));
+  const auto b6 = hn::BitCast(d32, hn::InterleaveLower(d16, a6, a7));
+  const auto b7 = hn::BitCast(d32, hn::InterleaveUpper(d16, a6, a7));
+  const auto c0 = hn::BitCast(d64, hn::InterleaveLower(d32, b0, b2));
+  const auto c1 = hn::BitCast(d64, hn::InterleaveUpper(d32, b0, b2));
+  const auto c2 = hn::BitCast(d64, hn::InterleaveLower(d32, b1, b3));
+  const auto c3 = hn::BitCast(d64, hn::InterleaveUpper(d32, b1, b3));
+  const auto c4 = hn::BitCast(d64, hn::InterleaveLower(d32, b4, b6));
+  const auto c5 = hn::BitCast(d64, hn::InterleaveUpper(d32, b4, b6));
+  const auto c6 = hn::BitCast(d64, hn::InterleaveLower(d32, b5, b7));
+  const auto c7 = hn::BitCast(d64, hn::InterleaveUpper(d32, b5, b7));
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveLower(d64, c0, c4)), d16,
+             dst + 0 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveUpper(d64, c0, c4)), d16,
+             dst + 1 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveLower(d64, c1, c5)), d16,
+             dst + 2 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveUpper(d64, c1, c5)), d16,
+             dst + 3 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveLower(d64, c2, c6)), d16,
+             dst + 4 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveUpper(d64, c2, c6)), d16,
+             dst + 5 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveLower(d64, c3, c7)), d16,
+             dst + 6 * dstStride);
+  hn::StoreU(hn::BitCast(d16, hn::InterleaveUpper(d64, c3, c7)), d16,
+             dst + 7 * dstStride);
+}
