+// Copies a transposed view into `out`: the last two dimensions are gathered
+// with a cache-blocked transpose (source stride 1 along dimension -2), in
+// parallel over row blocks. Outer dimensions may have any stride.
+template <typename T>
+static void gatherTransposed(const T *src, T *out,
+                             const std::vector<std::uint32_t> &shape,
+                             const std::vector<std::int64_t> &stride) {
+  constexpr std::int64_t kBlock = 64;
+  const size_t numDims = shape.size();
+  const std::int64_t rows = shape[numDims - 2];
+  const std::int64_t cols = shape[numDims - 1];
+  const std::int64_t colStride = stride[numDims - 1];
+  const std::int64_t rowBlocks = (rows + kBlock - 1) / kBlock;
+  std::int64_t numOuter = 1;
+  for (size_t d = 0; d + 2 < numDims; ++d) {
+    numOuter *= shape[d];
+  }
+
+  const auto copyTasks = [&](std::int64_t begin, std::int64_t end) {
+    for (std::int64_t task = begin; task < end; ++task) {
+      std::int64_t outer = task / rowBlocks;
+      const std::int64_t r0 = (task % rowBlocks) * kBlock;
+      const std::int64_t r1 = std::min(r0 + kBlock, rows);
+      std::int64_t srcOffset = 0;
+      for (size_t d = numDims - 2; d-- > 0;) {
+        srcOffset += (outer % shape[d]) * stride[d];
+        outer /= shape[d];
+      }
+      const T *matrix = src + srcOffset;
+      T *dst = out + (task / rowBlocks) * rows * cols;
+      for (std::int64_t c0 = 0; c0 < cols; c0 += kBlock) {
+        const std::int64_t c1 = std::min(c0 + kBlock, cols);
+#if defined(__SSE2__)
+        if constexpr (sizeof(T) == 2) {
+          if (r1 - r0 == kBlock && c1 - c0 == kBlock) {
+            for (std::int64_t c = c0; c < c1; c += 8) {
+              for (std::int64_t r = r0; r < r1; r += 8) {
+                transpose8x8(reinterpret_cast<const std::uint16_t *>(
+                                 matrix + r + c * colStride),
+                             colStride,
+                             reinterpret_cast<std::uint16_t *>(dst + r * cols + c),
+                             cols);
+              }
+            }
+            continue;
+          }
+        }
+#endif
+        for (std::int64_t c = c0; c < c1; ++c) {
+          const T *column = matrix + c * colStride;
+          for (std::int64_t r = r0; r < r1; ++r) {
+            dst[r * cols + c] = column[r];
+          }
+        }
+      }
+    }
+  };
+
+  const std::int64_t numTasks = numOuter * rowBlocks;
+  constexpr std::int64_t minBytesPerThread = 8 << 20;
+  const std::int64_t bytes = numOuter * rows * cols * sizeof(T);
+  const std::int64_t numThreads = std::max<std::int64_t>(
+      1, std::min<std::int64_t>({std::thread::hardware_concurrency(), 8,
+                                 bytes / minBytesPerThread, numTasks}));
+  if (numThreads == 1) {
+    copyTasks(0, numTasks);
+    return;
+  }
+  std::vector<std::thread> threads;
+  threads.reserve(numThreads);
+  for (std::int64_t t = 0; t < numThreads; ++t) {
+    threads.emplace_back(copyTasks, numTasks * t / numThreads,
+                         numTasks * (t + 1) / numThreads);
+  }
+  for (std::thread &thread : threads) {
+    thread.join();
+  }
+}
