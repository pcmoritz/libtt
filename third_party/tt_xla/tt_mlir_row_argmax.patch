diff --git a/lib/Dialect/TTNN/IR/TTNNRowArgMax.cpp b/lib/Dialect/TTNN/IR/TTNNRowArgMax.cpp
new file mode 100644
--- /dev/null
+++ b/lib/Dialect/TTNN/IR/TTNNRowArgMax.cpp
@@ -0,0 +1,100 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+// The argmax of rows of one tile row, which libtt's row argmax scans tiled,
+// and the canonicalization that folds a maximum of its input with a constant
+// into its floor (torch_tpu's argmax reduces from the lowest finite float).
+
+#include "ttmlir/Dialect/TTCore/IR/TTCoreOps.h"
+#include "ttmlir/Dialect/TTNN/IR/TTNNOps.h"
+
+#include "mlir/Dialect/Func/IR/FuncOps.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/PatternMatch.h"
+
+#include <optional>
+#include <utility>
+
+namespace mlir::tt::ttnn {
+namespace {
+
+// The value of every element of `value`: a full, also inside the const-eval
+// function a load_cached calls.
+std::optional<float> splatValue(Value value) {
+  if (auto load = value.getDefiningOp<ttcore::LoadCachedOp>()) {
+    auto module = load->getParentOfType<ModuleOp>();
+    auto callee =
+        module ? module.lookupSymbol<func::FuncOp>(load.getCallee()) : nullptr;
+    if (!callee || callee.getBody().empty()) {
+      return std::nullopt;
+    }
+    auto ret = dyn_cast<func::ReturnOp>(callee.getBody().back().getTerminator());
+    const unsigned index = mlir::cast<OpResult>(value).getResultNumber();
+    if (!ret || index >= ret.getNumOperands()) {
+      return std::nullopt;
+    }
+    value = ret.getOperand(index);
+  }
+  if (auto full = value.getDefiningOp<FullOp>()) {
+    if (auto attr = mlir::dyn_cast<FloatAttr>(full.getFillValue())) {
+      return attr.getValue().convertToFloat();
+    }
+  }
+  return std::nullopt;
+}
+
+} // namespace
+
+bool ArgMaxOp::isTiledRowArgMax(RankedTensorType input,
+                                std::optional<int32_t> dim) {
+  const int64_t rank = input.getRank();
+  if (rank < 2 || !dim || (*dim != -1 && *dim != rank - 1)) {
+    return false;
+  }
+  Type element = input.getElementType();
+  if (!element.isBF16() && !element.isF32()) {
+    return false;
+  }
+  ArrayRef<int64_t> shape = input.getShape();
+  for (int64_t size : shape.drop_back(2)) {
+    if (size != 1) {
+      return false;
+    }
+  }
+  return shape[rank - 2] >= 1 && shape[rank - 2] <= 32 &&
+         shape[rank - 1] > 0 && shape[rank - 1] % 32 == 0;
+}
+
+void ArgMaxOp::getCanonicalizationPatterns(RewritePatternSet &patterns,
+                                           MLIRContext *context) {
+  // argmax(maximum(x, c)) with every element of c equal: argmax(x) with floor
+  // c, which keeps index 0 where no element of x exceeds c, as the maximum's
+  // ties do.
+  // NOLINTBEGIN(clang-analyzer-core.StackAddressEscape)
+  patterns.add(+[](ArgMaxOp op, PatternRewriter &rewriter) {
+    auto maximum = op.getInput().getDefiningOp<MaximumOp>();
+    if (op.getFloor() || !maximum || !maximum->hasOneUse()) {
+      return failure();
+    }
+    for (auto [x, c] : {std::pair(maximum.getLhs(), maximum.getRhs()),
+                        std::pair(maximum.getRhs(), maximum.getLhs())}) {
+      auto type = mlir::cast<RankedTensorType>(x.getType());
+      std::optional<float> floor = splatValue(c);
+      if (type.getShape() != op.getInput().getType().getShape() || !floor ||
+          !isTiledRowArgMax(type, op.getDim())) {
+        continue;
+      }
+      Value input = x;
+      FloatAttr floorAttr = rewriter.getF32FloatAttr(*floor);
+      rewriter.modifyOpInPlace(op, [&] {
+        op.getInputMutable().set(input);
+        op.setFloorAttr(floorAttr);
+      });
+      return success();
+    }
+    return failure();
+  });
+  // NOLINTEND(clang-analyzer-core.StackAddressEscape)
+}
+
+} // namespace mlir::tt::ttnn
