+
+void PjrtTensor::update_host_staged_bytes() {
+  // Buffers in host memory are not device memory, wherever their data is.
+  auto shard = std::find_if(m_shards.begin(), m_shards.end(),
+                            [](BufferInstance *s) { return s != nullptr; });
+  const bool in_device_memory =
+      shard != m_shards.end() &&
+      ((*shard)->getMemory() == nullptr ||
+       !(*shard)->getMemory()->isHostMemory());
+
+  std::int64_t bytes = 0;
+  if (in_device_memory && m_runtime_tensor.has_value()) {
+    if (tt::runtime::isTensorOnHost(*m_runtime_tensor)) {
+      bytes = static_cast<std::int64_t>(
+                  tt::runtime::getTensorVolume(*m_runtime_tensor)) *
+              tt::runtime::getTensorElementSize(*m_runtime_tensor);
+    }
+  } else if (in_device_memory && m_host_tensor_shell.has_value()) {
+    bytes = std::accumulate(m_host_tensor_shell->shape.begin(),
+                            m_host_tensor_shell->shape.end(),
+                            std::int64_t{m_host_tensor_shell->element_size},
+                            std::multiplies<std::int64_t>());
+  }
+
+  const std::int64_t now =
+      g_host_staged_bytes.fetch_add(bytes - m_host_staged_bytes) + bytes -
+      m_host_staged_bytes;
+  m_host_staged_bytes = bytes;
+  std::int64_t peak = g_peak_host_staged_bytes;
+  while (now > peak &&
+         !g_peak_host_staged_bytes.compare_exchange_weak(peak, now)) {
+  }
+}
