+void PjrtTensor::update_host_staged_bytes() {
+  const bool staged = m_runtime_tensor.has_value()
+                          ? tt::runtime::isTensorOnHost(*m_runtime_tensor)
+                          : m_host_tensor_shell.has_value();
+  std::vector<std::pair<DeviceInstance *, std::int64_t>> bytes;
+  for (BufferInstance *shard : m_shards) {
+    // Buffers in host memory are not device memory, wherever their data is.
+    if (staged && shard != nullptr && shard->getDevice() != nullptr &&
+        (shard->getMemory() == nullptr ||
+         !shard->getMemory()->isHostMemory())) {
+      bytes.emplace_back(shard->getDevice(),
+                         static_cast<std::int64_t>(shard->logicalTensorSize()));
+    }
+  }
+  for (auto [device, count] : m_host_staged_bytes) {
+    device->addHostStagedBytes(-count);
+  }
+  for (auto [device, count] : bytes) {
+    device->addHostStagedBytes(count);
+  }
+  m_host_staged_bytes = std::move(bytes);
+}
