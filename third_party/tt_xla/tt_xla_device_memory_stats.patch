+PJRT_Error *onDeviceGetAttributes(PJRT_Device_GetAttributes_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "DeviceInstance::PJRT_Device_GetAttributes");
+
+  const auto &attributes =
+      DeviceInstance::unwrap(args->device)->getDeviceDescription().getAttributes();
+  args->attributes = attributes.data();
+  args->num_attributes = attributes.size();
+  // The device description owns these attributes for the client's lifetime.
+  args->device_attributes = nullptr;
+  args->attributes_deleter = [](PJRT_Device_Attributes *) {};
+  return nullptr;
+}
+
+PJRT_Error *onDeviceMemoryStats(PJRT_Device_MemoryStats_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "DeviceInstance::PJRT_Device_MemoryStats");
+
+  const uint64_t dram_size_bytes =
+      DeviceInstance::unwrap(args->device)->getDramSizeBytes();
+
+  // DRAM allocated on the open mesh, plus the device buffers whose data stays
+  // on the host until a program uses them: they take that DRAM then. Their
+  // peaks add up to a bound of the peak of the sum. Nothing caches freed
+  // memory, so none is reserved beyond what is in use.
+  int64_t bytes_in_use = PjrtTensor::host_staged_bytes();
+  int64_t peak_bytes_in_use = PjrtTensor::peak_host_staged_bytes();
+  std::optional<int64_t> largest_free_block_bytes;
+  ClientInstance *client = GlobalClientInstanceSingleton::getClientInstance();
+  if (client && client->parentMesh()) {
+    auto views = tt::runtime::getMemoryView(*client->parentMesh());
+    auto dram = views.find(tt::runtime::MemoryBufferType::DRAM);
+    if (dram != views.end()) {
+      const tt::runtime::MemoryView &view = dram->second;
+      bytes_in_use += view.numBanks * view.totalBytesAllocatedPerBank;
+      peak_bytes_in_use += view.numBanks * view.peakBytesAllocatedPerBank;
+      largest_free_block_bytes =
+          view.numBanks * view.largestContiguousBytesFreePerBank;
+    }
+  }
+
+  args->bytes_in_use = bytes_in_use;
+  args->peak_bytes_in_use = peak_bytes_in_use;
+  args->peak_bytes_in_use_is_set = true;
+  args->num_allocs = 0;
+  args->num_allocs_is_set = false;
+  args->largest_alloc_size = 0;
+  args->largest_alloc_size_is_set = false;
+  args->bytes_limit = static_cast<int64_t>(dram_size_bytes);
+  args->bytes_limit_is_set = dram_size_bytes > 0;
+  args->bytes_reserved = 0;
+  args->bytes_reserved_is_set = true;
+  args->peak_bytes_reserved = 0;
+  args->peak_bytes_reserved_is_set = true;
+  args->bytes_reservable_limit = 0;
+  args->bytes_reservable_limit_is_set = false;
+  args->largest_free_block_bytes = largest_free_block_bytes.value_or(0);
+  args->largest_free_block_bytes_is_set = largest_free_block_bytes.has_value();
+  args->pool_bytes = 0;
+  args->pool_bytes_is_set = false;
+  args->peak_pool_bytes = 0;
+  args->peak_pool_bytes_is_set = false;
+  args->peak_allocated_bytes = peak_bytes_in_use;
+  args->peak_allocated_bytes_is_set = true;
+
+  return nullptr;
+}
+
+PJRT_Error *onDeviceClearMemoryStats(PJRT_Device_ClearMemoryStats_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "DeviceInstance::PJRT_Device_ClearMemoryStats");
+
+  // The peaks restart from what is in use now.
+  PjrtTensor::reset_peak_host_staged_bytes();
+  ClientInstance *client = GlobalClientInstanceSingleton::getClientInstance();
+  if (client && client->parentMesh()) {
+    tt::runtime::resetMemoryPeaks(*client->parentMesh());
+  }
+  return nullptr;
+}
+
 } // namespace internal
 
