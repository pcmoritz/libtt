diff --git a/pjrt_implementation/inc/api/device_instance.h b/pjrt_implementation/inc/api/device_instance.h
--- a/pjrt_implementation/inc/api/device_instance.h
+++ b/pjrt_implementation/inc/api/device_instance.h
@@ -67,2 +67,5 @@ public:
 
+  // Returns total on-device DRAM in bytes, or 0 if unknown.
+  uint64_t getDramSizeBytes() const { return m_dram_size_bytes; }
+
   // Sets process index from which this device is addressable.
@@ -96,3 +99,3 @@ private:
         m_is_addressable(is_addressable), m_local_device_id(local_device_id),
-        m_default_memory(nullptr) {}
+        m_default_memory(nullptr), m_dram_size_bytes(dram_size_bytes) {}
 
@@ -117,2 +120,5 @@ private:
   MemoryInstance *m_default_memory;
+
+  // Total on-device DRAM in bytes, or 0 if unknown.
+  uint64_t m_dram_size_bytes;
 };
@@ -137,2 +143,8 @@ PJRT_Error *onDeviceDefaultMemory(PJRT_Device_DefaultMemory_Args *args);
 
+// Implements PJRT_Device_MemoryStats API function.
+PJRT_Error *onDeviceMemoryStats(PJRT_Device_MemoryStats_Args *args);
+
+// Implements PJRT_Device_ClearMemoryStats API function.
+PJRT_Error *onDeviceClearMemoryStats(PJRT_Device_ClearMemoryStats_Args *args);
+
 } // namespace internal
diff --git a/pjrt_implementation/src/api/device_instance.cc b/pjrt_implementation/src/api/device_instance.cc
--- a/pjrt_implementation/src/api/device_instance.cc
+++ b/pjrt_implementation/src/api/device_instance.cc
@@ -43,2 +43,4 @@ void DeviceInstance::bindApi(PJRT_Api *api) {
   api->PJRT_Device_DefaultMemory = internal::onDeviceDefaultMemory;
+  api->PJRT_Device_MemoryStats = internal::onDeviceMemoryStats;
+  api->PJRT_Device_ClearMemoryStats = internal::onDeviceClearMemoryStats;
 }
@@ -98,2 +100,40 @@ PJRT_Error *onDeviceDefaultMemory(PJRT_Device_DefaultMemory_Args *args) {
 
+PJRT_Error *onDeviceMemoryStats(PJRT_Device_MemoryStats_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "DeviceInstance::PJRT_Device_MemoryStats");
+
+  const uint64_t dram_size_bytes =
+      DeviceInstance::unwrap(args->device)->getDramSizeBytes();
+
+  args->bytes_in_use = 0;
+  args->peak_bytes_in_use = 0;
+  args->peak_bytes_in_use_is_set = false;
+  args->num_allocs = 0;
+  args->num_allocs_is_set = false;
+  args->largest_alloc_size = 0;
+  args->largest_alloc_size_is_set = false;
+  args->bytes_limit = static_cast<int64_t>(dram_size_bytes);
+  args->bytes_limit_is_set = dram_size_bytes > 0;
+  args->bytes_reserved = 0;
+  args->bytes_reserved_is_set = false;
+  args->peak_bytes_reserved = 0;
+  args->peak_bytes_reserved_is_set = false;
+  args->bytes_reservable_limit = 0;
+  args->bytes_reservable_limit_is_set = false;
+  args->largest_free_block_bytes = 0;
+  args->largest_free_block_bytes_is_set = false;
+  args->pool_bytes = 0;
+  args->pool_bytes_is_set = false;
+  args->peak_pool_bytes = 0;
+  args->peak_pool_bytes_is_set = false;
+
+  return nullptr;
+}
+
+PJRT_Error *onDeviceClearMemoryStats(PJRT_Device_ClearMemoryStats_Args *args) {
+  ZoneScoped;
+  DLOG_F(LOG_DEBUG, "DeviceInstance::PJRT_Device_ClearMemoryStats");
+  return nullptr;
+}
+
 } // namespace internal
