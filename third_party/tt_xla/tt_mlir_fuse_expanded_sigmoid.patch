+// jax.nn.sigmoid reaches StableHLO expanded under explicit sharding, as
+// 1 / (1 + exp(-x)). One sigmoid replaces the negate, exp, add and divide (a
+// gated attention output multiplies by one per layer). x * sigmoid(x) still
+// becomes silu: SiluFusionPattern matches a single-use sigmoid.
+class ExpandedSigmoidFusionPattern : public mlir::OpRewritePattern<DivOp> {
+  using mlir::OpRewritePattern<DivOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(DivOp divOp, mlir::PatternRewriter &rewriter) const final {
+    mlir::Value input =
+        SiluFusionPattern::matchExpandedSigmoidInput(divOp.getResult());
+    if (!input) {
+      return mlir::failure();
+    }
+    auto inputType = mlir::cast<RankedTensorType>(input.getType());
+    RankedTensorType outputType = divOp.getResult().getType();
+    if (inputType.getShape() != outputType.getShape()) {
+      return mlir::failure();
+    }
+    mlir::Value sigmoid =
+        rewriter.create<SigmoidOp>(divOp->getLoc(), inputType, input);
+    if (inputType != outputType) {
+      sigmoid =
+          rewriter.create<TypecastOp>(divOp->getLoc(), outputType, sigmoid);
+    }
+    rewriter.replaceOp(divOp, sigmoid);
+    return mlir::success();
+  }
+};
