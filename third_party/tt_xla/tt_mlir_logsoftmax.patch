+// Strip shape- and precision-only operations used around JAX reductions.
+static mlir::Value lookThroughLogSoftmaxPassthroughOps(mlir::Value value) {
+  while (mlir::Operation *definingOp = value.getDefiningOp()) {
+    if (auto broadcastOp = mlir::dyn_cast<BroadcastOp>(definingOp)) {
+      value = broadcastOp.getInput();
+      continue;
+    }
+    if (auto reshapeOp = mlir::dyn_cast<ReshapeOp>(definingOp)) {
+      value = reshapeOp.getInput();
+      continue;
+    }
+    if (auto typecastOp = mlir::dyn_cast<TypecastOp>(definingOp)) {
+      value = typecastOp.getInput();
+      continue;
+    }
+    break;
+  }
+  return value;
+}
+
+static std::optional<double>
+getLogSoftmaxSplatConstantValue(mlir::Value value) {
+  value = lookThroughLogSoftmaxPassthroughOps(value);
+  mlir::Operation *op = value.getDefiningOp();
+  if (!op) {
+    return std::nullopt;
+  }
+
+  if (auto fullOp = mlir::dyn_cast<FullOp>(op)) {
+    if (auto floatAttr =
+            mlir::dyn_cast<mlir::FloatAttr>(fullOp.getFillValue())) {
+      return floatAttr.getValue().convertToDouble();
+    }
+    return std::nullopt;
+  }
+
+  if (auto constantOp = mlir::dyn_cast<ConstantOp>(op)) {
+    auto elements =
+        mlir::dyn_cast<mlir::ElementsAttr>(constantOp.getValue());
+    if (elements && elements.isSplat() &&
+        mlir::isa<mlir::FloatType>(elements.getElementType())) {
+      return elements.getSplatValue<mlir::APFloat>().convertToDouble();
+    }
+  }
+
+  return std::nullopt;
+}
+
+static bool isNegativeInfinityValue(mlir::Value value) {
+  auto scalar = getLogSoftmaxSplatConstantValue(value);
+  return scalar && std::isinf(*scalar) && *scalar < 0.0;
+}
+
+// Fuse the canonical log-softmax tail emitted by JAX:
+// x - log(sum(exp(x), dim)) -> softmax(x, dim, log_output=true).
+//
+// A preceding x = input - max(input, dim) is folded independently by
+// NumericStableSoftmaxFusionPattern below.
+class LogSoftmaxFusionPattern : public mlir::OpRewritePattern<SubtractOp> {
+  using mlir::OpRewritePattern<SubtractOp>::OpRewritePattern;
+
+public:
+  mlir::LogicalResult
+  matchAndRewrite(SubtractOp subtractOp,
+                  mlir::PatternRewriter &rewriter) const final {
+    mlir::Value logValue =
+        lookThroughLogSoftmaxPassthroughOps(subtractOp.getRhs());
+    auto logOp = logValue.getDefiningOp<LogOp>();
+    if (!logOp) {
+      return mlir::failure();
+    }
+
+    mlir::Value sumValue =
+        lookThroughLogSoftmaxPassthroughOps(logOp.getInput());
+    auto sumOp = sumValue.getDefiningOp<SumOp>();
+    if (!sumOp || !sumOp.getDimArg()) {
+      return mlir::failure();
+    }
+
+    mlir::ArrayAttr reduceDims = *sumOp.getDimArg();
+    if (reduceDims.size() != 1) {
+      return mlir::failure();
+    }
+
+    mlir::Value expValue =
+        lookThroughLogSoftmaxPassthroughOps(sumOp.getInput());
+    auto expOp = expValue.getDefiningOp<ExpOp>();
+    if (!expOp || expOp.getInput() != subtractOp.getLhs()) {
+      return mlir::failure();
+    }
+
+    int64_t reduceDim =
+        mlir::cast<mlir::IntegerAttr>(reduceDims[0]).getInt();
+    rewriter.replaceOpWithNewOp<SoftmaxOp>(
+        subtractOp, subtractOp.getType(), expOp.getInput(), reduceDim,
+        /*numericStable=*/false, /*logOutput=*/true);
+    return mlir::success();
+  }
+};
