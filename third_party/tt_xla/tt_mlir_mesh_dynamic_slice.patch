+// On a mesh, dynamic slice bounds hold one value per device. One program
+// slices every device the same way, so the bounds must agree across devices.
+template <typename T>
+static ::ttsl::SmallVector<int32_t>
+agreedSliceBounds(const std::vector<::ttnn::Tensor> &shards) {
+  std::vector<T> values = shards.front().to_vector<T>();
+  for (const ::ttnn::Tensor &shard : shards) {
+    LOG_ASSERT(shard.to_vector<T>() == values,
+               "Dynamic slice bounds differ across devices");
+  }
+  return ::ttsl::SmallVector<int32_t>(values.begin(), values.end());
+}
+
+static ::ttsl::SmallVector<int32_t>
+agreedSliceBounds(const ::ttnn::Tensor &bounds) {
+  std::vector<::ttnn::Tensor> shards =
+      ::ttnn::distributed::get_device_tensors(bounds);
+  if (bounds.dtype() == ::ttnn::DataType::UINT32) {
+    return agreedSliceBounds<uint32_t>(shards);
+  }
+  return agreedSliceBounds<int32_t>(shards);
+}
