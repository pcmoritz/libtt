+std::optional<SerializedExecutableInstance::LoadableParts>
+SerializedExecutableInstance::parse(std::string_view payload) {
+  constexpr size_t header_size = sizeof(SerializationHeader);
+  constexpr size_t trailer_size =
+      2 * sizeof(uint64_t) + sizeof(c_loadable_magic);
+  if (payload.size() < header_size + trailer_size ||
+      payload.substr(0, 8) != "TTSERv00" ||
+      payload.substr(payload.size() - sizeof(c_loadable_magic)) !=
+          std::string_view(c_loadable_magic, sizeof(c_loadable_magic))) {
+    return std::nullopt;
+  }
+  auto read_u64 = [&](size_t offset) {
+    uint64_t value;
+    std::memcpy(&value, payload.data() + offset, sizeof(value));
+    return value;
+  };
+  // Header fields: magic, then (offset, size) for TTIR, TTNN and flatbuffer.
+  const uint64_t ttnn_offset = read_u64(24), ttnn_size = read_u64(32);
+  const uint64_t fb_offset = read_u64(40), fb_size = read_u64(48);
+  const size_t trailer = payload.size() - trailer_size;
+  const uint64_t program_size = read_u64(trailer);
+  const uint64_t compile_options_size = read_u64(trailer + sizeof(uint64_t));
+  const uint64_t body_size = payload.size() - header_size - trailer_size;
+  if (ttnn_offset + ttnn_size > body_size || fb_offset + fb_size > body_size ||
+      program_size + compile_options_size >
+          body_size - (fb_offset + fb_size)) {
+    return std::nullopt;
+  }
+  const size_t program_offset =
+      trailer - compile_options_size - program_size;
+  return LoadableParts{
+      payload.substr(program_offset, program_size),
+      payload.substr(program_offset + program_size, compile_options_size),
+      payload.substr(header_size + ttnn_offset, ttnn_size),
+      payload.substr(header_size + fb_offset, fb_size)};
+}
