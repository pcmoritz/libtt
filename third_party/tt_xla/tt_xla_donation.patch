+// TODO: Implement proper buffer donation by preserving the input/output alias
+// mapping through compilation and reusing donated input storage for outputs.
+
+// Collects inputs JAX marked for input/output aliasing. Only input indices are
+// needed here to invalidate consumed buffers after successful execution.
+static std::vector<size_t> collectDonatableInputIndices(
+    const mlir::OwningOpRef<mlir::ModuleOp> &module) {
+  std::vector<size_t> indices;
+  auto main = (*module).lookupSymbol<mlir::func::FuncOp>("main");
+  if (!main) {
+    return indices;
+  }
+
+  for (size_t i = 0; i < main.getNumArguments(); ++i) {
+    if (main.getArgAttrOfType<mlir::IntegerAttr>(i, "tf.aliasing_output")) {
+      indices.push_back(i);
+    }
+  }
+  return indices;
+}
