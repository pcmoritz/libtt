+void LoadedExecutableInstance::deleteDonatedInputBuffers(
+    PJRT_LoadedExecutable_Execute_Args *args) {
+  std::unordered_set<size_t> non_donatable_indices;
+  if (args->options &&
+      args->options->struct_size >=
+          PJRT_STRUCT_SIZE(PJRT_ExecuteOptions,
+                           num_non_donatable_input_indices)) {
+    for (size_t i = 0; i < args->options->num_non_donatable_input_indices;
+         ++i) {
+      const int64_t index = args->options->non_donatable_input_indices[i];
+      if (index >= 0) {
+        non_donatable_indices.insert(static_cast<size_t>(index));
+      }
+    }
+  }
+
+  for (size_t input_index :
+       m_executable_image->getDonatableInputIndices()) {
+    if (input_index >= args->num_args ||
+        non_donatable_indices.contains(input_index)) {
+      continue;
+    }
+    for (size_t device_index = 0; device_index < args->num_devices;
+         ++device_index) {
+      BufferInstance::unwrap(
+          args->argument_lists[device_index][input_index])
+          ->deleteData();
+    }
+  }
+}
+
+tt_pjrt_status LoadedExecutableInstance::validateInputBuffersForExecution(
+    PJRT_LoadedExecutable_Execute_Args *args) {
+  const std::vector<size_t> &candidate_indices =
+      m_executable_image->getDonatableInputIndices();
+  if (candidate_indices.empty()) {
+    return tt_pjrt_status::kSuccess;
+  }
+
+  std::unordered_set<size_t> donatable_indices(
+      candidate_indices.begin(), candidate_indices.end());
+  if (args->options &&
+      args->options->struct_size >=
+          PJRT_STRUCT_SIZE(PJRT_ExecuteOptions,
+                           num_non_donatable_input_indices)) {
+    for (size_t i = 0; i < args->options->num_non_donatable_input_indices;
+         ++i) {
+      const int64_t index = args->options->non_donatable_input_indices[i];
+      if (index >= 0) {
+        donatable_indices.erase(static_cast<size_t>(index));
+      }
+    }
+  }
+
+  for (size_t device_index = 0; device_index < args->num_devices;
+       ++device_index) {
+    std::unordered_set<BufferInstance *> used_buffers;
+    std::unordered_set<BufferInstance *> donated_buffers;
+    for (size_t input_index = 0; input_index < args->num_args; ++input_index) {
+      BufferInstance *buffer = BufferInstance::unwrap(
+          args->argument_lists[device_index][input_index]);
+      if (buffer->isDataDeleted()) {
+        LOG_F(ERROR, "Input buffer %zu on device %zu was already deleted",
+              input_index, device_index);
+        return tt_pjrt_status::kInvalidArgument;
+      }
+
+      const bool must_donate = donatable_indices.contains(input_index);
+      const bool already_used = !used_buffers.insert(buffer).second;
+      const bool already_donated = donated_buffers.contains(buffer);
+      if ((must_donate && already_used) || already_donated) {
+        LOG_F(ERROR,
+              "Input buffer %zu on device %zu is used in conflicting "
+              "donated and non-donated positions",
+              input_index, device_index);
+        return tt_pjrt_status::kInvalidArgument;
+      }
+      if (must_donate) {
+        donated_buffers.insert(buffer);
+      }
+    }
+  }
+
+  return tt_pjrt_status::kSuccess;
+}
