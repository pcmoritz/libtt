+void LoadedExecutableInstance::invalidateDonatedInputs(
+    PJRT_LoadedExecutable_Execute_Args *args,
+    const DonationIndices &donated_indices) {
+  // deleteData() only changes the PJRT-visible state; it does not reset the
+  // PjrtTensor or deallocate device storage. Outputs have already acquired
+  // their own reference-counted runtime tensor handles, so aliased TTNN
+  // storage also remains alive through the output buffer.
+
+  for (size_t input_index : donated_indices) {
+    if (input_index >= args->num_args) {
+      continue;
+    }
+    for (size_t device_index = 0; device_index < args->num_devices;
+         ++device_index) {
+      BufferInstance::unwrap(
+          args->argument_lists[device_index][input_index])
+          ->deleteData();
+    }
+  }
+}
+
+tt_pjrt_status LoadedExecutableInstance::validateInputBuffers(
+    PJRT_LoadedExecutable_Execute_Args *args,
+    DonationIndices &donated_indices) {
+  const std::vector<size_t> &candidate_indices =
+      m_executable_image->getDonatableInputIndices();
+  if (candidate_indices.empty()) {
+    return tt_pjrt_status::kSuccess;
+  }
+
+  donated_indices.insert(candidate_indices.begin(), candidate_indices.end());
+  if (args->options &&
+      args->options->struct_size >=
+          PJRT_STRUCT_SIZE(PJRT_ExecuteOptions,
+                           num_non_donatable_input_indices)) {
+    for (size_t i = 0; i < args->options->num_non_donatable_input_indices;
+         ++i) {
+      const int64_t index = args->options->non_donatable_input_indices[i];
+      if (index >= 0) {
+        donated_indices.erase(static_cast<size_t>(index));
+      }
+    }
+  }
+
+  // A donated buffer may appear in no other input position. Only the few
+  // donated buffers are tracked; other buffers may repeat freely.
+  std::unordered_set<BufferInstance *> donated_buffers;
+  donated_buffers.reserve(donated_indices.size());
+  for (size_t device_index = 0; device_index < args->num_devices;
+       ++device_index) {
+    donated_buffers.clear();
+    for (size_t input_index : donated_indices) {
+      if (!donated_buffers
+               .insert(BufferInstance::unwrap(
+                   args->argument_lists[device_index][input_index]))
+               .second) {
+        LOG_F(ERROR, "Input buffer %zu on device %zu is donated twice",
+              input_index, device_index);
+        return tt_pjrt_status::kInvalidArgument;
+      }
+    }
+    for (size_t input_index = 0; input_index < args->num_args; ++input_index) {
+      BufferInstance *buffer = BufferInstance::unwrap(
+          args->argument_lists[device_index][input_index]);
+      if (buffer->isDataDeleted()) {
+        LOG_F(ERROR, "Input buffer %zu on device %zu was already deleted",
+              input_index, device_index);
+        return tt_pjrt_status::kInvalidArgument;
+      }
+      if (donated_buffers.contains(buffer) &&
+          !donated_indices.contains(input_index)) {
+        LOG_F(ERROR,
+              "Input buffer %zu on device %zu is used in conflicting "
+              "donated and non-donated positions",
+              input_index, device_index);
+        return tt_pjrt_status::kInvalidArgument;
+      }
+    }
+  }
+
+  return tt_pjrt_status::kSuccess;
+}
