+// Collects inputs which JAX marked as candidates for input/output aliasing.
+// The output index is not needed by PJRT here: the runtime produces the
+// output tensor, while this metadata controls whether the consumed input
+// buffer is invalidated after a successful execution.
+static std::vector<size_t> collectDonatableInputIndices(
+    const mlir::OwningOpRef<mlir::ModuleOp> &module) {
+  std::vector<size_t> indices;
+  auto main = (*module).lookupSymbol<mlir::func::FuncOp>("main");
+  if (!main) {
+    return indices;
+  }
+
+  for (size_t i = 0; i < main.getNumArguments(); ++i) {
+    if (main.getArgAttrOfType<mlir::IntegerAttr>(i, "tf.aliasing_output")) {
+      indices.push_back(i);
+    }
+  }
+  return indices;
+}
