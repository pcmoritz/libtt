+  bool canPreserveFloat16() {
+    bool found = false;
+    WalkResult result = getOperation()->walk([&](Operation *op) {
+      auto hasFloat16 = [](TypeRange types) {
+        return llvm::any_of(types, [](Type type) {
+          auto shapedType = mlir::dyn_cast<ShapedType>(type);
+          return shapedType && shapedType.getElementType().isF16();
+        });
+      };
+
+      bool touchesFloat16;
+      if (auto funcOp = mlir::dyn_cast<func::FuncOp>(op)) {
+        touchesFloat16 = hasFloat16(funcOp.getArgumentTypes()) ||
+                         hasFloat16(funcOp.getResultTypes());
+      } else {
+        touchesFloat16 = hasFloat16(op->getOperandTypes()) ||
+                         hasFloat16(op->getResultTypes());
+      }
+      if (!touchesFloat16) {
+        return WalkResult::advance();
+      }
+      found = true;
+      return mlir::isa<func::FuncOp, func::ReturnOp, DotGeneralOp, ReshapeOp,
+                       ScatterOp, TypecastOp>(op)
+                 ? WalkResult::advance()
+                 : WalkResult::interrupt();
+    });
