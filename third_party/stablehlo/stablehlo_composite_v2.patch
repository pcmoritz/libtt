+// Returns the op of a scan body that only combines its two arguments, e.g.
+// "add" for `^bb0(%a, %b): %r = vhlo.add_v1(%b, %a); vhlo.return_v1(%r, %r)`,
+// or an empty string for any other body.
+static StringRef getScanCombiner(Region& body) {
+  if (!body.hasOneBlock()) return {};
+  Block& block = body.front();
+  if (block.getNumArguments() != 2 || !llvm::hasNItems(block, 2)) return {};
+  Operation& combine = block.front();
+  if (combine.getNumOperands() != 2 || combine.getNumResults() != 1 ||
+      !llvm::is_contained(combine.getOperands(), block.getArgument(0)) ||
+      !llvm::is_contained(combine.getOperands(), block.getArgument(1)))
+    return {};
+  if (!llvm::all_of(block.getTerminator()->getOperands(), [&](Value value) {
+        return value == combine.getResult(0);
+      }))
+    return {};
+  return llvm::StringSwitch<StringRef>(combine.getName().getStringRef())
+      .Case("vhlo.add_v1", "add")
+      .Case("vhlo.multiply_v1", "multiply")
+      .Case("vhlo.maximum_v1", "maximum")
+      .Case("vhlo.minimum_v1", "minimum")
+      .Default({});
+}
