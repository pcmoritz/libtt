 struct VhloLegalizeToStablehloPass
     : public impl::VhloLegalizeToStablehloPassBase<
           VhloLegalizeToStablehloPass> {
@@ -1090,6 +1115,38 @@
   }
 
   void runOnOperation() override {
+    // StableHLO composites have no regions yet, so drop the regions of
+    // composite_v2 and keep its decomposition function. A chlo.scan body that
+    // just combines its two arguments is kept as the composite attribute
+    // "tt.scan_combiner", so that it can still run as a cumulative op.
+    SmallVector<vhlo::CompositeOpV2> compositesV2;
+    getOperation()->walk(
+        [&](vhlo::CompositeOpV2 op) { compositesV2.push_back(op); });
+    IRRewriter rewriter(&getContext());
+    for (vhlo::CompositeOpV2 op : compositesV2) {
+      Attribute compositeAttrs = op.getCompositeAttributes();
+      auto name = dyn_cast<vhlo::StringV1Attr>(op.getName());
+      auto attrs = dyn_cast<vhlo::DictionaryV1Attr>(compositeAttrs);
+      if (name && name.getValue() == "chlo.scan" && attrs &&
+          op.getCompositeRegions().size() == 1) {
+        StringRef combiner = getScanCombiner(op.getCompositeRegions().front());
+        if (!combiner.empty()) {
+          SmallVector<std::pair<Attribute, Attribute>> entries(
+              attrs.getValue());
+          entries.push_back(
+              {vhlo::StringV1Attr::get(&getContext(), "tt.scan_combiner"),
+               vhlo::StringV1Attr::get(&getContext(), combiner)});
+          compositeAttrs = vhlo::DictionaryV1Attr::get(&getContext(), entries);
+        }
+      }
+      rewriter.setInsertionPoint(op);
+      DictionaryAttr discardableAttrs = op->getDiscardableAttrDictionary();
+      auto newOp = rewriter.replaceOpWithNewOp<vhlo::CompositeOpV1>(
+          op, op->getResultTypes(), op.getInputs(), op.getName(),
+          compositeAttrs, op.getDecomposition(), op.getVersion());
+      newOp->setDiscardableAttrs(discardableAttrs);
+    }
+
