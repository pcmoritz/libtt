diff --git ttnn/cpp/ttnn/operations/core/to_layout/to_layout_op.cpp ttnn/cpp/ttnn/operations/core/to_layout/to_layout_op.cpp
--- ttnn/cpp/ttnn/operations/core/to_layout/to_layout_op.cpp
+++ ttnn/cpp/ttnn/operations/core/to_layout/to_layout_op.cpp
@@ -11,1 +11,3 @@
 #include "ttnn/distributed/types.hpp"
+#include "ttnn/operations/eltwise/unary/unary.hpp"
+#include "ttnn/operations/copy/typecast/typecast.hpp"
@@ -85,3 +87,15 @@ Tensor to_layout_impl(
     if (!supported_layouts.contains(layout)) {
         TT_THROW("ttnn::to_layout: Unsupported layout conversion from {} to {}!", tensor_arg.layout(), layout);
     }
+
+    const DataType output_dtype = dtype.value_or(tensor_arg.dtype());
+    if (tt::tt_metal::is_device_tensor(tensor_arg) && tensor_arg.dtype() == DataType::FLOAT16 &&
+        (output_dtype == DataType::FLOAT16 || output_dtype == DataType::FLOAT32)) {
+        auto bits = ttnn::bitcast(tensor_arg, DataType::UINT16);
+        bits = to_layout_impl(bits, layout, DataType::UINT16, memory_config, sub_core_grids, pad_value);
+        auto tensor = ttnn::bitcast(bits, DataType::FLOAT16);
+        if (output_dtype == DataType::FLOAT32) {
+            return ttnn::typecast(tensor, DataType::FLOAT32);
+        }
+        return tensor;
+    }
