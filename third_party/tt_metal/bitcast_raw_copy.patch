diff --git a/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_device_operation.cpp b/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_device_operation.cpp
--- a/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_device_operation.cpp
+++ b/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_device_operation.cpp
@@ -32,2 +32,16 @@ void UnaryDeviceOperation::validate_on_program_cache_miss(
 
+    if (args.op_chain.size() == 1 && args.op_chain.front().type() == operations::unary::UnaryOpType::BITCAST) {
+        const DataType output_dtype = output_tensor.has_value() ? output_tensor->dtype() : args.output_dtype;
+        TT_FATAL(
+            input_tensor.element_size() == sizeof(uint16_t) || input_tensor.element_size() == sizeof(uint32_t),
+            "Bitcast only supports 16- and 32-bit element types");
+        const auto input_format = tt::tt_metal::datatype_to_dataformat_converter(input_tensor.dtype());
+        const auto output_format = tt::tt_metal::datatype_to_dataformat_converter(output_dtype);
+        const bool equal_width =
+            input_tensor.layout() == Layout::TILE
+                ? tile_size(input_format) == tile_size(output_format)
+                : datum_size(input_format) == datum_size(output_format);
+        TT_FATAL(equal_width, "Bitcast requires equal-width input and output element types");
+    }
+
     auto out_memory_config = args.memory_config;
diff --git a/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_program_factory.cpp b/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_program_factory.cpp
--- a/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_program_factory.cpp
+++ b/ttnn/cpp/ttnn/operations/eltwise/unary/device/unary_program_factory.cpp
@@ -120,2 +120,3 @@ tt::tt_metal::ProgramDescriptor UnaryDeviceOperation::ProgramFactory::create_des
     TT_FATAL(!ops_chain.empty(), "Unary: op_chain must not be empty");
+    const bool is_bitcast = ops_chain.size() == 1 && ops_chain[0].type() == UnaryOpType::BITCAST;
     auto compute_ops_chain = ops_chain;
@@ -159,4 +160,7 @@ tt::tt_metal::ProgramDescriptor UnaryDeviceOperation::ProgramFactory::create_des
                                                       : datatype_to_dataformat_converter(output.dtype());
-    if (ops_chain[0].type() == unary::UnaryOpType::BITCAST && output.dtype() == DataType::FLOAT16) {
-        cb_data_format_output = DataFormat::UInt16;
+    if (is_bitcast) {
+        // For BITCAST, cb_data_format_for_input below inherits this format.
+        // Unsigned semantics therefore apply to both unpacking and packing.
+        cb_data_format_output =
+            input.element_size() == sizeof(uint16_t) ? DataFormat::UInt16 : DataFormat::UInt32;
     }
