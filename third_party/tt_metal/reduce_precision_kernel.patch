+// SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include "api/compute/common_globals.h"
+#ifdef TRISC_MATH
+#include "ckernel_sfpu_reduce_precision.h"
+#include "llk_math_eltwise_unary_sfpu_macros.h"
+#endif
+
+namespace ckernel {
+
+// clang-format off
+/**
+ * Rounds each value of the tile in DST to a floating-point format with EXPONENT_BITS and MANTISSA_BITS, like XLA's
+ * reduce_precision. DST holds the raw bits of a float with INPUT_EXPONENT_BITS and INPUT_MANTISSA_BITS: as UInt32 for
+ * Float32 and as UInt16 for BFloat16 and Float16. Blackhole only.
+ *
+ * | Argument       | Description                                                                | Type     | Valid Range                                           | Required |
+ * |----------------|----------------------------------------------------------------------------|----------|-------------------------------------------------------|----------|
+ * | idst           | The index of the tile in DST register buffer to perform the computation on | uint32_t | Must be less than the size of the DST register buffer | True     |
+ */
+// clang-format on
+template <
+    std::uint32_t INPUT_EXPONENT_BITS,
+    std::uint32_t INPUT_MANTISSA_BITS,
+    std::uint32_t EXPONENT_BITS,
+    std::uint32_t MANTISSA_BITS>
+ALWI void reduce_precision_tile(uint32_t idst) {
+    MATH(SFPU_UNARY_CALL(
+        DST_SYNC_MODE,
+        DST_ACCUM_MODE,
+        calculate_reduce_precision,
+        (INPUT_EXPONENT_BITS, INPUT_MANTISSA_BITS, EXPONENT_BITS, MANTISSA_BITS),
+        idst,
+        VectorMode::RC));
+}
+
+ALWI void reduce_precision_tile_init() { MATH(SFPU_UNARY_INIT(unused)); }
+
+}  // namespace ckernel
