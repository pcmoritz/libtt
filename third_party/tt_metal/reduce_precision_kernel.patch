+Tensor reduce_precision(
+    const Tensor& input_tensor,
+    uint32_t exponent_bits,
+    uint32_t mantissa_bits,
+    const std::optional<MemoryConfig>& memory_config,
+    const std::optional<Tensor>& optional_output_tensor) {
+    using namespace operations::unary;
+    TT_FATAL(exponent_bits >= 1, "reduce_precision needs at least one exponent bit");
+    // The kernel configures both buffers with the input's raw-bit width.
+    TT_FATAL(
+        !optional_output_tensor || optional_output_tensor->dtype() == input_tensor.dtype(),
+        "reduce_precision requires matching input and output dtypes");
+    EltwiseUnaryWithParam reduce_precision_op(UnaryOpType::REDUCE_PRECISION, {exponent_bits, mantissa_bits});
+    return operations::unary::detail::unary_impl(
+        input_tensor, {reduce_precision_op}, memory_config, optional_output_tensor);
+}
