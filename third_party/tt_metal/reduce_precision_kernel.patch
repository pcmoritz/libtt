+// SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include "ckernel.h"
+#include "ckernel_defs.h"
+#include "cmath_common.h"
+#include "sfpi.h"
+
+namespace ckernel {
+namespace sfpu {
+
+// Rounds the floating-point values in Dest to a format with EXPONENT_BITS and MANTISSA_BITS, with XLA's bit
+// manipulation on the input format's own bits: round to nearest even, flush values below the format's smallest
+// normal to signed zero, saturate overflows to signed infinity, and keep NaN. Dest holds the raw bits, as UInt32
+// for a 32-bit input and as UInt16 for a 16-bit one, so subnormals of the input format are never converted.
+template <
+    std::uint32_t INPUT_EXPONENT_BITS,
+    std::uint32_t INPUT_MANTISSA_BITS,
+    std::uint32_t EXPONENT_BITS,
+    std::uint32_t MANTISSA_BITS,
+    int ITERATIONS = 8>
+inline void calculate_reduce_precision() {
+    constexpr std::uint32_t WIDTH = 1 + INPUT_EXPONENT_BITS + INPUT_MANTISSA_BITS;
+    static_assert(WIDTH == 16 || WIDTH == 32, "reduce_precision supports 16- and 32-bit inputs");
+    static_assert(EXPONENT_BITS >= 1, "reduce_precision needs at least one exponent bit");
+    constexpr sfpi::DataLayout LAYOUT = WIDTH == 16 ? sfpi::DataLayout::U16 : sfpi::DataLayout::I32;
+    constexpr std::uint32_t SIGN_BIT = 1u << (WIDTH - 1);
+    constexpr std::uint32_t EXPONENT_MASK = ((1u << INPUT_EXPONENT_BITS) - 1) << INPUT_MANTISSA_BITS;
+
+#pragma GCC unroll 0
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vInt input;
+        if constexpr (WIDTH == 16) {
+            sfpi::vUInt raw = sfpi::dst_reg[0].mode<LAYOUT>();
+            input = sfpi::as<sfpi::vInt>(raw) & sfpi::vInt(0xFFFF);
+        } else {
+            input = sfpi::dst_reg[0].mode<LAYOUT>();
+        }
+        sfpi::vInt bits = input;
+
+        if constexpr (MANTISSA_BITS < INPUT_MANTISSA_BITS) {
+            // Round to nearest even: add 0111..., plus one if the last kept bit is set, then truncate. A carry
+            // into the exponent is correct.
+            constexpr std::uint32_t LAST_KEPT_BIT = 1u << (INPUT_MANTISSA_BITS - MANTISSA_BITS);
+            sfpi::vInt bias = sfpi::vInt((LAST_KEPT_BIT >> 1) - 1);
+            v_if((bits & sfpi::vInt(LAST_KEPT_BIT)) != sfpi::vInt(0)) { bias = sfpi::vInt(LAST_KEPT_BIT >> 1); }
+            v_endif;
+            bits = (bits + bias) & sfpi::vInt(~(LAST_KEPT_BIT - 1));
+        }
+
+        if constexpr (EXPONENT_BITS < INPUT_EXPONENT_BITS) {
+            constexpr std::uint32_t INPUT_BIAS = (1u << (INPUT_EXPONENT_BITS - 1)) - 1;
+            constexpr std::uint32_t REDUCED_BIAS = (1u << (EXPONENT_BITS - 1)) - 1;
+            constexpr std::uint32_t MAX_EXPONENT = (INPUT_BIAS + REDUCED_BIAS) << INPUT_MANTISSA_BITS;
+            constexpr std::uint32_t MIN_EXPONENT = (INPUT_BIAS - REDUCED_BIAS) << INPUT_MANTISSA_BITS;
+            // Masked to at most 31 bits, so the signed compares below are exact.
+            sfpi::vInt exponent = bits & sfpi::vInt(EXPONENT_MASK);
+            sfpi::vInt signed_zero = bits & sfpi::vInt(SIGN_BIT);
+            v_if(exponent > sfpi::vInt(MAX_EXPONENT)) { bits = signed_zero | sfpi::vInt(EXPONENT_MASK); }
+            v_elseif(exponent <= sfpi::vInt(MIN_EXPONENT)) { bits = signed_zero; }
+            v_endif;
+        }
+
+        // Rounding and the exponent handling can turn NaN into a number or infinity; NaN stays NaN.
+        v_if((input & sfpi::vInt(SIGN_BIT - 1)) > sfpi::vInt(EXPONENT_MASK)) { bits = input; }
+        v_endif;
+
+        if constexpr (WIDTH == 16) {
+            // Drop a rounding carry out of the input's width.
+            sfpi::dst_reg[0].mode<LAYOUT>() = sfpi::as<sfpi::vUInt>(bits & sfpi::vInt(0xFFFF));
+        } else {
+            sfpi::dst_reg[0].mode<LAYOUT>() = bits;
+        }
+        sfpi::dst_reg++;
+    }
+}
+
+}  // namespace sfpu
+}  // namespace ckernel
