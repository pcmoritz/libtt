+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+#include <stdint.h>
+
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "recurrent_utils.hpp"
+
+void kernel_main() {
+    constexpr uint32_t kt = get_compile_time_arg_val(0);
+    constexpr uint32_t full_vt = get_compile_time_arg_val(1);
+    constexpr uint32_t batch_size = get_compile_time_arg_val(2);
+    constexpr uint32_t num_heads = get_compile_time_arg_val(3);
+    constexpr uint32_t workers_per_head = get_compile_time_arg_val(4);
+    constexpr uint32_t num_workers = get_compile_time_arg_val(5);
+    constexpr uint32_t vt = full_vt / workers_per_head;
+    constexpr uint32_t state_tiles = kt * vt;
+    constexpr uint32_t state_tile_bytes = 4096;
+    constexpr uint32_t output_tile_bytes = 4096;
+
+    const uint32_t worker = get_arg_val<uint32_t>(0);
+    const uint32_t output_address = get_arg_val<uint32_t>(1);
+    const uint32_t state_address = get_arg_val<uint32_t>(2);
+    const uint32_t state_indices_address = get_arg_val<uint32_t>(3);
+
+    constexpr auto output_args = TensorAccessorArgs<6>();
+    constexpr auto state_args =
+        TensorAccessorArgs<output_args.next_compile_time_args_offset()>();
+    constexpr auto state_indices_args =
+        TensorAccessorArgs<state_args.next_compile_time_args_offset()>();
+    const auto output = TensorAccessor(output_args, output_address, output_tile_bytes);
+    const auto state = TensorAccessor(state_args, state_address, state_tile_bytes);
+    const auto state_indices =
+        TensorAccessor(state_indices_args, state_indices_address, 4096);
+
+    CircularBuffer output_cb(tt::CBIndex::c_12);
+    CircularBuffer state_cb(tt::CBIndex::c_11);
+    CircularBuffer state_indices_cb(tt::CBIndex::c_29);
+    Noc noc;
+
+    // Metadata is shared by every head handled by this core.
+    state_indices_cb.reserve_back(1);
+    noc.async_read(
+        state_indices, state_indices_cb, 4096,
+        {.page_id = 0}, {.offset_bytes = 0});
+    noc.async_read_barrier();
+
+    for (uint32_t work = worker; work < batch_size * num_heads * workers_per_head; work += num_workers) {
+        const uint32_t head_work = work / workers_per_head;
+        const uint32_t column_start = (work % workers_per_head) * vt;
+        const uint32_t batch = head_work / num_heads;
+        const uint32_t head = head_work % num_heads;
+        const uint32_t head_tile = batch * ((num_heads + 31) / 32) + head / 32;
+        const uint32_t vector_base = head_tile * full_vt + column_start;
+        const uint32_t row_offset = tile_offset(head % 32, 0) * sizeof(uint32_t);
+
+        const uint32_t state_slot =
+            read_index(state_indices_cb.get_write_ptr(), batch);
+
+        const uint32_t state_base =
+            (state_slot * num_heads + head) * kt * full_vt;
+
+        output_cb.wait_front(vt);
+        state_cb.wait_front(state_tiles);
+        // Copy row zero from each compute tile into this head's packed output row.
+        for (uint32_t tile = 0; tile < vt; ++tile) {
+            for (uint32_t face = 0; face < 2; ++face) {
+                const uint32_t face_offset = tile_offset(0, face * 16) * sizeof(uint32_t);
+                noc.async_write(
+                    output_cb, output, 16 * sizeof(uint32_t),
+                    {.offset_bytes = tile * output_tile_bytes + face_offset},
+                    {.page_id = vector_base + tile, .offset_bytes = row_offset + face_offset});
+            }
+        }
+        for (uint32_t row = 0; state_slot != 0 && row < kt; ++row) {
+            for (uint32_t column = 0; column < vt; ++column) {
+                const uint32_t local_tile = row * vt + column;
+                noc.async_write(
+                    state_cb, state, state_tile_bytes,
+                    {.offset_bytes = local_tile * state_tile_bytes},
+                    {.page_id = state_base + row * full_vt + column_start + column});
+            }
+        }
+        noc.async_write_barrier();
+        output_cb.pop_front(vt);
+        state_cb.pop_front(state_tiles);
+    }
+}
