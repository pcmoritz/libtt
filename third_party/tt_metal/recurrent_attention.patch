+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/transformer/gated_delta_attn/state_pool_update.hpp"
+
+#include <algorithm>
+#include <utility>
+
+#include <tt-metalium/program_descriptors.hpp>
+#include <tt-metalium/tensor_accessor_args.hpp>
+#include <tt-metalium/work_split.hpp>
+#include "ttnn/device.hpp"
+#include "ttnn/device_operation.hpp"
+
+using namespace tt::tt_metal;
+
+namespace ttnn::prim {
+namespace {
+
+struct StatePoolUpdateParams {};
+
+struct StatePoolUpdateInputs {
+    Tensor state_pool;
+    Tensor state_indices;
+    Tensor updates;
+};
+
+struct StatePoolUpdateOperation {
+    using operation_attributes_t = StatePoolUpdateParams;
+    using tensor_args_t = StatePoolUpdateInputs;
+    using spec_return_value_t = TensorSpec;
+    using tensor_return_value_t = Tensor;
+
+    static ProgramDescriptor create_descriptor(
+        const operation_attributes_t&, const tensor_args_t&, tensor_return_value_t&);
+    static void validate_on_program_cache_miss(
+        const operation_attributes_t&, const tensor_args_t&);
+    static spec_return_value_t compute_output_specs(
+        const operation_attributes_t&, const tensor_args_t& inputs) {
+        return inputs.state_pool.tensor_spec();
+    }
+    static tensor_return_value_t create_output_tensors(
+        const operation_attributes_t&, const tensor_args_t& inputs) {
+        return inputs.state_pool;
+    }
+};
+
+void validate_tensor(const Tensor& tensor, const char* name) {
+    TT_FATAL(tensor.storage_type() == StorageType::DEVICE, "{} must be on device", name);
+    TT_FATAL(tensor.buffer() != nullptr, "{} must be allocated", name);
+    TT_FATAL(tensor.layout() == Layout::TILE, "{} must be tiled", name);
+    TT_FATAL(!tensor.is_sharded(), "{} must be interleaved", name);
+}
+
+void check_shape(const Tensor& tensor, std::initializer_list<uint32_t> expected, const char* name) {
+    TT_FATAL(tensor.logical_shape() == Shape(expected), "{} shape mismatch", name);
+}
+
+void StatePoolUpdateOperation::validate_on_program_cache_miss(
+    const operation_attributes_t&, const tensor_args_t& inputs) {
+    validate_tensor(inputs.state_pool, "state pool");
+    validate_tensor(inputs.state_indices, "state indices");
+    validate_tensor(inputs.updates, "updates");
+    TT_FATAL(
+        inputs.state_indices.dtype() == DataType::INT32,
+        "state indices must be int32");
+    TT_FATAL(
+        inputs.state_pool.dtype() == inputs.updates.dtype(),
+        "state pool and updates must have the same dtype");
+
+    const auto& pool_shape = inputs.state_pool.logical_shape();
+    const auto& update_shape = inputs.updates.logical_shape();
+    TT_FATAL(
+        pool_shape.rank() >= 2 && pool_shape.rank() == update_shape.rank(),
+        "state pool and updates must have the same rank of at least two");
+    TT_FATAL(update_shape[0] <= 32, "updates must fit in one tile row");
+    check_shape(inputs.state_indices, {update_shape[0]}, "state indices");
+    for (uint32_t dim = 1; dim < pool_shape.rank(); ++dim) {
+        TT_FATAL(
+            pool_shape[dim] == update_shape[dim],
+            "state pool and update slices must match");
+    }
+    TT_FATAL(
+        inputs.state_pool.buffer()->num_pages() % pool_shape[0] == 0 &&
+            inputs.updates.buffer()->num_pages() % update_shape[0] == 0 &&
+            inputs.state_pool.buffer()->num_pages() / pool_shape[0] ==
+                inputs.updates.buffer()->num_pages() / update_shape[0],
+        "state pool and update slices must have the same page count");
+}
+
+ProgramDescriptor StatePoolUpdateOperation::create_descriptor(
+    const operation_attributes_t&, const tensor_args_t& inputs,
+    tensor_return_value_t&) {
+    const uint32_t batch_size = inputs.updates.logical_shape()[0];
+    const uint32_t pages_per_slice =
+        inputs.updates.buffer()->num_pages() / batch_size;
+    const uint32_t total_pages = batch_size * pages_per_slice;
+    const uint32_t tile_bytes = inputs.updates.buffer()->page_size();
+
+    ProgramDescriptor program;
+    auto* device = inputs.state_pool.device();
+    const CoreCoord grid = device->compute_with_storage_grid_size();
+    const uint32_t num_workers = std::min(
+        total_pages, static_cast<uint32_t>(grid.x * grid.y));
+    CoreRangeSet cores = num_cores_to_corerangeset(num_workers, grid);
+
+    program.cbs = {
+        CBDescriptor{
+            .total_size = tile_bytes,
+            .core_ranges = cores,
+            .format_descriptors = {{
+                .buffer_index = tt::CBIndex::c_0,
+                .data_format = datatype_to_dataformat_converter(inputs.updates.dtype()),
+                .page_size = tile_bytes}}},
+        CBDescriptor{
+            .total_size = 4096,
+            .core_ranges = cores,
+            .format_descriptors = {{
+                .buffer_index = tt::CBIndex::c_1,
+                .data_format = tt::DataFormat::Int32, .page_size = 4096}}}};
+
+    std::vector<uint32_t> compile_args = {
+        batch_size, pages_per_slice, num_workers, tile_bytes};
+    TensorAccessorArgs(inputs.state_pool.buffer()).append_to(compile_args);
+    TensorAccessorArgs(inputs.state_indices.buffer()).append_to(compile_args);
+    TensorAccessorArgs(inputs.updates.buffer()).append_to(compile_args);
+
+    KernelDescriptor kernel{
+        .kernel_source = "ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/"
+        "kernels/dataflow/state_pool_update.cpp",
+        .core_ranges = cores,
+        .compile_time_args = compile_args,
+        .config = DataMovementConfigDescriptor{
+            .processor = DataMovementProcessor::RISCV_0,
+            .noc = NOC::RISCV_0_default}};
+
+    for (uint32_t worker = 0; worker < num_workers; ++worker) {
+        const CoreCoord core{worker / grid.y, worker % grid.y};
+        kernel.emplace_runtime_args(
+            core,
+            {worker, inputs.state_pool.buffer(),
+             inputs.state_indices.buffer(),
+             inputs.updates.buffer()});
+    }
+
+    program.kernels.push_back(std::move(kernel));
+    return program;
+}
+
+}  // namespace
+}  // namespace ttnn::prim
+
+namespace ttnn::transformer {
+
+Tensor state_pool_update(
+    const Tensor& state_pool,
+    const Tensor& state_indices,
+    const Tensor& updates) {
+    using Op = prim::StatePoolUpdateOperation;
+    return device_operation::launch<Op>(
+        {},
+        {.state_pool = state_pool,
+         .state_indices = state_indices,
+         .updates = updates});
+}
+
+}  // namespace ttnn::transformer
diff --git ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/compute/gated_delta_decode.cpp ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/compute/gated_delta_decode.cpp
new file mode 100644
index 0000000..2df32b1
--- /dev/null
+++ ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/compute/gated_delta_decode.cpp
@@ -0,0 +1,187 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+#include <stdint.h>
+
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/exp.h"
+#include "api/compute/eltwise_unary/negative.h"
+#include "api/compute/eltwise_unary/softplus.h"
+#include "api/compute/matmul.h"
+#include "api/compute/tile_move_copy.h"
+
+void kernel_main() {
+    constexpr uint32_t kt = get_compile_time_arg_val(0);
+    constexpr uint32_t vt = get_compile_time_arg_val(1);
+    constexpr uint32_t batch_size = get_compile_time_arg_val(2);
+    constexpr uint32_t num_heads = get_compile_time_arg_val(3);
+    constexpr uint32_t workers_per_head = get_compile_time_arg_val(4);
+    constexpr uint32_t num_workers = get_compile_time_arg_val(5);
+    const uint32_t worker = get_arg_val<uint32_t>(0);
+    constexpr uint32_t state_tiles = kt * vt;
+
+    constexpr uint32_t state = tt::CBIndex::c_0;
+    constexpr uint32_t query = tt::CBIndex::c_1;
+    constexpr uint32_t key = tt::CBIndex::c_2;
+    constexpr uint32_t value = tt::CBIndex::c_3;
+    constexpr uint32_t delta_time = tt::CBIndex::c_4;
+    constexpr uint32_t beta_logits = tt::CBIndex::c_5;
+    constexpr uint32_t state_mid = tt::CBIndex::c_6;
+    constexpr uint32_t key_transposed = tt::CBIndex::c_9;
+    constexpr uint32_t scaled_delta = tt::CBIndex::c_10;
+    constexpr uint32_t state_new = tt::CBIndex::c_11;
+    constexpr uint32_t output = tt::CBIndex::c_12;
+    constexpr uint32_t a_log = tt::CBIndex::c_13;
+    constexpr uint32_t dt_bias = tt::CBIndex::c_14;
+    constexpr uint32_t beta = tt::CBIndex::c_16;
+    constexpr uint32_t decay = tt::CBIndex::c_20;
+
+    // Configure the FP32 unpack/pack paths before the first compute API call.
+    compute_kernel_hw_startup<SrcOrder::Reverse>(key, state, scaled_delta);
+    matmul_init(key, state);
+    for (uint32_t work = worker; work < batch_size * num_heads * workers_per_head; work += num_workers) {
+    // beta = sigmoid(beta_logits)
+    cb_wait_front(beta_logits, 1);
+    cb_reserve_back(beta, 1);
+    unary_bcast_init<BroadcastType::SCALAR>(beta_logits, beta);
+    sigmoid_tile_init();
+    tile_regs_acquire();
+    unary_bcast<BroadcastType::SCALAR>(beta_logits, 0, 0);
+    sigmoid_tile(0);
+    tile_regs_commit();
+    tile_regs_wait();
+    pack_reconfig_data_format(beta);
+    pack_tile(0, beta, 0);
+    tile_regs_release();
+    cb_push_back(beta, 1);
+    cb_pop_front(beta_logits, 1);
+
+    // decay = exp(-exp(a_log) * softplus(delta_time + dt_bias))
+    cb_wait_front(a_log, 1);
+    cb_wait_front(delta_time, 1);
+    cb_wait_front(dt_bias, 1);
+    cb_reserve_back(decay, 1);
+    binary_op_init_common(delta_time, dt_bias, decay);
+    add_tiles_init(delta_time, dt_bias);
+    tile_regs_acquire();
+    add_tiles(delta_time, dt_bias, 0, 0, 0);
+    softplus_tile_init();
+    softplus_tile(0, 0x3F800000u, 0x3F800000u, 0x41A00000u);
+    copy_tile_to_dst_init_short(a_log);
+    copy_tile(a_log, 0, 1);
+    exp_tile_init();
+    exp_tile(1);
+    negative_tile_init();
+    negative_tile(1);
+    mul_binary_tile_init();
+    mul_binary_tile(0, 1, 0);
+    exp_tile_init();
+    exp_tile(0);
+    tile_regs_commit();
+    tile_regs_wait();
+    pack_reconfig_data_format(decay);
+    pack_tile(0, decay, 0);
+    tile_regs_release();
+    cb_push_back(decay, 1);
+    cb_pop_front(a_log, 1);
+    cb_pop_front(delta_time, 1);
+    cb_pop_front(dt_bias, 1);
+
+    // state_mid = decay * state
+    mul_tiles_bcast_scalar_init_short(state, decay);
+    cb_wait_front(state, state_tiles);
+    cb_wait_front(decay, 1);
+    cb_reserve_back(state_mid, state_tiles);
+    for (uint32_t tile = 0; tile < state_tiles; ++tile) {
+        tile_regs_acquire();
+        mul_tiles_bcast_scalar(state, decay, tile, 0, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, state_mid, tile);
+        tile_regs_release();
+    }
+    cb_push_back(state_mid, state_tiles);
+    cb_pop_front(state, state_tiles);
+
+    // scaled_delta = beta * (value - key * state_mid), all before packing.
+    pack_reconfig_data_format(scaled_delta);
+    cb_wait_front(key, kt);
+    cb_wait_front(state_mid, state_tiles);
+    cb_wait_front(value, vt);
+    cb_wait_front(beta, 1);
+    cb_reserve_back(scaled_delta, vt);
+    for (uint32_t column = 0; column < vt; ++column) {
+        reconfig_data_format<SrcOrder::Reverse>(key, state_mid);
+        matmul_init(key, state_mid);
+        tile_regs_acquire();
+        for (uint32_t inner = 0; inner < kt; ++inner) {
+            matmul_tiles(key, state_mid, inner, inner * vt + column, 0);
+        }
+        binary_dest_reuse_tiles_init<
+            EltwiseBinaryType::ELWSUB, EltwiseBinaryReuseDestType::DEST_TO_SRCB>(value);
+        binary_dest_reuse_tiles<
+            EltwiseBinaryType::ELWSUB, EltwiseBinaryReuseDestType::DEST_TO_SRCB>(value, column, 0);
+        binary_dest_reuse_tiles_init<
+            EltwiseBinaryType::ELWMUL, EltwiseBinaryReuseDestType::DEST_TO_SRCA>(beta);
+        binary_dest_reuse_tiles<
+            EltwiseBinaryType::ELWMUL, EltwiseBinaryReuseDestType::DEST_TO_SRCA>(beta, 0, 0);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, scaled_delta, column);
+        tile_regs_release();
+    }
+    cb_push_back(scaled_delta, vt);
+
+    // state_new = state_mid + key^T * scaled_delta
+    cb_wait_front(key_transposed, kt);
+    cb_wait_front(scaled_delta, vt);
+    cb_reserve_back(state_new, state_tiles);
+    for (uint32_t row = 0; row < kt; ++row) {
+        for (uint32_t column = 0; column < vt; ++column) {
+            tile_regs_acquire();
+            copy_tile_to_dst_init_short(state_mid);
+            copy_tile(state_mid, row * vt + column, 0);
+            reconfig_data_format<SrcOrder::Reverse>(key_transposed, scaled_delta);
+            matmul_init(key_transposed, scaled_delta);
+            pack_reconfig_data_format(state_new);
+            matmul_tiles(key_transposed, scaled_delta, row, column, 0);
+            tile_regs_commit();
+            tile_regs_wait();
+            pack_tile(0, state_new, row * vt + column);
+            tile_regs_release();
+        }
+    }
+    cb_push_back(state_new, state_tiles);
+    cb_pop_front(state_mid, state_tiles);
+    cb_pop_front(key_transposed, kt);
+    cb_pop_front(scaled_delta, vt);
+
+    // output = query * state_new; reuse the FP32 pack configuration.
+    reconfig_data_format<SrcOrder::Reverse>(query, state_new);
+    matmul_init(query, state_new);
+    cb_wait_front(query, kt);
+    cb_wait_front(state_new, state_tiles);
+    cb_reserve_back(output, vt);
+    for (uint32_t column = 0; column < vt; ++column) {
+        tile_regs_acquire();
+        for (uint32_t inner = 0; inner < kt; ++inner) {
+            matmul_tiles(query, state_new, inner, inner * vt + column, 0);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_tile(0, output, column);
+        tile_regs_release();
+    }
+    cb_push_back(output, vt);
+
+    cb_pop_front(query, kt);
+    cb_pop_front(key, kt);
+    cb_pop_front(value, vt);
+    cb_pop_front(decay, 1);
+    cb_pop_front(beta, 1);
+    }
+}
diff --git ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/dataflow/reader_gated_delta_decode.cpp ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/dataflow/reader_gated_delta_decode.cpp
new file mode 100644
index 0000000..50ac022
--- /dev/null
+++ ttnn/cpp/ttnn/operations/transformer/gated_delta_attn/device/kernels/dataflow/reader_gated_delta_decode.cpp
@@ -0,0 +1,209 @@
+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+#include <stdint.h>
+
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "recurrent_utils.hpp"
+
+namespace {
+
+// Load one head from packed [B,H,D] tiles into row zero of each compute
+// tile. This avoids materializing 31 padding rows per head in DRAM.
+template <typename Accessor>
+FORCE_INLINE void read_vector(
+    Noc& noc, const Accessor& input, CircularBuffer& cb,
+    uint32_t page, uint32_t row, uint32_t tiles) {
+    cb.reserve_back(tiles);
+    noc.async_write_zeros(cb, tiles * 4096);
+    noc.write_zeros_l1_barrier();
+    for (uint32_t tile = 0; tile < tiles; ++tile) {
+        for (uint32_t face = 0; face < 2; ++face) {
+            noc.async_read(
+                input, cb, 16 * sizeof(uint32_t),
+                {.page_id = page + tile,
+                 .offset_bytes = tile_offset(row, face * 16) * sizeof(uint32_t)},
+                {.offset_bytes = tile * 4096 + face * 1024});
+        }
+    }
+}
+
+// Read the aligned half-row containing the scalar, preserving its tile offset.
+template <typename Accessor>
+FORCE_INLINE void read_scalar(
+    Noc& noc, const Accessor& input, CircularBuffer& cb,
+    uint32_t page, uint32_t row, uint32_t column) {
+    const uint32_t offset = tile_offset(row, (column / 16) * 16) * sizeof(uint32_t);
+    cb.reserve_back(1);
+    noc.async_read(
+        input, cb, 16 * sizeof(uint32_t),
+        {.page_id = page, .offset_bytes = offset}, {.offset_bytes = offset});
+}
+
+FORCE_INLINE void make_scalar_tile(
+    Noc& noc, CircularBuffer& cb, uint32_t row, uint32_t column) {
+    const uint32_t address = cb.get_write_ptr();
+    volatile tt_l1_ptr uint32_t* tile = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(address);
+    const uint32_t element = read_int32_tile(address, row, column);
+    noc.async_write_zeros(cb, 4096);
+    noc.write_zeros_l1_barrier();
+    tile[0] = element;
+    tile[256] = element;
+    tile[512] = element;
+    tile[768] = element;
+}
+
+FORCE_INLINE void transpose_row_tile(uint32_t source_address, uint32_t destination_address) {
+    volatile tt_l1_ptr uint32_t* source = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(source_address);
+    volatile tt_l1_ptr uint32_t* destination =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(destination_address);
+    for (uint32_t i = 0; i < 16; ++i) {
+        destination[i * 16] = source[i];
+        destination[512 + i * 16] = source[256 + i];
+    }
+}
+
+}  // namespace
+
+void kernel_main() {
+    constexpr uint32_t kt = get_compile_time_arg_val(0);
+    constexpr uint32_t full_vt = get_compile_time_arg_val(1);
+    constexpr uint32_t batch_size = get_compile_time_arg_val(2);
+    constexpr uint32_t num_heads = get_compile_time_arg_val(3);
+    constexpr uint32_t workers_per_head = get_compile_time_arg_val(4);
+    constexpr uint32_t num_workers = get_compile_time_arg_val(5);
+    constexpr uint32_t vt = full_vt / workers_per_head;
+    constexpr uint32_t state_tiles = kt * vt;
+    constexpr uint32_t tile_bytes = 4096;
+
+    const uint32_t worker = get_arg_val<uint32_t>(0);
+    const uint32_t query_address = get_arg_val<uint32_t>(1);
+    const uint32_t key_address = get_arg_val<uint32_t>(2);
+    const uint32_t value_address = get_arg_val<uint32_t>(3);
+    const uint32_t beta_logits_address = get_arg_val<uint32_t>(4);
+    const uint32_t delta_time_address = get_arg_val<uint32_t>(5);
+    const uint32_t a_log_address = get_arg_val<uint32_t>(6);
+    const uint32_t dt_bias_address = get_arg_val<uint32_t>(7);
+    const uint32_t state_address = get_arg_val<uint32_t>(8);
+    const uint32_t state_indices_address = get_arg_val<uint32_t>(9);
+    const uint32_t has_initial_state_address = get_arg_val<uint32_t>(10);
+
+    constexpr auto query_args = TensorAccessorArgs<6>();
+    constexpr auto key_args = TensorAccessorArgs<query_args.next_compile_time_args_offset()>();
+    constexpr auto value_args = TensorAccessorArgs<key_args.next_compile_time_args_offset()>();
+    constexpr auto beta_logits_args = TensorAccessorArgs<value_args.next_compile_time_args_offset()>();
+    constexpr auto delta_time_args = TensorAccessorArgs<beta_logits_args.next_compile_time_args_offset()>();
+    constexpr auto a_log_args = TensorAccessorArgs<delta_time_args.next_compile_time_args_offset()>();
+    constexpr auto dt_bias_args = TensorAccessorArgs<a_log_args.next_compile_time_args_offset()>();
+    constexpr auto state_args = TensorAccessorArgs<dt_bias_args.next_compile_time_args_offset()>();
+    constexpr auto state_indices_args = TensorAccessorArgs<state_args.next_compile_time_args_offset()>();
+    constexpr auto has_initial_state_args =
+        TensorAccessorArgs<state_indices_args.next_compile_time_args_offset()>();
+    const auto query = TensorAccessor(query_args, query_address, tile_bytes);
+    const auto key = TensorAccessor(key_args, key_address, tile_bytes);
+    const auto value = TensorAccessor(value_args, value_address, tile_bytes);
+    const auto beta_logits = TensorAccessor(beta_logits_args, beta_logits_address, tile_bytes);
+    const auto delta_time = TensorAccessor(delta_time_args, delta_time_address, tile_bytes);
+    const auto a_log = TensorAccessor(a_log_args, a_log_address, tile_bytes);
+    const auto dt_bias = TensorAccessor(dt_bias_args, dt_bias_address, tile_bytes);
+    const auto state = TensorAccessor(state_args, state_address, tile_bytes);
+    constexpr uint32_t index_tile_bytes = 4096;
+    constexpr uint32_t flag_tile_bytes = 2048;
+    const auto state_indices =
+        TensorAccessor(state_indices_args, state_indices_address, index_tile_bytes);
+    const auto has_initial_state =
+        TensorAccessor(has_initial_state_args, has_initial_state_address, flag_tile_bytes);
+
+    CircularBuffer state_cb(tt::CBIndex::c_0);
+    CircularBuffer query_cb(tt::CBIndex::c_1);
+    CircularBuffer key_cb(tt::CBIndex::c_2);
+    CircularBuffer value_cb(tt::CBIndex::c_3);
+    CircularBuffer delta_time_cb(tt::CBIndex::c_4);
+    CircularBuffer beta_logits_cb(tt::CBIndex::c_5);
+    CircularBuffer key_transposed_cb(tt::CBIndex::c_9);
+    CircularBuffer a_log_cb(tt::CBIndex::c_13);
+    CircularBuffer dt_bias_cb(tt::CBIndex::c_14);
+    CircularBuffer state_indices_cb(tt::CBIndex::c_15);
+    CircularBuffer has_initial_state_cb(tt::CBIndex::c_17);
+    Noc noc;
+
+    // Metadata is shared by every head handled by this core.
+    state_indices_cb.reserve_back(1);
+    has_initial_state_cb.reserve_back(1);
+    noc.async_read(state_indices, state_indices_cb, index_tile_bytes,
+                   {.page_id = 0}, {.offset_bytes = 0});
+    noc.async_read(has_initial_state, has_initial_state_cb, flag_tile_bytes,
+                   {.page_id = 0}, {.offset_bytes = 0});
+    noc.async_read_barrier();
+
+    for (uint32_t work = worker; work < batch_size * num_heads * workers_per_head; work += num_workers) {
+    const uint32_t head_work = work / workers_per_head;
+    const uint32_t column_start = (work % workers_per_head) * vt;
+    const uint32_t batch = head_work / num_heads;
+    const uint32_t head = head_work % num_heads;
+
+    const uint32_t state_slot =
+        read_index(state_indices_cb.get_write_ptr(), batch);
+    const bool has_state =
+        read_flag(has_initial_state_cb.get_write_ptr(), batch);
+
+    const uint32_t state_base = (state_slot * num_heads + head) * kt * full_vt;
+    state_cb.reserve_back(state_tiles);
+    if (has_state) {
+        for (uint32_t row = 0; row < kt; ++row) {
+            for (uint32_t column = 0; column < vt; ++column) {
+                const uint32_t local_tile = row * vt + column;
+                noc.async_read(
+                    state,
+                    state_cb,
+                    tile_bytes,
+                    {.page_id = state_base + row * full_vt + column_start + column},
+                    {.offset_bytes = local_tile * tile_bytes});
+            }
+        }
+    } else {
+        noc.async_write_zeros(state_cb, state_tiles * tile_bytes);
+    }
+
+    const uint32_t head_tile = batch * ((num_heads + 31) / 32) + head / 32;
+    read_vector(noc, query, query_cb, head_tile * kt, head % 32, kt);
+
+    key_transposed_cb.reserve_back(kt);
+    read_vector(noc, key, key_cb, head_tile * kt, head % 32, kt);
+
+    read_vector(noc, value, value_cb,
+                head_tile * full_vt + column_start, head % 32, vt);
+
+    const uint32_t scalar_page =
+        (batch / 32) * ((num_heads + 31) / 32) + head / 32;
+    const uint32_t scalar_row = batch % 32;
+    const uint32_t scalar_column = head % 32;
+    read_scalar(noc, beta_logits, beta_logits_cb, scalar_page, scalar_row, scalar_column);
+    read_scalar(noc, delta_time, delta_time_cb, scalar_page, scalar_row, scalar_column);
+    read_scalar(noc, a_log, a_log_cb, head / 32, 0, scalar_column);
+    read_scalar(noc, dt_bias, dt_bias_cb, head / 32, 0, scalar_column);
+    noc.async_write_zeros(key_transposed_cb, kt * tile_bytes);
+    noc.async_read_barrier();
+    noc.write_zeros_l1_barrier();
+    state_cb.push_back(state_tiles);
+    query_cb.push_back(kt);
+    for (uint32_t tile = 0; tile < kt; ++tile) {
+        transpose_row_tile(
+            key_cb.get_write_ptr() + tile * tile_bytes,
+            key_transposed_cb.get_write_ptr() + tile * tile_bytes);
+    }
+    key_cb.push_back(kt);
+    key_transposed_cb.push_back(kt);
+    value_cb.push_back(vt);
+    make_scalar_tile(noc, beta_logits_cb, scalar_row, scalar_column);
+    beta_logits_cb.push_back(1);
+    make_scalar_tile(noc, delta_time_cb, scalar_row, scalar_column);
+    delta_time_cb.push_back(1);
+    make_scalar_tile(noc, a_log_cb, 0, scalar_column);
+    a_log_cb.push_back(1);
+    make_scalar_tile(noc, dt_bias_cb, 0, scalar_column);
+    dt_bias_cb.push_back(1);
+    }
+}
