+template <DataFormat data_format, typename ValueType, typename CompareFunc>
+inline bool argmax_greater(ValueType a, ValueType b, CompareFunc compare_func) {
+    if constexpr (data_format == DataFormat::Float16_b || data_format == DataFormat::Float16 ||
+                  data_format == DataFormat::Float32) {
+        constexpr uint32_t magnitude_mask = data_format == DataFormat::Float32 ? 0x7FFFFFFF : 0x7FFF;
+        constexpr uint32_t infinity = data_format == DataFormat::Float32 ? 0x7F800000 :
+                                      data_format == DataFormat::Float16 ? 0x7C00 : 0x7F80;
+        const auto magnitude_a = a & magnitude_mask;
+        const auto magnitude_b = b & magnitude_mask;
+        if (magnitude_a > infinity || magnitude_b > infinity) {
+            return magnitude_a > infinity && magnitude_b <= infinity;
+        }
+        if ((magnitude_a | magnitude_b) == 0) {
+            return false;
+        }
+    }
+    return compare_func(a, b);
+}
