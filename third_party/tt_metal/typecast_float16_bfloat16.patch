+// Float16 and BFloat16 have no common 16-bit Dest format. Both conversions
+// read raw bits from UInt16 tiles, widen exactly to Float32 in registers and
+// store the rounded raw bits of the other format.
+template <bool APPROXIMATION_MODE, int ITERATIONS>
+inline void cast_fp16b_to_fp16a() {
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vUInt bits(
+            sfpi::dst_reg[0].mode<sfpi::DataLayout::U32>());
+        sfpi::vFloat x = sfpi::as<sfpi::vFloat>((bits & 0xffffU) << 16);
+        sfpi::vUInt halfBits = float32_to_float16_bits_rne(x);
+        __builtin_rvtt_sfpstore(
+            halfBits.get(), 0, 9 /* swap high/low 16 */, ADDR_MOD_6);
+    }
+}
+
+template <bool APPROXIMATION_MODE, int ITERATIONS>
+inline void cast_fp16a_to_fp16b() {
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vUInt bits(
+            sfpi::dst_reg[0].mode<sfpi::DataLayout::U32>());
+        sfpi::vUInt wide = float16_to_float32_bits(bits & 0xffffU);
+        // Round to nearest even. NaNs keep their sign and stay quiet NaNs,
+        // even when their payload lies only in the discarded bits.
+        sfpi::vUInt bfloatBits = (wide + 0x7fffU + ((wide >> 16) & 1U)) >> 16;
+        v_if((wide & 0x7fffffffU) > 0x7f800000U) {
+            bfloatBits = (wide >> 16) | 0x40U;
+        }
+        v_endif;
+        __builtin_rvtt_sfpstore(
+            bfloatBits.get(), 0, 9 /* swap high/low 16 */, ADDR_MOD_6);
+    }
+}
+
 }  // namespace sfpu
 }  // namespace ckernel
