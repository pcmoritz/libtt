diff --git tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_sign.h tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_sign.h
--- tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_sign.h
+++ tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_sign.h
@@ -30,6 +30,8 @@ inline void calculate_sign(const uint /*exponent_size_8*/) {
         sfpi::vFloat res = sfpi::copysgn(sfpi::vFloat(1.0f), v);
         // SFPSETCC is unspecified for -0.0 (VectorUnit.md), so a bare compare can miss it.
         v_if(sfpi::abs(v) == 0.0F) { res = 0.0f; }
+        // sign(NaN) is NaN.
+        v_elseif(sfpi::is_nan(v)) { res = v; }
         v_endif;
         sfpi::dst_reg[0] = res;
         sfpi::dst_reg++;
