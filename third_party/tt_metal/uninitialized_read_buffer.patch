+namespace {
+template <typename T>
+HostBuffer uninitialized_host_buffer(size_t size_bytes) {
+    const size_t count = size_bytes / sizeof(T);
+    std::shared_ptr<T[]> data = std::make_shared_for_overwrite<T[]>(count);
+    return HostBuffer(ttsl::Span<T>(data.get(), count), MemoryPin(std::shared_ptr<void>(data, data.get())));
+}
+}  // namespace
+
+HostBuffer allocate_uninitialized_host_buffer(const TensorSpec& tensor_spec) {
+    const size_t size_bytes = tensor_spec.compute_packed_buffer_size_bytes();
+    switch (tensor_spec.data_type()) {
+        case DataType::BFLOAT16: return uninitialized_host_buffer<bfloat16>(size_bytes);
+        case DataType::FLOAT16: return uninitialized_host_buffer<float16>(size_bytes);
+        case DataType::FLOAT32: return uninitialized_host_buffer<float>(size_bytes);
+        case DataType::INT32: return uninitialized_host_buffer<int32_t>(size_bytes);
+        case DataType::FP8_E4M3: return uninitialized_host_buffer<float8_e4m3>(size_bytes);
+        case DataType::UINT8: return uninitialized_host_buffer<uint8_t>(size_bytes);
+        case DataType::UINT16: return uninitialized_host_buffer<uint16_t>(size_bytes);
+        case DataType::BFLOAT4_B:
+        case DataType::BFLOAT8_B:
+        case DataType::UINT32: return uninitialized_host_buffer<uint32_t>(size_bytes);
+        case DataType::INVALID: TT_THROW("Invalid data type");
+    }
+    TT_THROW("Unreachable");
+}
+
