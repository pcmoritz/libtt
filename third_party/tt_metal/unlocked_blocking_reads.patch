+void FDMeshCommandQueue::wait_for_host_event_unlocked(const MeshEvent& event) {
+    // The reader thread processes the completion queue in order, so once it has seen the event, it has
+    // also copied every read queued before it.
+    auto event_done = [&] {
+        bool done = true;
+        for_each_local(mesh_device_, event.device_range(), [&](const auto& coord) {
+            done = done && mesh_device_->impl().get_device(coord)->sysmem_manager().get_last_completed_event(
+                               event.mesh_cq_id()) >= event.id();
+        });
+        return done;
+    };
+    const bool poll_watcher = this->watcher_test_mode_enabled();
+    constexpr auto watcher_poll_interval = std::chrono::milliseconds(100);
+    auto next_watcher_poll = std::chrono::steady_clock::now() + watcher_poll_interval;
+    while (!event_done()) {
+        if (poll_watcher && std::chrono::steady_clock::now() >= next_watcher_poll) {
+            // Sets the failure state below if the watcher has caught an error.
+            this->poll_watcher_error_in_test_mode();
+            next_watcher_poll = std::chrono::steady_clock::now() + watcher_poll_interval;
+        }
+        if (thread_exception_state_.load() || exit_condition_.load()) {
+            this->throw_read_failure();
+        }
+        std::this_thread::yield();
+    }
+}
+
+void FDMeshCommandQueue::throw_read_failure() {
+    // Every waiter fails. The stored exception is left for finish(), which rethrows and clears it; once it
+    // is gone, waiters report a generic failure.
+    std::exception_ptr exception;
+    {
+        std::lock_guard<std::mutex> exception_lock(exception_mutex_);
+        exception = thread_exception_ptr_;
+    }
+    if (exception) {
+        std::rethrow_exception(exception);
+    }
+    TT_THROW("Mesh command queue {} stopped before a blocking read completed", id_);
+}
