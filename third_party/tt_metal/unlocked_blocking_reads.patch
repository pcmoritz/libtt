+
+void FDMeshCommandQueue::wait_for_host_event_unlocked(const MeshEvent& event) {
+    // The reader thread processes the completion queue in order, so once it has seen the event, it has
+    // also copied every read queued before it.
+    auto event_done = [&] {
+        bool done = true;
+        for_each_local(mesh_device_, event.device_range(), [&](const auto& coord) {
+            done = done && mesh_device_->impl().get_device(coord)->sysmem_manager().get_last_completed_event(event.mesh_cq_id()) >=
+                               event.id();
+        });
+        return done;
+    };
+    while (!event_done()) {
+        if (thread_exception_state_.load()) {
+            // Rethrows the reader thread's exception.
+            auto lock = lock_api_function_();
+            this->finish_nolock();
+            return;
+        }
+        std::this_thread::yield();
+    }
+}
