+// The W kernel assigns tile rows to cores. Split only into otherwise idle cores,
+// balancing W / chunks tiles of partial work against chunks partial results.
+static uint32_t get_width_chunks(
+    uint32_t tile_rows, uint32_t width_tiles, uint32_t cores) {
+    if (tile_rows == 0) {
+        return 1;
+    }
+
+    uint32_t best_chunks = 1;
+    uint32_t best_cost = width_tiles;  // Unsplit: no combining stage.
+
+    for (uint32_t chunks = 2; chunks <= cores / tile_rows; ++chunks) {
+        if (width_tiles % chunks != 0) {
+            continue;
+        }
+
+        const uint32_t cost = width_tiles / chunks + chunks;
+        if (cost < best_cost) {
+            best_chunks = chunks;
+            best_cost = cost;
+        }
+    }
+    return best_chunks;
+}
