+    auto lock = lock_api_function_();
+    TT_FATAL(trace_id_.has_value(), "Trace cases can only be recorded while a trace is being captured");
+    // A case boundary resets every sub-device, as reset_worker_dispatch_state_on_device does, while a replay accounts
+    // only for the sub-devices its trace uses.
+    TT_FATAL(mesh_device_->num_sub_devices() == 1, "Trace cases need a mesh device with a single sub-device");
