+// Skips forward in the exec_buf, always or unless a device value matches. The skipped commands are paged in like any
+// others but consumed unread: they launch nothing, and the data they would relay is never fetched.
+static uint32_t process_exec_buf_skip_cmd(uintptr_t& cmd_ptr, PrefetchExecBufState& exec_buf_state) {
+    volatile CQPrefetchCmd tt_l1_ptr* cmd = reinterpret_cast<volatile CQPrefetchCmd tt_l1_ptr*>(cmd_ptr);
+    uint8_t mode = cmd->exec_buf_skip.mode;
+    uint32_t stride = CQ_PREFETCH_CMD_BARE_MIN_SIZE + load_aligned<uint32_t>(&cmd->exec_buf_skip.bytes);
+    if (mode != CQ_PREFETCH_EXEC_BUF_SKIP_ALWAYS) {
+        uint32_t value = load_aligned<uint32_t>(&cmd->exec_buf_skip.value);
+        uint32_t value_bits = cmd->exec_buf_skip.value_bits;
+        uint32_t mask = value_bits >= 32 ? 0xFFFFFFFF : (1u << value_bits) - 1;
+        uint32_t page_size = 1u << cmd->exec_buf_skip.log2_page_size;
+        auto addr_gen = TensorAccessor(
+            tensor_accessor::make_interleaved_dspec</*is_dram=*/true>(),
+            load_aligned<uint32_t>(&cmd->exec_buf_skip.base_addr),
+            page_size);
+        // Read the start of page 0 over this command, which is consumed, the way the exec_buf reads its own pages
+        // (L1 the NoC can write, aligned like the page). The read is counted before it is issued, so the barrier
+        // cannot pass before it lands, unlike the transaction-id barrier; it also waits for the exec_buf's read-ahead.
+        noc_read_with_state<DM_DEDICATED_NOC, read_cmd_buf, CQ_NOC_SNDL, CQ_NOC_SEND, CQ_NOC_WAIT>(
+            noc_index, addr_gen.get_noc_addr(0), cmd_ptr, CQ_PREFETCH_CMD_BARE_MIN_SIZE);
+        noc_async_read_barrier();
+        invalidate_l1_cache();
+        uint32_t index = *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(cmd_ptr);
+        if ((index & mask) == value) {
+            // The index selects the branch that follows: continue into it.
+            return CQ_PREFETCH_CMD_BARE_MIN_SIZE;
+        }
+    }
+    // Like a command that spans refills: consume whole chunks, and return the stride left in the last one.
+    while (stride > exec_buf_state.length) {
+        stride -= exec_buf_state.length;
+        cmd_ptr += exec_buf_state.length;
+        exec_buf_state.length = 0;
+        paged_read_into_cmddat_q(cmd_ptr, exec_buf_state);
+    }
+    return stride;
+}
