+    if (index) {
+        TT_FATAL(
+            index->device_local_config().buffer_type == BufferType::DRAM && std::has_single_bit(index->page_size()),
+            "A trace case index must be in an interleaved DRAM buffer with a power-of-two page size");
+        node.case_index_address = static_cast<uint32_t>(index->address());
+        node.case_index_log2_page_size = static_cast<uint8_t>(std::countr_zero(index->page_size()));
+        node.case_index_bits = index_bits;
+    }
+    trace_nodes_.push_back(std::move(node));
