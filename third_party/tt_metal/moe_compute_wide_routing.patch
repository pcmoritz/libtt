+namespace moe_ring::routing {
+// A token's routing row holds uint16 expert ids, or int32 ids as a router produces them, read as an id's low 16 bits
+// (a negative padding id lands past the experts).
+template <bool kWide>
+inline uint16_t expert_id(uint32_t row, uint32_t k) {
+    if constexpr (kWide) {
+        return static_cast<uint16_t>(reinterpret_cast<const uint32_t*>(row)[k] & 0xFFFF);
+    } else {
+        return reinterpret_cast<const uint16_t*>(row)[k];
+    }
+}
+}  // namespace moe_ring::routing
