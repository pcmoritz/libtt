+// binary_ng's MINIMUM/MAXIMUM have no UINT16 kernel and no mixed FLOAT16 kernel, so
+// those operands are compared in FLOAT32 and the result is cast back.
+Tensor run_promoted_min_max(
+    const Tensor& input_a,
+    const Tensor& input_b,
+    binary::BinaryOpType op_type,
+    const std::optional<const DataType>& output_dtype,
+    const std::optional<MemoryConfig>& memory_config,
+    const std::optional<Tensor>& optional_output_tensor,
+    ttsl::Span<const unary::EltwiseUnaryWithParam> post_activations,
+    ttsl::Span<const unary::EltwiseUnaryWithParam> lhs_activations,
+    ttsl::Span<const unary::EltwiseUnaryWithParam> rhs_activations) {
+    const bool has_float16 = input_a.dtype() == DataType::FLOAT16 || input_b.dtype() == DataType::FLOAT16;
+    const bool needs_promotion =
+        input_a.dtype() == DataType::UINT16 || input_b.dtype() == DataType::UINT16 ||
+        (has_float16 && input_a.dtype() != input_b.dtype());
+    if (!needs_promotion) {
+        return ttnn::detail::invoke_binary_ng(
+            input_a,
+            input_b,
+            op_type,
+            output_dtype,
+            memory_config,
+            optional_output_tensor,
+            post_activations,
+            lhs_activations,
+            rhs_activations);
+    }
+
+    const Tensor promoted_a = input_a.dtype() == DataType::FLOAT32 ? input_a : ttnn::typecast(input_a, DataType::FLOAT32);
+    const Tensor promoted_b = input_b.dtype() == DataType::FLOAT32 ? input_b : ttnn::typecast(input_b, DataType::FLOAT32);
+    const DataType result_dtype = output_dtype.value_or(input_a.dtype());
+    const bool needs_cast_back = result_dtype != DataType::FLOAT32;
+    Tensor result = ttnn::detail::invoke_binary_ng(
+        promoted_a,
+        promoted_b,
+        op_type,
+        std::nullopt,
+        memory_config,
+        needs_cast_back ? std::nullopt : optional_output_tensor,
+        post_activations,
+        lhs_activations,
+        rhs_activations);
+    if (!needs_cast_back) {
+        return result;
+    }
+    return ttnn::typecast(result, result_dtype, memory_config, optional_output_tensor);
+}
