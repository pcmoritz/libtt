+void AllocatorImpl::set_symmetric_dram(DeviceAddr base, DeviceAddr size_per_bank) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    symmetric_base_ = base;
+    symmetric_size_ = size_per_bank;
+}
+
+bool AllocatorImpl::has_symmetric_dram() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return symmetric_size_ > 0;
+}
+
+void AllocatorImpl::begin_symmetric_dram() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    TT_FATAL(symmetric_size_ > 0, "No symmetric DRAM region is set");
+    TT_FATAL(
+        symmetric_depth_ == 0 || symmetric_thread_ == std::this_thread::get_id(),
+        "Only one thread may allocate symmetric DRAM at a time");
+    if (symmetric_depth_++ == 0) {
+        symmetric_thread_ = std::this_thread::get_id();
+        symmetric_next_ = symmetric_base_;
+    }
+}
+
+void AllocatorImpl::end_symmetric_dram() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    TT_FATAL(symmetric_depth_ > 0, "No symmetric DRAM scope is open");
+    --symmetric_depth_;
+}
