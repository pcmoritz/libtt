@@ -5,6 +5,27 @@
 #pragma once
 
 #include "api/dataflow/dataflow_api.h"
+#include "ckernel.h"
+
+// Fills a tile in L1 with copies of its first face row, which the caller has written: the NoC
+// copies that row down the first face and then the first face over the other three, 18 NoC
+// reads instead of 512 (16-bit) or 1024 (32-bit) RISC stores.
+FORCE_INLINE void fill_tile_from_first_face_row(uint32_t l1_write_ptr, uint32_t row_bytes) {
+    constexpr uint32_t face_rows = 16;
+    const uint32_t face_bytes = face_rows * row_bytes;
+    // A baby-RISCV store can retire before its write lands in L1, and the RISC and the NoC reach
+    // L1 in no fixed order: read the last written word back before the NoC copies the row.
+    (void)ckernel::load_blocking(reinterpret_cast<volatile uint32_t*>(l1_write_ptr + row_bytes - 4));
+    const uint64_t src = get_noc_addr(l1_write_ptr);
+    for (uint32_t r = 1; r < face_rows; ++r) {
+        noc_async_read(src, l1_write_ptr + r * row_bytes, row_bytes);
+    }
+    noc_async_read_barrier();
+    for (uint32_t f = 1; f < 4; ++f) {
+        noc_async_read(src, l1_write_ptr + f * face_bytes, face_bytes);
+    }
+    noc_async_read_barrier();
+}
 
