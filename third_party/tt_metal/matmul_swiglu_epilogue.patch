+#include "matmul_swiglu_weights.hpp"
+
+// The whole activation row block stays resident in every core's L1. After a
+// single readiness handshake, stream it in chunks: the DRAM read of the next
+// chunk overlaps the multicast of the current one, and a counting semaphore
+// tells receivers how many chunks have landed. The odd weight K blocks for
+// this core follow on the same RISC.
+void kernel_main() {
+    const uint32_t input_addr = get_arg_val<uint32_t>(0);
+    const uint32_t dest_start_x = get_arg_val<uint32_t>(1);
+    const uint32_t dest_start_y = get_arg_val<uint32_t>(2);
+    const uint32_t dest_end_x = get_arg_val<uint32_t>(3);
+    const uint32_t dest_end_y = get_arg_val<uint32_t>(4);
+    const uint32_t num_dests = get_arg_val<uint32_t>(5);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(6);
+    const uint32_t core_n = get_arg_val<uint32_t>(7);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t half_Nt = get_named_compile_time_arg_val("half_Nt");
+    constexpr uint32_t per_core_N = get_named_compile_time_arg_val("per_core_N");
+    constexpr uint32_t in0_block_w = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t in1_block_tiles = in0_block_w * 2 * per_core_N;
+    constexpr auto input_args = TensorAccessorArgs<0>();
+    constexpr auto weight_args = TensorAccessorArgs<input_args.next_compile_time_args_offset()>();
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    static_assert(Kt % in0_mcast_w == 0);
+
+    const auto input = TensorAccessor(input_args, input_addr);
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const uint32_t n_start = core_n * per_core_N;
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    constexpr uint32_t tile_bytes = get_tile_size(cb_in0_id);
+    constexpr uint32_t chunk_bytes = in0_mcast_w * tile_bytes;
+
+    cb_in0.reserve_back(Kt);
+    const uint32_t base = cb_in0.get_write_ptr();
+    auto read_chunk = [&](uint32_t chunk) {
+        for (uint32_t k = 0; k < in0_mcast_w; ++k) {
+            const uint32_t tile = chunk * in0_mcast_w + k;
+            noc_async_read_tile(tile, input, base + tile * tile_bytes);
+        }
+    };
+
+    read_chunk(0);
+    noc.async_read_barrier();
+    sender_sem.wait(num_dests);
+    sender_sem.set(0);
+    for (uint32_t chunk = 0; chunk < num_chunks; ++chunk) {
+        if (chunk + 1 < num_chunks) {
+            read_chunk(chunk + 1);
+        }
+        if (num_dests > 0) {
+            const uint32_t addr = base + chunk * chunk_bytes;
+            MulticastEndpoint mcast_dst;
+            noc.async_write_multicast(
+                CoreLocalMem<uint32_t>(addr), mcast_dst, chunk_bytes, num_dests, {},
+                {.noc_x_start = dest_start_x, .noc_y_start = dest_start_y,
+                 .noc_x_end = dest_end_x, .noc_y_end = dest_end_y, .addr = addr}, true);
+#ifdef ARCH_BLACKHOLE
+            noc.async_writes_flushed();
+#endif
+            receiver_sem.set(chunk + 1);
+            receiver_sem.set_multicast(
+                noc, dest_start_x, dest_start_y, dest_end_x, dest_end_y, num_dests);
+        }
+        cb_in0.push_back(in0_mcast_w);
+        noc.async_read_barrier();
+    }
+    for (uint32_t k0 = in0_block_w; k0 < Kt; k0 += 2 * in0_block_w) {
+        cb_reserve_back(cb_weights, in1_block_tiles);
+        read_swiglu_weight_block<in0_block_w, per_core_N, half_Nt>(
+            weight, k0, n_start, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+        noc_async_read_barrier();
+        cb_push_back(cb_weights, in1_block_tiles);
+    }
+    noc.async_write_barrier();
+}
