+};
+
+// Core layout of the fused SwiGLU decode projection: output tiles split over
+// num_cores cores, per_core_N gate and per_core_N up tiles each.
+struct SwiGLULayout {
+    uint32_t num_cores;
+    uint32_t per_core_N;
+    uint32_t in0_block_w;
+    uint32_t in0_mcast_w;
+};
+
+// Layout for Kt activation tiles and half_Nt output tiles on a grid of
+// num_worker_cores, or nullopt if the fused program cannot handle the shape.
+std::optional<SwiGLULayout> swiglu_layout(uint32_t Kt, uint32_t half_Nt, uint32_t num_worker_cores);
+
+struct MatmulSwiGLUProgramFactory {
+    static tt::tt_metal::ProgramDescriptor create_descriptor(
+        const ttnn::prim::MatmulParams& operation_attributes,
+        const ttnn::prim::MatmulInputs& tensor_args,
         std::vector<ttnn::Tensor>& tensor_return_value,
         const std::optional<CoreRangeSet>& core_range_set = std::nullopt);
 };
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp
@@ -0,0 +1,62 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/matmul.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/compute/compute_kernel_api.h"
+
+void kernel_main() {
+    constexpr uint32_t in0_block_w = get_compile_time_arg_val(0);
+    constexpr uint32_t in0_block_tiles = get_compile_time_arg_val(1);
+    constexpr uint32_t in1_block_tiles = get_compile_time_arg_val(2);
+    constexpr uint32_t per_core_N = get_compile_time_arg_val(3);
+    constexpr uint32_t num_blocks = get_compile_time_arg_val(4);
+    constexpr uint32_t cb_in0 = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t cb_weights2 = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t combined_per_core_N = 2 * per_core_N;
+    constexpr uint32_t out_subblock_w = 2;
+    static_assert(combined_per_core_N > 0 && combined_per_core_N <= 8, "gate and up must fit in DST");
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_in0, cb_weights, cb_out);
+    matmul_block_init(cb_in0, cb_weights, 0, out_subblock_w, 1, in0_block_w);
+    // Both projections fit in DST; retain them across all K blocks.
+    tile_regs_acquire();
+    for (uint32_t block = 0; block < num_blocks; ++block) {
+        // Odd K blocks arrive through the second NOC's CB.
+        const uint32_t cb_block = (block & 1) ? cb_weights2 : cb_weights;
+        cb_wait_front(cb_in0, in0_block_tiles);
+        cb_wait_front(cb_block, in1_block_tiles);
+        for (uint32_t k = 0; k < in0_block_w; ++k) {
+            for (uint32_t offset = 0; offset < combined_per_core_N; offset += out_subblock_w) {
+                matmul_block(
+                    cb_in0, cb_block, k, k * combined_per_core_N + offset, offset,
+                    /*transpose=*/0, out_subblock_w, 1, in0_block_w);
+            }
+        }
+        cb_pop_front(cb_in0, in0_block_tiles);
+        cb_pop_front(cb_block, in1_block_tiles);
+    }
+
+    // Gate occupies the first per_core_N tiles, followed by up.
+    silu_tile_init();
+    for (uint32_t i = 0; i < per_core_N; ++i) {
+        silu_tile(i);
+    }
+    mul_binary_tile_init();
+    for (uint32_t i = 0; i < per_core_N; ++i) {
+        mul_binary_tile(i, per_core_N + i, i);
+    }
+    tile_regs_commit();
+    tile_regs_wait();
+    cb_reserve_back(cb_out, per_core_N);
+    for (uint32_t i = 0; i < per_core_N; ++i) {
+        pack_tile(i, cb_out);
+    }
+    cb_push_back(cb_out, per_core_N);
+    tile_regs_release();
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp
@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+
+// Reads one K block of this core's fused gate/up weight tiles into `ptr`.
+// Gate tiles come first, then up tiles, for each K row of the block.
+template <uint32_t in0_block_w, uint32_t per_core_N, uint32_t half_Nt, typename Accessor>
+FORCE_INLINE void read_swiglu_weight_block(
+    const Accessor& weight, uint32_t k0, uint32_t n_start, uint32_t ptr, uint32_t tile_bytes) {
+    constexpr uint32_t fused_Nt = 2 * half_Nt;
+    constexpr uint32_t combined_per_core_N = 2 * per_core_N;
+    for (uint32_t k = 0; k < in0_block_w; ++k) {
+        const uint32_t up_row = (k0 + k) * fused_Nt + n_start;
+        const uint32_t gate_row = up_row + half_Nt;
+        for (uint32_t n = 0; n < per_core_N; ++n) {
+            const uint32_t gate_local = (k * combined_per_core_N + n) * tile_bytes;
+            const uint32_t up_local = gate_local + per_core_N * tile_bytes;
+            noc_async_read_tile(gate_row + n, weight, ptr + gate_local);
+            noc_async_read_tile(up_row + n, weight, ptr + up_local);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "matmul_swiglu_weights.hpp"
+
+// Streams the even K blocks of this core's weights on RISCV_0's NOC, then
+// writes the SwiGLU output tiles.
+void kernel_main() {
+    const uint32_t weight_addr = get_arg_val<uint32_t>(0);
+    const uint32_t output_addr = get_arg_val<uint32_t>(1);
+    const uint32_t core_n = get_arg_val<uint32_t>(2);
+
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t half_Nt = get_named_compile_time_arg_val("half_Nt");
+    constexpr uint32_t per_core_N = get_named_compile_time_arg_val("per_core_N");
+    constexpr uint32_t in0_block_w = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t in1_block_tiles = in0_block_w * 2 * per_core_N;
+
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    constexpr auto output_args = TensorAccessorArgs<weight_args.next_compile_time_args_offset()>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const auto output = TensorAccessor(output_args, output_addr);
+    const uint32_t n_start = core_n * per_core_N;
+
+    for (uint32_t k0 = 0; k0 < Kt; k0 += 2 * in0_block_w) {
+        cb_reserve_back(cb_weights, in1_block_tiles);
+        read_swiglu_weight_block<in0_block_w, per_core_N, half_Nt>(
+            weight, k0, n_start, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+        noc_async_read_barrier();
+        cb_push_back(cb_weights, in1_block_tiles);
+    }
+
+    Noc noc;
+    CircularBuffer out_cb(cb_out);
+    const uint32_t page_bytes = get_local_cb_interface(cb_out).fifo_page_size;
+    for (uint32_t n = 0; n < per_core_N; ++n) {
+        out_cb.wait_front(1);
+        noc.async_write(out_cb, output, page_bytes, {}, {.page_id = n_start + n});
+        noc.async_writes_flushed();
+        out_cb.pop_front(1);
+    }
+    noc.async_write_barrier();
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu_in0_receiver.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu_in0_receiver.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu_in0_receiver.cpp
@@ -0,0 +1,67 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "matmul_swiglu_weights.hpp"
+
+void kernel_main() {
+    const uint32_t sender_x = get_arg_val<uint32_t>(0);
+    const uint32_t sender_y = get_arg_val<uint32_t>(1);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(2);
+    const uint32_t core_n = get_arg_val<uint32_t>(3);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t half_Nt = get_named_compile_time_arg_val("half_Nt");
+    constexpr uint32_t per_core_N = get_named_compile_time_arg_val("per_core_N");
+    constexpr uint32_t in0_block_w = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    constexpr uint32_t in1_block_tiles = in0_block_w * 2 * per_core_N;
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const uint32_t n_start = core_n * per_core_N;
+
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    volatile tt_l1_ptr uint32_t* chunks_landed =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_semaphore(receiver_sem_id));
+
+    // The CB holds all Kt tiles, so one handshake covers every chunk.
+    cb_in0.reserve_back(Kt);
+    receiver_sem.set(0);
+    sender_sem.up(noc, sender_x, sender_y, 1);
+
+    // Publish activation chunks as they land, and stream the odd weight K
+    // blocks on this RISC's NOC without blocking on weight CB space while
+    // activation chunks are still pending.
+    uint32_t chunks = 0;
+    uint32_t k0 = in0_block_w;
+    while (chunks < num_chunks || k0 < Kt) {
+        if (chunks < num_chunks) {
+            invalidate_l1_cache();
+            if (*chunks_landed > chunks) {
+                cb_in0.push_back(in0_mcast_w);
+                ++chunks;
+                continue;
+            }
+        }
+        if (k0 < Kt && (chunks == num_chunks || cb_pages_reservable_at_back(cb_weights, in1_block_tiles))) {
+            cb_reserve_back(cb_weights, in1_block_tiles);
+            read_swiglu_weight_block<in0_block_w, per_core_N, half_Nt>(
+                weight, k0, n_start, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+            noc_async_read_barrier();
+            cb_push_back(cb_weights, in1_block_tiles);
+            k0 += 2 * in0_block_w;
+        }
+    }
+}
