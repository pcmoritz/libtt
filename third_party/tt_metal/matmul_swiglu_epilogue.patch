diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_swiglu.cpp
@@ -0,0 +1,70 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/matmul.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/compute/compute_kernel_api.h"
+
+// silu(gate) * up for this core's output tile pairs. Each group of up to
+// `group` pairs accumulates the full K reduction in FP32 DST; the activation
+// stays resident, so later groups reuse it.
+void kernel_main() {
+    const uint32_t count = get_arg_val<uint32_t>(0);
+
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr uint32_t cb_in0 = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_weights2 = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t block_tiles = kblock * 2 * group;
+    static_assert(group > 0 && 2 * group <= 8, "gate and up must fit in FP32 DST");
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_in0, cb_weights, cb_out);
+    uint32_t in0_ready = 0;
+    uint32_t index = 0;
+    for (uint32_t group_start = 0; group_start < count; group_start += group) {
+        const uint32_t width = count - group_start < group ? count - group_start : group;
+        matmul_block_init(cb_in0, cb_weights, 0, /*ct_dim=*/2, /*rt_dim=*/1, kblock);
+        tile_regs_acquire();
+        for (uint32_t k0 = 0; k0 < Kt; k0 += kblock, ++index) {
+            // Odd blocks arrive through the second NOC's CB.
+            const uint32_t cb_block = (index & 1) ? cb_weights2 : cb_weights;
+            if (in0_ready < k0 + kblock) {
+                in0_ready = k0 + kblock;
+                cb_wait_front(cb_in0, in0_ready);
+            }
+            cb_wait_front(cb_block, block_tiles);
+            for (uint32_t k = 0; k < kblock; ++k) {
+                for (uint32_t offset = 0; offset < 2 * width; offset += 2) {
+                    matmul_block(cb_in0, cb_block, k0 + k, k * 2 * width + offset, offset, /*transpose=*/0, 2, 1,
+                                 kblock);
+                }
+            }
+            cb_pop_front(cb_block, block_tiles);
+        }
+
+        // Gate occupies the first `width` DST tiles, followed by up.
+        silu_tile_init();
+        for (uint32_t i = 0; i < width; ++i) {
+            silu_tile(i);
+        }
+        mul_binary_tile_init();
+        for (uint32_t i = 0; i < width; ++i) {
+            mul_binary_tile(i, width + i, i);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        cb_reserve_back(cb_out, width);
+        for (uint32_t i = 0; i < width; ++i) {
+            pack_tile(i, cb_out);
+        }
+        cb_push_back(cb_out, width);
+        tile_regs_release();
+    }
+    cb_pop_front(cb_in0, Kt);
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp
@@ -0,0 +1,60 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+
+// Weight blocks of one SwiGLU core in consumption order. The core's output
+// tile pairs are processed in groups of up to `group` (bounded by DST), and
+// each group walks K in blocks of `kblock` tiles. Even blocks travel on
+// RISCV_0's NOC and odd blocks on RISCV_1's. Every block occupies
+// kblock * 2 * group CB tiles, so a narrower last group keeps the CB block
+// size constant.
+template <uint32_t Kt, uint32_t kblock, uint32_t group>
+struct SwiGLUBlocks {
+    uint32_t count;
+    uint32_t group_start = 0;
+    uint32_t k0 = 0;
+    uint32_t index = 0;
+
+    bool done() const { return group_start >= count; }
+    uint32_t width() const { return count - group_start < group ? count - group_start : group; }
+    void next() {
+        k0 += kblock;
+        if (k0 >= Kt) {
+            k0 = 0;
+            group_start += group;
+        }
+        ++index;
+    }
+    // Moves to the first or next block with index % 2 == parity.
+    void seek(uint32_t parity) {
+        while (!done() && (index & 1) != parity) {
+            next();
+        }
+    }
+    void next_owned(uint32_t parity) {
+        next();
+        seek(parity);
+    }
+};
+
+// Reads one block: for each K row, the group's gate tiles followed by its up
+// tiles. Up columns are the first half of the fused weight, gate the second.
+template <uint32_t Kt, uint32_t kblock, uint32_t group, typename Accessor>
+FORCE_INLINE void read_swiglu_weight_block(
+    const Accessor& weight, uint32_t half_Nt, uint32_t n_start, const SwiGLUBlocks<Kt, kblock, group>& block,
+    uint32_t ptr, uint32_t tile_bytes) {
+    const uint32_t width = block.width();
+    for (uint32_t k = 0; k < kblock; ++k) {
+        const uint32_t up_row = (block.k0 + k) * 2 * half_Nt + n_start + block.group_start;
+        const uint32_t gate_row = up_row + half_Nt;
+        for (uint32_t n = 0; n < width; ++n) {
+            const uint32_t gate_local = (k * 2 * width + n) * tile_bytes;
+            noc_async_read_tile(gate_row + n, weight, ptr + gate_local);
+            noc_async_read_tile(up_row + n, weight, ptr + gate_local + width * tile_bytes);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_swiglu.cpp
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "matmul_swiglu_weights.hpp"
+
+// Streams the even weight blocks of this core on RISCV_0's NOC, then writes
+// the core's SwiGLU output tiles.
+void kernel_main() {
+    const uint32_t weight_addr = get_arg_val<uint32_t>(0);
+    const uint32_t output_addr = get_arg_val<uint32_t>(1);
+    const uint32_t n_start = get_arg_val<uint32_t>(2);
+    const uint32_t count = get_arg_val<uint32_t>(3);
+
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t half_Nt = get_named_compile_time_arg_val("half_Nt");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr uint32_t block_tiles = kblock * 2 * group;
+
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    constexpr auto output_args = TensorAccessorArgs<weight_args.next_compile_time_args_offset()>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const auto output = TensorAccessor(output_args, output_addr);
+
+    SwiGLUBlocks<Kt, kblock, group> block{count};
+    for (block.seek(0); !block.done(); block.next_owned(0)) {
+        cb_reserve_back(cb_weights, block_tiles);
+        read_swiglu_weight_block(weight, half_Nt, n_start, block, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+        noc_async_read_barrier();
+        cb_push_back(cb_weights, block_tiles);
+    }
+
+    Noc noc;
+    CircularBuffer out_cb(cb_out);
+    const uint32_t page_bytes = get_local_cb_interface(cb_out).fifo_page_size;
+    for (uint32_t n = 0; n < count; ++n) {
+        out_cb.wait_front(1);
+        noc.async_write(out_cb, output, page_bytes, {}, {.page_id = n_start + n});
+        noc.async_writes_flushed();
+        out_cb.pop_front(1);
+    }
+    noc.async_write_barrier();
+}
