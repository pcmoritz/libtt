+// Keep the legacy unstable API separate: its callers provide only idir, and
+// descending is unused when stable_sort is false. Stable callers must pass the
+// global direction explicitly because their local idir alternates; combining
+// these overloads with defaults could silently derive it from the wrong idir.
+template <bool idir = false>
+ALWI void topk_merge(uint32_t idst, int m_iter, int k) {
+    topk_merge_impl<idir, false, !idir>(idst, m_iter, k);
+}
+
+template <bool idir, bool stable_sort, bool descending>
+ALWI void topk_merge(uint32_t idst, int m_iter, int k) {
+    topk_merge_impl<idir, stable_sort, descending>(idst, m_iter, k);
+}
