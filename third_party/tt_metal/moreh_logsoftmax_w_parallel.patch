+
+#include <cstdint>
+
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "api/dataflow/noc.h"
+#include "api/tensor/noc_traits.h"
+
+
+void kernel_main() {
+    const uint32_t dst_addr = get_arg_val<uint32_t>(0);
+    const uint32_t start_tile = get_arg_val<uint32_t>(1);
+    const uint32_t local_wt = get_arg_val<uint32_t>(2);
+
+    constexpr auto out_args = TensorAccessorArgs<0>();
+    const auto dst = TensorAccessor(out_args, dst_addr);
+
+    constexpr auto cb_out = tt::CBIndex::c_16;
+
+    DataflowBuffer output(cb_out);
+
+    const uint32_t tile_bytes = output.get_entry_size();
+    Noc noc;
+    for (uint32_t w = 0; w < local_wt; ++w) {
+        output.wait_front(1);
+        noc.async_write(
+            output, dst, tile_bytes, {.offset_bytes = 0}, {.page_id = start_tile + w});
+        noc.async_write_barrier();
+        output.pop_front(1);
+    }
+
+    noc.async_atomic_barrier();
+}
