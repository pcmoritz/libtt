+++ ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/moreh_logsoftmax_w_parallel.cpp
@@ -0,0 +1,113 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+
+#include "ttnn/cpp/ttnn/kernel_lib/reduce_helpers_compute.hpp"
+#include "ttnn/kernel/compute/moreh_common.hpp"
+#include "api/dataflow/dataflow_buffer.h"
+
+void kernel_main() {
+    constexpr auto cb_in0 = tt::CBIndex::c_0;
+    constexpr auto cb_mask = tt::CBIndex::c_1;
+    constexpr auto cb_max_scaler = tt::CBIndex::c_2;
+    constexpr auto cb_sum_scaler = tt::CBIndex::c_3;
+    constexpr auto cb_out0 = tt::CBIndex::c_16;
+    constexpr auto cb_exps = tt::CBIndex::c_24;
+    constexpr auto cb_partial_max = tt::CBIndex::c_25;
+    constexpr auto cb_partial_sum = tt::CBIndex::c_26;
+    constexpr auto cb_global_max = tt::CBIndex::c_27;
+    constexpr auto cb_global_logsum = tt::CBIndex::c_28;
+    constexpr auto cb_aggregate = tt::CBIndex::c_29;
+    constexpr auto cb_root_max = tt::CBIndex::c_30;
+    constexpr auto cb_root_logsum = tt::CBIndex::c_31;
+    constexpr auto cb_add = tt::CBIndex::c_20;
+    constexpr auto cb_tmp = tt::CBIndex::c_21;
+
+    DataflowBuffer input(cb_in0);
+    DataflowBuffer mask(cb_mask);
+    DataflowBuffer output(cb_out0);
+    DataflowBuffer exps(cb_exps);
+    DataflowBuffer partial_max(cb_partial_max);
+    DataflowBuffer partial_sum(cb_partial_sum);
+    DataflowBuffer global_max(cb_global_max);
+    DataflowBuffer global_logsum(cb_global_logsum);
+    DataflowBuffer aggregate(cb_aggregate);
+    DataflowBuffer root_max(cb_root_max);
+    DataflowBuffer root_logsum(cb_root_logsum);
+    DataflowBuffer add(cb_add);
+    DataflowBuffer tmp(cb_tmp);
+
+    constexpr uint32_t local_wt = get_compile_time_arg_val(0);
+    constexpr bool is_root = get_compile_time_arg_val(1) == 1;
+    constexpr uint32_t num_cores = get_compile_time_arg_val(2);
+
+    binary_op_init_common(cb_in0, cb_max_scaler, cb_out0);
+
+    // Each core reduces one contiguous width shard to a partial maximum.
+    if constexpr (local_wt == 1) {
+        mask_tile_to_cb(input, mask, tmp, 0, 0, /*pop0=*/1, /*popm=*/0);
+        compute_kernel_lib::reduce<PoolType::MAX, ReduceDim::REDUCE_ROW, cb_tmp, cb_max_scaler, cb_partial_max>(
+            compute_kernel_lib::ReduceInputBlockShape::single());
+    } else {
+        compute_kernel_lib::reduce<PoolType::MAX, ReduceDim::REDUCE_ROW, cb_in0, cb_max_scaler, cb_partial_max>(
+            compute_kernel_lib::ReduceInputBlockShape::row(local_wt - 1));
+        mask_tile_to_cb(input, mask, tmp, 0, 0, /*pop0=*/1, /*popm=*/0);
+        compute_kernel_lib::reduce<PoolType::MAX, ReduceDim::REDUCE_ROW, cb_tmp, cb_max_scaler, cb_partial_max>(
+            compute_kernel_lib::ReduceInputBlockShape::single(),
+            compute_kernel_lib::ReduceInputMemoryLayout::contiguous(),
+            compute_kernel_lib::Accumulate::at(cb_partial_max, /*iteration=*/1));
+    }
+
+    // Core 0 combines all partial maxima. The reader broadcasts the result.
+    if constexpr (is_root) {
+        compute_kernel_lib::reduce<PoolType::MAX, ReduceDim::REDUCE_ROW, cb_aggregate, cb_max_scaler, cb_root_max>(
+            compute_kernel_lib::ReduceInputBlockShape::row(num_cores));
+    }
+
+    global_max.wait_front(1);
+
+    // Compute a partial sum(exp(x - global_max)) for this width shard.
+    for (uint32_t w = 0; w < local_wt; ++w) {
+        sub_tiles_bcast_cols_to_cb(input, global_max, tmp, 0, 0, /*pop0=*/1, /*pop1=*/0);
+        exp_tile_to_cb(tmp, exps);
+        if (w == 0) {
+            copy_tile_to_cb(exps, add);
+        } else {
+            add_tiles_to_cb(add, exps, add);
+        }
+    }
+
+    compute_kernel_lib::reduce<PoolType::SUM, ReduceDim::REDUCE_ROW, cb_add, cb_sum_scaler, cb_partial_sum>(
+        compute_kernel_lib::ReduceInputBlockShape::single());
+
+    // Core 0 combines the partial sums and computes log(sum).
+    if constexpr (is_root) {
+        compute_kernel_lib::reduce<
+            PoolType::SUM,
+            ReduceDim::REDUCE_ROW,
+            cb_aggregate,
+            cb_sum_scaler,
+            cb_root_logsum,
+            compute_kernel_lib::ReduceInputPolicy::BulkWaitBulkPop>(
+            compute_kernel_lib::ReduceInputBlockShape::row(num_cores),
+            compute_kernel_lib::ReduceInputMemoryLayout::contiguous(),
+            compute_kernel_lib::NoAccumulation{},
+            [](uint32_t dst_idx) {
+                log_tile_init();
+                log_tile(dst_idx);
+            });
+    }
+
+    global_logsum.wait_front(1);
+
+    // Produce x - global_max - log(global_sum) for this core's width shard.
+    for (uint32_t w = 0; w < local_wt; ++w) {
+        sub_tiles_bcast_cols_to_cb(input, global_max, tmp, 0, 0, /*pop0=*/1, /*pop1=*/0);
+        sub_tiles_bcast_cols_to_cb(tmp, global_logsum, output, 0, 0, /*pop0=*/1, /*pop1=*/0);
+    }
+
+    global_logsum.pop_front(1);
+    global_max.pop_front(1);
+}
diff --git ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/reader_moreh_logsoftmax_w_parallel.cpp ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/reader_moreh_logsoftmax_w_parallel.cpp
new file mode 100644
index 0000000..264d91f
--- /dev/null
+++ ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/reader_moreh_logsoftmax_w_parallel.cpp
@@ -0,0 +1,213 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+
+#include "ttnn/kernel/dataflow/moreh_common.hpp"
+#include "ttnn/cpp/ttnn/kernel_lib/reduce_helpers_dataflow.hpp"
+#include "api/dataflow/dataflow_buffer.h"
+#include "api/dataflow/endpoints.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "api/tensor/noc_traits.h"
+
+namespace {
+template <typename Accessor>
+inline __attribute__((always_inline)) void read_width_shard(
+    Noc& noc,
+    const Accessor& src,
+    DataflowBuffer& input,
+    uint32_t start_tile,
+    uint32_t local_wt,
+    uint32_t tile_bytes) {
+    for (uint32_t w = 0; w < local_wt; ++w) {
+        input.reserve_back(1);
+        noc.async_read(src, input, tile_bytes, {.page_id = start_tile + w}, {.offset_bytes = 0});
+        noc.async_read_barrier();
+        input.push_back(1);
+    }
+}
+
+inline __attribute__((always_inline)) void send_partial(
+    Noc& noc,
+    Semaphore<>& partial_done_sem,
+    DataflowBuffer& partial,
+    uint32_t aggregate_base,
+    uint32_t aggregate_tile_offset,
+    uint32_t core_index,
+    uint32_t root_x,
+    uint32_t root_y) {
+    partial.wait_front(1);
+
+    const uint32_t tile_bytes = partial.get_entry_size();
+    noc.async_write(
+        partial,
+        UnicastEndpoint{},
+        tile_bytes,
+        {.offset_bytes = 0},
+        {.noc_x = root_x,
+         .noc_y = root_y,
+         .addr = aggregate_base + (aggregate_tile_offset + core_index) * tile_bytes});
+    noc.async_write_barrier();
+    partial.pop_front(1);
+
+    partial_done_sem.up(noc, root_x, root_y, 1);
+    noc.async_atomic_barrier();
+}
+
+inline __attribute__((always_inline)) void broadcast_scalar(
+    Noc& noc,
+    Semaphore<>& broadcast_sem,
+    DataflowBuffer& source,
+    DataflowBuffer& destination,
+    uint32_t round,
+    uint32_t num_cores,
+    uint32_t mcast_x_start,
+    uint32_t mcast_y_start,
+    uint32_t mcast_x_end,
+    uint32_t mcast_y_end) {
+    source.wait_front(1);
+    const uint32_t tile_bytes = source.get_entry_size();
+
+    noc.async_write_multicast<NocOptions::MCAST_INCL_SRC>(
+        source,
+        MulticastEndpoint{},
+        tile_bytes,
+        num_cores,
+        {.offset_bytes = 0},
+        {.noc_x_start = mcast_x_start,
+         .noc_y_start = mcast_y_start,
+         .noc_x_end = mcast_x_end,
+         .noc_y_end = mcast_y_end,
+         .addr = destination.get_write_ptr()},
+        false);
+    noc.async_write_barrier();
+
+    broadcast_sem.set(round);
+    broadcast_sem.set_multicast(
+        noc, mcast_x_start, mcast_y_start, mcast_x_end, mcast_y_end, num_cores - 1);
+    noc.async_write_barrier();
+    source.pop_front(1);
+}
+}  // namespace
+
+void kernel_main() {
+    const uint32_t src_addr = get_arg_val<uint32_t>(0);
+    const uint32_t start_tile = get_arg_val<uint32_t>(1);
+    const uint32_t local_wt = get_arg_val<uint32_t>(2);
+    const uint32_t mask_w = get_arg_val<uint32_t>(3);
+    const bool is_root = get_arg_val<uint32_t>(4) == 1;
+    const uint32_t num_cores = get_arg_val<uint32_t>(5);
+    const uint32_t core_index = get_arg_val<uint32_t>(6);
+    const uint32_t root_x = get_arg_val<uint32_t>(7);
+    const uint32_t root_y = get_arg_val<uint32_t>(8);
+    const uint32_t mcast_x_start = get_arg_val<uint32_t>(9);
+    const uint32_t mcast_y_start = get_arg_val<uint32_t>(10);
+    const uint32_t mcast_x_end = get_arg_val<uint32_t>(11);
+    const uint32_t mcast_y_end = get_arg_val<uint32_t>(12);
+
+    constexpr bool is_fp32 = get_compile_time_arg_val(0) == 1;
+    constexpr auto in_args = TensorAccessorArgs<1>();
+    const auto src = TensorAccessor(in_args, src_addr);
+
+    constexpr auto cb_in = tt::CBIndex::c_0;
+    constexpr auto cb_mask = tt::CBIndex::c_1;
+    constexpr auto cb_max_scaler = tt::CBIndex::c_2;
+    constexpr auto cb_sum_scaler = tt::CBIndex::c_3;
+    constexpr auto cb_global_max = tt::CBIndex::c_27;
+    constexpr auto cb_partial_max = tt::CBIndex::c_25;
+    constexpr auto cb_partial_sum = tt::CBIndex::c_26;
+    constexpr auto cb_global_logsum = tt::CBIndex::c_28;
+    constexpr auto cb_aggregate = tt::CBIndex::c_29;
+
+    constexpr auto cb_root_max = tt::CBIndex::c_30;
+    constexpr auto cb_root_logsum = tt::CBIndex::c_31;
+    DataflowBuffer input(cb_in);
+    DataflowBuffer mask(cb_mask);
+    DataflowBuffer global_max(cb_global_max);
+    DataflowBuffer partial_max(cb_partial_max);
+    DataflowBuffer partial_sum(cb_partial_sum);
+    DataflowBuffer global_logsum(cb_global_logsum);
+    DataflowBuffer aggregate(cb_aggregate);
+    Noc noc;
+
+    DataflowBuffer root_max(cb_root_max);
+    DataflowBuffer root_logsum(cb_root_logsum);
+    Semaphore<> partial_done_sem(0);
+    Semaphore<> broadcast_sem(1);
+
+    dataflow_kernel_lib::
+        calculate_and_prepare_reduce_scaler<cb_max_scaler, ckernel::PoolType::MAX, ckernel::ReduceDim::REDUCE_ROW>();
+    dataflow_kernel_lib::
+        calculate_and_prepare_reduce_scaler<cb_sum_scaler, ckernel::PoolType::SUM, ckernel::ReduceDim::REDUCE_ROW>();
+
+    if constexpr (is_fp32) {
+        generate_mask_w<uint32_t>(mask, mask_w);
+    } else {
+        generate_mask_w<uint16_t>(mask, mask_w);
+    }
+
+    const uint32_t tile_bytes = input.get_entry_size();
+    const uint32_t aggregate_base = aggregate.get_write_ptr();
+
+    // Keep all collective traffic on this RISC. The root owns two fixed banks
+    // in the aggregate CB, one for each reduction.
+    global_max.reserve_back(1);
+    if (is_root) {
+        aggregate.reserve_back(num_cores);
+        partial_done_sem.set(0);
+    }
+
+    read_width_shard(noc, src, input, start_tile, local_wt, tile_bytes);
+    send_partial(
+        noc, partial_done_sem, partial_max, aggregate_base, 0, core_index, root_x, root_y);
+
+    if (is_root) {
+        partial_done_sem.wait(num_cores);
+        aggregate.push_back(num_cores);
+        aggregate.reserve_back(num_cores);
+        broadcast_scalar(
+            noc,
+            broadcast_sem,
+            root_max,
+            global_max,
+            1,
+            num_cores,
+            mcast_x_start,
+            mcast_y_start,
+            mcast_x_end,
+            mcast_y_end);
+    }
+
+    broadcast_sem.wait(1);
+    global_max.push_back(1);
+
+    // Stream the same shard again for the partial exponential sum.
+    read_width_shard(noc, src, input, start_tile, local_wt, tile_bytes);
+    global_logsum.reserve_back(1);
+    send_partial(
+        noc, partial_done_sem, partial_sum, aggregate_base, num_cores, core_index, root_x, root_y);
+
+    if (is_root) {
+        partial_done_sem.wait(2 * num_cores);
+        aggregate.push_back(num_cores);
+        broadcast_scalar(
+            noc,
+            broadcast_sem,
+            root_logsum,
+            global_logsum,
+            2,
+            num_cores,
+            mcast_x_start,
+            mcast_y_start,
+            mcast_x_end,
+            mcast_y_end);
+    }
+
+    broadcast_sem.wait(2);
+    global_logsum.push_back(1);
+
+    // Third and final read feeds the output stage.
+    read_width_shard(noc, src, input, start_tile, local_wt, tile_bytes);
+}
