index 0000000..9926157
--- /dev/null
+++ ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/softmax_w_parallel/softmax_w_parallel.cpp
@@ -0,0 +1,216 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/moreh/moreh_softmax/device/moreh_softmax_device_operation.hpp"
+
+#include <tt-metalium/tensor_accessor_args.hpp>
+
+#include "ttnn/operations/moreh/moreh_helper_functions.hpp"
+
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace ttnn::operations::moreh::moreh_softmax {
+
+tt::tt_metal::ProgramDescriptor MorehSoftmaxOperation::MorehSoftmaxWParallelFactory::create_descriptor(
+    const operation_attributes_t& operation_attributes,
+    const tensor_args_t& tensor_args,
+    tensor_return_value_t& output) {
+    using namespace tt;
+    using namespace tt::tt_metal;
+
+    const auto& input = tensor_args.input;
+    const auto& compute_kernel_config = operation_attributes.compute_kernel_config;
+    TT_FATAL(operation_attributes.op == MorehSoftmaxOp::LOGSOFTMAX, "Parallel W prototype only supports log-softmax");
+    TT_FATAL(input.dtype() == DataType::BFLOAT16, "Parallel W prototype only supports bfloat16");
+
+    auto* device = input.device();
+    const auto grid = device->compute_with_storage_grid_size();
+    TT_FATAL(grid.x >= 8 && grid.y >= 4, "Parallel W prototype requires at least an 8x4 worker grid");
+    const CoreRange core_range({0, 0}, {7, 3});
+
+    const auto shape = input.padded_shape();
+    const uint32_t h = shape[-2];
+    const uint32_t w = shape[-1];
+    const uint32_t ht = h / constants::TILE_HEIGHT;
+    const uint32_t wt = w / constants::TILE_WIDTH;
+    const uint32_t num_kernel_rows = input.physical_volume() / h / w * ht;
+    TT_FATAL(num_kernel_rows == 1, "Parallel W prototype requires exactly one tile row");
+
+    auto [num_cores, all_cores, core_group_1, core_group_2, wt_group_1, wt_group_2] =
+        split_work_to_cores_wt_core_range(core_range, wt);
+
+    const CoreCoord root_core = core_range.start_coord;
+    const CoreRangeSet root_range{CoreRange(root_core)};
+    const CoreRangeSet nonroot_group_1 = core_group_1.subtract(root_range);
+    const CoreRangeSet nonroot_group_2 = core_group_2.subtract(root_range);
+    const uint32_t root_wt = core_group_1.contains(root_core) ? wt_group_1 : wt_group_2;
+
+    const CoreCoord root_physical = device->worker_core_from_logical_core(root_core);
+    const CoreCoord mcast_start = device->worker_core_from_logical_core(core_range.start_coord);
+    const CoreCoord mcast_end = device->worker_core_from_logical_core(core_range.end_coord);
+    const uint32_t root_x = static_cast<uint32_t>(root_physical.x);
+    const uint32_t root_y = static_cast<uint32_t>(root_physical.y);
+    const uint32_t mcast_x_start = static_cast<uint32_t>(mcast_start.x);
+    const uint32_t mcast_y_start = static_cast<uint32_t>(mcast_start.y);
+    const uint32_t mcast_x_end = static_cast<uint32_t>(mcast_end.x);
+    const uint32_t mcast_y_end = static_cast<uint32_t>(mcast_end.y);
+
+    const auto arch = device->arch();
+    auto [math_fidelity, math_approx_mode, fp32_dest_acc_en, packer_l1_acc, dst_full_sync_en] =
+        get_compute_kernel_config_args(arch, compute_kernel_config);
+
+    // Keep the prototype's partial reductions and broadcasts in the input
+    // format. Mixing FP32 aggregate tiles with BF16 output currently leaves
+    // the packer in FP32 mode after the root reduction.
+    fp32_dest_acc_en = false;
+
+    const auto data_format = datatype_to_dataformat_converter(input.dtype());
+    const auto intermed_format = fp32_dest_acc_en ? DataFormat::Float32 : data_format;
+    const uint32_t data_tile_bytes = tile_size(data_format);
+    const uint32_t intermed_tile_bytes = tile_size(intermed_format);
+
+    ProgramDescriptor desc;
+    auto add_cb = [&](uint8_t index, uint32_t tiles, DataFormat format, uint32_t tile_bytes) {
+        desc.cbs.push_back(CBDescriptor{
+            .total_size = tiles * tile_bytes,
+            .core_ranges = all_cores,
+            .format_descriptors = {{CBFormatDescriptor{
+                .buffer_index = index,
+                .data_format = format,
+                .page_size = tile_bytes,
+            }}},
+        });
+    };
+
+    add_cb(static_cast<uint8_t>(CBIndex::c_0), 2, data_format, data_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_1), 1, data_format, data_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_2), 1, data_format, data_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_3), 1, data_format, data_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_16), 2, data_format, data_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_20), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_21), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_24), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_25), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_26), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_27), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_28), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_29), 2 * num_cores, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_30), 1, intermed_format, intermed_tile_bytes);
+    add_cb(static_cast<uint8_t>(CBIndex::c_31), 1, intermed_format, intermed_tile_bytes);
+
+    for (uint32_t semaphore_id = 0; semaphore_id < 2; ++semaphore_id) {
+        desc.semaphores.push_back(SemaphoreDescriptor{
+            .id = semaphore_id,
+            .core_type = CoreType::WORKER,
+            .core_ranges = all_cores,
+            .initial_value = 0,
+        });
+    }
+
+    KernelDescriptor::CompileTimeArgs reader_ct_args = {
+        static_cast<uint32_t>(input.dtype() == DataType::FLOAT32)};
+    TensorAccessorArgs(*input.buffer()).append_to(reader_ct_args);
+
+    KernelDescriptor reader;
+    reader.kernel_source =
+        "ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/reader_moreh_logsoftmax_w_parallel.cpp";
+    reader.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    reader.core_ranges = all_cores;
+    reader.compile_time_args = std::move(reader_ct_args);
+    reader.config = ReaderConfigDescriptor{};
+
+    KernelDescriptor::CompileTimeArgs writer_ct_args;
+    TensorAccessorArgs(*output.buffer()).append_to(writer_ct_args);
+
+    KernelDescriptor writer;
+    writer.kernel_source =
+        "ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/writer_moreh_logsoftmax_w_parallel.cpp";
+    writer.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    writer.core_ranges = all_cores;
+    writer.compile_time_args = std::move(writer_ct_args);
+    writer.config = WriterConfigDescriptor{};
+
+    std::vector<UnpackToDestMode> unpack_to_dest_mode(NUM_CIRCULAR_BUFFERS, UnpackToDestMode::Default);
+    auto add_compute_kernel = [&](const CoreRangeSet& cores, uint32_t local_wt, bool is_root) {
+        if (cores.ranges().empty()) {
+            return;
+        }
+        KernelDescriptor compute;
+        compute.kernel_source =
+            "ttnn/cpp/ttnn/operations/moreh/moreh_softmax/device/kernels/moreh_logsoftmax_w_parallel.cpp";
+        compute.source_type = KernelDescriptor::SourceType::FILE_PATH;
+        compute.core_ranges = cores;
+        compute.compile_time_args = {local_wt, static_cast<uint32_t>(is_root), num_cores};
+        compute.config = ComputeConfigDescriptor{
+            .math_fidelity = math_fidelity,
+            .fp32_dest_acc_en = fp32_dest_acc_en,
+            .dst_full_sync_en = dst_full_sync_en,
+            .unpack_to_dest_mode = unpack_to_dest_mode,
+            .math_approx_mode = math_approx_mode,
+        };
+        desc.kernels.push_back(std::move(compute));
+    };
+
+    const uint32_t core_h = core_range.end_coord.y - core_range.start_coord.y + 1;
+    for (uint32_t i = 0, start_tile = 0; i < num_cores; ++i) {
+        const CoreCoord core = {
+            (i / core_h) + core_range.start_coord.x,
+            (i % core_h) + core_range.start_coord.y};
+
+        uint32_t local_wt = 0;
+        if (core_group_1.contains(core)) {
+            local_wt = wt_group_1;
+        } else if (core_group_2.contains(core)) {
+            local_wt = wt_group_2;
+        } else {
+            TT_THROW("Core not in row-parallel softmax core ranges");
+        }
+
+        uint32_t mask_w = constants::TILE_WIDTH;
+        if (start_tile + local_wt == wt) {
+            mask_w = input.logical_shape()[-1] % constants::TILE_WIDTH;
+            if (mask_w == 0) {
+                mask_w = constants::TILE_WIDTH;
+            }
+        }
+
+        const bool is_root = core == root_core;
+        reader.emplace_runtime_args(
+            core,
+            {input.buffer(),
+             start_tile,
+             local_wt,
+             mask_w,
+             static_cast<uint32_t>(is_root),
+             num_cores,
+             i,
+             root_x,
+             root_y,
+             mcast_x_start,
+             mcast_y_start,
+             mcast_x_end,
+             mcast_y_end});
+
+        writer.emplace_runtime_args(
+            core,
+            {output.buffer(),
+             start_tile,
+             local_wt});
+
+        start_tile += local_wt;
+    }
+
+    desc.kernels.push_back(std::move(reader));
+    desc.kernels.push_back(std::move(writer));
+    add_compute_kernel(root_range, root_wt, true);
+    add_compute_kernel(nonroot_group_1, wt_group_1, false);
+    add_compute_kernel(nonroot_group_2, wt_group_2, false);
+
+    return desc;
+}
+
+}  // namespace ttnn::operations::moreh::moreh_softmax
