+    const bool use_fpu_negate = operation_attributes.negate && !is_sfpu_reduce;
+    const uint32_t min_rows_per_core = num_rows_per_core_group_2 == 0
+                                          ? num_rows_per_core_group_1
+                                          : std::min(num_rows_per_core_group_1, num_rows_per_core_group_2);
+    // Upstream uses four reads per barrier, except for tiny work units and
+    // fused-negate with one row per core, where batching measured slower.
+    const bool batch_reads = !rm_path && !(use_fpu_negate && min_rows_per_core < 2);
+    const uint32_t reader_tiles_per_batch = batch_reads && min_rows_per_core * Wt >= 4 ? 4 : 1;
+
     uint32_t src0_cb_index = 0;
-    uint32_t num_input_tiles = 2;
