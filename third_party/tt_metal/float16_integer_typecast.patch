diff --git ttnn/cpp/ttnn/operations/copy/typecast/device/typecast_device_op_types.hpp ttnn/cpp/ttnn/operations/copy/typecast/device/typecast_device_op_types.hpp
--- ttnn/cpp/ttnn/operations/copy/typecast/device/typecast_device_op_types.hpp
