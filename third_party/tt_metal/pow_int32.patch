 }
 
 ALWI void mulhi_uint32_tile_init() { MATH((SFPU_BINARY_INIT(mul_int32))); }
+
+// base**exponent of an Int32 or UInt32 base tile and exponent tile, wrapping
+// like their multiplication. A negative Int32 exponent gives 1 for a base of
+// 1, +-1 for -1 and 0 otherwise.
+template <DataFormat data_format>
+ALWI void pow_int_tile(uint32_t idst0, uint32_t idst1, uint32_t odst) {
+    static_assert(
+        data_format == DataFormat::Int32 || data_format == DataFormat::UInt32,
+        "Unsupported data format for pow_int. Supported data formats are: Int32, UInt32");
+    MATH((SFPU_BINARY_CALL(
+        DST_SYNC_MODE,
+        DST_ACCUM_MODE,
+        pow_int32,
+        (APPROX, data_format == DataFormat::UInt32),
+        idst0,
+        idst1,
+        odst,
+        VectorMode::RC)));
+}
+
+ALWI void pow_int_tile_init() { MATH((SFPU_BINARY_INIT(mul_int32))); }
 #endif
 
 }  // namespace ckernel
