+// a * b modulo 2^32, as in mul_int32: with a = a1 * 2^23 + a0,
+// a * b = a0 * b0 + ((a1 * b0 + a0 * b1) << 23) modulo 2^32, where SFPMUL24
+// gives the low and high halves of the 46-bit product a0 * b0.
+sfpi_inline sfpi::vUInt mul_uint32_wrapping(sfpi::vUInt a, sfpi::vUInt b) {
+    sfpi::vUInt high = sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a >> 23, b));
+    high += sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a, b >> 23));
+    high += sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a, b, sfpi::FractionalHalf::High));
+    return sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a, b)) + (high << 23);
+}
+
+// a * a modulo 2^32, whose two cross terms are equal: one SFPMUL24 fewer.
+sfpi_inline sfpi::vUInt square_uint32_wrapping(sfpi::vUInt a) {
+    sfpi::vUInt cross = sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a >> 23, a));
+    sfpi::vUInt high = sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a, a, sfpi::FractionalHalf::High));
+    high += cross + cross;
+    return sfpi::as<sfpi::vUInt>(sfpi::fractional_mul(a, a)) + (high << 23);
+}
+
+// base**exponent of two Int32 or UInt32 tiles, wrapping like their
+// multiplication: square-and-multiply over the exponent's 32 bits from the
+// highest. A negative Int32 exponent gives 1 for a base of 1, +-1 for -1 and
+// 0 otherwise, as in StableHLO.
+template <bool APPROXIMATION_MODE, bool UNSIGNED, int ITERATIONS = 8>
+inline void pow_int32(const uint dst_index_in0, const uint dst_index_in1, const uint dst_index_out) {
+    constexpr uint dst_tile_size_sfpi = 32;
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vUInt base = sfpi::dst_reg[dst_index_in0 * dst_tile_size_sfpi];
+        sfpi::vInt exponent = sfpi::dst_reg[dst_index_in1 * dst_tile_size_sfpi];
+        sfpi::vUInt result = 1;
+        sfpi::vInt bits = exponent;
+        for (int i = 0; i < 32; i++) {
+            result = square_uint32_wrapping(result);
+            v_if(bits < 0) { result = mul_uint32_wrapping(result, base); }
+            v_endif;
+            bits <<= 1;
+        }
+        if constexpr (!UNSIGNED) {
+            v_if(exponent < 0) {
+                sfpi::vInt signed_base = sfpi::as<sfpi::vInt>(base);
+                sfpi::vInt negative = 0;
+                v_if(signed_base == 1) { negative = 1; }
+                v_elseif(signed_base == -1) {
+                    negative = 1;
+                    v_if((exponent & 1) != 0) { negative = -1; }
+                    v_endif;
+                }
+                v_endif;
+                result = sfpi::as<sfpi::vUInt>(negative);
+            }
+            v_endif;
+        }
+        sfpi::dst_reg[dst_index_out * dst_tile_size_sfpi] = result;
+        sfpi::dst_reg++;
+    }
+}
+
+// base**exponent of a tile and a scalar exponent: the same multiplications,
+// chosen by the exponent's bits from its highest set bit on.
+template <bool APPROXIMATION_MODE, int ITERATIONS = 8>
+inline void power_int32(const uint32_t exponent) {
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vUInt base = sfpi::dst_reg[0];
+        sfpi::vUInt result = 1;
+        if (exponent != 0) {
+            result = base;
+            for (int bit = 30 - __builtin_clz(exponent); bit >= 0; bit--) {
+                result = square_uint32_wrapping(result);
+                if ((exponent >> bit) & 1) {
+                    result = mul_uint32_wrapping(result, base);
+                }
+            }
+        }
+        sfpi::dst_reg[0] = result;
+        sfpi::dst_reg++;
+    }
+}
+
 }  // namespace ckernel::sfpu
