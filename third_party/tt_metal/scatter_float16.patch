+// Float16 keys that order like the values: negatives flip all bits, the rest only the sign bit.
+FORCE_INLINE uint16_t fp16_order_key(uint16_t bits) { return bits ^ ((bits & 0x8000u) ? 0xffffu : 0x8000u); }
+
+FORCE_INLINE bool fp16_is_nan(uint16_t bits) { return (bits & 0x7fffu) > 0x7c00u; }
+
+template <DataFormat Format, ScatterReductionType Reduction>
+FORCE_INLINE std_type_t<Format> perform_reduction(std_type_t<Format> input, std_type_t<Format> source_value) {
+    constexpr bool is_float16 = Format == DataFormat::Float16;
+    if constexpr (is_float16 && (Reduction == ScatterReductionType::AMAX || Reduction == ScatterReductionType::AMIN)) {
+        // Compared on the bits, which is exact; NaN propagates.
+        if (fp16_is_nan(input)) {
+            return input;
         }
-        default: {
+        if (fp16_is_nan(source_value)) {
             return source_value;
         }
+        const uint16_t input_key = fp16_order_key(input);
+        const uint16_t source_key = fp16_order_key(source_value);
+        const bool keep_input =
+            Reduction == ScatterReductionType::AMAX ? input_key >= source_key : input_key <= source_key;
+        return keep_input ? input : source_value;
+    } else if constexpr (
+        is_float16 && (Reduction == ScatterReductionType::ADD || Reduction == ScatterReductionType::MULTIPLY)) {
+        // Float16 reduces in float32 and rounds back after every update, which is exact Float16 arithmetic: float32
+        // has at least 2 * 11 + 2 bits of precision, so the double rounding is harmless.
+        const float a = fp16_to_fp32(input);
+        const float b = fp16_to_fp32(source_value);
+        return fp32_to_fp16(Reduction == ScatterReductionType::ADD ? a + b : a * b);
+    } else if constexpr (Reduction == ScatterReductionType::ADD) {
+        return input + source_value;
+    } else if constexpr (Reduction == ScatterReductionType::MULTIPLY) {
+        return input * source_value;
+    } else if constexpr (Reduction == ScatterReductionType::AMAX) {
+        return std::max(input, source_value);
+    } else if constexpr (Reduction == ScatterReductionType::AMIN) {
+        return std::min(input, source_value);
+    } else {
+        return source_value;
     }
