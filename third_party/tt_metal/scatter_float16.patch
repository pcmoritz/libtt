+FORCE_INLINE uint16_t fp16_order_key(uint16_t bits) { return bits ^ ((bits & 0x8000u) ? 0xffffu : 0x8000u); }
+
+FORCE_INLINE bool fp16_is_nan(uint16_t bits) { return (bits & 0x7fffu) > 0x7c00u; }
+
+template <DataFormat Format>
+FORCE_INLINE std_type_t<Format> perform_reduction(
+    std_type_t<Format> input, std_type_t<Format> source_value, ScatterReductionType scatter_reduction_type) {
+    if constexpr (Format == DataFormat::Float16) {
+        switch (scatter_reduction_type) {
+            case ScatterReductionType::AMAX:
+            case ScatterReductionType::AMIN: {
+                // Compared on the bits, which is exact; NaN propagates.
+                if (fp16_is_nan(input)) {
+                    return input;
+                }
+                if (fp16_is_nan(source_value)) {
+                    return source_value;
+                }
+                const uint16_t input_key = fp16_order_key(input);
+                const uint16_t source_key = fp16_order_key(source_value);
+                const bool keep_input = scatter_reduction_type == ScatterReductionType::AMAX
+                                            ? input_key >= source_key
+                                            : input_key <= source_key;
+                return keep_input ? input : source_value;
+            }
+            case ScatterReductionType::ADD:
+            case ScatterReductionType::MULTIPLY: {
+                // Float16 reduces in float32 and rounds back after every update, which is exact Float16
+                // arithmetic: float32 has at least 2 * 11 + 2 bits of precision, so the double rounding is harmless.
+                const float a = fp16_to_fp32(input);
+                const float b = fp16_to_fp32(source_value);
+                return fp32_to_fp16(scatter_reduction_type == ScatterReductionType::ADD ? a + b : a * b);
+            }
+            default: {
+                return source_value;
+            }
+        }
+    }
