diff --git tt_metal/hw/inc/api/numeric/float16.h tt_metal/hw/inc/api/numeric/float16.h
new file mode 100644
--- /dev/null
+++ tt_metal/hw/inc/api/numeric/float16.h
@@ -0,0 +1,74 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstring>
+#include <stdint.h>
+
+#include "internal/risc_attribs.h"
+
+// Scalar IEEE float16 conversions for data movement kernels. Integer-only, so they stay exact under the
+// -ffast-math the kernels build with.
+
+// Convert float16 (stored as uint16_t) to float. Exact, including subnormals, infinities and NaN.
+FORCE_INLINE float fp16_to_fp32(std::uint16_t fp16) {
+    std::uint32_t sign = static_cast<std::uint32_t>(fp16 & 0x8000u) << 16;
+    std::uint32_t exponent = (fp16 >> 10) & 0x1Fu;
+    std::uint32_t mantissa = fp16 & 0x3FFu;
+    std::uint32_t bits;
+    if (exponent == 0x1Fu) {
+        bits = sign | 0x7F800000u | (mantissa << 13);
+    } else if (exponent != 0) {
+        bits = sign | ((exponent + 112u) << 23) | (mantissa << 13);
+    } else if (mantissa == 0) {
+        bits = sign;
+    } else {
+        // Subnormal: normalize the mantissa into a float normal.
+        exponent = 113u;
+        while ((mantissa & 0x400u) == 0) {
+            mantissa <<= 1;
+            --exponent;
+        }
+        bits = sign | (exponent << 23) | ((mantissa & 0x3FFu) << 13);
+    }
+    float result;
+    std::memcpy(&result, &bits, sizeof(result));
+    return result;
+}
+
+// Convert a single-precision float to float16, rounding to nearest even: to subnormals below 2^-14, and to
+// infinity from 65520 up. NaN stays NaN.
+FORCE_INLINE std::uint16_t fp32_to_fp16(float x) {
+    std::uint32_t bits;
+    std::memcpy(&bits, &x, sizeof(bits));
+    std::uint32_t sign = (bits >> 16) & 0x8000u;
+    std::uint32_t magnitude = bits & 0x7FFFFFFFu;
+    if (magnitude > 0x7F800000u) {
+        return static_cast<std::uint16_t>(sign | 0x7E00u | ((magnitude >> 13) & 0x3FFu));
+    }
+    if (magnitude >= 0x477FF000u) {
+        return static_cast<std::uint16_t>(sign | 0x7C00u);
+    }
+    if (magnitude >= 0x38800000u) {
+        // Normal: rebias the exponent and round the mantissa from 23 to 10 bits; a carry into the exponent is
+        // correct.
+        std::uint32_t rounded = magnitude + 0xFFFu + ((magnitude >> 13) & 1u);
+        return static_cast<std::uint16_t>(sign | ((rounded - 0x38000000u) >> 13));
+    }
+    // Subnormal or zero: the result counts multiples of 2^-24.
+    std::uint32_t exponent = magnitude >> 23;
+    if (exponent < 102u) {
+        return static_cast<std::uint16_t>(sign);  // below 2^-25, which rounds to zero
+    }
+    std::uint32_t mantissa = (magnitude & 0x7FFFFFu) | 0x800000u;
+    std::uint32_t shift = 126u - exponent;
+    std::uint32_t result = mantissa >> shift;
+    std::uint32_t remainder = mantissa & ((1u << shift) - 1u);
+    std::uint32_t half = 1u << (shift - 1u);
+    if (remainder > half || (remainder == half && (result & 1u))) {
+        ++result;  // may carry into the smallest normal, which is the right encoding
+    }
+    return static_cast<std::uint16_t>(sign | result);
+}
