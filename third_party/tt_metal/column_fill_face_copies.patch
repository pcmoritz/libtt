+// Fills faces 1 and 3 of a tile with faces 0 and 2, which the caller has written: two NoC reads.
+FORCE_INLINE void copy_left_faces_right(uint32_t l1_write_ptr, uint32_t face_bytes) {
+    // A baby-RISCV store can retire before its write lands in L1, and the RISC and the NoC reach
+    // L1 in no fixed order: read the last written word back before the NoC copies the faces.
+    (void)ckernel::load_blocking(reinterpret_cast<volatile uint32_t*>(l1_write_ptr + 3 * face_bytes - 4));
+    noc_async_read(get_noc_addr(l1_write_ptr), l1_write_ptr + face_bytes, face_bytes);
+    noc_async_read(get_noc_addr(l1_write_ptr + 2 * face_bytes), l1_write_ptr + 3 * face_bytes, face_bytes);
+    noc_async_read_barrier();
+}
