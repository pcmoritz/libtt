+// uint8 tiles: a face row is 16 bytes (4 words), a face 256 bytes.
+FORCE_INLINE void fill_tile_with_first_element_uint8(uint32_t l1_write_ptr) {
+    auto* words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(l1_write_ptr);
+    const uint32_t packed = (words[0] & 0xFF) * 0x01010101u;
+    for (uint32_t i = 0; i < 4; ++i) {
+        words[i] = packed;
+    }
+    fill_tile_from_first_face_row(l1_write_ptr, 16);
+}
+
+FORCE_INLINE void fill_tile_with_first_row_uint8(uint32_t l1_write_ptr) {
+    auto* words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(l1_write_ptr);
+    // The first rows of faces 0 and 1 down their faces, then faces 0 and 1 over faces 2 and 3.
+    for (uint32_t i = 4; i < 64; ++i) {
+        words[i] = words[i % 4];
+        words[64 + i] = words[64 + i % 4];
+    }
+    for (uint32_t i = 0; i < 128; ++i) {
+        words[128 + i] = words[i];
+    }
+}
+
+FORCE_INLINE void fill_tile_with_first_column_uint8(uint32_t l1_write_ptr, [[maybe_unused]] uint32_t rows = 32) {
+    auto* ptr = reinterpret_cast<volatile tt_l1_ptr uint8_t*>(l1_write_ptr);
+    auto* words = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(l1_write_ptr);
+    // The left faces' rows from their first bytes, then the left faces copied right.
+    for (uint32_t face_offset = 0; face_offset < 1024; face_offset += 512) {
+        for (uint32_t row_offset = 0; row_offset < 256; row_offset += 16) {
+            const uint32_t packed = ptr[face_offset + row_offset] * 0x01010101u;
+            for (uint32_t i = 0; i < 4; ++i) {
+                words[(face_offset + row_offset) / 4 + i] = packed;
+            }
+        }
+    }
+    copy_left_faces_right(l1_write_ptr, 256);
+}
+
+FORCE_INLINE void fill_tile_with_first_column_rm_uint8(uint32_t ptr_arg, uint32_t row_width) {
+    auto* ptr = reinterpret_cast<volatile tt_l1_ptr uint8_t*>(ptr_arg);
+    for (uint32_t i = 1; i < row_width; i++) {
+        ptr[i] = ptr[0];
+    }
+}
+
+FORCE_INLINE void fill_tile_with_first_row_rm_uint8(uint32_t ptr_arg, uint32_t row_width, uint32_t num_rows) {
+    auto* ptr = reinterpret_cast<volatile tt_l1_ptr uint8_t*>(ptr_arg);
+    for (uint32_t i = row_width; i < num_rows * row_width; i++) {
+        ptr[i] = ptr[i % row_width];
+    }
+}
