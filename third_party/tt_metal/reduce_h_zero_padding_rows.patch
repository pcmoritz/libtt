 #include <vector>
 
@@ -41,6 +42,24 @@ namespace ttnn::prim {
 // Tiles the universal reduce reader fetches per NoC barrier.
 inline constexpr uint32_t kReduceReaderTilesPerBatch = 4;
 
+// An H sum or mean of BF16 or FP32 32x32 interleaved tiles padded only below their rows zeroes the padding
+// rows of the last tile row as its reader fetches it (reduce_op_multi_core_h), so the input needs no fill_pad.
+// Returns the data rows of that tile row (0 if they fill it) in that case, nullopt when the padding must be
+// filled first.
+inline std::optional<uint32_t> reduce_h_reader_valid_rows(const Tensor& input, bool sum_or_mean) {
+    constexpr uint32_t tile_dim = 32;
+    const auto& logical = input.logical_shape();
+    const auto& padded = input.padded_shape();
+    const auto tile = input.tensor_spec().tile();
+    if (!sum_or_mean || input.layout() != tt::tt_metal::Layout::TILE || logical.rank() < 2 ||
+        (input.dtype() != tt::tt_metal::DataType::BFLOAT16 && input.dtype() != tt::tt_metal::DataType::FLOAT32) ||
+        tile.get_height() != tile_dim || tile.get_width() != tile_dim || input.is_sharded() ||
+        padded[-1] != logical[-1] || padded[-2] != (logical[-2] + tile_dim - 1) / tile_dim * tile_dim) {
+        return std::nullopt;
+    }
+    return logical[-2] % tile_dim;
+}
+
 inline uint32_t reduce_reader_batch(uint32_t min_tiles_per_core) {
     return min_tiles_per_core < kReduceReaderTilesPerBatch ? 1u : kReduceReaderTilesPerBatch;
 }
