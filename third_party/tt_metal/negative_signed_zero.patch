diff --git tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_negative.h tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_negative.h
--- tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_negative.h
+++ tt_metal/hw/ckernels/blackhole/metal/llk_api/llk_sfpu/ckernel_sfpu_negative.h
@@ -18,7 +18,9 @@ inline void _calculate_negative_()
     for (int d = 0; d < ITERATIONS; d++)
     {
         sfpi::vFloat val = sfpi::dst_reg[0];
-        sfpi::dst_reg[0] = -val;
+        // Floating-point negation toggles the sign bit, including for zero.
+        sfpi::vUInt bits = sfpi::as<sfpi::vUInt>(val);
+        sfpi::dst_reg[0] = sfpi::as<sfpi::vFloat>(bits ^ 0x80000000U);
         sfpi::dst_reg++;
     }
 }
