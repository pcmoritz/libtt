diff --git tt_metal/tt-llk/tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_negative.h tt_metal/tt-llk/tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_negative.h
--- tt_metal/tt-llk/tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_negative.h
+++ tt_metal/tt-llk/tt_llk_blackhole/common/inc/sfpu/ckernel_sfpu_negative.h
@@ -17,8 +17,10 @@ inline void _calculate_negative_()
 #pragma GCC unroll 8
     for (int d = 0; d < ITERATIONS; d++)
     {
         sfpi::vFloat val = sfpi::dst_reg[0];
-        sfpi::dst_reg[0] = -val;
+        // Floating-point negation toggles the sign bit, including for zero.
+        sfpi::vUInt bits = sfpi::as<sfpi::vUInt>(val);
+        sfpi::dst_reg[0] = sfpi::as<sfpi::vFloat>(bits ^ 0x80000000U);
         sfpi::dst_reg++;
     }
 }
