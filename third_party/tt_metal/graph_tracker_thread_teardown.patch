-thread_local std::shared_ptr<IGraphHooks> GraphTracker::hook;
+GraphTracker::ThreadState& GraphTracker::thread_state() {
+    // Deleted by an owner at thread exit, not destroyed with the thread's
+    // other thread-local objects: those are destroyed in the reverse order of
+    // their first use, so one first used before this state, such as a
+    // framework's cache of device buffers, can free buffers after it is gone.
+    // Such a late use gets a new, empty state, which the thread leaves behind.
+    thread_local ThreadState* state = nullptr;
+    if (state == nullptr) {
+        state = new ThreadState();
+        struct Owner {
+            ~Owner() {
+                // Nulled first: a processor's destructor that calls back gets
+                // a new state, not the one being deleted.
+                ThreadState* deleted = state;
+                state = nullptr;
+                delete deleted;
+            }
+        };
+        thread_local Owner owner;
+    }
+    return *state;
+}
 
