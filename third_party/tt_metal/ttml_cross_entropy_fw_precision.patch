-ttnn::Tensor cross_entropy_fw(const ttnn::Tensor& input_tensor, const ttnn::Tensor& target_tensor) {
-    auto result = ttnn::prim::ttml_cross_entropy_fw(input_tensor, target_tensor);
-    return result;
+ttnn::Tensor cross_entropy_fw(
+    const ttnn::Tensor& input_tensor,
+    const ttnn::Tensor& target_tensor,
+    std::optional<tt::tt_metal::DataType> output_dtype) {
+    std::optional<ttnn::Tensor> output;
+    if (output_dtype.has_value() && *output_dtype != input_tensor.dtype()) {
+        auto output_shape = input_tensor.logical_shape();
+        output_shape[-1] = 1U;
+        output = ttnn::create_device_tensor(
+            tt::tt_metal::TensorSpec(
+                ttnn::Shape(output_shape),
+                tt::tt_metal::TensorLayout(
+                    *output_dtype, tt::tt_metal::Layout::TILE, input_tensor.memory_config())),
+            input_tensor.device());
+    }
+    return ttnn::prim::ttml_cross_entropy_fw(input_tensor, target_tensor, output);
 }
 
 }  // namespace ttml::metal
