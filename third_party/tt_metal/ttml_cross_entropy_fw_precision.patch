+// Finishes the row's loss in FP32 DST and packs it to cb_output: the SFPU sums the exp tile's rows into column 0,
+// takes the log, adds the row max (broadcast in max_value_register) and subtracts the target logit. The FPU path
+// this replaces (a matmul row sum, then add_tiles with the FP32 log-sum) read its FP32 operands as TF32, an error
+// up to about 1e-3 that a BF16 output hid but an FP32 one shows.
+void pack_loss(uint32_t accum_register, uint32_t tile_register, uint32_t max_value_register) {
+    sfpu_reduce_init<PoolType::SUM, DataFormat::Float32>();
+    sfpu_reduce<PoolType::SUM, DataFormat::Float32, ReduceDim::REDUCE_ROW>(accum_register);
+    log_tile_init();
+    log_tile(accum_register);
+    add_binary_tile_init();
+    add_binary_tile(accum_register, max_value_register, accum_register);
+
+    cb_wait_front(cb_target_logits, onetile);
+    copy_init(cb_target_logits);
+    copy_tile(cb_target_logits, /* tile_idx */ 0, /* register_idx */ tile_register);
+    sub_binary_tile_init();
+    sub_binary_tile(accum_register, tile_register, accum_register);
+    tile_regs_commit();
+
+    cb_reserve_back(cb_output, onetile);
+    tile_regs_wait();
+    pack_reconfig_data_format(cb_output);
+    pack_tile(accum_register, cb_output);
+    tile_regs_release();
+    cb_push_back(cb_output, onetile);
+}
