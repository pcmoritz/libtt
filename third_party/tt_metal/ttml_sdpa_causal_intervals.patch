diff --git tt-train/sources/ttml/metal/common/const_utils.hpp tt-train/sources/ttml/metal/common/const_utils.hpp
--- tt-train/sources/ttml/metal/common/const_utils.hpp
+++ tt-train/sources/ttml/metal/common/const_utils.hpp
@@ -14,13 +14,30 @@ namespace ttml::metal {
  * - None: No mask applied, just scale attention scores
  * - Causal: Generate lower-triangular causal mask on device (prevents attending to future tokens)
  * - Arbitrary: Use provided mask tensor from DRAM
+ * - CausalIntervals: Use provided mask tensor from DRAM that keeps, in each query row r, the keys of one
+ *   interval [start(r), r] whose start never decreases down the rows (packed documents attending causally
+ *   within themselves, sliding windows). The kernels skip the mask's tiles that keep no score.
  */
 enum class AttentionMaskType {
-    None,      // No mask - just scale attention scores
-    Causal,    // Generate causal mask on device (lower triangular)
-    Arbitrary  // Use provided mask tensor from DRAM
+    None,             // No mask - just scale attention scores
+    Causal,           // Generate causal mask on device (lower triangular)
+    Arbitrary,        // Use provided mask tensor from DRAM
+    CausalIntervals,  // Use provided mask tensor from DRAM, causal intervals: skip tiles it drops
 };
 
+// Whether the mask type reads a mask tensor.
+inline constexpr bool reads_mask_tensor(AttentionMaskType mask_type) {
+    return mask_type == AttentionMaskType::Arbitrary || mask_type == AttentionMaskType::CausalIntervals;
+}
+
+// AttentionMaskType::CausalIntervals: the readers read mask tile corners in batches of 64-byte DRAM reads into an
+// L1 scratch (with room to align it to 64 bytes), and hand the compute kernels per-row counts in small pages.
+constexpr uint32_t kMaskCornerProbes = 8U;
+constexpr uint32_t kMaskCornerReadBytes = 64U;
+constexpr uint32_t kMaskCornerScratchBytes = (kMaskCornerProbes + 1U) * kMaskCornerReadBytes;
+constexpr uint32_t kCountPageBytes = 32U;
+constexpr uint32_t kCountPages = 4U;
+
 /**
  * Specifies whether stochastic rounding is applied during optimizer updates.
  *
diff --git tt-train/sources/ttml/metal/common/dataflow_utils.hpp tt-train/sources/ttml/metal/common/dataflow_utils.hpp
--- tt-train/sources/ttml/metal/common/dataflow_utils.hpp
+++ tt-train/sources/ttml/metal/common/dataflow_utils.hpp
@@ -14,6 +14,7 @@
 #include "api/debug/dprint.h"
 #include "api/debug/dprint_pages.h"
 #include "ttnn/operations/kernel_helper_functions/pad_tile.hpp"
+#include "tt-train/sources/ttml/metal/common/const_utils.hpp"
 
 #ifndef FORCE_INLINE
 #define FORCE_INLINE inline
@@ -680,3 +681,82 @@ inline void mcast_sender_signal_receivers_loopback(
     noc_semaphore_set_multicast_loopback_src(receiver_sem_addr, receiver_sem_noc_addr, num_dests_including_self);
     noc_async_atomic_barrier();
 }
+
+// ----------------------------------------------------------------------------------------------------------
+// AttentionMaskType::CausalIntervals: block skipping.
+//
+// Such a mask keeps, in each query row r, the keys of one interval [start(r), r] whose start never decreases
+// down the rows: packed documents that attend causally within themselves, sliding windows. Mask tile (i, j),
+// query tile i and key tile j <= i, then keeps a score iff it keeps its corner (0, 31), the score of query 32i
+// for key 32j + 31: query 32i's interval reaches key tile j iff it starts at or before 32j + 31 (and it ends
+// at 32i, past it), and the tile's later queries start no earlier. The kernels visit only those tiles.
+// ----------------------------------------------------------------------------------------------------------
+
+using ttml::metal::kMaskCornerProbes;
+using ttml::metal::kMaskCornerReadBytes;
+// A corner is the last element of row 0 of face 1, which starts at byte 512 of a BF16 tile; one aligned 64-byte
+// read holds it.
+constexpr uint32_t kMaskCornerReadOffset = 512U;
+constexpr uint32_t kMaskCornerElement = 15U;
+
+inline uint32_t mask_corner_scratch(const uint32_t cb_scratch) {
+    cb_reserve_back(cb_scratch, onetile);
+    return (get_write_ptr(cb_scratch) + kMaskCornerReadBytes - 1U) & ~(kMaskCornerReadBytes - 1U);
+}
+
+template <typename AddrGen>
+inline void read_mask_corner(const AddrGen& mask, const uint32_t tile_idx, const uint32_t l1_addr) {
+    noc_async_read(mask.get_noc_addr(tile_idx, kMaskCornerReadOffset), l1_addr, kMaskCornerReadBytes);
+}
+
+inline bool mask_corner_kept(const uint32_t scratch, const uint32_t probe) {
+    const auto* corner_row = reinterpret_cast<volatile tt_l1_ptr uint16_t*>(scratch + probe * kMaskCornerReadBytes);
+    return (corner_row[kMaskCornerElement] & 0x7FFFU) != 0U;  // a BF16 1 (kept), not +-0 (dropped)
+}
+
+// The first key tile that query tile `q_tile` attends to; the diagonal tile always.
+template <typename AddrGen>
+inline uint32_t first_kept_key_tile(const AddrGen& mask, const uint32_t Ht, const uint32_t q_tile, const uint32_t scratch) {
+    uint32_t first = q_tile;
+    while (first > 0U) {
+        const uint32_t count = std::min(first, kMaskCornerProbes);
+        for (uint32_t p = 0U; p < count; ++p) {
+            read_mask_corner(mask, q_tile * Ht + (first - 1U - p), scratch + p * kMaskCornerReadBytes);
+        }
+        noc_async_read_barrier();
+        for (uint32_t p = 0U; p < count; ++p) {
+            if (!mask_corner_kept(scratch, p)) {
+                return first - p;
+            }
+        }
+        first -= count;
+    }
+    return 0U;
+}
+
+// One past the last query tile that attends to key tile `k_tile`; the diagonal tile always attends.
+template <typename AddrGen>
+inline uint32_t end_kept_query_tile(const AddrGen& mask, const uint32_t Ht, const uint32_t k_tile, const uint32_t scratch) {
+    uint32_t end = k_tile + 1U;
+    while (end < Ht) {
+        const uint32_t count = std::min(Ht - end, kMaskCornerProbes);
+        for (uint32_t p = 0U; p < count; ++p) {
+            read_mask_corner(mask, (end + p) * Ht + k_tile, scratch + p * kMaskCornerReadBytes);
+        }
+        noc_async_read_barrier();
+        for (uint32_t p = 0U; p < count; ++p) {
+            if (!mask_corner_kept(scratch, p)) {
+                return end + p;
+            }
+        }
+        end += count;
+    }
+    return Ht;
+}
+
+// Hands the compute kernel a count through a one-value page of `cb_count`.
+inline void push_count(const uint32_t cb_count, const uint32_t count) {
+    cb_reserve_back(cb_count, onetile);
+    *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_write_ptr(cb_count)) = count;
+    cb_push_back(cb_count, onetile);
+}
