+// equal width and the output is silu(gate) * up, at half the weight's width;
+// both halves of an output tile are computed on the same core.
+struct MatmulDecodeProgramConfig {
+    tt::tt_metal::CoreCoord compute_with_storage_grid_size;
+    std::size_t in0_block_w{};
+    bool fuse_swiglu{};
+};
