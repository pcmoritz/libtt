+#include "api/dataflow/noc_semaphore.h"
+#include "matmul_decode_weights.hpp"
+
+// RISCV_1 on multicast receivers: publish activation chunks as they land
+// and stream this core's odd weight blocks in between.
+void kernel_main() {
+    const uint32_t sender_x = get_arg_val<uint32_t>(0);
+    const uint32_t sender_y = get_arg_val<uint32_t>(1);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(2);
+    const uint32_t n_start = get_arg_val<uint32_t>(3);
+    const uint32_t count = get_arg_val<uint32_t>(4);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    volatile tt_l1_ptr uint32_t* chunks_landed =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_semaphore(receiver_sem_id));
+
+    // The CB holds all Kt tiles, so one handshake covers every chunk.
+    cb_in0.reserve_back(Kt);
+    receiver_sem.set(0);
+    sender_sem.up(noc, sender_x, sender_y, 1);
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    uint32_t chunks = 0;
+    auto publish_landed = [&] {
+        invalidate_l1_cache();
+        for (const uint32_t landed = *chunks_landed; chunks < landed; ++chunks) {
+            cb_in0.push_back(in0_mcast_w);
+        }
+    };
+    stream_decode_weights<1>(weight, n_start, count, cb_weights, publish_landed);
+    for (; chunks < num_chunks; ++chunks) {
+        receiver_sem.wait_min(chunks + 1);
+        cb_in0.push_back(in0_mcast_w);
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "api/dataflow/endpoints.h"
+#include "api/core_local_mem.h"
+#include "matmul_decode_weights.hpp"
+
+// RISCV_1 on the first core of a multicast group. The activation row block
+// stays resident in every core's L1: after one readiness handshake, stream it
+// in chunks, overlapping the DRAM read of the next chunk with the multicast
+// of the current one; a counting semaphore tells receivers how many chunks
+// have landed. This core's odd weight blocks follow.
+void kernel_main() {
+    const uint32_t input_addr = get_arg_val<uint32_t>(0);
+    const uint32_t dest_start_x = get_arg_val<uint32_t>(1);
+    const uint32_t dest_start_y = get_arg_val<uint32_t>(2);
+    const uint32_t dest_end_x = get_arg_val<uint32_t>(3);
+    const uint32_t dest_end_y = get_arg_val<uint32_t>(4);
+    const uint32_t num_dests = get_arg_val<uint32_t>(5);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(6);
+    const uint32_t n_start = get_arg_val<uint32_t>(7);
+    const uint32_t count = get_arg_val<uint32_t>(8);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    static_assert(Kt % in0_mcast_w == 0);
+    constexpr auto input_args = TensorAccessorArgs<0>();
+    constexpr auto weight_args = TensorAccessorArgs<input_args.next_compile_time_args_offset()>();
+
+    const auto input = TensorAccessor(input_args, input_addr);
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    constexpr uint32_t tile_bytes = get_tile_size(cb_in0_id);
+    constexpr uint32_t chunk_bytes = in0_mcast_w * tile_bytes;
+
+    cb_in0.reserve_back(Kt);
+    const uint32_t base = cb_in0.get_write_ptr();
+    auto read_chunk = [&](uint32_t chunk) {
+        for (uint32_t k = 0; k < in0_mcast_w; ++k) {
+            const uint32_t tile = chunk * in0_mcast_w + k;
+            noc_async_read_tile(tile, input, base + tile * tile_bytes);
+        }
+    };
+
+    read_chunk(0);
+    noc.async_read_barrier();
+    sender_sem.wait(num_dests);
+    sender_sem.set(0);
+    for (uint32_t chunk = 0; chunk < num_chunks; ++chunk) {
+        if (chunk + 1 < num_chunks) {
+            read_chunk(chunk + 1);
+        }
+        if (num_dests > 0) {
+            const uint32_t addr = base + chunk * chunk_bytes;
+            MulticastEndpoint mcast_dst;
+            noc.async_write_multicast(
+                CoreLocalMem<uint32_t>(addr), mcast_dst, chunk_bytes, num_dests, {},
+                {.noc_x_start = dest_start_x, .noc_y_start = dest_start_y,
+                 .noc_x_end = dest_end_x, .noc_y_end = dest_end_y, .addr = addr}, true);
+#ifdef ARCH_BLACKHOLE
+            noc.async_writes_flushed();
+#endif
+            receiver_sem.set(chunk + 1);
+            receiver_sem.set_multicast(
+                noc, dest_start_x, dest_start_y, dest_end_x, dest_end_y, num_dests);
+        }
+        cb_in0.push_back(in0_mcast_w);
+        noc.async_read_barrier();
+    }
+
+    stream_decode_weights<1>(weight, n_start, count, cb_weights, [] {});
+    noc.async_write_barrier();
+}
