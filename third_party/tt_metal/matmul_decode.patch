+    // the attributes take the defaults of an automatically configured matmul,
+    // such as its math fidelity, before the decode config is set.
+    auto attributes = ttnn::prim::create_matmul_attributes(input_tensor_a, input_tensor_b, params, {std::nullopt});
+    attributes.program_config = create_matmul_decode_program_config(
+        input_tensor_a, input_tensor_a.device()->compute_with_storage_grid_size(), /*fuse_swiglu=*/true);
+    return ttnn::prim::matmul(
+               input_tensor_a, input_tensor_b, /*bias=*/std::nullopt,
+               /*optional_output_tensor=*/std::nullopt, attributes)
+        .at(0);
