+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <optional>
+
+#include "ttnn/device_operation.hpp"
+#include "ttnn/operations/matmul/device/matmul_device_operation_types.hpp"
+#include <tt-metalium/program_descriptors.hpp>
+
+namespace ttnn::prim {
+
+// The circular-buffer bytes per core of the decode program: the whole
+// activation row, two double-buffered weight blocks, and this core's output
+// and bias tiles. What create_descriptor allocates.
+uint32_t matmul_decode_cb_bytes(
+    const ttnn::Tensor& input_tensor_a,
+    const ttnn::Tensor& input_tensor_b,
+    const std::optional<const ttnn::Tensor>& bias,
+    bool transpose_b,
+    tt::tt_metal::DataType output_dtype,
+    const operations::matmul::MatmulDecodeProgramConfig& config);
+
+// Program factory of MatmulDecodeProgramConfig: one tile row of activations
+// times DRAM-interleaved weights, optionally finishing with SwiGLU.
+struct MatmulDecodeProgramFactory {
+    static tt::tt_metal::ProgramDescriptor create_descriptor(
+        const ttnn::prim::MatmulParams& operation_attributes,
+        const ttnn::prim::MatmulInputs& tensor_args,
+        std::vector<ttnn::Tensor>& tensor_return_value,
+        const std::optional<CoreRangeSet>& core_range_set = std::nullopt);
+};
+
+}  // namespace ttnn::prim
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_decode.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_decode.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_decode.cpp
@@ -0,0 +1,93 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/matmul.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/compute/compute_kernel_api.h"
+
+// This core's output tiles, or silu(gate) * up for SwiGLU's two weight halves.
+// Each group of up to `group` output tiles accumulates the full K reduction in
+// FP32 DST, starting from the bias if there is one; the activation stays
+// resident, so later groups reuse it.
+void kernel_main() {
+    const uint32_t count = get_arg_val<uint32_t>(0);
+
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t halves = get_named_compile_time_arg_val("halves");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr uint32_t cb_in0 = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_weights2 = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t cb_bias = get_named_compile_time_arg_val("cb_bias");
+    constexpr bool has_bias = get_named_compile_time_arg_val("has_bias");
+    constexpr uint32_t transpose_b = get_named_compile_time_arg_val("transpose_b");
+    constexpr uint32_t block_tiles = kblock * halves * group;
+    static_assert(group > 0 && halves * group <= 8, "a group's accumulators must fit in FP32 DST");
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_in0, cb_weights, cb_out);
+    if constexpr (has_bias) {
+        cb_wait_front(cb_bias, count);
+    }
+    uint32_t in0_ready = 0;
+    uint32_t index = 0;
+    for (uint32_t group_start = 0; group_start < count; group_start += group) {
+        const uint32_t width = count - group_start < group ? count - group_start : group;
+        tile_regs_acquire();
+        if constexpr (has_bias) {
+            // Row 0 of the bias, broadcast over the rows as by the 1D matmul.
+            unary_bcast_init<BroadcastType::ROW>(cb_bias, cb_out);
+            for (uint32_t i = 0; i < width; ++i) {
+                unary_bcast<BroadcastType::ROW>(cb_bias, group_start + i, i);
+            }
+            reconfig_data_format<SrcOrder::Reverse>(cb_in0, cb_weights);
+        }
+        matmul_block_init(cb_in0, cb_weights, transpose_b, /*ct_dim=*/halves, /*rt_dim=*/1, kblock);
+        for (uint32_t k0 = 0; k0 < Kt; k0 += kblock, ++index) {
+            // Odd blocks arrive through the second NOC's CB.
+            const uint32_t cb_block = (index & 1) ? cb_weights2 : cb_weights;
+            if (in0_ready < k0 + kblock) {
+                in0_ready = k0 + kblock;
+                cb_wait_front(cb_in0, in0_ready);
+            }
+            cb_wait_front(cb_block, block_tiles);
+            for (uint32_t k = 0; k < kblock; ++k) {
+                for (uint32_t offset = 0; offset < halves * width; offset += halves) {
+                    matmul_block(cb_in0, cb_block, k0 + k, k * halves * width + offset, offset, transpose_b, halves,
+                                 1, kblock);
+                }
+            }
+            cb_pop_front(cb_block, block_tiles);
+        }
+
+        if constexpr (halves == 2) {
+            // Gate occupies the first `width` DST tiles, followed by up.
+            silu_tile_init();
+            for (uint32_t i = 0; i < width; ++i) {
+                silu_tile(i);
+            }
+            mul_binary_tile_init();
+            for (uint32_t i = 0; i < width; ++i) {
+                mul_binary_tile(i, width + i, i);
+            }
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        cb_reserve_back(cb_out, width);
+        for (uint32_t i = 0; i < width; ++i) {
+            pack_tile(i, cb_out);
+        }
+        cb_push_back(cb_out, width);
+        tile_regs_release();
+    }
+    cb_pop_front(cb_in0, Kt);
+    if constexpr (has_bias) {
+        cb_pop_front(cb_bias, count);
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_decode_weights.hpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_decode_weights.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_decode_weights.hpp
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+
+// Streams one decode matmul core's weight blocks into `cb` in consumption
+// order. The core's output tiles are processed in groups of up to `group`
+// (bounded by DST), and each group walks K in blocks of `in0_block_w` tiles.
+// Even blocks travel on RISCV_0's NOC and odd blocks on RISCV_1's; this reads
+// the blocks with index % 2 == parity. For each K row, a block holds the
+// group's weight tiles of every half in turn: a plain matmul has one half, and
+// SwiGLU's [up | gate] weight has two, read gate first. A transposed weight
+// is stored [N, K]. Every block occupies the same CB space, so a narrower last
+// group keeps the block size constant. `poll` runs while waiting for CB space,
+// so the caller can make other progress.
+template <uint32_t parity, typename Accessor, typename Poll>
+FORCE_INLINE void stream_decode_weights(
+    const Accessor& weight, uint32_t n_start, uint32_t count, uint32_t cb, Poll poll) {
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t halves = get_named_compile_time_arg_val("halves");
+    constexpr uint32_t out_Nt = get_named_compile_time_arg_val("out_Nt");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("in0_block_w");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr bool transpose_b = get_named_compile_time_arg_val("transpose_b");
+    constexpr uint32_t block_tiles = kblock * halves * group;
+    const uint32_t tile_bytes = get_tile_size(cb);
+    uint32_t index = 0;
+    for (uint32_t group_start = 0; group_start < count; group_start += group) {
+        const uint32_t width = count - group_start < group ? count - group_start : group;
+        for (uint32_t k0 = 0; k0 < Kt; k0 += kblock, ++index) {
+            if ((index & 1) != parity) {
+                continue;
+            }
+            do {
+                poll();
+            } while (!cb_pages_reservable_at_back(cb, block_tiles));
+            cb_reserve_back(cb, block_tiles);
+            uint32_t local = get_write_ptr(cb);
+            for (uint32_t k = 0; k < kblock; ++k) {
+                for (uint32_t half = 0; half < halves; ++half) {
+                    const uint32_t first = (halves - 1 - half) * out_Nt + n_start + group_start;
+                    for (uint32_t n = first; n < first + width; ++n, local += tile_bytes) {
+                        const uint32_t tile = transpose_b ? n * Kt + k0 + k : (k0 + k) * halves * out_Nt + n;
+                        noc_async_read_tile(tile, weight, local);
+                    }
+                }
+            }
+            noc_async_read_barrier();
+            cb_push_back(cb, block_tiles);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode.cpp
@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "matmul_decode_weights.hpp"
+
+// Reads the bias tiles of this core's output columns. The bias address is
+// runtime argument 4 and its accessor arguments follow the output's; kernels
+// without a bias have neither.
+template <bool has_bias, uint32_t args_offset>
+FORCE_INLINE void read_bias(uint32_t n_start, uint32_t count, uint32_t cb_bias) {
+    if constexpr (has_bias) {
+        constexpr auto bias_args = TensorAccessorArgs<args_offset>();
+        const auto bias = TensorAccessor(bias_args, get_arg_val<uint32_t>(4));
+        const uint32_t tile_bytes = get_tile_size(cb_bias);
+        cb_reserve_back(cb_bias, count);
+        for (uint32_t n = 0; n < count; ++n) {
+            noc_async_read_tile(n_start + n, bias, get_write_ptr(cb_bias) + n * tile_bytes);
+        }
+        noc_async_read_barrier();
+        cb_push_back(cb_bias, count);
+    }
+}
+
+// Reads this core's bias tiles, streams its even weight blocks on RISCV_0's
+// NOC, then writes its output tiles.
+void kernel_main() {
+    const uint32_t weight_addr = get_arg_val<uint32_t>(0);
+    const uint32_t output_addr = get_arg_val<uint32_t>(1);
+    const uint32_t n_start = get_arg_val<uint32_t>(2);
+    const uint32_t count = get_arg_val<uint32_t>(3);
+
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t cb_bias = get_named_compile_time_arg_val("cb_bias");
+    constexpr bool has_bias = get_named_compile_time_arg_val("has_bias");
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    constexpr auto output_args = TensorAccessorArgs<weight_args.next_compile_time_args_offset()>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const auto output = TensorAccessor(output_args, output_addr);
+    read_bias<has_bias, output_args.next_compile_time_args_offset()>(n_start, count, cb_bias);
+
+    stream_decode_weights<0>(weight, n_start, count, cb_weights, [] {});
+
+    Noc noc;
+    CircularBuffer out_cb(cb_out);
+    const uint32_t page_bytes = get_local_cb_interface(cb_out).fifo_page_size;
+    for (uint32_t n = 0; n < count; ++n) {
+        out_cb.wait_front(1);
+        noc.async_write(out_cb, output, page_bytes, {}, {.page_id = n_start + n});
+        noc.async_writes_flushed();
+        out_cb.pop_front(1);
+    }
+    noc.async_write_barrier();
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_receiver.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_receiver.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_receiver.cpp
@@ -0,0 +1,53 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "matmul_decode_weights.hpp"
+
+// RISCV_1 on multicast receivers: publish activation chunks as they land
+// and stream this core's odd weight blocks in between.
+void kernel_main() {
+    const uint32_t sender_x = get_arg_val<uint32_t>(0);
+    const uint32_t sender_y = get_arg_val<uint32_t>(1);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(2);
+    const uint32_t n_start = get_arg_val<uint32_t>(3);
+    const uint32_t count = get_arg_val<uint32_t>(4);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    volatile tt_l1_ptr uint32_t* chunks_landed =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_semaphore(receiver_sem_id));
+
+    // The CB holds all Kt tiles, so one handshake covers every chunk.
+    cb_in0.reserve_back(Kt);
+    receiver_sem.set(0);
+    sender_sem.up(noc, sender_x, sender_y, 1);
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    uint32_t chunks = 0;
+    auto publish_landed = [&] {
+        invalidate_l1_cache();
+        for (const uint32_t landed = *chunks_landed; chunks < landed; ++chunks) {
+            cb_in0.push_back(in0_mcast_w);
+        }
+    };
+    stream_decode_weights<1>(weight, n_start, count, cb_weights, publish_landed);
+    for (; chunks < num_chunks; ++chunks) {
+        receiver_sem.wait_min(chunks + 1);
+        cb_in0.push_back(in0_mcast_w);
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_matmul_decode_in0_sender.cpp
@@ -0,0 +1,86 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "api/dataflow/endpoints.h"
+#include "api/core_local_mem.h"
+#include "matmul_decode_weights.hpp"
+
+// RISCV_1 on the first core of a multicast group. The activation row block
+// stays resident in every core's L1: after one readiness handshake, stream it
+// in chunks, overlapping the DRAM read of the next chunk with the multicast
+// of the current one; a counting semaphore tells receivers how many chunks
+// have landed. This core's odd weight blocks follow.
+void kernel_main() {
+    const uint32_t input_addr = get_arg_val<uint32_t>(0);
+    const uint32_t dest_start_x = get_arg_val<uint32_t>(1);
+    const uint32_t dest_start_y = get_arg_val<uint32_t>(2);
+    const uint32_t dest_end_x = get_arg_val<uint32_t>(3);
+    const uint32_t dest_end_y = get_arg_val<uint32_t>(4);
+    const uint32_t num_dests = get_arg_val<uint32_t>(5);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(6);
+    const uint32_t n_start = get_arg_val<uint32_t>(7);
+    const uint32_t count = get_arg_val<uint32_t>(8);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    static_assert(Kt % in0_mcast_w == 0);
+    constexpr auto input_args = TensorAccessorArgs<0>();
+    constexpr auto weight_args = TensorAccessorArgs<input_args.next_compile_time_args_offset()>();
+
+    const auto input = TensorAccessor(input_args, input_addr);
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    constexpr uint32_t tile_bytes = get_tile_size(cb_in0_id);
+    constexpr uint32_t chunk_bytes = in0_mcast_w * tile_bytes;
+
+    cb_in0.reserve_back(Kt);
+    const uint32_t base = cb_in0.get_write_ptr();
+    auto read_chunk = [&](uint32_t chunk) {
+        for (uint32_t k = 0; k < in0_mcast_w; ++k) {
+            const uint32_t tile = chunk * in0_mcast_w + k;
+            noc_async_read_tile(tile, input, base + tile * tile_bytes);
+        }
+    };
+
+    read_chunk(0);
+    noc.async_read_barrier();
+    sender_sem.wait(num_dests);
+    sender_sem.set(0);
+    for (uint32_t chunk = 0; chunk < num_chunks; ++chunk) {
+        if (chunk + 1 < num_chunks) {
+            read_chunk(chunk + 1);
+        }
+        if (num_dests > 0) {
+            const uint32_t addr = base + chunk * chunk_bytes;
+            MulticastEndpoint mcast_dst;
+            noc.async_write_multicast(
+                CoreLocalMem<uint32_t>(addr), mcast_dst, chunk_bytes, num_dests, {},
+                {.noc_x_start = dest_start_x, .noc_y_start = dest_start_y,
+                 .noc_x_end = dest_end_x, .noc_y_end = dest_end_y, .addr = addr}, true);
+#ifdef ARCH_BLACKHOLE
+            noc.async_writes_flushed();
+#endif
+            receiver_sem.set(chunk + 1);
+            receiver_sem.set_multicast(
+                noc, dest_start_x, dest_start_y, dest_end_x, dest_end_y, num_dests);
+        }
+        cb_in0.push_back(in0_mcast_w);
+        noc.async_read_barrier();
+    }
+
+    stream_decode_weights<1>(weight, n_start, count, cb_weights, [] {});
+    noc.async_write_barrier();
+}
