+
+// A 1D matmul of one tile row of BF16 activations times DRAM-interleaved
+// weights, as in LLM decode, with at least one output tile per worker core.
+// The decode matmul streams such weights on both NOCs and splits the output
+// columns evenly over the cores; with fewer output tiles, the 1D matmul keeps
+// more cores busy. Like the 1D matmul, it adds row 0 of the bias to every row.
+bool is_decode_matmul(const MatmulParams& attributes, const MatmulInputs& args) {
+    const auto& a = args.input_tensors.at(0);
+    const auto& b = args.input_tensors.at(1);
+    const bool has_output = !args.optional_output_tensors.empty() && args.optional_output_tensors[0].has_value();
+    const auto& a_shape = a.padded_shape();
+    const auto& b_shape = b.padded_shape();
+    const uint32_t K = a_shape[-1];
+    const uint32_t N = b_shape[attributes.transpose_b ? -2 : -1];
+    const auto output_dtype = attributes.output_dtype.value_or(a.dtype());
+    const auto grid = a.device()->compute_with_storage_grid_size();
+    auto is_tile_row = [&](const Tensor& t, uint32_t width) {
+        return t.layout() == Layout::TILE && t.tensor_spec().tile() == tt::tt_metal::Tile() &&
+               t.padded_shape().volume() == static_cast<uint64_t>(TILE_HEIGHT) * width &&
+               is_dram_interleaved(t.memory_config());
+    };
+    const auto bias = args.optional_input_tensors.empty() ? std::nullopt : args.optional_input_tensors[0];
+    const bool bias_ok = !bias.has_value() || (is_tile_row(*bias, N) && (bias->dtype() == DataType::BFLOAT16 ||
+                                                                          bias->dtype() == DataType::FLOAT32));
+    return bias_ok && !has_output && !attributes.transpose_a && !attributes.untilize_out &&
+           !attributes.user_fused_activation.has_value() && !attributes.global_cb.has_value() &&
+           attributes.output_tile.value_or(tt::tt_metal::Tile()) == tt::tt_metal::Tile() &&
+           a.dtype() == DataType::BFLOAT16 && is_tile_row(a, K) && a.logical_shape()[-1] % TILE_WIDTH == 0 &&
+           (output_dtype == DataType::BFLOAT16 || output_dtype == DataType::FLOAT32) &&
+           b.layout() == Layout::TILE && b.tensor_spec().tile() == tt::tt_metal::Tile() &&
+           b_shape.volume() == static_cast<uint64_t>(K) * N &&
+           b.logical_shape()[attributes.transpose_b ? -1 : -2] % TILE_WIDTH == 0 && N / TILE_WIDTH >= grid.x * grid.y &&
+           is_dram_interleaved(b.memory_config()) && is_dram_interleaved(attributes.output_mem_config);
+}
