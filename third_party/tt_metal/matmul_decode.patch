diff --git ttnn/cpp/ttnn/operations/matmul/device/factory/matmul_multicore_program_factory.cpp ttnn/cpp/ttnn/operations/matmul/device/factory/matmul_multicore_program_factory.cpp
--- ttnn/cpp/ttnn/operations/matmul/device/factory/matmul_multicore_program_factory.cpp
+++ ttnn/cpp/ttnn/operations/matmul/device/factory/matmul_multicore_program_factory.cpp
@@ -241,4 +241,227 @@ ProgramDescriptor MatmulMultiCoreProgramFactory::create_descriptor(
     return desc;
 }
 
+namespace {
+
+// Core layout of a decode matmul: output tiles are split as evenly as possible
+// over num_cores cores, and each core processes its tiles in passes of up to
+// `group`.
+struct DecodeLayout {
+    uint32_t num_cores;
+    uint32_t group;
+    uint32_t in0_block_w;
+    uint32_t in0_mcast_w;
+};
+
+DecodeLayout decode_layout(uint32_t Kt, uint32_t out_Nt, uint32_t halves, uint32_t num_worker_cores) {
+    // The accumulators of every weight half for one pass share the eight FP32
+    // DST tiles.
+    const uint32_t max_group = 8 / halves;
+    const uint32_t num_cores = std::min(out_Nt, num_worker_cores);
+    const uint32_t max_per_core = tt::div_up(out_Nt, num_cores);
+    const uint32_t passes = tt::div_up(max_per_core, max_group);
+    uint32_t in0_mcast_w = 8;
+    while (Kt % in0_mcast_w != 0) {
+        in0_mcast_w /= 2;
+    }
+    return DecodeLayout{
+        .num_cores = num_cores,
+        .group = tt::div_up(max_per_core, passes),
+        .in0_block_w = Kt % 2 == 0 ? 2u : 1u,
+        .in0_mcast_w = in0_mcast_w,
+    };
+}
+
+}  // namespace
+
+ProgramDescriptor MatmulDecodeProgramFactory::create_descriptor(
+    const ttnn::prim::MatmulParams& operation_attributes,
+    const ttnn::prim::MatmulInputs& tensor_args,
+    std::vector<ttnn::Tensor>& tensor_return_value,
+    const std::optional<CoreRangeSet>& /*core_range_set*/) {
+    const auto& a = tensor_args.input_tensors.at(0).mesh_tensor();
+    const auto& b = tensor_args.input_tensors.at(1).mesh_tensor();
+    const auto& output = tensor_return_value.at(0).mesh_tensor();
+    auto* device = &a.mutable_device();
+
+    const uint32_t Kt = a.padded_shape()[-1] / TILE_WIDTH;
+    // SwiGLU's weight holds an up and a gate half for every output tile.
+    const uint32_t halves = operation_attributes.fused_swiglu ? 2 : 1;
+    const bool transpose_b = operation_attributes.transpose_b;
+    const uint32_t out_Nt = b.padded_shape()[transpose_b ? -2 : -1] / TILE_WIDTH / halves;
+    const auto bias_tensor = tensor_args.optional_input_tensors.empty() ? std::nullopt
+                                                                     : tensor_args.optional_input_tensors[0];
+    const auto grid = device->compute_with_storage_grid_size();
+    const auto [num_cores, group, in0_block_w, in0_mcast_w] = decode_layout(Kt, out_Nt, halves, grid.x * grid.y);
+    constexpr uint32_t in1_buffers = 2;
+    const uint32_t in1_block_num_tiles = in0_block_w * halves * group;
+    // Output tiles are split as evenly as possible: the first `extra` cores
+    // take one more than the rest.
+    const uint32_t base_count = out_Nt / num_cores;
+    const uint32_t extra = out_Nt % num_cores;
+    auto count_of = [&](uint32_t i) { return base_count + (i < extra ? 1 : 0); };
+    auto start_of = [&](uint32_t i) { return i * base_count + std::min(i, extra); };
+
+    // Cores are numbered row-major over the worker grid. Full rows form one
+    // multicast group and a partial last row forms another; the first core
+    // of each group multicasts the activation to the rest of it.
+    const uint32_t grid_x = grid.x;
+    auto core_at = [&](uint32_t i) { return CoreCoord(i % grid_x, i / grid_x); };
+    std::vector<CoreRange> groups;
+    if (num_cores >= grid_x) {
+        groups.emplace_back(CoreCoord(0, 0), core_at(num_cores / grid_x * grid_x - 1));
+    }
+    if (num_cores % grid_x != 0) {
+        groups.emplace_back(core_at(num_cores / grid_x * grid_x), core_at(num_cores - 1));
+    }
+    const CoreRangeSet all_cores(groups);
+
+    const auto in0_format = tt_metal::datatype_to_dataformat_converter(a.dtype());
+    const auto in1_format = tt_metal::datatype_to_dataformat_converter(b.dtype());
+    const auto output_format = tt_metal::datatype_to_dataformat_converter(output.dtype());
+    ProgramDescriptor desc;
+    auto add_cb = [&](uint32_t index, uint32_t tiles, tt::DataFormat format) {
+        const uint32_t page_size = tt::tile_size(format);
+        desc.cbs.push_back(CBDescriptor{
+            .total_size = tiles * page_size,
+            .core_ranges = all_cores,
+            .format_descriptors = {{CBFormatDescriptor{
+                .buffer_index = index, .data_format = format, .page_size = page_size}}},
+        });
+    };
+    add_cb(tt::CBIndex::c_0, Kt, in0_format);
+    // Even weight K blocks arrive on RISCV_0's NOC and odd blocks on RISCV_1's.
+    add_cb(tt::CBIndex::c_1, in1_buffers * in1_block_num_tiles, in1_format);
+    add_cb(tt::CBIndex::c_2, in1_buffers * in1_block_num_tiles, in1_format);
+    add_cb(tt::CBIndex::c_16, count_of(0), output_format);
+    if (bias_tensor.has_value()) {
+        add_cb(tt::CBIndex::c_3, count_of(0), tt_metal::datatype_to_dataformat_converter(bias_tensor->dtype()));
+    }
+
+    constexpr uint32_t sender_sem_id = 0;
+    constexpr uint32_t receiver_sem_id = 1;
+    desc.semaphores.push_back(tt::tt_metal::SemaphoreDescriptor{
+        .id = sender_sem_id, .core_ranges = all_cores, .initial_value = 0});
+    desc.semaphores.push_back(tt::tt_metal::SemaphoreDescriptor{
+        .id = receiver_sem_id, .core_ranges = all_cores, .initial_value = 0});
+
+    const auto in0_noc = tt::tt_metal::detail::preferred_noc_for_dram_write(device->arch());
+    const auto in1_noc = tt::tt_metal::detail::preferred_noc_for_dram_read(device->arch());
+    const std::vector<std::pair<std::string, uint32_t>> common_args = {
+        {"cb_in0", tt::CBIndex::c_0},
+        {"cb_weights", tt::CBIndex::c_1},
+        {"cb_weights2", tt::CBIndex::c_2},
+        {"cb_out", tt::CBIndex::c_16},
+        {"cb_bias", tt::CBIndex::c_3},
+        {"has_bias", bias_tensor.has_value()},
+        {"transpose_b", transpose_b},
+        {"Kt", Kt},
+        {"halves", halves},
+        {"out_Nt", out_Nt},
+        {"group", group},
+        {"in0_block_w", in0_block_w},
+        {"in0_mcast_w", in0_mcast_w},
+        {"sender_sem", sender_sem_id},
+        {"receiver_sem", receiver_sem_id},
+    };
+    auto make_kernel = [&](const char* name, std::vector<uint32_t> compile_args,
+                           tt_metal::DataMovementProcessor processor, tt::tt_metal::NOC noc) {
+        KernelDescriptor kernel;
+        kernel.kernel_source =
+            std::string("ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/") + name;
+        kernel.source_type = KernelDescriptor::SourceType::FILE_PATH;
+        kernel.compile_time_args = std::move(compile_args);
+        kernel.named_compile_time_args = common_args;
+        kernel.config = tt::tt_metal::DataMovementConfigDescriptor{.processor = processor, .noc = noc};
+        return kernel;
+    };
+
+    std::vector<uint32_t> reader_args;
+    tt::tt_metal::TensorAccessorArgs(b).append_to(reader_args);
+    tt::tt_metal::TensorAccessorArgs(output).append_to(reader_args);
+    if (bias_tensor.has_value()) {
+        tt::tt_metal::TensorAccessorArgs(bias_tensor->mesh_tensor()).append_to(reader_args);
+    }
+    auto reader = make_kernel(
+        "reader_matmul_decode.cpp", reader_args, tt_metal::DataMovementProcessor::RISCV_0, in1_noc);
+    reader.core_ranges = all_cores;
+    std::vector<uint32_t> sender_args;
+    tt::tt_metal::TensorAccessorArgs(a).append_to(sender_args);
+    tt::tt_metal::TensorAccessorArgs(b).append_to(sender_args);
+    auto sender = make_kernel(
+        "reader_matmul_decode_in0_sender.cpp", sender_args, tt_metal::DataMovementProcessor::RISCV_1, in0_noc);
+    std::vector<uint32_t> receiver_args;
+    tt::tt_metal::TensorAccessorArgs(b).append_to(receiver_args);
+    auto receiver = make_kernel(
+        "reader_matmul_decode_in0_receiver.cpp", receiver_args, tt_metal::DataMovementProcessor::RISCV_1, in0_noc);
+
+    std::vector<CoreRange> sender_ranges;
+    std::vector<CoreRange> receiver_ranges;
+    for (const auto& group : groups) {
+        sender_ranges.emplace_back(group.start_coord, group.start_coord);
+        const uint32_t first = group.start_coord.y * grid_x + group.start_coord.x;
+        const uint32_t last = group.end_coord.y * grid_x + group.end_coord.x;
+        auto start = device->worker_core_from_logical_core(group.start_coord);
+        auto end = device->worker_core_from_logical_core(group.end_coord);
+        const auto sender_physical = start;
+        if (in0_noc == tt::tt_metal::NOC::NOC_1) {
+            std::swap(start, end);
+        }
+        sender.emplace_runtime_args(
+            group.start_coord,
+            {a,
+             static_cast<uint32_t>(start.x),
+             static_cast<uint32_t>(start.y),
+             static_cast<uint32_t>(end.x),
+             static_cast<uint32_t>(end.y),
+             last - first,
+             b,
+             start_of(first),
+             count_of(first)});
+        for (uint32_t i = first + 1; i <= last; ++i) {
+            receiver_ranges.emplace_back(core_at(i), core_at(i));
+            receiver.emplace_runtime_args(
+                core_at(i),
+                {static_cast<uint32_t>(sender_physical.x),
+                 static_cast<uint32_t>(sender_physical.y),
+                 b,
+                 start_of(i),
+                 count_of(i)});
+        }
+    }
+    for (uint32_t i = 0; i < num_cores; ++i) {
+        std::vector<std::variant<uint32_t, std::reference_wrapper<const tt::tt_metal::MeshTensor>>> args = {
+            b, output, start_of(i), count_of(i)};
+        if (bias_tensor.has_value()) {
+            args.emplace_back(bias_tensor->mesh_tensor());
+        }
+        reader.emplace_runtime_args(core_at(i), args);
+    }
+    sender.core_ranges = CoreRangeSet(sender_ranges);
+    desc.kernels.push_back(std::move(reader));
+    desc.kernels.push_back(std::move(sender));
+    if (!receiver_ranges.empty()) {
+        receiver.core_ranges = CoreRangeSet(receiver_ranges).merge_ranges();
+        desc.kernels.push_back(std::move(receiver));
+    }
+
+    const auto config = operation_attributes.compute_kernel_config.value_or(DeviceComputeKernelConfig{});
+    KernelDescriptor compute;
+    compute.kernel_source = "ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/matmul_decode.cpp";
+    compute.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    compute.core_ranges = all_cores;
+    compute.named_compile_time_args = common_args;
+    for (uint32_t i = 0; i < num_cores; ++i) {
+        compute.emplace_runtime_args(core_at(i), {count_of(i)});
+    }
+    // The kernel accumulates every output tile over all of K in FP32 DST.
+    compute.config = ComputeConfigDescriptor{
+        .math_fidelity = config.math_fidelity,
+        .fp32_dest_acc_en = true,
+        .dst_full_sync_en = true,
+        .math_approx_mode = config.math_approx_mode};
+    desc.kernels.push_back(std::move(compute));
+    return desc;
+}
+
 }  // namespace ttnn::prim
