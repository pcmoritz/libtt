diff --git ttnn/cpp/ttnn/operations/data_movement/common/float8_bytes.hpp ttnn/cpp/ttnn/operations/data_movement/common/float8_bytes.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/data_movement/common/float8_bytes.hpp
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <variant>
+
+#include <tt-metalium/float8.hpp>
+
+#include "ttnn/tensor/tensor.hpp"
+#include "ttnn/tensor/tensor_ops.hpp"
+#include "ttnn/tensor/types.hpp"
+
+namespace ttnn::operations::data_movement {
+
+// Float8 tensors (FP8_E4M3, FP8_E5M2) on device move as their bytes: a data-movement op runs its UINT8 path on a
+// view of them, which copies every byte as it is, and views its result as float8 again. The float8 formats' own
+// paths unpack the values, which the hardware converts inexactly (it truncates and flushes subnormals), or reject
+// them.
+inline bool is_float8(tt::tt_metal::DataType dtype) {
+    return dtype == tt::tt_metal::DataType::FP8_E4M3 || dtype == tt::tt_metal::DataType::FP8_E5M2;
+}
+
+inline bool is_float8_on_device(const Tensor& tensor) {
+    return is_float8(tensor.dtype()) && tensor.storage_type() == StorageType::DEVICE;
+}
+
+inline Tensor float8_as_bytes(const Tensor& tensor) {
+    return unchecked_reinterpret_dtype(tensor, tt::tt_metal::DataType::UINT8);
+}
+
+inline std::optional<Tensor> float8_as_bytes(const std::optional<Tensor>& tensor) {
+    return tensor.has_value() ? std::optional<Tensor>(float8_as_bytes(*tensor)) : std::nullopt;
+}
+
+inline Tensor bytes_as_float8(const Tensor& bytes, tt::tt_metal::DataType dtype) {
+    return unchecked_reinterpret_dtype(bytes, dtype);
+}
+
+// A pad or fill value's float8 code, rounded to nearest even.
+inline uint8_t float8_code(float value, tt::tt_metal::DataType dtype) {
+    return dtype == tt::tt_metal::DataType::FP8_E4M3 ? float8_e4m3(value).to_bits() : float8_e5m2(value).to_bits();
+}
+
+// A pad value for the bytes: a float becomes its float8 code; a uint32 is a code already.
+inline PadValue float8_pad(const PadValue& value, tt::tt_metal::DataType dtype) {
+    if (const float* f = std::get_if<float>(&value)) {
+        return static_cast<uint32_t>(float8_code(*f, dtype));
+    }
+    return value;
+}
+
+}  // namespace ttnn::operations::data_movement
