diff --git ttnn/cpp/ttnn/operations/data_movement/common/float8.hpp ttnn/cpp/ttnn/operations/data_movement/common/float8.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/data_movement/common/float8.hpp
@@ -0,0 +1,27 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent AI ULC
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+
+#include <tt-metalium/float8.hpp>
+
+#include "ttnn/tensor/types.hpp"
+
+namespace ttnn::operations::data_movement {
+
+// Float8 (FP8_E4M3, FP8_E5M2) tensors move as their bytes (data_movement_format).
+
+inline bool is_float8(tt::tt_metal::DataType dtype) {
+    return dtype == tt::tt_metal::DataType::FP8_E4M3 || dtype == tt::tt_metal::DataType::FP8_E5M2;
+}
+
+// A pad value's float8 code: rounded to nearest even, subnormals kept, NaN (e4m3) or infinity (e5m2) past the
+// largest finite value, as libtt's exact typecast encodes.
+inline uint8_t float8_code(float value, tt::tt_metal::DataType dtype) {
+    return dtype == tt::tt_metal::DataType::FP8_E4M3 ? float8_e4m3(value).to_bits() : float8_e5m2(value).to_bits();
+}
+
+}  // namespace ttnn::operations::data_movement
