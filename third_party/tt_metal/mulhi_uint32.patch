+// High 32 bits of the 64-bit product of two UInt32 tiles.
+ALWI void mulhi_uint32_tile(uint32_t idst0, uint32_t idst1, uint32_t odst) {
+    MATH((SFPU_BINARY_CALL(DST_SYNC_MODE, DST_ACCUM_MODE, mulhi_uint32, (APPROX), idst0, idst1, odst, VectorMode::RC)));
+}
+
+ALWI void mulhi_uint32_tile_init() { MATH((SFPU_BINARY_INIT(mul_int32))); }
+#endif
+
 }  // namespace ckernel
