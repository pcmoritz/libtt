+void AllocatorImpl::reset_peak_statistics(const BufferType& buffer_type) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    switch (buffer_type) {
+        case BufferType::DRAM: return dram_manager_->reset_peak_statistics();
+        case BufferType::L1: return l1_manager_->reset_peak_statistics();
+        case BufferType::L1_SMALL: return l1_small_manager_->reset_peak_statistics();
+        case BufferType::TRACE: return trace_buffer_manager_->reset_peak_statistics();
+        default: {
+            TT_THROW("Unsupported buffer type!");
+        }
+    }
+}
