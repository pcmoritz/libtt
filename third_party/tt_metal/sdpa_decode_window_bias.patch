+/**
+ * One chunk of causal mode's window bias: for each of the PNHt head tiles, Sk_chunk_t tiles for key tiles
+ * k_tile_start.. of a [Bmask, PNHt, window_t] tile grid whose tile t is key tile first_tile + t. Key tiles outside
+ * the window take zeros.
+ */
+template <uint32_t cb_bias_in, uint32_t window_t, uint32_t barrier_threshold, uint32_t PNHt, typename BiasReaderType>
+void read_window_bias_chunk(
+    uint32_t batch_offset,
+    uint32_t first_tile,
+    uint32_t k_tile_start,
+    uint32_t Sk_chunk_t,
+    const BiasReaderType& bias_reader) {
+    Noc noc;
+    constexpr uint32_t tile_bytes = get_tile_size(cb_bias_in);
+    CircularBuffer cb_bias(cb_bias_in);
+    const uint32_t chunk_tiles = PNHt * Sk_chunk_t;
+    cb_bias.reserve_back(chunk_tiles);
+    uint32_t write_ptr = cb_bias.get_write_ptr();
+    uint32_t barrier_count = 0;
+    bool zeroed = false;
+    for (uint32_t row = 0; row < PNHt; ++row) {
+        for (uint32_t col = 0; col < Sk_chunk_t; ++col) {
+            const uint32_t k_tile = k_tile_start + col;
+            if (k_tile >= first_tile && k_tile - first_tile < window_t) {
+                // An explicit size: the CB may hold half tiles (16x32) of the bias's full DRAM tiles.
+                noc.async_read(
+                    bias_reader,
+                    CoreLocalMem<uint32_t>(write_ptr),
+                    tile_bytes,
+                    {.page_id = batch_offset + row * window_t + k_tile - first_tile},
+                    {});
+                if (++barrier_count == barrier_threshold) {
+                    noc.async_read_barrier();
+                    barrier_count = 0;
+                }
+            } else {
+                noc.async_write_zeros(cb_bias, tile_bytes, {.offset_bytes = write_ptr - cb_bias.get_write_ptr()});
+                zeroed = true;
+            }
+            write_ptr += tile_bytes;
+        }
+    }
+    noc.async_read_barrier();
+    if (zeroed) {
+        noc.write_zeros_l1_barrier();
+    }
+    cb_bias.push_back(chunk_tiles);
+}
