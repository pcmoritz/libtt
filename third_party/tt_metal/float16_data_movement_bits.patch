+// Data movement only copies values, so a Float16 tensor is moved as UInt16 and no kernel interprets it.
+// Unpacking Float16 flushes subnormals and -0 to +0.
+inline tt::DataFormat data_movement_format(DataType dtype) {
+    return dtype == DataType::FLOAT16 ? tt::DataFormat::UInt16
+                                      : tt::tt_metal::datatype_to_dataformat_converter(dtype);
