+#include <utility>
+
 #include <tt-metalium/host_api.hpp>
 #include "ttnn/tensor/tensor.hpp"
 
@@ -10,4 +12,15 @@ namespace ttnn::prim::detail {
 
 uint32_t get_packed_value(const tt::tt_metal::Tensor& tensor, const tt::tt_metal::PadValue& pad_value);
 
+inline std::pair<tt::DataFormat, tt::DataFormat> get_cb_formats(
+    tt::tt_metal::DataType input_dtype, tt::tt_metal::DataType output_dtype) {
+    if (input_dtype == tt::tt_metal::DataType::FLOAT16 &&
+        output_dtype == tt::tt_metal::DataType::FLOAT16) {
+        // Padding changes layout but not FP16 values, so move their raw bits.
+        return {tt::DataFormat::UInt16, tt::DataFormat::UInt16};
+    }
+    return {tt::tt_metal::datatype_to_dataformat_converter(input_dtype),
+            tt::tt_metal::datatype_to_dataformat_converter(output_dtype)};
+}
+
 }  // namespace ttnn::prim::detail
