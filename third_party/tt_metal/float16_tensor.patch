+template <bool APPROXIMATION_MODE, int ITERATIONS>
+inline void cast_fp16a_to_fp32() {
+    for (int d = 0; d < ITERATIONS; d++) {
+        // In 32-bit DST mode, UInt16 tiles are unpacked into the low half of
+        // each word. Loading U16 would apply the 16-bit DST lane swizzle.
