diff --git tt_metal/hw/inc/internal/tt-1xx/float16_conversion.h tt_metal/hw/inc/internal/tt-1xx/float16_conversion.h
new file mode 100644
--- /dev/null
+++ tt_metal/hw/inc/internal/tt-1xx/float16_conversion.h
@@ -0,0 +1,56 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include "sfpi.h"
+
+namespace ckernel::sfpu {
+
+// Returns the exact Float32 representation of the IEEE Float16 value obtained
+// by round-to-nearest-even. Keeping the result in Float32 lets the packer emit
+// Float16 without making a second rounding decision.
+sfpi_inline sfpi::vFloat float32_to_float16_rne(sfpi::vFloat input) {
+    sfpi::vUInt bits = sfpi::as<sfpi::vUInt>(input);
+    sfpi::vUInt sign = bits & 0x80000000U;
+    sfpi::vUInt magnitude = bits & 0x7fffffffU;
+    sfpi::vUInt rounded;
+
+    v_if(magnitude >= 0x7f800000U) {
+        // Preserve infinities and NaNs.
+        rounded = magnitude;
+    }
+    v_elseif(magnitude >= 0x477ff000U) {
+        // Values at or above the midpoint after max-finite overflow to infinity.
+        rounded = 0x7f800000U;
+    }
+    v_elseif(magnitude >= 0x38800000U) {
+        // Normal Float16: discard 13 mantissa bits with the retained LSB as
+        // the tie breaker.
+        sfpi::vUInt lsb = (magnitude >> 13) & 1U;
+        rounded = (magnitude + 0xfffU + lsb) & 0xffffe000U;
+    }
+    v_elseif(magnitude > 0x33000000U) {
+        // Float16 subnormal. Quantize the Float32 significand to a multiple of
+        // 2^-24, again adding half minus one plus the retained LSB for RNE.
+        sfpi::vUInt exponent = (magnitude >> 23) & 0xffU;
+        sfpi::vUInt significand = (magnitude & 0x7fffffU) | 0x800000U;
+        sfpi::vInt shift = sfpi::vInt(126) - sfpi::as<sfpi::vInt>(exponent);
+        sfpi::vUInt truncated =
+            sfpi::shft(significand, -shift, sfpi::ShiftMode::Logical);
+        sfpi::vUInt half =
+            sfpi::shft(sfpi::vUInt(1), shift - 1, sfpi::ShiftMode::Logical);
+        sfpi::vUInt value = sfpi::shft(
+            significand + half - 1U + (truncated & 1U), -shift,
+            sfpi::ShiftMode::Logical);
+        sfpi::vFloat valueFloat = sfpi::convert<sfpi::vFloat>(
+            sfpi::as<sfpi::vSMag>(value), sfpi::RoundMode::Nearest);
+        rounded = sfpi::as<sfpi::vUInt>(valueFloat * 0x1p-24f);
+    }
+    v_else { rounded = 0U; }
+    v_endif;
+    return sfpi::as<sfpi::vFloat>(rounded | sign);
+}
+
+}  // namespace ckernel::sfpu
