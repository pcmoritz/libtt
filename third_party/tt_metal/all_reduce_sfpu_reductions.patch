@@ -12,6 +12,7 @@
 #include <tt-metalium/hal.hpp>
 #include <tt-metalium/constants.hpp>
 #include <tt-metalium/math.hpp>
+#include <tt-metalium/circular_buffer_constants.h>
 
 #include "ttnn/operations/experimental/ccl/composite_common.hpp"
 
@@ -467,4 +468,53 @@ void append_fabric_mux_connection_rt_args(
     worker_rt_args.push_back(static_cast<uint32_t>(termination_master_virtual_core.y));
 }
 
+bool reduce_op_reads_dst(reduction_common::ReduceType math_op, tt::tt_metal::DataType dtype) {
+    return math_op != reduction_common::ReduceType::Sum || reduce_op_uses_fp32_dest(math_op, dtype);
+}
+
+bool reduce_op_uses_fp32_dest(reduction_common::ReduceType /*math_op*/, tt::tt_metal::DataType dtype) {
+    return dtype == tt::tt_metal::DataType::FLOAT32 || dtype == tt::tt_metal::DataType::INT32 ||
+           dtype == tt::tt_metal::DataType::UINT32;
+}
+
+void configure_reduce_op(
+    tt::tt_metal::ComputeConfig& config, reduction_common::ReduceType math_op, tt::tt_metal::DataType dtype) {
+    std::string op;
+    std::string init;
+    if (math_op == reduction_common::ReduceType::Sum) {
+        // add_tiles adds on the FPU, whose source registers keep only TF32, so
+        // 32-bit sums go through the SFPU with a 32-bit DST instead.
+        if (dtype == tt::tt_metal::DataType::FLOAT32) {
+            op = "add_binary_tile";
+            init = "add_binary_tile_init";
+        } else if (dtype == tt::tt_metal::DataType::INT32) {
+            op = "add_int_tile<DataFormat::Int32>";
+            init = "add_int_tile_init";
+        } else if (dtype == tt::tt_metal::DataType::UINT32) {
+            op = "add_int_tile<DataFormat::UInt32>";
+            init = "add_int_tile_init";
+        } else {
+            return;
+        }
+    } else {
+        TT_FATAL(
+            math_op == reduction_common::ReduceType::Max || math_op == reduction_common::ReduceType::Min,
+            "Reductions only support sum, max and min");
+        std::string name = math_op == reduction_common::ReduceType::Max ? "binary_max" : "binary_min";
+        if (dtype == tt::tt_metal::DataType::INT32) {
+            name += "_int32";
+        } else if (dtype == tt::tt_metal::DataType::UINT32) {
+            name += "_uint32";
+        }
+        op = name + "_tile";
+        init = name + "_tile_init";
+    }
+    config.defines["REDUCE_OP"] = op;
+    config.defines["REDUCE_OP_INIT"] = init;
+    if (reduce_op_uses_fp32_dest(math_op, dtype)) {
+        config.fp32_dest_acc_en = true;
+        config.unpack_to_dest_mode.assign(NUM_CIRCULAR_BUFFERS, tt::tt_metal::UnpackToDestMode::UnpackToDestFp32);
+    }
+}
+
 }  // namespace ttnn::experimental::ccl
