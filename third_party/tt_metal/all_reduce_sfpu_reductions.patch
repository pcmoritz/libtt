diff --git ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/kernels/reduce_tiles.hpp ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/kernels/reduce_tiles.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/kernels/reduce_tiles.hpp
@@ -0,0 +1,42 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+// Max, min and 32-bit sum reductions for kernels that otherwise sum with
+// add_tiles. The host defines REDUCE_OP and REDUCE_OP_INIT (see
+// reduce_op_defines) to the SFPU function, which reads both operands from DST:
+// results live in DST[0, n) and second operands in DST[n, 2n), so n is at most
+// half of DST.
+#ifdef REDUCE_OP
+
+#include "api/compute/add_int_sfpu.h"
+#include "api/compute/binary_max_min.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/tile_move_copy.h"
+
+// DST[dst + i] = tile first + i of cb, for i < num_tiles.
+ALWI void load_tiles(uint32_t cb, uint32_t first, uint32_t dst, uint32_t num_tiles) {
+    copy_tile_to_dst_init_short(cb);
+    for (uint32_t i = 0; i < num_tiles; ++i) {
+        copy_tile(cb, first + i, dst + i);
+    }
+}
+
+// DST[i] = REDUCE_OP(DST[i], DST[num_tiles + i]), for i < num_tiles.
+ALWI void reduce_dst_tiles(uint32_t num_tiles) {
+    REDUCE_OP_INIT();
+    for (uint32_t i = 0; i < num_tiles; ++i) {
+        REDUCE_OP(i, num_tiles + i, i);
+    }
+}
+
+// DST[i] = REDUCE_OP(tile i of cb_a, tile i of cb_b), for i < num_tiles.
+ALWI void reduce_tiles(uint32_t cb_a, uint32_t cb_b, uint32_t num_tiles) {
+    load_tiles(cb_a, 0, 0, num_tiles);
+    load_tiles(cb_b, 0, num_tiles, num_tiles);
+    reduce_dst_tiles(num_tiles);
+}
+
+#endif
diff --git ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/reduce_scatter_program_utils.cpp ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/reduce_scatter_program_utils.cpp
--- ttnn/cpp/ttnn/operations/experimental/ccl/reduce_scatter_common/reduce_scatter_program_utils.cpp
