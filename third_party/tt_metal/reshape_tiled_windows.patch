+// A tiled reshape planned on the host (ReshapeViewTiledProgramFactory): every segment of this core's
+// output pages lies within one aligned window of its input page. The kernel reads each segment's
+// window, copies the segments into its output pages and writes the windows of those pages that the
+// segments touch, each step behind one barrier.
+
+#include <stdint.h>
+
+#include "experimental/kernel_args.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/scratchpad.h"
+
+#include "ttnn/operations/data_movement/common/kernels/common.hpp"
+
+using namespace tt::data_movement::common;
+
+void kernel_main() {
+    const uint32_t start_output_page = get_arg(args::start_output_page);
+    const uint32_t num_pages = get_arg(args::num_pages);
+    const uint32_t num_segments = get_arg(args::num_segments);
+
+    constexpr uint32_t Tile_size_bytes = get_arg(args::Tile_size_bytes);
+    constexpr uint32_t Alignment = get_arg(args::Alignment);
+    constexpr uint32_t Max_Segments = get_arg(args::Max_Segments);
+    constexpr uint32_t Windows_Per_Page = Tile_size_bytes / Alignment;
+    constexpr uint32_t Bitmap_Words = (Windows_Per_Page + 31) / 32;
+
+    const auto input = TensorAccessor(tensor::input);
+    const auto output = TensorAccessor(tensor::output);
+    Noc noc;
+    // One window per segment, then this core's output pages.
+    Scratchpad<uint8_t> staging(scratch::staging);
+    const uint32_t windows_base = round_up(staging.get_base_address(), Alignment);
+    const uint32_t pages_base = windows_base + Max_Segments * Alignment;
+
+    // Segment s: vararg 2s is its window (input page * Windows_Per_Page + window in the page); vararg
+    // 2s + 1 packs its offset in the window (bits 0-5), its byte offset in this core's output pages
+    // (bits 6-21) and its size in bytes (bits 22-29).
+    for (uint32_t s = 0; s < num_segments; ++s) {
+        const uint32_t window = get_vararg(2 * s);
+        enhanced_noc_async_read<Alignment, true>(
+            noc,
+            input.get_noc_addr(window / Windows_Per_Page, (window % Windows_Per_Page) * Alignment),
+            windows_base + s * Alignment,
+            Alignment);
+    }
+    noc.async_read_barrier();
+
+    for (uint32_t s = 0; s < num_segments; ++s) {
+        const uint32_t packed = get_vararg(2 * s + 1);
+        tt_memmove<false, true, true, Alignment>(
+            noc, pages_base + ((packed >> 6) & 0xFFFF), windows_base + s * Alignment + (packed & 0x3F), packed >> 22);
+    }
+    noc.async_read_barrier();
+
+    // Output page j: bit w of its Bitmap_Words varargs, after the segments', marks window w as touched.
+    // Runs of touched windows are written; the rest of the page is tile padding.
+    for (uint32_t j = 0; j < num_pages; ++j) {
+        const uint32_t bitmap = 2 * Max_Segments + j * Bitmap_Words;
+        auto touched = [&](uint32_t w) { return (get_vararg(bitmap + w / 32) >> (w % 32)) & 1; };
+        const uint32_t page_addr = pages_base + j * Tile_size_bytes;
+        const uint64_t page_noc_addr = output.get_noc_addr(start_output_page + j);
+        for (uint32_t w = 0; w < Windows_Per_Page;) {
+            if (!touched(w)) {
+                ++w;
+                continue;
+            }
+            uint32_t end = w + 1;
+            while (end < Windows_Per_Page && touched(end)) {
+                ++end;
+            }
+            enhanced_noc_async_write<Tile_size_bytes, true>(
+                noc, page_addr + w * Alignment, page_noc_addr + w * Alignment, (end - w) * Alignment);
+            w = end;
+        }
+    }
+    noc.async_write_barrier();
+}
