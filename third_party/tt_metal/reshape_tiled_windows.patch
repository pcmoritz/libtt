+
+// A reshape small enough per core runs as one data-movement kernel on a plan the host computes here
+// (reshape_tiled_windows.cpp): no mapping tensor, and all of a core's input reads behind one barrier
+// instead of a mapping-page read followed by input-page reads for every output page. It applies when
+// every segment lies within one aligned window of its input page, so that a window read brings it in,
+// and when each core's segments fit its runtime args and its output pages a few L1 pages.
+std::optional<ttnn::device_operation::ProgramArtifacts> create_windowed_program_artifacts(
+    const Tensor& input_tensor,
+    const Tensor& output_tensor,
+    const CoreRangeSet& all_cores,
+    const CoreRangeSet& core_group_1,
+    const CoreRangeSet& core_group_2,
+    const uint32_t num_tiles_per_core_group_1,
+    const uint32_t num_tiles_per_core_group_2) {
+    using namespace tt::tt_metal;
+    using namespace tt::tt_metal::experimental;
+    constexpr uint32_t kMaxPagesPerCore = 8;
+    constexpr uint32_t kMaxSegmentsPerCore = 128;  // two runtime args each
+
+    const auto& input_shape = input_tensor.logical_shape();
+    const auto& output_shape = output_tensor.logical_shape();
+    const auto& tile_shape = input_tensor.tensor_spec().tile().get_tile_shape();
+    const auto& face_shape = input_tensor.tensor_spec().tile().get_face_shape();
+    const auto data_format = datatype_to_dataformat_converter(output_tensor.dtype());
+    const uint32_t tile_bytes = tt::tile_size(data_format);
+    const uint32_t element_size = tt::datum_size(data_format);
+    const uint32_t alignment = std::max(hal::get_dram_alignment(), hal::get_l1_alignment());
+    const uint32_t windows_per_page = tile_bytes / alignment;
+    const uint32_t bitmap_words = tt::div_up(windows_per_page, 32u);
+    const uint32_t max_pages = std::max(num_tiles_per_core_group_1, num_tiles_per_core_group_2);
+    const uint64_t num_input_pages = tt::div_up(input_tensor.physical_volume(), tile_shape[0] * tile_shape[1]);
+    // The kernel's packing of a segment: its window as one word, and its offset in the window, its
+    // offset in the core's output pages and its size in 6, 16 and 8 bits.
+    if (max_pages > kMaxPagesPerCore || alignment > 64 || tile_bytes % alignment != 0 ||
+        num_input_pages * windows_per_page > std::numeric_limits<uint32_t>::max()) {
+        return std::nullopt;
+    }
+
+    struct CorePlan {
+        CoreCoord core;
+        uint32_t start_page = 0;
+        uint32_t num_pages = 0;
+        std::vector<uint32_t> segments;  // two words per segment
+        std::vector<uint32_t> bitmaps;   // per output page, the windows its segments touch
+    };
+    const Dims tile_dims_input(input_shape, tile_shape), tile_dims_output(output_shape, tile_shape);
+    std::vector<CorePlan> plans;
+    uint32_t max_segments = 0;
+    uint32_t page = 0;
+    for (const auto& core : corerange_to_cores(all_cores, std::nullopt)) {
+        const uint32_t num_pages = core_group_1.contains(core)   ? num_tiles_per_core_group_1
+                                   : core_group_2.contains(core) ? num_tiles_per_core_group_2
+                                                                 : 0;
+        if (num_pages == 0) {
+            continue;
+        }
+        auto& plan = plans.emplace_back(CorePlan{.core = core, .start_page = page, .num_pages = num_pages});
+        plan.bitmaps.assign(num_pages * bitmap_words, 0);
+        for (uint32_t j = 0; j < num_pages; ++j, ++page) {
+            for (const auto& segment : reshape_map_output_page(
+                     page, input_shape, output_shape, tile_dims_input, tile_dims_output, tile_shape, face_shape)) {
+                if (segment.num_elements == 0) {
+                    continue;
+                }
+                const uint32_t in_begin = segment.input_page_offset * element_size;
+                const uint32_t out_begin = segment.output_page_offset * element_size;
+                const uint32_t size = segment.num_elements * element_size;
+                if (in_begin % alignment + size > alignment) {
+                    return std::nullopt;
+                }
+                plan.segments.push_back(segment.input_page_index * windows_per_page + in_begin / alignment);
+                plan.segments.push_back(in_begin % alignment | (j * tile_bytes + out_begin) << 6 | size << 22);
+                for (uint32_t w = out_begin / alignment; w <= (out_begin + size - 1) / alignment; ++w) {
+                    plan.bitmaps[j * bitmap_words + w / 32] |= 1u << (w % 32);
+                }
+            }
+        }
+        if (plan.segments.size() / 2 > kMaxSegmentsPerCore) {
+            return std::nullopt;
+        }
+        max_segments = std::max<uint32_t>(max_segments, plan.segments.size() / 2);
+    }
+    if (max_segments == 0) {
+        return std::nullopt;
+    }
+
+    const KernelSpecName MOVER{"mover"};
+    const ScratchpadSpecName STAGING{"staging"};  // the segments' windows, then the core's output pages
+    const TensorParamName INPUT_T{"input"};
+    const TensorParamName OUTPUT_T{"output"};
+    const auto& input_mt = input_tensor.mesh_tensor();
+    const auto& output_mt = output_tensor.mesh_tensor();
+    const uint32_t num_varargs = 2 * max_segments + max_pages * bitmap_words;
+
+    ProgramSpec spec;
+    spec.name = "reshape_view_tiled_windows";
+    spec.scratchpads = {
+        ScratchpadSpec{
+            .unique_id = STAGING,
+            .size_per_node = alignment + max_segments * alignment + max_pages * tile_bytes,
+        },
+    };
+    KernelSpec mover{
+        .unique_id = MOVER,
+        .source = "ttnn/cpp/ttnn/operations/data_movement/reshape_view/device/device/dataflow/reshape_tiled_windows.cpp",
+        .scratchpad_bindings =
+            {
+                ScratchpadBinding{.scratchpad_spec_name = STAGING, .accessor_name = "staging"},
+            },
+        .tensor_bindings =
+            {
+                TensorBinding{.tensor_parameter_name = INPUT_T, .accessor_name = "input"},
+                TensorBinding{.tensor_parameter_name = OUTPUT_T, .accessor_name = "output"},
+            },
+        .compile_time_args =
+            {
+                {"Tile_size_bytes", tile_bytes},
+                {"Alignment", alignment},
+                {"Max_Segments", max_segments},
+            },
+        .runtime_arg_schema = {.runtime_arg_names = {"start_output_page", "num_pages", "num_segments"}},
+        .hw_config = create_reader_datamovement_config(),
+        .advanced_options = {.num_runtime_varargs = num_varargs},
+    };
+    spec.kernels = {mover};
+    spec.tensor_parameters = {
+        TensorParameter{.unique_id = INPUT_T, .spec = input_mt.tensor_spec()},
+        TensorParameter{.unique_id = OUTPUT_T, .spec = output_mt.tensor_spec()},
+    };
+    spec.work_units = {WorkUnitSpec{.name = "main", .kernels = {MOVER}, .target_nodes = all_cores}};
+
+    KernelRunArgs mover_kra{.kernel = MOVER};
+    for (auto& plan : plans) {
+        AddRuntimeArgsForNode(
+            mover_kra.runtime_arg_values,
+            plan.core,
+            {{"start_output_page", plan.start_page},
+             {"num_pages", plan.num_pages},
+             {"num_segments", static_cast<uint32_t>(plan.segments.size() / 2)}});
+        std::vector<uint32_t> varargs = std::move(plan.segments);
+        varargs.resize(2 * max_segments, 0);
+        varargs.insert(varargs.end(), plan.bitmaps.begin(), plan.bitmaps.end());
+        varargs.resize(num_varargs, 0);
+        mover_kra.advanced_options.runtime_varargs[plan.core] = std::move(varargs);
+    }
+
+    ProgramRunArgs run_args;
+    run_args.kernel_run_args = {std::move(mover_kra)};
+    run_args.tensor_args = {
+        {INPUT_T, TensorArgument{input_mt}},
+        {OUTPUT_T, TensorArgument{output_mt}},
+    };
+    return ttnn::device_operation::ProgramArtifacts{.spec = std::move(spec), .run_params = std::move(run_args)};
+}
