+{
+    if (topk_stable_descending_mode)
+    {
+        topk_cmp_swap_stable_directional<VC, VD, MODE, false>();
+    }
+    else
+    {
+        topk_cmp_swap_stable_directional<VC, VD, MODE, true>();
+    }
+}
