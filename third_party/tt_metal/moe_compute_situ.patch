+// SiTU gating (Kimi-K3, Inkling 2): beta * tanh(gate / beta) * sigmoid(gate) * linear_beta * tanh(up / linear_beta),
+// a SiLU whose gate and up are softcapped. tanh(x) = 2 * sigmoid(2x) - 1 takes the SwiGLU header's sigmoid, whose
+// reciprocal is the only state it initializes: the accurate tanh and the other sigmoid each want the programmable
+// constants for themselves. With FP32 DEST, 2 * sigmoid - 1 near 0 loses only about 2^-24 of the softcap.
+template <bool is_fp32_dest_acc_en, int ITERATIONS, class Config>
+inline void calculate_situ(const uint gate_tile_idx, const uint up_tile_idx, const uint out_tile_idx) {
+    constexpr float beta = Config::beta;
+    constexpr float linear_beta = Config::linear_beta;
+    constexpr uint dst_tile_size = 32;  // 32 rows per tile in SFPU addressing
+
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vFloat gate = sfpi::dst_reg[gate_tile_idx * dst_tile_size];
+        sfpi::vFloat up = sfpi::dst_reg[up_tile_idx * dst_tile_size];
+
+        sfpi::vFloat gate_cap = _swiglu_sigmoid_<is_fp32_dest_acc_en>(gate * (2.0f / beta)) * (2.0f * beta) - beta;
+        sfpi::vFloat up_cap =
+            _swiglu_sigmoid_<is_fp32_dest_acc_en>(up * (2.0f / linear_beta)) * (2.0f * linear_beta) - linear_beta;
+        sfpi::vFloat result = gate_cap * _swiglu_sigmoid_<is_fp32_dest_acc_en>(gate) * up_cap;
+        if constexpr (!is_fp32_dest_acc_en) {
+            result = sfpi::convert<sfpi::vFloat16b>(result, sfpi::RoundMode::Nearest);
+        }
+
+        sfpi::dst_reg[out_tile_idx * dst_tile_size] = result;
+        sfpi::dst_reg++;
+    }
+}
