+TraceAllocationFootprint AllocatorImpl::end_trace_allocation_tracking() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    dram_manager_->end_high_water_mark_tracking();
+    l1_manager_->end_high_water_mark_tracking();
+    l1_small_manager_->end_high_water_mark_tracking();
+    return {
+        .dram = dram_manager_->take_allocation_footprint(),
+        .l1 = l1_manager_->take_allocation_footprint(),
+        .l1_small = l1_small_manager_->take_allocation_footprint(),
+    };
