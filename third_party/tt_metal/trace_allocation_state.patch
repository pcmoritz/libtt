+
+void AllocatorImpl::snapshot_trace_live_allocations(TraceAllocationFootprint& footprint) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    footprint.dram_reserved = dram_manager_->reserve_trace_footprint(footprint.dram);
+    footprint.l1_reserved = l1_manager_->reserve_trace_footprint(footprint.l1);
+    footprint.l1_small_reserved = l1_small_manager_->reserve_trace_footprint(footprint.l1_small);
+    footprint.dram_live = dram_manager_->get_live_allocation_overlaps(footprint.dram);
+    footprint.l1_live = l1_manager_->get_live_allocation_overlaps(footprint.l1);
+    footprint.l1_small_live = l1_small_manager_->get_live_allocation_overlaps(footprint.l1_small);
+}
+
+void AllocatorImpl::release_trace_reservations(const TraceAllocationFootprint& footprint) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    l1_small_manager_->release_trace_reservations(footprint.l1_small_reserved);
+    l1_manager_->release_trace_reservations(footprint.l1_reserved);
+    dram_manager_->release_trace_reservations(footprint.dram_reserved);
+}
