+
+BankManager::AllocationFootprint BankManager::get_live_allocation_overlaps(
+    const AllocationFootprint& footprint) const {
+    AllocationFootprint live_allocations;
+    auto collect_overlaps = [&](uint32_t allocator_id, const AllocationRegion& region) {
+        const auto* alloc = this->get_allocator_from_id(AllocatorDependencies::AllocatorID{allocator_id});
+        TT_FATAL(alloc, "Allocator not initialized for ID {}", allocator_id);
+        for (DeviceAddr address : allocated_buffers_[allocator_id]) {
+            const auto size = alloc->get_allocation_size(address);
+            TT_FATAL(size.has_value(), "Missing allocation size for address {}", address);
+            if (region.begin < address + *size && address < region.end) {
+                live_allocations.push_back({allocator_id, address, address + *size});
+            }
+        }
+    };
+
+    for (const AllocationRegion& region : footprint) {
+        collect_overlaps(region.allocator_id, region);
+        for (const auto dependent_id : allocator_dependencies_.dependencies[region.allocator_id]) {
+            collect_overlaps(dependent_id.get(), region);
+        }
+    }
+    std::sort(
+        live_allocations.begin(),
+        live_allocations.end(),
+        [](const AllocationRegion& lhs, const AllocationRegion& rhs) {
+            return std::tie(lhs.allocator_id, lhs.begin, lhs.end) <
+                   std::tie(rhs.allocator_id, rhs.begin, rhs.end);
+        });
+    live_allocations.erase(
+        std::unique(live_allocations.begin(), live_allocations.end()), live_allocations.end());
+    return live_allocations;
+}
+
+bool BankManager::is_trace_replay_safe(
+    const AllocationFootprint& footprint, const AllocationFootprint& expected_live_allocations) const {
+    const AllocationFootprint live_allocations = get_live_allocation_overlaps(footprint);
+    if (live_allocations == expected_live_allocations) {
+        return true;
+    }
+    log_debug(
+        tt::LogAlways,
+        "Trace replay allocation state changed: expected {} live overlap(s), found {}",
+        expected_live_allocations.size(),
+        live_allocations.size());
+    for (const AllocationRegion& region : expected_live_allocations) {
+        log_debug(
+            tt::LogAlways,
+            "  expected allocator {} [0x{:x}, 0x{:x})",
+            region.allocator_id,
+            region.begin,
+            region.end);
+    }
+    for (const AllocationRegion& region : live_allocations) {
+        log_debug(
+            tt::LogAlways,
+            "  current allocator {} [0x{:x}, 0x{:x})",
+            region.allocator_id,
+            region.begin,
+            region.end);
+    }
+    return false;
+}
