+LiveBufferAllocationLayout AllocatorImpl::get_live_buffer_allocation_layout() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    LiveBufferAllocationLayout layout;
+    layout.reserve(allocated_buffers_.size());
+
+    for (const Buffer* buffer : allocated_buffers_) {
+        const BufferType buffer_type = buffer->buffer_type();
+        if (buffer_type == BufferType::TRACE || buffer->is_trace_command_buffer()) {
+            continue;
+        }
+
+        const DeviceAddr allocation_size = buffer->aligned_size_per_bank();
+        if (buffer->per_core_allocation_) {
+            TT_ASSERT(buffer_type == BufferType::L1);
+            for (const auto& [core, address] : buffer->per_core_addresses_) {
+                const uint32_t bank_id = logical_core_to_bank_ids_.at(BufferType::L1).at(core).at(0);
+                layout.emplace_back(
+                    static_cast<uint32_t>(buffer_type), bank_id + 1, address, address + allocation_size);
+            }
+        } else {
+            const DeviceAddr address = buffer->address();
+            layout.emplace_back(static_cast<uint32_t>(buffer_type), 0, address, address + allocation_size);
+        }
+    }
+
+    std::sort(layout.begin(), layout.end());
+    return layout;
+}
+
 std::unordered_set<Buffer*> AllocatorImpl::get_allocated_buffers() const {
     std::lock_guard<std::mutex> lock(mutex_);
     return allocated_buffers_;
@@ -616,6 +646,10 @@ Allocator::Allocator(AllocatorImpl* _impl) : impl(_impl) {}

