+BankManager::AllocationFootprint BankManager::get_live_allocation_overlaps(
+    const AllocationFootprint& footprint) const {
+    AllocationFootprint live_allocations;
+    auto collect_overlaps = [&](uint32_t allocator_id, const AllocationRegion& region) {
+        const auto* alloc = this->get_allocator_from_id(AllocatorDependencies::AllocatorID{allocator_id});
+        TT_FATAL(alloc, "Allocator not initialized for ID {}", allocator_id);
+        for (DeviceAddr address : allocated_buffers_[allocator_id]) {
+            const auto size = alloc->get_allocation_size(address);
+            TT_FATAL(size.has_value(), "Missing allocation size for address {}", address);
+            if (region.begin < address + *size && address < region.end) {
+                live_allocations.push_back({allocator_id, address, address + *size});
+            }
+        }
+    };
+
+    for (const AllocationRegion& region : footprint) {
+        collect_overlaps(region.allocator_id, region);
+        for (const auto dependent_id : allocator_dependencies_.dependencies[region.allocator_id]) {
+            collect_overlaps(dependent_id.get(), region);
+        }
+    }
+    std::sort(
+        live_allocations.begin(),
+        live_allocations.end(),
+        [](const AllocationRegion& lhs, const AllocationRegion& rhs) {
+            return std::tie(lhs.allocator_id, lhs.begin, lhs.end) <
+                   std::tie(rhs.allocator_id, rhs.begin, rhs.end);
+        });
+    live_allocations.erase(
+        std::unique(live_allocations.begin(), live_allocations.end()), live_allocations.end());
+    return live_allocations;
+}
+
+BankManager::AllocationFootprint BankManager::reserve_trace_footprint(
+    const AllocationFootprint& footprint) {
+    AllocationFootprint reservations;
+    for (const AllocationRegion& region : footprint) {
+        const AllocationFootprint live_allocations =
+            get_live_allocation_overlaps(AllocationFootprint{region});
+        std::vector<std::pair<DeviceAddr, DeviceAddr>> occupied;
+        occupied.reserve(live_allocations.size());
+        for (const AllocationRegion& live : live_allocations) {
+            const DeviceAddr begin = std::max(region.begin, live.begin);
+            const DeviceAddr end = std::min(region.end, live.end);
+            if (begin < end) {
+                occupied.emplace_back(begin, end);
+            }
+        }
+        std::sort(occupied.begin(), occupied.end());
+
+        DeviceAddr cursor = region.begin;
+        const auto reserve = [&](DeviceAddr begin, DeviceAddr end) {
+            if (begin >= end) {
+                return;
+            }
+            const auto allocator_id = AllocatorDependencies::AllocatorID{region.allocator_id};
+            mark_allocated(allocator_id, begin, end - begin);
+            reservations.push_back({region.allocator_id, begin, end});
+        };
+        for (const auto& [begin, end] : occupied) {
+            if (begin > cursor) {
+                reserve(cursor, begin);
+            }
+            cursor = std::max(cursor, end);
+            if (cursor >= region.end) {
+                break;
+            }
+        }
+        reserve(cursor, region.end);
+    }
+    return reservations;
+}
+
+void BankManager::release_trace_reservations(const AllocationFootprint& reservations) {
+    for (auto it = reservations.rbegin(); it != reservations.rend(); ++it) {
+        mark_deallocated(AllocatorDependencies::AllocatorID{it->allocator_id}, it->begin);
+    }
+}
+
+bool BankManager::is_trace_replay_safe(
+    const AllocationFootprint& footprint, const AllocationFootprint& expected_live_allocations) const {
+    const AllocationFootprint live_allocations = get_live_allocation_overlaps(footprint);
+    if (live_allocations == expected_live_allocations) {
+        return true;
+    }
+    log_debug(
+        tt::LogAlways,
+        "Trace replay allocation state changed: expected {} live overlap(s), found {}",
+        expected_live_allocations.size(),
+        live_allocations.size());
+    for (const AllocationRegion& region : expected_live_allocations) {
+        log_debug(
+            tt::LogAlways,
+            "  expected allocator {} [0x{:x}, 0x{:x})",
+            region.allocator_id,
+            region.begin,
+            region.end);
+    }
+    for (const AllocationRegion& region : live_allocations) {
+        log_debug(
+            tt::LogAlways,
+            "  current allocator {} [0x{:x}, 0x{:x})",
+            region.allocator_id,
+            region.begin,
+            region.end);
+    }
+    return false;
+}
+
+void BankManager::record_allocation_region(
+    AllocatorDependencies::AllocatorID allocator_id, DeviceAddr address, DeviceAddr size) {
+    if (!tracking_high_water_mark_) {
+        return;
+    }
+
+    // Addresses and sizes are per-bank. Bank offsets are intentionally omitted:
+    // overlap is checked in the same allocator's interleaved address space.
+    allocation_footprint_.push_back({allocator_id.get(), address, address + size});
+}
