+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include "ttnn/tensor/tensor.hpp"
+
+namespace ttnn::transformer {
+
+// One recurrent gated-delta decode step. Query and key are normalized. The
+// scalar gates are fused into the device kernel:
+// beta = sigmoid(beta_logits)
+// decay = exp(-exp(a_log) * softplus(delta_time + dt_bias))
+// state_mid = decay * state
+// state' = state_mid + k^T * (beta * (v - k * state_mid))
+// output = q * state'
+Tensor gated_delta_decode(
+    const Tensor& query,
+    const Tensor& key,
+    const Tensor& value,
+    const Tensor& beta_logits,
+    const Tensor& delta_time,
+    const Tensor& a_log,
+    const Tensor& dt_bias,
+    const Tensor& state,
+    const Tensor& output,
+    const Tensor& state_indices,
+    const Tensor& has_initial_state);
+
+}  // namespace ttnn::transformer
