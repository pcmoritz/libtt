@@ -9,7 +9,9 @@
 
 #include "ttnn/tensor/tensor.hpp"
 
+#include <array>
 #include <cstdint>
+#include <string>
 
 namespace ttnn::prim {
 
@@ -30,4 +32,24 @@ inline uint32_t calculate_optimal_chunk_size(const ttnn::Tensor& input_tensor) {
     return ceil32((l1_per_chunk * 9 / 10) - 32);
 }
 
+inline std::array<uint32_t, ttnn::MAX_NUM_DIMENSIONS - 1> scatter_outer_dims(const ttnn::Shape& shape) {
+    std::array<uint32_t, ttnn::MAX_NUM_DIMENSIONS - 1> dims{};
+    dims.fill(1);
+    for (uint32_t i = 0; i + 1 < shape.rank(); ++i) {
+        dims[i] = shape[i];
+    }
+    return dims;
+}
+
+template <typename CompileTimeArgs>
+inline void add_scatter_shape_compile_time_args(
+    CompileTimeArgs& compile_time_args, const ttnn::Shape& input_shape, const ttnn::Shape& index_shape) {
+    const auto input_dims = scatter_outer_dims(input_shape);
+    const auto index_dims = scatter_outer_dims(index_shape);
+    for (uint32_t i = 0; i < input_dims.size(); ++i) {
+        compile_time_args["input_dim_" + std::to_string(i)] = input_dims[i];
+        compile_time_args["index_dim_" + std::to_string(i)] = index_dims[i];
+    }
+}
+
 }  // namespace ttnn::prim
