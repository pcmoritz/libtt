+        dfb_out_obj.reserve_back(static_cast<uint16_t>(rem));
+        tile_regs_wait();
+        for (std::uint32_t wt8 = 0; wt8 < rem; wt8++) {
+            pack_tile(wt8, dfb_out);
+        }
+        tile_regs_release();
+        dfb_out_obj.push_back(static_cast<uint16_t>(rem));
+    }
