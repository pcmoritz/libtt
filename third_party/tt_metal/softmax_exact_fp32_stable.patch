+    // DEST tile for the mask.
+    auto load_x = [&](std::uint32_t wt, std::uint32_t rem, std::uint32_t spare) {
+        copy_init(dfb_in);
+        for (std::uint32_t wt8 = 0; wt8 < rem; wt8++) {
+            copy_tile(dfb_in, wt + wt8, wt8);
+        }
+        if constexpr (masked) {
+            if (wt + rem == Wt) {
+                // The broadcast reads through source register B, which otherwise holds the max's
+                // format.
+                reconfig_data_format_srcb(dfb_max, dfb_mask);
+                unary_bcast_init<BroadcastType::ROW>(dfb_mask);
+                unary_bcast<BroadcastType::ROW>(dfb_mask, 0, spare);
+                reconfig_data_format_srcb(dfb_mask, dfb_max);
+                add_binary_tile_init();
+                add_binary_tile(rem - 1, spare, rem - 1);
+            }
+        }
+    };
+    // DEST tiles per block: the x tiles, the broadcast max and the mask.
+    const std::uint32_t blk = ndst > 2 ? ndst - 2 : 1;
+
+    if constexpr (masked) {
+        DataflowBuffer(dfb_mask).wait_front(1);  // pushed once by the reader, never popped
+    }
+    dfb_in_obj.wait_front(static_cast<uint16_t>(Wt));
+    reconfig_data_format(dfb_in, dfb_max);
+    pack_reconfig_data_format(dfb_x);
+    for (std::uint32_t wt = 0; wt < Wt; wt += blk) {
+        const std::uint32_t rem = (wt + blk > Wt) ? (Wt - wt) : blk;  // clamped final block
+        tile_regs_acquire();
+        load_x(wt, rem, rem);
+        tile_regs_commit();
+        dfb_x_obj.reserve_back(static_cast<uint16_t>(rem));
+        tile_regs_wait();
+        for (std::uint32_t wt8 = 0; wt8 < rem; wt8++) {
+            pack_tile(wt8, dfb_x);
+        }
+        tile_regs_release();
+        dfb_x_obj.push_back(static_cast<uint16_t>(rem));
