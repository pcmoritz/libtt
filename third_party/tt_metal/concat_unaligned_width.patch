+++ ttnn/cpp/ttnn/operations/data_movement/concat/device/kernels/dataflow/writer_concat_stick_chunks.cpp
@@ -0,0 +1,36 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Writes row-major width-concat output sticks that the reader builds in chunks of chunk_size bytes,
+// one DFB entry each; the last chunk of a stick holds the rest. A stick that fits in L1 is one chunk.
+// Takes the arguments and bindings of writer_unary_stick_layout_interleaved_start_id_metal2.cpp.
+
+#include <stdint.h>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "api/tensor/noc_traits.h"
+#include "experimental/kernel_args.h"
+
+void kernel_main() {
+    const uint32_t stick_size = get_arg(args::stick_size);
+    const uint32_t num_sticks = get_arg(args::num_sticks);
+    const uint32_t start_id = get_arg(args::start_id);
+    constexpr uint32_t chunk_size = get_arg(args::chunk_size);
+
+    const auto s0 = TensorAccessor(tensor::dst);
+
+    Noc noc;
+    DataflowBuffer dfb_out0(dfb::out0);
+
+    for (uint32_t i = start_id; i < start_id + num_sticks; ++i) {
+        for (uint32_t offset = 0; offset < stick_size; offset += chunk_size) {
+            const uint32_t size = stick_size - offset < chunk_size ? stick_size - offset : chunk_size;
+            dfb_out0.wait_front(1);
+            noc.async_write(dfb_out0, s0, size, {.offset_bytes = 0}, {.page_id = i, .offset_bytes = offset});
+            noc.async_write_barrier();
+            dfb_out0.pop_front(1);
+        }
+    }
+}
