+            const uint32_t element_bytes = page_bytes / (out_tile_h * 32);
+            const uint32_t rows_bytes = rows_tile_h * 16 * element_bytes;
+            const uint32_t full_face_bytes = 256 * element_bytes;
+            const uint32_t local = get_read_ptr(cb_out);
+            const uint32_t local_face = out_tile_h < 32 ? rows_bytes : full_face_bytes;
+            noc_async_write(local, output.get_noc_addr(n_start + n), rows_bytes);
+            noc_async_write(local + local_face, output.get_noc_addr(n_start + n, full_face_bytes), rows_bytes);
+        } else {
+            noc.async_write(out_cb, output, page_bytes, {}, {.page_id = n_start + n});
+        }
         noc.async_writes_flushed();
         out_cb.pop_front(1);
     }
