@@ -106,9 +106,24 @@
 
     CircularBuffer out_cb(cb_out);
     const uint32_t page_bytes = get_local_cb_interface(cb_out).fifo_page_size;
+    // Of an activation of rows_tile_h < 32 rows only the top rows_tile_h rows of faces 0 and 1 of each output
+    // tile are written; the output tile in L1 has out_tile_h rows (rows_tile_h, or 32 for a split over K), the
+    // output's tiles in DRAM faces of 256 elements.
+    constexpr uint32_t rows_tile_h = get_named_compile_time_arg_val("rows_tile_h");
+    constexpr uint32_t out_tile_h = get_named_compile_time_arg_val("out_tile_h");
