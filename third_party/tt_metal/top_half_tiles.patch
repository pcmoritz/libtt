diff --git ttnn/cpp/ttnn/operations/top_half_tile.hpp ttnn/cpp/ttnn/operations/top_half_tile.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/top_half_tile.hpp
@@ -0,0 +1,29 @@
+// SPDX-FileCopyrightText: © 2026 libtt authors
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <optional>
+
+#include <tt-metalium/tensor/spec/tensor_spec.hpp>
+#include <tt-metalium/tensor/tensor_types.hpp>
+#include <tt-metalium/tile.hpp>
+
+namespace ttnn::operations {
+
+// libtt: a tensor of at most 16 rows has its values in the top halves (faces 0 and 1) of its 32x32 tiles, and
+// a top half is a 16x32 tile. On vocabulary-sized rows, like a sampler's, ops move and compute only the top
+// halves: their buffers take the 16x32 tile returned here, and their kernels read and write one buffer entry
+// at the start of each page. That halves the traffic. The bottom halves of an output keep stale values; they
+// are padding, which reductions fill before reading it. The tile has to be part of a program's cache key.
+inline std::optional<tt::tt_metal::Tile> top_half_tile(const tt::tt_metal::TensorSpec& spec) {
+    const tt::tt_metal::Shape& shape = spec.logical_shape();
+    if (spec.layout() != tt::tt_metal::Layout::TILE || shape.rank() == 0 || !(spec.tile() == tt::tt_metal::Tile()) ||
+        (shape.rank() >= 2 && shape[-2] > 16) || shape[-1] < 32768 || spec.memory_config().is_sharded() ||
+        tt::tt_metal::is_block_float(spec.data_type())) {
+        return std::nullopt;
+    }
+    return tt::tt_metal::Tile({16, 32});
+}
+
+}  // namespace ttnn::operations
