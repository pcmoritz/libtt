diff --git ttnn/cpp/ttnn/operations/data_movement/tilize/device/tilize_float16_to_float32.hpp ttnn/cpp/ttnn/operations/data_movement/tilize/device/tilize_float16_to_float32.hpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/data_movement/tilize/device/tilize_float16_to_float32.hpp
@@ -0,0 +1,44 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <tt-metalium/experimental/metal2_host_api/kernel_spec.hpp>
+#include <tt-metalium/program_descriptors.hpp>
+
+#include "ttnn/tensor/types.hpp"
+
+namespace ttnn::prim {
+
+// Unpacking Float16 flushes subnormals and -0 to +0. A Float16 -> Float32 tilize therefore declares its
+// input as UInt16, so the raw bits reach 32-bit Dest unchanged, and the compute kernel
+// (TILIZE_FLOAT16_TO_FLOAT32 in tilize_helpers.inl) widens them exactly with the SFPU before packing.
+inline bool is_float16_to_float32_tilize(tt::tt_metal::DataType input_dtype, tt::tt_metal::DataType output_dtype) {
+    return input_dtype == tt::tt_metal::DataType::FLOAT16 && output_dtype == tt::tt_metal::DataType::FLOAT32;
+}
+
+inline tt::DataFormat tilize_input_data_format(
+    tt::tt_metal::DataType input_dtype, tt::tt_metal::DataType output_dtype) {
+    return is_float16_to_float32_tilize(input_dtype, output_dtype)
+               ? tt::DataFormat::UInt16
+               : tt::tt_metal::datatype_to_dataformat_converter(input_dtype);
+}
+
+inline tt::tt_metal::KernelDescriptor::Defines tilize_compute_defines(bool float16_to_float32) {
+    if (!float16_to_float32) {
+        return {};
+    }
+    return {{"TILIZE_FLOAT16_TO_FLOAT32", "1"}};
+}
+
+inline tt::tt_metal::experimental::KernelSpec::CompilerOptions tilize_compiler_options(bool float16_to_float32) {
+    tt::tt_metal::experimental::KernelSpec::CompilerOptions options{
+        .opt_level = tt::tt_metal::KernelBuildOptLevel::O3};
+    for (const auto& [name, value] : tilize_compute_defines(float16_to_float32)) {
+        options.defines[name] = value;
+    }
+    return options;
+}
+
+}  // namespace ttnn::prim
