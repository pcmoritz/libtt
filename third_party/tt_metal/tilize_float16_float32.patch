+#ifdef TILIZE_FLOAT16_TO_FLOAT32
+// Unpacking Float16 flushes subnormals and -0 to +0. The factory instead declares the Float16 input as
+// UInt16, so its raw bits reach the low half of each 32-bit Dest word, and the SFPU widens them exactly
+// to Float32 before the tile is released to the packer.
+template <bool is_fp32_dest_acc_en = DST_ACCUM_MODE>
+ALWI void tilize_block_float16_to_float32(uint32_t icb, uint32_t block, uint32_t ocb) {
+    UNPACK((llk_unpack_tilize_block(icb, block, 0)));
+
+    for (uint32_t t = 0; t < block; t++) {
+        MATH((llk_math_wait_for_dest_available()));
+        PACK((llk_packer_wait_for_math_done()));
+
+        MATH((llk_math_eltwise_unary_datacopy<DataCopyType::A2D, is_fp32_dest_acc_en, BroadcastType::NONE, UnpackToDestEn>(
+            0 /*dst index*/, icb)));
+        typecast_tile<static_cast<uint32_t>(DataFormat::Float16), static_cast<uint32_t>(DataFormat::Float32)>(0);
+        PACK((llk_pack<is_fp32_dest_acc_en, true, PackMode::Default>(0 /*tile index*/, ocb, t)));
+
+        MATH((llk_math_dest_section_done<is_fp32_dest_acc_en>()));
+        PACK((llk_pack_dest_section_done<is_fp32_dest_acc_en>()));
+    }
+}
+#endif
+
