+
+#pragma once
+
+#include "api/compute/common_globals.h"
+#ifdef TRISC_MATH
+#ifdef ARCH_BLACKHOLE
+#include "ckernel_sfpu_logaddexp.h"
+#endif
+#include "llk_math_eltwise_binary_sfpu_macros.h"
+#endif
+
+namespace ckernel {
+
+#ifdef ARCH_BLACKHOLE
+// log(exp(a) + exp(b)) of two Float32 tiles in Dest, without overflow; see calculate_logaddexp.
+ALWI void logaddexp_tile(uint32_t idst0, uint32_t idst1, uint32_t odst) {
+    MATH((SFPU_BINARY_CALL(
+        DST_SYNC_MODE, DST_ACCUM_MODE, calculate_logaddexp, (8 /* ITERATIONS */), idst0, idst1, odst, VectorMode::RC)));
+}
+
+ALWI void logaddexp_tile_init() { MATH((SFPU_BINARY_INIT(unused))); }
+#endif  // ARCH_BLACKHOLE
+
+}  // namespace ckernel
