@@ -0,0 +1,47 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <limits>
+
+#include "ckernel.h"
+#include "ckernel_defs.h"
+#include "ckernel_sfpu_exp.h"
+#include "ckernel_sfpu_log1p.h"
+
+namespace ckernel {
+namespace sfpu {
+
+// log(exp(a) + exp(b)) like jax.numpy.logaddexp: max(a, b) + log1p(exp(-|a - b|)), which neither
+// overflows nor loses the smaller operand. When a - b is NaN (a NaN operand, or two infinities of
+// the same sign) the result is a + b. Computes in Float32.
+template <int ITERATIONS = 8>
+inline void calculate_logaddexp(const uint dst_index_in0, const uint dst_index_in1, const uint dst_index_out) {
+    constexpr uint dst_tile_size_sfpi = 32;
+    // The constants calculate_log1p_fp32 expects (see log1p_init), set here because other
+    // initializations between tiles may reuse them.
+    sfpi::vConstFloatPrgm0 = 0.693147182f * 1.19209290e-7f;
+    sfpi::vConstFloatPrgm1 = -0x1.00001ap-2f;
+    sfpi::vConstFloatPrgm2 = 0x1.555572p-2f;
+
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vFloat a = sfpi::dst_reg[dst_index_in0 * dst_tile_size_sfpi];
+        sfpi::vFloat b = sfpi::dst_reg[dst_index_in1 * dst_tile_size_sfpi];
+        sfpi::vFloat diff = a - b;
+        sfpi::vFloat larger = b;
+        v_if(diff > 0.0f) { larger = a; }
+        v_endif;
+        sfpi::vFloat result = larger + calculate_log1p_fp32<true>(_sfpu_exp_fp32_accurate_(-sfpi::abs(diff)));
+        // diff is NaN exactly when its magnitude bits exceed those of infinity.
+        sfpi::vFloat infinity = std::numeric_limits<float>::infinity();
+        v_if(sfpi::as<sfpi::vInt>(sfpi::abs(diff)) > sfpi::as<sfpi::vInt>(infinity)) { result = a + b; }
+        v_endif;
+        sfpi::dst_reg[dst_index_out * dst_tile_size_sfpi] = result;
+        sfpi::dst_reg++;
+    }
+}
+
+}  // namespace sfpu
+}  // namespace ckernel
