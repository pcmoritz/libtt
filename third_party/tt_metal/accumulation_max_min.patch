+            defines_kernel_args["BINARY_OP_INIT"] = fmt::format("binary_{}{}_tile_init", reduction, suffix);
+            defines_kernel_args["BINARY_OP"] = fmt::format("binary_{}{}_tile", reduction, suffix);
+            defines_kernel_args["FILL_TILE"] = fmt::format("fill_tile_int<{}>", acc_dataformat_name);
+            const uint32_t lowest = is_unsigned ? 0U : 0x80000000U;
