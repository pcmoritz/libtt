+#ifdef ARCH_BLACKHOLE
+// Float max and min that propagate NaN from either operand, of either sign
+// (binary_max_tile and binary_min_tile skip -NaN and +NaN respectively). They
+// share binary_max_tile_init and binary_min_tile_init.
+ALWI void binary_max_nan_tile(uint32_t idst0, uint32_t idst1, uint32_t odst) {
+    MATH((SFPU_BINARY_CALL(
+        DST_SYNC_MODE,
+        DST_ACCUM_MODE,
+        calculate_binary_max_min_nan,
+        (true /* IS_MAX */),
+        idst0,
+        idst1,
+        odst,
+        VectorMode::RC)));
+}
+
+ALWI void binary_min_nan_tile(uint32_t idst0, uint32_t idst1, uint32_t odst) {
+    MATH((SFPU_BINARY_CALL(
+        DST_SYNC_MODE,
+        DST_ACCUM_MODE,
+        calculate_binary_max_min_nan,
+        (false /* IS_MAX */),
+        idst0,
+        idst1,
+        odst,
+        VectorMode::RC)));
+}
+#endif  // ARCH_BLACKHOLE
+
 }  // namespace ckernel
