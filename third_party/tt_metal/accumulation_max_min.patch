+// Gives the value in LREG `X` the sign `NAN_SIGN` if it is NaN. Expects +inf in
+// LREG3 and uses LREG2.
+template <uint X, uint NAN_SIGN>
+inline void set_nan_sign() {
+    // if |x| > inf, i.e. x is NaN: inf - |x| < 0
+    TTI_SFPSETSGN(0, X, p_sfpu::LREG2, 1);  // SFPSETSGN_MOD1_ARG_IMM
+    TTI_SFPIADD(0, p_sfpu::LREG3, p_sfpu::LREG2, sfpi::SFPIADD_MOD1_ARG_2SCOMP_LREG_DST | sfpi::SFPIADD_MOD1_CC_LT0);
+    TTI_SFPSETSGN(NAN_SIGN, X, X, 1);  // SFPSETSGN_MOD1_ARG_IMM
+    TTI_SFPENCC(0, 0, 0, 0);
+}
+
+// Float max or min that propagates NaN from either operand, as IEEE maximum and
+// minimum and JAX do. SFPSWAP orders sign-magnitude bit patterns, so +NaN is the
+// largest value and -NaN the smallest: a NaN operand is given the sign that wins
+// (+ for max, - for min) and is then selected like any other value.
+template <bool IS_MAX_OP = true, int ITERATIONS = 8>
+inline void calculate_binary_max_min_nan(const uint dst_index_in0, const uint dst_index_in1, const uint dst_index_out) {
+    constexpr uint a = p_sfpu::LREG0;
+    constexpr uint b = p_sfpu::LREG1;
+    constexpr uint nan_sign = IS_MAX_OP ? 0 : 1;
+    constexpr uint dst_tile_size = 64;
+
+    TTI_SFPLOADI(p_sfpu::LREG3, sfpi::SFPLOADI_MOD0_FLOATB, 0x7f80);  // +inf
+
+#pragma GCC unroll 0
+    for (int d = 0; d < ITERATIONS; d++) {
+        TT_SFPLOAD(a, InstrModLoadStore::DEFAULT, ADDR_MOD_7, dst_index_in0 * dst_tile_size);
+        TT_SFPLOAD(b, InstrModLoadStore::DEFAULT, ADDR_MOD_7, dst_index_in1 * dst_tile_size);
+        set_nan_sign<a, nan_sign>();
+        set_nan_sign<b, nan_sign>();
+        // Maximum in b, minimum in a.
+        TTI_SFPSWAP(0, b, a, sfpi::SFPSWAP_MOD1_VEC_MIN_MAX);
+        TT_SFPSTORE(IS_MAX_OP ? b : a, InstrModLoadStore::DEFAULT, ADDR_MOD_6, dst_index_out * dst_tile_size);
+    }
+}
+
