+            vchannel = static_cast<uint32_t>(core_idx % ring_size) & 0x3;
+            for (uint32_t tries = 1; tries < 4; ++tries) {
+                const uint32_t candidate = (static_cast<uint32_t>(core_idx % ring_size) + tries) & 0x3;
