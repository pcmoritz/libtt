+std::vector<uint32_t> ring_core_vchannels(const std::vector<tt::tt_metal::CoreCoord>& ring_cores, uint32_t ring_size) {
+    std::vector<uint32_t> vchannels;
+    vchannels.reserve(ring_cores.size());
