+#endif
+#ifndef MOE_ZONES_CHUNKS
+#define MOE_ZONES_CHUNKS 16
+#endif
+namespace moe_ring::zones {
+constexpr bool in_window(uint32_t chunk) {
+    return chunk >= MOE_ZONES_FIRST_CHUNK && chunk < MOE_ZONES_FIRST_CHUNK + MOE_ZONES_CHUNKS;
