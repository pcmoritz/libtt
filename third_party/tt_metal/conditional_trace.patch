 template <bool hugepage_write>
+void DeviceCommand<hugepage_write>::add_prefetch_exec_buf_predicate(
+    uint32_t base_addr, uint8_t log2_page_size, uint32_t value) {
+    uint32_t increment_sizeB = tt::align(sizeof(CQPrefetchCmd), this->pcie_alignment);
+    auto initialize_predicate_cmd = [&](CQPrefetchCmd* predicate_cmd) {
+        *predicate_cmd = {};
+        predicate_cmd->base.cmd_id = CQ_PREFETCH_CMD_EXEC_BUF_PREDICATE;
+        predicate_cmd->exec_buf_predicate.log2_page_size = log2_page_size;
+        predicate_cmd->exec_buf_predicate.base_addr = base_addr;
+        predicate_cmd->exec_buf_predicate.value = value;
+    };
+    CQPrefetchCmd* predicate_cmd_dst = this->reserve_space<CQPrefetchCmd*>(increment_sizeB);
+
+    if constexpr (hugepage_write) {
+        alignas(MEMCPY_ALIGNMENT) CQPrefetchCmd predicate_cmd{};
+        initialize_predicate_cmd(&predicate_cmd);
+        this->memcpy(predicate_cmd_dst, &predicate_cmd, sizeof(CQPrefetchCmd));
+    } else {
+        initialize_predicate_cmd(predicate_cmd_dst);
+    }
+}
