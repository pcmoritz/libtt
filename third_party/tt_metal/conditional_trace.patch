+void FDMeshCommandQueue::enqueue_trace_if(const MeshTraceId& trace_id, const MeshBuffer& predicate, uint32_t value) {
+    auto lock = lock_api_function_();
+    TT_FATAL(!trace_id_.has_value(), "A conditional trace cannot be replayed during trace capture.");
+    auto trace_inst = mesh_device_->get_mesh_trace(trace_id);
+    TT_FATAL(trace_inst->desc->conditional, "Trace {} was not captured as a conditional trace", *trace_id);
+    TT_FATAL(
+        predicate.device_local_config().buffer_type == BufferType::DRAM &&
+            predicate.device_local_config().sharding_args.buffer_layout() == TensorMemoryLayout::INTERLEAVED,
+        "A trace predicate must be an interleaved DRAM buffer");
+    const uint32_t page_size = predicate.page_size();
+    TT_FATAL(page_size != 0 && (page_size & (page_size - 1)) == 0, "A trace predicate needs a power-of-two page size");
+    in_use_ = true;
+    submit_replay_buffer(
+        trace_inst->desc->descriptors,
+        trace_inst->desc->sub_device_ids,
+        *trace_inst->mesh_buffer,
+        /*ends_with_reset=*/true,
+        trace_dispatch::TracePredicate{
+            .address = static_cast<uint32_t>(predicate.address()),
+            .log2_page_size = static_cast<uint8_t>(__builtin_ctz(page_size)),
+            .value = value});
+}
+
+void FDMeshCommandQueue::set_dry_launches(bool dry) {
+    auto lock = lock_api_function_();
+    dry_launches_ = dry;
+}
