+// Decides an exec_buf jump. The stream moves once the command is done.
+static uint32_t process_exec_buf_jump_cmd(uintptr_t cmd_ptr) {
+    volatile CQPrefetchCmd tt_l1_ptr* cmd = reinterpret_cast<volatile CQPrefetchCmd tt_l1_ptr*>(cmd_ptr);
