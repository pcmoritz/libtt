+    if (condition != CQ_PREFETCH_EXEC_BUF_JUMP_ALWAYS) {
+        uint32_t base_addr = load_aligned<uint32_t>(&cmd->exec_buf_jump.base_addr);
+        uint32_t page_size = 1u << cmd->exec_buf_jump.log2_page_size;
+        // Read page 0 of the predicate the way the exec_buf reads its own pages: a stateful read on
+        // the prefetcher's read command buffer, tagged and retired by transaction id 1.
+        auto addr_gen = TensorAccessor(tensor_accessor::make_interleaved_dspec</*is_dram=*/true>(), base_addr, page_size);
+        uint64_t noc_addr = addr_gen.get_noc_addr(0);
+        // Stamp the landing zone and wait for the data to overwrite it: the transaction-id
+        // barrier alone was seen to pass before this single read had landed.
+        constexpr uint32_t kUnread = 0xA5A5A5A5;
