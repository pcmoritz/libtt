+            noc_index, noc_addr, exec_buf_jump_scratch, 64);
+        noc_async_read_barrier_with_trid(1);
+        noc_async_read_set_trid(0);
+        invalidate_l1_cache();
+        while (landing[0] == kUnread && landing[1] == kUnread) {
+            invalidate_l1_cache();
+        }
+        uint32_t value = landing[0];
+        if (flags & CQ_PREFETCH_EXEC_BUF_JUMP_FLAG_16BIT) {
