+void FDMeshCommandQueue::push_trace_branch_marker(MeshTraceNode&& marker) {
+    auto lock = lock_api_function_();
+    TT_FATAL(
+        this->reference_sysmem_manager().get_bypass_mode(),
+        "Trace branches can only be recorded while a trace is being captured");
+    trace_nodes_.push_back(std::move(marker));
+}
+
+void FDMeshCommandQueue::trace_branch_begin(const MeshBuffer& predicate, bool predicate_is_16bit) {
+    TT_FATAL(trace_branch_state_ == TraceBranchState::None, "Trace branches do not nest");
+    TT_FATAL(
+        predicate.device_local_config().buffer_type == BufferType::DRAM,
+        "A trace branch predicate must live in an interleaved DRAM buffer");
+    const uint32_t page_size = predicate.page_size();
+    TT_FATAL(
+        page_size != 0 && (page_size & (page_size - 1)) == 0,
+        "A trace branch predicate buffer needs a power-of-two page size, got {}",
+        page_size);
+    MeshTraceNode marker;
+    marker.branch = MeshTraceNode::Branch::Begin;
+    marker.predicate_base_addr = static_cast<uint32_t>(predicate.address());
+    marker.predicate_log2_page_size = static_cast<uint8_t>(std::bit_width(page_size) - 1);
+    marker.predicate_flags = predicate_is_16bit ? CQ_PREFETCH_EXEC_BUF_JUMP_FLAG_16BIT : 0;
+    this->push_trace_branch_marker(std::move(marker));
+    trace_branch_state_ = TraceBranchState::InThen;
+}
+
+void FDMeshCommandQueue::trace_branch_else() {
+    TT_FATAL(trace_branch_state_ == TraceBranchState::InThen, "trace_branch_else needs an open trace_branch_begin");
+    MeshTraceNode marker;
+    marker.branch = MeshTraceNode::Branch::Else;
+    this->push_trace_branch_marker(std::move(marker));
+    trace_branch_state_ = TraceBranchState::InElse;
+}
+
+void FDMeshCommandQueue::trace_branch_end() {
+    TT_FATAL(trace_branch_state_ == TraceBranchState::InElse, "trace_branch_end needs an open trace_branch_else");
+    MeshTraceNode marker;
+    marker.branch = MeshTraceNode::Branch::End;
+    this->push_trace_branch_marker(std::move(marker));
+    trace_branch_state_ = TraceBranchState::None;
+}
