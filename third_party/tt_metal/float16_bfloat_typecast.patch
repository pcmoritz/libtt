+// Raw BFloat16 bits in a UInt16 tile -> raw Float16 bits, rounded to nearest even.
+template <bool APPROXIMATION_MODE, int ITERATIONS>
+inline void cast_fp16b_to_fp16a() {
+    for (int d = 0; d < ITERATIONS; d++) {
+        // UInt16 tiles unpack into the low half of each 32-bit Dest word.
+        sfpi::vUInt bits(sfpi::dst_reg[0].mode<sfpi::DataLayout::U32>());
+        bits &= 0xffffU;
+        sfpi::vUInt halfBits = float32_to_float16_bits_rne(sfpi::as<sfpi::vFloat>(bits << 16));
+        __builtin_rvtt_sfpstore(halfBits.get(), 0, 9 /* swap high/low 16 */, ADDR_MOD_6);
+    }
+}
+
+// Raw Float16 bits in a UInt16 tile -> raw BFloat16 bits, rounded to nearest even.
+template <bool APPROXIMATION_MODE, int ITERATIONS>
+inline void cast_fp16a_to_fp16b() {
+    for (int d = 0; d < ITERATIONS; d++) {
+        sfpi::vUInt bits(sfpi::dst_reg[0].mode<sfpi::DataLayout::U32>());
+        bits &= 0xffffU;
+        sfpi::vUInt fp32Bits = float16_to_float32_bits(bits);
+        // Float16 values need at most 11 significant bits, which BFloat16 (8) may round.
+        fp32Bits += 0x7fffU + ((fp32Bits >> 16) & 1U);
+        sfpi::vUInt bfloatBits = fp32Bits >> 16;
+        __builtin_rvtt_sfpstore(bfloatBits.get(), 0, 9 /* swap high/low 16 */, ADDR_MOD_6);
+    }
+}
+
 }  // namespace sfpu
 }  // namespace ckernel
