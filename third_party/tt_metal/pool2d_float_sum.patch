@@ -0,0 +1,80 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "api/dataflow/dataflow_api.h"
+#include "ttnn/cpp/ttnn/operations/pool/device/kernels/pool_kernels_common.hpp"
+
+void kernel_main() {
+    constexpr uint32_t kh = get_compile_time_arg_val(0), kw = get_compile_time_arg_val(1);
+    constexpr uint32_t stride = get_compile_time_arg_val(2);
+    constexpr uint32_t dh = get_compile_time_arg_val(3), dw = get_compile_time_arg_val(4);
+    constexpr uint32_t padded_w = get_compile_time_arg_val(5);
+    constexpr uint32_t in_c = get_compile_time_arg_val(6), out_c = get_compile_time_arg_val(7);
+    constexpr uint32_t bytes = get_compile_time_arg_val(8);
+    // SFPU addition is elementwise: fill all four faces even with only 16 channels.
+    constexpr uint32_t tile_channels = out_c <= 16 ? 16 : 32;
+    constexpr uint32_t tile_rows = 1024 / tile_channels;
+    constexpr bool indices_in_dram = get_compile_time_arg_val(9);
+    constexpr uint32_t indices_addr = get_compile_time_arg_val(10), indices_page = get_compile_time_arg_val(11);
+    const uint32_t count = get_arg_val<uint32_t>(0), nhw_core = get_arg_val<uint32_t>(1);
+    DataflowBuffer staged(0), input(1), output(2), indices(3), result(16);
+    Noc noc;
+    if constexpr (indices_in_dram) {
+        load_config_tensor_if_in_dram<indices_addr, indices_page, 12, 3>(noc, indices, nhw_core);
+    }
+    auto config = reinterpret_cast<volatile tt_l1_ptr uint32_t *>(indices.get_read_ptr());
+    // Config word 0 is the segment count; each following word packs inclusive uint16 start/end indices.
+    uint32_t segment = 1, next = 0, end = 0;
+    bool new_segment = true;
+    uint32_t origins[tile_rows];
+    for (uint32_t base = 0; base < count; base += tile_rows) {
+        const uint32_t rows = std::min<uint32_t>(tile_rows, count - base);
+        for (uint32_t row = 0; row < rows; ++row) {
+            if (new_segment || next > end) {
+                const uint32_t packed = config[segment++];
+                next = packed & 0xffff;
+                end = packed >> 16;
+                new_segment = false;
+            }
+            origins[row] = next;
+            next += stride;
+        }
+        for (uint32_t channel = 0; channel < out_c; channel += tile_channels) {
+            for (uint32_t h = 0; h < kh; ++h) {
+                for (uint32_t w = 0; w < kw; ++w) {
+                    staged.reserve_back(1);
+                    if (rows < tile_rows || channel + tile_channels > in_c) {
+                        noc.async_write_zeros(staged, 1024 * bytes);
+                        noc.write_zeros_l1_barrier();
+                    }
+                    for (uint32_t row = 0; row < rows; ++row) {
+                        const uint32_t origin = origins[row] + h * dh * padded_w + w * dw;
+                        for (uint32_t half = 0; half < tile_channels / 16 && channel + half * 16 < in_c; ++half) {
+                            const uint32_t width = std::min<uint32_t>(16u, in_c - channel - half * 16);
+                            // Four 16x16 faces, with spatial outputs in rows and channels in columns.
+                            const uint32_t dst = ((row / 16) * tile_channels * 16 + half * 256 + (row % 16) * 16) * bytes;
+                            const uint32_t src = input.get_read_ptr() + (origin * in_c + channel + half * 16) * bytes;
+                            noc.async_read(UnicastEndpoint(), staged, width * bytes, experimental::local_addr(src),
+                                           {.offset_bytes = dst});
+                        }
+                    }
+                    noc.async_read_barrier();
+                    staged.push_back(1);
+                }
+            }
+            result.wait_front(1);
+            for (uint32_t row = 0; row < rows; ++row) {
+                for (uint32_t half = 0; half < tile_channels / 16 && channel + half * 16 < out_c; ++half) {
+                    const uint32_t width = std::min<uint32_t>(16u, out_c - channel - half * 16);
+                    const uint32_t src =
+                        result.get_read_ptr() + ((row / 16) * tile_channels * 16 + half * 256 + (row % 16) * 16) * bytes;
+                    const uint32_t dst = ((base + row) * out_c + channel + half * 16) * bytes;
+                    noc.async_read(UnicastEndpoint(), output, width * bytes, experimental::local_addr(src),
+                                   {.offset_bytes = dst});
+                }
+            }
+            noc.async_read_barrier();
+            result.pop_front(1);
+        }
+    }
+}
