+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "api/compute/tile_move_copy.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/typecast.h"
+#include "api/compute/eltwise_unary/eltwise_unary.h"
+#include "api/dataflow/dataflow_buffer.h"
+
+void kernel_main() {
+    constexpr uint32_t window = get_compile_time_arg_val(0), channels = get_compile_time_arg_val(1);
+    constexpr bool fp16 = get_compile_time_arg_val(2);
+    constexpr uint32_t tile_rows = channels <= 16 ? 64 : 32;
+    const uint32_t count = get_arg_val<uint32_t>(0);
+    DataflowBuffer input(0), output(16);
+    init_sfpu(0, 16);
+    for (uint32_t block = 0; block < (count + tile_rows - 1) / tile_rows * ((channels + 31) / 32); ++block) {
+        tile_regs_acquire();
+        for (uint32_t k = 0; k < window; ++k) {
+            input.wait_front(1);
+            const uint32_t dst = k == 0 ? 0 : 1;
+            copy_tile(0, 0, dst);
+            if constexpr (fp16) {
+                typecast_tile_init<(uint32_t)DataFormat::Float16, (uint32_t)DataFormat::Float32>();
+                typecast_tile<(uint32_t)DataFormat::Float16, (uint32_t)DataFormat::Float32>(dst);
+            }
+            if (k != 0) {
+                add_binary_tile_init();
+                add_binary_tile(0, 1, 0);
+            }
+            input.pop_front(1);
+        }
+        if constexpr (fp16) {
+            typecast_tile_init<(uint32_t)DataFormat::Float32, (uint32_t)DataFormat::Float16>();
+            typecast_tile<(uint32_t)DataFormat::Float32, (uint32_t)DataFormat::Float16>(0);
+        }
+        tile_regs_commit();
+        output.reserve_back(1);
+        tile_regs_wait();
+        pack_tile(0, 16);
+        tile_regs_release();
+        output.push_back(1);
+    }
+}
