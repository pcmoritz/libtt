+// Gather directly into tiles and add on the SFPU. No BF16/TF32 conversion or reciprocal is involved.
+static tt::tt_metal::ProgramDescriptor sum_pool_program(const Tensor &input, tt::tt_metal::Buffer *indices,
+                                                        Tensor &output, uint32_t kernel_h, uint32_t kernel_w,
+                                                        uint32_t stride_w, uint32_t dilation_h, uint32_t dilation_w,
+                                                        uint32_t padded_w, uint32_t total_outputs,
+                                                        bool indices_in_dram) {
+    using namespace tt::tt_metal;
+    const auto grid = input.shard_spec()->grid;
+    const auto in_shape = input.shard_spec()->shape;
+    const auto out_shape = output.shard_spec()->shape;
+    const bool fp16 = input.dtype() == DataType::FLOAT16;
+    // Load FP16 bits unchanged; convert in SFPU registers to avoid the FPU input precision limit.
+    const auto format = fp16 ? tt::DataFormat::UInt16 : tt::DataFormat::Float32;
+    const uint32_t bytes = fp16 ? 2 : 4;
+    const uint32_t tile_bytes = 1024 * bytes;
+    ProgramDescriptor desc;
+    auto cb = [&](uint8_t id, uint32_t page, uint32_t count, tt::DataFormat df, Buffer *buffer = nullptr) {
+        desc.cbs.push_back(CBDescriptor{
+            .total_size = page * count,
+            .core_ranges = grid,
+            .format_descriptors = {{CBFormatDescriptor{.buffer_index = id, .data_format = df, .page_size = page}}},
+            .buffer = buffer});
+    };
+    cb(0, tile_bytes, 2, format);
+    cb(16, tile_bytes, 2, format);
+    cb(1, in_shape[1] * bytes, in_shape[0], format, input.buffer());
+    cb(2, out_shape[1] * bytes, out_shape[0], format, output.buffer());
+    cb(3, indices->page_size(), 1, tt::DataFormat::UInt16, indices_in_dram ? nullptr : indices);
+    KernelDescriptor reader;
+    reader.kernel_source = "ttnn/cpp/ttnn/operations/pool/generic/device/kernels/dataflow/reader_sum_pool_2d.cpp";
+    reader.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    reader.core_ranges = grid;
+    reader.compile_time_args = {kernel_h,   kernel_w,        stride_w,           dilation_h,
+                                dilation_w, padded_w,        in_shape[1],        out_shape[1],
+                                bytes,      indices_in_dram, indices->address(), indices->page_size()};
+    TensorAccessorArgs(indices).append_to(reader.compile_time_args);
+    reader.config =
+        DataMovementConfigDescriptor{.processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default};
+    KernelDescriptor compute;
+    compute.kernel_source = "ttnn/cpp/ttnn/operations/pool/generic/device/kernels/compute/compute_sum_pool_2d.cpp";
+    compute.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    compute.core_ranges = grid;
+    compute.compile_time_args = {kernel_h * kernel_w, out_shape[1], fp16};
+    std::vector<UnpackToDestMode> unpack_modes(NUM_CIRCULAR_BUFFERS, UnpackToDestMode::Default);
+    if (!fp16) {
+        unpack_modes[0] = UnpackToDestMode::UnpackToDestFp32;
+    }
+    auto compute_config = ComputeConfigDescriptor{
+        .math_fidelity = MathFidelity::HiFi4, .fp32_dest_acc_en = true, .math_approx_mode = false};
+    compute_config.unpack_to_dest_mode = unpack_modes;
+    compute.config = std::move(compute_config);
+    const bool block = input.memory_config().memory_layout() == TensorMemoryLayout::BLOCK_SHARDED;
+    const bool width = input.memory_config().memory_layout() == TensorMemoryLayout::WIDTH_SHARDED;
+    const uint32_t cores_x = grid.bounding_box().grid_size().x;
+    for (uint32_t i = 0; i < grid.num_cores(); ++i) {
+        const CoreCoord core(i % cores_x, i / cores_x);
+        const uint32_t nhw_core = width ? 0 : block ? i / cores_x : i;
+        const uint32_t start = nhw_core * out_shape[0];
+        const uint32_t count = start < total_outputs ? std::min(out_shape[0], total_outputs - start) : 0;
+        reader.runtime_args.emplace_back(core, KernelDescriptor::CoreRuntimeArgs{count, nhw_core});
+        compute.runtime_args.emplace_back(core, KernelDescriptor::CoreRuntimeArgs{count});
+    }
+    desc.kernels = {std::move(reader), std::move(compute)};
+    return desc;
 }
 
