diff --git ttnn/cpp/ttnn/operations/matmul/device/config/matmul_program_config.cpp ttnn/cpp/ttnn/operations/matmul/device/config/matmul_program_config.cpp
--- ttnn/cpp/ttnn/operations/matmul/device/config/matmul_program_config.cpp
+++ ttnn/cpp/ttnn/operations/matmul/device/config/matmul_program_config.cpp
@@ -1258,18 +1258,44 @@
     // otherwise the 1D matmul.
     if (!attributes.user_core_coord.has_value()) {
         const auto grid = input_tensor_a.device()->compute_with_storage_grid_size();
-        const auto decode_config = create_matmul_decode_program_config(input_tensor_a, grid, /*fuse_swiglu=*/false);
+        auto decode_config = create_matmul_decode_program_config(input_tensor_a, grid, /*fuse_swiglu=*/false);
         const uint32_t N = utilities::get_matmul_tensor_padded_shape(input_tensor_b, transpose_b)[-1];
-        if (N / tt::constants::TILE_WIDTH >= grid.x * grid.y &&
-            !matmul_decode_unsupported_reason(input_tensor_a, input_tensor_b, bias, attributes, decode_config)
-                 .has_value()) {
-            return decode_config;
+        const uint32_t out_Nt = N / tt::constants::TILE_WIDTH;
+        const uint32_t worker_cores = grid.x * grid.y;
+        // A core streams in0_block_w K rows of each output tile of its pass per
+        // weight block, one block per round trip on each NOC: blocks of up to
+        // 16 tiles, and at least four blocks once a core streams 16 tiles or
+        // more, so that reads stay in flight (the GDN qkv projection of
+        // Qwen3.8-Flash-Next, two output tiles a core and K = 80 tiles, 28.1 us
+        // with blocks of 2 K tiles, 25.6 with 8; its hyper-connection up
+        // projection, three tiles of K = 10, is fastest at 2).
+        {
+            const uint32_t Kt =
+                utilities::get_matmul_tensor_padded_shape(input_tensor_a, /*transpose_a=*/false)[-1] /
+                tt::constants::TILE_WIDTH;
+            const uint32_t per_core = tt::div_up(out_Nt, std::max(1u, std::min(out_Nt, worker_cores)));
+            const uint32_t group = tt::div_up(per_core, tt::div_up(per_core, 8u));
+            for (uint32_t w = 1; w <= Kt; ++w) {
+                if (Kt % w == 0 && w * group <= 16 && (group * Kt < 16 || Kt / w >= 4)) {
+                    decode_config.in0_block_w = w;
+                }
+            }
         }
         // Only for BF16 outputs: matmul_decode reads BF16 activations only, so an
         // FP32 matmul of a BF16 activation keeps summing in the order of one of
         // the activation cast to FP32.
         const bool bf16_output =
             attributes.output_dtype.value_or(input_tensor_a.dtype()) == tt::tt_metal::DataType::BFLOAT16;
+        // The decode program once its output tiles fill at least half of the
+        // worker cores (one output tile each) for a BF16 output, all of them for
+        // FP32; the 1D matmul's K loop is slower per core: Qwen3.8-Flash-Next's
+        // out projection [1536, 2560] 13.4 -> 11.2 us, its shared-expert down
+        // projection [160, 2560] 3.4 -> 2.5 us.
+        if ((bf16_output ? 2 * out_Nt : out_Nt) >= worker_cores &&
+            !matmul_decode_unsupported_reason(input_tensor_a, input_tensor_b, bias, attributes, decode_config)
+                 .has_value()) {
+            return decode_config;
+        }
         if (const auto split_config =
                 bf16_output ? create_matmul_decode_split_k_program_config(input_tensor_a, input_tensor_b, transpose_b, grid)
                             : std::nullopt;
