-            (source_page_size_bytes / source_chunks) % dest_page_size_bytes != 0)) {
+    while (source_chunks > 1 && !valid_chunks(source_chunks)) {
         --source_chunks;
     }
+    // A chunk is staged whole in L1, twice per kernel, so rows that are still too wide (a flattened
+    // [1, N] buffer) are split further and each core copies several chunks.
+    constexpr uint32_t max_chunk_bytes = 64 * 1024;
+    for (uint32_t chunks = source_chunks + 1;
+         source_page_size_bytes / source_chunks > max_chunk_bytes && chunks <= source_page_size_bytes / 64;
+         ++chunks) {
+        if (valid_chunks(chunks)) {
+            source_chunks = chunks;
+        }
