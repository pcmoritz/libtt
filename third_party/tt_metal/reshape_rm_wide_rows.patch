     // Split wide input rows across cores. Each chunk must contain whole output
     // rows and start at a 64-byte boundary so the existing copy kernel can read
     // it independently without sharing output pages with another core.
+    auto valid_chunks = [&](uint32_t chunks) {
+        return source_page_size_bytes % chunks == 0 && (source_page_size_bytes / chunks) % 64 == 0 &&
+               (source_page_size_bytes / chunks) % dest_page_size_bytes == 0;
+    };
     uint32_t source_chunks = std::max(1u, num_cores_total / input_log_shape[-2]);
-    while (source_chunks > 1 &&
