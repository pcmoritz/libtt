+// Float8 <-> Float32 typecasts convert the float8 bytes exactly in SFPU registers: the hardware's own
+// conversions truncate, flush subnormals and lose NaN.
+inline bool is_float8_float32_typecast(tt::tt_metal::DataType input_dtype, tt::tt_metal::DataType output_dtype) {
+    auto is_float8 = [](tt::tt_metal::DataType dtype) {
+        return dtype == tt::tt_metal::DataType::FP8_E4M3 || dtype == tt::tt_metal::DataType::FP8_E5M2;
+    };
+    return (is_float8(input_dtype) && output_dtype == tt::tt_metal::DataType::FLOAT32) ||
+           (input_dtype == tt::tt_metal::DataType::FLOAT32 && is_float8(output_dtype));
+}
+
