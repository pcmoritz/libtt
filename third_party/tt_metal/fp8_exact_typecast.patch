+template <bool DECODE, int M, int BIAS, bool HAS_INF>
+inline void fp8_typecast_tile(uint32_t idst) {
+    if constexpr (DECODE) {
+        SFPU_UNARY_CALL(DST_SYNC_MODE, DST_ACCUM_MODE, calculate_fp8_to_fp32, (M, BIAS, HAS_INF), idst, VectorMode::RC);
+    } else {
+        SFPU_UNARY_CALL(DST_SYNC_MODE, DST_ACCUM_MODE, calculate_fp32_to_fp8, (M, BIAS, HAS_INF), idst, VectorMode::RC);
+    }
+}
