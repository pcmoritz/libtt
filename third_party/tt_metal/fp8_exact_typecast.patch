     tt::tt_metal::DataType input_dtype, tt::tt_metal::DataType output_dtype) {
+    if (is_float8_float32_typecast(input_dtype, output_dtype) && input_dtype != tt::tt_metal::DataType::FLOAT32) {
+        return tt::DataFormat::UInt8;
+    }
     return ((input_dtype == tt::tt_metal::DataType::FLOAT16 || input_dtype == tt::tt_metal::DataType::BFLOAT16) &&
