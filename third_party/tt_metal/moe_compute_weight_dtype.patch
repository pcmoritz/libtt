+
+ttnn::Tensor prepare_w0_w1_tensor_with_column_scales(
+    const ttnn::Tensor& experts_w0,
+    const ttnn::Tensor& experts_w1,
+    const ttnn::Tensor& tt_s0,
+    const ttnn::Tensor& tt_s1,
+    uint32_t L,
+    uint32_t E,
+    uint32_t K,
+    uint32_t N) {
+    TT_FATAL(
+        experts_w0.dtype() == ttnn::DataType::FP8_E4M3 && experts_w1.dtype() == ttnn::DataType::FP8_E4M3,
+        "W0 and W1 are FP8_E4M3, got {} and {}",
+        experts_w0.dtype(),
+        experts_w1.dtype());
+    // The packing moves the experts' bytes: UINT8 views.
+    const ttnn::Tensor tt_w0 = ttnn::bitcast(experts_w0, ttnn::DataType::UINT8);
+    const ttnn::Tensor tt_w1 = ttnn::bitcast(experts_w1, ttnn::DataType::UINT8);
+    TT_FATAL(K % TILE_SIZE == 0, "K dimension ({}) must be divisible by TILE_SIZE ({})", K, TILE_SIZE);
+    TT_FATAL(N % TILE_SIZE == 0, "N dimension ({}) must be divisible by TILE_SIZE ({})", N, TILE_SIZE);
+    TT_FATAL(
+        tt_w0.logical_shape() == ttnn::Shape({L, E, K, N}) && tt_w1.logical_shape() == tt_w0.logical_shape(),
+        "W0 and W1 are ({}, {}, {}, {}), got {} and {}",
+        L,
+        E,
+        K,
+        N,
+        tt_w0.logical_shape(),
+        tt_w1.logical_shape());
+
+    const uint32_t Kt = K / TILE_SIZE;
+    const uint32_t Nt = N / TILE_SIZE;
+    const uint32_t num_cores = static_cast<uint32_t>(
+        get_weight_core_shard_maps(tt_w0.device(), /*hidden_size=*/K, /*intermediate_size=*/N).w0_w1_shard_map.size());
+    const uint32_t tiles_per_txn = ::moe_ring::tiles_per_txn_for_shape(Kt, Nt, /*has_bias=*/false, num_cores);
+    // The K rows after the weights': zero rows up to the scale row, then the scale and the two identity rows.
+    const uint32_t scale_row = (::moe_ring::column_scale_row(Kt, tiles_per_txn) - Kt) * TILE_SIZE;
+    const uint32_t rows = scale_row + ::moe_ring::COLUMN_SCALE_ROWS * TILE_SIZE;
+    constexpr uint8_t fp8_one = 0x38;  // 1.0 in float8_e4m3
+
+    // The scales on host: each expert's gate scales, then its up scales.
+    auto both = ttnn::concat({tt_s0, tt_s1}, 2);
+    auto scales = column_scales_on_host(both, L, E, 2 * N);
+    both.deallocate(/*force=*/true);
+
+    // W0's or W1's K rows after the weights', from the scales: (L, E, 2 * N) -> (L, E, rows, N).
+    const auto tail = [&](bool w1) {
+        const tt::tt_metal::TensorSpec spec(
+            ttnn::Shape({L, E, rows, N}),
+            tt::tt_metal::TensorLayout(
+                tt_w0.dtype(), tt::tt_metal::PageConfig(ttnn::Layout::ROW_MAJOR), ttnn::MemoryConfig{}));
+        auto buffer = scales.host_storage().buffer().transform(
+            [&](const tt::tt_metal::HostBuffer& shard) {
+                const auto values = shard.view_as<float>();
+                std::vector<uint8_t> out(static_cast<size_t>(L) * E * rows * N, 0);
+                // A traced call (a constraint query) has no data to read.
+                const size_t experts = values.size() == static_cast<size_t>(L) * E * 2 * N ? L * E : 0;
+                for (size_t expert = 0; expert < experts; ++expert) {
+                    const float* in = values.data() + expert * 2 * N;
+                    uint8_t* tiles = out.data() + (expert * rows + scale_row) * N;
+                    for (uint32_t tile = 0; tile < Nt; ++tile) {
+                        // The identity: in W0's second row of tiles, in W1's third.
+                        for (uint32_t d = 0; d < TILE_SIZE; ++d) {
+                            tiles[((w1 ? 2 : 1) * TILE_SIZE + d) * N + tile * TILE_SIZE + d] = fp8_one;
+                        }
+                        // The first row of tiles: W0's and W1's are the halves of the scale tile, each with
+                        // the gate scales (the first slot's) and the up scales.
+                        write_scale_half_tile(
+                            tiles + tile * TILE_SIZE, N, {in + tile * TILE_SIZE, in + N + tile * TILE_SIZE});
+                    }
+                }
+                return tt::tt_metal::HostBuffer(std::move(out));
+            },
+            tt::tt_metal::DistributedHostBuffer::ProcessShardExecutionPolicy::PARALLEL);
+        auto host = ttnn::to_layout(
+            ttnn::Tensor(tt::tt_metal::host_tensor_from_buffer_with_topology(
+                std::move(buffer), spec, scales.tensor_topology())),
+            tt_w0.layout());
+        return ttnn::to_device(host, tt_w0.device(), tt_w0.memory_config());
+    };
+    const auto with_tail = [&](const ttnn::Tensor& weights, bool w1) {
+        auto rows_after = tail(w1);
+        auto all = ttnn::concat({weights, rows_after}, 2);
+        rows_after.deallocate(/*force=*/true);
+        return all;
+    };
+    auto w0 = with_tail(tt_w0, /*w1=*/false);
+    auto w1 = with_tail(tt_w1, /*w1=*/true);
+    auto result = prepare_w0_w1_compact(w0, w1, L, E, K + rows, N, tiles_per_txn);
+    w0.deallocate(/*force=*/true);
+    w1.deallocate(/*force=*/true);
+    // The bytes are float8 values, which the matrix unit reads: a view.
+    return ttnn::bitcast(result, ttnn::DataType::FP8_E4M3);
+}
+
+ttnn::Tensor prepare_w2_tensor_with_column_scales(
+    const ttnn::Tensor& experts_w2, const ttnn::Tensor& tt_s2, uint32_t L, uint32_t E, uint32_t N, uint32_t K) {
+    TT_FATAL(experts_w2.dtype() == ttnn::DataType::FP8_E4M3, "W2 is FP8_E4M3, got {}", experts_w2.dtype());
+    // The packing moves the experts' bytes: UINT8 views.
+    const ttnn::Tensor tt_w2 = ttnn::bitcast(experts_w2, ttnn::DataType::UINT8);
+    TT_FATAL(N % TILE_SIZE == 0, "N dimension ({}) must be divisible by TILE_SIZE ({})", N, TILE_SIZE);
+    TT_FATAL(K % TILE_SIZE == 0, "K dimension ({}) must be divisible by TILE_SIZE ({})", K, TILE_SIZE);
+    TT_FATAL(
+        tt_w2.logical_shape() == ttnn::Shape({L, E, N, K}),
+        "W2 is ({}, {}, {}, {}), got {}",
+        L,
+        E,
+        N,
+        K,
+        tt_w2.logical_shape());
+
+    const auto shard_maps = get_weight_core_shard_maps(tt_w2.device(), /*hidden_size=*/K, /*intermediate_size=*/N);
+    const auto& w0_w1_shard_map = shard_maps.w0_w1_shard_map;
+    const auto& w2_shard_map = shard_maps.w2_shard_map;
+    const uint32_t Nt = N / TILE_SIZE;
+    const uint32_t Kt = K / TILE_SIZE;
+    const uint32_t num_cores = static_cast<uint32_t>(w2_shard_map.size());
+    const uint32_t first_pair_sum = w2_shard_map[0].first + w2_shard_map[0].second;
+    const uint32_t w2_groups_per_core = ceil_div(Kt, num_cores * first_pair_sum);
+    const uint32_t full_block_width = (w2_groups_per_core - 1) * 4 * TILE_SIZE;
+    const uint32_t tiles_per_txn = ::moe_ring::tiles_per_txn_for_shape(Kt, Nt, /*has_bias=*/false, num_cores);
+    // The K rows after the weights': zero rows up to the scale row, then the scale and the two identity rows.
+    const uint32_t scale_row = (::moe_ring::column_scale_row(Nt, tiles_per_txn) - Nt) * TILE_SIZE;
+    const uint32_t rows = scale_row + ::moe_ring::COLUMN_SCALE_ROWS * TILE_SIZE;
+    constexpr uint8_t fp8_one = 0x38;  // 1.0 in float8_e4m3
+
+    // 1) The weights, ring-rotated in the kernel's layout (no trailing N padding).
+    auto n_reordered_no_pad = prepare_w2_no_n_pad(tt_w2, L, E, N, K, w2_shard_map, w0_w1_shard_map);
+
+    // 2) The rows after them, from the scales on host, in the weights' layout: (L, E, K) ->
+    //    (num_cores, L, E, groups, rows, 4 * TILE_SIZE). A core's column tiles fill its groups' slots in order.
+    std::vector<uint32_t> core_tiles;
+    core_tiles.reserve(num_cores);
+    for (const auto& [last_group_tiles, last_group_pad_tiles] : w2_shard_map) {
+        core_tiles.push_back(full_block_width / TILE_SIZE + last_group_tiles);
+    }
+    TT_FATAL(
+        std::accumulate(core_tiles.begin(), core_tiles.end(), 0u) == Kt,
+        "The W2 column shards do not hold the {} column tiles",
+        Kt);
+    auto host_scales = column_scales_on_host(tt_s2, L, E, K);
+    constexpr uint32_t group_width = 4 * TILE_SIZE;
+    const tt::tt_metal::TensorSpec spec(
+        ttnn::Shape({num_cores, L, E, w2_groups_per_core, rows, group_width}),
+        tt::tt_metal::TensorLayout(
+            tt_w2.dtype(), tt::tt_metal::PageConfig(ttnn::Layout::ROW_MAJOR), ttnn::MemoryConfig{}));
+    auto buffer = host_scales.host_storage().buffer().transform(
+        [&](const tt::tt_metal::HostBuffer& shard) {
+            const auto values = shard.view_as<float>();
+            const size_t group_bytes = static_cast<size_t>(rows) * group_width;
+            std::vector<uint8_t> out(static_cast<size_t>(num_cores) * L * E * w2_groups_per_core * group_bytes, 0);
+            // A traced call (a constraint query) has no data to read.
+            const size_t experts = values.size() == static_cast<size_t>(L) * E * K ? L * E : 0;
+            uint32_t first_tile = 0;
+            for (uint32_t core = 0; core < num_cores; first_tile += core_tiles[core++]) {
+                for (size_t expert = 0; expert < experts; ++expert) {
+                    const float* in = values.data() + expert * K;
+                    for (uint32_t group = 0; group < w2_groups_per_core; ++group) {
+                        uint8_t* tiles =
+                            out.data() +
+                            ((static_cast<size_t>(core) * L * E + expert) * w2_groups_per_core + group) * group_bytes +
+                            static_cast<size_t>(scale_row) * group_width;
+                        // A slot's column tile's scales, or null for a slot past the core's columns.
+                        const auto scales = [&](uint32_t slot) -> const float* {
+                            const uint32_t tile = 4 * group + slot;
+                            return tile < core_tiles[core] ? in + (first_tile + tile) * TILE_SIZE : nullptr;
+                        };
+                        for (uint32_t slot = 0; slot < 4; ++slot) {
+                            // The first row of tiles: the slot's half of its pair's scale tile.
+                            const uint32_t pair = slot / 2 * 2;
+                            write_scale_half_tile(tiles + slot * TILE_SIZE, group_width, {scales(pair), scales(pair + 1)});
+                            // The identity: in the second row of tiles for a pair's first slot, in the third for
+                            // its second.
+                            for (uint32_t d = 0; d < TILE_SIZE; ++d) {
+                                tiles[((1 + slot % 2) * TILE_SIZE + d) * group_width + slot * TILE_SIZE + d] = fp8_one;
+                            }
+                        }
+                    }
+                }
+            }
+            return tt::tt_metal::HostBuffer(std::move(out));
+        },
+        tt::tt_metal::DistributedHostBuffer::ProcessShardExecutionPolicy::PARALLEL);
+    auto tail_host = ttnn::to_layout(
+        ttnn::Tensor(tt::tt_metal::host_tensor_from_buffer_with_topology(
+            std::move(buffer), spec, host_scales.tensor_topology())),
+        tt_w2.layout());
+    auto tail_grouped = ttnn::to_device(tail_host, tt_w2.device(), tt_w2.memory_config());
+
+    // 4) After the weights' rows, padded to whole DRAM blocks.
+    auto all = ttnn::concat({n_reordered_no_pad, tail_grouped}, 4);
+    n_reordered_no_pad.deallocate(/*force=*/true);
+    tail_grouped.deallocate(/*force=*/true);
+    auto blocks = w2_blocks_from_groups(all, Nt + rows / TILE_SIZE, Kt, tiles_per_txn);
+    all.deallocate(/*force=*/false);
+    auto result = ttnn::to_layout(blocks, ttnn::Layout::TILE);
+    blocks.deallocate(/*force=*/false);
+    // The bytes are float8 values, which the matrix unit reads: a view.
+    return ttnn::bitcast(result, ttnn::DataType::FP8_E4M3);
+}
