+// matmul_block_init for in0 @ weights, ct_dim tiles wide. FP8 weights (fp8_weights) have four significant bits,
+// which the first of srcA's two fidelity slices holds whole: the phases that take its second slice, 1 and 3, add
+// nothing to a product. HiFi2's two passes then run as phases 0 and 2, the weights times the two slices of in0,
+// which is as exact as HiFi4. llk_math_matmul_init has ADDR_MOD_5 end each pass one phase on; this makes it two.
+template <bool fp8_weights>
+FORCE_INLINE void matmul_block_init_for_weights(uint32_t in0_cb_id, uint32_t weights_cb_id, uint32_t ct_dim) {
+    matmul_block_init(in0_cb_id, weights_cb_id, /*transpose=*/false, ct_dim, /*rt_dim=*/1, /*kt_dim=*/1);
+    if constexpr (fp8_weights) {
+        MATH((ckernel::addr_mod_t{
+                  .srca = {.incr = 0, .clr = 1, .cr = 1},
+                  .srcb = {.incr = 0, .clr = 1, .cr = 1},
+                  .dest = {.incr = 0, .clr = 1, .cr = 1},
+                  .fidelity =
+                      {.incr = MATH_FIDELITY == ckernel::MathFidelity::HiFi2  ? 2
+                               : MATH_FIDELITY == ckernel::MathFidelity::LoFi ? 0
+                                                                              : 1,
+                       .clr = 0},
+              }
+                  .set(ADDR_MOD_5)));
+    }
+}
+
+// FP8 experts' scale tiles into the DEST tiles after a block column's ct_dim data tiles. K row `k` of the weights
+// holds a scale tile per pair of slots (read as the FLOAT16 tile its two slots' bytes make), the next row the
+// identity in each pair's first slot and the row after in its second (moe_ring_common.h, COLUMN_SCALE_ROWS): the
+// first pair's scale tile times the next row lands in dst ct_dim (and ct_dim + 2), the second pair's times the row
+// after in dst ct_dim + 1 (and ct_dim + 3).
+FORCE_INLINE void matmul_scale_tiles(uint32_t weights_cb_id, uint32_t k, uint32_t ct_dim) {
+    matmul_block(weights_cb_id, weights_cb_id, k, k + ct_dim, ct_dim, /*transpose=*/false, ct_dim, 1, 1);
+    if (ct_dim == 4) {
+        matmul_block(weights_cb_id, weights_cb_id, k + 2, k + 2 * ct_dim, ct_dim, /*transpose=*/false, ct_dim, 1, 1);
+    }
+}
