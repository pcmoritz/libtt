+// A slot's half of its pair's scale tile (moe_ring_common.h, COLUMN_SCALE_ROWS) as the float8 tile that holds its
+// bytes: `tile`, 32 rows of 32 bytes `stride` apart. The half is two FLOAT16 faces of 16 rows, the left and the
+// right 16 columns', with the pair's first slot's scales in rows 0 to 3 and its second slot's in rows 4 to 7.
+// `scales[slot]` are a slot's 32 columns' FP32 scales, or null for a slot without columns.
+void write_scale_half_tile(uint8_t* tile, size_t stride, const std::array<const float*, 2>& scales) {
+    uint8_t raw[TILE_SIZE * TILE_SIZE] = {};
+    for (uint32_t slot = 0; slot < 2; ++slot) {
+        for (uint32_t column = 0; scales[slot] != nullptr && column < TILE_SIZE; ++column) {
+            const tt::tt_metal::float16 scale(std::ldexp(scales[slot][column], ::moe_ring::COLUMN_SCALE_SHIFT));
+            const uint32_t face = column / (TILE_SIZE / 2);
+            for (uint32_t row = 4 * slot; row < 4 * slot + 4; ++row) {
+                uint8_t* bytes = raw + face * 512 + row * TILE_SIZE + (column % 16) * 2;
+                bytes[0] = static_cast<uint8_t>(scale.bits);
+                bytes[1] = static_cast<uint8_t>(scale.bits >> 8);
+            }
+        }
+    }
+    // The bytes as a float8 tile: four 16 x 16 faces.
+    for (uint32_t face = 0; face < 4; ++face) {
+        for (uint32_t row = 0; row < 16; ++row) {
+            std::memcpy(tile + ((face / 2) * 16 + row) * stride + (face % 2) * 16, raw + face * 256 + row * 16, 16);
+        }
+    }
+}
