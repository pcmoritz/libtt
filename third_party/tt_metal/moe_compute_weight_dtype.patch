+// FP8 experts' column scales, (L, E, columns) FLOAT32 on device, on host and row-major. The scale tile holds
+// finite scales up to the largest FLOAT16 times 2^-COLUMN_SCALE_SHIFT in magnitude; a larger one is refused.
+ttnn::Tensor column_scales_on_host(const ttnn::Tensor& scales, uint32_t L, uint32_t E, uint32_t columns) {
+    TT_FATAL(
+        scales.logical_shape() == ttnn::Shape({L, E, columns}) && scales.dtype() == ttnn::DataType::FLOAT32,
+        "Column scales are FLOAT32 ({}, {}, {}), got {} {}",
+        L,
+        E,
+        columns,
+        scales.dtype(),
+        scales.logical_shape());
+    auto host = ttnn::to_layout(ttnn::from_device(scales), ttnn::Layout::ROW_MAJOR);
+    const float largest = std::ldexp(65504.0f, -::moe_ring::COLUMN_SCALE_SHIFT);
+    host.host_storage().buffer().apply([&](const tt::tt_metal::HostBuffer& shard) {
+        const auto values = shard.view_as<float>();
+        // A traced call (a constraint query) has no data to read.
+        if (values.size() != static_cast<size_t>(L) * E * columns) {
+            return;
+        }
+        for (const float scale : values) {
+            TT_FATAL(
+                std::isfinite(scale) && std::fabs(scale) <= largest,
+                "An FP8 expert's column scale is {}; moe_compute takes finite scales up to {} in magnitude",
+                scale,
+                largest);
+        }
+    });
+    return host;
+}
