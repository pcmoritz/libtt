+#include "sfpi.h"
+
+// Column scales of FP8 experts (moe_ring_common.h, COLUMN_SCALE_ROWS): a data tile in DEST times its columns'
+// scales, which sit in rows of a scale tile in another DEST tile, times 2^18 (COLUMN_SCALE_SHIFT).
+//
+// An SFPU load takes four rows of eight columns: load 2 * i of a face its rows 4 * i to 4 * i + 3 at the even
+// columns, load 2 * i + 1 the same rows at the odd columns. The scale tile repeats each scale over four rows, so
+// load 2 * slot + p of one of its faces holds the scales of a slot's even (p = 0) or odd (p = 1) columns of that
+// face in every row.
+namespace moe_column_scale {
+
+// One face of the data tile, where DEST points, times its 16 columns' scales, the loads `scales` and `scales` + 1
+// from here.
+template <int32_t scales>
+inline void scale_face() {
+    sfpi::vFloat even = sfpi::dst_reg[scales] * 0x1p-18f;
+    sfpi::vFloat odd = sfpi::dst_reg[scales + 1] * 0x1p-18f;
+    for (int d = 0; d < 4; d++) {
+        sfpi::vFloat value = sfpi::dst_reg[0];
+        sfpi::dst_reg[0] = value * even;
+        sfpi::dst_reg++;
+        value = sfpi::dst_reg[0];
+        sfpi::dst_reg[0] = value * odd;
+        sfpi::dst_reg++;
+    }
+}
+
+// DEST tile `data` times the scales of the scale tile at DEST tile `scale`: those of its pair's first (slot = 0)
+// or second slot (slot = 1). Each face of the scale tile holds the scales of its 16 columns, the first slot's in
+// its loads 0 and 1 and the second's in loads 2 and 3: every face of the data tile reads the same face of the scale
+// tile, whole tiles further on.
+template <uint32_t data, uint32_t scale, int32_t slot>
+inline void scale_columns() {
+    constexpr int32_t tile = 32;  // a tile in loads
+    constexpr int32_t scales = (static_cast<int32_t>(scale) - static_cast<int32_t>(data)) * tile + 2 * slot;
+    _llk_math_eltwise_sfpu_start_(data);
+    for (int face = 0; face < 4; face++) {
+        scale_face<scales>();
+        _llk_math_eltwise_sfpu_inc_dst_face_addr_();
+    }
+    _llk_math_eltwise_sfpu_done_();
+}
+
+// The data tiles of one or two pairs (dst 0/1 and, with two pairs, 2/3) times their scales: each pair's scale
+// tile follows the data tiles, at dst 2 * pairs + pair.
+template <uint32_t pairs>
+inline void scale_block_column() {
+    scale_columns<0, 2 * pairs, 0>();
+    scale_columns<1, 2 * pairs, 1>();
+    if constexpr (pairs == 2) {
+        scale_columns<2, 2 * pairs + 1, 0>();
+        scale_columns<3, 2 * pairs + 1, 1>();
+    }
+}
+
+}  // namespace moe_column_scale
