 namespace ttnn::prim {
 
 using namespace tt::tt_metal;
+
+// Partition output rows into bounded pieces instead of assigning whole rows.
+// This also permits rows larger than L1 and uses more cores for wide tensors.
+static ProgramDescriptor chunked_reshape(
+    const Tensor& input, const Tensor& output, const CoreRangeSet& cores,
+    uint32_t source_row_bytes, uint32_t dest_row_bytes) {
+    constexpr uint32_t chunk_bytes = 2048;
+    const uint32_t chunks_per_row = (dest_row_bytes + chunk_bytes - 1) / chunk_bytes;
+    const uint32_t chunks = (output.logical_volume() / output.logical_shape()[-1]) * chunks_per_row;
+    ProgramDescriptor desc;
+    for (uint32_t cb = 0; cb < 2; ++cb) {
+        const uint32_t bytes = chunk_bytes + (cb == 1 ? 64 : 0);
+        desc.cbs.push_back(CBDescriptor{
+            .total_size = bytes,
+            .core_ranges = cores,
+            .format_descriptors = {{CBFormatDescriptor{
+                .buffer_index = cb,
+                .data_format = datatype_to_dataformat_converter(input.dtype()),
+                .page_size = bytes,
+            }}},
+        });
+    }
+    KernelDescriptor kernel;
+    kernel.kernel_source =
+        "ttnn/cpp/ttnn/operations/data_movement/reshape_view/device/device/rm_reshape_chunked.cpp";
+    kernel.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    kernel.core_ranges = cores;
+    kernel.compile_time_args = {source_row_bytes, dest_row_bytes, chunk_bytes, chunks_per_row};
+    TensorAccessorArgs(*input.buffer()).append_to(kernel.compile_time_args);
+    TensorAccessorArgs(*output.buffer()).append_to(kernel.compile_time_args);
+    kernel.config = ReaderConfigDescriptor{};
+    uint32_t i = 0;
+    for (auto core : corerange_to_cores(cores, std::nullopt)) {
+        const uint32_t start = uint64_t(chunks) * i / cores.num_cores();
+        const uint32_t end = uint64_t(chunks) * ++i / cores.num_cores();
+        kernel.emplace_runtime_args(core, {input.buffer(), output.buffer(), start, end});
+    }
+    desc.kernels.push_back(std::move(kernel));
+    return desc;
+}
 
