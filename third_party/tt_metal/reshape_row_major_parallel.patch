+// SPDX-FileCopyrightText: (c) 2026 Tenstorrent AI ULC
+// SPDX-License-Identifier: Apache-2.0
+#include "api/dataflow/dataflow_api.h"
+#include "ttnn/operations/data_movement/common/kernels/common.hpp"
+
+void kernel_main() {
+    constexpr uint32_t source_row_bytes = get_compile_time_arg_val(0);
+    constexpr uint32_t dest_row_bytes = get_compile_time_arg_val(1);
+    constexpr uint32_t chunk_bytes = get_compile_time_arg_val(2);
+    constexpr uint32_t chunks_per_row = get_compile_time_arg_val(3);
+    constexpr auto source_args = TensorAccessorArgs<4>();
+    constexpr auto dest_args = TensorAccessorArgs<source_args.next_compile_time_args_offset()>();
+    const auto source = TensorAccessor(source_args, get_arg_val<uint32_t>(0));
+    const auto dest = TensorAccessor(dest_args, get_arg_val<uint32_t>(1));
+    const uint32_t start = get_arg_val<uint32_t>(2), end = get_arg_val<uint32_t>(3);
+    cb_reserve_back(0, 1);
+    cb_reserve_back(1, 1);
+    const uint32_t output = get_write_ptr(0), scratch = get_write_ptr(1);
+    for (uint32_t chunk = start; chunk < end; ++chunk) {
+        const uint32_t row = chunk / chunks_per_row;
+        const uint32_t offset = (chunk % chunks_per_row) * chunk_bytes;
+        const uint32_t bytes = std::min(chunk_bytes, dest_row_bytes - offset);
+        uint64_t position = uint64_t(row) * dest_row_bytes + offset;
+        uint32_t copied = 0;
+        while (copied < bytes) {
+            const uint32_t source_row = position / source_row_bytes;
+            const uint32_t source_offset = position % source_row_bytes;
+            const uint32_t count = std::min(bytes - copied, source_row_bytes - source_offset);
+            const uint64_t address = source.get_noc_addr(source_row) + source_offset;
+            if ((address & 63) == 0 && (copied & 63) == 0) {
+                noc_async_read(address, output + copied, count);
+            } else {
+                const uint32_t alignment = address & 63;
+                noc_async_read(address - alignment, scratch, (alignment + count + 63) & ~uint32_t(63));
+                noc_async_read_barrier();
+                tt::data_movement::common::copy_via_memmove<false>(output + copied, scratch + alignment, count);
+            }
+            position += count;
+            copied += count;
+        }
+        noc_async_read_barrier();
+        noc_async_write(output, dest.get_noc_addr(row) + offset, bytes);
+        noc_async_write_barrier();
+    }
+}
