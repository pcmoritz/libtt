+void AllocatorImpl::add_trace_dram_footprint(uint32_t trace_id, const TraceAllocationFootprint& footprint) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!footprint.dram.empty()) {
+        trace_dram_footprints_[trace_id] = footprint.dram;
+    }
+    // Also restores a pool suspended for this capture when the capture allocated nothing.
+    this->release_trace_dram_reservations();
+    this->reserve_trace_dram_footprints();
+}
+
+void AllocatorImpl::remove_trace_dram_footprint(uint32_t trace_id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    trace_dram_footprints_.erase(trace_id);
+    // Re-reserve even for an unknown trace: releasing a trace whose capture never ended restores the pool.
+    this->release_trace_dram_reservations();
+    this->reserve_trace_dram_footprints();
+}
+
+void AllocatorImpl::suspend_trace_dram_reservations() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    this->release_trace_dram_reservations();
+}
+
+void AllocatorImpl::reserve_trace_dram_footprints() {
+    for (const auto& [trace_id, footprint] : trace_dram_footprints_) {
+        auto reserved = dram_manager_->reserve_free_regions(footprint);
+        trace_dram_reservations_.insert(trace_dram_reservations_.end(), reserved.begin(), reserved.end());
+    }
+}
+
+void AllocatorImpl::release_trace_dram_reservations() {
+    dram_manager_->release_reserved_regions(trace_dram_reservations_);
+    trace_dram_reservations_.clear();
+}
