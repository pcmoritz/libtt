+BankManager::AllocationFootprint BankManager::reserve_free_regions(const AllocationFootprint& footprint) {
+    AllocationFootprint reserved;
+    for (const AllocationRegion& region : footprint) {
+        const AllocatorDependencies::AllocatorID allocator_id{region.allocator_id};
+        auto* alloc = this->get_allocator_from_id(allocator_id);
+        TT_FATAL(alloc, "Allocator not initialized for ID {}", region.allocator_id);
+        for (const auto& [free_begin, free_end] : alloc->available_addresses(1)) {
+            const DeviceAddr begin = std::max(region.begin, free_begin);
+            const DeviceAddr end = std::min(region.end, free_end);
+            if (begin >= end) {
+                continue;
+            }
+            if (alloc->allocate_at_address(begin, end - begin).has_value()) {
+                reserved.push_back({region.allocator_id, begin, end});
+            }
+        }
+        this->invalidate_allocated_ranges_cache_for_dependent_allocators(allocator_id);
+    }
+    return reserved;
+}
+
+void BankManager::release_reserved_regions(const AllocationFootprint& reserved) {
+    for (const AllocationRegion& region : reserved) {
+        const AllocatorDependencies::AllocatorID allocator_id{region.allocator_id};
+        auto* alloc = this->get_allocator_from_id(allocator_id);
+        TT_FATAL(alloc, "Allocator not initialized for ID {}", region.allocator_id);
+        // Never free a buffer that took the address after the allocator was reset.
+        if (allocated_buffers_[region.allocator_id].contains(region.begin)) {
+            continue;
+        }
+        alloc->deallocate(region.begin);
+        this->invalidate_allocated_ranges_cache_for_dependent_allocators(allocator_id);
+    }
+}
