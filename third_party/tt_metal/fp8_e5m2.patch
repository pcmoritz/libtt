+// FP8 E5M2: 1 sign bit (MSB), 5 exponent bits (bias=15), 2 mantissa bits: the top
+// byte of an IEEE half, with subnormals, infinities and NaNs.
+class float8_e5m2 {
+private:
+    uint8_t uint8_data;
+
+public:
+    constexpr float8_e5m2() = default;
+
+    float8_e5m2(float v) noexcept : uint8_data(from_float(v)) {}
+
+    operator float() const;
+
+    uint8_t to_bits() const { return uint8_data; }
+
+    static float8_e5m2 from_bits(uint8_t bits) {
+        float8_e5m2 f;
+        f.uint8_data = bits;
+        return f;
+    }
+
+private:
+    static uint8_t from_float(float v);
+};
+
 uint32_t pack_four_float8_e4m3_into_uint32(float8_e4m3 a, float8_e4m3 b, float8_e4m3 c, float8_e4m3 d);
 
