+// Widening conversion: FP8 E5M2 → float32, exactly.
+float8_e5m2::operator float() const {
+    const uint32_t sign = static_cast<uint32_t>(uint8_data >> 7) << 31;
+    const uint32_t exp = (uint8_data >> 2) & 0x1F;
+    const uint32_t man = uint8_data & 0x3;
+    if (exp == 0x1F) {
+        return man != 0 ? std::numeric_limits<float>::quiet_NaN() : std::bit_cast<float>(sign | 0x7F800000u);
+    }
+    if (exp == 0) {
+        const float magnitude = std::ldexp(static_cast<float>(man), -16);
+        return sign != 0 ? -magnitude : magnitude;
+    }
+    return std::bit_cast<float>(sign | ((exp - 15 + 127) << 23) | (man << 21));
+}
+
+// Narrowing conversion: rounds to nearest even; values that round past the
+// largest finite value become infinity.
+uint8_t float8_e5m2::from_float(float v) {
+    const uint32_t bits = std::bit_cast<uint32_t>(v);
+    const auto sign = static_cast<uint8_t>((bits >> 24) & 0x80);
+    uint32_t magnitude = bits & 0x7FFFFFFF;
+    if (magnitude > 0x7F800000) {
+        return sign | 0x7F;  // NaN
+    }
+    if (magnitude >= (143u << 23)) {
+        return sign | 0x7C;  // >= 2^16: infinity
+    }
+    if (magnitude < (113u << 23)) {
+        // Subnormal results, in units of 2^-16.
+        return sign | static_cast<uint8_t>(std::nearbyint(std::bit_cast<float>(magnitude) * 65536.0f));
+    }
+    magnitude += 0xFFFFF + ((magnitude >> 21) & 1);
+    return sign | static_cast<uint8_t>((magnitude >> 21) - ((127 - 15) << 2));
+}
+
 uint32_t pack_four_float8_e4m3_into_uint32(float8_e4m3 a, float8_e4m3 b, float8_e4m3 c, float8_e4m3 d) {
     return static_cast<uint32_t>(a.to_bits()) | (static_cast<uint32_t>(b.to_bits()) << 8) |
            (static_cast<uint32_t>(c.to_bits()) << 16) | (static_cast<uint32_t>(d.to_bits()) << 24);
