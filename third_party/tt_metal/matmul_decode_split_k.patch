+// The decode program reads its activation and bias and writes its output
+// through tensor accessors, so either interleaved buffer type serves.
+bool is_interleaved(const tt::tt_metal::MemoryConfig& memory_config) {
+    return memory_config.memory_layout() == tt::tt_metal::TensorMemoryLayout::INTERLEAVED;
+}
+
+// A narrow decode matmul splits K when its output tiles leave most worker
+// cores idle: one core per output tile and K share, each output tile's shares
+// stacked in grid rows. On Blackhole, five shares were fastest or close to it
+// for 0.5 to 4 MB of weights; shares of at least four K tiles keep the
+// reduction a small part of the work. Each core reads its share of the weight
+// as one block, on RISCV_0's NOC, clear of the activation multicast on
+// RISCV_1's.
+std::optional<MatmulDecodeProgramConfig> create_matmul_decode_split_k_program_config(
+    const Tensor& input_tensor_a,
+    const Tensor& input_tensor_b,
+    const bool transpose_b,
+    const tt::tt_metal::CoreCoord& grid) {
+    constexpr uint32_t min_share_tiles = 4;
+    constexpr uint32_t max_splits = 5;
+    constexpr uint32_t max_block_tiles = 64;
+    const uint32_t Kt = utilities::get_matmul_tensor_padded_shape(input_tensor_a, /*transpose_a=*/false)[-1] /
+                        tt::constants::TILE_WIDTH;
+    const uint32_t out_Nt =
+        utilities::get_matmul_tensor_padded_shape(input_tensor_b, transpose_b)[-1] / tt::constants::TILE_WIDTH;
+    if (out_Nt == 0 || Kt < 2 * min_share_tiles) {
+        return std::nullopt;
+    }
+    const uint32_t rows_per_share = tt::div_up(out_Nt, static_cast<uint32_t>(grid.x));
+    uint32_t k_splits = std::min({static_cast<uint32_t>(grid.y) / rows_per_share, Kt / min_share_tiles, max_splits});
+    while (k_splits > 1 && Kt % k_splits != 0) {
+        --k_splits;
+    }
+    if (k_splits < 2) {
+        return std::nullopt;
+    }
+    const uint32_t share = Kt / k_splits;
+    uint32_t in0_block_w = std::min(share, max_block_tiles);
+    while (share % in0_block_w != 0) {
+        --in0_block_w;
+    }
+    return MatmulDecodeProgramConfig{
+        .compute_with_storage_grid_size = grid,
+        .in0_block_w = in0_block_w,
+        .fuse_swiglu = false,
+        .k_splits = k_splits,
+    };
+}
