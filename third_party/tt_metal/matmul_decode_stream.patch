diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_blocks.hpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_blocks.hpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_blocks.hpp
@@ -0,0 +1,55 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+
+// Weight blocks of a decode-stream matmul core, in consumption order: output
+// tiles are processed in groups of up to `group` tiles, and each group walks
+// K in blocks of `kblock` tiles. Even blocks travel on RISCV_0's NOC and odd
+// blocks on RISCV_1's NOC. Every block occupies kblock * group CB tiles, so
+// narrower final groups keep the CB block size constant.
+template <uint32_t Kt, uint32_t kblock, uint32_t group>
+struct DecodeStreamBlocks {
+    uint32_t count;
+    uint32_t group_start = 0;
+    uint32_t k0 = 0;
+    uint32_t index = 0;
+
+    bool done() const { return group_start >= count; }
+    uint32_t width() const { return count - group_start < group ? count - group_start : group; }
+    void next() {
+        k0 += kblock;
+        if (k0 >= Kt) {
+            k0 = 0;
+            group_start += group;
+        }
+        ++index;
+    }
+    // Blocks with index % stride == parity belong to the calling RISC.
+    void first_owned(uint32_t stride, uint32_t parity) {
+        while (!done() && index % stride != parity) {
+            next();
+        }
+    }
+    void next_owned(uint32_t stride, uint32_t parity) {
+        do {
+            next();
+        } while (!done() && index % stride != parity);
+    }
+};
+
+template <uint32_t Kt, uint32_t kblock, uint32_t group, typename Accessor>
+FORCE_INLINE void read_decode_stream_block(
+    const Accessor& weight, uint32_t Nt, uint32_t n_start, const DecodeStreamBlocks<Kt, kblock, group>& block,
+    uint32_t ptr, uint32_t tile_bytes) {
+    const uint32_t width = block.width();
+    for (uint32_t k = 0; k < kblock; ++k) {
+        const uint32_t row = (block.k0 + k) * Nt + n_start + block.group_start;
+        for (uint32_t n = 0; n < width; ++n) {
+            noc_async_read_tile(row + n, weight, ptr + (k * width + n) * tile_bytes);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_receiver.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_receiver.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_receiver.cpp
@@ -0,0 +1,69 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "decode_stream_blocks.hpp"
+
+// RISCV_1 on multicast receivers: publish activation chunks as they land and
+// stream the odd weight blocks, never blocking on weight CB space while
+// activation chunks are still pending.
+void kernel_main() {
+    const uint32_t sender_x = get_arg_val<uint32_t>(0);
+    const uint32_t sender_y = get_arg_val<uint32_t>(1);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(2);
+    const uint32_t n_start = get_arg_val<uint32_t>(3);
+    const uint32_t count = get_arg_val<uint32_t>(4);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t Nt = get_named_compile_time_arg_val("Nt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("kblock");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr bool dual_noc = get_named_compile_time_arg_val("dual_noc");
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    constexpr uint32_t block_tiles = kblock * group;
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    volatile tt_l1_ptr uint32_t* chunks_landed =
+        reinterpret_cast<volatile tt_l1_ptr uint32_t*>(get_semaphore(receiver_sem_id));
+
+    // The CB holds all Kt tiles, so one handshake covers every chunk.
+    cb_in0.reserve_back(Kt);
+    receiver_sem.set(0);
+    sender_sem.up(noc, sender_x, sender_y, 1);
+
+    DecodeStreamBlocks<Kt, kblock, group> block{dual_noc ? count : 0};
+    block.first_owned(2, 1);
+    uint32_t chunks = 0;
+    while (chunks < num_chunks || !block.done()) {
+        if (chunks < num_chunks) {
+            invalidate_l1_cache();
+            if (*chunks_landed > chunks) {
+                cb_in0.push_back(in0_mcast_w);
+                ++chunks;
+                continue;
+            }
+        }
+        if (!block.done() && (chunks == num_chunks || cb_pages_reservable_at_back(cb_weights, block_tiles))) {
+            cb_reserve_back(cb_weights, block_tiles);
+            read_decode_stream_block(
+                weight, Nt, n_start, block, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+            noc_async_read_barrier();
+            cb_push_back(cb_weights, block_tiles);
+            block.next_owned(2, 1);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_sender.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_sender.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_sender.cpp
@@ -0,0 +1,115 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/noc_semaphore.h"
+#include "api/dataflow/endpoints.h"
+#include "api/core_local_mem.h"
+#include "decode_stream_blocks.hpp"
+
+// RISCV_1 on a multicast sender. The activation row block stays resident in
+// every core's L1: after one readiness handshake, stream it in chunks, with
+// the DRAM read of the next chunk overlapping the multicast of the current
+// one and a counting semaphore announcing landed chunks. The odd weight
+// blocks for this core follow.
+void kernel_main() {
+    const uint32_t input_addr = get_arg_val<uint32_t>(0);
+    const uint32_t dest_start_x = get_arg_val<uint32_t>(1);
+    const uint32_t dest_start_y = get_arg_val<uint32_t>(2);
+    const uint32_t dest_end_x = get_arg_val<uint32_t>(3);
+    const uint32_t dest_end_y = get_arg_val<uint32_t>(4);
+    const uint32_t num_dests = get_arg_val<uint32_t>(5);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(6);
+    const uint32_t n_start = get_arg_val<uint32_t>(7);
+    const uint32_t count = get_arg_val<uint32_t>(8);
+
+    constexpr uint32_t cb_in0_id = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t Nt = get_named_compile_time_arg_val("Nt");
+    constexpr uint32_t in0_mcast_w = get_named_compile_time_arg_val("in0_mcast_w");
+    constexpr uint32_t sender_sem_id = get_named_compile_time_arg_val("sender_sem");
+    constexpr uint32_t receiver_sem_id = get_named_compile_time_arg_val("receiver_sem");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("kblock");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr bool dual_noc = get_named_compile_time_arg_val("dual_noc");
+    constexpr uint32_t block_tiles = kblock * group;
+    constexpr uint32_t num_chunks = Kt / in0_mcast_w;
+    static_assert(Kt % in0_mcast_w == 0);
+    constexpr auto input_args = TensorAccessorArgs<0>();
+    constexpr auto weight_args = TensorAccessorArgs<input_args.next_compile_time_args_offset()>();
+
+    const auto input = TensorAccessor(input_args, input_addr);
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    Noc noc;
+    CircularBuffer cb_in0(cb_in0_id);
+    Semaphore<> sender_sem(sender_sem_id);
+    Semaphore<> receiver_sem(receiver_sem_id);
+    constexpr uint32_t tile_bytes = get_tile_size(cb_in0_id);
+    constexpr uint32_t chunk_bytes = in0_mcast_w * tile_bytes;
+
+    cb_in0.reserve_back(Kt);
+    const uint32_t base = cb_in0.get_write_ptr();
+    auto read_chunk = [&](uint32_t chunk) {
+        for (uint32_t k = 0; k < in0_mcast_w; ++k) {
+            const uint32_t tile = chunk * in0_mcast_w + k;
+            noc_async_read_tile(tile, input, base + tile * tile_bytes);
+        }
+    };
+
+    DecodeStreamBlocks<Kt, kblock, group> block{dual_noc ? count : 0};
+    block.first_owned(2, 1);
+    // Interleave this core's odd weight blocks with the activation chunks so
+    // the sender does not finish its own share of weights last.
+    auto read_weight_block_if_free = [&]() {
+        if (!block.done() && cb_pages_reservable_at_back(cb_weights, block_tiles)) {
+            cb_reserve_back(cb_weights, block_tiles);
+            read_decode_stream_block(
+                weight, Nt, n_start, block, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+            return true;
+        }
+        return false;
+    };
+
+    read_chunk(0);
+    noc.async_read_barrier();
+    sender_sem.wait(num_dests);
+    sender_sem.set(0);
+    for (uint32_t chunk = 0; chunk < num_chunks; ++chunk) {
+        if (chunk + 1 < num_chunks) {
+            read_chunk(chunk + 1);
+        }
+        if (num_dests > 0) {
+            const uint32_t addr = base + chunk * chunk_bytes;
+            MulticastEndpoint mcast_dst;
+            noc.async_write_multicast(
+                CoreLocalMem<uint32_t>(addr), mcast_dst, chunk_bytes, num_dests, {},
+                {.noc_x_start = dest_start_x, .noc_y_start = dest_start_y,
+                 .noc_x_end = dest_end_x, .noc_y_end = dest_end_y, .addr = addr}, true);
+#ifdef ARCH_BLACKHOLE
+            noc.async_writes_flushed();
+#endif
+            receiver_sem.set(chunk + 1);
+            receiver_sem.set_multicast(
+                noc, dest_start_x, dest_start_y, dest_end_x, dest_end_y, num_dests);
+        }
+        cb_in0.push_back(in0_mcast_w);
+        const bool weights = read_weight_block_if_free();
+        noc.async_read_barrier();
+        if (weights) {
+            cb_push_back(cb_weights, block_tiles);
+            block.next_owned(2, 1);
+        }
+    }
+
+    for (; !block.done(); block.next_owned(2, 1)) {
+        cb_reserve_back(cb_weights, block_tiles);
+        read_decode_stream_block(weight, Nt, n_start, block, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+        noc_async_read_barrier();
+        cb_push_back(cb_weights, block_tiles);
+    }
+    noc.async_write_barrier();
+}
