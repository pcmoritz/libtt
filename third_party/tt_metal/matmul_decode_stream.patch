+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/circular_buffer.h"
+#include "decode_stream_blocks.hpp"
+
+// RISCV_0: stream the even weight blocks (all blocks without the dual-NOC
+// split), then write this core's output tiles.
+void kernel_main() {
+    const uint32_t weight_addr = get_arg_val<uint32_t>(0);
+    const uint32_t output_addr = get_arg_val<uint32_t>(1);
+    const uint32_t n_start = get_arg_val<uint32_t>(2);
+    const uint32_t count = get_arg_val<uint32_t>(3);
+
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t Nt = get_named_compile_time_arg_val("Nt");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("kblock");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr uint32_t stride = get_named_compile_time_arg_val("dual_noc") ? 2 : 1;
+    constexpr uint32_t block_tiles = kblock * group;
+
+    constexpr auto weight_args = TensorAccessorArgs<0>();
+    constexpr auto output_args = TensorAccessorArgs<weight_args.next_compile_time_args_offset()>();
+    const auto weight = TensorAccessor(weight_args, weight_addr);
+    const auto output = TensorAccessor(output_args, output_addr);
+
+    DecodeStreamBlocks<Kt, kblock, group> block{count};
+    for (block.first_owned(stride, 0); !block.done(); block.next_owned(stride, 0)) {
+        cb_reserve_back(cb_weights, block_tiles);
+        read_decode_stream_block(weight, Nt, n_start, block, get_write_ptr(cb_weights), get_tile_size(cb_weights));
+        noc_async_read_barrier();
+        cb_push_back(cb_weights, block_tiles);
+    }
+
+    Noc noc;
+    CircularBuffer out_cb(cb_out);
+    const uint32_t page_bytes = get_local_cb_interface(cb_out).fifo_page_size;
+    for (uint32_t n = 0; n < count; ++n) {
+        out_cb.wait_front(1);
+        noc.async_write(out_cb, output, page_bytes, {}, {.page_id = n_start + n});
+        noc.async_writes_flushed();
+        out_cb.pop_front(1);
+    }
+    noc.async_write_barrier();
+}
