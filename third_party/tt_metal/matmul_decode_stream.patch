--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/matmul_swiglu_weights.hpp
@@ -0,0 +1,26 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#pragma once
+
+#include <cstdint>
+#include "api/dataflow/dataflow_api.h"
+
+// Reads one K block of this core's fused gate/up weight tiles into `ptr`.
+// Gate tiles come first, then up tiles, for each K row of the block.
+template <uint32_t in0_block_w, uint32_t per_core_N, uint32_t half_Nt, typename Accessor>
+FORCE_INLINE void read_swiglu_weight_block(
+    const Accessor& weight, uint32_t k0, uint32_t n_start, uint32_t ptr, uint32_t tile_bytes) {
+    constexpr uint32_t fused_Nt = 2 * half_Nt;
+    constexpr uint32_t combined_per_core_N = 2 * per_core_N;
+    for (uint32_t k = 0; k < in0_block_w; ++k) {
+        const uint32_t up_row = (k0 + k) * fused_Nt + n_start;
+        const uint32_t gate_row = up_row + half_Nt;
+        for (uint32_t n = 0; n < per_core_N; ++n) {
+            const uint32_t gate_local = (k * combined_per_core_N + n) * tile_bytes;
+            const uint32_t up_local = gate_local + per_core_N * tile_bytes;
+            noc_async_read_tile(gate_row + n, weight, ptr + gate_local);
+            noc_async_read_tile(up_row + n, weight, ptr + up_local);
+        }
+    }
+}
