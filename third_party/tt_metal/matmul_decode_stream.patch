+// Decode matmul of one activation tile row against BFP8 DRAM weights. The
+// activation stays resident in L1 while each core streams its weight columns
+// over both NOCs.
+struct MatmulDecodeStreamProgramFactory {
+    static tt::tt_metal::ProgramDescriptor create_descriptor(
+        const ttnn::prim::MatmulParams& operation_attributes,
+        const ttnn::prim::MatmulInputs& tensor_args,
+        std::vector<ttnn::Tensor>& tensor_return_value,
+        const std::optional<CoreRangeSet>& core_range_set = std::nullopt);
+};
+
 }  // namespace ttnn::prim
diff --git ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/decode_stream.cpp ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/decode_stream.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/decode_stream.cpp
@@ -0,0 +1,58 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/matmul.h"
+#include "api/dataflow/circular_buffer.h"
+#include "api/compute/compute_kernel_api.h"
+
+// One activation tile row times this core's weight columns. Each output group
+// accumulates the full K reduction in FP32 DST before packing. The activation
+// stays resident, so later groups reuse it without another transfer.
+void kernel_main() {
+    const uint32_t count = get_arg_val<uint32_t>(0);
+
+    constexpr uint32_t Kt = get_named_compile_time_arg_val("Kt");
+    constexpr uint32_t kblock = get_named_compile_time_arg_val("kblock");
+    constexpr uint32_t group = get_named_compile_time_arg_val("group");
+    constexpr bool dual_noc = get_named_compile_time_arg_val("dual_noc");
+    constexpr uint32_t cb_in0 = get_named_compile_time_arg_val("cb_in0");
+    constexpr uint32_t cb_weights = get_named_compile_time_arg_val("cb_weights");
+    constexpr uint32_t cb_weights2 = get_named_compile_time_arg_val("cb_weights2");
+    constexpr uint32_t cb_out = get_named_compile_time_arg_val("cb_out");
+    constexpr uint32_t block_tiles = kblock * group;
+    static_assert(group > 0 && group <= 8, "output group must fit in FP32 DST");
+
+    compute_kernel_hw_startup<SrcOrder::Reverse>(cb_in0, cb_weights, cb_out);
+    matmul_block_init(cb_in0, cb_weights, 0, 1, 1, kblock);
+    uint32_t in0_ready = 0;
+    uint32_t index = 0;
+    for (uint32_t group_start = 0; group_start < count; group_start += group) {
+        const uint32_t width = count - group_start < group ? count - group_start : group;
+        tile_regs_acquire();
+        for (uint32_t k0 = 0; k0 < Kt; k0 += kblock, ++index) {
+            const uint32_t cb_block = (dual_noc && (index & 1)) ? cb_weights2 : cb_weights;
+            if (in0_ready < k0 + kblock) {
+                in0_ready = k0 + kblock;
+                cb_wait_front(cb_in0, in0_ready);
+            }
+            cb_wait_front(cb_block, block_tiles);
+            for (uint32_t k = 0; k < kblock; ++k) {
+                for (uint32_t n = 0; n < width; ++n) {
+                    matmul_block(cb_in0, cb_block, k0 + k, k * width + n, n, /*transpose=*/0, 1, 1, kblock);
+                }
+            }
+            cb_pop_front(cb_block, block_tiles);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        cb_reserve_back(cb_out, width);
+        for (uint32_t n = 0; n < width; ++n) {
+            pack_tile(n, cb_out);
+        }
+        cb_push_back(cb_out, width);
+        tile_regs_release();
+    }
+    cb_pop_front(cb_in0, Kt);
+}
