+ProgramDescriptor MatmulDecodeStreamProgramFactory::create_descriptor(
+    const ttnn::prim::MatmulParams& operation_attributes,
+    const ttnn::prim::MatmulInputs& tensor_args,
+    std::vector<ttnn::Tensor>& tensor_return_value,
+    const std::optional<CoreRangeSet>& /*core_range_set*/) {
+    const auto& a = tensor_args.input_tensors.at(0).mesh_tensor();
+    const auto& b = tensor_args.input_tensors.at(1).mesh_tensor();
+    const auto& output = tensor_return_value.at(0).mesh_tensor();
+    auto* device = &a.mutable_device();
+
+    const uint32_t Kt = a.padded_shape()[-1] / TILE_WIDTH;
+    const uint32_t Nt = b.padded_shape()[-1] / TILE_WIDTH;
+    const auto grid = device->compute_with_storage_grid_size();
+    const uint32_t grid_x = grid.x;
+    const uint32_t max_cores = grid.x * grid.y;
+
+    // Prefer an even split of output tiles; otherwise use every core and let
+    // per-core counts differ by one.
+    uint32_t num_cores = std::min(max_cores, Nt);
+    for (uint32_t c = num_cores; c * 10 >= max_cores * 7; --c) {
+        if (Nt % c == 0) {
+            num_cores = c;
+            break;
+        }
+    }
+    const uint32_t max_count = tt::div_up(Nt, num_cores);
+    const uint32_t groups = tt::div_up(max_count, 8u);
+    const uint32_t group = tt::div_up(max_count, groups);
+    uint32_t kblock = 8;
+    while (kblock > 1 && (Kt % kblock != 0 || kblock * group > 16)) {
+        kblock /= 2;
+    }
+    uint32_t in0_mcast_w = 8;
+    while (Kt % in0_mcast_w != 0) {
+        in0_mcast_w /= 2;
+    }
+    constexpr uint32_t dual_noc = 1;
+    constexpr uint32_t in1_buffers = 2;
+    TT_FATAL(Kt % kblock == 0, "Decode stream K block must divide K");
+    const uint32_t block_tiles = kblock * group;
+
+    const uint32_t full_rows = num_cores / grid_x;
+    const uint32_t last_row = num_cores % grid_x;
+    TT_FATAL(full_rows > 0 && full_rows + (last_row ? 1 : 0) <= grid.y, "Decode stream needs a full core row");
+    std::vector<CoreRange> ranges{CoreRange(CoreCoord(0, 0), CoreCoord(grid_x - 1, full_rows - 1))};
+    if (last_row) {
+        ranges.emplace_back(CoreCoord(0, full_rows), CoreCoord(last_row - 1, full_rows));
+    }
+    const CoreRangeSet compute_cores(ranges);
+    // When the compute cores leave the last grid row free, feed the multicast
+    // from idle cores there so no compute core also carries the activation.
+    const bool dedicated_senders = full_rows + (last_row ? 1 : 0) < grid.y && grid_x >= 2;
+    std::vector<CoreCoord> senders{dedicated_senders ? CoreCoord(0, grid.y - 1) : CoreCoord(0, 0)};
+    if (last_row) {
+        senders.push_back(dedicated_senders ? CoreCoord(1, grid.y - 1) : CoreCoord(0, full_rows));
+    }
+    std::vector<CoreRange> sender_ranges;
+    for (const auto& sender : senders) {
+        sender_ranges.emplace_back(sender, sender);
+    }
+    const CoreRangeSet all_cores =
+        dedicated_senders ? compute_cores.merge(CoreRangeSet(sender_ranges)) : compute_cores;
+
+    const auto in0_format = tt_metal::datatype_to_dataformat_converter(a.dtype());
+    const auto in1_format = tt_metal::datatype_to_dataformat_converter(b.dtype());
+    const auto output_format = tt_metal::datatype_to_dataformat_converter(output.dtype());
+    ProgramDescriptor desc;
+    auto add_cb = [&](uint32_t index, uint32_t tiles, tt::DataFormat format) {
+        const uint32_t page_size = tt::tile_size(format);
+        desc.cbs.push_back(CBDescriptor{
+            .total_size = tiles * page_size,
+            .core_ranges = all_cores,
+            .format_descriptors = {{CBFormatDescriptor{
+                .buffer_index = index, .data_format = format, .page_size = page_size}}},
+        });
+    };
+    add_cb(tt::CBIndex::c_0, Kt, in0_format);
+    add_cb(tt::CBIndex::c_1, in1_buffers * block_tiles, in1_format);
+    add_cb(tt::CBIndex::c_2, in1_buffers * block_tiles, in1_format);
+    add_cb(tt::CBIndex::c_16, max_count, output_format);
+
+    constexpr uint32_t sender_sem_id = 0;
+    constexpr uint32_t receiver_sem_id = 1;
+    desc.semaphores.push_back(tt::tt_metal::SemaphoreDescriptor{
+        .id = sender_sem_id, .core_ranges = all_cores, .initial_value = 0});
+    desc.semaphores.push_back(tt::tt_metal::SemaphoreDescriptor{
+        .id = receiver_sem_id, .core_ranges = all_cores, .initial_value = 0});
+
+    const auto in0_noc = tt::tt_metal::detail::preferred_noc_for_dram_write(device->arch());
+    const auto in1_noc = tt::tt_metal::detail::preferred_noc_for_dram_read(device->arch());
+    const std::vector<std::pair<std::string, uint32_t>> common_args = {
+        {"cb_in0", tt::CBIndex::c_0},
+        {"cb_weights", tt::CBIndex::c_1},
+        {"cb_weights2", tt::CBIndex::c_2},
+        {"cb_out", tt::CBIndex::c_16},
+        {"Kt", Kt},
+        {"Nt", Nt},
+        {"kblock", kblock},
+        {"group", group},
+        {"in0_mcast_w", in0_mcast_w},
+        {"dual_noc", dual_noc},
+        {"sender_sem", sender_sem_id},
+        {"receiver_sem", receiver_sem_id},
+    };
+    auto make_kernel = [&](const char* source, CoreRangeSet cores, std::vector<uint32_t> compile_args,
+                           tt_metal::DataMovementProcessor processor, tt::tt_metal::NOC noc) {
+        KernelDescriptor kernel;
+        kernel.kernel_source = source;
+        kernel.source_type = KernelDescriptor::SourceType::FILE_PATH;
+        kernel.core_ranges = std::move(cores);
+        kernel.compile_time_args = std::move(compile_args);
+        kernel.named_compile_time_args = common_args;
+        kernel.config = tt::tt_metal::DataMovementConfigDescriptor{.processor = processor, .noc = noc};
+        return kernel;
+    };
+
+    std::vector<uint32_t> reader_args;
+    tt::tt_metal::TensorAccessorArgs(b).append_to(reader_args);
+    tt::tt_metal::TensorAccessorArgs(output).append_to(reader_args);
+    std::vector<uint32_t> sender_args;
+    tt::tt_metal::TensorAccessorArgs(a).append_to(sender_args);
+    tt::tt_metal::TensorAccessorArgs(b).append_to(sender_args);
+    std::vector<uint32_t> receiver_args;
+    tt::tt_metal::TensorAccessorArgs(b).append_to(receiver_args);
+
+    // One multicast group per rectangle of compute cores.
+    std::vector<CoreRange> receiver_ranges;
+    if (dedicated_senders) {
+        receiver_ranges = ranges;
+    } else if (grid_x > 1) {
+        receiver_ranges.emplace_back(CoreCoord(1, 0), CoreCoord(grid_x - 1, 0));
+    }
+    if (!dedicated_senders && full_rows > 1) {
+        receiver_ranges.emplace_back(CoreCoord(0, 1), CoreCoord(grid_x - 1, full_rows - 1));
+    }
+    if (!dedicated_senders && last_row > 1) {
+        receiver_ranges.emplace_back(CoreCoord(1, full_rows), CoreCoord(last_row - 1, full_rows));
+    }
+    auto reader = make_kernel(
+        "ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/reader_decode_stream.cpp", compute_cores, reader_args,
+        tt_metal::DataMovementProcessor::RISCV_0, in1_noc);
+    auto sender = make_kernel(
+        "ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_sender.cpp",
+        CoreRangeSet(sender_ranges), sender_args, tt_metal::DataMovementProcessor::RISCV_1, in0_noc);
+    auto receiver = make_kernel(
+        "ttnn/cpp/ttnn/operations/matmul/device/kernels/dataflow/decode_stream_in0_receiver.cpp",
+        CoreRangeSet(receiver_ranges), receiver_args, tt_metal::DataMovementProcessor::RISCV_1, in0_noc);
+
+    TT_FATAL(operation_attributes.compute_kernel_config.has_value(), "Decode stream compute config is required");
+    auto [math_fidelity, math_approx_mode, fp32_dest_acc_en, packer_l1_acc, dst_full_sync_en] =
+        get_compute_kernel_config_args(device->arch(), operation_attributes.compute_kernel_config.value());
+    KernelDescriptor compute;
+    compute.kernel_source = "ttnn/cpp/ttnn/operations/matmul/device/kernels/compute/decode_stream.cpp";
+    compute.source_type = KernelDescriptor::SourceType::FILE_PATH;
+    compute.core_ranges = compute_cores;
+    compute.named_compile_time_args = common_args;
+    compute.config = ComputeConfigDescriptor{
+        .math_fidelity = math_fidelity,
+        .fp32_dest_acc_en = true,
+        .dst_full_sync_en = true,
+        .math_approx_mode = math_approx_mode};
+
+    const uint32_t base_count = Nt / num_cores;
+    const uint32_t extra = Nt % num_cores;
+    auto add_sender = [&](const CoreCoord& core, bool group0, uint32_t n_start, uint32_t count) {
+        auto start = device->worker_core_from_logical_core(group0 ? CoreCoord(0, 0) : CoreCoord(0, full_rows));
+        auto end = device->worker_core_from_logical_core(
+            group0 ? CoreCoord(grid_x - 1, full_rows - 1) : CoreCoord(last_row - 1, full_rows));
+        if (in0_noc == tt::tt_metal::NOC::NOC_1) {
+            std::swap(start, end);
+        }
+        const uint32_t num_dests = (group0 ? grid_x * full_rows : last_row) - (dedicated_senders ? 0 : 1);
+        sender.emplace_runtime_args(
+            core,
+            {a,
+             static_cast<uint32_t>(start.x),
+             static_cast<uint32_t>(start.y),
+             static_cast<uint32_t>(end.x),
+             static_cast<uint32_t>(end.y),
+             num_dests,
+             b,
+             n_start,
+             count});
+    };
+    if (dedicated_senders) {
+        for (uint32_t g = 0; g < senders.size(); ++g) {
+            add_sender(senders[g], g == 0, 0, 0);
+        }
+    }
+    uint32_t n_start = 0;
+    for (uint32_t i = 0; i < num_cores; ++i) {
+        const CoreCoord core{i % grid_x, i / grid_x};
+        const uint32_t count = base_count + (i < extra ? 1 : 0);
+        reader.emplace_runtime_args(core, {b, output, n_start, count});
+        compute.emplace_runtime_args(core, {count});
+        const bool group0 = core.y < full_rows;
+        const CoreCoord group_sender = group0 ? senders[0] : senders[1];
+        if (core == group_sender) {
+            add_sender(core, group0, n_start, count);
+        } else {
+            const auto sender_physical = device->worker_core_from_logical_core(group_sender);
+            receiver.emplace_runtime_args(
+                core,
+                {static_cast<uint32_t>(sender_physical.x),
+                 static_cast<uint32_t>(sender_physical.y),
+                 b,
+                 n_start,
+                 count});
+        }
+        n_start += count;
+    }
+    desc.kernels.push_back(std::move(reader));
+    desc.kernels.push_back(std::move(sender));
+    if (!receiver_ranges.empty()) {
+        desc.kernels.push_back(std::move(receiver));
+    }
+    desc.kernels.push_back(std::move(compute));
+    return desc;
+}
+
 }  // namespace ttnn::prim
