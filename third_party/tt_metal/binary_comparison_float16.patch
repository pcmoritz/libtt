+inline void calculate_binary_comp_bfloat16(
+    const uint dst_index_in0, const uint dst_index_in1, const uint dst_index_out) {
+    calculate_binary_comp_narrow<32, APPROXIMATION_MODE, ITERATIONS, RELATIONAL_OP>(
+        dst_index_in0, dst_index_in1, dst_index_out);
+}
