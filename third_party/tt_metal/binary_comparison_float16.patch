+            v_endif;
+        } else if constexpr (RELATIONAL_OP == SfpuType::gt) {
+            v_if((abs_a_bits <= infinity_bits) && (abs_b_bits <= infinity_bits) && (magnitude_bits != 0U) &&
+                 (a_bits != b_bits) && (a > b)) {
+                result = 1.0f;
+            }
+            v_endif;
+        } else if constexpr (RELATIONAL_OP == SfpuType::le) {
+            v_if((abs_a_bits <= infinity_bits) && (abs_b_bits <= infinity_bits) &&
+                 ((magnitude_bits == 0U) || (a <= b))) {
+                result = 1.0f;
+            }
+            v_endif;
+        } else if constexpr (RELATIONAL_OP == SfpuType::ge) {
+            v_if((abs_a_bits <= infinity_bits) && (abs_b_bits <= infinity_bits) &&
+                 ((magnitude_bits == 0U) || (a >= b))) {
+                result = 1.0f;
+            }
+            v_endif;
+        }
+
+        sfpi::dst_reg[dst_index_out * DST_TILE_SIZE_SFPI] = result;
+        sfpi::dst_reg++;
+    }
+}
