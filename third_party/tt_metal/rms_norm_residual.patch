+#include "ttnn/tensor/tensor.hpp"
+
+namespace ttnn::normalization {
+
+// The residual add and RMS normalization of a decode step in one program, for
+// one tile row [B <= 32, W] of activations: returns {norm, sum} with
+// sum = input + residual and
+// norm = sum / sqrt(mean(sum^2) + epsilon) * (weight + weight_offset).
+// sum is the residual stream of the next layer, and norm its input.
+//
+// With a float8_type (FP8_E4M3 or FP8_E5M2, for a BFLOAT16 input), also
+// returns {q, scale} of the norm, equal bit for bit to
+// ttnn::experimental::quantize_rows(norm, *float8_type, min_scale): the
+// activations of a float8 linear that reads the norm.
+std::vector<Tensor> rms_norm_residual(
+    const Tensor& input,
+    const Tensor& residual,
+    const Tensor& weight,
+    float epsilon,
+    float weight_offset = 0.0f,
+    std::optional<tt::tt_metal::DataType> float8_type = std::nullopt,
+    float min_scale = 0.0f);
+
+}  // namespace ttnn::normalization
