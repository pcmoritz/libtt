+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/compute/rms_norm_residual.cpp
@@ -0,0 +1,309 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/binop_with_scalar.h"
+#include "api/compute/eltwise_unary/rsqrt.h"
+#include "api/compute/matmul.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/reduce.h"
+#include "api/compute/tile_move_copy.h"
+#include "ttnn/cpp/ttnn/operations/experimental/quantize_rows/device/kernels/compute/quantize_rows_sfpu.h"
+
+#ifdef TRISC_MATH
+#include "ckernel_sfpu_conversions.h"
+
+namespace ckernel::sfpu {
+// out = in0 + in1 over ITERATIONS SFPU rows of a DST face: added in FP32 and
+// rounded to nearest even at BF16 precision, so that packing the sum to BF16
+// keeps it unchanged. add_binary_tile's NearestEven option does nothing with
+// FP32 DST accumulation.
+template <int ITERATIONS>
+inline void add_round_to_bf16(uint32_t in0, uint32_t in1, uint32_t out) {
+    // A DST tile is 32 SFPU rows.
+    constexpr uint32_t tile = 32;
+#pragma GCC unroll 0
+    for (int d = 0; d < ITERATIONS; ++d) {
+        const sfpi::vFloat sum = sfpi::dst_reg[in0 * tile] + sfpi::vFloat(sfpi::dst_reg[in1 * tile]);
+        sfpi::dst_reg[out * tile] = float32_to_bf16_rne(sum);
+        sfpi::dst_reg++;
+    }
+}
+}  // namespace ckernel::sfpu
+#endif
+
+// sum = input + residual for this core's tiles. The rows' sums of squares
+// over those tiles are the diagonal of sum * sum^T, a tile the writer takes
+// them from to gather on the first core, one column per core; that core
+// sums the rows, turns them into rsqrt(mean + eps), and the writer
+// multicasts the column. norm = sum * weight * rstd.
+//
+// With `quantize`, also the norm's float8 codes as quantize_rows makes them
+// from the BF16 norm (quantize_rows_sfpu.h): each core's row maxima go to the
+// first core, which makes the divisor tile for the writer to multicast, and
+// every core divides its norm tiles by it and converts them.
+void kernel_main() {
+    const uint32_t count = get_arg_val<uint32_t>(0);
+    const bool first = get_arg_val<uint32_t>(1) != 0;
+
+    constexpr uint32_t cb_input = get_named_compile_time_arg_val("cb_input");
+    constexpr uint32_t cb_residual = get_named_compile_time_arg_val("cb_residual");
+    constexpr uint32_t cb_weight = get_named_compile_time_arg_val("cb_weight");
+    constexpr uint32_t cb_sum = get_named_compile_time_arg_val("cb_sum");
+    constexpr uint32_t cb_sum_out = get_named_compile_time_arg_val("cb_sum_out");
+    constexpr uint32_t cb_scaled = get_named_compile_time_arg_val("cb_scaled");
+    constexpr uint32_t cb_scaler = get_named_compile_time_arg_val("cb_scaler");
+    constexpr uint32_t cb_partial = get_named_compile_time_arg_val("cb_partial");
+    constexpr uint32_t cb_exchange = get_named_compile_time_arg_val("cb_exchange");
+    constexpr uint32_t cb_rstd = get_named_compile_time_arg_val("cb_rstd");
+    constexpr uint32_t cb_norm = get_named_compile_time_arg_val("cb_norm");
+    constexpr uint32_t cb_weight_offset = get_named_compile_time_arg_val("cb_weight_offset");
+    constexpr uint32_t rows = get_named_compile_time_arg_val("rows");
+    constexpr uint32_t eps = get_named_compile_time_arg_val("eps");
+    constexpr uint32_t inv_width = get_named_compile_time_arg_val("inv_width");
+    constexpr uint32_t weight_offset = get_named_compile_time_arg_val("weight_offset");
+    constexpr uint32_t cb_amax = get_named_compile_time_arg_val("cb_amax");
+    constexpr uint32_t cb_gather = get_named_compile_time_arg_val("cb_gather");
+    constexpr uint32_t cb_divisor = get_named_compile_time_arg_val("cb_divisor");
+    constexpr uint32_t cb_q = get_named_compile_time_arg_val("cb_q");
+    constexpr uint32_t num_cores = get_named_compile_time_arg_val("num_cores");
+    constexpr bool quantize = get_named_compile_time_arg_val("quantize") != 0;
+    constexpr uint32_t stride = get_named_compile_time_arg_val("stride");
+    constexpr uint32_t gather_tiles = get_named_compile_time_arg_val("gather_tiles");
+    constexpr bool e5m2 = get_named_compile_time_arg_val("e5m2") != 0;
+    constexpr uint32_t fp8_max_bits = get_named_compile_time_arg_val("fp8_max_bits");
+    constexpr uint32_t min_scale_bits = get_named_compile_time_arg_val("min_scale_bits");
+
+    // DST holds four FP32 tiles per acquire.
+    constexpr uint32_t batch = 4;
+    // Pack DST tiles 0..n-1 to `cb` as its tiles first..first+n-1.
+    auto pack_block = [&](uint32_t cb, uint32_t first_tile, uint32_t n) {
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_reconfig_data_format(cb);
+        for (uint32_t j = 0; j < n; ++j) {
+            pack_tile(j, cb, first_tile + j);
+        }
+        tile_regs_release();
+    };
+
+    // sum = input + residual, once for the writer and once to normalize. The
+    // SFPU adds in FP32 and the sum is rounded to nearest even, as a BF16 add
+    // rounds on the CPU; the FPU's BF16 add rounds ties away from zero. DST
+    // holds four FP32 tiles: two sums with their second operands.
+    compute_kernel_hw_startup(cb_input, cb_residual, cb_sum);
+    cb_wait_front(cb_input, count);
+    cb_wait_front(cb_residual, count);
+    cb_reserve_back(cb_sum, count);
+    cb_reserve_back(cb_sum_out, count);
+    // An SFPU iteration covers eight columns of four rows of a face, so the
+    // add covers just the input's rows, in the top faces for up to 16 rows;
+    // the other rows keep the input's padding.
+    constexpr int add_iterations = rows <= 16 ? (rows + 3) / 4 * 2 : 8;
+    constexpr VectorMode add_mode = rows <= 16 ? VectorMode::R : VectorMode::RC;
+    constexpr uint32_t pairs = batch / 2;
+    // The input and residual have one format, and the SFPU add keeps clear of
+    // the copy's address modifiers, so both are set up once.
+    copy_init(cb_input);
+    add_binary_tile_init();
+    for (uint32_t b = 0; b < count; b += pairs) {
+        const uint32_t n = count - b < pairs ? count - b : pairs;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            copy_tile(cb_input, b + j, 2 * j);
+            copy_tile(cb_residual, b + j, 2 * j + 1);
+        }
+        for (uint32_t j = 0; j < n; ++j) {
+            MATH((SFPU_BINARY_CALL(
+                DST_SYNC_MODE, DST_ACCUM_MODE, add_round_to_bf16, (add_iterations), 2 * j, 2 * j + 1, 2 * j,
+                add_mode)));
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        for (uint32_t j = 0; j < n; ++j) {
+            pack_tile(2 * j, cb_sum, b + j);
+            pack_tile(2 * j, cb_sum_out, b + j);
+        }
+        tile_regs_release();
+    }
+    cb_push_back(cb_sum, count);
+    cb_push_back(cb_sum_out, count);
+    cb_pop_front(cb_input, count);
+    cb_pop_front(cb_residual, count);
+
+    // partial = sum * sum^T over this core's tiles: its diagonal holds every
+    // row's sum of squares.
+    cb_wait_front(cb_sum, count);
+    cb_reserve_back(cb_partial, 1);
+    reconfig_data_format(cb_sum, cb_sum);
+    matmul_init(cb_sum, cb_sum, /*transpose=*/1);
+    tile_regs_acquire();
+    for (uint32_t i = 0; i < count; ++i) {
+        matmul_tiles(cb_sum, cb_sum, i, i, 0);
+    }
+    pack_block(cb_partial, 0, 1);
+    cb_push_back(cb_partial, 1);
+
+    // scaled = sum * (weight + weight_offset) (one per column) needs nothing
+    // from the other cores, so it is done while their sums are gathered.
+    // Zero-centered weights have an offset of 1, added in FP32 first.
+    cb_wait_front(cb_weight, count);
+    uint32_t cb_scale = cb_weight;
+    if constexpr (weight_offset != 0) {
+        cb_reserve_back(cb_weight_offset, count);
+        reconfig_data_format_srca(cb_weight);
+        copy_init(cb_weight);
+        binop_with_scalar_tile_init();
+        for (uint32_t b = 0; b < count; b += batch) {
+            const uint32_t n = count - b < batch ? count - b : batch;
+            tile_regs_acquire();
+            for (uint32_t j = 0; j < n; ++j) {
+                copy_tile(cb_weight, b + j, j);
+                add_unary_tile(j, weight_offset);
+            }
+            pack_block(cb_weight_offset, b, n);
+        }
+        cb_push_back(cb_weight_offset, count);
+        cb_wait_front(cb_weight_offset, count);
+        cb_scale = cb_weight_offset;
+    }
+    cb_reserve_back(cb_scaled, count);
+    reconfig_data_format(cb_sum, cb_scale);
+    mul_bcast_rows_init_short(cb_sum, cb_scale);
+    for (uint32_t b = 0; b < count; b += batch) {
+        const uint32_t n = count - b < batch ? count - b : batch;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            mul_tiles_bcast_rows(cb_sum, cb_scale, b + j, b + j, j);
+        }
+        pack_block(cb_scaled, b, n);
+    }
+    cb_push_back(cb_scaled, count);
+    cb_pop_front(cb_weight, count);
+    if constexpr (weight_offset != 0) {
+        cb_pop_front(cb_weight_offset, count);
+    }
+    cb_pop_front(cb_sum, count);
+
+    if (first) {
+        // The exchange tile holds every core's sums of squares, one column
+        // per core and one row per row; their row sums are the whole width's.
+        cb_wait_front(cb_exchange, 1);
+        cb_wait_front(cb_scaler, 1);
+        cb_reserve_back(cb_rstd, 1);
+        cb_reserve_back(cb_partial, 1);
+        // A row reduce unpacks the scaler first; set the formats in that order.
+        reconfig_data_format(cb_scaler, cb_exchange);
+        reduce_init<PoolType::SUM, ReduceDim::REDUCE_ROW>(cb_exchange, cb_scaler, cb_rstd);
+        tile_regs_acquire();
+        reduce_tile<PoolType::SUM, ReduceDim::REDUCE_ROW>(cb_exchange, cb_scaler, 0, 0, 0);
+        reduce_uninit(cb_exchange);
+        // rstd = rsqrt(sum / width + eps) down column 0: the SFPU's column
+        // mode covers faces 0 and 2, two rows per iteration.
+        constexpr int sfpu_iterations = rows < 16 ? (rows + 1) / 2 : 8;
+        binop_with_scalar_tile_init();
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_binop_with_scalar,
+            (APPROX, ckernel::sfpu::MUL, sfpu_iterations, DST_ACCUM_MODE), 0, VectorMode::C, inv_width));
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_binop_with_scalar,
+            (APPROX, ckernel::sfpu::ADD, sfpu_iterations, DST_ACCUM_MODE), 0, VectorMode::C, eps));
+        rsqrt_tile_init();
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_rsqrt,
+            (APPROX, sfpu_iterations, DST_ACCUM_MODE, false), 0, VectorMode::C));
+        // Once for this core, once for the writer to multicast.
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_reconfig_data_format(cb_rstd);
+        pack_tile(0, cb_rstd, 0);
+        pack_tile(0, cb_partial, 0);
+        tile_regs_release();
+        cb_push_back(cb_rstd, 1);
+        cb_push_back(cb_partial, 1);
+        cb_pop_front(cb_exchange, 1);
+    }
+    cb_wait_front(cb_scaler, 1);
+    cb_pop_front(cb_scaler, 1);
+
+    // norm = scaled * rstd (one per row)
+    cb_wait_front(cb_scaled, count);
+    cb_wait_front(cb_rstd, 1);
+    cb_reserve_back(cb_norm, count);
+    reconfig_data_format(cb_scaled, cb_rstd);
+    mul_bcast_cols_init_short(cb_scaled, cb_rstd);
+    for (uint32_t b = 0; b < count; b += batch) {
+        const uint32_t n = count - b < batch ? count - b : batch;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            mul_tiles_bcast_cols(cb_scaled, cb_rstd, b + j, 0, j);
+        }
+        pack_block(cb_norm, b, n);
+    }
+    cb_push_back(cb_norm, count);
+    cb_pop_front(cb_scaled, count);
+    cb_pop_front(cb_rstd, 1);
+    if constexpr (!quantize) {
+        return;
+    }
+
+    // This core's row maxima, from the norm's first `stride` rows: the
+    // writer pops the norm once the codes are out.
+    constexpr uint32_t groups = stride / 4;
+    cb_wait_front(cb_norm, count);
+    cb_reserve_back(cb_amax, 1);
+    reconfig_data_format_srca(cb_norm);
+    copy_init(cb_norm);
+    tile_regs_acquire();
+    qr::sfpu_init();
+    MATH((qr::zero_acc<groups, 0>()));
+    for (uint32_t i = 0; i < count; ++i) {
+        copy_tile(cb_norm, i, 1);
+        MATH((qr::fold_absmax<groups, 1, 0>(groups)));
+    }
+    MATH((qr::finish_partial<groups, 0>()));
+    pack_block(cb_amax, 0, 1);
+    cb_push_back(cb_amax, 1);
+
+    if (first) {
+        // The divisor from every core's maxima, once for this core and once
+        // for the writer to multicast and write as the scale.
+        cb_wait_front(cb_gather, gather_tiles);
+        cb_reserve_back(cb_divisor, 1);
+        cb_reserve_back(cb_amax, 1);
+        reconfig_data_format_srca(cb_gather);
+        tile_regs_acquire();
+        qr::make_divisor<groups, 0, 1, 2>(
+            cb_gather, gather_tiles, num_cores * groups, fp8_max_bits, min_scale_bits);
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_reconfig_data_format(cb_divisor);
+        pack_tile(0, cb_divisor, 0);
+        pack_tile(0, cb_amax, 0);
+        tile_regs_release();
+        cb_push_back(cb_divisor, 1);
+        cb_push_back(cb_amax, 1);
+        cb_pop_front(cb_gather, gather_tiles);
+    }
+
+    // The codes of the first `stride` rows, three norm tiles at a time beside
+    // the divisor in DST tile 3.
+    cb_wait_front(cb_divisor, 1);
+    cb_reserve_back(cb_q, count);
+    for (uint32_t b = 0; b < count; b += batch - 1) {
+        const uint32_t n = count - b < batch - 1 ? count - b : batch - 1;
+        tile_regs_acquire();
+        reconfig_data_format_srca(cb_divisor);
+        copy_init(cb_divisor);
+        copy_tile(cb_divisor, 0, 3);
+        reconfig_data_format_srca(cb_norm);
+        qr::quantize_tiles<e5m2, 3, 0, stride, rows>(cb_norm, b, n);
+        pack_block(cb_q, b, n);
+    }
+    cb_push_back(cb_q, count);
+    cb_pop_front(cb_divisor, 1);
+}
