+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/writer_rms_norm_residual.cpp
@@ -0,0 +1,216 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+
+// Writes the first `rows` rows of this core's sum and norm tiles, and
+// exchanges the rows' sums of squares through the first core. That core
+// zeroes its exchange tile and tells the others with the `cleared`
+// semaphore (zeroing only the columns past the cores would avoid the
+// handshake, but one store at a time it costs 6 us for 32 rows on 5 cores,
+// while the handshake costs nothing measurable); every core then writes its
+// rows' sums, the diagonal of its partial tile, into column `worker` of the
+// exchange tile and counts itself in on the `written` semaphore; the first
+// core multicasts the rstd column into every other core's rstd buffer and
+// sets their `valid` semaphore. The buffers have the same address on every
+// core.
+//
+// With `quantize`, a second exchange the same way: every core writes its row
+// maxima into slot `worker` of the first core's gather buffer and counts
+// itself in again; the first core multicasts the divisor tile its compute
+// kernel made from them, writes it as the scale, and every core writes its
+// float8 codes.
+void kernel_main() {
+    const uint32_t worker = get_arg_val<uint32_t>(0);
+    const uint32_t start = get_arg_val<uint32_t>(1);
+    const uint32_t count = get_arg_val<uint32_t>(2);
+    const uint32_t sum_addr = get_arg_val<uint32_t>(3);
+    const uint32_t norm_addr = get_arg_val<uint32_t>(4);
+    const uint32_t gather_x = get_arg_val<uint32_t>(5);
+    const uint32_t gather_y = get_arg_val<uint32_t>(6);
+    // Two multicast rectangles (x0, y0, x1, y1, destinations), the second one
+    // possibly empty: the full rows of cores and the partial last row.
+    constexpr uint32_t rectangles_arg = 7;
+    const uint32_t q_addr = get_arg_val<uint32_t>(17);
+    const uint32_t scale_addr = get_arg_val<uint32_t>(18);
+
+    constexpr uint32_t cb_sum_out = get_named_compile_time_arg_val("cb_sum_out");
+    constexpr uint32_t cb_partial = get_named_compile_time_arg_val("cb_partial");
+    constexpr uint32_t cb_exchange = get_named_compile_time_arg_val("cb_exchange");
+    constexpr uint32_t cb_rstd = get_named_compile_time_arg_val("cb_rstd");
+    constexpr uint32_t cb_norm = get_named_compile_time_arg_val("cb_norm");
+    constexpr uint32_t num_cores = get_named_compile_time_arg_val("num_cores");
+    constexpr uint32_t rows = get_named_compile_time_arg_val("rows");
+    constexpr uint32_t valid_sem = get_named_compile_time_arg_val("valid_sem");
+    constexpr uint32_t written_sem = get_named_compile_time_arg_val("written_sem");
+    constexpr uint32_t cleared_sem = get_named_compile_time_arg_val("cleared_sem");
+    constexpr uint32_t cb_amax = get_named_compile_time_arg_val("cb_amax");
+    constexpr uint32_t cb_gather = get_named_compile_time_arg_val("cb_gather");
+    constexpr uint32_t cb_divisor = get_named_compile_time_arg_val("cb_divisor");
+    constexpr uint32_t cb_q = get_named_compile_time_arg_val("cb_q");
+    constexpr bool quantize = get_named_compile_time_arg_val("quantize") != 0;
+    constexpr uint32_t stride = get_named_compile_time_arg_val("stride");
+    constexpr uint32_t gather_tiles = get_named_compile_time_arg_val("gather_tiles");
+    constexpr auto sum_args = TensorAccessorArgs<0>();
+    constexpr auto norm_args = TensorAccessorArgs<sum_args.next_compile_time_args_offset()>();
+    constexpr auto q_args = TensorAccessorArgs<norm_args.next_compile_time_args_offset()>();
+    constexpr auto scale_args = TensorAccessorArgs<q_args.next_compile_time_args_offset()>();
+    const auto sum = TensorAccessor(sum_args, sum_addr, get_tile_size(cb_sum_out));
+    const auto norm = TensorAccessor(norm_args, norm_addr, get_tile_size(cb_norm));
+    constexpr uint32_t f32_tile_bytes = 4096;
+    const auto q = TensorAccessor(q_args, q_addr, get_tile_size(cb_q));
+    const auto scale = TensorAccessor(scale_args, scale_addr, f32_tile_bytes);
+    const uint32_t valid_addr = get_semaphore(valid_sem);
+    const uint32_t written_addr = get_semaphore(written_sem);
+    const uint32_t cleared_addr = get_semaphore(cleared_sem);
+    volatile tt_l1_ptr uint32_t* valid = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(valid_addr);
+    volatile tt_l1_ptr uint32_t* written = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(written_addr);
+    volatile tt_l1_ptr uint32_t* cleared = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(cleared_addr);
+    auto rectangle = [&](uint32_t r, uint32_t field) { return get_arg_val<uint32_t>(rectangles_arg + 5 * r + field); };
+    // `source` of the first core goes to `address` on every other core.
+    auto multicast = [&](uint32_t source, uint32_t address, uint32_t bytes, uint32_t sem_addr) {
+        for (uint32_t r = 0; r < 2; ++r) {
+            const uint32_t dests = rectangle(r, 4);
+            if (dests == 0) {
+                continue;
+            }
+            const uint32_t x0 = rectangle(r, 0), y0 = rectangle(r, 1), x1 = rectangle(r, 2), y1 = rectangle(r, 3);
+            if (bytes > 0) {
+                noc_async_write_multicast(source, get_noc_multicast_addr(x0, y0, x1, y1, address), bytes, dests, true);
+#ifdef ARCH_BLACKHOLE
+                noc_async_writes_flushed();
+#endif
+            }
+            noc_semaphore_set_multicast(sem_addr, get_noc_multicast_addr(x0, y0, x1, y1, sem_addr), dests);
+        }
+    };
+    auto write_rows = [&](const auto& tensor, uint32_t tile, uint32_t cb, uint32_t num_rows) {
+        const uint64_t dest = tensor.get_noc_addr(start + tile);
+        const uint32_t source = get_read_ptr(cb) + tile * get_tile_size(cb);
+        const uint32_t face_bytes = get_tile_size(cb) / 4;
+        const uint32_t row_bytes = face_bytes / 16;
+        const uint32_t first = num_rows < 16 ? num_rows : 16;
+        for (uint32_t face = 0; face < 2; ++face) {
+            noc_async_write(source + face * face_bytes, dest + face * face_bytes, first * row_bytes);
+        }
+        if (num_rows > 16) {
+            for (uint32_t face = 2; face < 4; ++face) {
+                noc_async_write(source + face * face_bytes, dest + face * face_bytes, (num_rows - 16) * row_bytes);
+            }
+        }
+    };
+
+    // The exchange tile has the same address on every core; only the first
+    // core's is written, after it zeroed it.
+    const uint32_t exchange = get_write_ptr(cb_exchange);
+    if (worker == 0) {
+        cb_reserve_back(cb_exchange, 1);
+        {
+            Noc noc;
+            CircularBuffer cb(cb_exchange);
+            noc.async_write_zeros(cb, 4096);
+            noc.write_zeros_l1_barrier();
+        }
+        *cleared = 1;
+        multicast(0, 0, 0, cleared_addr);
+    }
+
+    cb_wait_front(cb_sum_out, count);
+    for (uint32_t i = 0; i < count; ++i) {
+        write_rows(sum, i, cb_sum_out, rows);
+    }
+
+    // Element (r, r) of the partial tile goes to element (r, worker) of the
+    // exchange tile. In a 32x32 FP32 tile, element (r, c) is in face
+    // (r / 16) * 2 + c / 16 at row r % 16, column c % 16.
+    cb_wait_front(cb_partial, 1);
+    const uint32_t partial = get_read_ptr(cb_partial);
+    if (worker != 0) {
+        noc_semaphore_wait(cleared, 1);
+        *cleared = 0;
+    }
+    for (uint32_t r = 0; r < rows; ++r) {
+        const uint32_t value = *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            partial + ((r / 16) * 3) * 1024 + (r % 16) * 64 + (r % 16) * 4);
+        const uint32_t dest = exchange + ((r / 16) * 2 + worker / 16) * 1024 + (r % 16) * 64 + (worker % 16) * 4;
+        noc_inline_dw_write(get_noc_addr(gather_x, gather_y, dest), value);
+    }
+    noc_async_write_barrier();
+    noc_semaphore_inc(get_noc_addr(gather_x, gather_y, written_addr), 1);
+    cb_pop_front(cb_partial, 1);
+
+    if (worker == 0) {
+        noc_semaphore_wait_min(written, num_cores);
+        cb_push_back(cb_exchange, 1);
+        // The rstd column from the compute kernel goes to every other core.
+        cb_wait_front(cb_partial, 1);
+        *valid = 1;
+        multicast(get_read_ptr(cb_partial), get_write_ptr(cb_rstd), get_tile_size(cb_rstd), valid_addr);
+        noc_async_write_barrier();
+        cb_pop_front(cb_partial, 1);
+    } else {
+        cb_reserve_back(cb_rstd, 1);
+        noc_semaphore_wait(valid, 1);
+        *valid = 0;
+        cb_push_back(cb_rstd, 1);
+    }
+
+    cb_wait_front(cb_norm, count);
+    for (uint32_t i = 0; i < count; ++i) {
+        write_rows(norm, i, cb_norm, rows);
+    }
+
+    if constexpr (quantize) {
+        // Rows 0 .. stride - 1 of the left faces of the maxima tile (faces 0
+        // and 2), as quantize_rows lays out a core's slot.
+        constexpr uint32_t slot_bytes = stride * 64;
+        constexpr uint32_t pieces = stride <= 16 ? 1 : 2;
+        cb_wait_front(cb_amax, 1);
+        const uint32_t slot = get_write_ptr(cb_gather) + worker * slot_bytes;
+        for (uint32_t p = 0; p < pieces; ++p) {
+            noc_async_write(
+                get_read_ptr(cb_amax) + p * 2048,
+                get_noc_addr(gather_x, gather_y, slot + p * (slot_bytes / pieces)),
+                slot_bytes / pieces);
+        }
+        noc_async_write_barrier();
+        noc_semaphore_inc(get_noc_addr(gather_x, gather_y, written_addr), 1);
+        cb_pop_front(cb_amax, 1);
+
+        if (worker == 0) {
+            cb_reserve_back(cb_gather, gather_tiles);
+            noc_semaphore_wait_min(written, 2 * num_cores);
+            cb_push_back(cb_gather, gather_tiles);
+            // The divisor tile goes to every other core, and is the scale
+            // output: row m holds scale[m] in every column.
+            cb_wait_front(cb_amax, 1);
+            *valid = 1;
+            multicast(get_read_ptr(cb_amax), get_write_ptr(cb_divisor), f32_tile_bytes, valid_addr);
+            noc_async_write(get_read_ptr(cb_amax), scale.get_noc_addr(0), f32_tile_bytes);
+            noc_async_write_barrier();
+            cb_pop_front(cb_amax, 1);
+        } else {
+            cb_reserve_back(cb_divisor, 1);
+            noc_semaphore_wait(valid, 1);
+            *valid = 0;
+            cb_push_back(cb_divisor, 1);
+        }
+
+        // `stride` rows of codes, whole 64-byte words, as quantize_rows writes.
+        cb_wait_front(cb_q, count);
+        for (uint32_t i = 0; i < count; ++i) {
+            write_rows(q, i, cb_q, stride);
+        }
+    }
+    noc_async_write_barrier();
+    cb_pop_front(cb_sum_out, count);
+    cb_pop_front(cb_norm, count);
+    if constexpr (quantize) {
+        cb_pop_front(cb_q, count);
+    }
+    // No core signals the next launch before every core has finished this one.
+    *written = 0;
+}
diff --git ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/rms_norm_residual.cpp ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/rms_norm_residual.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/rms_norm_residual.cpp
@@ -0,0 +1,329 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include "ttnn/operations/normalization/rms_norm_residual/rms_norm_residual.hpp"
+
+#include <algorithm>
+#include <bit>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <tt-metalium/buffer.hpp>
+#include <tt-metalium/constants.hpp>
+#include <tt-metalium/program_descriptors.hpp>
+#include <tt-metalium/tensor_accessor_args.hpp>
+#include <tt-metalium/work_split.hpp>
+#include "ttnn/device.hpp"
+#include "ttnn/device_operation.hpp"
+#include "ttnn/tensor/tensor_ops.hpp"
+
+using namespace tt::tt_metal;
+using namespace tt::constants;
+
+namespace ttnn::prim {
+namespace {
+
+struct RMSNormResidualParams {
+    float epsilon = 1e-6f;
+    float weight_offset = 0.0f;
+    std::optional<DataType> float8_type;
+    float min_scale = 0.0f;
+};
+
+struct RMSNormResidualInputs {
+    Tensor input;
+    Tensor residual;
+    Tensor weight;
+};
+
+struct RMSNormResidualOperation {
+    using operation_attributes_t = RMSNormResidualParams;
+    using tensor_args_t = RMSNormResidualInputs;
+    using spec_return_value_t = std::vector<TensorSpec>;
+    using tensor_return_value_t = std::vector<Tensor>;
+
+    static ProgramDescriptor create_descriptor(
+        const operation_attributes_t&, const tensor_args_t&, tensor_return_value_t&);
+    static void validate_on_program_cache_miss(const operation_attributes_t&, const tensor_args_t&);
+    static spec_return_value_t compute_output_specs(const operation_attributes_t&, const tensor_args_t&);
+    static tensor_return_value_t create_output_tensors(const operation_attributes_t&, const tensor_args_t&);
+};
+
+// At most one exchange-tile row per core.
+constexpr uint32_t max_cores = 32;
+
+void validate_row(const Tensor& tensor, const char* name) {
+    TT_FATAL(tensor.storage_type() == StorageType::DEVICE, "{} must be on device", name);
+    TT_FATAL(tensor.buffer() != nullptr, "{} must be allocated", name);
+    TT_FATAL(tensor.layout() == Layout::TILE, "{} must use TILE layout", name);
+    TT_FATAL(
+        tensor.memory_config().buffer_type() == BufferType::DRAM &&
+            tensor.memory_config().memory_layout() == TensorMemoryLayout::INTERLEAVED,
+        "{} must be interleaved in DRAM", name);
+    TT_FATAL(
+        tensor.dtype() == DataType::BFLOAT16 || tensor.dtype() == DataType::FLOAT32,
+        "{} must be BFLOAT16 or FLOAT32", name);
+    TT_FATAL(tensor.tensor_spec().tile() == Tile(), "{} must use the default tile", name);
+}
+
+void RMSNormResidualOperation::validate_on_program_cache_miss(
+    const operation_attributes_t& params, const tensor_args_t& in) {
+    validate_row(in.input, "input");
+    validate_row(in.residual, "residual");
+    validate_row(in.weight, "weight");
+    const auto& shape = in.input.logical_shape();
+    TT_FATAL(shape.rank() == 2, "input must have rank 2, got {}", shape);
+    TT_FATAL(shape[0] > 0 && shape[0] <= TILE_HEIGHT, "input must be one tile row, got {} rows", shape[0]);
+    TT_FATAL(shape[1] > 0 && shape[1] % TILE_WIDTH == 0, "width {} must be a multiple of the tile width", shape[1]);
+    TT_FATAL(in.residual.logical_shape() == shape, "residual shape {} must match input shape {}",
+             in.residual.logical_shape(), shape);
+    TT_FATAL(in.residual.dtype() == in.input.dtype(), "residual dtype must match the input");
+    const auto& weight_shape = in.weight.logical_shape();
+    TT_FATAL(
+        weight_shape[-1] == shape[1] && weight_shape.volume() == shape[1],
+        "weight shape {} must be the row width {}", weight_shape, shape[1]);
+    if (params.float8_type) {
+        TT_FATAL(
+            *params.float8_type == DataType::FP8_E4M3 || *params.float8_type == DataType::FP8_E5M2,
+            "float8_type must be FP8_E4M3 or FP8_E5M2, got {}", *params.float8_type);
+        // The codes come from the norm's BF16 tiles through the FPU's
+        // source registers, which keep BF16 exact.
+        TT_FATAL(in.input.dtype() == DataType::BFLOAT16, "a float8 output needs a BFLOAT16 input");
+    }
+}
+
+RMSNormResidualOperation::spec_return_value_t RMSNormResidualOperation::compute_output_specs(
+    const operation_attributes_t& params, const tensor_args_t& in) {
+    spec_return_value_t specs = {in.input.tensor_spec(), in.input.tensor_spec()};
+    if (params.float8_type) {
+        const auto& shape = in.input.logical_shape();
+        auto layout = [&](DataType dtype) {
+            return TensorLayout(dtype, PageConfig(Layout::TILE), in.input.memory_config());
+        };
+        specs.emplace_back(shape, layout(*params.float8_type));
+        specs.emplace_back(ttnn::Shape({shape[0], 1}), layout(DataType::FLOAT32));
+    }
+    return specs;
+}
+
+RMSNormResidualOperation::tensor_return_value_t RMSNormResidualOperation::create_output_tensors(
+    const operation_attributes_t& params, const tensor_args_t& in) {
+    tensor_return_value_t outputs;
+    for (const auto& spec : compute_output_specs(params, in)) {
+        outputs.push_back(create_device_tensor(spec, in.input.device()));
+    }
+    return outputs;
+}
+
+ProgramDescriptor RMSNormResidualOperation::create_descriptor(
+    const operation_attributes_t& params, const tensor_args_t& in, tensor_return_value_t& outputs) {
+    const auto& input = in.input.mesh_tensor();
+    const auto& residual = in.residual.mesh_tensor();
+    const auto& weight = in.weight.mesh_tensor();
+    const auto& norm = outputs.at(0).mesh_tensor();
+    const auto& sum = outputs.at(1).mesh_tensor();
+    const bool quantize = params.float8_type.has_value();
+    // Without a float8 output the norm stands in for the unused codes and
+    // scale in the writer's arguments.
+    const auto& q = quantize ? outputs.at(2).mesh_tensor() : norm;
+    const auto& scale = quantize ? outputs.at(3).mesh_tensor() : norm;
+    auto* device = &input.mutable_device();
+
+    const uint32_t width = input.logical_shape()[1];
+    const uint32_t Wt = width / TILE_WIDTH;
+    const CoreCoord grid = device->compute_with_storage_grid_size();
+    const uint32_t num_cores = std::min({Wt, max_cores, static_cast<uint32_t>(grid.x * grid.y)});
+    // Cores are numbered row-major over the grid; the tiles are split as
+    // evenly as possible, the first `extra` cores taking one more.
+    auto core_at = [&](uint32_t i) { return CoreCoord(i % grid.x, i / grid.x); };
+    const CoreRangeSet cores = num_cores_to_corerangeset(num_cores, grid, /*row_wise=*/true);
+    const uint32_t base_count = Wt / num_cores;
+    const uint32_t extra = Wt % num_cores;
+    auto count_of = [&](uint32_t i) { return base_count + (i < extra ? 1 : 0); };
+    auto start_of = [&](uint32_t i) { return i * base_count + std::min(i, extra); };
+    const uint32_t max_count = count_of(0);
+
+    ProgramDescriptor program;
+    const auto row_format = datatype_to_dataformat_converter(input.dtype());
+    const auto weight_format = datatype_to_dataformat_converter(weight.dtype());
+    uint32_t cb_bytes = 0;
+    auto make_cb = [&](uint32_t index, uint32_t tiles, tt::DataFormat format) {
+        const uint32_t page_size = tt::tile_size(format);
+        cb_bytes += tiles * page_size;
+        program.cbs.push_back(CBDescriptor{
+            .total_size = tiles * page_size,
+            .core_ranges = cores,
+            .format_descriptors = {{CBFormatDescriptor{
+                .buffer_index = static_cast<uint8_t>(index), .data_format = format, .page_size = page_size}}}});
+    };
+    make_cb(0, max_count, row_format);              // input tiles
+    make_cb(1, max_count, row_format);              // residual tiles
+    make_cb(2, max_count, weight_format);           // weight tiles
+    make_cb(3, max_count, row_format);              // sum, kept for the normalization
+    make_cb(4, max_count, row_format);              // sum, for the writer
+    make_cb(5, max_count, tt::DataFormat::Float32); // sum * weight
+    make_cb(6, 1, tt::DataFormat::Float32);         // reduce scaler
+    make_cb(7, 1, tt::DataFormat::Float32);         // sum * sum^T, for the writer; then the rstd for the writer
+    make_cb(8, 1, tt::DataFormat::Float32);         // every core's sums of squares, one column per core
+    make_cb(9, 1, tt::DataFormat::Float32);         // rsqrt(mean + eps), one per row, a column
+    make_cb(10, max_count, row_format);             // norm, for the writer
+    // Like the kernel, on the offset's bits.
+    if (std::bit_cast<uint32_t>(params.weight_offset) != 0) {
+        make_cb(11, max_count, tt::DataFormat::Float32);  // weight + weight_offset
+    }
+    // The float8 codes as quantize_rows lays out a row's maxima: `stride`
+    // rows of 64 bytes per core in the first core's gather buffer.
+    const uint32_t rows = input.logical_shape()[0];
+    const uint32_t stride = rows <= 4 ? 4 : rows <= 8 ? 8 : rows <= 16 ? 16 : 32;
+    const uint32_t gather_tiles = (num_cores * stride * 64 + 4095) / 4096;
+    if (quantize) {
+        make_cb(12, 1, tt::DataFormat::Float32);             // row maxima; on the first core then the divisor
+        make_cb(13, gather_tiles, tt::DataFormat::Float32);  // every core's row maxima
+        make_cb(14, 1, tt::DataFormat::Float32);             // the divisor: scale[m] across row m
+        make_cb(15, max_count, tt::DataFormat::UInt8);       // float8 codes
+    }
+    const uint32_t l1_bytes =
+        device->l1_size_per_core() - device->allocator()->get_base_allocator_addr(tt::tt_metal::HalMemType::L1);
+    TT_FATAL(
+        cb_bytes <= l1_bytes,
+        "the circular buffers need {} bytes of L1 per core for a width of {}, more than the {} available",
+        cb_bytes,
+        width,
+        l1_bytes);
+
+    // The first core counts the columns written into its exchange tile; the
+    // others are told when it has zeroed that tile, and when the rstd column
+    // has arrived.
+    constexpr uint32_t valid_sem_id = 0;
+    constexpr uint32_t written_sem_id = 1;
+    constexpr uint32_t cleared_sem_id = 2;
+    for (uint32_t id : {valid_sem_id, written_sem_id, cleared_sem_id}) {
+        program.semaphores.push_back(SemaphoreDescriptor{.id = id, .core_ranges = cores, .initial_value = 0});
+    }
+
+    const std::vector<std::pair<std::string, uint32_t>> common_args = {
+        {"cb_input", 0},  {"cb_residual", 1}, {"cb_weight", 2},   {"cb_sum", 3},      {"cb_sum_out", 4},
+        {"cb_scaled", 5},  {"cb_scaler", 6},   {"cb_partial", 7},  {"cb_exchange", 8}, {"cb_rstd", 9},
+        {"cb_norm", 10},  {"cb_weight_offset", 11}, {"cb_amax", 12}, {"cb_gather", 13}, {"cb_divisor", 14},
+        {"cb_q", 15},
+        {"num_cores", num_cores},
+        {"rows", rows},
+        {"quantize", quantize ? 1u : 0u},
+        {"stride", stride},
+        {"gather_tiles", gather_tiles},
+        {"e5m2", params.float8_type == DataType::FP8_E5M2 ? 1u : 0u},
+        {"fp8_max_bits", std::bit_cast<uint32_t>(params.float8_type == DataType::FP8_E5M2 ? 57344.0f : 448.0f)},
+        {"min_scale_bits", std::bit_cast<uint32_t>(params.min_scale)},
+        {"valid_sem", valid_sem_id},
+        {"written_sem", written_sem_id},
+        {"cleared_sem", cleared_sem_id},
+        {"eps", std::bit_cast<uint32_t>(params.epsilon)},
+        {"weight_offset", std::bit_cast<uint32_t>(params.weight_offset)},
+        {"inv_width", std::bit_cast<uint32_t>(1.0f / static_cast<float>(width))},
+    };
+    const std::string kernel_dir = "ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/";
+
+    std::vector<uint32_t> reader_args;
+    TensorAccessorArgs(input).append_to(reader_args);
+    TensorAccessorArgs(residual).append_to(reader_args);
+    TensorAccessorArgs(weight).append_to(reader_args);
+    KernelDescriptor reader{
+        .kernel_source = kernel_dir + "dataflow/reader_rms_norm_residual.cpp",
+        .core_ranges = cores,
+        .compile_time_args = reader_args,
+        .named_compile_time_args = common_args,
+        .config = DataMovementConfigDescriptor{
+            .processor = DataMovementProcessor::RISCV_1, .noc = NOC::RISCV_1_default}};
+    std::vector<uint32_t> writer_args;
+    TensorAccessorArgs(sum).append_to(writer_args);
+    TensorAccessorArgs(norm).append_to(writer_args);
+    TensorAccessorArgs(q).append_to(writer_args);
+    TensorAccessorArgs(scale).append_to(writer_args);
+    KernelDescriptor writer{
+        .kernel_source = kernel_dir + "dataflow/writer_rms_norm_residual.cpp",
+        .core_ranges = cores,
+        .compile_time_args = writer_args,
+        .named_compile_time_args = common_args,
+        .config = DataMovementConfigDescriptor{
+            .processor = DataMovementProcessor::RISCV_0, .noc = NOC::RISCV_0_default}};
+    // The maxima and the divisor unpack straight to DST, keeping FP32.
+    ComputeConfigDescriptor compute_config{
+        .math_fidelity = MathFidelity::HiFi4, .fp32_dest_acc_en = true, .math_approx_mode = false};
+    if (quantize) {
+        compute_config.unpack_to_dest_mode.assign(NUM_CIRCULAR_BUFFERS, UnpackToDestMode::Default);
+        compute_config.unpack_to_dest_mode[13] = UnpackToDestMode::UnpackToDestFp32;
+        compute_config.unpack_to_dest_mode[14] = UnpackToDestMode::UnpackToDestFp32;
+    }
+    KernelDescriptor compute{
+        .kernel_source = kernel_dir + "compute/rms_norm_residual.cpp",
+        .core_ranges = cores,
+        .named_compile_time_args = common_args,
+        .config = compute_config};
+
+    // Every core writes its column into the first core's exchange tile, and
+    // that core multicasts the rstd column to the rectangles of the core set: the
+    // full rows of the grid and the partial last row. A rectangle's
+    // destination count leaves out the first core itself. The writer takes
+    // two rectangles, the second one possibly empty.
+    const CoreCoord gather = device->worker_core_from_logical_core(core_at(0));
+    TT_FATAL(cores.ranges().size() <= 2, "the cores must form at most two rectangles, got {}", cores.ranges().size());
+    std::vector<uint32_t> rectangles;
+    for (const CoreRange& range : cores.ranges()) {
+        const CoreCoord start = device->worker_core_from_logical_core(range.start_coord);
+        const CoreCoord end = device->worker_core_from_logical_core(range.end_coord);
+        const uint32_t dests = range.size() - (range.contains(core_at(0)) ? 1 : 0);
+        rectangles.insert(
+            rectangles.end(),
+            {static_cast<uint32_t>(start.x),
+             static_cast<uint32_t>(start.y),
+             static_cast<uint32_t>(end.x),
+             static_cast<uint32_t>(end.y),
+             dests});
+    }
+    rectangles.resize(10, 0);
+    for (uint32_t i = 0; i < num_cores; ++i) {
+        const CoreCoord core = core_at(i);
+        reader.emplace_runtime_args(core, {i, start_of(i), count_of(i), input, residual, weight});
+        std::vector<std::variant<uint32_t, std::reference_wrapper<const MeshTensor>>> args = {
+            i, start_of(i), count_of(i), sum, norm, static_cast<uint32_t>(gather.x), static_cast<uint32_t>(gather.y)};
+        for (uint32_t value : rectangles) {
+            args.emplace_back(value);
+        }
+        if (quantize) {
+            args.emplace_back(std::cref(q));
+            args.emplace_back(std::cref(scale));
+        } else {
+            args.emplace_back(0u);
+            args.emplace_back(0u);
+        }
+        writer.emplace_runtime_args(core, args);
+        compute.emplace_runtime_args(core, {count_of(i), i == 0 ? 1u : 0u});
+    }
+    program.kernels.push_back(std::move(reader));
+    program.kernels.push_back(std::move(writer));
+    program.kernels.push_back(std::move(compute));
+    return program;
+}
+
+}  // namespace
+}  // namespace ttnn::prim
+
+namespace ttnn::normalization {
+
+std::vector<Tensor> rms_norm_residual(
+    const Tensor& input,
+    const Tensor& residual,
+    const Tensor& weight,
+    float epsilon,
+    float weight_offset,
+    std::optional<DataType> float8_type,
+    float min_scale) {
+    using Op = prim::RMSNormResidualOperation;
+    return device_operation::launch<Op>(
+        {.epsilon = epsilon, .weight_offset = weight_offset, .float8_type = float8_type, .min_scale = min_scale},
+        {.input = input, .residual = residual, .weight = weight});
+}
+
+}  // namespace ttnn::normalization
