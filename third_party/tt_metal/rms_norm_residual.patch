diff --git ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/compute/rms_norm_residual.cpp ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/compute/rms_norm_residual.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/compute/rms_norm_residual.cpp
@@ -0,0 +1,167 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/compute/bcast.h"
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/compute_kernel_hw_startup.h"
+#include "api/compute/eltwise_binary.h"
+#include "api/compute/eltwise_unary/binop_with_scalar.h"
+#include "api/compute/eltwise_unary/rsqrt.h"
+#include "api/compute/matmul.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/reduce.h"
+
+// sum = input + residual for this core's tiles. The rows' sums of squares
+// over those tiles are the diagonal of sum * sum^T, a tile the writer takes
+// them from to gather on the first core, one column per core; that core
+// sums the rows, turns them into rsqrt(mean + eps), and the writer
+// multicasts the column. norm = sum * weight * rstd.
+void kernel_main() {
+    const uint32_t count = get_arg_val<uint32_t>(0);
+    const bool first = get_arg_val<uint32_t>(1) != 0;
+
+    constexpr uint32_t cb_input = get_named_compile_time_arg_val("cb_input");
+    constexpr uint32_t cb_residual = get_named_compile_time_arg_val("cb_residual");
+    constexpr uint32_t cb_weight = get_named_compile_time_arg_val("cb_weight");
+    constexpr uint32_t cb_sum = get_named_compile_time_arg_val("cb_sum");
+    constexpr uint32_t cb_sum_out = get_named_compile_time_arg_val("cb_sum_out");
+    constexpr uint32_t cb_scaled = get_named_compile_time_arg_val("cb_scaled");
+    constexpr uint32_t cb_scaler = get_named_compile_time_arg_val("cb_scaler");
+    constexpr uint32_t cb_partial = get_named_compile_time_arg_val("cb_partial");
+    constexpr uint32_t cb_exchange = get_named_compile_time_arg_val("cb_exchange");
+    constexpr uint32_t cb_rstd = get_named_compile_time_arg_val("cb_rstd");
+    constexpr uint32_t cb_norm = get_named_compile_time_arg_val("cb_norm");
+    constexpr uint32_t rows = get_named_compile_time_arg_val("rows");
+    constexpr uint32_t eps = get_named_compile_time_arg_val("eps");
+    constexpr uint32_t inv_width = get_named_compile_time_arg_val("inv_width");
+
+    // DST holds four FP32 tiles per acquire.
+    constexpr uint32_t batch = 4;
+    // Pack DST tiles 0..n-1 to `cb` as its tiles first..first+n-1.
+    auto pack_block = [&](uint32_t cb, uint32_t first_tile, uint32_t n) {
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_reconfig_data_format(cb);
+        for (uint32_t j = 0; j < n; ++j) {
+            pack_tile(j, cb, first_tile + j);
+        }
+        tile_regs_release();
+    };
+
+    // sum = input + residual, once for the writer and once to normalize.
+    compute_kernel_hw_startup(cb_input, cb_residual, cb_sum);
+    cb_wait_front(cb_input, count);
+    cb_wait_front(cb_residual, count);
+    cb_reserve_back(cb_sum, count);
+    cb_reserve_back(cb_sum_out, count);
+    add_tiles_init(cb_input, cb_residual);
+    for (uint32_t b = 0; b < count; b += batch) {
+        const uint32_t n = count - b < batch ? count - b : batch;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            add_tiles(cb_input, cb_residual, b + j, b + j, j);
+        }
+        tile_regs_commit();
+        tile_regs_wait();
+        for (uint32_t j = 0; j < n; ++j) {
+            pack_tile(j, cb_sum, b + j);
+            pack_tile(j, cb_sum_out, b + j);
+        }
+        tile_regs_release();
+    }
+    cb_push_back(cb_sum, count);
+    cb_push_back(cb_sum_out, count);
+    cb_pop_front(cb_input, count);
+    cb_pop_front(cb_residual, count);
+
+    // partial = sum * sum^T over this core's tiles: its diagonal holds every
+    // row's sum of squares.
+    cb_wait_front(cb_sum, count);
+    cb_reserve_back(cb_partial, 1);
+    reconfig_data_format(cb_sum, cb_sum);
+    matmul_init(cb_sum, cb_sum, /*transpose=*/1);
+    tile_regs_acquire();
+    for (uint32_t i = 0; i < count; ++i) {
+        matmul_tiles(cb_sum, cb_sum, i, i, 0);
+    }
+    pack_block(cb_partial, 0, 1);
+    cb_push_back(cb_partial, 1);
+
+    // scaled = sum * weight (one per column) needs nothing from the other
+    // cores, so it is done while their sums are gathered.
+    cb_wait_front(cb_weight, count);
+    cb_reserve_back(cb_scaled, count);
+    reconfig_data_format(cb_sum, cb_weight);
+    mul_bcast_rows_init_short(cb_sum, cb_weight);
+    for (uint32_t b = 0; b < count; b += batch) {
+        const uint32_t n = count - b < batch ? count - b : batch;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            mul_tiles_bcast_rows(cb_sum, cb_weight, b + j, b + j, j);
+        }
+        pack_block(cb_scaled, b, n);
+    }
+    cb_push_back(cb_scaled, count);
+    cb_pop_front(cb_weight, count);
+    cb_pop_front(cb_sum, count);
+
+    if (first) {
+        // The exchange tile holds every core's sums of squares, one column
+        // per core and one row per row; their row sums are the whole width's.
+        cb_wait_front(cb_exchange, 1);
+        cb_wait_front(cb_scaler, 1);
+        cb_reserve_back(cb_rstd, 1);
+        cb_reserve_back(cb_partial, 1);
+        // A row reduce unpacks the scaler first; set the formats in that order.
+        reconfig_data_format(cb_scaler, cb_exchange);
+        reduce_init<PoolType::SUM, ReduceDim::REDUCE_ROW>(cb_exchange, cb_scaler, cb_rstd);
+        tile_regs_acquire();
+        reduce_tile<PoolType::SUM, ReduceDim::REDUCE_ROW>(cb_exchange, cb_scaler, 0, 0, 0);
+        reduce_uninit(cb_exchange);
+        // rstd = rsqrt(sum / width + eps) down column 0: the SFPU's column
+        // mode covers faces 0 and 2, two rows per iteration.
+        constexpr int sfpu_iterations = rows < 16 ? (rows + 1) / 2 : 8;
+        binop_with_scalar_tile_init();
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_binop_with_scalar,
+            (APPROX, ckernel::sfpu::MUL, sfpu_iterations), 0, VectorMode::C, inv_width));
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_binop_with_scalar,
+            (APPROX, ckernel::sfpu::ADD, sfpu_iterations), 0, VectorMode::C, eps));
+        rsqrt_tile_init();
+        MATH(SFPU_UNARY_CALL(
+            DST_SYNC_MODE, DST_ACCUM_MODE, calculate_rsqrt,
+            (APPROX, sfpu_iterations, DST_ACCUM_MODE, false, false), 0, VectorMode::C));
+        // Once for this core, once for the writer to multicast.
+        tile_regs_commit();
+        tile_regs_wait();
+        pack_reconfig_data_format(cb_rstd);
+        pack_tile(0, cb_rstd, 0);
+        pack_tile(0, cb_partial, 0);
+        tile_regs_release();
+        cb_push_back(cb_rstd, 1);
+        cb_push_back(cb_partial, 1);
+        cb_pop_front(cb_exchange, 1);
+    }
+    cb_wait_front(cb_scaler, 1);
+    cb_pop_front(cb_scaler, 1);
+
+    // norm = scaled * rstd (one per row)
+    cb_wait_front(cb_scaled, count);
+    cb_wait_front(cb_rstd, 1);
+    cb_reserve_back(cb_norm, count);
+    reconfig_data_format(cb_scaled, cb_rstd);
+    mul_bcast_cols_init_short(cb_scaled, cb_rstd);
+    for (uint32_t b = 0; b < count; b += batch) {
+        const uint32_t n = count - b < batch ? count - b : batch;
+        tile_regs_acquire();
+        for (uint32_t j = 0; j < n; ++j) {
+            mul_tiles_bcast_cols(cb_scaled, cb_rstd, b + j, 0, j);
+        }
+        pack_block(cb_norm, b, n);
+    }
+    cb_push_back(cb_norm, count);
+    cb_pop_front(cb_scaled, count);
+    cb_pop_front(cb_rstd, 1);
+}
diff --git ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/reader_rms_norm_residual.cpp ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/reader_rms_norm_residual.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/reader_rms_norm_residual.cpp
@@ -0,0 +1,83 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+
+// Reads the first `rows` rows of this core's input and residual tiles and
+// row 0 of its weight tiles, and builds the reduce scaler. The other rows of
+// a tile are padding: they are left as they are and every stage keeps rows
+// apart, so they never reach row 0.
+void kernel_main() {
+    const uint32_t start = get_arg_val<uint32_t>(1);
+    const uint32_t count = get_arg_val<uint32_t>(2);
+    const uint32_t input_addr = get_arg_val<uint32_t>(3);
+    const uint32_t residual_addr = get_arg_val<uint32_t>(4);
+    const uint32_t weight_addr = get_arg_val<uint32_t>(5);
+
+    constexpr uint32_t cb_input = get_named_compile_time_arg_val("cb_input");
+    constexpr uint32_t cb_residual = get_named_compile_time_arg_val("cb_residual");
+    constexpr uint32_t cb_weight = get_named_compile_time_arg_val("cb_weight");
+    constexpr uint32_t cb_scaler = get_named_compile_time_arg_val("cb_scaler");
+    constexpr uint32_t rows = get_named_compile_time_arg_val("rows");
+    constexpr auto input_args = TensorAccessorArgs<0>();
+    constexpr auto residual_args = TensorAccessorArgs<input_args.next_compile_time_args_offset()>();
+    constexpr auto weight_args = TensorAccessorArgs<residual_args.next_compile_time_args_offset()>();
+    const auto input = TensorAccessor(input_args, input_addr, get_tile_size(cb_input));
+    const auto residual = TensorAccessor(residual_args, residual_addr, get_tile_size(cb_residual));
+    const auto weight = TensorAccessor(weight_args, weight_addr, get_tile_size(cb_weight));
+
+    // Faces 0 and 1 of a tile hold rows 0-15, faces 2 and 3 rows 16-31; a
+    // face row is 16 elements.
+    auto read_rows = [&](const auto& tensor, uint32_t tile, uint32_t cb, uint32_t valid_rows) {
+        const uint64_t source = tensor.get_noc_addr(start + tile);
+        const uint32_t dest = get_write_ptr(cb) + tile * get_tile_size(cb);
+        const uint32_t face_bytes = get_tile_size(cb) / 4;
+        const uint32_t row_bytes = face_bytes / 16;
+        const uint32_t first = valid_rows < 16 ? valid_rows : 16;
+        for (uint32_t face = 0; face < 2; ++face) {
+            noc_async_read(source + face * face_bytes, dest + face * face_bytes, first * row_bytes);
+        }
+        if (valid_rows > 16) {
+            for (uint32_t face = 2; face < 4; ++face) {
+                noc_async_read(source + face * face_bytes, dest + face * face_bytes, (valid_rows - 16) * row_bytes);
+            }
+        }
+    };
+    cb_reserve_back(cb_input, count);
+    cb_reserve_back(cb_residual, count);
+    cb_reserve_back(cb_weight, count);
+    for (uint32_t i = 0; i < count; ++i) {
+        read_rows(input, i, cb_input, rows);
+        read_rows(residual, i, cb_residual, rows);
+    }
+
+    // A reduce sums a tile's rows or columns scaled by row zero of each face
+    // of the scaler tile: FP32 ones here. Built while the reads are in flight.
+    {
+        Noc noc;
+        CircularBuffer scaler(cb_scaler);
+        scaler.reserve_back(1);
+        noc.async_write_zeros(scaler, 4096);
+        noc.write_zeros_l1_barrier();
+        volatile tt_l1_ptr uint32_t* tile = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(scaler.get_write_ptr());
+        for (uint32_t face = 0; face < 4; ++face) {
+            for (uint32_t column = 0; column < 16; ++column) {
+                tile[face * 256 + column] = 0x3F800000u;
+            }
+        }
+        scaler.push_back(1);
+    }
+    noc_async_read_barrier();
+    cb_push_back(cb_input, count);
+    cb_push_back(cb_residual, count);
+
+    // The weight is needed only after the sums.
+    for (uint32_t i = 0; i < count; ++i) {
+        read_rows(weight, i, cb_weight, 1);
+    }
+    noc_async_read_barrier();
+    cb_push_back(cb_weight, count);
+}
diff --git ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/writer_rms_norm_residual.cpp ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/writer_rms_norm_residual.cpp
--- /dev/null
+++ ttnn/cpp/ttnn/operations/normalization/rms_norm_residual/device/kernels/dataflow/writer_rms_norm_residual.cpp
@@ -0,0 +1,150 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <cstdint>
+#include "api/dataflow/circular_buffer.h"
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+
+// Writes the first `rows` rows of this core's sum and norm tiles, and
+// exchanges the rows' sums of squares through the first core. That core
+// zeroes its exchange tile and tells the others with the `cleared`
+// semaphore (zeroing only the columns past the cores would avoid the
+// handshake, but one store at a time it costs 6 us for 32 rows on 5 cores,
+// while the handshake costs nothing measurable); every core then writes its
+// rows' sums, the diagonal of its partial tile, into column `worker` of the
+// exchange tile and counts itself in on the `written` semaphore; the first
+// core multicasts the rstd column into every other core's rstd buffer and
+// sets their `valid` semaphore. The buffers have the same address on every
+// core.
+void kernel_main() {
+    const uint32_t worker = get_arg_val<uint32_t>(0);
+    const uint32_t start = get_arg_val<uint32_t>(1);
+    const uint32_t count = get_arg_val<uint32_t>(2);
+    const uint32_t sum_addr = get_arg_val<uint32_t>(3);
+    const uint32_t norm_addr = get_arg_val<uint32_t>(4);
+    const uint32_t gather_x = get_arg_val<uint32_t>(5);
+    const uint32_t gather_y = get_arg_val<uint32_t>(6);
+    // Two multicast rectangles (x0, y0, x1, y1, destinations), the second one
+    // possibly empty: the full rows of cores and the partial last row.
+    constexpr uint32_t rectangles_arg = 7;
+
+    constexpr uint32_t cb_sum_out = get_named_compile_time_arg_val("cb_sum_out");
+    constexpr uint32_t cb_partial = get_named_compile_time_arg_val("cb_partial");
+    constexpr uint32_t cb_exchange = get_named_compile_time_arg_val("cb_exchange");
+    constexpr uint32_t cb_rstd = get_named_compile_time_arg_val("cb_rstd");
+    constexpr uint32_t cb_norm = get_named_compile_time_arg_val("cb_norm");
+    constexpr uint32_t num_cores = get_named_compile_time_arg_val("num_cores");
+    constexpr uint32_t rows = get_named_compile_time_arg_val("rows");
+    constexpr uint32_t valid_sem = get_named_compile_time_arg_val("valid_sem");
+    constexpr uint32_t written_sem = get_named_compile_time_arg_val("written_sem");
+    constexpr uint32_t cleared_sem = get_named_compile_time_arg_val("cleared_sem");
+    constexpr auto sum_args = TensorAccessorArgs<0>();
+    constexpr auto norm_args = TensorAccessorArgs<sum_args.next_compile_time_args_offset()>();
+    const auto sum = TensorAccessor(sum_args, sum_addr, get_tile_size(cb_sum_out));
+    const auto norm = TensorAccessor(norm_args, norm_addr, get_tile_size(cb_norm));
+    const uint32_t valid_addr = get_semaphore(valid_sem);
+    const uint32_t written_addr = get_semaphore(written_sem);
+    const uint32_t cleared_addr = get_semaphore(cleared_sem);
+    volatile tt_l1_ptr uint32_t* valid = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(valid_addr);
+    volatile tt_l1_ptr uint32_t* written = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(written_addr);
+    volatile tt_l1_ptr uint32_t* cleared = reinterpret_cast<volatile tt_l1_ptr uint32_t*>(cleared_addr);
+    auto rectangle = [&](uint32_t r, uint32_t field) { return get_arg_val<uint32_t>(rectangles_arg + 5 * r + field); };
+    // `source` of the first core goes to `address` on every other core.
+    auto multicast = [&](uint32_t source, uint32_t address, uint32_t bytes, uint32_t sem_addr) {
+        for (uint32_t r = 0; r < 2; ++r) {
+            const uint32_t dests = rectangle(r, 4);
+            if (dests == 0) {
+                continue;
+            }
+            const uint32_t x0 = rectangle(r, 0), y0 = rectangle(r, 1), x1 = rectangle(r, 2), y1 = rectangle(r, 3);
+            if (bytes > 0) {
+                noc_async_write_multicast(source, get_noc_multicast_addr(x0, y0, x1, y1, address), bytes, dests, true);
+#ifdef ARCH_BLACKHOLE
+                noc_async_writes_flushed();
+#endif
+            }
+            noc_semaphore_set_multicast(sem_addr, get_noc_multicast_addr(x0, y0, x1, y1, sem_addr), dests);
+        }
+    };
+    auto write_rows = [&](const auto& tensor, uint32_t tile, uint32_t cb) {
+        const uint64_t dest = tensor.get_noc_addr(start + tile);
+        const uint32_t source = get_read_ptr(cb) + tile * get_tile_size(cb);
+        const uint32_t face_bytes = get_tile_size(cb) / 4;
+        const uint32_t row_bytes = face_bytes / 16;
+        constexpr uint32_t first = rows < 16 ? rows : 16;
+        for (uint32_t face = 0; face < 2; ++face) {
+            noc_async_write(source + face * face_bytes, dest + face * face_bytes, first * row_bytes);
+        }
+        if constexpr (rows > 16) {
+            for (uint32_t face = 2; face < 4; ++face) {
+                noc_async_write(source + face * face_bytes, dest + face * face_bytes, (rows - 16) * row_bytes);
+            }
+        }
+    };
+
+    // The exchange tile has the same address on every core; only the first
+    // core's is written, after it zeroed it.
+    const uint32_t exchange = get_write_ptr(cb_exchange);
+    if (worker == 0) {
+        cb_reserve_back(cb_exchange, 1);
+        {
+            Noc noc;
+            CircularBuffer cb(cb_exchange);
+            noc.async_write_zeros(cb, 4096);
+            noc.write_zeros_l1_barrier();
+        }
+        *cleared = 1;
+        multicast(0, 0, 0, cleared_addr);
+    }
+
+    cb_wait_front(cb_sum_out, count);
+    for (uint32_t i = 0; i < count; ++i) {
+        write_rows(sum, i, cb_sum_out);
+    }
+
+    // Element (r, r) of the partial tile goes to element (r, worker) of the
+    // exchange tile. In a 32x32 FP32 tile, element (r, c) is in face
+    // (r / 16) * 2 + c / 16 at row r % 16, column c % 16.
+    cb_wait_front(cb_partial, 1);
+    const uint32_t partial = get_read_ptr(cb_partial);
+    if (worker != 0) {
+        noc_semaphore_wait(cleared, 1);
+        *cleared = 0;
+    }
+    for (uint32_t r = 0; r < rows; ++r) {
+        const uint32_t value = *reinterpret_cast<volatile tt_l1_ptr uint32_t*>(
+            partial + ((r / 16) * 3) * 1024 + (r % 16) * 64 + (r % 16) * 4);
+        const uint32_t dest = exchange + ((r / 16) * 2 + worker / 16) * 1024 + (r % 16) * 64 + (worker % 16) * 4;
+        noc_inline_dw_write(get_noc_addr(gather_x, gather_y, dest), value);
+    }
+    noc_async_write_barrier();
+    noc_semaphore_inc(get_noc_addr(gather_x, gather_y, written_addr), 1);
+    cb_pop_front(cb_partial, 1);
+
+    if (worker == 0) {
+        noc_semaphore_wait_min(written, num_cores);
+        cb_push_back(cb_exchange, 1);
+        // The rstd column from the compute kernel goes to every other core.
+        cb_wait_front(cb_partial, 1);
+        *valid = 1;
+        multicast(get_read_ptr(cb_partial), get_write_ptr(cb_rstd), get_tile_size(cb_rstd), valid_addr);
+        noc_async_write_barrier();
+        cb_pop_front(cb_partial, 1);
+    } else {
+        cb_reserve_back(cb_rstd, 1);
+        noc_semaphore_wait(valid, 1);
+        *valid = 0;
+        cb_push_back(cb_rstd, 1);
+    }
+
+    cb_wait_front(cb_norm, count);
+    for (uint32_t i = 0; i < count; ++i) {
+        write_rows(norm, i, cb_norm);
+    }
+    noc_async_write_barrier();
+    cb_pop_front(cb_sum_out, count);
+    cb_pop_front(cb_norm, count);
+    // No core signals the next launch before every core has finished this one.
+    *written = 0;
+}
