+    const uint32_t packed_cb_pages = (total * PACKED_TILE_BYTES + page - 1) / page;
+    cb_reserve_back(cb, packed_cb_pages);
+    const uint32_t dst = get_write_ptr(cb);
+    for (uint32_t t = 0; t < total; ++t) {
+        noc_async_read(src.get_noc_addr(start + t), dst + 2 * t * packed_face_bytes, packed_face_bytes);
+        noc_async_read(
+            src.get_noc_addr(start + t, tile_face_bytes), dst + (2 * t + 1) * packed_face_bytes, packed_face_bytes);
+    }
+    noc_async_read_barrier();
+    cb_push_back(cb, packed_cb_pages);
+    return;
