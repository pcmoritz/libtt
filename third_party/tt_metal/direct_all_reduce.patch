+// SPDX-License-Identifier: Apache-2.0
+#include "api/dataflow/dataflow_api.h"
+void kernel_main() {
+    constexpr uint32_t cb = get_compile_time_arg_val(1);
+    constexpr uint32_t page = get_compile_time_arg_val(2);
+    constexpr auto spec = TensorAccessorArgs<3>();
+    const auto src = TensorAccessor(spec, get_arg_val<uint32_t>(0), page);
+    const uint32_t chunk = get_arg_val<uint32_t>(1);
+    const uint32_t total = get_arg_val<uint32_t>(2);
+    const uint32_t cores = get_arg_val<uint32_t>(4);
+    const uint32_t start = get_arg_val<uint32_t>(5 + 2 * cores);
+    for (uint32_t i = 0; i < total;) {
+        const uint32_t n = (total-i < chunk) ? total-i : chunk;
+        cb_reserve_back(cb, n);
+        const uint32_t dst = get_write_ptr(cb);
+        for (uint32_t j = 0; j < n; ++j) noc_async_read_tile(start+i+j, src, dst+j*page);
+        noc_async_read_barrier();
+        cb_push_back(cb, n);
+        i += n;
+    }
+}
diff --git ttnn/cpp/ttnn/operations/experimental/ccl/all_reduce_async/device/kernels/dataflow/dram_writer.cpp ttnn/cpp/ttnn/operations/experimental/ccl/all_reduce_async/device/kernels/dataflow/dram_writer.cpp
