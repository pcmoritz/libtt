+tt::tt_metal::WorkloadDescriptor AllReduceAsyncMeshWorkloadFactory::create_workload_descriptor(
+    const AllReduceAsyncParams& operation_attributes,
+    const AllReduceAsyncInputs& tensor_args,
+    Tensor& output_tensor,
+    const ttnn::MeshCoordinateRangeSet& tensor_coords) {
+    tt::tt_metal::WorkloadDescriptor workload;
+    auto attributes = operation_attributes;
+    if (!attributes.semaphore) {
+        auto* device = tensor_args.input_tensor.device();
+        auto sd = attributes.sub_device_id.value_or(device->get_sub_device_ids().at(0));
+        auto cores = device->worker_cores(tt::tt_metal::HalProgrammableCoreType::TENSIX, sd);
+        // Keep the semaphore out of L1 when possible, as reduce_scatter does.
+        const auto sem_buffer_type = device->allocator()->get_bank_size(tt::tt_metal::BufferType::L1_SMALL) > 0
+                                         ? tt::tt_metal::BufferType::L1_SMALL
+                                         : tt::tt_metal::BufferType::L1;
+        attributes.semaphore = ttnn::global_semaphore::create_global_semaphore(device, cores, 0, sem_buffer_type);
+        tt::tt_metal::distributed::Synchronize(device, std::nullopt, {});
+    }
+    // The workload keeps the semaphore it was built with, created here or passed by the caller.
+    workload.semaphores.push_back(*attributes.semaphore);
+    for (const auto& coord : tensor_coords.coords()) {
+        workload.programs.push_back(
+            {ttnn::MeshCoordinateRange(coord), create_descriptor(attributes, tensor_args, output_tensor, coord)});
+    }
+    return workload;
+}
