+std::optional<MemoryConfig> direct_all_reduce_scratch_config(const Tensor& input_tensor, uint32_t ring_size) {
+    using tt::constants::TILE_HEIGHT;
+    using tt::constants::TILE_WIDTH;
+    // More reduction cores only add multicast destinations for small vectors.
+    constexpr uint32_t max_workers = 32;
+    // Every worker holds ring_size copies of its slice in L1.
+    constexpr uint32_t max_scratch_bytes_per_core = 512 * 1024;
+    const auto& padded = input_tensor.padded_shape();
+    // Validated on Blackhole and for BF16 only; the sizes below follow the
+    // element size. The reduction kernel adds rank slices in pairs.
+    if (input_tensor.device()->arch() != tt::ARCH::BLACKHOLE || ring_size < 2 || ring_size % 2 != 0 ||
+        input_tensor.dtype() != DataType::BFLOAT16 ||
+        input_tensor.layout() != Layout::TILE || input_tensor.memory_config() != DRAM_MEMORY_CONFIG ||
+        padded.rank() < 2 || input_tensor.physical_volume() != TILE_HEIGHT * padded[-1]) {
+        return std::nullopt;
+    }
+    const uint32_t Wt = padded[-1] / TILE_WIDTH;
+    const auto grid = input_tensor.device()->compute_with_storage_grid_size();
+    // Aim for about one tile of payload per worker: with packed decode rows,
+    // more workers multiply fabric destinations without reducing the compute.
+    const uint32_t element_size = input_tensor.element_size();
+    const uint32_t tile_bytes = TILE_HEIGHT * TILE_WIDTH * element_size;
+    const uint32_t payload_bytes =
+        direct_all_reduce_packed_tile_bytes(input_tensor.logical_shape()[-2], element_size).value_or(tile_bytes);
+    const uint32_t target_workers = tt::div_up(Wt * payload_bytes, tile_bytes);
+    // Workers split Wt evenly, and their slices must fit. Take the most workers
+    // up to the target whose slices fit, or else the fewest above it.
+    const auto shard_width = [&](uint32_t workers) { return ring_size * (Wt / workers) * TILE_WIDTH; };
+    const uint32_t most_workers = std::min<uint32_t>({max_workers, Wt, static_cast<uint32_t>(grid.x * grid.y)});
+    uint32_t workers = 0;
+    for (uint32_t w = 1; w <= most_workers; ++w) {
+        if (Wt % w == 0 && shard_width(w) * TILE_HEIGHT * element_size <= max_scratch_bytes_per_core &&
+            (workers == 0 || w <= target_workers)) {
+            workers = w;
+        }
+    }
+    if (workers == 0) {
+        return std::nullopt;
+    }
+    const auto cores = tt::tt_metal::num_cores_to_corerangeset(workers, grid, /*row_wise=*/true);
+    return MemoryConfig(
+        TensorMemoryLayout::WIDTH_SHARDED, BufferType::L1,
+        tt::tt_metal::ShardSpec(cores, {TILE_HEIGHT, shard_width(workers)}, ShardOrientation::ROW_MAJOR));
+}
