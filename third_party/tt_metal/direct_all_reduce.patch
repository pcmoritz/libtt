+// SPDX-License-Identifier: Apache-2.0
+#include "api/dataflow/dataflow_api.h"
+void kernel_main() {
+    constexpr uint32_t cb = get_compile_time_arg_val(0);
+    constexpr uint32_t count = get_compile_time_arg_val(1);
+    constexpr auto spec = TensorAccessorArgs<2>();
+    const uint32_t page = get_tile_size(cb);
+    // Common arg 0: output address (updated on cache hits). Per-core arg 0: first output page.
+    const auto dst = TensorAccessor(spec, get_common_arg_val<uint32_t>(0), page);
+    const uint32_t start = get_arg_val<uint32_t>(0);
+#ifdef PACKED_TILE_BYTES
+    // The sums are packed at the start of the reduced pages (see dram_reader);
+    // put each tile's rows back at the start of its two upper faces.
+    constexpr uint32_t packed_face_bytes = PACKED_TILE_BYTES / 2;
+    const uint32_t tile_face_bytes = page / 4;
+    cb_wait_front(cb, count);
+    const uint32_t packed = get_read_ptr(cb);
+    for (uint32_t t = 0; t < count; ++t) {
+        noc_async_write(packed + 2 * t * packed_face_bytes, dst.get_noc_addr(start + t), packed_face_bytes);
+        noc_async_write(
+            packed + (2 * t + 1) * packed_face_bytes, dst.get_noc_addr(start + t, tile_face_bytes), packed_face_bytes);
+    }
+    noc_async_write_barrier();
+    cb_pop_front(cb, count);
+    return;
+#endif
+    cb_wait_front(cb, count);
+    const uint32_t src = get_read_ptr(cb);
+    for (uint32_t j = 0; j < count; ++j) noc_async_write_tile(start+j, dst, src+j*page);
+    noc_async_write_barrier();
+    cb_pop_front(cb, count);
+}
