+// Order-preserving integer key for BFloat16 bits under argmax semantics: +0 and -0 tie, and NaN is
+// greater than every number (so the first NaN wins, like the generic comparison).
+inline int32_t bfloat16_argmax_key(uint16_t bits) {
+    const int32_t magnitude = bits & 0x7FFF;
+    if (magnitude > 0x7F80) {
+        return 0x8000;  // NaN
+    }
+    return (bits & 0x8000) ? -magnitude : magnitude;
+}
