+// Order-preserving integer key for BFloat16 bits (in the low 16 bits of `bits`) under argmax semantics:
+// +0 and -0 tie, and NaN is greater than every number. The sign is applied without a branch because it is
+// unpredictable, while NaN is rare.
+inline int32_t bfloat16_argmax_key(uint32_t bits) {
+    const int32_t magnitude = bits & 0x7FFF;
+    if (magnitude > 0x7F80) {
+        return 0x8000;
+    }
+    const int32_t sign = -static_cast<int32_t>((bits >> 15) & 1);
+    return (magnitude ^ sign) - sign;
+}
