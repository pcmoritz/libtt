+// Float32 comparisons in IEEE 754 total order:
+// -NaN < -inf < ... < -0 < +0 < ... < +inf < +NaN, with NaNs ordered by
+// payload. SFPGT and SFPLE compare sign-magnitude bit patterns, which is
+// exactly this order, so unlike the ordinary comparisons above no NaN or zero
+// corrections are needed.
+template <bool APPROXIMATION_MODE, int ITERATIONS, SfpuType RELATIONAL_OP>
+inline void calculate_binary_comp_fp32_total_order(
+    const uint dst_index_in0, const uint dst_index_in1, const uint dst_index_out) {
+    static_assert(is_fp32_compare_v<RELATIONAL_OP>, "Supported operation types: eq, ne, lt, gt, le, ge");
+
+    constexpr uint a = p_sfpu::LREG0;
+    constexpr uint b = p_sfpu::LREG1;
+    constexpr uint dst_tile_size = 64;
+
+    // Each op is a < b (SFPGT) or a == b (two SFPLEs) on possibly swapped
+    // operands, possibly negated: gt is b < a, le is !(b < a), ge is !(a < b).
+    constexpr bool swap_operands = RELATIONAL_OP == SfpuType::gt || RELATIONAL_OP == SfpuType::le;
+    constexpr bool negate =
+        RELATIONAL_OP == SfpuType::ne || RELATIONAL_OP == SfpuType::le || RELATIONAL_OP == SfpuType::ge;
+    constexpr uint default_result = negate ? p_sfpu::LCONST_1 : p_sfpu::LCONST_0;
+    constexpr uint true_result = negate ? p_sfpu::LCONST_0 : p_sfpu::LCONST_1;
+    const uint dst_index_a = swap_operands ? dst_index_in1 : dst_index_in0;
+    const uint dst_index_b = swap_operands ? dst_index_in0 : dst_index_in1;
+
+#pragma GCC unroll 8
+    for (int d = 0; d < ITERATIONS; d++) {
+        TT_SFPLOAD(a, InstrModLoadStore::DEFAULT, ADDR_MOD_7, dst_index_a * dst_tile_size);
+        TT_SFPLOAD(b, InstrModLoadStore::DEFAULT, ADDR_MOD_7, dst_index_b * dst_tile_size);
+        TT_SFPSTORE(default_result, InstrModLoadStore::DEFAULT, ADDR_MOD_7, dst_index_out * dst_tile_size);
+
+        if constexpr (is_fp32_equal_compare_v<RELATIONAL_OP>) {
+            // if total-order a == b
+            TTI_SFPLE(0, b, a, 1);  // SFPLE_MOD1_SET_CC
+            TTI_SFPLE(0, a, b, 1);  // SFPLE_MOD1_SET_CC
+        } else {
+            // if total-order a < b
+            TTI_SFPGT(0, a, b, 1);  // SFPGT_MOD1_SET_CC
+        }
+        TT_SFPSTORE(true_result, InstrModLoadStore::DEFAULT, ADDR_MOD_6, dst_index_out * dst_tile_size);
+
+        TTI_SFPENCC(0, 0, 0, 0);
+    }
+}
+
 // Float32 binary comparisons.
 // - eq/ne: calculate_binary_comp_fp32_equal.
 // - lt/gt: calculate_binary_comp_fp32_strict_ordered.
