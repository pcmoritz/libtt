+
+// Precompiled header for TRISC kernel compiles: the standard library plus the low-level LLK and
+// device headers every compute kernel includes. It is built with the target's own defines
+// (device and processor configuration) but none of a kernel's, so only headers that do not depend
+// on per-kernel macros, compile-time args or generated kernel headers may be listed here. GCC
+// rejects the PCH (and parses the headers as usual) if a kernel defines a macro they use
+// differently.
+
+#pragma once
+
+#include "internal/pch.h"
+
+#include "ckernel.h"
