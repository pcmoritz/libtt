diff --git tt_metal/jit_build/build.cpp tt_metal/jit_build/build.cpp
--- tt_metal/jit_build/build.cpp
+++ tt_metal/jit_build/build.cpp
@@ -759,12 +759,37 @@ void JitBuildState::compile_one(const string& out_dir, const JitBuildSettings* s
 
     // Add the machine-local PCH here so exported recipes remain portable.
     // Exclude build-map dump flags from the PCH profile.
-    const std::string pch = tt::jit_build::ensure_pch(
-        env_.gpp_,
-        recipe.compiler_opt_level,
-        recipe.cflags,
-        recipe.pch_umbrella,
-        fs::path(env_.out_root_) / "pch");
+    //
+    // Kernel builds first try a per-processor PCH that also holds the low-level device headers
+    // every kernel of that processor includes. It is built with this target's defines and
+    // include paths (device and processor configuration) but none of the kernel's own defines
+    // or include paths, so one artifact serves every kernel of the target. Fall back to the standard-library PCH
+    // if it cannot be built (e.g. on an architecture whose headers it does not cover).
+    std::string pch;
+    if (!is_fw_) {
+        const char* project_umbrella = nullptr;
+        if (target_name_ == "brisc" || target_name_ == "ncrisc") {
+            project_umbrella = "tt_metal/hw/inc/internal/pch_dataflow.h";
+        } else if (target_name_.starts_with("trisc")) {
+            project_umbrella = "tt_metal/hw/inc/internal/pch_compute.h";
+        }
+        if (project_umbrella != nullptr) {
+            pch = tt::jit_build::ensure_pch(
+                env_.gpp_,
+                recipe.compiler_opt_level,
+                fmt::format("{} {} {}", recipe.cflags, defines_, includes_),
+                fs::path(env_.root_) / project_umbrella,
+                fs::path(env_.out_root_) / "pch");
+        }
+    }
+    if (pch.empty()) {
+        pch = tt::jit_build::ensure_pch(
+            env_.gpp_,
+            recipe.compiler_opt_level,
+            recipe.cflags,
+            recipe.pch_umbrella,
+            fs::path(env_.out_root_) / "pch");
+    }
 
     // Preserve the recipe's defines for watcher logging.
     std::vector<std::string> defines = recipe.defines;
