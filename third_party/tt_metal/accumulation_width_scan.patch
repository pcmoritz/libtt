+
+void kernel_main() {
+    const uint32_t num_chunks = get_arg(args::num_chunks);
+    const uint32_t start_chunk = get_arg(args::start_chunk);
+    const uint32_t row_tiles = get_arg(args::row_tiles);
+    const uint32_t chunks_per_row = get_arg(args::chunks_per_row);
+    const uint32_t chunk_tiles = get_arg(args::chunk_tiles);
+
+    const Noc noc;
+    DataflowBuffer dfb_in_obj(dfb::in);
+    const uint32_t tile_bytes = dfb_in_obj.get_tile_size();
+    const auto input_addrg = TensorAccessor(tensor::input);
+#ifdef ADD_CHUNK_OFFSETS
+    DataflowBuffer dfb_totals_obj(dfb::totals);
+    const auto totals_addrg = TensorAccessor(tensor::totals);
+#endif
+
+#ifdef WRITE_TOTALS
+    // The tile of zeros the scan runs through after each chunk to read out its totals.
+    DataflowBuffer dfb_zero_obj(dfb::zero);
+    dfb_zero_obj.reserve_back(ONE_TILE);
+    noc.async_write_zeros(dfb_zero_obj, dfb_zero_obj.get_tile_size());
+    noc.write_zeros_l1_barrier();
+    dfb_zero_obj.push_back(ONE_TILE);
+#endif
+
+    for (uint32_t chunk = start_chunk; chunk < start_chunk + num_chunks; ++chunk) {
+#ifdef ADD_CHUNK_OFFSETS
+        for (uint32_t before = chunk - chunk % chunks_per_row; before < chunk; ++before) {
+            dfb_totals_obj.reserve_back(ONE_TILE);
+            noc.async_read(totals_addrg, dfb_totals_obj, tile_bytes, {.page_id = before}, {.offset_bytes = 0});
+            noc.async_read_barrier();
+            dfb_totals_obj.push_back(ONE_TILE);
+        }
+#endif
+        const uint32_t first = chunk_first_tile(chunk, chunks_per_row, chunk_tiles, row_tiles);
+        const uint32_t length = chunk_length(chunk, chunks_per_row, chunk_tiles, row_tiles);
+        for (uint32_t j = 0; j < length; ++j) {
+            dfb_in_obj.reserve_back(ONE_TILE);
+            noc.async_read(input_addrg, dfb_in_obj, tile_bytes, {.page_id = first + j}, {.offset_bytes = 0});
+            noc.async_read_barrier();
+            dfb_in_obj.push_back(ONE_TILE);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_width_writer.cpp ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_width_writer.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_width_writer.cpp
@@ -0,0 +1,49 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Width scan: the result tiles of each chunk of a row of tiles and, with WRITE_TOTALS, the chunk's
+// tile of row totals at the chunk's index.
+
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "api/tensor/noc_traits.h"
+#include "experimental/kernel_args.h"
+
+#include "../accumulation_common.hpp"
+
+void kernel_main() {
+    const uint32_t num_chunks = get_arg(args::num_chunks);
+    const uint32_t start_chunk = get_arg(args::start_chunk);
+    const uint32_t row_tiles = get_arg(args::row_tiles);
+    const uint32_t chunks_per_row = get_arg(args::chunks_per_row);
+    const uint32_t chunk_tiles = get_arg(args::chunk_tiles);
+
+    const Noc noc;
+    DataflowBuffer dfb_out_obj(dfb::out);
+    const uint32_t tile_bytes = dfb_out_obj.get_tile_size();
+    const auto output_addrg = TensorAccessor(tensor::output);
+#ifdef WRITE_TOTALS
+    DataflowBuffer dfb_totals_obj(dfb::totals);
+    const auto totals_addrg = TensorAccessor(tensor::totals);
+#endif
+
+    for (uint32_t chunk = start_chunk; chunk < start_chunk + num_chunks; ++chunk) {
+        const uint32_t first = chunk_first_tile(chunk, chunks_per_row, chunk_tiles, row_tiles);
+        const uint32_t length = chunk_length(chunk, chunks_per_row, chunk_tiles, row_tiles);
+        for (uint32_t j = 0; j < length; ++j) {
+            dfb_out_obj.wait_front(ONE_TILE);
+            noc.async_write(dfb_out_obj, output_addrg, tile_bytes, {.offset_bytes = 0}, {.page_id = first + j});
+            noc.async_write_barrier();
+            dfb_out_obj.pop_front(ONE_TILE);
+        }
+#ifdef WRITE_TOTALS
+        dfb_totals_obj.wait_front(ONE_TILE);
+        noc.async_write(
+            dfb_totals_obj, totals_addrg, dfb_totals_obj.get_tile_size(), {.offset_bytes = 0}, {.page_id = chunk});
+        noc.async_write_barrier();
+        dfb_totals_obj.pop_front(ONE_TILE);
+#endif
+    }
+}
diff --git ttnn/cpp/ttnn/operations/reduction/accumulation/device/accumulation_width_program_factory.cpp ttnn/cpp/ttnn/operations/reduction/accumulation/device/accumulation_width_program_factory.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/reduction/accumulation/device/accumulation_width_program_factory.cpp
@@ -0,0 +1,308 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// The accumulation op's width path: a forward floating-point or 32-bit integer cumsum along the last
+// dimension, scanned along the width of each row of tiles (accumulation_width_compute.cpp) instead of
+// after permuting that dimension to the front.
+//
+// Each row of tiles is scanned in chunks of chunk_tiles tiles (the last may be shorter), each from
+// zero on its own core. With more than one chunk per row (32-bit), this pass also writes every chunk's
+// row totals to the chunk_totals tensor, and a second pass (add_chunk_offsets) adds the totals of the
+// earlier chunks of the row to each chunk, in place.
+
+#include "accumulation/device/accumulation_device_operation_types.hpp"
+#include "accumulation_device_operation.hpp"
+#include "ttnn/operations/core/data_movement_kernel/datamovement_kernel_config.hpp"
+#include "ttnn/operations/reduction/reduce_op_validation.hpp"
+
+#include "tt-metalium/base_types.hpp"
+#include "tt-metalium/host_api.hpp"
+#include "tt-metalium/kernel_types.hpp"
+#include "tt-metalium/tt_backend_api_types.hpp"
+#include "ttnn/tensor/types.hpp"
+#include <tt-metalium/experimental/metal2_host_api/program_run_args.hpp>
+#include <tt-metalium/experimental/metal2_host_api/program_spec.hpp>
+#include <tt-metalium/work_split.hpp>
+
+#include <map>
+#include <string>
+
+namespace ttnn::prim {
+
+using AccumulationWidthProgramFactory = AccumulationDeviceOperation::AccumulationWidthProgramFactory;
+
+namespace {
+
+using namespace tt::tt_metal::experimental;
+
+// Prefixed like the other factories' constants, which may share a unity-built translation unit.
+const KernelSpecName WIDTH_READER{"reader"};
+const KernelSpecName WIDTH_WRITER{"writer"};
+const KernelSpecName WIDTH_COMPUTE{"compute"};
+
+// SRC and DST carry tiles from the reader to compute and on to the writer. The scan reads a tile of
+// ZERO after each chunk and sends the chunk's totals through TOTALS to the writer; the second pass
+// reads them back through TOTALS and keeps their sum, the chunk's offset, in OFFSET.
+const DFBSpecName WIDTH_SRC{"src"};
+const DFBSpecName WIDTH_DST{"dst"};
+const DFBSpecName WIDTH_ZERO{"zero"};
+const DFBSpecName WIDTH_TOTALS{"totals"};
+const DFBSpecName WIDTH_OFFSET{"offset"};
+
+const TensorParamName WIDTH_INPUT{"input"};
+const TensorParamName WIDTH_OUTPUT{"output"};
+const TensorParamName WIDTH_TOTALS_TENSOR{"totals"};
+
+}  // namespace
+
+ttnn::device_operation::ProgramArtifacts AccumulationWidthProgramFactory::create_program_artifacts(
+    const AccumulationParams& operation_attributes,
+    const AccumulationInputs& tensor_args,
+    Tensor& tensor_return_value) {
+    using namespace tt;
+    using namespace tt::tt_metal;
+    using namespace tt::tt_metal::experimental;
+
+    const auto& input_tensor{tensor_args.input_tensor.mesh_tensor()};
+    const auto& output_tensor{tensor_return_value.mesh_tensor()};
+    const tt::tt_metal::distributed::MeshDevice& device = input_tensor.device();
+    const auto& tile = input_tensor.tensor_spec().tile();
+
+    const auto input_dataformat = datatype_to_dataformat_converter(input_tensor.dtype());
+    const auto output_dataformat = datatype_to_dataformat_converter(output_tensor.dtype());
+    const bool integers = is_integer_format(output_dataformat);
+    TT_FATAL(
+        operation_attributes.op == AccumulationOp::CUMSUM && !operation_attributes.flip &&
+            (!integers || ((output_dataformat == DataFormat::Int32 || output_dataformat == DataFormat::UInt32) &&
+                           input_dataformat == output_dataformat)),
+        "Only a forward floating-point or 32-bit integer cumsum scans along the last dimension");
+
+    const uint32_t row_tiles = input_tensor.padded_shape()[-1] / tile.get_width();
+    const bool chunked = operation_attributes.chunk_tiles != 0;
+    const uint32_t chunk_tiles = chunked ? operation_attributes.chunk_tiles : row_tiles;
+    const uint32_t chunks_per_row = (row_tiles + chunk_tiles - 1) / chunk_tiles;
+    const bool add_chunk_offsets = chunked && operation_attributes.add_chunk_offsets;
+    const bool write_totals = chunked && !add_chunk_offsets;
+    TT_FATAL(
+        !chunked || (tensor_args.chunk_totals.has_value() && input_dataformat == output_dataformat &&
+                     (integers || output_dataformat == DataFormat::Float32)),
+        "A chunked width scan needs 32-bit tensors and a totals tensor");
+    const uint32_t num_chunks = input_tensor.physical_volume() / tile.get_tile_hw() / row_tiles * chunks_per_row;
+
+    const auto grid = device.compute_with_storage_grid_size();
+    const auto num_cores_y = grid.y;
+    const auto [num_cores, all_cores, core_group_1, core_group_2, chunks_per_core_group_1, chunks_per_core_group_2] =
+        tt::tt_metal::split_work_to_cores(grid, num_chunks);
+    validate_reduce_op_program_grid("Accumulation", all_cores, grid, nullptr, true, {{&tensor_return_value, "output"}});
+
+    auto make_dfb = [](const DFBSpecName& unique_id, const tt::DataFormat& data_format, uint32_t num_entries) {
+        return DataflowBufferSpec{
+            .unique_id = unique_id,
+            .entry_size = tt::tile_size(data_format),
+            .num_entries = num_entries,
+            .data_format_metadata = data_format,
+        };
+    };
+
+    // 32-bit tiles are unpacked straight into Dest: SrcA would read FP32 as TF32, and can't hold integers.
+    ComputeHardwareConfig::ComputeUnpackModes unpack_modes;
+    if (input_dataformat != DataFormat::Float16_b) {
+        unpack_modes[WIDTH_SRC] = UnpackMode::UnpackToDest;
+    }
+    if (write_totals) {
+        unpack_modes[WIDTH_ZERO] = UnpackMode::UnpackToDest;
+    }
+    if (add_chunk_offsets) {
+        unpack_modes[WIDTH_TOTALS] = UnpackMode::UnpackToDest;
+        unpack_modes[WIDTH_OFFSET] = UnpackMode::UnpackToDest;
+    }
+
+    std::map<std::string, std::string> defines;
+    if (integers) {
+        defines["INTEGER_SUM"] = "1";
+    }
+    if (write_totals) {
+        defines["WRITE_TOTALS"] = "1";
+    }
+    if (add_chunk_offsets) {
+        defines["ADD_CHUNK_OFFSETS"] = "1";
+    }
+    const KernelSpec::CompilerOptions::Defines kernel_defines(defines);
+    // Every kernel of the width path takes the same arguments.
+    const Group<std::string> rta_names{"num_chunks", "start_chunk", "row_tiles", "chunks_per_row", "chunk_tiles"};
+
+    KernelSpec reader{
+        .unique_id = WIDTH_READER,
+        .source = KERNEL_PATHS[0],
+        .compiler_options = {.defines = kernel_defines},
+        .dfb_bindings = {DFBBinding{
+            .dfb_spec_name = WIDTH_SRC,
+            .accessor_name = "in",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        }},
+        .tensor_bindings = {TensorBinding{
+            .tensor_parameter_name = WIDTH_INPUT,
+            .accessor_name = "input",
+        }},
+        .runtime_arg_schema = {.runtime_arg_names = rta_names},
+        .hw_config = ttnn::create_reader_datamovement_config(),
+    };
+    KernelSpec writer{
+        .unique_id = WIDTH_WRITER,
+        .source = KERNEL_PATHS[2],
+        .compiler_options = {.defines = kernel_defines},
+        .dfb_bindings = {DFBBinding{
+            .dfb_spec_name = WIDTH_DST,
+            .accessor_name = "out",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        }},
+        .tensor_bindings = {TensorBinding{
+            .tensor_parameter_name = WIDTH_OUTPUT,
+            .accessor_name = "output",
+        }},
+        .runtime_arg_schema = {.runtime_arg_names = rta_names},
+        .hw_config = ttnn::create_writer_datamovement_config(),
+    };
+    Group<DFBBinding> compute_bindings{
+        DFBBinding{
+            .dfb_spec_name = WIDTH_SRC,
+            .accessor_name = "in",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        },
+        DFBBinding{
+            .dfb_spec_name = WIDTH_DST,
+            .accessor_name = "out",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        }};
+    Group<DataflowBufferSpec> dataflow_buffers{
+        make_dfb(WIDTH_SRC, input_dataformat, 4), make_dfb(WIDTH_DST, output_dataformat, 4)};
+    Group<TensorParameter> tensor_parameters{
+        TensorParameter{.unique_id = WIDTH_INPUT, .spec = input_tensor.tensor_spec()},
+        TensorParameter{.unique_id = WIDTH_OUTPUT, .spec = output_tensor.tensor_spec()}};
+
+    if (write_totals) {
+        reader.dfb_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_ZERO,
+            .accessor_name = "zero",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        });
+        compute_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_ZERO,
+            .accessor_name = "zero",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        });
+        compute_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_TOTALS,
+            .accessor_name = "totals",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        });
+        writer.dfb_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_TOTALS,
+            .accessor_name = "totals",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        });
+        writer.tensor_bindings.push_back(TensorBinding{
+            .tensor_parameter_name = WIDTH_TOTALS_TENSOR,
+            .accessor_name = "totals",
+        });
+        dataflow_buffers.push_back(make_dfb(WIDTH_ZERO, output_dataformat, 1));
+    }
+    if (add_chunk_offsets) {
+        reader.dfb_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_TOTALS,
+            .accessor_name = "totals",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        });
+        reader.tensor_bindings.push_back(TensorBinding{
+            .tensor_parameter_name = WIDTH_TOTALS_TENSOR,
+            .accessor_name = "totals",
+        });
+        compute_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_TOTALS,
+            .accessor_name = "totals",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        });
+        // Both ends of the offset FIFO belong to the compute kernel.
+        compute_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_OFFSET,
+            .accessor_name = "offset",
+            .endpoint_type = DFBEndpointType::PRODUCER,
+        });
+        compute_bindings.push_back(DFBBinding{
+            .dfb_spec_name = WIDTH_OFFSET,
+            .accessor_name = "offset",
+            .endpoint_type = DFBEndpointType::CONSUMER,
+        });
+        dataflow_buffers.push_back(make_dfb(WIDTH_OFFSET, output_dataformat, 1));
+    }
+    if (chunked) {
+        dataflow_buffers.push_back(make_dfb(WIDTH_TOTALS, output_dataformat, 2));
+        tensor_parameters.push_back(
+            TensorParameter{.unique_id = WIDTH_TOTALS_TENSOR, .spec = tensor_args.chunk_totals->tensor_spec()});
+    }
+
+    // As in AccumulationProgramFactory: HiFi4 with an FP32 Dest gives wrong results on Wormhole (#38306).
+    const auto default_math_fidelity =
+        (device.arch() == tt::ARCH::WORMHOLE_B0 && output_tensor.dtype() == DataType::FLOAT32) ? MathFidelity::HiFi3
+                                                                                               : MathFidelity::HiFi4;
+    const ComputeHardwareConfig compute_config{
+        .fpu_math_fidelity = default_math_fidelity,
+        .sfpu_precision_mode = Precision::Precise,
+        .enable_32_bit_dest = true,
+        .double_buffer_dest = true,
+        .unpack_modes = unpack_modes,
+    };
+    KernelSpec compute{
+        .unique_id = WIDTH_COMPUTE,
+        .source = KERNEL_PATHS[add_chunk_offsets ? 3 : 1],
+        .compiler_options = {.defines = kernel_defines, .opt_level = KernelBuildOptLevel::O3},
+        .dfb_bindings = compute_bindings,
+        .runtime_arg_schema = {.runtime_arg_names = rta_names},
+        .hw_config = ComputeHardwareConfig{compute_config},
+    };
+
+    // The work split's two core groups only differ in how many chunks a core scans.
+    KernelRunArgs reader_run_args{.kernel = WIDTH_READER};
+    KernelRunArgs writer_run_args{.kernel = WIDTH_WRITER};
+    KernelRunArgs compute_run_args{.kernel = WIDTH_COMPUTE};
+    for (uint32_t i = 0, start_chunk = 0; i < num_cores; ++i) {
+        const NodeCoord node{i / num_cores_y, i % num_cores_y};
+        const uint32_t core_chunks =
+            core_group_1.contains(node) ? chunks_per_core_group_1 : chunks_per_core_group_2;
+        for (auto* run_args : {&reader_run_args, &writer_run_args, &compute_run_args}) {
+            AddRuntimeArgsForNode(
+                run_args->runtime_arg_values,
+                node,
+                {{"num_chunks", core_chunks},
+                 {"start_chunk", start_chunk},
+                 {"row_tiles", row_tiles},
+                 {"chunks_per_row", chunks_per_row},
+                 {"chunk_tiles", chunk_tiles}});
+        }
+        start_chunk += core_chunks;
+    }
+
+    ProgramSpec spec{
+        .name = "accumulation_width",
+        .kernels = {std::move(reader), std::move(writer), std::move(compute)},
+        .dataflow_buffers = std::move(dataflow_buffers),
+        .tensor_parameters = std::move(tensor_parameters),
+        .work_units = {WorkUnitSpec{
+            .name = "accumulation_width",
+            .kernels = {WIDTH_READER, WIDTH_WRITER, WIDTH_COMPUTE},
+            .target_nodes = all_cores,
+        }},
+    };
+    ProgramRunArgs run_args{
+        .kernel_run_args = {std::move(reader_run_args), std::move(writer_run_args), std::move(compute_run_args)},
+        .tensor_args = {{WIDTH_INPUT, input_tensor}, {WIDTH_OUTPUT, output_tensor}},
+    };
+    if (chunked) {
+        run_args.tensor_args.insert({WIDTH_TOTALS_TENSOR, tensor_args.chunk_totals->mesh_tensor()});
+    }
+
+    return ttnn::device_operation::ProgramArtifacts{.spec = std::move(spec), .run_params = std::move(run_args)};
+}
+
+}  // namespace ttnn::prim
