+// Adds lreg A into lreg B: as FP32 (A times lreg 10's 1.0, plus B), or with IS_INT32 as integers,
+// leaving the condition codes alone. The SFPNOP covers the FP32 add's latency.
+template <bool IS_INT32, uint32_t A, uint32_t B>
+inline void cumsum_add() {
+    if constexpr (IS_INT32) {
+        TTI_SFPIADD(0, A, B, 4);
+    } else {
+        TTI_SFPADD(10, A, B, B, 0);
+    }
+    TTI_SFPNOP;
 }
 
