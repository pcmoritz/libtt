+// Chunks per row of tiles for a width scan, each scanned from zero on its own core: as many as there
+// are cores for each row, but chunks of at least 16 tiles, and at least enough that no chunk is over
+// 128 tiles (4096 elements), which bounds each sequential FP32 sum. The chunks divide the row; one
+// chunk scans the row whole.
+uint32_t width_scan_chunks(uint32_t rows, uint32_t row_tiles, uint32_t cores) {
+    constexpr uint32_t min_chunk_tiles = 16;
+    constexpr uint32_t max_chunk_tiles = 128;
+    const uint32_t fewest = (row_tiles + max_chunk_tiles - 1) / max_chunk_tiles;
+    const uint32_t most = row_tiles / min_chunk_tiles;
+    const uint32_t wanted = std::max(fewest, (cores + rows - 1) / rows);
+    for (uint32_t chunks = std::min(wanted, most); chunks >= std::max(fewest, 2u); --chunks) {
+        if (row_tiles % chunks == 0) {
+            return chunks;
+        }
+    }
+    for (uint32_t chunks = wanted + 1; chunks <= most; ++chunks) {
+        if (row_tiles % chunks == 0) {
+            return chunks;
+        }
+    }
+    return 1;
+}
