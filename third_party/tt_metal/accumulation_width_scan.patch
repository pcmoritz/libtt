diff --git ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_width_compute.cpp ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_width_compute.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_width_compute.cpp
@@ -0,0 +1,83 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Cumulative sum along the width of each row of tiles. Each tile is transposed as it is unpacked,
+// so its rows become columns; cumsum_tile scans the columns top to bottom and carries their totals
+// to the next tile in SFPU registers; the result is transposed back in Dest and packed. The running
+// totals are FP32 in Dest; only the packed output is rounded.
+//
+// With WRITE_TOTALS, a row is one chunk of a longer row, and after it the kernel scans a tile of
+// zeros: every row of the result is then the carried column totals, so the tile, transposed back,
+// holds each row's total of the chunk in all its columns. The program adds those to later chunks.
+
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/cumsum.h"
+#include "api/compute/pack.h"
+#include "api/compute/reconfig_data_format.h"
+#include "api/compute/transpose.h"
+#include "api/compute/transpose_dest.h"
+#include "api/compute/tile_move_copy.h"
+#define APPROX false
+#include "api/compute/common.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "experimental/kernel_args.h"
+#include "../accumulation_common.hpp"
+
+void kernel_main() {
+    const uint32_t num_rows = get_arg(args::num_rows);
+    const uint32_t tiles_per_row = get_arg(args::tiles_per_row);
+
+    DataflowBuffer dfb_in_obj(dfb::in);
+    DataflowBuffer dfb_out_obj(dfb::out);
+#ifdef WRITE_TOTALS
+    DataflowBuffer dfb_zero_obj(dfb::zero);
+    DataflowBuffer dfb_totals_obj(dfb::totals);
+    dfb_zero_obj.wait_front(ONE_TILE);
+#endif
+
+    compute_kernel_hw_startup(dfb::in, dfb::out);
+
+    for (uint32_t i = 0; i < num_rows; ++i) {
+        for (uint32_t j = 0; j < tiles_per_row; ++j) {
+            dfb_in_obj.wait_front(ONE_TILE);
+            tile_regs_acquire();
+
+            transpose_init(dfb::in);
+            transpose_tile(dfb::in, FIRST_TILE, WORKING_REG);
+            // The transposes reprogram the replay buffer the scan runs from, not the SFPU
+            // registers that carry the column totals between tiles.
+            cumsum_tile_init();
+            cumsum_tile(WORKING_REG, /*first=*/j == 0);
+            transpose_dest_init</*is_32bit=*/true>();
+            transpose_dest</*is_32bit=*/true>(WORKING_REG);
+
+            tile_regs_commit();
+            dfb_in_obj.pop_front(ONE_TILE);
+
+            tile_regs_wait();
+            dfb_out_obj.reserve_back(ONE_TILE);
+            pack_tile(WORKING_REG, dfb::out);
+            dfb_out_obj.push_back(ONE_TILE);
+            tile_regs_release();
+        }
+#ifdef WRITE_TOTALS
+        tile_regs_acquire();
+        copy_init(dfb::zero);
+        copy_tile(dfb::zero, FIRST_TILE, WORKING_REG);
+        cumsum_tile_init();
+        cumsum_tile(WORKING_REG, /*first=*/false);
+        transpose_dest_init</*is_32bit=*/true>();
+        transpose_dest</*is_32bit=*/true>(WORKING_REG);
+        tile_regs_commit();
+        tile_regs_wait();
+        dfb_totals_obj.reserve_back(ONE_TILE);
+        pack_tile(WORKING_REG, dfb::totals);
+        dfb_totals_obj.push_back(ONE_TILE);
+        tile_regs_release();
+#endif
+    }
+#ifdef WRITE_TOTALS
+    dfb_zero_obj.pop_front(ONE_TILE);
+#endif
+}
diff --git ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_offsets_compute.cpp ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_offsets_compute.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/compute/accumulation_offsets_compute.cpp
@@ -0,0 +1,80 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Second pass of a chunked width scan: adds to each chunk the sum of the totals of the chunks before
+// it in its row of tiles. The totals tiles hold each row's total in all their columns, so their sum is
+// the offset tile itself. FP32 throughout, on the SFPU.
+
+#include "api/compute/compute_kernel_api.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/pack.h"
+#include "api/compute/tile_move_copy.h"
+#define APPROX false
+#include "api/compute/common.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "experimental/kernel_args.h"
+#include "../accumulation_common.hpp"
+
+void kernel_main() {
+    const uint32_t num_chunks = get_arg(args::num_rows);
+    const uint32_t chunk_tiles = get_arg(args::tiles_per_row);
+    const uint32_t start_chunk = get_arg(args::start_chunk);
+    const uint32_t chunks_per_row = get_arg(args::chunks_per_row);
+
+    DataflowBuffer dfb_in_obj(dfb::in);
+    DataflowBuffer dfb_out_obj(dfb::out);
+    DataflowBuffer dfb_totals_obj(dfb::totals);
+    DataflowBuffer dfb_acc_obj(dfb::acc);
+
+    constexpr uint32_t DST_IN = 0;
+    constexpr uint32_t DST_ACC = 1;
+
+    compute_kernel_hw_startup(dfb::in, dfb::out);
+
+    for (uint32_t chunk = start_chunk; chunk < start_chunk + num_chunks; ++chunk) {
+        const uint32_t before = chunk % chunks_per_row;
+        if (before > 0) {
+            tile_regs_acquire();
+            for (uint32_t k = 0; k < before; ++k) {
+                dfb_totals_obj.wait_front(ONE_TILE);
+                copy_init(dfb::totals);
+                copy_tile(dfb::totals, FIRST_TILE, k == 0 ? DST_ACC : DST_IN);
+                dfb_totals_obj.pop_front(ONE_TILE);
+                if (k > 0) {
+                    add_binary_tile_init();
+                    add_binary_tile(DST_ACC, DST_IN, DST_ACC);
+                }
+            }
+            tile_regs_commit();
+            tile_regs_wait();
+            dfb_acc_obj.reserve_back(ONE_TILE);
+            pack_tile(DST_ACC, dfb::acc);
+            dfb_acc_obj.push_back(ONE_TILE);
+            tile_regs_release();
+            dfb_acc_obj.wait_front(ONE_TILE);
+        }
+        for (uint32_t j = 0; j < chunk_tiles; ++j) {
+            dfb_in_obj.wait_front(ONE_TILE);
+            tile_regs_acquire();
+            copy_init(dfb::in);
+            copy_tile(dfb::in, FIRST_TILE, DST_IN);
+            if (before > 0) {
+                copy_init(dfb::acc);
+                copy_tile(dfb::acc, FIRST_TILE, DST_ACC);
+                add_binary_tile_init();
+                add_binary_tile(DST_IN, DST_ACC, DST_IN);
+            }
+            tile_regs_commit();
+            dfb_in_obj.pop_front(ONE_TILE);
+            tile_regs_wait();
+            dfb_out_obj.reserve_back(ONE_TILE);
+            pack_tile(DST_IN, dfb::out);
+            dfb_out_obj.push_back(ONE_TILE);
+            tile_regs_release();
+        }
+        if (before > 0) {
+            dfb_acc_obj.pop_front(ONE_TILE);
+        }
+    }
+}
diff --git ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_offsets_reader.cpp ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_offsets_reader.cpp
new file mode 100644
--- /dev/null
+++ ttnn/cpp/ttnn/operations/reduction/accumulation/device/kernels/dataflow/accumulation_offsets_reader.cpp
@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: © 2026 Tenstorrent USA, Inc.
+//
+// SPDX-License-Identifier: Apache-2.0
+
+// Second pass of a chunked width scan: for each chunk, the totals of the chunks before it in its row
+// of tiles, then the chunk's tiles of the first pass's result.
+
+#include "api/dataflow/dataflow_api.h"
+#include "api/dataflow/noc.h"
+#include "api/dataflow/dataflow_buffer.h"
+#include "api/tensor/noc_traits.h"
+#include "experimental/kernel_args.h"
+
+#include "../accumulation_common.hpp"
+
+void kernel_main() {
+    const uint32_t num_chunks = get_arg(args::num_rows_per_core);
+    const uint32_t chunk_tiles = get_arg(args::tiles_per_row);
+    const uint32_t start_chunk = get_arg(args::start_id);
+    const uint32_t chunks_per_row = get_arg(args::chunks_per_row);
+
+    const Noc noc;
+    DataflowBuffer dfb_in_obj(dfb::in);
+    DataflowBuffer dfb_totals_obj(dfb::totals);
+    const uint32_t tile_bytes = dfb_in_obj.get_tile_size();
+    const auto input_addrg = TensorAccessor(tensor::input);
+    const auto totals_addrg = TensorAccessor(tensor::totals);
+
+    for (uint32_t chunk = start_chunk; chunk < start_chunk + num_chunks; ++chunk) {
+        const uint32_t first_of_row = chunk - chunk % chunks_per_row;
+        for (uint32_t before = first_of_row; before < chunk; ++before) {
+            dfb_totals_obj.reserve_back(ONE_TILE);
+            noc.async_read(totals_addrg, dfb_totals_obj, tile_bytes, {.page_id = before}, {.offset_bytes = 0});
+            noc.async_read_barrier();
+            dfb_totals_obj.push_back(ONE_TILE);
+        }
+        for (uint32_t j = 0; j < chunk_tiles; ++j) {
+            dfb_in_obj.reserve_back(ONE_TILE);
+            noc.async_read(
+                input_addrg, dfb_in_obj, tile_bytes, {.page_id = chunk * chunk_tiles + j}, {.offset_bytes = 0});
+            noc.async_read_barrier();
+            dfb_in_obj.push_back(ONE_TILE);
+        }
+    }
+}
