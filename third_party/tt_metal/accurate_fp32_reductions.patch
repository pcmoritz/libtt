+    // Float32-formatted consumed DFB. The FPU truncates Float32 to TF32, so with a 32-bit DEST the
+    // kernel unpacks Float32 straight to DEST and multiplies on the SFPU.
+    const bool fp32_sfpu_product = cb_data_format == DataFormat::Float32 && fp32_dest_acc_en;
     if (cb_data_format == DataFormat::Float32) {
-        compute_hw.unpack_modes.insert({INPUT_DFB, UnpackMode::UnpackToSrc});
