diff --git ttnn/cpp/ttnn/operations/reduction/prod/device/kernels/compute/prod_nc.cpp ttnn/cpp/ttnn/operations/reduction/prod/device/kernels/compute/prod_nc.cpp
--- ttnn/cpp/ttnn/operations/reduction/prod/device/kernels/compute/prod_nc.cpp
+++ ttnn/cpp/ttnn/operations/reduction/prod/device/kernels/compute/prod_nc.cpp
@@ -7,6 +7,8 @@
 #include "api/compute/common.h"
 #include "api/compute/tile_move_copy.h"
 #include "api/compute/eltwise_binary.h"
+#include "api/compute/eltwise_binary_sfpu.h"
+#include "api/compute/eltwise_unary/eltwise_unary.h"
 #include "api/dataflow/dataflow_buffer.h"
 #include "experimental/kernel_args.h"
 
@@ -21,7 +23,13 @@ void kernel_main() {
     DataflowBuffer dfb_in0_obj(dfb::in);
     DataflowBuffer dfb_out0_obj(dfb::out);
 
+#ifdef PROD_FP32_SFPU
+    // The FPU truncates Float32 operands to TF32; multiply in DEST on the SFPU instead.
+    constexpr std::uint32_t dst1 = 1;
+    init_sfpu(dfb::in, dfb::out);
+#else
     compute_kernel_hw_startup(dfb::in, dfb::in, dfb::out);
+#endif
     pack_reconfig_data_format(dfb::out);
 
     for (std::uint32_t i = 0; i < num_output_tiles; ++i) {
@@ -35,12 +43,22 @@ void kernel_main() {
         copy_tile(dfb::in, 0, dst0);
         dfb_in0_obj.pop_front(onetile);
 
+#ifdef PROD_FP32_SFPU
+        mul_binary_tile_init();
+        for (std::uint32_t j = 1; j < num_input_tiles; ++j) {
+            dfb_in0_obj.wait_front(onetile);
+            copy_tile(dfb::in, 0, dst1);
+            mul_binary_tile(dst0, dst1, dst0);
+            dfb_in0_obj.pop_front(onetile);
+        }
+#else
         mul_reuse_dest_init<EltwiseBinaryReuseDestType::DEST_TO_SRCA>(dfb::in);
         for (std::uint32_t j = 1; j < num_input_tiles; ++j) {
             dfb_in0_obj.wait_front(onetile);
             mul_reuse_dest_tiles<EltwiseBinaryReuseDestType::DEST_TO_SRCA>(dfb::in, 0, dst0);
             dfb_in0_obj.pop_front(onetile);
         }
+#endif
 
         tile_regs_commit();
 
diff --git ttnn/cpp/ttnn/operations/reduction/prod/device/prod_nc_program_factory.cpp ttnn/cpp/ttnn/operations/reduction/prod/device/prod_nc_program_factory.cpp
